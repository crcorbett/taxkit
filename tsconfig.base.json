{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "ignoreEffectSuggestionsInTscExitCode": true,
        "ignoreEffectWarningsInTscExitCode": true,
        "allowedUnstableApis": [
          "@effect/atom-react",
          "@effect/platform-bun",
          "@effect/platform-node",
          "@effect/vitest",
          "effect/ByteSize",
          "effect/Crypto",
          "effect/Effect#withErrorReporting",
          "effect/ErrorReporter",
          "effect/FileSystem",
          "effect/Graph",
          "effect/Path",
          "effect/PlatformError",
          "effect/Schema#IpAddressFromString",
          "effect/Stream#limitBytes",
          "effect/Stdio",
          "effect/ai",
          "effect/http",
          "effect/http-api",
          "effect/net/NetAddress",
          "effect/process",
          "effect/reactivity",
          "effect/testing/TestConsole"
        ]
      }
    ],
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "files": ["raw-modules.d.ts"]
}
