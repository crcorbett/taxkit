{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taxkit-website-local-candidate",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 0,
    "logs": {
      "enabled": false,
      "head_sampling_rate": 0,
      "invocation_logs": false,
      "persist": false,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0,
      "persist": false,
    },
  },
  "services": [
    { "binding": "TAXKIT_API", "service": "taxkit-api-local-candidate" },
  ],
  "vars": {
    "API_PUBLIC_ORIGIN": "http://127.0.0.1:4101",
    "WEBSITE_PUBLIC_ORIGIN": "http://127.0.0.1:4100",
  },
}
