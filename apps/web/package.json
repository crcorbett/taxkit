{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "TAXKIT_API_BASE_URL=$(portless get api.taxkit) VITE_TAXKIT_API_BASE_URL=$(portless get api.taxkit) portless run --name taxkit vite dev",
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .output .tanstack .turbo node_modules/.vite",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@taxkit/api-http": "workspace:*",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@effect/atom-react": "4.0.0",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "5.0.3",
    "nitro": "catalog:",
    "playwright": "1.63.0",
    "scheduler": "0.28.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
