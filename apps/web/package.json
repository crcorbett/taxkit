{
  "name": "web",
  "version": "0.0.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "portless run --name taxkit vite dev",
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .tanstack .turbo .wrangler dist node_modules/.vite",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test": "bun --bun vitest run",
    "generate:worker-types": "wrangler types src/worker-runtime.generated.d.ts --include-env true --include-runtime true --strict-vars false --config wrangler.jsonc",
    "check:worker-types": "wrangler types src/worker-runtime.generated.d.ts --include-env true --include-runtime true --strict-vars false --config wrangler.jsonc --check"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@base-ui/react": "catalog:",
    "@effect/atom-react": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@taxkit/api-http": "workspace:*",
    "@taxkit/api-mcp": "workspace:*",
    "@taxkit/calculators": "workspace:*",
    "@taxkit/content": "workspace:*",
    "@taxkit/mdx-react": "workspace:*",
    "@taxkit/observability": "workspace:*",
    "@taxkit/webmcp": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@effect/vitest": "catalog:",
    "@taxkit/core": "workspace:*",
    "@taxkit/infrastructure": "workspace:*",
    "@taxkit/rules-au-pay": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "scheduler": "0.28.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "webmcp-types": "0.1.10",
    "wrangler": "catalog:"
  }
