{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "vitest.native.config.ts"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "paths": {
      "#/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  }
}
