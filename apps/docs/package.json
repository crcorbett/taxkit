{
  "name": "docs",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --cwd ../.. run docs:dev:cloudflare",
    "dev:vite": "portless run --name docs.taxkit vite dev",
    "build": "vite build",
    "build:cloudflare": "vite build",
    "check-types": "bun run --filter=@taxkit/docs-fumadocs build && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "clean": "rm -rf .tanstack .turbo .wrangler dist node_modules/.vite",
    "check-import-boundaries": "bun run ./scripts/check-import-boundaries.ts",
    "preview": "portless run --name docs.taxkit vite preview",
    "preview:cloudflare": "vite preview",
    "test": "vitest run --config vitest.server.config.ts && bun test ./scripts/cloudflare-hosted-proof.boundary.test.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:built": "bun run ./scripts/test-cloudflare-built.tsx",
    "test:cloudflare-built": "bun run ./scripts/test-cloudflare-built.tsx",
    "test:cloudflare-hosted": "bun run ./scripts/test-cloudflare-hosted.tsx"
  },
  "dependencies": {
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@taxkit/docs-content": "workspace:*",
    "@taxkit/docs-fumadocs": "workspace:*",
    "effect": "catalog:",
    "fumadocs-mdx": "^14.3.1",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "5.0.1",
    "playwright": "^1.60.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
