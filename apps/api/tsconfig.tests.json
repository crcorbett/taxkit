{
  "extends": "./tsconfig.json",
  "include": [
    "test/**/*.ts",
    "scripts/**/*.ts",
    "catalogue/**/*.ts",
    "smoke/**/*.ts",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    // `bun` keeps eventsource on its built types. Takumi's `bun` types omit
    // the default module, so retain the types every other program sees.
    "customConditions": ["bun"],
    "paths": {
      "@takumi-rs/wasm/auto": [
        "../../packages/og-image/node_modules/@takumi-rs/wasm/bundlers/wasm-module.d.ts"
      ]
    },
    "rootDir": ".",
    "noEmit": true,
    "tsBuildInfoFile": "tests.tsbuildinfo"
  }
}
