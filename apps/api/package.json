{
  "name": "api",
  "version": "2.0.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "dev": "bun run docs-catalogue && portless run --name api.taxkit bun --watch src/index.ts",
    "start": "bun run docs-catalogue && bun src/index.ts",
    "build": "bun run docs-catalogue",
    "check-types": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.tests.json",
    "smoke": "bun run smoke:public-routes",
    "smoke:public-routes": "bun scripts/smoke-public-routes.runtime.ts",
    "clean": "rm -rf .turbo src/generated",
    "test": "bun --bun vitest run --config vitest.config.ts",
    "docs-catalogue": "bun scripts/docs-catalogue.runtime.ts"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@taxkit/aeo": "workspace:*",
    "@taxkit/analytics": "workspace:*",
    "@taxkit/api-http": "workspace:*",
    "@taxkit/api-mcp": "workspace:*",
    "@taxkit/calculators": "workspace:*",
    "@taxkit/content": "workspace:*",
    "@taxkit/core": "workspace:*",
    "@taxkit/infrastructure": "workspace:*",
    "@taxkit/observability": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@content/docs": "workspace:*",
    "@effect/vitest": "catalog:",
    "@modelcontextprotocol/client": "2.4.0",
    "@taxkit/diagrams": "workspace:*",
    "@taxkit/mdx": "workspace:*",
    "@taxkit/og-image": "workspace:*",
    "@taxkit/rules-au-pay": "workspace:*",
    "@taxkit/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
