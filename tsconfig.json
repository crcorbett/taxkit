{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tools/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/.output",
    "**/.alchemy",
    "tools/oxlint/fixtures"
  ]
}
