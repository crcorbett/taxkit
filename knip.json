{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": ["docs/**", "apps/web/src/routeTree.gen.ts"],
  "ignoreIssues": {
    "packages/api/http/src/groups/health.ts": ["exports", "types"]
  },
  "ignoreBinaries": ["doppler", "gh", "jq", "oxfmt", "oxlint"],
  "workspaces": {
    ".": {
      "entry": [
        "alchemy.*.ts",
        "tools/vitest.config.ts",
        "tools/**/*.test.ts",
        "tools/apps-local/native-pair-build.runtime.ts",
        "tools/apps-local/fixtures/**/*.ts"
      ],
      "project": ["*.ts", "tools/**/*.ts", "!tools/oxlint/fixtures/**"],
      "ignoreDependencies": ["typescript", "@effect/language-service"]
    },
    "apps/api": {
      "entry": [
        "src/index.ts",
        "src/worker.ts",
        "scripts/smoke-public-routes.runtime.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/router.tsx",
        "src/entry.server.ts",
        "src/routes/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/*": {
      "entry": ["type-tests/**/*.ts", "test/**/*.typecheck.ts"]
    },
    "packages/{api,sdk}/*": {
      "entry": ["type-tests/**/*.ts", "test/**/*.typecheck.ts"]
    },
    "packages/rules/*/*": {},
    "packages/docs-examples": {
      "entry": ["src/**/*.ts"]
    }
  }
}
