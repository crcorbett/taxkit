{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": ["docs/**", "apps/web/src/routeTree.gen.ts"],
  "ignoreDependencies": ["@taxkit/tsconfig"],
  "ignoreIssues": {
    "packages/api/http/src/client/in-process.layer.ts": ["exports"],
    "packages/api/http/src/client/service.ts": ["duplicates"],
    "packages/api/http/src/groups/health.ts": ["exports", "types"]
  },
  "ignoreBinaries": ["doppler", "gh", "jq", "oxfmt", "oxlint"],
  "workspaces": {
    ".": {
      "entry": [
        "alchemy.run.ts",
        "package.json",
        "turbo.json",
        "oxfmt.config.ts",
        "oxlint.config.ts",
        "tools/effect-language-service/compatibility.ts",
        "tools/repository-paths/check.runtime.ts",
        "tools/repository-paths/*.test.ts",
        "tools/quality-workflow/check.runtime.ts",
        "tools/quality-workflow/*.test.ts",
        "tools/docs-deployment/check.runtime.ts",
        "tools/docs-deployment/automation.check.runtime.ts",
        "tools/docs-deployment/doppler-custody.runtime.ts",
        "tools/docs-deployment/inventory.runtime.ts",
        "tools/docs-deployment/local-doppler.runtime.ts",
        "tools/docs-deployment/workflow-artifact.runtime.ts",
        "tools/docs-deployment/*.test.ts"
      ],
      "project": [
        "*.json",
        "*.ts",
        "tools/effect-language-service/**/*.ts",
        "tools/repository-paths/**/*.ts",
        "tools/quality-workflow/**/*.ts",
        "tools/docs-deployment/**/*.ts"
      ],
      "ignoreDependencies": ["typescript", "@effect/language-service"]
    },
    "apps/api": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@taxkit/tsconfig"]
    },
    "apps/web": {
      "entry": [
        "src/router.tsx",
        "src/server.ts",
        "src/routes/**/*.{ts,tsx}",
        "vite.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "vite.config.ts"],
      "ignoreDependencies": ["@tanstack/router-plugin", "@taxkit/tsconfig"]
    },
    "apps/docs": {
      "entry": [
        "scripts/**/*.{ts,tsx}",
        "src/lib/docs/route-boundary.type-test.ts",
        "src/**/*.test.ts",
        "src/**/*.server.ts",
        "src/router.tsx",
        "src/server.ts",
        "src/routes/**/*.{ts,tsx}",
        "vitest.server.config.ts",
        "vite.config.ts"
      ],
      "project": [
        "scripts/**/*.{ts,tsx}",
        "test/**/*.ts",
        "src/**/*.{ts,tsx}",
        "vitest.server.config.ts",
        "vite.config.ts"
      ],
      "ignore": ["examples/**/*.ts", "src/routeTree.gen.ts"],
      "ignoreDependencies": ["@taxkit/tsconfig"]
    },
    "packages/core": {
      "entry": ["src/index.ts", "src/*/index.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    },
    "packages/api/http": {
      "entry": [
        "src/index.ts",
        "src/api.ts",
        "src/client/index.ts",
        "src/client/live.layer.ts",
        "src/client/server.layer.ts",
        "src/server.ts",
        "src/handlers/index.ts",
        "src/handlers/live.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@effect/platform-node", "@taxkit/tsconfig"]
    },
    "packages/calculators": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/docs-content": {
      "entry": [
        "source.config.ts",
        "src/client.ts",
        "src/errors.ts",
        "src/generated-source.layer.ts",
        "src/live.layer.ts",
        "src/schemas.ts",
        "src/server.ts",
        "src/service.ts",
        "src/test.layer.ts",
        "src/validate.runtime.ts",
        "src/**/*.test.ts",
        "vitest.config.ts",
        "examples/**/*.ts"
      ],
      "project": [
        "source.config.ts",
        "src/**/*.ts",
        "vitest.config.ts",
        "examples/**/*.ts"
      ],
      "ignoreDependencies": ["@shikijs/core", "@taxkit/tsconfig", "typescript"]
    },
    "packages/docs-fumadocs": {
      "entry": [
        "src/config.ts",
        "src/errors.ts",
        "src/live.layer.ts",
        "src/render/index.ts",
        "src/schemas.ts",
        "src/service.ts",
        "src/test.layer.ts",
        "src/**/*.test.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.ts", "vitest.config.ts"],
      "ignoreDependencies": ["@taxkit/tsconfig", "typescript"]
    },
    "packages/sdk/typescript": {
      "entry": [
        "src/index.ts",
        "src/effect.ts",
        "src/au.ts",
        "src/au-effect.ts",
        "src/schemas/index.ts",
        "src/testing/index.ts",
        "scripts/check-import-boundaries.ts",
        "src/**/*.test.ts",
        "vitest*.config.ts",
        "type-tests/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "vitest*.config.ts",
        "type-tests/**/*.ts"
      ],
      "ignoreDependencies": ["@types/bun"]
    },
    "packages/scripts": {
      "entry": [
        "src/index.ts",
        "src/release-readiness/release-readiness.runtime.ts"
      ],
      "project": ["src/**/*.ts", "vitest.config.ts"]
    },
    "packages/rules/au/income-tax": {
      "entry": ["src/index.ts", "src/*/index.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    },
    "packages/rules/au/pay": {
      "entry": ["src/index.ts", "src/*/index.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    },
    "packages/rules/au/stsl": {
      "entry": ["src/index.ts", "src/*/index.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    }
  }
}
