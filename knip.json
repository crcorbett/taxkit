{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": ["docs/**", "apps/web/src/routeTree.gen.ts"],
  "ignoreDependencies": ["@taxkit/tsconfig"],
  "ignoreIssues": {
    "packages/api/http/src/client/service.ts": ["duplicates"],
    "packages/api/http/src/groups/health.ts": ["exports", "types"]
  },
  "ignoreBinaries": ["doppler", "gh", "jq", "oxfmt", "oxlint"],
  "workspaces": {
    ".": {
      "entry": [
        "alchemy.run.ts",
        "package.json",
        "turbo.json",
        "oxfmt.config.ts",
        "oxlint.config.ts",
        "tools/effect-language-service/compatibility.ts",
        "tools/repository-paths/check.runtime.ts",
        "tools/repository-paths/*.test.ts",
        "alchemy.posthog.run.ts",
        "alchemy.axiom.run.ts",
        "alchemy.trace.run.ts",
        "tools/documentation/check.runtime.ts",
        "tools/**/*.test.ts",
        "tools/apps-local/native-pair-build.runtime.ts"
      ],
      "project": [
        "*.json",
        "*.ts",
        "tools/effect-language-service/**/*.ts",
        "tools/repository-paths/**/*.ts",
        "tools/documentation/*.ts",
        "tools/oxlint/*.ts",
        "tools/infrastructure/*.ts",
        "tools/apps-local/*.ts",
        "tools/workspace/*.ts"
      ],
      "ignoreDependencies": ["typescript", "@effect/language-service"]
    },
    "apps/api": {
      "entry": [
        "src/index.ts",
        "src/worker.ts",
        "scripts/smoke-public-routes.runtime.ts",
        "scripts/**/*.test.ts",
        "test/**/*.test.ts",
        "vitest.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts",
        "vitest.config.ts"
      ],
      "ignoreDependencies": ["@taxkit/tsconfig"]
    },
    "apps/web": {
      "entry": [
        "src/router.tsx",
        "src/server.ts",
        "src/routes/**/*.{ts,tsx}",
        "vite.config.ts",
        "vitest.config.ts",
        "vitest.browser.config.ts",
        "scripts/**/*.ts",
        "test/**/*.{ts,tsx}",
        "vitest.native.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "vite.config.ts",
        "vitest.config.ts",
        "vitest.browser.config.ts",
        "scripts/**/*.ts",
        "test/**/*.{ts,tsx}",
        "vitest.native.config.ts"
      ],
      "ignoreDependencies": ["@taxkit/tsconfig", "cloudflare"]
    },
    "packages/core": {
      "entry": ["src/index.ts", "src/*/index.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    },
    "packages/api/http": {
      "entry": [
        "src/index.ts",
        "src/api.ts",
        "src/client/index.ts",
        "src/client/live.layer.ts",
        "src/in-process.layer.ts",
        "src/server.ts",
        "src/handlers/index.ts",
        "src/handlers/live.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@effect/platform-node", "@taxkit/tsconfig"]
    },
    "packages/calculators": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/sdk/typescript": {
      "entry": [
        "src/index.ts",
        "src/effect.ts",
        "src/au.ts",
        "src/au-effect.ts",
        "src/schemas/index.ts",
        "src/testing/index.ts",
        "scripts/check-import-boundaries.runtime.ts",
        "vitest*.config.ts",
        "type-tests/**/*.ts",
        "src/core.ts",
        "src/http.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "vitest*.config.ts",
        "type-tests/**/*.ts",
        "test/**/*.ts"
      ],
      "ignoreDependencies": ["@types/bun"]
    },
    "packages/rules/au/income-tax": {
      "entry": ["src/index.ts", "src/*/index.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    },
    "packages/rules/au/pay": {
      "entry": ["src/index.ts", "src/*/index.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    },
    "packages/rules/au/stsl": {
      "entry": ["src/index.ts", "src/*/index.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    },
    "packages/docs-examples": {
      "entry": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
      "ignoreDependencies": ["typescript"]
    },
    "packages/content": {
      "entry": [
        "src/schemas.ts",
        "src/errors.ts",
        "src/service.ts",
        "src/live.layer.ts",
        "src/links.ts",
        "src/test.layer.ts",
        "src/__testing__/*.ts",
        "test/**/*.test.ts",
        "vitest.config.ts",
        "src/mdx.layer.ts",
        "src/link-resolver.layer.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    },
    "packages/mdx": {
      "entry": [
        "src/live.layer.ts",
        "src/highlights.adapter.layer.ts",
        "test/**/*.test.ts",
        "vitest.config.ts",
        "src/service.ts",
        "src/schemas.ts",
        "src/errors.ts",
        "src/compiler.layer.ts",
        "src/renderer.layer.ts",
        "src/artifacts.layer.ts",
        "src/config.ts",
        "src/test.layer.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    },
    "packages/diagrams": {
      "entry": [
        "src/mermaid.adapter.layer.ts",
        "test/**/*.test.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    },
    "packages/aeo": {
      "entry": [
        "src/documents.egress.ts",
        "src/routes.layer.ts",
        "src/service.ts",
        "src/__testing__/*.ts",
        "test/**/*.test.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    },
    "packages/og-image": {
      "entry": [
        "src/image-archive.ts",
        "src/takumi.adapter.layer.ts",
        "test/**/*.test.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts", "vitest.config.ts"]
    },
    "packages/webmcp": {
      "entry": [
        "src/model-context.adapter.layer.ts",
        "src/registration.egress.ts",
        "src/schemas.ts",
        "src/service.ts",
        "test/**/*.test.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
    }
  }
}
