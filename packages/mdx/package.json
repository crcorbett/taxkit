{
  "name": "@taxkit/mdx",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./live": {
      "source": "./src/live.layer.ts",
      "types": "./dist/live.layer.d.ts",
      "default": "./dist/live.layer.js"
    },
    "./highlights": {
      "source": "./src/highlights.adapter.layer.ts",
      "types": "./dist/highlights.adapter.layer.d.ts",
      "default": "./dist/highlights.adapter.layer.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@pierre/highlights": "0.1.3",
    "@taxkit/content": "workspace:*",
    "effect": "catalog:",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-mdx": "3.0.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-mdxjs": "3.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
