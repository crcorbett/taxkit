{
  "name": "@taxkit/api-http",
  "version": "3.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "source": "./src/api.ts",
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./in-process": {
      "source": "./src/in-process.layer.ts",
      "types": "./dist/in-process.layer.d.ts",
      "default": "./dist/in-process.layer.js"
    },
    "./config": {
      "source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./handlers": {
      "source": "./src/handlers/index.ts",
      "types": "./dist/handlers/index.d.ts",
      "default": "./dist/handlers/index.js"
    },
    "./handlers/live": {
      "source": "./src/handlers/live.ts",
      "types": "./dist/handlers/live.d.ts",
      "default": "./dist/handlers/live.js"
    },
    "./request-boundary": {
      "source": "./src/request-boundary.ts",
      "types": "./dist/request-boundary.d.ts",
      "default": "./dist/request-boundary.js"
    },
    "./response-policy": {
      "source": "./src/response-policy.ts",
      "types": "./dist/response-policy.d.ts",
      "default": "./dist/response-policy.js"
    },
    "./routes": {
      "source": "./src/routes.ts",
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./origin": {
      "source": "./src/origin.ts",
      "types": "./dist/origin.d.ts",
      "default": "./dist/origin.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./api": {
        "types": "./dist/api.d.ts",
        "default": "./dist/api.js"
      },
      "./in-process": {
        "types": "./dist/in-process.layer.d.ts",
        "default": "./dist/in-process.layer.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./handlers": {
        "types": "./dist/handlers/index.d.ts",
        "default": "./dist/handlers/index.js"
      },
      "./handlers/live": {
        "types": "./dist/handlers/live.d.ts",
        "default": "./dist/handlers/live.js"
      },
      "./request-boundary": {
        "types": "./dist/request-boundary.d.ts",
        "default": "./dist/request-boundary.js"
      },
      "./response-policy": {
        "types": "./dist/response-policy.d.ts",
        "default": "./dist/response-policy.js"
      },
      "./routes": {
        "types": "./dist/routes.d.ts",
        "default": "./dist/routes.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:openapi": "vitest run __tests__/openapi-snapshot.test.ts",
    "update-openapi-snapshot": "UPDATE_TAXKIT_OPENAPI_SNAPSHOT=true vitest run __tests__/openapi-snapshot.test.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@taxkit/calculators": "workspace:*",
    "@taxkit/content": "workspace:*",
    "@taxkit/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@taxkit/rules-au-pay": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
