{
  "name": "@taxkit/api-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tools": {
      "source": "./src/tools.ts",
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./handlers": {
      "source": "./src/handlers.layer.ts",
      "types": "./dist/handlers.layer.d.ts",
      "default": "./dist/handlers.layer.js"
    },
    "./service": {
      "source": "./src/service.ts",
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./schemas": {
      "source": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./request": {
      "source": "./src/request.service.ts",
      "types": "./dist/request.service.d.ts",
      "default": "./dist/request.service.js"
    },
    "./cancellation": {
      "source": "./src/cancellation.boundary.ts",
      "types": "./dist/cancellation.boundary.d.ts",
      "default": "./dist/cancellation.boundary.js"
    },
    "./response-budget": {
      "source": "./src/response-budget.boundary.ts",
      "types": "./dist/response-budget.boundary.d.ts",
      "default": "./dist/response-budget.boundary.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@taxkit/api-http": "workspace:*",
    "@taxkit/calculators": "workspace:*",
    "@taxkit/content": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
