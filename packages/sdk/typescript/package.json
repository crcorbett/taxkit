{
  "name": "taxkit",
  "version": "3.0.0",
  "private": false,
  "description": "TypeScript SDK for in-process TaxKit calculations.",
  "homepage": "https://taxkit.dev",
  "bugs": {
    "url": "https://github.com/crcorbett/taxkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crcorbett/taxkit.git",
    "directory": "packages/sdk/typescript"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "default": "./dist/effect.js"
    },
    "./au": {
      "types": "./dist/au.d.ts",
      "default": "./dist/au.js"
    },
    "./au/effect": {
      "types": "./dist/au-effect.d.ts",
      "default": "./dist/au-effect.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./effect": {
        "types": "./dist/effect.d.ts",
        "default": "./dist/effect.js"
      },
      "./au": {
        "types": "./dist/au.d.ts",
        "default": "./dist/au.js"
      },
      "./au/effect": {
        "types": "./dist/au-effect.d.ts",
        "default": "./dist/au-effect.js"
      },
      "./schemas": {
        "types": "./dist/schemas/index.d.ts",
        "default": "./dist/schemas/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "./http": {
        "types": "./dist/http.d.ts",
        "default": "./dist/http.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist .compiled && tsc -p tsconfig.build.json && bun run scripts/assemble-package.runtime.ts",
    "check-boundaries": "bun run scripts/check-import-boundaries.runtime.ts",
    "check-packed-artifact": "bun run scripts/check-packed-artifact.runtime.ts",
    "validate:downstream": "bun run scripts/validate-downstream-consumer.runtime.ts",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test-types": "tsc -p tsconfig.type-tests.json --noEmit",
    "clean": "rm -rf dist .compiled .turbo *.tsbuildinfo",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "@taxkit/api-http": "workspace:*",
    "@taxkit/calculators": "workspace:*",
    "@taxkit/content": "workspace:*",
    "@taxkit/core": "workspace:*",
    "@taxkit/rules-au-income-tax": "workspace:*",
    "@taxkit/rules-au-pay": "workspace:*",
    "@taxkit/rules-au-stsl": "workspace:*",
    "@taxkit/testing": "workspace:*",
    "@types/bun": "catalog:",
    "@vitest/browser-playwright": "5.0.5",
    "typescript": "catalog:",
    "typescript-ast": "npm:typescript@6.0.3",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
