{
  "name": "@taxkit/aeo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./documents": {
      "source": "./src/documents.egress.ts",
      "types": "./dist/documents.egress.d.ts",
      "default": "./dist/documents.egress.js"
    },
    "./routes": {
      "source": "./src/routes.layer.ts",
      "types": "./dist/routes.layer.d.ts",
      "default": "./dist/routes.layer.js"
    },
    "./service": {
      "source": "./src/service.ts",
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./testing/fixtures": {
      "source": "./src/__testing__/fixtures.ts",
      "types": "./dist/__testing__/fixtures.d.ts",
      "default": "./dist/__testing__/fixtures.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@taxkit/api-http": "workspace:*",
    "@taxkit/content": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
