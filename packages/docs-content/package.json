{
  "name": "@taxkit/docs-content",
  "version": "0.0.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./public-catalogue": "./.source/public-catalogue.json",
    "./errors": {
      "types": "./src/errors.ts",
      "source": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./live": {
      "types": "./src/live.layer.ts",
      "source": "./src/live.layer.ts",
      "default": "./src/live.layer.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "source": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "source": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    },
    "./service": {
      "types": "./src/service.ts",
      "source": "./src/service.ts",
      "default": "./src/service.ts"
    },
    "./test": {
      "types": "./src/test.layer.ts",
      "source": "./src/test.layer.ts",
      "default": "./src/test.layer.ts"
    },
    "./source.config": "./source.config.ts",
    "./catalogue-source": {
      "types": "./src/catalogue-source.layer.ts",
      "source": "./src/catalogue-source.layer.ts",
      "default": "./src/catalogue-source.layer.ts"
    }
  },
  "scripts": {
    "build": "bun run generate && bun --conditions=source run ./src/catalogue.runtime.ts",
    "check-types": "tsc --noEmit",
    "generate": "fumadocs-mdx && bun --conditions=source run ./src/catalogue-index.runtime.ts",
    "test": "vitest run --passWithNoTests",
    "validate": "bun run ./src/validate.runtime.ts",
    "clean": "rm -rf .source .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@mdx-js/mdx": "3.1.1",
    "@taxkit/content": "workspace:*",
    "@taxkit/docs-fumadocs": "workspace:*",
    "effect": "catalog:",
    "estree-util-visit": "2.0.0",
    "fumadocs-core": "16.16.0",
    "fumadocs-mdx": "15.4.6",
    "react": "catalog:",
    "unist-util-map": "4.0.0",
    "vfile": "6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/mdast": "4.0.4",
    "typescript": "catalog:",
    "unified": "11.0.5",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
