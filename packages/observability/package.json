{
  "name": "@taxkit/observability",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./host-telemetry": {
      "source": "./src/host-telemetry.ts",
      "types": "./dist/host-telemetry.d.ts",
      "default": "./dist/host-telemetry.js"
    },
    "./edge-identity": {
      "source": "./src/edge-identity.boundary.ts",
      "types": "./dist/edge-identity.boundary.d.ts",
      "default": "./dist/edge-identity.boundary.js"
    },
    "./stage": {
      "source": "./src/stage.ts",
      "types": "./dist/stage.d.ts",
      "default": "./dist/stage.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
