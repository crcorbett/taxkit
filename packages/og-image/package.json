{
  "name": "@taxkit/og-image",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./live": {
      "source": "./src/cache.layer.ts",
      "types": "./dist/cache.layer.d.ts",
      "default": "./dist/cache.layer.js"
    },
    "./takumi": {
      "source": "./src/takumi.adapter.layer.ts",
      "types": "./dist/takumi.adapter.layer.d.ts",
      "default": "./dist/takumi.adapter.layer.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/geist-latin.base64.txt dist/",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@takumi-rs/wasm": "2.14.0",
    "@taxkit/content": "workspace:*",
    "effect": "catalog:",
    "react": "catalog:",
    "takumi-js": "2.14.0"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@fontsource-variable/geist": "5.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
