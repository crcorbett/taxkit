{
  "name": "@taxkit/webmcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./host": {
      "source": "./src/model-context.adapter.layer.ts",
      "types": "./dist/model-context.adapter.layer.d.ts",
      "default": "./dist/model-context.adapter.layer.js"
    },
    "./registration": {
      "source": "./src/registration.egress.ts",
      "types": "./dist/registration.egress.d.ts",
      "default": "./dist/registration.egress.js"
    },
    "./schemas": {
      "source": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./service": {
      "source": "./src/service.ts",
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@taxkit/calculators": "workspace:*",
    "@taxkit/content": "workspace:*",
    "effect": "catalog:",
    "webmcp-types": "0.1.10"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
