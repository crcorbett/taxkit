{
  "name": "@taxkit/docs-fumadocs",
  "version": "0.0.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./config": {
      "source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./src/config.ts"
    },
    "./errors": {
      "source": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./live": {
      "source": "./src/live.layer.ts",
      "types": "./dist/live.layer.d.ts",
      "default": "./dist/live.layer.js"
    },
    "./render": {
      "source": "./src/render/index.ts",
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    },
    "./schemas": {
      "source": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./service": {
      "source": "./src/service.ts",
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./test": {
      "source": "./src/test.layer.ts",
      "types": "./dist/test.layer.d.ts",
      "default": "./dist/test.layer.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@shikijs/core": "4.5.0",
    "@shikijs/transformers": "4.5.0",
    "@standard-schema/spec": "1.1.0",
    "effect": "catalog:",
    "fumadocs-core": "16.16.0",
    "fumadocs-mdx": "15.4.6",
    "react": "catalog:",
    "remark-mermaidjs": "7.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
