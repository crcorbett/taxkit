import { Effect, Layer } from "effect";
import type { __DOMAIN_SYMBOL__Id } from "__DOMAIN_PACKAGE__/schemas";
import * as EffectRpcTest from "effect/unstable/rpc/RpcTest";

import { __SYMBOL__Group } from "./group.js";
import { __SYMBOL__HandlersLive } from "./handlers.js";
import { __SYMBOL__Client } from "./service.js";

export const __SYMBOL__ClientTest = Layer.effect(
  __SYMBOL__Client,
  EffectRpcTest.makeClient(__SYMBOL__Group).pipe(
    Effect.map((client) =>
      __SYMBOL__Client.of({
        get: Effect.fn("__SYMBOL__Client.get")((id: __DOMAIN_SYMBOL__Id) => client.Get__DOMAIN_SYMBOL__({ id })),
        list: Effect.fn("__SYMBOL__Client.list")(() => client.List__DOMAIN_SYMBOL__()),
      }),
    ),
  ),
).pipe(Layer.provide(__SYMBOL__HandlersLive));
