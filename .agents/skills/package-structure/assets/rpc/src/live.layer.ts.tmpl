import { __DOMAIN_SYMBOL__UnavailableError, Invalid__DOMAIN_SYMBOL__ResponseError } from "__DOMAIN_PACKAGE__/errors";
import { __DOMAIN_SYMBOL__ClientDeadline } from "__DOMAIN_PACKAGE__/schemas";
import type { __DOMAIN_SYMBOL__ApiOrigin, __DOMAIN_SYMBOL__Id } from "__DOMAIN_PACKAGE__/schemas";
import { Effect, Layer, Match, Option, Schema } from "effect";
import { Rpc as EffectRpc, RpcClient as EffectRpcClient, RpcSerialization } from "effect/unstable/rpc";
import type { RpcClientError } from "effect/unstable/rpc/RpcClientError";
import { Get__DOMAIN_SYMBOL__, List__DOMAIN_SYMBOL__, __SYMBOL__Group } from "./group.js";
import { __SYMBOL__Client } from "./service.js";

class RpcReplyDecodeDefect extends Schema.TaggedError<RpcReplyDecodeDefect>()("RpcReplyDecodeDefect", {
  operation: Schema.Literals(["get", "list"]),
}) {}

// rc.117 caches each native exit Schema. Mark failure only inside its reply decoder.
// Keep the native codecs and Ndjson parser; other SchemaError defects retain their identity.
const replySerialization = Layer.succeed(RpcSerialization.RpcSerialization, RpcSerialization.RpcSerialization.of({
  ...RpcSerialization.ndjson,
  codecFor: <S extends Schema.Top>(schema: S) => {
    const operation = schema.ast === EffectRpc.exitSchema(Get__DOMAIN_SYMBOL__).ast ? Option.some<"get" | "list">("get") :
      schema.ast === EffectRpc.exitSchema(List__DOMAIN_SYMBOL__).ast ? Option.some<"get" | "list">("list") : Option.none<"get" | "list">();
    const codec = RpcSerialization.ndjson.codecFor(schema);
    return Schema.catchDecoding<typeof codec>((issue) => Option.match(operation, {
      onNone: () => Effect.fail(issue),
      onSome: (operation) => Effect.die(new RpcReplyDecodeDefect({ operation })),
    }))(codec);
  },
}));

const rpcFailure = (operation: "get" | "list", error: RpcClientError) => Match.value(error.reason).pipe(
  Match.tag("RpcClientDefect", () => new Invalid__DOMAIN_SYMBOL__ResponseError({ operation })),
  Match.tag("HttpError", (reason) => Match.value(reason.kind).pipe(
    Match.when("DecodeError", () => new Invalid__DOMAIN_SYMBOL__ResponseError({ operation })),
    Match.when("EmptyBodyError", () => new Invalid__DOMAIN_SYMBOL__ResponseError({ operation })),
    Match.orElse(() => new __DOMAIN_SYMBOL__UnavailableError({ operation })),
  )),
  Match.orElse(() => new __DOMAIN_SYMBOL__UnavailableError({ operation })),
);

// The caller supplies its stage's HttpClient; the scoped native client stays private.
export const __SYMBOL__ClientLive = (origin: __DOMAIN_SYMBOL__ApiOrigin) => Layer.effect(
  __SYMBOL__Client,
  Effect.gen(function* () {
    const client = yield* EffectRpcClient.make(__SYMBOL__Group);
    return __SYMBOL__Client.of({
      get: Effect.fn("__DOMAIN_SYMBOL__Service.get")((id: __DOMAIN_SYMBOL__Id) => client.Get__DOMAIN_SYMBOL__({ id }).pipe(
        Effect.timeoutOrElse({ duration: __DOMAIN_SYMBOL__ClientDeadline, orElse: () => Effect.fail(new __DOMAIN_SYMBOL__UnavailableError({ operation: "get" })) }),
        Effect.catchTag("RpcClientError", (error) => Effect.fail(rpcFailure("get", error))),
        Effect.catchDefect((defect) => Schema.is(RpcReplyDecodeDefect)(defect)
          ? Effect.fail(new Invalid__DOMAIN_SYMBOL__ResponseError({ operation: "get" }))
          : Effect.die(defect)),
      )),
      list: Effect.fn("__DOMAIN_SYMBOL__Service.list")(() => client.List__DOMAIN_SYMBOL__().pipe(
        Effect.timeoutOrElse({ duration: __DOMAIN_SYMBOL__ClientDeadline, orElse: () => Effect.fail(new __DOMAIN_SYMBOL__UnavailableError({ operation: "list" })) }),
        Effect.catchTag("RpcClientError", (error) => Effect.fail(rpcFailure("list", error))),
        Effect.catchDefect((defect) => Schema.is(RpcReplyDecodeDefect)(defect)
          ? Effect.fail(new Invalid__DOMAIN_SYMBOL__ResponseError({ operation: "list" }))
          : Effect.die(defect)),
      )),
    });
  }),
).pipe(Layer.provide(EffectRpcClient.layerProtocolHttp({ url: origin + "/rpc" })), Layer.provide(replySerialization));
