import { assert, describe, it } from "@effect/vitest";
import { Cause, Effect, Exit, Layer, Result, Schema, Scope } from "effect";
import { HttpClient, HttpRouter, HttpServerRequest, HttpServerResponse } from "effect/unstable/http";
import { __DOMAIN_SYMBOL__Live } from "__DOMAIN_PACKAGE__/live";
import { __DOMAIN_SYMBOL__NotFoundError, Invalid__DOMAIN_SYMBOL__ResponseError } from "__DOMAIN_PACKAGE__/errors";
import { __DOMAIN_SYMBOL__ApiOrigin, __DOMAIN_SYMBOL__Id } from "__DOMAIN_PACKAGE__/schemas";

import { __SYMBOL__Client } from "../src/service.js";
import { __SYMBOL__ClientTest } from "../src/test.layer.js";
import { __SYMBOL__ClientLive } from "../src/live.layer.js";
import { __SYMBOL__HttpLayer } from "../src/server.js";

describe("__SYMBOL__ RPC", () => {
  it.effect("lists through the in-process client", () =>
    Effect.gen(function* () {
      const client = yield* __SYMBOL__Client;
      const items = yield* client.list();
      assert.isArray(items);
    }).pipe(Effect.provide(__SYMBOL__ClientTest.pipe(Layer.provide(__DOMAIN_SYMBOL__Live)))),
  );

  it.effect("native HTTP serialization preserves success and tagged error classes", () =>
    Effect.gen(function* () {
      const handler = yield* HttpRouter.toHttpEffect(__SYMBOL__HttpLayer.pipe(Layer.provide(__DOMAIN_SYMBOL__Live)));
      const scope = yield* Effect.scope;
      const transport = HttpClient.make((request) => handler.pipe(
        Effect.provideService(HttpServerRequest.HttpServerRequest, HttpServerRequest.fromClientRequest(request)),
        Effect.map((response) => HttpServerResponse.toClientResponse(response, { request })),
        Effect.orDie,
        Effect.provideService(Scope.Scope, scope),
      ));
      yield* Effect.gen(function* () {
        const client = yield* __SYMBOL__Client;
        assert.deepEqual(yield* client.list(), []);
        const missing = yield* client.get(__DOMAIN_SYMBOL__Id.make("missing")).pipe(Effect.result);
        assert.isTrue(Result.isFailure(missing));
        if (Result.isFailure(missing)) assert.instanceOf(missing.failure, __DOMAIN_SYMBOL__NotFoundError);
      }).pipe(Effect.provide(__SYMBOL__ClientLive(__DOMAIN_SYMBOL__ApiOrigin.make("https://api.example.com")).pipe(
        Layer.provide(Layer.succeed(HttpClient.HttpClient, transport)),
      )));
    }).pipe(Effect.scoped),
  );
  it.effect("rejects broken JSON and schema-invalid native RPC replies as named errors", () =>
    Effect.gen(function* () {
      const RequestId = Schema.Union([Schema.String, Schema.Number]);
      const invalidFrame = Schema.fromJsonString(Schema.Struct({
        _tag: Schema.Literal("Exit"), requestId: RequestId,
        exit: Schema.Struct({ _tag: Schema.Literal("Success"), value: Schema.Literal("invalid") }),
      }));
      const invalidReplies: readonly ("json" | "schema")[] = ["json", "schema"];
      yield* Effect.forEach(invalidReplies, (invalid) => Effect.gen(function* () {
        const transport = HttpClient.make((request) => Effect.gen(function* () {
          const input = yield* HttpServerRequest.fromClientRequest(request).text.pipe(
            Effect.flatMap(Schema.decodeEffect(Schema.fromJsonString(Schema.Struct({ id: RequestId })))),
          );
          const wire = invalid === "json" ? "{" : yield* Schema.encodeEffect(invalidFrame)({
            _tag: "Exit", requestId: input.id, exit: { _tag: "Success", value: "invalid" },
          });
          return HttpServerResponse.toClientResponse(HttpServerResponse.text(wire + "\n", { contentType: "application/ndjson" }), { request });
        }).pipe(Effect.orDie));
        yield* Effect.gen(function* () {
          const client = yield* __SYMBOL__Client;
          const operations: readonly ("get" | "list")[] = ["get", "list"];
          yield* Effect.forEach(operations, (operation) => Effect.gen(function* () {
            const read = operation === "get" ? client.get(__DOMAIN_SYMBOL__Id.make("example")).pipe(Effect.asVoid) : client.list().pipe(Effect.asVoid);
            const result = yield* read.pipe(Effect.result);
            assert.isTrue(Result.isFailure(result));
            if (Result.isFailure(result)) {
              assert.isTrue(Schema.is(Invalid__DOMAIN_SYMBOL__ResponseError)(result.failure));
              if (Schema.is(Invalid__DOMAIN_SYMBOL__ResponseError)(result.failure)) assert.strictEqual(result.failure.operation, operation);
            }
          }), { concurrency: 1, discard: true });
        }).pipe(Effect.provide(__SYMBOL__ClientLive(__DOMAIN_SYMBOL__ApiOrigin.make("https://api.example.com")).pipe(
          Layer.provide(Layer.succeed(HttpClient.HttpClient, transport)),
        )));
      }), { concurrency: 1, discard: true });
    }),
  );

  it.effect("keeps an unexpected adapter defect outside the expected error union", () =>
    Effect.gen(function* () {
      const marker = "unexpected-native-rpc-defect";
      const transport = HttpClient.make(() => Effect.die(marker));
      yield* Effect.gen(function* () {
        const client = yield* __SYMBOL__Client;
        const operations: readonly ("get" | "list")[] = ["get", "list"];
        yield* Effect.forEach(operations, (operation) => Effect.gen(function* () {
          const read = operation === "get" ? client.get(__DOMAIN_SYMBOL__Id.make("example")).pipe(Effect.asVoid) : client.list().pipe(Effect.asVoid);
          const exit = yield* read.pipe(Effect.exit);
          assert.isTrue(Exit.isFailure(exit));
          if (Exit.isFailure(exit)) {
            assert.isTrue(Cause.hasDies(exit.cause));
            assert.isFalse(Cause.hasFails(exit.cause));
            assert.isTrue(Result.match(Cause.findDie(exit.cause), { onFailure: () => false, onSuccess: (reason) => reason.defect === marker }));
          }
        }), { concurrency: 1, discard: true });
      }).pipe(Effect.provide(__SYMBOL__ClientLive(__DOMAIN_SYMBOL__ApiOrigin.make("https://api.example.com")).pipe(
        Layer.provide(Layer.succeed(HttpClient.HttpClient, transport)),
      )));
    }),
  );

  it.effect("preserves an unrelated adapter SchemaError by exact defect identity", () =>
    Effect.gen(function* () {
      const original = yield* Schema.decodeUnknownEffect(Schema.String)(123).pipe(Effect.flip);
      const transport = HttpClient.make(() => Effect.die(original));
      yield* Effect.gen(function* () {
        const client = yield* __SYMBOL__Client;
        const operations: readonly ("get" | "list")[] = ["get", "list"];
        yield* Effect.forEach(operations, (operation) => Effect.gen(function* () {
          const read = operation === "get" ? client.get(__DOMAIN_SYMBOL__Id.make("example")).pipe(Effect.asVoid) : client.list().pipe(Effect.asVoid);
          const exit = yield* read.pipe(Effect.exit);
          assert.isTrue(Exit.isFailure(exit));
          if (Exit.isFailure(exit)) {
            assert.isTrue(Cause.hasDies(exit.cause));
            assert.isFalse(Cause.hasFails(exit.cause));
            assert.isTrue(Result.match(Cause.findDie(exit.cause), {
              onFailure: () => false,
              onSuccess: (reason) => reason.defect === original,
            }));
          }
        }), { concurrency: 1, discard: true });
      }).pipe(Effect.provide(__SYMBOL__ClientLive(__DOMAIN_SYMBOL__ApiOrigin.make("https://api.example.com")).pipe(
        Layer.provide(Layer.succeed(HttpClient.HttpClient, transport)),
      )));
    }),
  );
});
