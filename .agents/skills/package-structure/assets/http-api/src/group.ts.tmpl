import { __DOMAIN_SYMBOL__NotFoundError, __DOMAIN_SYMBOL__UnavailableError, Invalid__DOMAIN_SYMBOL__ResponseError } from "__DOMAIN_PACKAGE__/errors";
import { __DOMAIN_SYMBOL__Item } from "__DOMAIN_PACKAGE__/schemas";
import { Schema } from "effect";
import {
  HttpApiEndpoint as EffectHttpApiEndpoint,
  HttpApiGroup as EffectHttpApiGroup,
  HttpApiSchema as EffectHttpApiSchema,
} from "effect/unstable/httpapi";

const AccessError = Schema.Union([
  __DOMAIN_SYMBOL__NotFoundError.pipe(EffectHttpApiSchema.status(404)),
  __DOMAIN_SYMBOL__UnavailableError.pipe(EffectHttpApiSchema.status(503)),
  Invalid__DOMAIN_SYMBOL__ResponseError.pipe(EffectHttpApiSchema.status(502)),
]);


export const __SYMBOL__Group = EffectHttpApiGroup.make("domain")
  .add(
    EffectHttpApiEndpoint.get("list", "/api/items", {
      success: Schema.Array(__DOMAIN_SYMBOL__Item),
      error: AccessError,
    }),
  )
  .add(
    EffectHttpApiEndpoint.get("get", "/api/items/:id", {
      error: AccessError,
      params: Schema.Struct({ id: __DOMAIN_SYMBOL__Item.fields.id }),
      success: __DOMAIN_SYMBOL__Item,
    }),
  );
