import { assert, it } from "@effect/vitest";
import { __DOMAIN_SYMBOL__Live } from "__DOMAIN_PACKAGE__/live";
import { __DOMAIN_SYMBOL__NotFoundError, Invalid__DOMAIN_SYMBOL__ResponseError } from "__DOMAIN_PACKAGE__/errors";
import { __DOMAIN_SYMBOL__ApiOrigin, __DOMAIN_SYMBOL__Id } from "__DOMAIN_PACKAGE__/schemas";
import { __DOMAIN_SYMBOL__Service } from "__DOMAIN_PACKAGE__/service";
import { Effect, Layer, Result, Schema } from "effect";
import { HttpClient, HttpServer, HttpServerResponse } from "effect/unstable/http";
import { HttpApiTest } from "effect/unstable/httpapi";
import { __SYMBOL__Api } from "../src/api.js";
import { __SYMBOL__HandlersLive } from "../src/handlers.js";
import { __SYMBOL__ClientLive } from "../src/client/live.layer.js";

it.effect("native handlers and clients round-trip success and tagged errors", () => Effect.gen(function* () {
  const client = yield* HttpApiTest.groups(__SYMBOL__Api, ["domain"]);
  assert.deepEqual(yield* client.domain.list({}), []);
  const missing = yield* client.domain.get({ params: { id: __DOMAIN_SYMBOL__Id.make("missing") } }).pipe(Effect.result);
  assert.isTrue(Result.isFailure(missing));
  if (Result.isFailure(missing)) {
    assert.instanceOf(missing.failure, __DOMAIN_SYMBOL__NotFoundError);
  }
}).pipe(Effect.scoped, Effect.provide(__SYMBOL__HandlersLive.pipe(Layer.provide(__DOMAIN_SYMBOL__Live))), Effect.provide(HttpServer.layerServices)));

it.effect("the semantic client rejects an invalid wire response", () => Effect.gen(function* () {
  yield* Effect.forEach(["{", "null"], (wire) => Effect.gen(function* () {
    const transport = HttpClient.make((request) => Effect.succeed(HttpServerResponse.toClientResponse(HttpServerResponse.text(wire, { contentType: "application/json" }), { request })));
    yield* Effect.gen(function* () {
      const client = yield* __DOMAIN_SYMBOL__Service;
      const operations: readonly ("get" | "list")[] = ["get", "list"];
      yield* Effect.forEach(operations, (operation) => Effect.gen(function* () {
        const read = operation === "get" ? client.get(__DOMAIN_SYMBOL__Id.make("example")).pipe(Effect.asVoid) : client.list().pipe(Effect.asVoid);
        const result = yield* read.pipe(Effect.result);
        assert.isTrue(Result.isFailure(result));
        if (Result.isFailure(result)) {
          assert.isTrue(Schema.is(Invalid__DOMAIN_SYMBOL__ResponseError)(result.failure));
          if (Schema.is(Invalid__DOMAIN_SYMBOL__ResponseError)(result.failure)) assert.strictEqual(result.failure.operation, operation);
        }
      }), { concurrency: 1, discard: true });
    }).pipe(Effect.provide(__SYMBOL__ClientLive({ baseUrl: __DOMAIN_SYMBOL__ApiOrigin.make("https://api.example.com") }).pipe(Layer.provide(Layer.succeed(HttpClient.HttpClient, transport)))));
  }), { concurrency: 1, discard: true });
}));
