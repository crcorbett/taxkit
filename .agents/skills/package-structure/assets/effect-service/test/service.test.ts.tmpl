import { assert, describe, it } from "@effect/vitest";
import { Effect, Schema } from "effect";
import { __SYMBOL__NotFoundError } from "../src/errors.js";

import { example__SYMBOL__ } from "../src/__testing__/fixtures.js";
import { __SYMBOL__Service } from "../src/service.js";
import { __SYMBOL__Id } from "../src/schemas.js";
import { make__SYMBOL__Test } from "../src/test.layer.js";

describe("__SYMBOL__Service", () => {
  it.effect("uses the deterministic Layer", () =>
    Effect.gen(function* () {
      const example = yield* example__SYMBOL__;
      const setup = yield* make__SYMBOL__Test([example]);
      const item = yield* Effect.gen(function* () {
        const service = yield* __SYMBOL__Service;
        return yield* service.get(example.id);
      }).pipe(Effect.provide(setup.layer));
      assert.strictEqual(item.name, "Example");
      const missingId = yield* __SYMBOL__Id.makeEffect("missing");
      const missing = yield* Effect.gen(function* () {
        const service = yield* __SYMBOL__Service;
        return yield* service.get(missingId).pipe(Effect.flip);
      }).pipe(Effect.provide(setup.layer));
      assert.strictEqual(missing._tag, "__SYMBOL__NotFoundError");
      assert.isTrue(Schema.is(__SYMBOL__NotFoundError)(missing));
      if (Schema.is(__SYMBOL__NotFoundError)(missing)) assert.strictEqual(missing.id, missingId);
    }),
  );
});
