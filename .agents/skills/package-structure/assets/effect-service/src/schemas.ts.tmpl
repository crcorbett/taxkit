import { Duration, Result, Schema } from "effect";

import { Url } from "effect/unstable/http";

export const __SYMBOL__Id = Schema.Trimmed.check(Schema.isMinLength(1), Schema.isMaxLength(128)).pipe(
  Schema.brand("__SYMBOL__Id"),
);
export type __SYMBOL__Id = typeof __SYMBOL__Id.Type;

export const __SYMBOL__Name = Schema.Trimmed.check(Schema.isMinLength(1), Schema.isMaxLength(200)).pipe(
  Schema.brand("__SYMBOL__Name"),
);
export type __SYMBOL__Name = typeof __SYMBOL__Name.Type;

export const __SYMBOL__Item = Schema.Struct({
  id: __SYMBOL__Id,
  name: __SYMBOL__Name,
});
export type __SYMBOL__Item = typeof __SYMBOL__Item.Type;

// Shared checked address and deadline for this domain's remote access examples.
export const __SYMBOL__ApiOrigin = Schema.String.check(Schema.makeFilter((input) =>
  Result.match(Url.fromString(input), {
    onFailure: () => false,
    onSuccess: (url) => (url.protocol === "http:" || url.protocol === "https:") &&
      url.origin === input && url.username === "" && url.password === "",
  }),
)).pipe(Schema.brand("__SYMBOL__ApiOrigin"));
export type __SYMBOL__ApiOrigin = typeof __SYMBOL__ApiOrigin.Type;
// This small-read example has no render deadline. Qualify this budget for real work.
export const __SYMBOL__ClientDeadline = Duration.seconds(10);
