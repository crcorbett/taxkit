import { Array, Effect, Layer, Ref } from "effect";

import { __SYMBOL__NotFoundError } from "./errors.js";
import type { __SYMBOL__Id, __SYMBOL__Item } from "./schemas.js";
import { __SYMBOL__Service } from "./service.js";

export const make__SYMBOL__Test = Effect.fnUntraced(function* (items: readonly __SYMBOL__Item[]) {
    const requested = yield* Ref.make<readonly __SYMBOL__Id[]>([]);
    const layer = Layer.succeed(
      __SYMBOL__Service,
      __SYMBOL__Service.of({
        get: Effect.fn("__SYMBOL__Service.get")(function* (id: __SYMBOL__Id) {
          yield* Ref.update(requested, Array.append(id));
          return yield* Array.findFirst(items, (item) => item.id === id).pipe(
            Effect.fromOption,
            Effect.mapError(() => new __SYMBOL__NotFoundError({ id })),
          );
        }),
        list: Effect.fn("__SYMBOL__Service.list")(() => Effect.succeed(items)),
      }),
    );
    return { layer, observations: { requested } };
});
