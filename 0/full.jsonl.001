"35647"],["kill","35850"],["kill","54300"],["kill","64632"],["kill","74025"],["kill","86592"],["kill","9293"],["kill","9768"],["node","-e","const {chromium}=require(\"playwright\"); (async()=>{const browser=await chromium.launch({headless:true,executablePath:\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\"}); const configs=[{w:736,scheme:\"light\",path:\"/Users/cooper/Library/CloudStorage/OneDrive-SharedLibraries-TILTLegal/Internal - Documents/Agentic AI for Legal Work/visualisations/2026.08.22 — TPG Legal — Proposal Structure and Length — desktop.png\"},{w:360,scheme:\"dark\",path:\"/Users/cooper/Library/CloudStorage/OneDrive-SharedLibraries-TILTLegal/Internal - Documents/Agentic AI for Legal Work/visualisations/2026.08.22 — TPG Legal — Proposal Structure and Length — mobile.png\"}]; for(const cfg of configs){const page=await browser.newPage({viewport:{width:cfg.w,height:1200},colorScheme:cfg.scheme}); await page.goto(\"file:///private/tmp/tpg-proposal-structure-preview.html\"); await page.waitForTimeout(500); const frame=page.frames()[1]; if(!frame) throw new Error(\"visual frame missing\"); await frame.waitForSelector(\"#allocation-chart svg\"); const height=await frame.evaluate(()=>Math.ceil(document.documentElement.scrollHeight)); await page.setViewportSize({width:cfg.w,height:Math.max(1200,height)}); await page.locator(\"iframe\").evaluate((el,h)=>{el.style.height=h+\"px\"},height); await page.locator(\"iframe\").screenshot({path:cfg.path}); console.log(JSON.stringify({path:cfg.path,width:cfg.w,height})); await page.close();} await browser.close();})().catch(e=>{console.error(e);process.exit(1)})"],["pgrep","-fl"],["playwriter"],["pnpm","--filter","@ai/steps","exec","tsx"],["pnpm","--filter","@frontend/queries","test"],["pnpm","--filter","admin","dev:local"],["pnpm","--filter","admin","test"],["pnpm","--filter","api","run","dev:local"],["pnpm","--filter","app-start","run","dev:local"],["pnpm","--filter=@backend/http-api","exec","vitest"],["pnpm","--filter=@mobius/exports","exec","tsx","--conditions=@mobius/source","-e","import { evidenceMatrixInputDataStructureHash } from './src/document-generation/input-data.ts'; console.log(evidenceMatrixInputDataStructureHash());"],["pnpm","--filter=@mobius/exports","exec","tsx","--conditions=@mobius/source","-e","import { writeFile } from 'node:fs/promises'; import JSZip from 'jszip'; const successScript = String.raw\\`import json\\nimport zipfile\\nfrom pathlib import Path\\nfrom docx import Document\\ninput_path = Path('./inputs/input_data.json')\\ncontext_path = Path('./inputs/context.json')\\noutput_path = Path('./outputs/document.docx')\\nresult_path = Path('./outputs/result.json')\\ntemplate_path = Path('./templates/evidence-matrix-template.docx')\\nif not template_path.exists() or not zipfile.is_zipfile(template_path):\\n    raise FileNotFoundError('Expected a valid DOCX template in templates/')\\ninput_data = json.loads(input_path.read_text())\\ncontext = json.loads(context_path.read_text())\\ndocument = Document()\\ndocument.add_heading('Browser Evidence Matrix', level=1)\\ndocument.add_paragraph(f\\\"Container: {input_data['container']['name']}\\\")\\ndocument.add_paragraph(f\\\"Document type: {context['documentType']}\\\")\\ndocument.add_paragraph(f\\\"Bundle hash: {context['bundleSha256']}\\\")\\nfor allegation in input_data['allegations']:\\n    document.add_heading(allegation['title'], level=2)\\n    document.add_paragraph(allegation.get('description', ''))\\nfor evidence in input_data['evidence']:\\n    document.add_paragraph(evidence['excerpt'])\\noutput_path.parent.mkdir(parents=True, exist_ok=True)\\ndocument.save(output_path)\\nresult_path.write_text(json.dumps({'status':'success','docxPath':'./outputs/document.docx','mimeType':'application/vnd.openxmlformats-officedocument.wordprocessingml.document','sizeBytes': output_path.stat().st_size}))\\n\\`; const template = new JSZip(); template.file('[Content_Types].xml', '<?xml version=1.0 encoding=UTF-8 standalone=yes?><Types xmlns=http://schemas.openxmlformats.org/package/2006/content-types><Default Extension=rels ContentType=application/vnd.openxmlformats-package.relationships+xml/><Default Extension=xml ContentType=application/xml/><Override PartName=/word/document.xml ContentType=application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml/></Types>'); template.file('_rels/.rels', '<?xml version=1.0 encoding=UTF-8 standalone=yes?><Relationships xmlns=http://schemas.openxmlformats.org/package/2006/relationships><Relationship Id=rId1 Type=http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument Target=word/document.xml/></Relationships>'); template.file('word/document.xml', '<?xml version=1.0 encoding=UTF-8 standalone=yes?><w:document xmlns:w=http://schemas.openxmlformats.org/wordprocessingml/2006/main><w:body><w:p><w:r><w:t>Evidence matrix browser template</w:t></w:r></w:p><w:sectPr/></w:body></w:document>'); const templateBytes = await template.generateAsync({ type: 'uint8array', compression: 'DEFLATE' }); const bundle = new JSZip(); bundle.file('scripts/generate.py', successScript); bundle.file('templates/evidence-matrix-template.docx', templateBytes); const bytes = await bundle.generateAsync({ type: 'uint8array', compression: 'DEFLATE' }); await writeFile('/private/tmp/mobius-evidence-matrix-browser-bundle.zip', bytes); console.log('/private/tmp/mobius-evidence-matrix-browser-bundle.zip', bytes.byteLength);"],["pnpm","--filter=@mobius/exports","exec","tsx","-e","import { evidenceMatrixInputDataStructureHash } from './src/document-generation/input-data.ts'; console.log(evidenceMatrixInputDataStructureHash());"],["pnpm","--filter=@mobius/exports","test:integration"],["pnpm","--filter=@tech-diagnostic/http-api","test"],["pnpm","--filter=admin","test","--","src/lib/components/configs/catalog-state.test.ts"],["pnpm","--filter=admin","test","--","src/lib/components/configs/document-generation-bundle.browser.test.tsx"],[