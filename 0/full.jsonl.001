es and disposes\",\n    () =>\n      Effect.gen(function* () {\n        const count = Atom.make(42);\n        const disposed = vi.fn();\n        const captured = vi.fn();\n        const hydrated = vi.fn();\n        const errors = vi.fn();\n        const resource = Atom.make((get) => {\n          get.addFinalizer(disposed);\n          return \"mounted\";\n        });\n        const Counter = () => {\n          const [value, setValue] = useAtom(count);\n          useEffect(() => {\n            hydrated();\n          }, []);\n          return (\n            <button onClick={() => setValue((n) => n + 1)} type=\"button\">\n              {value}\n            </button>\n          );\n        };\n        const Resource = () => {\n          const registry = useContext(RegistryContext);\n          const value = useAtomValue(resource);\n          useEffect(() => {\n            captured(registry);\n          }, [registry]);\n          return <span>{value}</span>;\n        };\n\n        yield* Effect.scoped(\n          Effect.gen(function* () {\n            // Browser test host: React owns DOM writes and registry scheduling. The\n            // Effect scope owns root/host teardown even when an assertion fails.\n            const host = yield* Effect.acquireRelease(\n              Effect.sync(() => {\n                const element = document.createElement(\"div\");\n                element.insertAdjacentHTML(\n                  \"afterbegin\",\n                  renderToString(\n                    <AtomHarness>\n                      <Counter />\n                    </AtomHarness>\n                  )\n                );\n                document.body.append(element);\n                return element;\n              }),\n              (element) => Effect.sync(() => element.remove())\n            );\n            expect(host.textContent).toBe(\"42\");\n            const root = yield* Effect.acquireRelease(\n              Effect.sync(() =>\n                hydrateRoot(\n                  host,\n                  <AtomHarness>\n                    <Counter />\n                  </AtomHarness>,\n                  {\n                    onRecoverableError: errors,\n                    onUncaughtError: errors,\n                  }\n                )\n              ),\n              (reactRoot) => Effect.sync(() => reactRoot.unmount())\n            );\n            yield* Effect.promise(() =>\n              expect.poll(() => hydrated.mock.calls.length).toBeGreaterThan(0)\n            );\n            root.render(\n              <AtomHarness>\n                <Counter />\n                <Resource />\n              </AtomHarness>\n            );\n            yield* Effect.promise(() =>\n              expect.poll(() => captured.mock.calls.length).toBe(2)\n            );\n            expect(\n              EffectArray.dedupe(\n                EffectArray.map(captured.mock.calls, ([registry]) => registry)\n              )\n            ).toHaveLength(1);\n            const button = yield* Option.fromNullishOr(\n              host.querySelector(\"button\")\n            ).pipe(\n              Option.match({\n                onNone: () =>\n                  Effect.die(\n                    new Error(\"The hydrated counter button is missing\")\n                  ),\n                onSome: Effect.succeed,\n              })\n            );\n            yield* Effect.forEach(\n              EffectArray.range(1, 50),\n              () => Effect.sync(() => button.click()),\n              { discard: true }\n            );\n            yield* Effect.promise(() =>\n              expect.poll(() => button.textContent).toBe(\"92\")\n            );\n            expect(errors).not.toHaveBeenCalled();\n            expect(disposed).not.toHaveBeenCalled();\n          })\n        );\n        yield* Effect.promise(() =>\n          expect\n            .poll(() => disposed.mock.calls.length, { timeout: 2000 })\n            .toBe(1)\n        );\n      })\n  );\n});\nsed: node_modules/@effect/atom-react/src/RegistryContext.ts: No such file or directory\nsed: node_modules/@effect/atom-react/src/Hooks.ts: No such file or directory\n{\n  \"name\": \"web\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"imports\": {\n    \"#/*\": \"./src/*\"\n  },\n  \"scripts\": {\n    \"dev\": \"TAXKIT_API_BASE_URL=$(portless get api.taxkit) VITE_TAXKIT_API_BASE_URL=$(portless get api.taxkit) portless run --name taxkit vite dev\",\n    \"build\": \"vite build\",\n    \"check-types\": \"tsc --noEmit\",\n    \"clean\": \"rm -rf .output .tanstack .turbo node_modules/.vite\",\n    \"test:browser\": \"vitest run --config vitest.browser.config.ts\",\n    \"test\": \"bun --bun vitest run\"\n  },\n  \"dependencies\": {\n    \"@tanstack/react-router\": \"catalog:\",\n    \"@tanstack/react-start\": \"catalog:\",\n    \"@taxkit/api-http\": \"workspace:*\",\n    \"effect\": \"catalog:\",\n    \"react\": \"catalog:\",\n    \"react-dom\": \"catalog:\"\n  },\n  \"devDependencies\": {\n    \"@effect/atom-react\": \"4.0.0\",\n    \"@effect/vitest\": \"catalog:\",\n    \"@types/node\": \"catalog:\",\n    \"@types/react\": \"catalog:\",\n    \"@types/react-dom\": \"catalog:\",\n    \"@vitejs/plugin-react\": \"catalog:\",\n    \"@vitest/browser-playwright\": \"5.0.3\",\n    \"nitro\": \"catalog:\",\n    \"playwright\": \"1.63.0\",\n    \"scheduler\": \"0.28.0\",\n    \"typescript\": \"catalog:\",\n    \"vite\": \"catalog:\",\n    \"vitest\": \"catalog:\"\n  }\n}\n"},"started_at_ms":1791132158800,"completed_at_ms":1791132158800}}
