{"timestamp":"2026-10-04T16:13:41.273Z","ordinal":14542,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","item":{"type":"CommandExecution","id":"exec-73c98bb6-e242-4ab6-9971-4f1fd0861521","process_id":"60135","command":["/bin/zsh","-lc","cat packages/api/http/src/config.ts packages/api/http/src/client/live.layer.ts packages/api/http/src/client/server.layer.ts; sed -n '5270,5288p' node_modules/effect/src/Schema.ts; cat packages/docs-content/src/service.ts; cat packages/api/rpc/README.md"],"cwd":"file:///Users/cooper/.codex/worktrees/aac7/taxkit","parsed_cmd":[{"type":"unknown","cmd":"cat packages/api/http/src/config.ts packages/api/http/src/client/live.layer.ts packages/api/http/src/client/server.layer.ts; sed -n '5270,5288p' node_modules/effect/src/Schema.ts; cat packages/docs-content/src/service.ts; cat packages/api/rpc/README.md"}],"source":"unified_exec_startup","status":"completed","stdout":"import { Config, Schema } from \"effect\";\n\nexport const TaxKitHttpApiClientConfigSchema = Schema.Struct({\n  baseUrl: Schema.URLFromString,\n});\n\nexport type TaxKitHttpApiClientConfig = Schema.Schema.Type<\n  typeof TaxKitHttpApiClientConfigSchema\n>;\n\nexport interface TaxKitHttpApiConfig {\n  readonly httpApi: TaxKitHttpApiClientConfig;\n}\n\nconst HttpApiClientConfig = Config.all({\n  baseUrl: Config.URL(\"BASE_URL\"),\n}).pipe(Config.map(TaxKitHttpApiClientConfigSchema.make));\n\nexport const TaxKitHttpApiConfig = {\n  httpApi: HttpApiClientConfig,\n} satisfies Config.Wrap<TaxKitHttpApiConfig>;\n\nexport const TaxKitHttpApiServerEnvConfig = {\n  httpApi: HttpApiClientConfig.pipe(Config.nested(\"TAXKIT_API\")),\n} satisfies Config.Wrap<TaxKitHttpApiConfig>;\n\nexport const TaxKitHttpApiViteEnvConfig = {\n  httpApi: HttpApiClientConfig.pipe(Config.nested(\"VITE_TAXKIT_API\")),\n} satisfies Config.Wrap<TaxKitHttpApiConfig>;\nimport { Layer } from \"effect\";\nimport type { HttpClient } from \"effect/http/HttpClient\";\n\nimport { createTaxKitApiClient } from \"./index.js\";\nimport { TaxKitHttpApiService } from \"./service.js\";\n\nexport interface MakeTaxKitApiClientLayerOptions {\n  readonly baseUrl?: URL | string | undefined;\n  readonly transformClient?: (client: HttpClient) => HttpClient;\n}\n\nexport const createTaxKitApiClientLayer = (\n  options: MakeTaxKitApiClientLayerOptions = {}\n) => Layer.effect(TaxKitHttpApiService, createTaxKitApiClient(options));\n\n/** @deprecated Use `createTaxKitApiClientLayer`. */\nexport const makeTaxKitApiClientLayer = (\n  options: MakeTaxKitApiClientLayerOptions = {}\n) => createTaxKitApiClientLayer(options);\nimport { Context } from \"effect\";\nimport * as HttpRouter from \"effect/http/HttpRouter\";\n\nimport { TaxKitServerLayer } from \"../server.js\";\nimport { createTaxKitApiInProcessClientLayer } from \"./in-process.layer.js\";\n\nconst { handler } = HttpRouter.toWebHandler(TaxKitServerLayer);\n\nexport const TaxKitApiInProcessClientLive = createTaxKitApiInProcessClientLayer(\n  (request) => handler(request, Context.empty())\n);\n * @see {@link catchEncoding} for a simpler error-recovery variant\n * @category encoding\n * @since 4.0.0\n */\nexport function middlewareEncoding<S extends Constraint, RE>(\n  encode: (\n    effect: Effect.Effect<Option_.Option<S[\"Encoded\"]>, SchemaIssue.Issue, S[\"EncodingServices\"]>,\n    options: SchemaAST.ParseOptions\n  ) => Effect.Effect<Option_.Option<S[\"Encoded\"]>, SchemaIssue.Issue, RE>\n) {\n  return (schema: S): middlewareEncoding<S, RE> =>\n    make(\n      SchemaAST.middlewareEncoding(schema.ast, new SchemaTransformation.Middleware(identity, encode)),\n      { schema }\n    )\n}\n/**\n * Recovers from a decoding error by providing a fallback value.\n *\nimport { Context } from \"effect\";\nimport type { Effect } from \"effect\";\n\nimport type { DocsPageNotFoundError, DocsSourceError } from \"./errors.js\";\nimport type {\n  DocsContentPage,\n  DocsNavigation,\n  DocsPagePath,\n  DocsValidationResult,\n} from \"./schemas.js\";\n\nexport interface DocsContentServiceContract {\n  readonly getNavigation: () => Effect.Effect<DocsNavigation, DocsSourceError>;\n  readonly getPage: (\n    path: DocsPagePath\n  ) => Effect.Effect<DocsContentPage, DocsPageNotFoundError | DocsSourceError>;\n  readonly listPages: () => Effect.Effect<\n    readonly DocsContentPage[],\n    DocsSourceError\n  >;\n  readonly validateContent: () => Effect.Effect<\n    DocsValidationResult,\n    DocsSourceError\n  >;\n}\n\nexport class DocsContentService extends Context.Service<\n  DocsContentService,\n  DocsContentServiceContract\n>()(\"@taxkit/docs-content/DocsContentService\") {}\n# `@taxkit/api-rpc`\n\nNative reply validation must also become a named invalid-response error. In the\nqualified rc.117, an invalid RPC payload can arrive as a SchemaError defect.\nThe private client marks failure only inside the native exit reply codec's\ndecoder, then translates that marker to its named invalid-response error. It\nkeeps the native Schemas, Ndjson parser, Protocol and client. It never treats\nevery SchemaError as a bad reply: transport and request-encoding defects retain\ntheir original identity, and caller interruption remains interruption. Tests\ncover bad native replies and an unrelated adapter SchemaError for both reads.\nRequalify the cached exit Schema identity and decoder behaviour on Effect\nupgrades before retaining or removing this small compatibility handling.\n\nEffect RPC transport over `@taxkit/calculators`. `Calculators` policy remains in the\ndomain service; this package owns the RPC contract, handlers, clients, and HTTP\nmounting.\n\n## Exports\n\n- `./group`: public RPC contract group.\n- `./handlers`: server handler Layer.\n- `./service`: public RPC client service contract.\n- `./server`: HTTP/RPC server composition.\n- `./live`: production client Layer.\n- `./test`: deterministic in-process test Layer.\n\n## Documentation impact\n\nPublic RPC changes update the repository transport architecture owner and\naffected critical journeys/proof in the same slice.\n\n## Runbook applicability\n\nProvider operations, authority, and runbooks remain repository-owned. Add or\nupdate a target-owned runbook only when an operation or deployment changes.\n\n## Non-claims\n\nThis package makes no deployment, provider-state, network-reachability, or\npacked-publisher claim.\n\nThe client implements the existing domain service and preserves its checked\nerror vocabulary. The caller supplies its checked stage API origin and native\nHttpClient. Each complete read has one domain-owned deadline; no automatic retry.\n","stderr":"","aggregated_output":"import { Config, Schema } from \"effect\";\n\nexport const TaxKitHttpApiClientConfigSchema = Schema.Struct({\n  baseUrl: Schema.URLFromString,\n});\n\nexport type TaxKitHttpApiClientConfig = Schema.Schema.Type<\n  typeof TaxKitHttpApiClientConfigSchema\n>;\n\nexport interface TaxKitHttpApiConfig {\n  readonly httpApi: TaxKitHttpApiClientConfig;\n}\n\nconst HttpApiClientConfig = Config.all({\n  baseUrl: Config.URL(\"BASE_URL\"),\n}).pipe(Config.map(TaxKitHttpApiClientConfigSchema.make));\n\nexport const TaxKitHttpApiConfig = {\n  httpApi: HttpApiClientConfig,\n} satisfies Config.Wrap<TaxKitHttpApiConfig>;\n\nexport const TaxKitHttpApiServerEnvConfig = {\n  httpApi: HttpApiClientConfig.pipe(Config.nested(\"TAXKIT_API\")),\n} satisfies Config.Wrap<TaxKitHttpApiConfig>;\n\nexport const TaxKitHttpApiViteEnvConfig = {\n  httpApi: HttpApiClientConfig.pipe(Config.nested(\"VITE_TAXKIT_API\")),\n} satisfies Config.Wrap<TaxKitHttpApiConfig>;\nimport { Layer } from \"effect\";\nimport type { HttpClient } from \"effect/http/HttpClient\";\n\nimport { createTaxKitApiClient } from \"./index.js\";\nimport { TaxKitHttpApiService } from \"./service.js\";\n\nexport interface MakeTaxKitApiClientLayerOptions {\n  readonly baseUrl?: URL | string | undefined;\n  readonly transformClient?: (client: HttpClient) => HttpClient;\n}\n\nexport const createTaxKitApiClientLayer = (\n  options: MakeTaxKitApiClientLayerOptions = {}\n) => Layer.effect(TaxKitHttpApiService, createTaxKitApiClient(options));\n\n/** @deprecated Use `createTaxKitApiClientLayer`. */\nexport const makeTaxKitApiClientLayer = (\n  options: MakeTaxKitApiClientLayerOptions = {}\n) => createTaxKitApiClientLayer(options);\nimport { Context } from \"effect\";\nimport * as HttpRouter from \"effect/http/HttpRouter\";\n\nimport { TaxKitServerLayer } from \"../server.js\";\nimport { createTaxKitApiInProcessClientLayer } from \"./in-process.layer.js\";\n\nconst { handler } = HttpRouter.toWebHandler(TaxKitServerLayer);\n\nexport const TaxKitApiInProcessClientLive = createTaxKitApiInProcessClientLayer(\n  (request) => handler(request, Context.empty())\n);\n * @see {@link catchEncoding} for a simpler error-recovery variant\n * @category encoding\n * @since 4.0.0\n */\nexport function middlewareEncoding<S extends Constraint, RE>(\n  encode: (\n    effect: Effect.Effect<Option_.Option<S[\"Encoded\"]>, SchemaIssue.Issue, S[\"EncodingServices\"]>,\n    options: SchemaAST.ParseOptions\n  ) => Effect.Effect<Option_.Option<S[\"Encoded\"]>, SchemaIssue.Issue, RE>\n) {\n  return (schema: S): middlewareEncoding<S, RE> =>\n    make(\n      SchemaAST.middlewareEncoding(schema.ast, new SchemaTransformation.Middleware(identity, encode)),\n      { schema }\n    )\n}\n/**\n * Recovers from a decoding error by providing a fallback value.\n *\nimport { Context } from \"effect\";\nimport type { Effect } from \"effect\";\n\nimport type { DocsPageNotFoundError, DocsSourceError } from \"./errors.js\";\nimport type {\n  DocsContentPage,\n  DocsNavigation,\n  DocsPagePath,\n  DocsValidationResult,\n} from \"./schemas.js\";\n\nexport interface DocsContentServiceContract {\n  readonly getNavigation: () => Effect.Effect<DocsNavigation, DocsSourceError>;\n  readonly getPage: (\n    path: DocsPagePath\n  ) => Effect.Effect<DocsContentPage, DocsPageNotFoundError | DocsSourceError>;\n  readonly listPages: () => Effect.Effect<\n    readonly DocsContentPage[],\n    DocsSourceError\n  >;\n  readonly validateContent: () => Effect.Effect<\n    DocsValidationResult,\n    DocsSourceError\n  >;\n}\n\nexport class DocsContentService extends Context.Service<\n  DocsContentService,\n  DocsContentServiceContract\n>()(\"@taxkit/docs-content/DocsContentService\") {}\n# `@taxkit/api-rpc`\n\nNative reply validation must also become a named invalid-response error. In the\nqualified rc.117, an invalid RPC payload can arrive as a SchemaError defect.\nThe private client marks failure only inside the native exit reply codec's\ndecoder, then translates that marker to its named invalid-response error. It\nkeeps the native Schemas, Ndjson parser, Protocol and client. It never treats\nevery SchemaError as a bad reply: transport and request-encoding defects retain\ntheir original identity, and caller interruption remains interruption. Tests\ncover bad native replies and an unrelated adapter SchemaError for both reads.\nRequalify the cached exit Schema identity and decoder behaviour on Effect\nupgrades before retaining or removing this small compatibility handling.\n\nEffect RPC transport over `@taxkit/calculators`. `Calculators` policy remains in the\ndomain service; this package owns the RPC contract, handlers, clients, and HTTP\nmounting.\n\n## Exports\n\n- `./group`: public RPC contract group.\n- `./handlers`: server handler Layer.\n- `./service`: public RPC client service contract.\n- `./server`: HTTP/RPC server composition.\n- `./live`: production client Layer.\n- `./test`: deterministic in-process test Layer.\n\n## Documentation impact\n\nPublic RPC changes update the repository transport architecture owner and\naffected critical journeys/proof in the same slice.\n\n## Runbook applicability\n\nProvider operations, authority, and runbooks remain repository-owned. Add or\nupdate a target-owned runbook only when an operation or deployment changes.\n\n## Non-claims\n\nThis package makes no deployment, provider-state, network-reachability, or\npacked-publisher claim.\n\nThe client implements the existing domain service and preserves its checked\nerror vocabulary. The caller supplies its checked stage API origin and native\nHttpClient. Each complete read has one domain-owned deadline; no automatic retry.\n","exit_code":0,"duration":{"secs":0,"nanos":6417},"formatted_output":"import { Config, Schema } from \"effect\";\n\nexport const TaxKitHttpApiClientConfigSchema = Schema.Struct({\n  baseUrl: Schema.URLFromString,\n});\n\nexport type TaxKitHttpApiClientConfig = Schema.Schema.Type<\n  typeof TaxKitHttpApiClientConfigSchema\n>;\n\nexport interface TaxKitHttpApiConfig {\n  readonly httpApi: TaxKitHttpApiClientConfig;\n}\n\nconst HttpApiClientConfig = Config.all({\n  baseUrl: Config.URL(\"BASE_URL\"),\n}).pipe(Config.map(TaxKitHttpApiClientConfigSchema.make));\n\nexport const TaxKitHttpApiConfig = {\n  httpApi: HttpApiClientConfig,\n} satisfies Config.Wrap<TaxKitHttpApiConfig>;\n\nexport const TaxKitHttpApiServerEnvConfig = {\n  httpApi: HttpApiClientConfig.pipe(Config.nested(\"TAXKIT_API\")),\n} satisfies Config.Wrap<TaxKitHttpApiConfig>;\n\nexport const TaxKitHttpApiViteEnvConfig = {\n  httpApi: HttpApiClientConfig.pipe(Config.nested(\"VITE_TAXKIT_API\")),\n} satisfies Config.Wrap<TaxKitHttpApiConfig>;\nimport { Layer } from \"effect\";\nimport type { HttpClient } from \"effect/http/HttpClient\";\n\nimport { createTaxKitApiClient } from \"./index.js\";\nimport { TaxKitHttpApiService } from \"./service.js\";\n\nexport interface MakeTaxKitApiClientLayerOptions {\n  readonly baseUrl?: URL | string | undefined;\n  readonly transformClient?: (client: HttpClient) => HttpClient;\n}\n\nexport const createTaxKitApiClientLayer = (\n  options: MakeTaxKitApiClientLayerOptions = {}\n) => Layer.effect(TaxKitHttpApiService, createTaxKitApiClient(options));\n\n/** @deprecated Use `createTaxKitApiClientLayer`. */\nexport const makeTaxKitApiClientLayer = (\n  options: MakeTaxKitApiClientLayerOptions = {}\n) => createTaxKitApiClientLayer(options);\nimport { Context } from \"effect\";\nimport * as HttpRouter from \"effect/http/HttpRouter\";\n\nimport { TaxKitServerLayer } from \"../server.js\";\nimport { createTaxKitApiInProcessClientLayer } from \"./in-process.layer.js\";\n\nconst { handler } = HttpRouter.toWebHandler(TaxKitServerLayer);\n\nexport const TaxKitApiInProcessClientLive = createTaxKitApiInProcessClientLayer(\n  (request) => handler(request, Context.empty())\n);\n * @see {@link catchEncoding} for a simpler error-recovery variant\n * @category encoding\n * @since 4.0.0\n */\nexport function middlewareEncoding<S extends Constraint, RE>(\n  encode: (\n    effect: Effect.Effect<Option_.Option<S[\"Encoded\"]>, SchemaIssue.Issue, S[\"EncodingServices\"]>,\n    options: SchemaAST.ParseOptions\n  ) => Effect.Effect<Option_.Option<S[\"Encoded\"]>, SchemaIssue.Issue, RE>\n) {\n  return (schema: S): middlewareEncoding<S, RE> =>\n    make(\n      SchemaAST.middlewareEncoding(schema.ast, new SchemaTransformation.Middleware(identity, encode)),\n      { schema }\n    )\n}\n/**\n * Recovers from a decoding error by providing a fallback value.\n *\nimport { Context } from \"effect\";\nimport type { Effect } from \"effect\";\n\nimport type { DocsPageNotFoundError, DocsSourceError } from \"./errors.js\";\nimport type {\n  DocsContentPage,\n  DocsNavigation,\n  DocsPagePath,\n  DocsValidationResult,\n} from \"./schemas.js\";\n\nexport interface DocsContentServiceContract {\n  readonly getNavigation: () => Effect.Effect<DocsNavigation, DocsSourceError>;\n  readonly getPage: (\n    path: DocsPagePath\n  ) => Effect.Effect<DocsContentPage, DocsPageNotFoundError | DocsSourceError>;\n  readonly listPages: () => Effect.Effect<\n    readonly DocsContentPage[],\n    DocsSourceError\n  >;\n  readonly validateContent: () => Effect.Effect<\n    DocsValidationResult,\n    DocsSourceError\n  >;\n}\n\nexport class DocsContentService extends Context.Service<\n  DocsContentService,\n  DocsContentServiceContract\n>()(\"@taxkit/docs-content/DocsContentService\") {}\n# `@taxkit/api-rpc`\n\nNative reply validation must also become a named invalid-response error. In the\nqualified rc.117, an invalid RPC payload can arrive as a SchemaError defect.\nThe private client marks failure only inside the native exit reply codec's\ndecoder, then translates that marker to its named invalid-response error. It\nkeeps the native Schemas, Ndjson parser, Protocol and client. It never treats\nevery SchemaError as a bad reply: transport and request-encoding defects retain\ntheir original identity, and caller interruption remains interruption. Tests\ncover bad native replies and an unrelated adapter SchemaError for both reads.\nRequalify the cached exit Schema identity and decoder behaviour on Effect\nupgrades before retaining or removing this small compatibility handling.\n\nEffect RPC transport over `@taxkit/calculators`. `Calculators` policy remains in the\ndomain service; this package owns the RPC contract, handlers, clients, and HTTP\nmounting.\n\n## Exports\n\n- `./group`: public RPC contract group.\n- `./handlers`: server handler Layer.\n- `./service`: public RPC client service contract.\n- `./server`: HTTP/RPC server composition.\n- `./live`: production client Layer.\n- `./test`: deterministic in-process test Layer.\n\n## Documentation impact\n\nPublic RPC changes update the repository transport architecture owner and\naffected critical journeys/proof in the same slice.\n\n## Runbook applicability\n\nProvider operations, authority, and runbooks remain repository-owned. Add or\nupdate a target-owned runbook only when an operation or deployment changes.\n\n## Non-claims\n\nThis package makes no deployment, provider-state, network-reachability, or\npacked-publisher claim.\n\nThe client implements the existing domain service and preserves its checked\nerror vocabulary. The caller supplies its checked stage API origin and native\nHttpClient. Each complete read has one domain-owned deadline; no automatic retry.\n"},"started_at_ms":1791130421273,"completed_at_ms":1791130421273}}
{"timestamp":"2026-10-04T16:13:41.320Z","ordinal":14543,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a107b1-4848-7bc1-bdff-cbf27d93d3c2","call_id":"call_kC4DpjzSx6vh1oMAVoD7glZS","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"287cc5\",\"wall_time_seconds\":0.000006417,\"exit_code\":0,\"original_token_count\":1373,\"output\":\"import { Config, Schema } from \\\"effect\\\";\\n\\nexport const TaxKitHttpApiClientConfigSchema = Schema.Struct({\\n  baseUrl: Schema.URLFromString,\\n});\\n\\nexport type TaxKitHttpApiClientConfig = Schema.Schema.Type<\\n  typeof TaxKitHttpApiClientConfigSchema\\n>;\\n\\nexport interface TaxKitHttpApiConfig {\\n  readonly httpApi: TaxKitHttpApiClientConfig;\\n}\\n\\nconst HttpApiClientConfig = Config.all({\\n  baseUrl: Config.URL(\\\"BASE_URL\\\"),\\n}).pipe(Config.map(TaxKitHttpApiClientConfigSchema.make));\\n\\nexport const TaxKitHttpApiConfig = {\\n  httpApi: HttpApiClientConfig,\\n} satisfies Config.Wrap<TaxKitHttpApiConfig>;\\n\\nexport const TaxKitHttpApiServerEnvConfig = {\\n  httpApi: HttpApiClientConfig.pipe(Config.nested(\\\"TAXKIT_API\\\")),\\n} satisfies Config.Wrap<TaxKitHttpApiConfig>;\\n\\nexport const TaxKitHttpApiViteEnvConfig = {\\n  httpApi: HttpApiClientConfig.pipe(Config.nested(\\\"VITE_TAXKIT_API\\\")),\\n} satisfies Config.Wrap<TaxKitHttpApiConfig>;\\nimport { Layer } from \\\"effect\\\";\\nimport type { HttpClient } from \\\"effect/http/HttpClient\\\";\\n\\nimport { createTaxKitApiClient } from \\\"./index.js\\\";\\nimport { TaxKitHttpApiService } from \\\"./service.js\\\";\\n\\nexport interface MakeTaxKitApiClientLayerOptions {\\n  readonly baseUrl?: URL | string | undefined;\\n  readonly transformClient?: (client: HttpClient) => HttpClient;\\n}\\n\\nexport const createTaxKitApiClientLayer = (\\n  options: MakeTaxKitApiClientLayerOptions = {}\\n) => Layer.effect(TaxKitHttpApiService, createTaxKitApiClient(options));\\n\\n/** @deprecated Use `createTaxKitApiClientLayer`. */\\nexport const makeTaxKitApiClientLayer = (\\n  options: MakeTaxKitApiClientLayerOptions = {}\\n) => createTaxKitApiClientLayer(options);\\nimport { Context } from \\\"effect\\\";\\nimport * as HttpRouter from \\\"effect/http/HttpRouter\\\";\\n\\nimport { TaxKitServerLayer } from \\\"../server.js\\\";\\nimport { createTaxKitApiInProcessClientLayer } from \\\"./in-process.layer.js\\\";\\n\\nconst { handler } = HttpRouter.toWebHandler(TaxKitServerLayer);\\n\\nexport const TaxKitApiInProcessClientLive = createTaxKitApiInProcessClientLayer(\\n  (request) => handler(request, Context.empty())\\n);\\n * @see {@link catchEncoding} for a simpler error-recovery variant\\n * @category encoding\\n * @since 4.0.0\\n */\\nexport function middlewareEncoding<S extends Constraint, RE>(\\n  encode: (\\n    effect: Effect.Effect<Option_.Option<S[\\\"Encoded\\\"]>, SchemaIssue.Issue, S[\\\"EncodingServices\\\"]>,\\n    options: SchemaAST.ParseOptions\\n  ) => Effect.Effect<Option_.Option<S[\\\"Encoded\\\"]>, SchemaIssue.Issue, RE>\\n) {\\n  return (schema: S): middlewareEncoding<S, RE> =>\\n    make(\\n      SchemaAST.middlewareEncoding(schema.ast, new SchemaTransformation.Middleware(identity, encode)),\\n      { schema }\\n    )\\n}\\n/**\\n * Recovers from a decoding error by providing a fallback value.\\n *\\nimport { Context } from \\\"effect\\\";\\nimport type { Effect } from \\\"effect\\\";\\n\\nimport type { DocsPageNotFoundError, DocsSourceError } from \\\"./errors.js\\\";\\nimport type {\\n  DocsContentPage,\\n  DocsNavigation,\\n  DocsPagePath,\\n  DocsValidationResult,\\n} from \\\"./schemas.js\\\";\\n\\nexport interface DocsContentServiceContract {\\n  readonly getNavigation: () => Effect.Effect<DocsNavigation, DocsSourceError>;\\n  readonly getPage: (\\n    path: DocsPagePath\\n  ) => Effect.Effect<DocsContentPage, DocsPageNotFoundError | DocsSourceError>;\\n  readonly listPages: () => Effect.Effect<\\n    readonly DocsContentPage[],\\n    DocsSourceError\\n  >;\\n  readonly validateContent: () => Effect.Effect<\\n    DocsValidationResult,\\n    DocsSourceError\\n  >;\\n}\\n\\nexport class DocsContentService extends Context.Service<\\n  DocsContentService,\\n  DocsContentServiceContract\\n>()(\\\"@taxkit/docs-content/DocsContentService\\\") {}\\n# `@taxkit/api-rpc`\\n\\nNative reply validation must also become a named invalid-response error. In the\\nqualified rc.117, an invalid RPC payload can arrive as a SchemaError defect.\\nThe private client marks failure only inside the native exit reply codec's\\ndecoder, then translates that marker to its named invalid-response error. It\\nkeeps the native Schemas, Ndjson parser, Protocol and client. It never treats\\nevery SchemaError as a bad reply: transport and request-encoding defects retain\\ntheir original identity, and caller interruption remains interruption. Tests\\ncover bad native replies and an unrelated adapter SchemaError for both reads.\\nRequalify the cached exit Schema identity and decoder behaviour on Effect\\nupgrades before retaining or removing this small compatibility handling.\\n\\nEffect RPC transport over `@taxkit/calculators`. `Calculators` policy remains in the\\ndomain service; this package owns the RPC contract, handlers, clients, and HTTP\\nmounting.\\n\\n## Exports\\n\\n- `./group`: public RPC contract group.\\n- `./handlers`: server handler Layer.\\n- `./service`: public RPC client service contract.\\n- `./server`: HTTP/RPC server composition.\\n- `./live`: production client Layer.\\n- `./test`: deterministic in-process test Layer.\\n\\n## Documentation impact\\n\\nPublic RPC changes update the repository transport architecture owner and\\naffected critical journeys/proof in the same slice.\\n\\n## Runbook applicability\\n\\nProvider operations, authority, and runbooks remain repository-owned. Add or\\nupdate a target-owned runbook only when an operation or deployment changes.\\n\\n## Non-claims\\n\\nThis package makes no deployment, provider-state, network-reachability, or\\npacked-publisher claim.\\n\\nThe client implements the existing domain service and preserves its checked\\nerror vocabulary. The caller supplies its checked stage API origin and native\\nHttpClient. Each complete read has one domain-owned deadline; no automatic retry.\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","create_time":1791130421.320761}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
