{"timestamp":"2026-10-04T16:23:19.755Z","ordinal":14740,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","item":{"type":"CommandExecution","id":"exec-1170fb2a-14c3-4530-80a6-c203ba11f591","process_id":"26259","command":["/bin/zsh","-lc","sed -n '25,75p' node_modules/effect/src/rpc/RpcMessage.ts; cat packages/api/rpc/package-structure.render.json; sed -n '1,25p' docs/architecture/api-and-sdk.md; rg -n 'RPC|strict|source extensions' docs/architecture/testing-and-quality.md | head -n 12; cat /private/tmp/taxkit-local-toolchain/dev74-rpc-install.log"],"cwd":"file:///Users/cooper/.codex/worktrees/aac7/taxkit","parsed_cmd":[{"type":"read","cmd":"sed -n '25,75p' node_modules/effect/src/rpc/RpcMessage.ts","name":"RpcMessage.ts","path":"node_modules/effect/src/rpc/RpcMessage.ts"},{"type":"read","cmd":"cat packages/api/rpc/package-structure.render.json","name":"package-structure.render.json","path":"packages/api/rpc/package-structure.render.json"},{"type":"read","cmd":"sed -n '1,25p' docs/architecture/api-and-sdk.md","name":"api-and-sdk.md","path":"docs/architecture/api-and-sdk.md"},{"type":"search","cmd":"rg -n 'RPC|strict|source extensions' docs/architecture/testing-and-quality.md","query":"RPC|strict|source extensions","path":"testing-and-quality.md"},{"type":"read","cmd":"cat /private/tmp/taxkit-local-toolchain/dev74-rpc-install.log","name":"dev74-rpc-install.log","path":"/private/tmp/taxkit-local-toolchain/dev74-rpc-install.log"}],"source":"unified_exec_startup","status":"completed","stdout":" * @category models\n * @since 4.0.0\n */\nexport type FromClient<A extends Rpc.Any> = Request<A> | Ack | Interrupt | Eof\n\n/**\n * Transport-encoded messages that can be sent from an RPC client to a server.\n *\n * @stability unstable\n * @category models\n * @since 4.0.0\n */\nexport type FromClientEncoded = RequestEncoded | AckEncoded | InterruptEncoded | Ping | Eof\n\n/**\n * A branded request identifier used to correlate RPC requests, responses,\n * chunks, acknowledgements, and interrupts.\n *\n * @stability unstable\n * @category models\n * @since 4.0.0\n */\nexport type RequestId = Branded<string | number, \"~effect/rpc/RpcMessage/RequestId\">\n\n/**\n * Converts a bigint or string request id into the branded `RequestId` type.\n *\n * @stability unstable\n * @category constructors\n * @since 4.0.0\n */\nexport const RequestId = (id: string | number): RequestId => id as RequestId\n\n/**\n * The transport-encoded RPC request envelope, including the string request id,\n * RPC tag, encoded payload, headers, and optional trace context.\n *\n * **Details**\n *\n * Requests flow in both directions: servers use them for server-originated\n * requests and, with `isNotification` set, for server notifications.\n *\n * @stability unstable\n * @category models\n * @since 4.0.0\n */\nexport interface RequestEncoded {\n  readonly _tag: \"Request\"\n  readonly id: string | number\n  readonly tag: string\n  readonly payload: unknown\n{\n  \"schemaVersion\": 1,\n  \"kind\": \"rpc\",\n  \"packageName\": \"@taxkit/api-rpc\",\n  \"domainPackage\": \"@taxkit/calculators\",\n  \"sourceCondition\": \"source\",\n  \"versionSnapshot\": {\n    \"resolvedAt\": \"2026-10-05\",\n    \"sha256\": \"2938a67efef3b517b5ac520871b39b92027ce10258d62f8c6fd11b94d20988aa\"\n  },\n  \"officialSources\": {\n    \"effect\": \"https://github.com/Effect-TS/effect\",\n    \"typescript\": \"https://github.com/microsoft/typescript-go\"\n  },\n  \"selectedVersions\": {\n    \"effect\": \"4.0.0\",\n    \"typescript\": \"7.0.2\",\n    \"vitest\": \"5.0.3\"\n  },\n  \"compatibilityDecisions\": [\n    {\n      \"status\": \"qualified\",\n      \"decision\": \"Use TaxKit installed stable Effect 4.0.0 and native TypeScript 7.0.2, rather than canonical templates rc.117 snapshot\",\n      \"evidence\": \"docs/documentation-audit/clean-slate-foundation/2026-10-05-foundation-acceptance-review.json\",\n      \"limitation\": \"RPC templates still require adaptation and runtime qualification before acceptance\"\n    }\n  ],\n  \"configDigests\": {\n    \"package.json\": \"529fd22d74c2cadf26524bec9099d8636cbe8b3eef22429977b824197e5e3061\",\n    \"tsconfig.json\": \"71596163cd8ffea16eb4950049bc772ec8a8e2db408759c80bc8232aa40a6d99\",\n    \"tsconfig.build.json\": \"320b70b4115224df6a42038a8759a444d0feecabb0666c22a519904a1e9b9de9\",\n    \"vitest.config.ts\": \"0be6a110349188c59f6651c3e6cc19543b37c18cb1d8b9c4d40666709122798e\"\n  },\n  \"limitations\": [\n    \"Structural rendering does not prove installed dependency, declaration, runtime, or packed-consumer behavior.\"\n  ],\n  \"nonClaims\": [\"Selected versions are not claimed to remain latest.\"]\n}\n---\ndocument_type: architecture\nlifecycle: current\nauthority: canonical\nowner: taxkit-api-sdk-owner\nlast_reviewed: 2026-10-04\nreview_trigger: API or SDK contracts, exports, lifetime or caller composition change\n---\n\n# API and SDK\n\nTaxKit should publish a reusable API app server and TypeScript SDK around the\nopen-source calculation engine.\n\nThe API and SDK are part of this repository because they expose reusable tax\ncalculation capabilities through stable, documented boundaries.\n\n## Current API runtime\n\nSee [TypeScript SDK and publishing](../product-specs/typescript-sdk-and-publishing.md)\nand [SDK public naming and export contract](../product-specs/sdk-public-naming-and-export-contract.md)\nfor the SDK facade, plain TypeScript entrypoint, Effect entrypoint and export\ncontract specs.\n\n`apps/api` is the current API runtime owner. It is a standalone Bun process\n59:covered by strict packed/downstream artifact proof rather than a fabricated\n65:NUL byte or failed strict UTF-8 decode and skipped. For skill governance it\n122:the browser configuration. Canonical strict rules cover all docs app source;\n145:inspect and import the SDK artifact. The strict command builds the nine-package\n158:strict rules as SDK source, with execution admitted only in the three exact\n275:content validation, the focused SDK artifact check, strict downstream package\n365:input so strict environment filtering cannot detach those tasks from the\n489:- Oxlint can enforce restricted APIs, such as banned `Object.*` enumeration\n503:  Layers out of service contracts, restrict encoder execution, reject throwing\n511:- The six owned TypeScript policy modules use all eleven canonical strict\n521:  completion of repository-wide strict enforcement.\n532:  writes and runner captures/callbacks on migrated strict paths. Exact counts\nbun install v1.4.2 (744846f84)\nResolving dependencies\nResolved, downloaded and extracted [1]\nSaved lockfile\n\n$ effect-tsgo patch\ntypescript skipped because its hash matches the replacement.\n\nChecked 793 installs across 1021 packages (no changes) [339.00ms]\n","stderr":"","aggregated_output":" * @category models\n * @since 4.0.0\n */\nexport type FromClient<A extends Rpc.Any> = Request<A> | Ack | Interrupt | Eof\n\n/**\n * Transport-encoded messages that can be sent from an RPC client to a server.\n *\n * @stability unstable\n * @category models\n * @since 4.0.0\n */\nexport type FromClientEncoded = RequestEncoded | AckEncoded | InterruptEncoded | Ping | Eof\n\n/**\n * A branded request identifier used to correlate RPC requests, responses,\n * chunks, acknowledgements, and interrupts.\n *\n * @stability unstable\n * @category models\n * @since 4.0.0\n */\nexport type RequestId = Branded<string | number, \"~effect/rpc/RpcMessage/RequestId\">\n\n/**\n * Converts a bigint or string request id into the branded `RequestId` type.\n *\n * @stability unstable\n * @category constructors\n * @since 4.0.0\n */\nexport const RequestId = (id: string | number): RequestId => id as RequestId\n\n/**\n * The transport-encoded RPC request envelope, including the string request id,\n * RPC tag, encoded payload, headers, and optional trace context.\n *\n * **Details**\n *