dev:cloudflare\": \"bun --no-env-file run tools/docs-deployment/local-doppler.runtime.ts\",\n    \"docs:dev:cloudflare:internal\": \"alchemy dev --env-file tools/docs-deployment/no-local-env\",\n    \"docs:dev:vite\": \"bun run --filter=docs dev:vite\",\n    \"docs:validate\": \"turbo run validate --filter=@taxkit/docs-content\",\n    \"fix\": \"ultracite fix --type-aware\",\n    \"format\": \"oxfmt -c oxfmt.config.ts --write . --no-error-on-unmatched-pattern\",\n    \"format:check\": \"turbo run //#format:check:task\",\n    \"format:check:task\": \"oxfmt -c oxfmt.config.ts --check . --no-error-on-unmatched-pattern\",\n    \"knip\": \"turbo run //#knip:task\",\n    \"knip:task\": \"knip --no-progress --no-config-hints\",\n    \"knip:production\": \"turbo run //#knip:production:task\",\n    \"knip:production:task\": \"knip --production --config knip.production.json --no-gitignore --no-progress --no-config-hints\",\n    \"lint\": \"turbo run //#lint:task\",\n    \"lint:task\": \"bun run lint:boundary-directives && oxlint -c oxlint.config.ts . --disable-nested-config --no-error-on-unmatched-pattern\",\n    \"lint:boundary-directives\": \"oxlint -c oxlint.config.ts . --allow=taxkit/no-decoding-outside-boundaries --allow=taxkit/no-route-transport-restore-outside-consumers --report-unused-disable-directives-severity=error --disable-nested-config --no-error-on-unmatched-pattern\",\n    \"prepare\": \"effect-tsgo patch\",\n    \"release:check\": \"bun run --filter=@taxkit/scripts release:check\",\n    \"release:present\": \"bun run --filter=@taxkit/scripts release:present\",\n    \"test\": \"bun run test:documentation && bun run test:repository-paths && bun run test:docs-boundaries && bun run test:oxlint && turbo run test\",\n    \"test:documentation\": \"turbo run //#test:documentation:task\",\n    \"test:documentation:task\": \"bun --bun vitest run --config tools/vitest.config.ts tools/documentation\",\n    \"test:docs-deployment\": \"turbo run //#test:docs-deployment:tas