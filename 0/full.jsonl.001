readFileString(path.join(serverRoot, \"wrangler.json\"))','readArtifactBytes(path.join(serverRoot, \"wrangler.json\"), \"configuration\").pipe(Effect.map((bytes) => new TextDecoder().decode(bytes)))')\ns=s.replace('const serverModuleBytes = Array.reduce(serverSizes, 0, (total, size) => total + size);','const serverModuleBytes = Array.reduce(serverSizes, 0, (total, size) => total + size);\\n        yield* requireProof(serverFiles.length <= 10_000 && serverModuleBytes <= 67_108_864, \"filesystem\");')\n# Formatter splits this declaration; replace the stable read expression only.\ns=s.replace('fs.readFileString(path.join(serverRoot, file))','readArtifactBytes(path.join(serverRoot, file), \"filesystem\").pipe(Effect.map((bytes) => new TextDecoder().decode(bytes)))')\ns=s.replace('return yield* fs.readFileString(full);','return yield* readArtifactBytes(full, \"filesystem\").pipe(Effect.map((bytes) => new TextDecoder().decode(bytes)));')\ns=s.replace('const allBuiltFiles = yield* fs.glob(\"**/*\", { root: builtRoot });','const allBuiltFiles = yield* fs.glob(\"**/*\", { root: builtRoot });\\n        yield* requireProof(allBuiltFiles.length <= 10_000, \"filesystem\");\\n        const allBuiltSizes = yield* Effect.forEach(allBuiltFiles, (file) => fs.stat(path.join(builtRoot, file)).pipe(Effect.map((info) => info.type === \"File\" ? Number(info.size) : 0)));\\n        yield* requireProof(Array.reduce(allBuiltSizes, 0, (total, bytes) => total + bytes) <= 67_108_864, \"filesystem\");')\nfor name in ['vitePath','wranglerPath','workerdPath']:\n s=s.replace('fs.readFileString('+name+')','readArtifactBytes('+name+', \"configuration\").pipe(Effect.map((bytes) => new TextDecoder().decode(bytes)))')\np.write_text(s)\nPY"],"cwd":"file:///Users/cooper/.codex/worktrees/aac7/taxkit","parsed_cmd":[{"type":"unknown","cmd":"python3 - <<'PY'\nfrom pathlib import Path\np=Path('apps/docs/scripts/cloudflare-built-proof.live.layer.ts');s=p.read_text().replace('const digestDirectory =','export const digestBuiltProofDirectory =').replace('digestDirectory(', 'digestBuiltProofDirectory(')\nmarker='// Preserve the existing sorted path/NUL/content/NUL digest bytes.'\nhelper='''// Binary artifact reading has a separate finite bound from command output.\n// Streaming enforces it before collection and closes the native file handle.\nconst readArtifactBytes = Effect.fnUntraced(function* (\n  file: string, operation: typeof BuiltProofOperation.Type\n) {\n  const fs = yield* FileSystem.FileSystem;\n  const chunks = yield* fs.stream(file).pipe(\n    Stream.mapAccum(() => 0, (previous, bytes) => [previous + bytes.byteLength, [{ total: previous + bytes.byteLength, bytes }]] as const),\n    Stream.mapEffect(({ total, bytes }) => total > 67_108_864\n      ? Effect.fail(new BuiltProofError({ operation, reason: \"output-limit\" }))\n      : Effect.succeed(bytes)),\n    Stream.runCollect,\n    Effect.mapError((error) => Match.value(error).pipe(Match.tag(\"BuiltProofError\", (value) => value), Match.orElse(() => failure(operation))))\n  );\n  return Buffer.concat(chunks);\n});\n\n'''\nassert marker in s;s=s.replace(marker,helper+marker,1)\ns=s.replace('const bytes = yield* fs.readFile(fullPath);','const bytes = yield* readArtifactBytes(fullPath, \"digest\");')\ns=s.replace('const files = yield* fs.glob(\"**/*\", { root: directory });','const files = yield* fs.glob(\"**/*\", { root: directory });\\n  yield* requireProof(files.length <= 10_000, \"digest\");')\ns=s.replace('fs.readFileString(path.join(serverRoot, \"wrangler.json\"))','readArtifactBytes(path.join(serverRoot, \"wrangler.json\"), \"configuration\").pipe(Effect.map((bytes) => new TextDecoder().decode(bytes)))')\ns=s.replace('const serverModuleBytes = Array.reduce(serverSizes, 0, (total, size) => total + size);','const serverModuleBytes = Array.reduce(serverSizes, 0, (total, size) => total + size);\\n        yield* requireProof(serverFiles.length <= 10_000 && serverModuleBytes <= 67_108_864, \"filesystem\");')\n# Formatter splits this declaration; replace the stable read expression only.\ns=s.replace('fs.readFileString(path.join(serverRoot, file))','readArtifactBytes(path.join(serverRoot, file), \"filesystem\").pipe(Effect.map((bytes) => new TextDecoder().decode(bytes)))')\ns=s.replace('return yield* fs.readFileString(full);','return yield* readArtifactBytes(full, \"filesystem\").pipe(Effect.map((bytes) => new TextDecoder().decode(bytes)));')\ns=s.replace('const allBuiltFiles = yield* fs.glob(\"**/*\", { root: builtRoot });','const allBuiltFiles = yield* fs.glob(\"**/*\", { root: builtRoot });\\n        yield* requireProof(allBuiltFiles.length <= 10_000, \"filesystem\");\\n        const allBuiltSizes = yield* Effect.forEach(allBuiltFiles, (file) => fs.stat(path.join(builtRoot, file)).pipe(Effect.map((info) => info.type === \"File\" ? Number(info.size) : 0)));\\n        yield* requireProof(Array.reduce(allBuiltSizes, 0, (total, bytes) => total + bytes) <= 67_108_864, \"filesystem\");')\nfor name in ['vitePath','wranglerPath','workerdPath']:\n s=s.replace('fs.readFileString('+name+')','readArtifactBytes('+name+', \"configuration\").pipe(Effect.map((bytes) => new TextDecoder().decode(bytes)))')\np.write_text(s)\nPY"}],"source":"unified_exec_startup","status":"completed","stdout":"","stderr":"","aggregated_output":"","exit_code":0,"duration":{"secs":0,"nanos":6166},"formatted_output":""},"started_at_ms":1791125384244,"completed_at_ms":1791125384244}}
