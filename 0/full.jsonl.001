k:quality-workflow && bun run check:docs:types && bun run check:harness-foundation-epoch:types && bun run check:docs && bun run check:runbooks && bun run check:effect-language-service && bun run check:docs-deployment:types && bun run check:docs-deployment-tools:types && bun run check:docs-deployment && bun run check:docs-deployment-automation && bun run test:docs-deployment && bun run lint && bun run format:check && bun run test:skills && bun run test:hgi-206 && bun run test:quality-workflow && bun run knip && bun run knip:production && bun run check-types && bun run sdk:test:browser && bun run web:test:browser\\\",\\n    \\\"version-packages\\\": \\\"changeset version\\\",\\n    \\\"version-repo\\\": \\\"changeset version\\\",\\n    \\\"web:test:browser\\\": \\\"turbo run test:browser --filter=web\\\",\\n    \\\"sdk:test:browser\\\": \\\"turbo run test:browser --filter=@taxkit/sdk\\\"\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"@taxkit/infrastructure\\\": \\\"workspace:*\\\",\\n    \\\"alchemy\\\": \\\"catalog:\\\"\\n  },\\n  \\\"devDependencies\\\": {\\n    \\\"@changesets/cli\\\": \\\"3.0.3\\\",\\n    \\\"@effect/platform-bun\\\": \\\"catalog:\\\",\\n    \\\"@effect/platform-node\\\": \\\"catalog:\\\",\\n    \\\"@effect/tsgo\\\": \\\"0.48.0\\\",\\n    \\\"@effect/vitest\\\": \\\"catalog:\\\",\\n    \\\"@oxlint/plugins\\\": \\\"1.86.0\\\",\\n    \\\"@taxkit/scripts\\\": \\\"workspace:*\\\",\\n    \\\"@types/bun\\\": \\\"catalog:\\\",\\n    \\\"@typescript/typescript6\\\": \\\"6.0.2\\\",\\n    \\\"effect\\\": \\\"catalog:\\\",\\n    \\\"knip\\\": \\\"6.39.0\\\",\\n    \\\"oxfmt\\\": \\\"0.71.0\\\",\\n    \\\"oxlint\\\": \\\"1.86.0\\\",\\n    \\\"portless\\\": \\\"0.15.7\\\",\\n    \\\"turbo\\\": \\\"2.11.7\\\",\\n    \\\"typescript\\\": \\\"7.0.2\\\",\\n    \\\"ultracite\\\": \\\"7.12.2\\\",\\n    \\\"vite\\\": \\\"catalog:\\\",\\n    \\\"vitest\\\": \\\"catalog:\\\",\\n    \\\"yaml\\\": \\\"2.9.1\\\"\\n  },\\n  \\\"overrides\\\": {\\n    \\\"@effect/platform-node