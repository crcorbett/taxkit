k/*\",\n      \"packages/rules/au/*\"\n    ],\n    \"catalog\": {\n      \"@effect/platform-bun\": \"4.0.0\",\n      \"@effect/platform-node\": \"4.0.0\",\n      \"@effect/vitest\": \"4.0.0\",\n      \"@cloudflare/vite-plugin\": \"1.62.5\",\n      \"@tanstack/react-router\": \"1.170.41\",\n      \"@tanstack/react-start\": \"1.168.60\",\n      \"@types/bun\": \"1.4.2\",\n      \"@types/node\": \"26.6.4\",\n      \"@types/react\": \"19.3.0\",\n      \"@types/react-dom\": \"19.3.0\",\n      \"@vitejs/plugin-react\": \"6.1.1\",\n      \"alchemy\": \"2.0.0-beta.80\",\n      \"effect\": \"4.0.0\",\n      \"nitro\": \"3.0.260903-beta\",\n      \"react\": \"19.3.0\",\n      \"react-dom\": \"19.3.0\",\n      \"typescript\": \"7.0.2\",\n      \"vite\": \"8.3.2\",\n      \"vitest\": \"5.0.3\",\n      \"wrangler\": \"4.147.0\"\n    }\n  },\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"turbo run build\",\n    \"changeset\": \"changeset\",\n    \"check\": \"ultracite check --type-aware\",\n    \"check:docs\": \"turbo run //#check:docs:task\",\n    \"check:docs:task\": \"bun run tools/documentation/check.runtime.ts\",\n    \"check:docs-deployment\": \"turbo run //#check:docs-deployment:task\",\n    \"check:docs-deployment:task\": \"bun --conditions=source run tools/docs-deployment/check.runtime.ts\",\n    \"check:docs-deployment-automation\": \"turbo run //#check:docs-deployment-automation:task\",\n    \"check:docs-deployment-automation:task\": \"bun --conditions=source run tools/docs-deployment/automation.check.runtime.ts\",\n    \"check:docs-deployment-inventory\": \"CI=1 turbo run //#check:docs-deployment-inventory:task\",\n    \"check:docs-deployment-inventory:task\": \"bun --conditions=source run tools/docs-deployment/inventory.runtime.ts\",\n    \"check:docs-deployment-workflow-proof\": \"turbo run //#check:docs-deployment-workflow-proof:task\",\n    \"check:docs-deployment-workflow-proof:task\": \"bun --conditions=source run tools/docs-deployment/workflow-pro