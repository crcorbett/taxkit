check:quality-workflow:types && bun run check:quality-workflow && bun run check:docs:types && bun run check:harness-foundation-epoch:types && bun run check:docs && bun run check:runbooks && bun run check:effect-language-service && bun run check:docs-deployment:types && bun run check:docs-deployment-tools:types && bun run check:docs-deployment && bun run check:docs-deployment-automation && bun run test:docs-deployment && bun run lint && bun run format:check && bun run test:skills && bun run test:hgi-206 && bun run test:quality-workflow && bun run knip && bun run knip:production && bun run check-types && bun run sdk:test:browser && bun run web:test:browser\",\n    \"version-packages\": \"changeset version\",\n    \"version-repo\": \"changeset version\",\n    \"web:test:browser\": \"turbo run test:browser --filter=web\",\n    \"sdk:test:browser\": \"turbo run test:browser --filter=@taxkit/sdk\"\n  },\n  \"dependencies\": {\n    \"@taxkit/infrastructure\": \"workspace:*\",\n    \"alchemy\": \"catalog:\"\n  },\n  \"devDependencies\": {\n    \"@changesets/cli\": \"3.0.3\",\n    \"@effect/platform-bun\": \"catalog:\",\n    \"@effect/platform-node\": \"catalog:\",\n    \"@effect/tsgo\": \"0.48.0\",\n    \"@effect/vitest\": \"catalog:\",\n    \"@oxlint/plugins\": \"1.86.0\",\n    \"@taxkit/scripts\": \"workspace:*\",\n    \"@types/bun\": \"catalog:\",\n    \"@typescript/typescript6\": \"6.0.2\",\n    \"effect\": \"catalog:\",\n    \"knip\": \"6.39.0\",\n    \"oxfmt\": \"0.71.0\",\n    \"oxlint\": \"1.86.0\",\n    \"portless\": \"0.15.7\",\n    \"turbo\": \"2.11.7\",\n    \"typescript\": \"7.0.2\",\n    \"ultracite\": \"7.12.2\",\n    \"vite\": \"catalog:\",\n    \"vitest\": \"catalog:\",\n    \"yaml\": \"2.9.1\"\n  },\n  \"overrides\": {\n    \"@effect/platform-node-shared\": \"4.0.0\",\n    \"@effect/sql-d1\": \"4.0.0\",\n    \"@effect/sql-sqlite-do\": \"4.0.0\"\n  },\n  \"engines\": {\n    \"bun\": \">=1.4.2\",\n    \"node\": \">=24.16.0\"\n  },\n  \"packageManager\": \"bun@1.4.2\",\n  \"patchedDependencies\": {\n    \"@effect/atom-react@4.0.0\": \"patches/@effect%2Fatom-react@4.0.0.patch\"\n  }\n}\n","exit_code":0,"duration":{"secs":0,"nanos":6500},"formatted_output":"import { Effect, Layer, Match, Option, Result, Schema } from \"effect\";\nimport { RpcSerialization } from \"effect/rpc\";\n\nimport { Calculate } from \"./group.js\";\n\n// Validate the native JSON parser's unknown envelopes before the native server\n// can reflect an unchecked procedure tag or request identity. This is ingress\n// validation, not a replacement message encoder or framing implementation.\nconst RequestIdentity = Schema.Union([\n  Schema.String.check(Schema.isPattern(/^\\d{1,20}$/u)),\n  Schema.Int.check(\n    Schema.isBetween({ maximum: Number.MAX_SAFE_INTEGER, minimum: 0 })\n  ),\n]);\nconst RequestEnvelope = Schema.TaggedStruct(\"Request\", {\n  headers: Schema.Array(\n    Schema.Tuple([\n      Schema.String.check(Schema.isMaxLength(128)),\n      Schema.String.check(Schema.isMaxLength(4096)),\n    ])\n  ).check(Schema.isMaxLength(32)),\n  id: RequestIdentity,\n  payload: Schema.Unknown,\n  tag: Schema.Literal(Calculate._tag),\n});\nconst RequestBytes = Schema.Union([Schema.String, Schema.Uint8Array]).check(\n  Schema.makeFilter(\n    (bytes) =>\n      Match.value(bytes).pipe(\n        Match.when(\n          Match.string,\n          (text) => new TextEncoder().encode(text).byteLength\n        ),\n        Match.orElse((buffer) => buffer.byteLength)\n      ) <=\n      1024 * 1024\n  )\n);\nconst RequestBatch = Schema.Array(RequestEnvelope).check(\n  Schema.isMinLength(1),\n  Schema.isMaxLength(16)\n);\n\nclass RpcEnvelopeRejected extends Schema.TaggedError<RpcEnvelopeRejected>()(\n  \"RpcEnvelopeRejected\",\n  {}\n) {}\n\nexport const TaxKitRpcServerSerialization = Layer.succeed(\n  RpcSerialization.RpcSerialization,\n  RpcSerialization.RpcSerialization.of({\n    ...RpcSerialization.json,\n    codecFor: <S extends Schema.Top>(schema: S) => {\n      const codec = RpcSerialization.json.codecFor(schema);\n      return schema.ast === Schema.Defect().ast\n        ? codec.pipe(\n            Schema.middlewareEncoding<typeof codec, S[\"EncodingServices\"]>(() =>\n              Effect.succeed(Option.some(\"Calculation service failed\"))\n            )\n          )\n        : codec;\n    },\n    makeUnsafe: () => {\n      const parser = RpcSerialization.json.makeUnsafe();\n      return {\n        decode: (bytes) => {\n          const input = Schema.decodeResult(RequestBytes)(bytes).pipe(\n            Result.getOrThrowWith(() => new RpcEnvelopeRejected())\n          );\n          return Schema.decodeUnknownResult(RequestBatch, {\n            onExcessProperty: \"error\",\n          })(parser.decode(input)).pipe(\n            Result.getOrThrowWith(() => new RpcEnvelopeRejected())\n          );\n        },\n        encode: parser.encode,\n      };\n    },\n  })\n);\ndocs/documentation-audit/clean-slate-foundation/2026-10-05-native-rpc-contract.json:4:  \"task\": \"CSF-T003\",\ndocs/documentation-audit/clean-slate-foundation/2026-10-05-native-rpc-contract.json:5:  \"issue\": \"DEV-74\",\ndocs/documentation-audit/clean-slate-foundation/2026-10-05-native-rpc-contract.json:26:      \"outcome\": \"pass: 24 native RPC tests in two files, actual POST/JSON handler/client, real calculator net pay 130100 cents at 165400 cents weekly gross, checked errors, pure/mixed defects, malformed JSON/envelopes/tags/IDs, version skew, invalid replies, exact independent SchemaError defect, deadlines/body/root-scope cleanup and operation policy\",\ndocs/documentation-audit/clean-slate-foundation/2026-10-05-native-rpc-contract.json:81:      \"provider runbook\": \"This package-only slice changes no provider command or graph; real host operations remain with later T003 composition\",\ndocs/documentation-audit/clean-slate-foundation/2026-10-05-native-rpc-contract.json:87:    \"Candidate acceptance awaits complete slice checks; T003 remains in progress\",