       (entry): entry is [string, string | Redacted.Redacted<string>] =>\n              entry[1] !== undefined,\n          )\n          .map(([key, value]) => [\n            key,\n            Redacted.isRedacted(value) ? Redacted.value(value) : value,\n          ]),\n      )\n    : undefined;\n\nexport const BuildProvider = () =>\n  Provider.effect(\n    Build,\n    Effect.gen(function* () {\n      const path = yield* Path.Path;\n      const fs = yield* FileSystem.FileSystem;\n      const { run } = yield* CommandExecutor;\n\n      const makeOutput = Effect.fn(function* (props: BuildProps) {\n        // Anchored to the initial cwd: a live `process.cwd()` read can race\n        // a concurrent tool's transient chdir (framework source builds),\n        // and the relative `outdir` stored here is resolved again later\n        // (assets read) — mismatched bases corrupt the path.\n        const cwd = path.resolve(initialCwd, props.cwd ?? \".\");\n        const outdir = path.resolve(cwd, props.outdir);\n        if (!(yield* fs.exists(outdir))) {\n          return yield* makeCommandError(\n            props,\n            new OutputNotFound({\n              outdir: props.outdir,\n            }),\n          );\n31:export const BUN_CONDITION_NAMES: readonly string[] = [\n36:export const NODE_CONDITION_NAMES: readonly string[] = [\n44: * merely importing alchemy — the CLI command tree, the Cloudflare provider\n85: * instances, Docker service images, Cloudflare container images, …):\n227:export const build = (\n261:export const watch = (\n358:export const virtualEntryPlugin = Effect.gen(function* () {\nsed: node_modules/alchemy/src/Secrets/Doppler.ts: No such file or directory\n   Start at  03:38:06\n   Duration  588ms (tests 67%, import 26%, transform 6%, worker 1%)\n\n$ turbo run //#test:quality-workflow:task\n\n   • turbo 2.11.7\n   • Packages in scope: //\n   • Running //#test:quality-workflow:task in 1 package\n   • Remote caching disabled, using shared worktree cache\n\n/