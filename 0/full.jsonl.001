{"timestamp":"2026-10-04T15:40:44.980Z","ordinal":13670,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","item":{"type":"CommandExecution","id":"exec-8ae2ea3e-5aa2-4c0c-9b45-90ff64b65a1e","process_id":"34920","command":["/bin/zsh","-lc","rg --files apps/web/src/lib; cat packages/core/src/primitives/money.ts; cat tools/documentation/owner-policy.json | head -70; rg -n 'ScenarioDates|calculationDate|paymentDate' packages/calculators/src packages/core/src"],"cwd":"file:///Users/cooper/.codex/worktrees/aac7/taxkit","parsed_cmd":[{"type":"list_files","cmd":"rg --files apps/web/src/lib","path":"lib"},{"type":"read","cmd":"cat packages/core/src/primitives/money.ts","name":"money.ts","path":"packages/core/src/primitives/money.ts"},{"type":"read","cmd":"cat tools/documentation/owner-policy.json","name":"owner-policy.json","path":"tools/documentation/owner-policy.json"},{"type":"search","cmd":"rg -n 'ScenarioDates|calculationDate|paymentDate' packages/calculators/src packages/core/src","query":"ScenarioDates|calculationDate|paymentDate","path":"calculators"}],"source":"unified_exec_startup","status":"failed","stdout":"apps/web/src/lib/health-loader.boundary.browser.test.tsx\napps/web/src/lib/config.ts\napps/web/src/lib/config.server.ts\napps/web/src/lib/route-context.ts\napps/web/src/lib/config.client.ts\napps/web/src/lib/config.boundary.test.ts\napps/web/src/lib/runtime.server.ts\napps/web/src/lib/atom-lifecycle.browser.test.tsx\napps/web/src/lib/runtime-selection.ts\napps/web/src/lib/config.client-input.ts\napps/web/src/lib/runtime.client.ts\nimport { Schema } from \"effect\";\n\n/**\n * Whole cents used by all money values in the core package.\n *\n * @since 0.1.0\n */\nexport const Cents = Schema.Int.pipe(Schema.brand(\"taxkit/Cents\"));\n\n/**\n * Whole cents used by all money values in the core package.\n *\n * @since 0.1.0\n */\nexport type Cents = typeof Cents.Type;\n\n/**\n * The currency supported by core tax calculations.\n *\n * @since 0.1.0\n */\nexport const Currency = Schema.Literal(\"AUD\");\n\n/**\n * The currency supported by core tax calculations.\n *\n * @since 0.1.0\n */\nexport type Currency = typeof Currency.Type;\n\n/**\n * An AUD amount represented as integer cents.\n *\n * @example\n * ```ts\n * import { aud } from \"@taxkit/core\";\n *\n * const withholding = aud(12_345);\n * ```\n *\n * @since 0.1.0\n */\nexport class Money extends Schema.TaggedClass<Money>()(\"Money\", {\n  cents: Cents,\n  currency: Currency,\n}) {}\n\n/**\n * Creates an AUD money value from integer cents.\n *\n * @since 0.1.0\n */\nexport const aud = (cents: number): Money =>\n  new Money({ cents: Cents.make(cents), currency: \"AUD\" });\n\n/**\n * Creates an AUD money value from dollars, rounded to the nearest cent.\n *\n * @example\n * ```ts\n * import { audDollars } from \"@taxkit/core\";\n *\n * const amount = audDollars(42.5);\n * ```\n *\n * @since 0.1.0\n */\nexport const audDollars = (dollars: number): Money =>\n  aud(Math.round(dollars * 100));\n\n/**\n * Adds two checked AUD money values.\n *\n * @since 0.1.0\n */\nexport const moneyAdd = (a: Money, b: Money): Money => aud(a.cents + b.cents);\n\n/**\n * Subtracts one checked AUD money value from another.\n *\n * @since 0.1.0\n */\nexport const moneySub = (a: Money, b: Money): Money => aud(a.cents - b.cents);\n\n/**\n * Tests money values for exact cent and currency equality.\n *\n * @since 0.1.0\n */\nexport const moneyEquals = (a: Money, b: Money): boolean =>\n  a.cents === b.cents && a.currency === b.currency;\n{\n  \"public\": {\n    \"roots\": [\"packages/docs-content/content\"],\n    \"navigation\": {\n      \"path\": \"packages/docs-content/navigation.json\",\n      \"owner\": \"packages/docs-content-public-doc-owner\"\n    },\n    \"statusDecision\": {\n      \"acceptanceRecords\": [],\n      \"path\": \"docs/documentation-audit/hgi-207/public-mdx-lifecycle.json\",\n   