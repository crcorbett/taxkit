{"timestamp":"2026-10-04T16:39:03.602Z","ordinal":15057,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","item":{"type":"CommandExecution","id":"exec-a50af118-f2be-42b9-85cc-31f825b2e1e3","process_id":"64490","command":["/bin/zsh","-lc","sed -n '611,644p' node_modules/effect/src/http/HttpRouter.ts; sed -n '1278,1344p' node_modules/effect/src/http/HttpRouter.ts; sed -n '1360,1430p' node_modules/effect/src/http/HttpRouter.ts; sed -n '2035,2078p' node_modules/alchemy/src/Cloudflare/Workers/Worker.ts; sed -n '1630,1765p' node_modules/alchemy/src/Cloudflare/Workers/Worker.ts; cat node_modules/alchemy/src/Cloudflare/Website/Vite.ts | head -145; sed -n '132,181p' docs/product-specs/clean-slate-foundation.md; cat packages/api/rpc/src/handlers.ts; cat packages/api/rpc/src/live.layer.ts"],"cwd":"file:///Users/cooper/.codex/worktrees/aac7/taxkit","parsed_cmd":[{"type":"read","cmd":"sed -n '611,644p' node_modules/effect/src/http/HttpRouter.ts","name":"HttpRouter.ts","path":"node_modules/effect/src/http/HttpRouter.ts"},{"type":"read","cmd":"sed -n '1278,1344p' node_modules/effect/src/http/HttpRouter.ts","name":"HttpRouter.ts","path":"node_modules/effect/src/http/HttpRouter.ts"},{"type":"read","cmd":"sed -n '1360,1430p' node_modules/effect/src/http/HttpRouter.ts","name":"HttpRouter.ts","path":"node_modules/effect/src/http/HttpRouter.ts"},{"type":"read","cmd":"sed -n '2035,2078p' node_modules/alchemy/src/Cloudflare/Workers/Worker.ts","name":"Worker.ts","path":"node_modules/alchemy/src/Cloudflare/Workers/Worker.ts"},{"type":"read","cmd":"sed -n '1630,1765p' node_modules/alchemy/src/Cloudflare/Workers/Worker.ts","name":"Worker.ts","path":"node_modules/alchemy/src/Cloudflare/Workers/Worker.ts"},{"type":"read","cmd":"cat node_modules/alchemy/src/Cloudflare/Website/Vite.ts","name":"Vite.ts","path":"node_modules/alchemy/src/Cloudflare/Website/Vite.ts"},{"type":"read","cmd":"sed -n '132,181p' docs/product-specs/clean-slate-foundation.md","name":"clean-slate-foundation.md","path":"docs/product-specs/clean-slate-foundation.md"},{"type":"read","cmd":"cat packages/api/rpc/src/handlers.ts","name":"handlers.ts","path":"packages/api/rpc/src/handlers.ts"},{"type":"read","cmd":"cat packages/api/rpc/src/live.layer.ts","name":"live.layer.ts","path":"packages/api/rpc/src/live.layer.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"export const toHttpEffect = <A, E, R>(\n  appLayer: Layer.Layer<A, E, R>\n): Effect.Effect<\n  Effect.Effect<\n    HttpServerResponse.HttpServerResponse,\n    Request.Only<\"Error\", R> | Request.Only<\"GlobalError\", R> | HttpServerError.HttpServerError,\n    Scope.Scope | HttpServerRequest.HttpServerRequest | Request.Only<\"Requires\", R> | Request.Only<\"GlobalRequires\", R>\n  >,\n  Request.Without<E>,\n  Exclude<Request.Without<R>, HttpRouter> | Scope.Scope\n> =>\n  Effect.contextWith((context) => {\n    const scope = Context.get(context, Scope.Scope)\n    const memoMap = Layer.CurrentMemoMap.forkOrCreate(context)\n    return Effect.map(Layer.buildWithMemoMap(Layer.provideMerge(appLayer, layer), memoMap, scope), (context) => {\n      const router = Context.get(context, HttpRouter)\n      return router.asHttpEffect()\n    })\n  }) as any\n\nconst RouteTypeId = \"~effect/http/HttpRouter/Route\"\n\n/**\n * Description of a registered HTTP route.\n *\n * **Details**\n *\n * A route pairs an HTTP method and path pattern with a response handler, plus\n * metadata used for prefix handling and interruptibility.\n *\n * @stability unstable\n * @category routes\n * @since 4.0.0\n */\n * import { HttpRouter, HttpServerResponse } from \"effect/http\"\n *\n * const Route = HttpRouter.add(\n *   \"GET\",\n *   \"/hello\",\n *   HttpServerResponse.text(\"Hello, World!\")\n * ).pipe(\n *   // disable the logger for this route\n *   Layer.provide(HttpRouter.disableLogger)\n * )\n * Layer.isLayer(Route) // => true\n * ```\n *\n * @stability unstable\n * @category layers\n * @since 4.0.0\n */\nexport const disableLogger: Layer.Layer<never> = middleware(HttpMiddleware.withLoggerDisabled).layer\n\n/**\n * Provides request-level dependencies to some routes.\n *\n * @stability unstable\n * @category layers\n * @since 4.0.0\n */\nexport const provideRequest =\n  <A2, E2, R2>(layer: Layer.Layer<A2, E2, R2>) =>\n  <A, E, R>(self: Layer.Layer<A, E, R>): Layer.Layer<\n    A,\n    E | E2,\n    R2 | Exclude<R, Request.From<\"Requires\", A2>>\n  > =>\n    Layer.provide(\n      self,\n      middleware<{ provides: A2 }>()(Effect.gen(function*() {\n        const services = yield* Layer.build(layer as Layer.Layer<A2>)\n        return (effect) =>\n          Effect.provideContext(effect, services) as Effect.Effect<\n            HttpServerResponse.HttpServerResponse,\n            Types.unhandled\n          >\n      })).layer\n    )\n\n/**\n * Runs the provided application layer as an HTTP server.\n *\n * **Details**\n *\n * Layers first built inside the app are private to this server. Provide\n * services that must be shared with sibling layers outside `serve`.\n *\n * **Gotchas**\n *\n * The layer is built with a forked `MemoMap`, so calling `serve` twice will\n * build the same layer twice.\n *\n * @stability unstable\n * @category layers\n * @since 4.0.0\n */\nexport const serve = <A, E, R, HE, HR = Request.Only<\"Requires\", R> | Request.Only<\"GlobalRequires\", R>>(\n  appLayer: Layer.Layer<A, E, R>,\n  options?: {\n    readonly routerConfig?: Partial<FindMyWay.RouterConfig> | undefined\n    readonly disableLogger?: boolean | undefined\n        | Scope.Scope\n        | HttpServerRequest.HttpServerRequest\n        | Request.Only<\"Requires\", R>\n        | Request.Only<\"GlobalRequires\", R>\n      >\n    ) => Effect.Effect<HttpServerResponse.HttpServerResponse, HE, HR>\n  }\n): Layer.Layer<\n  A,\n  Request.Without<E>,\n  HttpServer.HttpServer | Exclude<Request.Without<R> | Exclude<HR, GlobalProvided>, HttpRouter>\n> => {\n  let middleware: any = options?.middleware\n  if (options?.disableLogger !== true) {\n    middleware = middleware ? compose(middleware, HttpMiddleware.logger) : HttpMiddleware.logger\n  }\n  const layerWithRouter = Layer.provideMerge(\n    appLayer,\n    options?.routerConfig\n      ? Layer.provide(layer, Layer.succeed(RouterConfig)(options.routerConfig))\n      : layer\n  )\n  return Effect.contextWith((context) => {\n    const memoMap = Layer.CurrentMemoMap.forkOrCreate(context)\n    return Layer.buildWithMemoMap(layerWithRouter, memoMap, Context.get(context, Scope.Scope))\n  }).pipe(\n    Effect.map((context) => {\n      const router = Context.get(context, HttpRouter)\n      const handler = router.asHttpEffect()\n      return Layer.merge(\n        middleware ? HttpServer.serve(handler, middleware) : HttpServer.serve(handler),\n        Layer.succeedContext(context)\n      )\n    }),\n    Layer.unwrap,\n    options?.disableListenLog ? identity : HttpServer.withLogAddress\n  ) as any\n}\n\n/**\n * Builds a Fetch-compatible request handler from an HTTP router application\n * layer.\n *\n * **Details**\n *\n * The result contains a `handler` function that converts Web `Request` values to\n * Web `Response` values and a `dispose` function for releasing the layer\n * resources. The layer is built immediately, so the cost is paid when the\n * handler is created rather than on the first request. A layer that performs\n * asynchronous work while building may still be in progress when the first\n * request arrives, in which case that request waits for the build to finish.\n * If the build fails, every request rejects with the build error.\n *\n * @stability unstable\n * @category converting\n * @since 4.0.0\n */\nexport const toWebHandler = <\n  A,\n  E,\n  R extends\n    | HttpRouter\n    | Request<\"Requires\", any>\n    | Request<\"GlobalRequires\", any>\n    | Request<\"Error\", any>\n    | Request<\"GlobalError\", any>,\n  HE,\n  HR = Exclude<Request.Only<\"Requires\", R> | Request.Only<\"GlobalRequires\", R>, A>,\n  ReqR = Exclude<HR, A | Scope.Scope | HttpServerRequest.HttpServerRequest>\n>(\n  appLayer: Layer.Layer<A, E, R>,\n *     traffic: 25,\n *     affinity: { cookie: \"session_id\", ip: true },\n *   },\n * });\n * ```\n *\n * ### The Worker's own URL\n * `Worker.URL` injects the URL a Worker is served at as a binding on that\n * same Worker — the first custom `domain` if one is configured, otherwise\n * its `workers.dev` URL, always equal to the resource's `url` attribute.\n * Under `alchemy dev` it resolves to the local dev server's URL.\n *\n * **Example:** Read the Worker's own URL inside a handler\n * ```typescript\n * Cloudflare.Worker(\n *   \"Api\",\n *   { main: import.meta.url },\n *   Effect.gen(function* () {\n *     // Attaches the binding and returns a deferred accessor.\n *     const url = yield* Cloudflare.Worker.URL;\n *\n *     return {\n *       fetch: Effect.gen(function* () {\n *         const publicUrl = yield* url;\n *         return yield* HttpServerResponse.json({ url: publicUrl });\n *       }),\n *     };\n *   }),\n * );\n * ```\n *\n * **Example:** Inject the URL into an async Worker's env\n * `InferEnv` types the entry as `string`. A `VITE_`-prefixed key on a\n * vite-built Worker is additionally inlined into the client bundle as\n * `import.meta.env.VITE_PUBLIC_URL` at build time.\n * ```typescript\n * export const Worker = Cloudflare.Worker(\"Worker\", {\n *   main: \"./src/worker.ts\",\n *   env: { PUBLIC_URL: Cloudflare.Worker.URL },\n * });\n *\n * export type WorkerEnv = Cloudflare.InferEnv<typeof Worker>;\n * //   { PUBLIC_URL: string }\n * ```\n *\n * See the [Python Workers guide](/cloudflare/compute/python-workers)\n * for the full walkthrough.\n *\n * **Example:** Defining a Python Worker in your stack\n * ```typescript\n * // alchemy.run.ts\n * const kv = yield* Cloudflare.KV.Namespace(\"Cache\");\n *\n * export const Worker = Cloudflare.Worker(\"Worker\", {\n *   main: \"./src/worker.py\",\n *   env: { CACHE: kv },\n * });\n * ```\n *\n * **Example:** Writing the Python handler\n * ```python\n * # src/worker.py\n * from workers import Response, WorkerEntrypoint\n *\n * class Default(WorkerEntrypoint):\n *     async def fetch(self, request):\n *         cached = await self.env.CACHE.get(\"greeting\")\n *         return Response(cached or \"Hello from Python!\")\n * ```\n *\n * **Example:** Vendoring dependencies with pyproject.toml\n * ```toml\n * # src/pyproject.toml — vendored with uv on deploy\n * [project]\n * name = \"my-worker\"\n * version = \"0.1.0\"\n * requires-python = \">=3.13\"\n * dependencies = [\"humanize\"]\n * ```\n *\n * ### Effect Workers\n * Pass the Effect implementation as the third argument. This is the\n * simplest Effect-based approach — everything lives in one file.\n * Convenient for standalone Workers that don't need to be referenced\n * by other Workers.\n *\n * **Example:** Worker Effect\n * ```typescript\n * export default class MyWorker extends Cloudflare.Worker<MyWorker>()(\n *   \"MyWorker\",\n *   { main: import.meta.url },\n *   Effect.gen(function* () {\n *     // Construction: bind resources\n *     const kv = yield* Cloudflare.KV.ReadWriteNamespace(MyKV);\n *\n *     return {\n *       // Runtime: use them\n *       fetch: Effect.gen(function* () {\n *         const value = yield* kv.get(\"key\");\n *         return HttpServerResponse.text(value ?? \"not found\");\n *       }),\n *     };\n *   }),\n * ) {}\n * ```\n *\n * ### Worker Layer\n * When two Workers need to reference each other (e.g. WorkerA calls\n * WorkerB and vice versa), or you simply want optimal tree-shaking,\n * define the Worker class separately from its `.make()` call. The\n * class is a lightweight identifier; `.make()` provides the runtime\n * implementation as an `export default`. Rolldown treats `.make()`\n * as pure, so any Worker that imports the class to bind it will not\n * pull in the `.make()` dependencies — the bundler tree-shakes\n * them away entirely.\n *\n * The class and `.make()` can live in the same file. This is the\n * same pattern used by `Container` and `DurableObject`,\n * and is recommended for any cross-Worker or cross-DO bindings.\n *\n * **Example:** Worker Layer (class + .make() in one file)\n * ```typescript\n * // src/WorkerB.ts — the tag carries the name + RPC shape; props live\n * // on `.make()`.\n * export class WorkerB extends Cloudflare.Worker<\n *   WorkerB,\n *   { greet: (name: string) => Effect.Effect<string> }\n * >()(\"WorkerB\") {}\n *\n * export default WorkerB.make(\n *   { main: import.meta.url },\n *   Effect.gen(function* () {\n *     // Construction: bind resources\n *     const kv = yield* Cloudflare.KV.ReadWriteNamespace(MyKV);\n *\n *     return {\n *       // Runtime: use them\n *       greet: (name: string) =>\n *         Effect.gen(function* () {\n *           yield* kv.put(\"last-greeted\", name);\n *           return `Hello ${name}`;\n *         }),\n *     };\n *   }),\n * );\n * ```\n *\n * **Example:** Binding a Worker Layer from another Worker\n * ```typescript\n * // src/WorkerA.ts — imports WorkerB; bundler tree-shakes .make()\n * import WorkerB from \"./WorkerB.ts\";\n *\n * export default class WorkerA extends Cloudflare.Worker<WorkerA>()(\n *   \"WorkerA\",\n *   { main: import.meta.url },\n *   Effect.gen(function* () {\n *     const b = yield* Cloudflare.Workers.bindWorker(WorkerB);\n *     return {\n *       fetch: Effect.gen(function* () {\n *         return yield* b.greet(\"world\");\n *       }),\n *     };\n *   }),\n * ) {}\n * ```\n *\n * ### Configuration\n * The props object controls compatibility flags, static assets, and\n * build options. These are evaluated at deploy time.\n *\n * **Example:** Enabling Node.js compatibility\n * ```typescript\n * {\n *   main: import.meta.url,\n *   compatibility: {\n *     flags: [\"nodejs_compat\"],\n *     date: \"2026-08-31\",\n *   },\n * }\n * ```\nimport * as Effect from \"effect/Effect\";\nimport type { InputProps } from \"../../Input.ts\";\nimport { effectClass } from \"../../Util/effect.ts\";\nimport type { Providers } from \"../Providers.ts\";\nimport type { AssetsConfig } from \"../Workers/Assets.ts\";\nimport {\n  Worker,\n  type NormalizedBindings,\n  type ViteOptions,\n  type WorkerAssetsConfig,\n  type WorkerBindingProps,\n  type WorkerProps,\n} from \"../Workers/Worker.ts\";\n\nexport interface ViteProps<Bindings extends WorkerBindingProps = {}>\n  extends Omit<WorkerProps<Bindings>, \"vite\" | \"main\" | \"assets\">, ViteOptions {\n  /**\n   * Optional configuration for static asset routing behavior.\n   * Supports `runWorkerFirst`, `htmlHandling`, `notFoundHandling`, etc.\n   */\n  assets?: AssetsConfig;\n}\n\n/**\n * A Cloudflare Worker deployed from a Vite project.\n *\n * `Vite` uses the Cloudflare Vite plugin to build both the server bundle\n * and client assets in a single `vite build` invocation — no manual\n * `main` entrypoint, build command, output directory, or Wrangler\n * configuration required.\n *\n * Input files are content-hashed (respecting `.gitignore` by default) so\n * unchanged projects skip the build and deploy entirely.\n *\n *\n * ### Deploying a Static Site\n * For a pure static site (no SSR), a single call is all you need.\n * Vite builds the project and Alchemy deploys the output as a\n * Cloudflare Worker with static assets.\n *\n * **Example:** Static Vite site\n * ```typescript\n * const site = yield* Cloudflare.Website.Vite(\"Website\");\n * ```\n *\n * ### SSR Frameworks\n * SSR frameworks like TanStack Start or SolidStart work with a single\n * call — the `nodejs_compat` compatibility flag is enabled by default\n * so the server bundle can use Node.js APIs.\n *\n * **Example:** TanStack Start\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"TanStackStart\");\n * ```\n *\n * **Example:** SolidStart with worker-first routing\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"SolidStart\", {\n *   assets: { runWorkerFirst: true },\n * });\n * ```\n *\n * **Example:** React Router\n * React Router's server build (`virtual:react-router/server-build`) is a\n * build manifest with no default export, so it cannot be deployed as the\n * Worker entry directly. Point `main` at a module that wraps it with\n * `createRequestHandler` (React Router's Cloudflare template ships this\n * as `workers/app.ts`):\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"ReactRouter\", {\n *   main: \"workers/app.ts\",\n * });\n * ```\n *\n * ### React Server Components\n * Frameworks that emit more than one server environment (e.g. React\n * Server Components, which split into an `rsc` environment and an `ssr`\n * environment) need `viteEnvironments` to declare which environment\n * produces the deployed Worker entry and which additional server\n * environments to bundle alongside it. The `client` environment is\n * always deployed as static assets.\n *\n * **Example:** React Router with RSC\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"ReactRouterRSC\", {\n *   viteEnvironments: {\n *     entry: \"rsc\",\n *     children: [\"ssr\"],\n *   },\n * });\n * ```\n *\n * ### Custom Worker Entry\n * By default the deployed Worker entry is the server bundle the\n * framework produces. When the Worker must export more than the\n * framework's fetch handler — Durable Object classes, additional\n * handlers — point `main` at your own module that wraps the framework\n * handler and re-exports the extras. `main` takes precedence over any\n * entry configured in the Vite config.\n *\n * **Example:** Custom entry hosting Durable Objects\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"App\", {\n *   main: \"worker/index.ts\",\n *   viteEnvironments: {\n *     entry: \"rsc\",\n *     children: [\"ssr\"],\n *   },\n * });\n * ```\n *\n * ### Single-Page Applications\n * For SPAs (React, Vue, etc.), configure asset handling so unmatched\n * routes fall back to `index.html` and the client router takes over.\n *\n * **Example:** Vue SPA\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"Vue\", {\n *   assets: {\n *     notFoundHandling: \"single-page-application\",\n *   },\n * });\n * ```\n *\n * **Example:** Foldkit\n * [Foldkit](https://foldkit.dev) apps are client-only Vite projects, so a\n * single call deploys them — the Foldkit Vite plugin in the app's own\n * `vite.config.ts` composes with the injected Cloudflare plugin. Enable\n * `single-page-application` not-found handling so deep links boot the app:\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"Foldkit\", {\n *   assets: {\n *     notFoundHandling: \"single-page-application\",\n *   },\n * });\n * ```\n * {@link Foldkit | Cloudflare.Website.Foldkit} is the same thing with that\n * default already applied.\n *\n * **Example:** Octane SPA\n * A client-only [OctaneJS](https://octanejs.dev) app (no `octane.config.ts`\n * routes) is a plain Vite SPA — the `octane()` compiler plugin in the app's\n * own `vite.config.ts` composes with the injected Cloudflare plugin:\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"Octane\", {\ntheir Schemas, brands, errors and operations. HTTP/OpenAPI, RPC and remote MCP\ncall the same API application operation, which coordinates calculation,\nrequest limits and safe measurement. No transport duplicates tax policy,\nanalytics or calculation Schemas. Browser WebMCP calls the visible page\ncommands, then the same website client.\n\nThe Website server runner supplies a private same-stage service-binding\ntransport; browser Atom supplies the checked public API URL from the root\nloader. Both implement the same named checked client contract and keep the\nnative generated client private. The Website has no live rule engine, authored\nsource loader, RPC server or backend fallback. Calculator facts go only in\nbounded bodies; reports live only in the current calculation/page state.\nCredentials are omitted and unexpected redirects rejected for public browser\ncalls. Actual native request headers determine the tested CORS allowlist.\n\nVersion the RPC contract and qualify a checked compatibility boundary so\nindependently activated Website/API Workers fail safely during version skew.\nA single Alchemy plan does not make activation atomic. Keep public HTTP/OpenAPI\nversioning and package Changesets explicit; a fresh SDK interface is not\npermission to silently repurpose an already published wire contract. T001\nestablishes any existing public consumer/version before selecting its successor.\n\nPrivate client Layers distinguish expected calculation errors, unavailable\ntransport, incompatible contract and malformed replies. Keep one total budget\nthrough headers and decoded body; preserve earlier caller interruption and\nclose abandoned bodies. Root-owned RPC/client resources survive individual\nrequest cleanup and are released at their actual host/browser lifetime. Native\nAPI handlers run in the incoming Effect fibre with no extra ManagedRuntime.\n\nExact Effect 4.0.0 exports RPC at `effect/rpc`, while the RPC source still marks\nthe APIs unstable. Requalify the older skill's invalid-reply decoder workaround,\nnative error/defect encoders, JSON codec and Alchemy integration against this\nselected source; copy no RC-specific workaround without evidence. A safe outer\nHTTP reporter alone does not prove that native RPC replies omit raw Causes,\nSchema inputs or stack details. Native global/fatal defect paths, malformed\nenvelopes, unknown procedure tags and request IDs also need qualification;\nper-procedure defect encoding alone does not cover them. Test actual wire\nreplies, request/response payloads and native logs with sensitive sentinels,\nincluding malformed valid-JSON responses and an unrelated adapter defect.\nThe public serialisation `codecFor` hook is a candidate supported adapter,\nnot yet proof that every native path is safe: an unknown-procedure response\nuses an identity encoder and can reflect its supplied tag. Qualify a supported\nchecked ingress treatment or an exact reviewed native correction for uncovered\npaths. No complete redaction capability has been established. Do not replace\nthe native protocol\nwith handwritten framing or broadly convert every defect to an expected error.\n\nSources: [selected native RPC server](https://github.com/Effect-TS/effect/blob/effect%404.0.0/packages/effect/src/rpc/RpcServer.ts),\n[client](https://github.com/Effect-TS/effect/blob/effect%404.0.0/packages/effect/src/rpc/RpcClient.ts)\nand [serialisation](https://github.com/Effect-TS/effect/blob/effect%404.0.0/packages/effect/src/rpc/RpcSerialization.ts).\nimport { PublicCalculatorService } from \"@taxkit/calculators/service\";\nimport { Effect, Match } from \"effect\";\n\nimport {\n  CalculatorRpcRejected,\n  CalculatorRpcVersionMismatch,\n} from \"./errors.js\";\nimport { TaxKitRpcGroup } from \"./group.js\";\nimport { CalculatorRpcVersion } from \"./schemas.js\";\n\nexport const TaxKitRpcHandlersLive = TaxKitRpcGroup.toLayer(\n  Effect.gen(function* () {\n    const calculator = yield* PublicCalculatorService;\n    return TaxKitRpcGroup.of({\n      Calculate: ({ request, version }) =>\n        version === CalculatorRpcVersion\n          ? calculator.calculate(request).pipe(\n              Effect.mapError((error) =>\n                Match.value(error).pipe(\n                  Match.tag(\n                    \"CalculatorInputDecodeError\",\n                    () => new CalculatorRpcRejected({ reason: \"input\" })\n                  ),\n                  Match.tag(\n                    \"UnsupportedCalculatorContextError\",\n                    () => new CalculatorRpcRejected({ reason: \"context\" })\n                  ),\n                  Match.tag(\n                    \"UnsupportedCalculatorError\",\n                    () => new CalculatorRpcRejected({ reason: \"unsupported\" })\n                  ),\n                  Match.tag(\n                    \"CalculationError\",\n                    () => new CalculatorRpcRejected({ reason: \"calculation\" })\n                  ),\n                  Match.exhaustive\n                )\n              )\n            )\n          : Effect.fail(new CalculatorRpcVersionMismatch()),\n    });\n  })\n);\nimport type { CalculatorRunServiceRequest } from \"@taxkit/calculators/schemas\";\nimport { Effect, Layer, Match, Schema } from \"effect\";\nimport { FetchHttpClient } from \"effect/http\";\nimport { Rpc, RpcClient, RpcSerialization } from \"effect/rpc\";\n\nimport {\n  CalculatorRpcDeadlineExceeded,\n  CalculatorRpcInvalidResponse,\n  CalculatorRpcUnavailable,\n} from \"./errors.js\";\nimport { Calculate, TaxKitRpcGroup } from \"./group.js\";\nimport { CalculatorRpcDeadline, CalculatorRpcVersion } from \"./schemas.js\";\nimport type { CalculatorRpcOrigin } from \"./schemas.js\";\nimport { TaxKitRpcClient } from \"./service.js\";\n\nclass RpcReplyDecodeDefect extends Schema.TaggedError<RpcReplyDecodeDefect>()(\n  \"RpcReplyDecodeDefect\",\n  {}\n) {}\n\n// Effect 4 caches the native exit Schema. Mark only its reply decoder's failure;\n// an independent adapter SchemaError remains a defect with its original identity.\nconst replySerialization = Layer.succeed(\n  RpcSerialization.RpcSerialization,\n  RpcSerialization.RpcSerialization.of({\n    ...RpcSerialization.json,\n    codecFor: <S extends Schema.Top>(schema: S) => {\n      const codec = RpcSerialization.json.codecFor(schema);\n      return schema.ast === Rpc.exitSchema(Calculate).ast\n        ? codec.pipe(\n            Schema.catchDecoding<typeof codec>(() =>\n              Effect.die(new RpcReplyDecodeDefect())\n            )\n          )\n        : codec;\n    },\n  })\n);\n\n// The app supplies its matching-stage HttpClient. Native generated clients stay\n// private and their lifetime belongs to the caller's Layer scope.\nexport const TaxKitRpcClientLive = (origin: CalculatorRpcOrigin) =>\n  Layer.effect(\n    TaxKitRpcClient,\n    Effect.gen(function* () {\n      const client = yield* RpcClient.make(TaxKitRpcGroup, {\n        disableTracing: true,\n      });\n      return TaxKitRpcClient.of({\n        calculate: Effect.fn(\"TaxKitRpcClient.calculate\")(\n          (request: CalculatorRunServiceRequest) =>\n            client.Calculate({ request, version: CalculatorRpcVersion }).pipe(\n              Effect.provideService(FetchHttpClient.RequestInit, {\n                credentials: \"omit\",\n                redirect: \"error\",\n              }),\n              Effect.timeoutOrElse({\n                duration: CalculatorRpcDeadline,\n                orElse: () => Effect.fail(new CalculatorRpcDeadlineExceeded()),\n              }),\n              Effect.catchTag(\"RpcClientError\", (error) =>\n                Effect.fail(\n                  Match.value(error.reason).pipe(\n                    Match.tag(\n                      \"RpcClientDefect\",\n                      () => new CalculatorRpcInvalidResponse()\n                    ),\n                    Match.tag(\"HttpError\", (reason) =>\n                      Match.value(reason.kind).pipe(\n                        Match.whenOr(\n                          \"DecodeError\",\n                          \"EmptyBodyError\",\n                          () => new CalculatorRpcInvalidResponse()\n                        ),\n                        Match.orElse(() => new CalculatorRpcUnavailable())\n                      )\n                    ),\n                    Match.orElse(() => new CalculatorRpcUnavailable())\n                  )\n                )\n              ),\n              Effect.catchDefect((defect) =>\n                Schema.is(RpcReplyDecodeDefect)(defect)\n                  ? Effect.fail(new CalculatorRpcInvalidResponse())\n                  : Effect.die(defect)\n              )\n            )\n        ),\n      });\n    })\n  ).pipe(\n    Layer.provide(\n      RpcClient.layerProtocolHttp({ url: new URL(\"/rpc\", origin).href })\n    ),\n    Layer.provide(replySerialization)\n  );\n","stderr":"","aggregated_output":"export const toHttpEffect = <A, E, R>(\n  appLayer: Layer.Layer<A, E, R>\n): Effect.Effect<\n  Effect.Effect<\n    HttpServerResponse.HttpServerResponse,\n    Request.Only<\"Error\", R> | Request.Only<\"GlobalError\", R> | HttpServerError.HttpServerError,\n    Scope.Scope | HttpServerRequest.HttpServerRequest | Request.Only<\"Requires\", R> | Request.Only<\"GlobalRequires\", R>\n  >,\n  Request.Without<E>,\n  Exclude<Request.Without<R>, HttpRouter> | Scope.Scope\n> =>\n  Effect.contextWith((context) => {\n    const scope = Context.get(context, Scope.Scope)\n    const memoMap = Layer.CurrentMemoMap.forkOrCreate(context)\n    return Effect.map(Layer.buildWithMemoMap(Layer.provideMerge(appLayer, layer), memoMap, scope), (context) => {\n      const router = Context.get(context, HttpRouter)\n      return router.asHttpEffect()\n    })\n  }) as any\n\nconst RouteTypeId = \"~effect/http/HttpRouter/Route\"\n\n/**\n * Description of a registered HTTP route.\n *\n * **Details**\n *\n * A route pairs an HTTP method and path pattern with a response handler, plus\n * metadata used for prefix handling and interruptibility.\n *\n * @stability unstable\n * @category routes\n * @since 4.0.0\n */\n * import { HttpRouter, HttpServerResponse } from \"effect/http\"\n *\n * const Route = HttpRouter.add(\n *   \"GET\",\n *   \"/hello\",\n *   HttpServerResponse.text(\"Hello, World!\")\n * ).pipe(\n *   // disable the logger for this route\n *   Layer.provide(HttpRouter.disableLogger)\n * )\n * Layer.isLayer(Route) // => true\n * ```\n *\n * @stability unstable\n * @category layers\n * @since 4.0.0\n */\nexport const disableLogger: Layer.Layer<never> = middleware(HttpMiddleware.withLoggerDisabled).layer\n\n/**\n * Provides request-level dependencies to some routes.\n *\n * @stability unstable\n * @category layers\n * @since 4.0.0\n */\nexport const provideRequest =\n  <A2, E2, R2>(layer: Layer.Layer<A2, E2, R2>) =>\n  <A, E, R>(self: Layer.Layer<A, E, R>): Layer.Layer<\n    A,\n    E | E2,\n    R2 | Exclude<R, Request.From<\"Requires\", A2>>\n  > =>\n    Layer.provide(\n      self,\n      middleware<{ provides: A2 }>()(Effect.gen(function*() {\n        const services = yield* Layer.build(layer as Layer.Layer<A2>)\n        return (effect) =>\n          Effect.provideContext(effect, services) as Effect.Effect<\n            HttpServerResponse.HttpServerResponse,\n            Types.unhandled\n          >\n      })).layer\n    )\n\n/**\n * Runs the provided application layer as an HTTP server.\n *\n * **Details**\n *\n * Layers first built inside the app are private to this server. Provide\n * services that must be shared with sibling layers outside `serve`.\n *\n * **Gotchas**\n *\n * The layer is built with a forked `MemoMap`, so calling `serve` twice will\n * build the same layer twice.\n *\n * @stability unstable\n * @category layers\n * @since 4.0.0\n */\nexport const serve = <A, E, R, HE, HR = Request.Only<\"Requires\", R> | Request.Only<\"GlobalRequires\", R>>(\n  appLayer: Layer.Layer<A, E, R>,\n  options?: {\n    readonly routerConfig?: Partial<FindMyWay.RouterConfig> | undefined\n    readonly disableLogger?: boolean | undefined\n        | Scope.Scope\n        | HttpServerRequest.HttpServerRequest\n        | Request.Only<\"Requires\", R>\n        | Request.Only<\"GlobalRequires\", R>\n      >\n    ) => Effect.Effect<HttpServerResponse.HttpServerResponse, HE, HR>\n  }\n): Layer.Layer<\n  A,\n  Request.Without<E>,\n  HttpServer.HttpServer | Exclude<Request.Without<R> | Exclude<HR, GlobalProvided>, HttpRouter>\n> => {\n  let middleware: any = options?.middleware\n  if (options?.disableLogger !== true) {\n    middleware = middleware ? compose(middleware, HttpMiddleware.logger) : HttpMiddleware.logger\n  }\n  const layerWithRouter = Layer.provideMerge(\n    appLayer,\n    options?.routerConfig\n      ? Layer.provide(layer, Layer.succeed(RouterConfig)(options.routerConfig))\n      : layer\n  )\n  return Effect.contextWith((context) => {\n    const memoMap = Layer.CurrentMemoMap.forkOrCreate(context)\n    return Layer.buildWithMemoMap(layerWithRouter, memoMap, Context.get(context, Scope.Scope))\n  }).pipe(\n    Effect.map((context) => {\n      const router = Context.get(context, HttpRouter)\n      const handler = router.asHttpEffect()\n      return Layer.merge(\n        middleware ? HttpServer.serve(handler, middleware) : HttpServer.serve(handler),\n        Layer.succeedContext(context)\n      )\n    }),\n    Layer.unwrap,\n    options?.disableListenLog ? identity : HttpServer.withLogAddress\n  ) as any\n}\n\n/**\n * Builds a Fetch-compatible request handler from an HTTP router application\n * layer.\n *\n * **Details**\n *\n * The result contains a `handler` function that converts Web `Request` values to\n * Web `Response` values and a `dispose` function for releasing the layer\n * resources. The layer is built immediately, so the cost is paid when the\n * handler is created rather than on the first request. A layer that performs\n * asynchronous work while building may still be in progress when the first\n * request arrives, in which case that request waits for the build to finish.\n * If the build fails, every request rejects with the build error.\n *\n * @stability unstable\n * @category converting\n * @since 4.0.0\n */\nexport const toWebHandler = <\n  A,\n  E,\n  R extends\n    | HttpRouter\n    | Request<\"Requires\", any>\n    | Request<\"GlobalRequires\", any>\n    | Request<\"Error\", any>\n    | Request<\"GlobalError\", any>,\n  HE,\n  HR = Exclude<Request.Only<\"Requires\", R> | Request.Only<\"GlobalRequires\", R>, A>,\n  ReqR = Exclude<HR, A | Scope.Scope | HttpServerRequest.HttpServerRequest>\n>(\n  appLayer: Layer.Layer<A, E, R>,\n *     traffic: 25,\n *     affinity: { cookie: \"session_id\", ip: true },\n *   },\n * });\n * ```\n *\n * ### The Worker's own URL\n * `Worker.URL` injects the URL a Worker is served at as a binding on that\n * same Worker — the first custom `domain` if one is configured, otherwise\n * its `workers.dev` URL, always equal to the resource's `url` attribute.\n * Under `alchemy dev` it resolves to the local dev server's URL.\n *\n * **Example:** Read the Worker's own URL inside a handler\n * ```typescript\n * Cloudflare.Worker(\n *   \"Api\",\n *   { main: import.meta.url },\n *   Effect.gen(function* () {\n *     // Attaches the binding and returns a deferred accessor.\n *     const url = yield* Cloudflare.Worker.URL;\n *\n *     return {\n *       fetch: Effect.gen(function* () {\n *         const publicUrl = yield* url;\n *         return yield* HttpServerResponse.json({ url: publicUrl });\n *       }),\n *     };\n *   }),\n * );\n * ```\n *\n * **Example:** Inject the URL into an async Worker's env\n * `InferEnv` types the entry as `string`. A `VITE_`-prefixed key on a\n * vite-built Worker is additionally inlined into the client bundle as\n * `import.meta.env.VITE_PUBLIC_URL` at build time.\n * ```typescript\n * export const Worker = Cloudflare.Worker(\"Worker\", {\n *   main: \"./src/worker.ts\",\n *   env: { PUBLIC_URL: Cloudflare.Worker.URL },\n * });\n *\n * export type WorkerEnv = Cloudflare.InferEnv<typeof Worker>;\n * //   { PUBLIC_URL: string }\n * ```\n *\n * See the [Python Workers guide](/cloudflare/compute/python-workers)\n * for the full walkthrough.\n *\n * **Example:** Defining a Python Worker in your stack\n * ```typescript\n * // alchemy.run.ts\n * const kv = yield* Cloudflare.KV.Namespace(\"Cache\");\n *\n * export const Worker = Cloudflare.Worker(\"Worker\", {\n *   main: \"./src/worker.py\",\n *   env: { CACHE: kv },\n * });\n * ```\n *\n * **Example:** Writing the Python handler\n * ```python\n * # src/worker.py\n * from workers import Response, WorkerEntrypoint\n *\n * class Default(WorkerEntrypoint):\n *     async def fetch(self, request):\n *         cached = await self.env.CACHE.get(\"greeting\")\n *         return Response(cached or \"Hello from Python!\")\n * ```\n *\n * **Example:** Vendoring dependencies with pyproject.toml\n * ```toml\n * # src/pyproject.toml — vendored with uv on deploy\n * [project]\n * name = \"my-worker\"\n * version = \"0.1.0\"\n * requires-python = \">=3.13\"\n * dependencies = [\"humanize\"]\n * ```\n *\n * ### Effect Workers\n * Pass the Effect implementation as the third argument. This is the\n * simplest Effect-based approach — everything lives in one file.\n * Convenient for standalone Workers that don't need to be referenced\n * by other Workers.\n *\n * **Example:** Worker Effect\n * ```typescript\n * export default class MyWorker extends Cloudflare.Worker<MyWorker>()(\n *   \"MyWorker\",\n *   { main: import.meta.url },\n *   Effect.gen(function* () {\n *     // Construction: bind resources\n *     const kv = yield* Cloudflare.KV.ReadWriteNamespace(MyKV);\n *\n *     return {\n *       // Runtime: use them\n *       fetch: Effect.gen(function* () {\n *         const value = yield* kv.get(\"key\");\n *         return HttpServerResponse.text(value ?? \"not found\");\n *       }),\n *     };\n *   }),\n * ) {}\n * ```\n *\n * ### Worker Layer\n * When two Workers need to reference each other (e.g. WorkerA calls\n * WorkerB and vice versa), or you simply want optimal tree-shaking,\n * define the Worker class separately from its `.make()` call. The\n * class is a lightweight identifier; `.make()` provides the runtime\n * implementation as an `export default`. Rolldown treats `.make()`\n * as pure, so any Worker that imports the class to bind it will not\n * pull in the `.make()` dependencies — the bundler tree-shakes\n * them away entirely.\n *\n * The class and `.make()` can live in the same file. This is the\n * same pattern used by `Container` and `DurableObject`,\n * and is recommended for any cross-Worker or cross-DO bindings.\n *\n * **Example:** Worker Layer (class + .make() in one file)\n * ```typescript\n * // src/WorkerB.ts — the tag carries the name + RPC shape; props live\n * // on `.make()`.\n * export class WorkerB extends Cloudflare.Worker<\n *   WorkerB,\n *   { greet: (name: string) => Effect.Effect<string> }\n * >()(\"WorkerB\") {}\n *\n * export default WorkerB.make(\n *   { main: import.meta.url },\n *   Effect.gen(function* () {\n *     // Construction: bind resources\n *     const kv = yield* Cloudflare.KV.ReadWriteNamespace(MyKV);\n *\n *     return {\n *       // Runtime: use them\n *       greet: (name: string) =>\n *         Effect.gen(function* () {\n *           yield* kv.put(\"last-greeted\", name);\n *           return `Hello ${name}`;\n *         }),\n *     };\n *   }),\n * );\n * ```\n *\n * **Example:** Binding a Worker Layer from another Worker\n * ```typescript\n * // src/WorkerA.ts — imports WorkerB; bundler tree-shakes .make()\n * import WorkerB from \"./WorkerB.ts\";\n *\n * export default class WorkerA extends Cloudflare.Worker<WorkerA>()(\n *   \"WorkerA\",\n *   { main: import.meta.url },\n *   Effect.gen(function* () {\n *     const b = yield* Cloudflare.Workers.bindWorker(WorkerB);\n *     return {\n *       fetch: Effect.gen(function* () {\n *         return yield* b.greet(\"world\");\n *       }),\n *     };\n *   }),\n * ) {}\n * ```\n *\n * ### Configuration\n * The props object controls compatibility flags, static assets, and\n * build options. These are evaluated at deploy time.\n *\n * **Example:** Enabling Node.js compatibility\n * ```typescript\n * {\n *   main: import.meta.url,\n *   compatibility: {\n *     flags: [\"nodejs_compat\"],\n *     date: \"2026-08-31\",\n *   },\n * }\n * ```\nimport * as Effect from \"effect/Effect\";\nimport type { InputProps } from \"../../Input.ts\";\nimport { effectClass } from \"../../Util/effect.ts\";\nimport type { Providers } from \"../Providers.ts\";\nimport type { AssetsConfig } from \"../Workers/Assets.ts\";\nimport {\n  Worker,\n  type NormalizedBindings,\n  type ViteOptions,\n  type WorkerAssetsConfig,\n  type WorkerBindingProps,\n  type WorkerProps,\n} from \"../Workers/Worker.ts\";\n\nexport interface ViteProps<Bindings extends WorkerBindingProps = {}>\n  extends Omit<WorkerProps<Bindings>, \"vite\" | \"main\" | \"assets\">, ViteOptions {\n  /**\n   * Optional configuration for static asset routing behavior.\n   * Supports `runWorkerFirst`, `htmlHandling`, `notFoundHandling`, etc.\n   */\n  assets?: AssetsConfig;\n}\n\n/**\n * A Cloudflare Worker deployed from a Vite project.\n *\n * `Vite` uses the Cloudflare Vite plugin to build both the server bundle\n * and client assets in a single `vite build` invocation — no manual\n * `main` entrypoint, build command, output directory, or Wrangler\n * configuration required.\n *\n * Input files are content-hashed (respecting `.gitignore` by default) so\n * unchanged projects skip the build and deploy entirely.\n *\n *\n * ### Deploying a Static Site\n * For a pure static site (no SSR), a single call is all you need.\n * Vite builds the project and Alchemy deploys the output as a\n * Cloudflare Worker with static assets.\n *\n * **Example:** Static Vite site\n * ```typescript\n * const site = yield* Cloudflare.Website.Vite(\"Website\");\n * ```\n *\n * ### SSR Frameworks\n * SSR frameworks like TanStack Start or SolidStart work with a single\n * call — the `nodejs_compat` compatibility flag is enabled by default\n * so the server bundle can use Node.js APIs.\n *\n * **Example:** TanStack Start\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"TanStackStart\");\n * ```\n *\n * **Example:** SolidStart with worker-first routing\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"SolidStart\", {\n *   assets: { runWorkerFirst: true },\n * });\n * ```\n *\n * **Example:** React Router\n * React Router's server build (`virtual:react-router/server-build`) is a\n * build manifest with no default export, so it cannot be deployed as the\n * Worker entry directly. Point `main` at a module that wraps it with\n * `createRequestHandler` (React Router's Cloudflare template ships this\n * as `workers/app.ts`):\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"ReactRouter\", {\n *   main: \"workers/app.ts\",\n * });\n * ```\n *\n * ### React Server Components\n * Frameworks that emit more than one server environment (e.g. React\n * Server Components, which split into an `rsc` environment and an `ssr`\n * environment) need `viteEnvironments` to declare which environment\n * produces the deployed Worker entry and which additional server\n * environments to bundle alongside it. The `client` environment is\n * always deployed as static assets.\n *\n * **Example:** React Router with RSC\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"ReactRouterRSC\", {\n *   viteEnvironments: {\n *     entry: \"rsc\",\n *     children: [\"ssr\"],\n *   },\n * });\n * ```\n *\n * ### Custom Worker Entry\n * By default the deployed Worker entry is the server bundle the\n * framework produces. When the Worker must export more than the\n * framework's fetch handler — Durable Object classes, additional\n * handlers — point `main` at your own module that wraps the framework\n * handler and re-exports the extras. `main` takes precedence over any\n * entry configured in the Vite config.\n *\n * **Example:** Custom entry hosting Durable Objects\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"App\", {\n *   main: \"worker/index.ts\",\n *   viteEnvironments: {\n *     entry: \"rsc\",\n *     children: [\"ssr\"],\n *   },\n * });\n * ```\n *\n * ### Single-Page Applications\n * For SPAs (React, Vue, etc.), configure asset handling so unmatched\n * routes fall back to `index.html` and the client router takes over.\n *\n * **Example:** Vue SPA\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"Vue\", {\n *   assets: {\n *     notFoundHandling: \"single-page-application\",\n *   },\n * });\n * ```\n *\n * **Example:** Foldkit\n * [Foldkit](https://foldkit.dev) apps are client-only Vite projects, so a\n * single call deploys them — the Foldkit Vite plugin in the app's own\n * `vite.config.ts` composes with the injected Cloudflare plugin. Enable\n * `single-page-application` not-found handling so deep links boot the app:\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"Foldkit\", {\n *   assets: {\n *     notFoundHandling: \"single-page-application\",\n *   },\n * });\n * ```\n * {@link Foldkit | Cloudflare.Website.Foldkit} is the same thing with that\n * default already applied.\n *\n * **Example:** Octane SPA\n * A client-only [OctaneJS](https://octanejs.dev) app (no `octane.config.ts`\n * routes) is a plain Vite SPA — the `octane()` compiler plugin in the app's\n * own `vite.config.ts` composes with the injected Cloudflare plugin:\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"Octane\", {\ntheir Schemas, brands, errors and operations. HTTP/OpenAPI, RPC and remote MCP\ncall the same API application operation, which coordinates calculation,\nrequest limits and safe measurement. No transport duplicates tax policy,\nanalytics or calculation Schemas. Browser WebMCP calls the visible page\ncommands, then the same website client.\n\nThe Website server runner supplies a private same-stage service-binding\ntransport; browser Atom supplies the checked public API URL from the root\nloader. Both implement the same named checked client contract and keep the\nnative generated client private. The Website has no live rule engine, authored\nsource loader, RPC server or backend fallback. Calculator facts go only in\nbounded bodies; reports live only in the current calculation/page state.\nCredentials are omitted and unexpected redirects rejected for public browser\ncalls. Actual native request headers determine the tested CORS allowlist.\n\nVersion the RPC contract and qualify a checked compatibility boundary so\nindependently activated Website/API Workers fail safely during version skew.\nA single Alchemy plan does not make activation atomic. Keep public HTTP/OpenAPI\nversioning and package Changesets explicit; a fresh SDK interface is not\npermission to silently repurpose an already published wire contract. T001\nestablishes any existing public consumer/version before selecting its successor.\n\nPrivate client Layers distinguish expected calculation errors, unavailable\ntransport, incompatible contract and malformed replies. Keep one total budget\nthrough headers and decoded body; preserve earlier caller interruption and\nclose abandoned bodies. Root-owned RPC/client resources survive individual\nrequest cleanup and are released at their actual host/browser lifetime. Native\nAPI handlers run in the incoming Effect fibre with no extra ManagedRuntime.\n\nExact Effect 4.0.0 exports RPC at `effect/rpc`, while the RPC source still marks\nthe APIs unstable. Requalify the older skill's invalid-reply decoder workaround,\nnative error/defect encoders, JSON codec and Alchemy integration against this\nselected source; copy no RC-specific workaround without evidence. A safe outer\nHTTP reporter alone does not prove that native RPC replies omit raw Causes,\nSchema inputs or stack details. Native global/fatal defect paths, malformed\nenvelopes, unknown procedure tags and request IDs also need qualification;\nper-procedure defect encoding alone does not cover them. Test actual wire\nreplies, request/response payloads and native logs with sensitive sentinels,\nincluding malformed valid-JSON responses and an unrelated adapter defect.\nThe public serialisation `codecFor` hook is a candidate supported adapter,\nnot yet proof that every native path is safe: an unknown-procedure response\nuses an identity encoder and can reflect its supplied tag. Qualify a supported\nchecked ingress treatment or an exact reviewed native correction for uncovered\npaths. No complete redaction capability has been established. Do not replace\nthe native protocol\nwith handwritten framing or broadly convert every defect to an expected error.\n\nSources: [selected native RPC server](https://github.com/Effect-TS/effect/blob/effect%404.0.0/packages/effect/src/rpc/RpcServer.ts),\n[client](https://github.com/Effect-TS/effect/blob/effect%404.0.0/packages/effect/src/rpc/RpcClient.ts)\nand [serialisation](https://github.com/Effect-TS/effect/blob/effect%404.0.0/packages/effect/src/rpc/RpcSerialization.ts).\nimport { PublicCalculatorService } from \"@taxkit/calculators/service\";\nimport { Effect, Match } from \"effect\";\n\nimport {\n  CalculatorRpcRejected,\n  CalculatorRpcVersionMismatch,\n} from \"./errors.js\";\nimport { TaxKitRpcGroup } from \"./group.js\";\nimport { CalculatorRpcVersion } from \"./schemas.js\";\n\nexport const TaxKitRpcHandlersLive = TaxKitRpcGroup.toLayer(\n  Effect.gen(function* () {\n    const calculator = yield* PublicCalculatorService;\n    return TaxKitRpcGroup.of({\n      Calculate: ({ request, version }) =>\n        version === CalculatorRpcVersion\n          ? calculator.calculate(request).pipe(\n              Effect.mapError((error) =>\n                Match.value(error).pipe(\n                  Match.tag(\n                    \"CalculatorInputDecodeError\",\n                    () => new CalculatorRpcRejected({ reason: \"input\" })\n                  ),\n                  Match.tag(\n                    \"UnsupportedCalculatorContextError\",\n                    () => new CalculatorRpcRejected({ reason: \"context\" })\n                  ),\n                  Match.tag(\n                    \"UnsupportedCalculatorError\",\n                    () => new CalculatorRpcRejected({ reason: \"unsupported\" })\n                  ),\n                  Match.tag(\n                    \"CalculationError\",\n                    () => new CalculatorRpcRejected({ reason: \"calculation\" })\n                  ),\n                  Match.exhaustive\n                )\n              )\n            )\n          : Effect.fail(new CalculatorRpcVersionMismatch()),\n    });\n  })\n);\nimport type { CalculatorRunServiceRequest } from \"@taxkit/calculators/schemas\";\nimport { Effect, Layer, Match, Schema } from \"effect\";\nimport { FetchHttpClient } from \"effect/http\";\nimport { Rpc, RpcClient, RpcSerialization } from \"effect/rpc\";\n\nimport {\n  CalculatorRpcDeadlineExceeded,\n  CalculatorRpcInvalidResponse,\n  CalculatorRpcUnavailable,\n} from \"./errors.js\";\nimport { Calculate, TaxKitRpcGroup } from \"./group.js\";\nimport { CalculatorRpcDeadline, CalculatorRpcVersion } from \"./schemas.js\";\nimport type { CalculatorRpcOrigin } from \"./schemas.js\";\nimport { TaxKitRpcClient } from \"./service.js\";\n\nclass RpcReplyDecodeDefect extends Schema.TaggedError<RpcReplyDecodeDefect>()(\n  \"RpcReplyDecodeDefect\",\n  {}\n) {}\n\n// Effect 4 caches the native exit Schema. Mark only its reply decoder's failure;\n// an independent adapter SchemaError remains a defect with its original identity.\nconst replySerialization = Layer.succeed(\n  RpcSerialization.RpcSerialization,\n  RpcSerialization.RpcSerialization.of({\n    ...RpcSerialization.json,\n    codecFor: <S extends Schema.Top>(schema: S) => {\n      const codec = RpcSerialization.json.codecFor(schema);\n      return schema.ast === Rpc.exitSchema(Calculate).ast\n        ? codec.pipe(\n            Schema.catchDecoding<typeof codec>(() =>\n              Effect.die(new RpcReplyDecodeDefect())\n            )\n          )\n        : codec;\n    },\n  })\n);\n\n// The app supplies its matching-stage HttpClient. Native generated clients stay\n// private and their lifetime belongs to the caller's Layer scope.\nexport const TaxKitRpcClientLive = (origin: CalculatorRpcOrigin) =>\n  Layer.effect(\n    TaxKitRpcClient,\n    Effect.gen(function* () {\n      const client = yield* RpcClient.make(TaxKitRpcGroup, {\n        disableTracing: true,\n      });\n      return TaxKitRpcClient.of({\n        calculate: Effect.fn(\"TaxKitRpcClient.calculate\")(\n          (request: CalculatorRunServiceRequest) =>\n            client.Calculate({ request, version: CalculatorRpcVersion }).pipe(\n              Effect.provideService(FetchHttpClient.RequestInit, {\n                credentials: \"omit\",\n                redirect: \"error\",\n              }),\n              Effect.timeoutOrElse({\n                duration: CalculatorRpcDeadline,\n                orElse: () => Effect.fail(new CalculatorRpcDeadlineExceeded()),\n              }),\n              Effect.catchTag(\"RpcClientError\", (error) =>\n                Effect.fail(\n                  Match.value(error.reason).pipe(\n                    Match.tag(\n                      \"RpcClientDefect\",\n                      () => new CalculatorRpcInvalidResponse()\n                    ),\n                    Match.tag(\"HttpError\", (reason) =>\n                      Match.value(reason.kind).pipe(\n                        Match.whenOr(\n                          \"DecodeError\",\n                          \"EmptyBodyError\",\n                          () => new CalculatorRpcInvalidResponse()\n                        ),\n                        Match.orElse(() => new CalculatorRpcUnavailable())\n                      )\n                    ),\n                    Match.orElse(() => new CalculatorRpcUnavailable())\n                  )\n                )\n              ),\n              Effect.catchDefect((defect) =>\n                Schema.is(RpcReplyDecodeDefect)(defect)\n                  ? Effect.fail(new CalculatorRpcInvalidResponse())\n                  : Effect.die(defect)\n              )\n            )\n        ),\n      });\n    })\n  ).pipe(\n    Layer.provide(\n      RpcClient.layerProtocolHttp({ url: new URL(\"/rpc\", origin).href })\n    ),\n    Layer.provide(replySerialization)\n  );\n","exit_code":0,"duration":{"secs":0,"nanos":6459},"formatted_output":"export const toHttpEffect = <A, E, R>(\n  appLayer: Layer.Layer<A, E, R>\n): Effect.Effect<\n  Effect.Effect<\n    HttpServerResponse.HttpServerResponse,\n    Request.Only<\"Error\", R> | Request.Only<\"GlobalError\", R> | HttpServerError.HttpServerError,\n    Scope.Scope | HttpServerRequest.HttpServerRequest | Request.Only<\"Requires\", R> | Request.Only<\"GlobalRequires\", R>\n  >,\n  Request.Without<E>,\n  Exclude<Request.Without<R>, HttpRouter> | Scope.Scope\n> =>\n  Effect.contextWith((context) => {\n    const scope = Context.get(context, Scope.Scope)\n    const memoMap = Layer.CurrentMemoMap.forkOrCreate(context)\n    return Effect.map(Layer.buildWithMemoMap(Layer.provideMerge(appLayer, layer), memoMap, scope), (context) => {\n      const router = Context.get(context, HttpRouter)\n      return router.asHttpEffect()\n    })\n  }) as any\n\nconst RouteTypeId = \"~effect/http/HttpRouter/Route\"\n\n/**\n * Description of a registered HTTP route.\n *\n * **Details**\n *\n * A route pairs an HTTP method and path pattern with a response handler, plus\n * metadata used for prefix handling and interruptibility.\n *\n * @stability unstable\n * @category routes\n * @since 4.0.0\n */\n * import { HttpRouter, HttpServerResponse } from \"effect/http\"\n *\n * const Route = HttpRouter.add(\n *   \"GET\",\n *   \"/hello\",\n *   HttpServerResponse.text(\"Hello, World!\")\n * ).pipe(\n *   // disable the logger for this route\n *   Layer.provide(HttpRouter.disableLogger)\n * )\n * Layer.isLayer(Route) // => true\n * ```\n *\n * @stability unstable\n * @category layers\n * @since 4.0.0\n */\nexport const disableLogger: Layer.Layer<never> = middleware(HttpMiddleware.withLoggerDisabled).layer\n\n/**\n * Provides request-level dependencies to some routes.\n *\n * @stability unstable\n * @category layers\n * @since 4.0.0\n */\nexport const provideRequest =\n  <A2, E2, R2>(layer: Layer.Layer<A2, E2, R2>) =>\n  <A, E, R>(self: Layer.Layer<A, E, R>): Layer.Layer<\n    A,\n    E | E2,\n    R2 | Exclude<R, Request.From<\"Requires\", A2>>\n  > =>\n    Layer.provide(\n      self,\n      middleware<{ provides: A2 }>()(Effect.gen(function*() {\n        const services = yield* Layer.build(layer as Layer.Layer<A2>)\n        return (effect) =>\n          Effect.provideContext(effect, services) as Effect.Effect<\n            HttpServerResponse.HttpServerResponse,\n            Types.unhandled\n          >\n      })).layer\n    )\n\n/**\n * Runs the provided application layer as an HTTP server.\n *\n * **Details**\n *\n * Layers first built inside the app are private to this server. Provide\n * services that must be shared with sibling layers outside `serve`.\n *\n * **Gotchas**\n *\n * The layer is built with a forked `MemoMap`, so calling `serve` twice will\n * build the same layer twice.\n *\n * @stability unstable\n * @category layers\n * @since 4.0.0\n */\nexport const serve = <A, E, R, HE, HR = Request.Only<\"Requires\", R> | Request.Only<\"GlobalRequires\", R>>(\n  appLayer: Layer.Layer<A, E, R>,\n  options?: {\n    readonly routerConfig?: Partial<FindMyWay.RouterConfig> | undefined\n    readonly disableLogger?: boolean | undefined\n        | Scope.Scope\n        | HttpServerRequest.HttpServerRequest\n        | Request.Only<\"Requires\", R>\n        | Request.Only<\"GlobalRequires\", R>\n      >\n    ) => Effect.Effect<HttpServerResponse.HttpServerResponse, HE, HR>\n  }\n): Layer.Layer<\n  A,\n  Request.Without<E>,\n  HttpServer.HttpServer | Exclude<Request.Without<R> | Exclude<HR, GlobalProvided>, HttpRouter>\n> => {\n  let middleware: any = options?.middleware\n  if (options?.disableLogger !== true) {\n    middleware = middleware ? compose(middleware, HttpMiddleware.logger) : HttpMiddleware.logger\n  }\n  const layerWithRouter = Layer.provideMerge(\n    appLayer,\n    options?.routerConfig\n      ? Layer.provide(layer, Layer.succeed(RouterConfig)(options.routerConfig))\n      : layer\n  )\n  return Effect.contextWith((context) => {\n    const memoMap = Layer.CurrentMemoMap.forkOrCreate(context)\n    return Layer.buildWithMemoMap(layerWithRouter, memoMap, Context.get(context, Scope.Scope))\n  }).pipe(\n    Effect.map((context) => {\n      const router = Context.get(context, HttpRouter)\n      const handler = router.asHttpEffect()\n      return Layer.merge(\n        middleware ? HttpServer.serve(handler, middleware) : HttpServer.serve(handler),\n        Layer.succeedContext(context)\n      )\n    }),\n    Layer.unwrap,\n    options?.disableListenLog ? identity : HttpServer.withLogAddress\n  ) as any\n}\n\n/**\n * Builds a Fetch-compatible request handler from an HTTP router application\n * layer.\n *\n * **Details**\n *\n * The result contains a `handler` function that converts Web `Request` values to\n * Web `Response` values and a `dispose` function for releasing the layer\n * resources. The layer is built immediately, so the cost is paid when the\n * handler is created rather than on the first request. A layer that performs\n * asynchronous work while building may still be in progress when the first\n * request arrives, in which case that request waits for the build to finish.\n * If the build fails, every request rejects with the build error.\n *\n * @stability unstable\n * @category converting\n * @since 4.0.0\n */\nexport const toWebHandler = <\n  A,\n  E,\n  R extends\n    | HttpRouter\n    | Request<\"Requires\", any>\n    | Request<\"GlobalRequires\", any>\n    | Request<\"Error\", any>\n    | Request<\"GlobalError\", any>,\n  HE,\n  HR = Exclude<Request.Only<\"Requires\", R> | Request.Only<\"GlobalRequires\", R>, A>,\n  ReqR = Exclude<HR, A | Scope.Scope | HttpServerRequest.HttpServerRequest>\n>(\n  appLayer: Layer.Layer<A, E, R>,\n *     traffic: 25,\n *     affinity: { cookie: \"session_id\", ip: true },\n *   },\n * });\n * ```\n *\n * ### The Worker's own URL\n * `Worker.URL` injects the URL a Worker is served at as a binding on that\n * same Worker — the first custom `domain` if one is configured, otherwise\n * its `workers.dev` URL, always equal to the resource's `url` attribute.\n * Under `alchemy dev` it resolves to the local dev server's URL.\n *\n * **Example:** Read the Worker's own URL inside a handler\n * ```typescript\n * Cloudflare.Worker(\n *   \"Api\",\n *   { main: import.meta.url },\n *   Effect.gen(function* () {\n *     // Attaches the binding and returns a deferred accessor.\n *     const url = yield* Cloudflare.Worker.URL;\n *\n *     return {\n *       fetch: Effect.gen(function* () {\n *         const publicUrl = yield* url;\n *         return yield* HttpServerResponse.json({ url: publicUrl });\n *       }),\n *     };\n *   }),\n * );\n * ```\n *\n * **Example:** Inject the URL into an async Worker's env\n * `InferEnv` types the entry as `string`. A `VITE_`-prefixed key on a\n * vite-built Worker is additionally inlined into the client bundle as\n * `import.meta.env.VITE_PUBLIC_URL` at build time.\n * ```typescript\n * export const Worker = Cloudflare.Worker(\"Worker\", {\n *   main: \"./src/worker.ts\",\n *   env: { PUBLIC_URL: Cloudflare.Worker.URL },\n * });\n *\n * export type WorkerEnv = Cloudflare.InferEnv<typeof Worker>;\n * //   { PUBLIC_URL: string }\n * ```\n *\n * See the [Python Workers guide](/cloudflare/compute/python-workers)\n * for the full walkthrough.\n *\n * **Example:** Defining a Python Worker in your stack\n * ```typescript\n * // alchemy.run.ts\n * const kv = yield* Cloudflare.KV.Namespace(\"Cache\");\n *\n * export const Worker = Cloudflare.Worker(\"Worker\", {\n *   main: \"./src/worker.py\",\n *   env: { CACHE: kv },\n * });\n * ```\n *\n * **Example:** Writing the Python handler\n * ```python\n * # src/worker.py\n * from workers import Response, WorkerEntrypoint\n *\n * class Default(WorkerEntrypoint):\n *     async def fetch(self, request):\n *         cached = await self.env.CACHE.get(\"greeting\")\n *         return Response(cached or \"Hello from Python!\")\n * ```\n *\n * **Example:** Vendoring dependencies with pyproject.toml\n * ```toml\n * # src/pyproject.toml — vendored with uv on deploy\n * [project]\n * name = \"my-worker\"\n * version = \"0.1.0\"\n * requires-python = \">=3.13\"\n * dependencies = [\"humanize\"]\n * ```\n *\n * ### Effect Workers\n * Pass the Effect implementation as the third argument. This is the\n * simplest Effect-based approach — everything lives in one file.\n * Convenient for standalone Workers that don't need to be referenced\n * by other Workers.\n *\n * **Example:** Worker Effect\n * ```typescript\n * export default class MyWorker extends Cloudflare.Worker<MyWorker>()(\n *   \"MyWorker\",\n *   { main: import.meta.url },\n *   Effect.gen(function* () {\n *     // Construction: bind resources\n *     const kv = yield* Cloudflare.KV.ReadWriteNamespace(MyKV);\n *\n *     return {\n *       // Runtime: use them\n *       fetch: Effect.gen(function* () {\n *         const value = yield* kv.get(\"key\");\n *         return HttpServerResponse.text(value ?? \"not found\");\n *       }),\n *     };\n *   }),\n * ) {}\n * ```\n *\n * ### Worker Layer\n * When two Workers need to reference each other (e.g. WorkerA calls\n * WorkerB and vice versa), or you simply want optimal tree-shaking,\n * define the Worker class separately from its `.make()` call. The\n * class is a lightweight identifier; `.make()` provides the runtime\n * implementation as an `export default`. Rolldown treats `.make()`\n * as pure, so any Worker that imports the class to bind it will not\n * pull in the `.make()` dependencies — the bundler tree-shakes\n * them away entirely.\n *\n * The class and `.make()` can live in the same file. This is the\n * same pattern used by `Container` and `DurableObject`,\n * and is recommended for any cross-Worker or cross-DO bindings.\n *\n * **Example:** Worker Layer (class + .make() in one file)\n * ```typescript\n * // src/WorkerB.ts — the tag carries the name + RPC shape; props live\n * // on `.make()`.\n * export class WorkerB extends Cloudflare.Worker<\n *   WorkerB,\n *   { greet: (name: string) => Effect.Effect<string> }\n * >()(\"WorkerB\") {}\n *\n * export default WorkerB.make(\n *   { main: import.meta.url },\n *   Effect.gen(function* () {\n *     // Construction: bind resources\n *     const kv = yield* Cloudflare.KV.ReadWriteNamespace(MyKV);\n *\n *     return {\n *       // Runtime: use them\n *       greet: (name: string) =>\n *         Effect.gen(function* () {\n *           yield* kv.put(\"last-greeted\", name);\n *           return `Hello ${name}`;\n *         }),\n *     };\n *   }),\n * );\n * ```\n *\n * **Example:** Binding a Worker Layer from another Worker\n * ```typescript\n * // src/WorkerA.ts — imports WorkerB; bundler tree-shakes .make()\n * import WorkerB from \"./WorkerB.ts\";\n *\n * export default class WorkerA extends Cloudflare.Worker<WorkerA>()(\n *   \"WorkerA\",\n *   { main: import.meta.url },\n *   Effect.gen(function* () {\n *     const b = yield* Cloudflare.Workers.bindWorker(WorkerB);\n *     return {\n *       fetch: Effect.gen(function* () {\n *         return yield* b.greet(\"world\");\n *       }),\n *     };\n *   }),\n * ) {}\n * ```\n *\n * ### Configuration\n * The props object controls compatibility flags, static assets, and\n * build options. These are evaluated at deploy time.\n *\n * **Example:** Enabling Node.js compatibility\n * ```typescript\n * {\n *   main: import.meta.url,\n *   compatibility: {\n *     flags: [\"nodejs_compat\"],\n *     date: \"2026-08-31\",\n *   },\n * }\n * ```\nimport * as Effect from \"effect/Effect\";\nimport type { InputProps } from \"../../Input.ts\";\nimport { effectClass } from \"../../Util/effect.ts\";\nimport type { Providers } from \"../Providers.ts\";\nimport type { AssetsConfig } from \"../Workers/Assets.ts\";\nimport {\n  Worker,\n  type NormalizedBindings,\n  type ViteOptions,\n  type WorkerAssetsConfig,\n  type WorkerBindingProps,\n  type WorkerProps,\n} from \"../Workers/Worker.ts\";\n\nexport interface ViteProps<Bindings extends WorkerBindingProps = {}>\n  extends Omit<WorkerProps<Bindings>, \"vite\" | \"main\" | \"assets\">, ViteOptions {\n  /**\n   * Optional configuration for static asset routing behavior.\n   * Supports `runWorkerFirst`, `htmlHandling`, `notFoundHandling`, etc.\n   */\n  assets?: AssetsConfig;\n}\n\n/**\n * A Cloudflare Worker deployed from a Vite project.\n *\n * `Vite` uses the Cloudflare Vite plugin to build both the server bundle\n * and client assets in a single `vite build` invocation — no manual\n * `main` entrypoint, build command, output directory, or Wrangler\n * configuration required.\n *\n * Input files are content-hashed (respecting `.gitignore` by default) so\n * unchanged projects skip the build and deploy entirely.\n *\n *\n * ### Deploying a Static Site\n * For a pure static site (no SSR), a single call is all you need.\n * Vite builds the project and Alchemy deploys the output as a\n * Cloudflare Worker with static assets.\n *\n * **Example:** Static Vite site\n * ```typescript\n * const site = yield* Cloudflare.Website.Vite(\"Website\");\n * ```\n *\n * ### SSR Frameworks\n * SSR frameworks like TanStack Start or SolidStart work with a single\n * call — the `nodejs_compat` compatibility flag is enabled by default\n * so the server bundle can use Node.js APIs.\n *\n * **Example:** TanStack Start\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"TanStackStart\");\n * ```\n *\n * **Example:** SolidStart with worker-first routing\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"SolidStart\", {\n *   assets: { runWorkerFirst: true },\n * });\n * ```\n *\n * **Example:** React Router\n * React Router's server build (`virtual:react-router/server-build`) is a\n * build manifest with no default export, so it cannot be deployed as the\n * Worker entry directly. Point `main` at a module that wraps it with\n * `createRequestHandler` (React Router's Cloudflare template ships this\n * as `workers/app.ts`):\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"ReactRouter\", {\n *   main: \"workers/app.ts\",\n * });\n * ```\n *\n * ### React Server Components\n * Frameworks that emit more than one server environment (e.g. React\n * Server Components, which split into an `rsc` environment and an `ssr`\n * environment) need `viteEnvironments` to declare which environment\n * produces the deployed Worker entry and which additional server\n * environments to bundle alongside it. The `client` environment is\n * always deployed as static assets.\n *\n * **Example:** React Router with RSC\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"ReactRouterRSC\", {\n *   viteEnvironments: {\n *     entry: \"rsc\",\n *     children: [\"ssr\"],\n *   },\n * });\n * ```\n *\n * ### Custom Worker Entry\n * By default the deployed Worker entry is the server bundle the\n * framework produces. When the Worker must export more than the\n * framework's fetch handler — Durable Object classes, additional\n * handlers — point `main` at your own module that wraps the framework\n * handler and re-exports the extras. `main` takes precedence over any\n * entry configured in the Vite config.\n *\n * **Example:** Custom entry hosting Durable Objects\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"App\", {\n *   main: \"worker/index.ts\",\n *   viteEnvironments: {\n *     entry: \"rsc\",\n *     children: [\"ssr\"],\n *   },\n * });\n * ```\n *\n * ### Single-Page Applications\n * For SPAs (React, Vue, etc.), configure asset handling so unmatched\n * routes fall back to `index.html` and the client router takes over.\n *\n * **Example:** Vue SPA\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"Vue\", {\n *   assets: {\n *     notFoundHandling: \"single-page-application\",\n *   },\n * });\n * ```\n *\n * **Example:** Foldkit\n * [Foldkit](https://foldkit.dev) apps are client-only Vite projects, so a\n * single call deploys them — the Foldkit Vite plugin in the app's own\n * `vite.config.ts` composes with the injected Cloudflare plugin. Enable\n * `single-page-application` not-found handling so deep links boot the app:\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"Foldkit\", {\n *   assets: {\n *     notFoundHandling: \"single-page-application\",\n *   },\n * });\n * ```\n * {@link Foldkit | Cloudflare.Website.Foldkit} is the same thing with that\n * default already applied.\n *\n * **Example:** Octane SPA\n * A client-only [OctaneJS](https://octanejs.dev) app (no `octane.config.ts`\n * routes) is a plain Vite SPA — the `octane()` compiler plugin in the app's\n * own `vite.config.ts` composes with the injected Cloudflare plugin:\n * ```typescript\n * const app = yield* Cloudflare.Website.Vite(\"Octane\", {\ntheir Schemas, brands, errors and operations. HTTP/OpenAPI, RPC and remote MCP\ncall the same API application operation, which coordinates calculation,\nrequest limits and safe measurement. No transport duplicates tax policy,\nanalytics or calculation Schemas. Browser WebMCP calls the visible page\ncommands, then the same website client.\n\nThe Website server runner supplies a private same-stage service-binding\ntransport; browser Atom supplies the checked public API URL from the root\nloader. Both implement the same named checked client contract and keep the\nnative generated client private. The Website has no live rule engine, authored\nsource loader, RPC server or backend fallback. Calculator facts go only in\nbounded bodies; reports live only in the current calculation/page state.\nCredentials are omitted and unexpected redirects rejected for public browser\ncalls. Actual native request headers determine the tested CORS allowlist.\n\nVersion the RPC contract and qualify a checked compatibility boundary so\nindependently activated Website/API Workers fail safely during version skew.\nA single Alchemy plan does not make activation atomic. Keep public HTTP/OpenAPI\nversioning and package Changesets explicit; a fresh SDK interface is not\npermission to silently repurpose an already published wire contract. T001\nestablishes any existing public consumer/version before selecting its successor.\n\nPrivate client Layers distinguish expected calculation errors, unavailable\ntransport, incompatible contract and malformed replies. Keep one total budget\nthrough headers and decoded body; preserve earlier caller interruption and\nclose abandoned bodies. Root-owned RPC/client resources survive individual\nrequest cleanup and are released at their actual host/browser lifetime. Native\nAPI handlers run in the incoming Effect fibre with no extra ManagedRuntime.\n\nExact Effect 4.0.0 exports RPC at `effect/rpc`, while the RPC source still marks\nthe APIs unstable. Requalify the older skill's invalid-reply decoder workaround,\nnative error/defect encoders, JSON codec and Alchemy integration against this\nselected source; copy no RC-specific workaround without evidence. A safe outer\nHTTP reporter alone does not prove that native RPC replies omit raw Causes,\nSchema inputs or stack details. Native global/fatal defect paths, malformed\nenvelopes, unknown procedure tags and request IDs also need qualification;\nper-procedure defect encoding alone does not cover them. Test actual wire\nreplies, request/response payloads and native logs with sensitive sentinels,\nincluding malformed valid-JSON responses and an unrelated adapter defect.\nThe public serialisation `codecFor` hook is a candidate supported adapter,\nnot yet proof that every native path is safe: an unknown-procedure response\nuses an identity encoder and can reflect its supplied tag. Qualify a supported\nchecked ingress treatment or an exact reviewed native correction for uncovered\npaths. No complete redaction capability has been established. Do not replace\nthe native protocol\nwith handwritten framing or broadly convert every defect to an expected error.\n\nSources: [selected native RPC server](https://github.com/Effect-TS/effect/blob/effect%404.0.0/packages/effect/src/rpc/RpcServer.ts),\n[client](https://github.com/Effect-TS/effect/blob/effect%404.0.0/packages/effect/src/rpc/RpcClient.ts)\nand [serialisation](https://github.com/Effect-TS/effect/blob/effect%404.0.0/packages/effect/src/rpc/RpcSerialization.ts).\nimport { PublicCalculatorService } from \"@taxkit/calculators/service\";\nimport { Effect, Match } from \"effect\";\n\nimport {\n  CalculatorRpcRejected,\n  CalculatorRpcVersionMismatch,\n} from \"./errors.js\";\nimport { TaxKitRpcGroup } from \"./group.js\";\nimport { CalculatorRpcVersion } from \"./schemas.js\";\n\nexport const TaxKitRpcHandlersLive = TaxKitRpcGroup.toLayer(\n  Effect.gen(function* () {\n    const calculator = yield* PublicCalculatorService;\n    return TaxKitRpcGroup.of({\n      Calculate: ({ request, version }) =>\n        version === CalculatorRpcVersion\n          ? calculator.calculate(request).pipe(\n              Effect.mapError((error) =>\n                Match.value(error).pipe(\n                  Match.tag(\n                    \"CalculatorInputDecodeError\",\n                    () => new CalculatorRpcRejected({ reason: \"input\" })\n                  ),\n                  Match.tag(\n                    \"UnsupportedCalculatorContextError\",\n                    () => new CalculatorRpcRejected({ reason: \"context\" })\n                  ),\n                  Match.tag(\n                    \"UnsupportedCalculatorError\",\n                    () => new CalculatorRpcRejected({ reason: \"unsupported\" })\n                  ),\n                  Match.tag(\n                    \"CalculationError\",\n                    () => new CalculatorRpcRejected({ reason: \"calculation\" })\n                  ),\n                  Match.exhaustive\n                )\n              )\n            )\n          : Effect.fail(new CalculatorRpcVersionMismatch()),\n    });\n  })\n);\nimport type { CalculatorRunServiceRequest } from \"@taxkit/calculators/schemas\";\nimport { Effect, Layer, Match, Schema } from \"effect\";\nimport { FetchHttpClient } from \"effect/http\";\nimport { Rpc, RpcClient, RpcSerialization } from \"effect/rpc\";\n\nimport {\n  CalculatorRpcDeadlineExceeded,\n  CalculatorRpcInvalidResponse,\n  CalculatorRpcUnavailable,\n} from \"./errors.js\";\nimport { Calculate, TaxKitRpcGroup } from \"./group.js\";\nimport { CalculatorRpcDeadline, CalculatorRpcVersion } from \"./schemas.js\";\nimport type { CalculatorRpcOrigin } from \"./schemas.js\";\nimport { TaxKitRpcClient } from \"./service.js\";\n\nclass RpcReplyDecodeDefect extends Schema.TaggedError<RpcReplyDecodeDefect>()(\n  \"RpcReplyDecodeDefect\",\n  {}\n) {}\n\n// Effect 4 caches the native exit Schema. Mark only its reply decoder's failure;\n// an independent adapter SchemaError remains a defect with its original identity.\nconst replySerialization = Layer.succeed(\n  RpcSerialization.RpcSerialization,\n  RpcSerialization.RpcSerialization.of({\n    ...RpcSerialization.json,\n    codecFor: <S extends Schema.Top>(schema: S) => {\n      const codec = RpcSerialization.json.codecFor(schema);\n      return schema.ast === Rpc.exitSchema(Calculate).ast\n        ? codec.pipe(\n            Schema.catchDecoding<typeof codec>(() =>\n              Effect.die(new RpcReplyDecodeDefect())\n            )\n          )\n        : codec;\n    },\n  })\n);\n\n// The app supplies its matching-stage HttpClient. Native generated clients stay\n// private and their lifetime belongs to the caller's Layer scope.\nexport const TaxKitRpcClientLive = (origin: CalculatorRpcOrigin) =>\n  Layer.effect(\n    TaxKitRpcClient,\n    Effect.gen(function* () {\n      const client = yield* RpcClient.make(TaxKitRpcGroup, {\n        disableTracing: true,\n      });\n      return TaxKitRpcClient.of({\n        calculate: Effect.fn(\"TaxKitRpcClient.calculate\")(\n          (request: CalculatorRunServiceRequest) =>\n            client.Calculate({ request, version: CalculatorRpcVersion }).pipe(\n              Effect.provideService(FetchHttpClient.RequestInit, {\n                credentials: \"omit\",\n                redirect: \"error\",\n              }),\n              Effect.timeoutOrElse({\n                duration: CalculatorRpcDeadline,\n                orElse: () => Effect.fail(new CalculatorRpcDeadlineExceeded()),\n              }),\n              Effect.catchTag(\"RpcClientError\", (error) =>\n                Effect.fail(\n                  Match.value(error.reason).pipe(\n                    Match.tag(\n                      \"RpcClientDefect\",\n                      () => new CalculatorRpcInvalidResponse()\n                    ),\n                    Match.tag(\"HttpError\", (reason) =>\n                      Match.value(reason.kind).pipe(\n                        Match.whenOr(\n                          \"DecodeError\",\n                          \"EmptyBodyError\",\n                          () => new CalculatorRpcInvalidResponse()\n                        ),\n                        Match.orElse(() => new CalculatorRpcUnavailable())\n                      )\n                    ),\n                    Match.orElse(() => new CalculatorRpcUnavailable())\n                  )\n                )\n              ),\n              Effect.catchDefect((defect) =>\n                Schema.is(RpcReplyDecodeDefect)(defect)\n                  ? Effect.fail(new CalculatorRpcInvalidResponse())\n                  : Effect.die(defect)\n              )\n            )\n        ),\n      });\n    })\n  ).pipe(\n    Layer.provide(\n      RpcClient.layerProtocolHttp({ url: new URL(\"/rpc\", origin).href })\n    ),\n    Layer.provide(replySerialization)\n  );\n"},"started_at_ms":1791131943602,"completed_at_ms":1791131943602}}
{"timestamp":"2026-10-04T16:39:03.663Z","ordinal":15058,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a107c8-82ef-7341-8d59-b3e747ab9f17","call_id":"call_sly4qCAUJoc2qnT1W2bgzTZA","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"149a65\",\"wall_time_seconds\":0.000006459,\"exit_code\":0,\"original_token_count\":6214,\"output\":\"export const toHttpEffect = <A, E, R>(\\n  appLayer: Layer.Layer<A, E, R>\\n): Effect.Effect<\\n  Effect.Effect<\\n    HttpServerResponse.HttpServerResponse,\\n    Request.Only<\\\"Error\\\", R> | Request.Only<\\\"GlobalError\\\", R> | HttpServerError.HttpServerError,\\n    Scope.Scope | HttpServerRequest.HttpServerRequest | Request.Only<\\\"Requires\\\", R> | Request.Only<\\\"GlobalRequires\\\", R>\\n  >,\\n  Request.Without<E>,\\n  Exclude<Request.Without<R>, HttpRouter> | Scope.Scope\\n> =>\\n  Effect.contextWith((context) => {\\n    const scope = Context.get(context, Scope.Scope)\\n    const memoMap = Layer.CurrentMemoMap.forkOrCreate(context)\\n    return Effect.map(Layer.buildWithMemoMap(Layer.provideMerge(appLayer, layer), memoMap, scope), (context) => {\\n      const router = Context.get(context, HttpRouter)\\n      return router.asHttpEffect()\\n    })\\n  }) as any\\n\\nconst RouteTypeId = \\\"~effect/http/HttpRouter/Route\\\"\\n\\n/**\\n * Description of a registered HTTP route.\\n *\\n * **Details**\\n *\\n * A route pairs an HTTP method and path pattern with a response handler, plus\\n * metadata used for prefix handling and interruptibility.\\n *\\n * @stability unstable\\n * @category routes\\n * @since 4.0.0\\n */\\n * import { HttpRouter, HttpServerResponse } from \\\"effect/http\\\"\\n *\\n * const Route = HttpRouter.add(\\n *   \\\"GET\\\",\\n *   \\\"/hello\\\",\\n *   HttpServerResponse.text(\\\"Hello, World!\\\")\\n * ).pipe(\\n *   // disable the logger for this route\\n *   Layer.provide(HttpRouter.disableLogger)\\n * )\\n * Layer.isLayer(Route) // => true\\n * ```\\n *\\n * @stability unstable\\n * @category layers\\n * @since 4.0.0\\n */\\nexport const disableLogger: Layer.Layer<never> = middleware(HttpMiddleware.withLoggerDisabled).layer\\n\\n/**\\n * Provides request-level dependencies to some routes.\\n *\\n * @stability unstable\\n * @category layers\\n * @since 4.0.0\\n */\\nexport const provideRequest =\\n  <A2, E2, R2>(layer: Layer.Layer<A2, E2, R2>) =>\\n  <A, E, R>(self: Layer.Layer<A, E, R>): Layer.Layer<\\n    A,\\n    E | E2,\\n    R2 | Exclude<R, Request.From<\\\"Requires\\\", A2>>\\n  > =>\\n    Layer.provide(\\n      self,\\n      middleware<{ provides: A2 }>()(Effect.gen(function*() {\\n        const services = yield* Layer.build(layer as Layer.Layer<A2>)\\n        return (effect) =>\\n          Effect.provideContext(effect, services) as Effect.Effect<\\n            HttpServerResponse.HttpServerResponse,\\n            Types.unhandled\\n          >\\n      })).layer\\n    )\\n\\n/**\\n * Runs the provided application layer as an HTTP server.\\n *\\n * **Details**\\n *\\n * Layers first built inside the app are private to this server. Provide\\n * services that must be shared with sibling layers outside `serve`.\\n *\\n * **Gotchas**\\n *\\n * The layer is built with a forked `MemoMap`, so calling `serve` twice will\\n * build the same layer twice.\\n *\\n * @stability unstable\\n * @category layers\\n * @since 4.0.0\\n */\\nexport const serve = <A, E, R, HE, HR = Request.Only<\\\"Requires\\\", R> | Request.Only<\\\"GlobalRequires\\\", R>>(\\n  appLayer: Layer.Layer<A, E, R>,\\n  options?: {\\n    readonly routerConfig?: Partial<FindMyWay.RouterConfig> | undefined\\n    readonly disableLogger?: boolean | undefined\\n        | Scope.Scope\\n        | HttpServerRequest.HttpServerRequest\\n        | Request.Only<\\\"Requires\\\", R>\\n        | Request.Only<\\\"GlobalRequires\\\", R>\\n      >\\n    ) => Effect.Effect<HttpServerResponse.HttpServerResponse, HE, HR>\\n  }\\n): Layer.Layer<\\n  A,\\n  Request.Without<E>,\\n  HttpServer.HttpServer | Exclude<Request.Without<R> | Exclude<HR, GlobalProvided>, HttpRouter>\\n> => {\\n  let middleware: any = options?.middleware\\n  if (options?.disableLogger !== true) {\\n    middleware = middleware ? compose(middleware, HttpMiddleware.logger) : HttpMiddleware.logger\\n  }\\n  const layerWithRouter = Layer.provideMerge(\\n    appLayer,\\n    options?.routerConfig\\n      ? Layer.provide(layer, Layer.succeed(RouterConfig)(options.routerConfig))\\n      : layer\\n  )\\n  return Effect.contextWith((context) => {\\n    const memoMap = Layer.CurrentMemoMap.forkOrCreate(context)\\n    return Layer.buildWithMemoMap(layerWithRouter, memoMap, Context.get(context, Scope.Scope))\\n  }).pipe(\\n    Effect.map((context) => {\\n      const router = Context.get(context, HttpRouter)\\n      const handler = router.asHttpEffect()\\n      return Layer.merge(\\n        middleware ? HttpServer.serve(handler, middleware) : HttpServer.serve(handler),\\n        Layer.succeedContext(context)\\n      )\\n    }),\\n    Layer.unwrap,\\n    options?.disableListenLog ? identity : HttpServer.withLogAddress\\n  ) as any\\n}\\n\\n/**\\n * Builds a Fetch-compatible request handler from an HTTP router application\\n * layer.\\n *\\n * **Details**\\n *\\n * The result contains a `handler` function that converts Web `Request` values to\\n * Web `Response` values and a `dispose` function for releasing the layer\\n * resources. The layer is built immediately, so the cost is paid when the\\n * handler is created rather than on the first request. A layer that performs\\n * asynchronous work while building may still be in progress when the first\\n * request arrives, in which case that request waits for the build to finish.\\n * If the build fails, every request rejects with the build error.\\n *\\n * @stability unstable\\n * @category converting\\n * @since 4.0.0\\n */\\nexport const toWebHandler = <\\n  A,\\n  E,\\n  R extends\\n    | HttpRouter\\n    | Request<\\\"Requires\\\", any>\\n    | Request<\\\"GlobalRequires\\\", any>\\n    | Request<\\\"Error\\\", any>\\n    | Request<\\\"GlobalError\\\", any>,\\n  HE,\\n  HR = Exclude<Request.Only<\\\"Requires\\\", R> | Request.Only<\\\"GlobalRequires\\\", R>, A>,\\n  ReqR = Exclude<HR, A | Scope.Scope | HttpServerRequest.HttpServerRequest>\\n>(\\n  appLayer: Layer.Layer<A, E, R>,\\n *     traffic: 25,\\n *     affinity: { cookie: \\\"session_id\\\", ip: true },\\n *   },\\n * });\\n * ```\\n *\\n * ### The Worker's own URL\\n * `Worker.URL` injects the URL a Worker is served at as a binding on that\\n * same Worker — the first custom `domain` if one is configured, otherwise\\n * its `workers.dev` URL, always equal to the resource's `url` attribute.\\n * Under `alchemy dev` it resolves to the local dev server's URL.\\n *\\n * **Example:** Read the Worker's own URL inside a handler\\n * ```typescript\\n * Cloudflare.Worker(\\n *   \\\"Api\\\",\\n *   { main: import.meta.url },\\n *   Effect.gen(function* () {\\n *     // Attaches the binding and returns a deferred accessor.\\n *     const url = yield* Cloudflare.Worker.URL;\\n *\\n *     return {\\n *       fetch: Effect.gen(function* () {\\n *         const publicUrl = yield* url;\\n *         return yield* HttpServerResponse.json({ url: publicUrl });\\n *       }),\\n *     };\\n *   }),\\n * );\\n * ```\\n *\\n * **Example:** Inject the URL into an async Worker's env\\n * `InferEnv` types the entry as `string`. A `VITE_`-prefixed key on a\\n * vite-built Worker is additionally inlined into the client bundle as\\n * `import.meta.env.VITE_PUBLIC_URL` at build time.\\n * ```typescript\\n * export const Worker = Cloudflare.Worker(\\\"Worker\\\", {\\n *   main: \\\"./src/worker.ts\\\",\\n *   env: { PUBLIC_URL: Cloudflare.Worker.URL },\\n * });\\n *\\n * export type WorkerEnv = Cloudflare.InferEnv<typeof Worker>;\\n * //   { PUBLIC_URL: string }\\n * ```\\n *\\n * See the [Python Workers guide](/cloudflare/compute/python-workers)\\n * for the full walkthrough.\\n *\\n * **Example:** Defining a Python Worker in your stack\\n * ```typescript\\n * // alchemy.run.ts\\n * const kv = yield* Cloudflare.KV.Namespace(\\\"Cache\\\");\\n *\\n * export const Worker = Cloudflare.Worker(\\\"Worker\\\", {\\n *   main: \\\"./src/worker.py\\\",\\n *   env: { CACHE: kv },\\n * });\\n * ```\\n *\\n * **Example:** Writing the Python handler\\n * ```python\\n * # src/worker.py\\n * from workers import Response, WorkerEntrypoint\\n *\\n * class Default(WorkerEntrypoint):\\n *     async def fetch(self, request):\\n *         cached = await self.env.CACHE.get(\\\"greeting\\\")\\n *         return Response(cached or \\\"Hello from Python!\\\")\\n * ```\\n *\\n * **Example:** Vendoring dependencies with pyproject.toml\\n * ```toml\\n * # src/pyproject.toml — vendored with uv on deploy\\n * [project]\\n * name = \\\"my-worker\\\"\\n * version = \\\"0.1.0\\\"\\n * requires-python = \\\">=3.13\\\"\\n * dependencies = [\\\"humanize\\\"]\\n * ```\\n *\\n * ### Effect Workers\\n * Pass the Effect implementation as the third argument. This is the\\n * simplest Effect-based approach — everything lives in one file.\\n * Convenient for standalone Workers that don't need to be referenced\\n * by other Workers.\\n *\\n * **Example:** Worker Effect\\n * ```typescript\\n * export default class MyWorker extends Cloudflare.Worker<MyWorker>()(\\n *   \\\"MyWorker\\\",\\n *   { main: import.meta.url },\\n *   Effect.gen(function* () {\\n *     // Construction: bind resources\\n *     const kv = yield* Cloudflare.KV.ReadWriteNamespace(MyKV);\\n *\\n *     return {\\n *       // Runtime: use them\\n *       fetch: Effect.gen(function* () {\\n *         const value = yield* kv.get(\\\"key\\\");\\n *         return HttpServerResponse.text(value ?? \\\"not found\\\");\\n *       }),\\n *     };\\n *   }),\\n * ) {}\\n * ```\\n *\\n * ### Worker Layer\\n * When two Workers need to reference each other (e.g. WorkerA calls\\n * WorkerB and vice versa), or you simply want optimal tree-shaking,\\n * define the Worker class separately from its `.make()` call. The\\n * class is a lightweight identifier; `.make()` provides the runtime\\n * implementation as an `export default`. Rolldown treats `.make()`\\n * as pure, so any Worker that imports the class to bind it will not\\n * pull in the `.make()` dependencies — the bundler tree-shakes\\n * them away entirely.\\n *\\n * The class and `.make()` can live in the same file. This is the\\n * same pattern used by `Container` and `DurableObject`,\\n * and is recommended for any cross-Worker or cross-DO bindings.\\n *\\n * **Example:** Worker Layer (class + .make() in one file)\\n * ```typescript\\n * // src/WorkerB.ts — the tag carries the name + RPC shape; props live\\n * // on `.make()`.\\n * export class WorkerB extends Cloudflare.Worker<\\n *   WorkerB,\\n *   { greet: (name: string) => Effect.Effect<string> }\\n * >()(\\\"WorkerB\\\") {}\\n *\\n * export default WorkerB.make(\\n *   { main: import.meta.url },\\n *   Effect.gen(function* () {\\n *     // Construction: bind resources\\n *     const kv = yield* Cloudflare.KV.ReadWriteNamespace(MyKV);\\n *\\n *     return {\\n *       // Runtime: use them\\n *       greet: (name: string) =>\\n *         Effect.gen(function* () {\\n *           yield* kv.put(\\\"last-greeted\\\", name);\\n *           return `Hello ${name}`;\\n *         }),\\n *     };\\n *   }),\\n * );\\n * ```\\n *\\n * **Example:** Binding a Worker Layer from another Worker\\n * ```typescript\\n * // src/WorkerA.ts — imports WorkerB; bundler tree-shakes .make()\\n * import WorkerB from \\\"./WorkerB.ts\\\";\\n *\\n * export default class WorkerA extends Cloudflare.Worker<WorkerA>()(\\n *   \\\"WorkerA\\\",\\n *   { main: import.meta.url },\\n *   Effect.gen(function* () {\\n *     const b = yield* Cloudflare.Workers.bindWorker(WorkerB);\\n *     return {\\n *       fetch: Effect.gen(function* () {\\n *         return yield* b.greet(\\\"world\\\");\\n *       }),\\n *     };\\n *   }),\\n * ) {}\\n * ```\\n *\\n * ### Configuration\\n * The props object controls compatibility flags, static assets, and\\n * build options. These are evaluated at deploy time.\\n *\\n * **Example:** Enabling Node.js compatibility\\n * ```typescript\\n * {\\n *   main: import.meta.url,\\n *   compatibility: {\\n *     flags: [\\\"nodejs_compat\\\"],\\n *     date: \\\"2026-08-31\\\",\\n *   },\\n * }\\n * ```\\nimport * as Effect from \\\"effect/Effect\\\";\\nimport type { InputProps } from \\\"../../Input.ts\\\";\\nimport { effectClass } from \\\"../../Util/effect.ts\\\";\\nimport type { Providers } from \\\"../Providers.ts\\\";\\nimport type { AssetsConfig } from \\\"../Workers/Assets.ts\\\";\\nimport {\\n  Worker,\\n  type NormalizedBindings,\\n  type ViteOptions,\\n  type WorkerAssetsConfig,\\n  type WorkerBindingProps,\\n  type WorkerProps,\\n} from \\\"../Workers/Worker.ts\\\";\\n\\nexport interface ViteProps<Bindings extends WorkerBindingProps = {}>\\n  extends Omit<WorkerProps<Bindings>, \\\"vite\\\" | \\\"main\\\" | \\\"assets\\\">, ViteOptions {\\n  /**\\n   * Optional configuration for static asset routing behavior.\\n   * Supports `runWorkerFirst`, `htmlHandling`, `notFoundHandling`, etc.\\n   */\\n  assets?: AssetsConfig;\\n}\\n\\n/**\\n * A Cloudflare Worker deployed from a Vite project.\\n *\\n * `Vite` uses the Cloudflare Vite plugin to build both the server bundle\\n * and client assets in a single `vite build` invocation — no manual\\n * `main` entrypoint, build command, output directory, or Wrangler\\n * configuration required.\\n *\\n * Input files are content-hashed (respecting `.gitignore` by default) so\\n * unchanged projects skip the build and deploy entirely.\\n *\\n *\\n * ### Deploying a Static Site\\n * For a pure static site (no SSR), a single call is all you need.\\n * Vite builds the project and Alchemy deploys the output as a\\n * Cloudflare Worker with static assets.\\n *\\n * **Example:** Static Vite site\\n * ```typescript\\n * const site = yield* Cloudflare.Website.Vite(\\\"Website\\\");\\n * ```\\n *\\n * ### SSR Frameworks\\n * SSR frameworks like TanStack Start or SolidStart work with a single\\n * call — the `nodejs_compat` compatibility flag is enabled by default\\n * so the server bundle can use Node.js APIs.\\n *\\n * **Example:** TanStack Start\\n * ```typescript\\n * const app = yield* Cloudflare.Website.Vite(\\\"TanStackStart\\\");\\n * ```\\n *\\n * **Example:** SolidStart with worker-first routing\\n * ```typescript\\n * const app = yield* Cloudflare.Website.Vite(\\\"SolidStart\\\", {\\n *   assets: { runWorkerFirst: true },\\n * });\\n * ```\\n *\\n * **Example:** React Router\\n * React Router's server build (`virtual:react-router/server-build`) is a\\n * build manifest with no default export, so it cannot be deployed as the\\n * Worker entry directly. Point `main` at a module that wraps it with\\n * `createRequestHandler` (React Router's Cloudflare template ships this\\n * as `workers/app.ts`):\\n * ```typescript\\n * const app = yield* Cloudflare.Website.Vite(\\\"ReactRouter\\\", {\\n *   main: \\\"workers/app.ts\\\",\\n * });\\n * ```\\n *\\n * ### React Server Components\\n * Frameworks that emit more than one server environment (e.g. React\\n * Server Components, which split into an `rsc` environment and an `ssr`\\n * environment) need `viteEnvironments` to declare which environment\\n * produces the deployed Worker entry and which additional server\\n * environments to bundle alongside it. The `client` environment is\\n * always deployed as static assets.\\n *\\n * **Example:** React Router with RSC\\n * ```typescript\\n * const app = yield* Cloudflare.Website.Vite(\\\"ReactRouterRSC\\\", {\\n *   viteEnvironments: {\\n *     entry: \\\"rsc\\\",\\n *     children: [\\\"ssr\\\"],\\n *   },\\n * });\\n * ```\\n *\\n * ### Custom Worker Entry\\n * By default the deployed Worker entry is the server bundle the\\n * framework produces. When the Worker must export more than the\\n * framework's fetch handler — Durable Object classes, additional\\n * handlers — point `main` at your own module that wraps the framework\\n * handler and re-exports the extras. `main` takes precedence over any\\n * entry configured in the Vite config.\\n *\\n * **Example:** Custom entry hosting Durable Objects\\n * ```typescript\\n * const app = yield* Cloudflare.Website.Vite(\\\"App\\\", {\\n *   main: \\\"worker/index.ts\\\",\\n *   viteEnvironments: {\\n *     entry: \\\"rsc\\\",\\n *     children: [\\\"ssr\\\"],\\n *   },\\n * });\\n * ```\\n *\\n * ### Single-Page Applications\\n * For SPAs (React, Vue, etc.), configure asset handling so unmatched\\n * routes fall back to `index.html` and the client router takes over.\\n *\\n * **Example:** Vue SPA\\n * ```typescript\\n * const app = yield* Cloudflare.Website.Vite(\\\"Vue\\\", {\\n *   assets: {\\n *     notFoundHandling: \\\"single-page-application\\\",\\n *   },\\n * });\\n * ```\\n *\\n * **Example:** Foldkit\\n * [Foldkit](https://foldkit.dev) apps are client-only Vite projects, so a\\n * single call deploys them — the Foldkit Vite plugin in the app's own\\n * `vite.config.ts` composes with the injected Cloudflare plugin. Enable\\n * `single-page-application` not-found handling so deep links boot the app:\\n * ```typescript\\n * const app = yield* Cloudflare.Website.Vite(\\\"Foldkit\\\", {\\n *   assets: {\\n *     notFoundHandling: \\\"single-page-application\\\",\\n *   },\\n * });\\n * ```\\n * {@link Foldkit | Cloudflare.Website.Foldkit} is the same thing with that\\n * default already applied.\\n *\\n * **Example:** Octane SPA\\n * A client-only [OctaneJS](https://octanejs.dev) app (no `octane.config.ts`\\n * routes) is a plain Vite SPA — the `octane()` compiler plugin in the app's\\n * own `vite.config.ts` composes with the injected Cloudflare plugin:\\n * ```typescript\\n * const app = yield* Cloudflare.Website.Vite(\\\"Octane\\\", {\\ntheir Schemas, brands, errors and operations. HTTP/OpenAPI, RPC and remote MCP\\ncall the same API application operation, which coordinates calculation,\\nrequest limits and safe measurement. No transport duplicates tax policy,\\nanalytics or calculation Schemas. Browser WebMCP calls the visible page\\ncommands, then the same website client.\\n\\nThe Website server runner supplies a private same-stage service-binding\\ntransport; browser Atom supplies the checked public API URL from the root\\nloader. Both implement the same named checked client contract and keep the\\nnative generated client private. The Website has no live rule engine, authored\\nsource loader, RPC server or backend fallback. Calculator facts go only in\\nbounded bodies; reports live only in the current calculation/page state.\\nCredentials are omitted and unexpected redirects rejected for public browser\\ncalls. Actual native request headers determine the tested CORS allowlist.\\n\\nVersion the RPC contract and qualify a checked compatibility boundary so\\nindependently activated Website/API Workers fail safely during version skew.\\nA single Alchemy plan does not make activation atomic. Keep public HTTP/OpenAPI\\nversioning and package Changesets explicit; a fresh SDK interface is not\\npermission to silently repurpose an already published wire contract. T001\\nestablishes any existing public consumer/version before selecting its successor.\\n\\nPrivate client Layers distinguish expected calculation errors, unavailable\\ntransport, incompatible contract and malformed replies. Keep one total budget\\nthrough headers and decoded body; preserve earlier caller interruption and\\nclose abandoned bodies. Root-owned RPC/client resources survive individual\\nrequest cleanup and are released at their actual host/browser lifetime. Native\\nAPI handlers run in the incoming Effect fibre with no extra ManagedRuntime.\\n\\nExact Effect 4.0.0 exports RPC at `effect/rpc`, while the RPC source still marks\\nthe APIs unstable. Requalify the older skill's invalid-reply decoder workaround,\\nnative error/defect encoders, JSON codec and Alchemy integration against this\\nselected source; copy no RC-specific workaround without evidence. A safe outer\\nHTTP reporter alone does not prove that native RPC replies omit raw Causes,\\nSchema inputs or stack details. Native global/fatal defect paths, malformed\\nenvelopes, unknown procedure tags and request IDs also need qualification;\\nper-procedure defect encoding alone does not cover them. Test actual wire\\nreplies, request/response payloads and native logs with sensitive sentinels,\\nincluding malformed valid-JSON responses and an unrelated adapter defect.\\nThe public serialisation `codecFor` hook is a candidate supported adapter,\\nnot yet proof that every native path is safe: an unknown-procedure response\\nuses an identity encoder and can reflect its supplied tag. Qualify a supported\\nchecked ingress treatment or an exact reviewed native correction for uncovered\\npaths. No complete redaction capability has been established. Do not replace\\nthe native protocol\\nwith handwritten framing or broadly convert every defect to an expected error.\\n\\nSources: [selected native RPC server](https://github.com/Effect-TS/effect/blob/effect%404.0.0/packages/effect/src/rpc/RpcServer.ts),\\n[client](https://github.com/Effect-TS/effect/blob/effect%404.0.0/packages/effect/src/rpc/RpcClient.ts)\\nand [serialisation](https://github.com/Effect-TS/effect/blob/effect%404.0.0/packages/effect/src/rpc/RpcSerialization.ts).\\nimport { PublicCalculatorService } from \\\"@taxkit/calculators/service\\\";\\nimport { Effect, Match } from \\\"effect\\\";\\n\\nimport {\\n  CalculatorRpcRejected,\\n  CalculatorRpcVersionMismatch,\\n} from \\\"./errors.js\\\";\\nimport { TaxKitRpcGroup } from \\\"./group.js\\\";\\nimport { CalculatorRpcVersion } from \\\"./schemas.js\\\";\\n\\nexport const TaxKitRpcHandlersLive = TaxKitRpcGroup.toLayer(\\n  Effect.gen(function* () {\\n    const calculator = yield* PublicCalculatorService;\\n    return TaxKitRpcGroup.of({\\n      Calculate: ({ request, version }) =>\\n        version === CalculatorRpcVersion\\n          ? calculator.calculate(request).pipe(\\n              Effect.mapError((error) =>\\n                Match.value(error).pipe(\\n                  Match.tag(\\n                    \\\"CalculatorInputDecodeError\\\",\\n                    () => new CalculatorRpcRejected({ reason: \\\"input\\\" })\\n                  ),\\n                  Match.tag(\\n                    \\\"UnsupportedCalculatorContextError\\\",\\n                    () => new CalculatorRpcRejected({ reason: \\\"context\\\" })\\n                  ),\\n                  Match.tag(\\n                    \\\"UnsupportedCalculatorError\\\",\\n                    () => new CalculatorRpcRejected({ reason: \\\"unsupported\\\" })\\n                  ),\\n                  Match.tag(\\n                    \\\"CalculationError\\\",\\n                    () => new CalculatorRpcRejected({ reason: \\\"calculation\\\" })\\n                  ),\\n                  Match.exhaustive\\n                )\\n              )\\n            )\\n          : Effect.fail(new CalculatorRpcVersionMismatch()),\\n    });\\n  })\\n);\\nimport type { CalculatorRunServiceRequest } from \\\"@taxkit/calculators/schemas\\\";\\nimport { Effect, Layer, Match, Schema } from \\\"effect\\\";\\nimport { FetchHttpClient } from \\\"effect/http\\\";\\nimport { Rpc, RpcClient, RpcSerialization } from \\\"effect/rpc\\\";\\n\\nimport {\\n  CalculatorRpcDeadlineExceeded,\\n  CalculatorRpcInvalidResponse,\\n  CalculatorRpcUnavailable,\\n} from \\\"./errors.js\\\";\\nimport { Calculate, TaxKitRpcGroup } from \\\"./group.js\\\";\\nimport { CalculatorRpcDeadline, CalculatorRpcVersion } from \\\"./schemas.js\\\";\\nimport type { CalculatorRpcOrigin } from \\\"./schemas.js\\\";\\nimport { TaxKitRpcClient } from \\\"./service.js\\\";\\n\\nclass RpcReplyDecodeDefect extends Schema.TaggedError<RpcReplyDecodeDefect>()(\\n  \\\"RpcReplyDecodeDefect\\\",\\n  {}\\n) {}\\n\\n// Effect 4 caches the native exit Schema. Mark only its reply decoder's failure;\\n// an independent adapter SchemaError remains a defect with its original identity.\\nconst replySerialization = Layer.succeed(\\n  RpcSerialization.RpcSerialization,\\n  RpcSerialization.RpcSerialization.of({\\n    ...RpcSerialization.json,\\n    codecFor: <S extends Schema.Top>(schema: S) => {\\n      const codec = RpcSerialization.json.codecFor(schema);\\n      return schema.ast === Rpc.exitSchema(Calculate).ast\\n        ? codec.pipe(\\n            Schema.catchDecoding<typeof codec>(() =>\\n              Effect.die(new RpcReplyDecodeDefect())\\n            )\\n          )\\n        : codec;\\n    },\\n  })\\n);\\n\\n// The app supplies its matching-stage HttpClient. Native generated clients stay\\n// private and their lifetime belongs to the caller's Layer scope.\\nexport const TaxKitRpcClientLive = (origin: CalculatorRpcOrigin) =>\\n  Layer.effect(\\n    TaxKitRpcClient,\\n    Effect.gen(function* () {\\n      const client = yield* RpcClient.make(TaxKitRpcGroup, {\\n        disableTracing: true,\\n      });\\n      return TaxKitRpcClient.of({\\n        calculate: Effect.fn(\\\"TaxKitRpcClient.calculate\\\")(\\n          (request: CalculatorRunServiceRequest) =>\\n            client.Calculate({ request, version: CalculatorRpcVersion }).pipe(\\n              Effect.provideService(FetchHttpClient.RequestInit, {\\n                credentials: \\\"omit\\\",\\n                redirect: \\\"error\\\",\\n              }),\\n              Effect.timeoutOrElse({\\n                duration: CalculatorRpcDeadline,\\n                orElse: () => Effect.fail(new CalculatorRpcDeadlineExceeded()),\\n              }),\\n              Effect.catchTag(\\\"RpcClientError\\\", (error) =>\\n                Effect.fail(\\n                  Match.value(error.reason).pipe(\\n                    Match.tag(\\n                      \\\"RpcClientDefect\\\",\\n                      () => new CalculatorRpcInvalidResponse()\\n                    ),\\n                    Match.tag(\\\"HttpError\\\", (reason) =>\\n                      Match.value(reason.kind).pipe(\\n                        Match.whenOr(\\n                          \\\"DecodeError\\\",\\n                          \\\"EmptyBodyError\\\",\\n                          () => new CalculatorRpcInvalidResponse()\\n                        ),\\n                        Match.orElse(() => new CalculatorRpcUnavailable())\\n                      )\\n                    ),\\n                    Match.orElse(() => new CalculatorRpcUnavailable())\\n                  )\\n                )\\n              ),\\n              Effect.catchDefect((defect) =>\\n                Schema.is(RpcReplyDecodeDefect)(defect)\\n                  ? Effect.fail(new CalculatorRpcInvalidResponse())\\n                  : Effect.die(defect)\\n              )\\n            )\\n        ),\\n      });\\n    })\\n  ).pipe(\\n    Layer.provide(\\n      RpcClient.layerProtocolHttp({ url: new URL(\\\"/rpc\\\", origin).href })\\n    ),\\n    Layer.provide(replySerialization)\\n  );\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","create_time":1791131943.663933}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
