ng\": {\n        \"types\": \"./dist/testing/index.d.ts\",\n        \"default\": \"./dist/testing/index.js\"\n      }\n    },\n    \"access\": \"public\"\n  },\n  \"scripts\": {\n    \"build\": \"rm -rf dist && tsc -p tsconfig.build.json\",\n    \"check-boundaries\": \"bun run scripts/check-import-boundaries.runtime.ts\",\n    \"check-packed-artifact\": \"bun run scripts/check-packed-artifact.runtime.ts\",\n    \"validate:downstream\": \"bun run scripts/validate-downstream-consumer.runtime.ts\",\n    \"check-types\": \"tsc --noEmit && tsc -p scripts/tsconfig.json --noEmit\",\n    \"test\": \"vitest run\",\n    \"test-types\": \"tsc -p tsconfig.type-tests.json --noEmit\",\n    \"clean\": \"rm -rf dist .turbo *.tsbuildinfo\",\n    \"test:browser\": \"vitest run --config vitest.browser.config.ts\"\n  },\n  \"dependencies\": {\n    \"@taxkit/calculators\": \"workspace:*\",\n    \"@taxkit/core\": \"workspace:*\",\n    \"@taxkit/rules-au-income-tax\": \"workspace:*\",\n    \"@taxkit/rules-au-pay\": \"workspace:*\",\n    \"effect\": \"catalog:\"\n  },\n  \"devDependencies\": {\n    \"@effect/platform-bun\": \"catalog:\",\n    \"@effect/vitest\": \"catalog:\",\n    \"@taxkit/testing\": \"workspace:*\",\n    \"@types/bun\": \"catalog:\",\n    \"@vitest/browser-playwright\": \"5.0.3\",\n    \"typescript\": \"catalog:\",\n    \"vite\": \"catalog:\",\n    \"vitest\": \"catalog:\"\n  }\n}\nimport { Context, Effect, Layer, Schema } from \"effect\";\n\nimport { GraphValidationIssue } from \"../graph/rule-graph.js\";\n\n/**\n * Input accepted by the core calculation engine.\n *\n * The engine is deliberately generic: rule packs and scenario layers are\n * selected by the caller, while the core service handles Effect-native\n * provisioning and returns the calculation result.\n *\n * @since 0.1.0\n */\nexport interface CalculationRequest<A, E, R> {\n  readonly calculation: Effect.Effect<A, E, R>;\n  readonly layer: Layer.Layer<R, E>;\n  readonly validationIssues?: readonly GraphValidationIssue[];\n}\n\n/**\n * Diagnostics returned by the calculation engine.\n *\n * @since 0.1.0\n */\nexport class CalculationDiagnostics extends Schema.TaggedClass<CalculationDiagnostics>()(\n  \"CalculationDiagnostics\",\n  {\n    graphIssues: Schema.Array(GraphValidationIssue),\n  }\n) {}\n\n/**\n * Result envelope returned by the calculation engine.\n *\n * @since 0.1.0\n */\nexport interface CalculationResult<A> {\n  readonly diagnostics: CalculationDiagnostics;\n  readonly report: A;\n}\n\n/**\n * Effect-native service for running typed core calculations.\n *\n * @since 0.1.0\n */\nexport interface CalculationEngineService {\n  readonly run: <A, E, R>(\n    request: CalculationRequest<A, E, R>\n  ) => Effect.Effect<CalculationResult<A>, E>;\n}\n\n/**\n * Context tag for the core calculation engine service.\n *\n * @since 0.1.0\n */\nexport class CalculationEngine extends Context.Service<\n  CalculationEngine,\n  CalculationEngineService\n>()(\"taxkit/core/CalculationEngine\") {}\n\n/**\n * Live core calculation engine implementation.\n *\n * @since 0.1.0\n */\nexport const CalculationEngineLive = Layer.succeed(CalculationEngine)({\n  run: (request) =>\n    request.calculation.pipe(\n      Effect.provide(request.layer),\n      Effect.map((report) => ({\n        diagnostics: new CalculationDiagnostics({\n          graphIssues: [...(request.validationIssues ?? [])],\n        }),\n        report,\n      }))\n    ),\n});\nimport { tanstackStart } from \"@tanstack/react-start/plugin/vite\";\nimport viteReact from \"@vitejs/plugin-react\";\nimport { ConfigProvider, Effect, Schema } from \"effect\";\nimport { nitro } from \"nitro/vite\";\nimport { defineConfig, loadEnv } from \"vite\";\n\nimport {\n  TaxKitWebClientInput,\n  TaxKitWebClientInputConfig,\n} from \"./src/lib/config.client-input.ts\";\n\nexport default defineConfig(({ command, mode }) => {\n  const useSourceWorkspacePackages = command !== \"build\";\n  const clientInput = Effect.runSync(\n    TaxKitWebClientInputConfig.pipe(\n      Effect.provideService(\n        ConfigProvider.ConfigProvider,\n        ConfigProvider.fromEnv({\n          env: loadEnv(mode, import.meta.dirname, \"VITE_\"),\n        })\n      ),\n      Effect.flatMap(\n        Schema.encodeEffect(Schema.fromJsonString(TaxKitWebClientInput))\n      )\n    )\n  );\n\n  return {\n    define: { __TAXKIT_WEB_CLIENT_INPUT__: clientInput },\n    // Only the explicit typed public input is exposed; Vite still owns its standard metadata.\n    envPrefix: [],\n    plugins: [\n      tanstackStart(),\n      viteReact(),\n      nitro({\n        preset: \"vercel\",\n        vercel: {\n          functions: {\n            runtime: \"nodejs22.x\",\n          },\n        },\n      }),\n    ],\n    resolve: useSourceWorkspacePackages\n      ? { conditions: [\"source\"], tsconfigPaths: true }\n      : { tsconfigPaths: true },\n    ssr: useSourceWorkspacePackages\n      ? { resolve: { conditions: [\"source\", \"node\"] } }\n      : {},\n  };\n});\n{\n  \"document_type\": \"qualification-receipt\",\n  \"date\": \"2026-10-04\",\n  \"issue\": \"DEV-73\",\n  \"parent_revision\": \"b726afb556fcafdb929b41417a8b0cf4a4aec92c\",\n  \"versions\": {\n    \"@effect/atom-react\": \"4.0.0\",\n    \"react\": \"19.3.0\",\n    \"react-dom\": \"19.3.0\",\n    \"scheduler\": \"0.28.0\",\n    \"vitest\": \"5.0.3\",\n    \"playwright\": \"1.63.0\"\n  },\n  \"patch\": {\n    \"path\": \"patches/@effect%2Fatom-react@4.0.0.patch\",\n    \"scope\": \"Exact Scheduler 0.28.0 peer admission only; no runtime edits\",\n    \"warning\": \"Bun reports original registry peer range before applying patch; retained and documented\"\n  },\n  \"evidence\": [\n    {\n      \"command\": \"bun install --frozen-lockfile\",\n      \"outcome\": \"passed\"\n    },\n    {\n      \"command\": \"bun run verification\",\n      \"outcome\": \"passed, including web:test:browser and its two real Chromium tests\"\n    },\n    {\n      \"command\": \"bun run --filter=web check-types\",\n      \"outcome\": \"passed; diagnostic warnings remain visible\"\n    }\n  ],\n  \"proof\": [\n    \"default scheduling and cancellation\",\n    \"SSR hydration without recoverable or uncaught errors\",\n    \"StrictMode registry identity\",\n    \"50 rapid updates without loss\",\n    \"Effect-scoped root/host teardown and final disposal\"\n  ],\n  \"limitations\": [\n    \"Does not implement app Atom state or RPC interruption; T003 owns these\",\n    \"Does not complete strict-policy enforcement\",\n    \"No tax results or parameters changed\",\n    \"Not merged or deployed\"\n  ],\n  \"recovery\": \"Revert this slice and reinstall the parent frozen dependency graph\"\n}\n"},"started_at_ms":1791128660169,"completed_at_ms":1791128660169}}
