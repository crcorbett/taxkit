pe\n *\n * @category branding\n * @since 3.10.0\n */\nexport function brand<B extends string>(identifier: B & EnsureSingleBrandKey<B>) {\n  return <S extends ConstraintRebuildable>(schema: S): brand<S[\"Rebuild\"], B> =>\n    make(schema.ast, { schema, identifier })\n}\n/**\n * Creates a branded schema from a {@link Brand.Constructor}, applying the\n * constructor's checks and branded type to the underlying schema.\n *\n * **When to use**\n *\n * Use to reuse the checks from a constructor with one concrete brand key.\n *\n * **Gotchas**\n *\n * `identifier` must match the constructor's only brand key. Apply `fromBrand`\n * repeatedly to compose distinct brands, and use {@link Union} to represent\n * alternatives.\n *\n * @see {@link brand} for adding a brand without constructor checks\n *\n * @category branding\n * @since 3.10.0\n */\nexport function fromBrand<A extends Brand.Brand<any>>(\n  identifier: Brand.Brand.Keys<A> & string,\n  ctor: Brand.Constructor<A> & EnsureSingleBrandKey<FromBrandKeys<A>>\n) {\n  type B = Brand.Brand.Keys<A> & string\n  return <S extends Top & { readonly \"Type\": Brand.Brand.Unbranded<A> }>(\n    self: S\n  ): brand<S[\"Rebuild\"], B> =>\n    // The constructor already guarantees a single concrete brand key.\n    (ctor.checks ? self.check(...ctor.checks) : self).pipe(brand<B>(identifier as B & EnsureSingleBrandKey<B>))\n}\n/**\n * Type-level representation returned by {@link middlewareDecoding}.\n *\n * @category decoding\n * @since 4.0.0\n */\nexport interface middlewareDecoding<S extends Constraint, RD> extends\n  BottomLazy<\n    S[\"ast\"],\n    middlewareDecoding<S, RD>,\n    S[\"~type.parameters\"],\n    S[\"~type.mutability\"],\n    S[\"~type.optionality\"],\n    S[\"~type.constructor.default\"],\n    S[\"~encoded.mutability\"],\n    S[\"~encoded.optionality\"]\n  >\n{\n  readonly \"Type\": S[\"Type\"]\n  readonly \"Encoded\": S[\"Encoded\"]\n  readonly \"DecodingServices\": RD\n  readonly \"EncodingServices\": S[\"EncodingServices\"]\n  readonly \"~type.make.in\": S[\"~type.make.in\"]\n  readonly \"~type.make\": S[\"~type.make\"]\n  readonly \"Iso\": S[\"Iso\"]\n  readonly schema: S\n}\n/**\n * Intercepts the decoding pipeline of a schema.\n *\n * **Details**\n *\n * The provided function receives the current decoding `Effect` and `ParseOptions`,\n * and returns a new `Effect` — potentially adding service requirements (`RD`),\n * recovering from errors, or augmenting the result.\n *\n * **Example** (Logging decode failures)\n *\n * ```ts import.meta.vitest\n * import { Effect, Schema } from \"effect\"\n *\n * const events: Array<string> = []\n * const Logged = Schema.String.pipe(\n *   Schema.middlewareDecoding((effect) =>\n *     Effect.tapError(effect, () => Effect.sync(() => events.push(\"decode failed\")))\n *   )\n * )\n * Effect.runSync(Effect.result(Schema.decodeUnknownEffect(Logged)(42)))\n * events // => [\"decode failed\"]\n * ```\n *\n * @see {@link catchDecoding} for a simpler error-recovery variant\n * @category decoding\n * @since 4.0.0\n */\nexport function middlewareDecoding<S extends Constraint, RD>(\n  decode: (\n    effect: Effect.Effect<Option_.Option<S[\"Type\"]>, SchemaIssue.Issue, S[\"DecodingServices\"]>,\n    options: SchemaAST.ParseOptions\nimport { Effect, Layer } from \"effect\";\nimport type { CalculatorsId } from \"@taxkit/calculators/schemas\";\nimport * as EffectRpcTest from \"effect/unstable/rpc/RpcTest\";\n\nimport { ApiRpcGroup } from \"./group.js\";\nimport { ApiRpcHandlersLive } from \"./handlers.js\";\nimport { ApiRpcClient } from \"./service.js\";\n\nexport const ApiRpcClientTest = Layer.effect(\n  ApiRpcClient,\n  EffectRpcTest.makeClient(ApiRpcGroup).pipe(\n    Effect.map((client) =>\n      ApiRpcClient.of({\n        get: Effect.fn(\"ApiRpcClient.get\")((id: CalculatorsId) => client.GetCalculators({ id })),\n        list: Effect.fn(\"ApiRpcClient.list\")(() => client.ListCalculators()),\n      }),\n    ),\n  ),\n).pipe(Layer.provide(ApiRpcHandlersLive));\n","exit_code":0,"duration":{"secs":0,"nanos":7375},"formatted_output":"5153: * Type-level representation returned by {@link middlewareDecoding}.\n5158:export interface middlewareDecoding<S extends Constraint, RD> extends\n5161:    middlewareDecoding<S, RD>,\n5195: *   Schema.middlewareDecoding((effect) =>\n5207:export function middlewareDecoding<S extends Constraint, RD>(\n5213:  return (schema: S): middlewareDecoding<S, RD> =>\n5215:      SchemaAST.middlewareDecoding(schema.ast, new SchemaTransformation.Middleware(decode, identity)),\n5220: * Type-level representation returned by {@link middlewareEncoding}.\n5225:export interface middlewareEncoding<S extends Constraint, RE> extends\n5228:    middlewareEncoding<S, RE>,\n5262: *   Schema.middlewareEncoding((effect) =>\n5274:export function middlewareEncoding<S extends Constraint, RE>(\n5280:  return (schema: S): middlewareEncoding<S, RE> =>\n5282:      SchemaAST.middlewareEncoding(schema.ast, new SchemaTransformation.Middleware(identity, encode)),\n5311:): (self: S) => middlewareDecoding<S, S[\"DecodingServices\"]> {\n5329: * @see {@link middlewareDecoding} for intercepting or replacing the full decoding pipeline\n5337:  return (self: S): middlewareDecoding<S, S[\"DecodingServices\"] | R> =>\n5338:    middlewareDecoding<S, S[\"DecodingServices\"] | R>(Effect.catchEager(f))(self)\n5354:): (self: S) => middlewareEncoding<S, S[\"EncodingServices\"]> {\n5372: * @see {@link middlewareEncoding} for intercepting or replacing the full encoding pipeline\n  readonly \"Iso\": S[\"Type\"] & Brand.Brand<B>\n  readonly schema: S\n  readonly identifier: string\n}\n/**\n * Intersects a schema's output type with `Brand.Brand<B>` to prevent accidental\n * mixing of structurally identical types.\n *\n * **When to use**\n *\n * Use to make values decoded by an existing schema nominally distinct when the\n * schema already carries the runtime validation you need.\n *\n * **Gotchas**\n *\n * - `identifier` must be a single concrete string literal. Widened strings,\n *   unions, and open template literal types are rejected.\n * - `brand` only narrows the TypeScript output type. It does not change the\n *   schema's runtime AST or add runtime checks.\n * - Schema representations and generated schema code omit the brand. Reapply\n *   `brand` after rebuilding or generating a schema when the nominal type is\n *   still required.\n *\n * @see {@link fromBrand} for applying a Brand constructor's checks along with its branded type\n *\n * @category branding\n * @since 3.10.0\n */\nexport function brand<B extends string>(identifier: B & EnsureSingleBrandKey<B>) {\n  return <S extends ConstraintRebuildable>(schema: S): brand<S[\"Rebuild\"], B> =>\n    make(schema.ast, { schema, identifier })\n}\n/**\n * Creates a branded schema from a {@link Brand.Constructor}, applying the\n * constructor's checks and branded type to the underlying schema.\n *\n * **When to use**\n *\n * Use to reuse the checks from a constructor with one concrete brand key.\n *\n * **Gotchas**\n *\n * `identifier` must match the constructor's only brand key. Apply `fromBrand`\n * repeatedly to compose distinct brands, and use {@link Union} to represent\n * alternatives.\n *\n * @see {@link brand} for adding a brand without constructor checks\n *\n * @category branding\n * @since 3.10.0\n */\nexport function fromBrand<A extends Brand.Brand<any>>(\n  identifier: Brand.Brand.Keys<A> & string,\n  ctor: Brand.Constructor<A> & EnsureSingleBrandKey<FromBrandKeys<A>>\n) {\n  type B = Brand.Brand.Keys<A> & string\n  return <S extends Top & { readonly \"Type\": Brand.Brand.Unbranded<A> }>(\n    self: S\n  ): brand<S[\"Rebuild\"], B> =>\n    // The constructor already guarantees a single concrete brand key.\n    (ctor.checks ? self.check(...ctor.checks) : self).pipe(brand<B>(identifier as B & EnsureSingleBrandKey<B>))\n}\n/**\n * Type-level representation returned by {@link middlewareDecoding}.\n *\n * @category decoding\n * @since 4.0.0\n */\nexport interface middlewareDecoding<S extends Constraint, RD> extends\n  BottomLazy<\n    S[\"ast\"],\n    middlewareDecoding<S, RD>,\n    S[\"~type.parameters\"],\n    S[\"~type.mutability\"],\n    S[\"~type.optionality\"],\n    S[\"~type.constructor.default\"],\n    S[\"~encoded.mutability\"],\n    S[\"~encoded.optionality\"]\n  >\n{\n  readonly \"Type\": S[\"Type\"]\n  readonly \"Encoded\": S[\"Encoded\"]\n  readonly \"DecodingServices\": RD\n  readonly \"EncodingServices\": S[\"EncodingServices\"]\n  readonly \"~type.make.in\": S[\"~type.make.in\"]\n  readonly \"~type.make\": S[\"~type.make\"]\n  readonly \"Iso\": S[\"Iso\"]\n  readonly schema: S\n}\n/**\n * Intercepts the decoding pipeline of a schema.\n *\n * **Details**\n *\n * The provided function receives the current decoding `Effect` and `ParseOptions`,\n * and returns a new `Effect` — potentially adding service requirements (`RD`),\n * recovering from errors, or augmenting the result.\n *\n * **Example** (Logging decode failures)\n *\n * ```ts import.meta.vitest\n * import { Effect, Schema } from \"effect\"\n *\n * const events: Array<string> = []\n * const Logged = Schema.String.pipe(\n *   Schema.middlewareDecoding((effect) =>\n *     Effect.tapError(effect, () => Effect.sync(() => events.push(\"decode failed\")))\n *   )\n * )\n * Effect.runSync(Effect.result(Schema.decodeUnknownEffect(Logged)(42)))\n * events // => [\"decode failed\"]\n * ```\n *\n * @see {@link catchDecoding} for a simpler error-recovery variant\n * @category decoding\n * @since 4.0.0\n */\nexport function middlewareDecoding<S extends Constraint, RD>(\n  decode: (\n    effect: Effect.Effect<Option_.Option<S[\"Type\"]>, SchemaIssue.Issue, S[\"DecodingServices\"]>,\n    options: SchemaAST.ParseOptions\nimport { Effect, Layer } from \"effect\";\nimport type { CalculatorsId } from \"@taxkit/calculators/schemas\";\nimport * as EffectRpcTest from \"effect/unstable/rpc/RpcTest\";\n\nimport { ApiRpcGroup } from \"./group.js\";\nimport { ApiRpcHandlersLive } from \"./handlers.js\";\nimport { ApiRpcClient } from \"./service.js\";\n\nexport const ApiRpcClientTest = Layer.effect(\n  ApiRpcClient,\n  EffectRpcTest.makeClient(ApiRpcGroup).pipe(\n    Effect.map((client) =>\n      ApiRpcClient.of({\n        get: Effect.fn(\"ApiRpcClient.get\")((id: CalculatorsId) => client.GetCalculators({ id })),\n        list: Effect.fn(\"ApiRpcClient.list\")(() => client.ListCalculators()),\n      }),\n    ),\n  ),\n).pipe(Layer.provide(ApiRpcHandlersLive));\n"},"started_at_ms":1791130408724,"completed_at_ms":1791130408724}}
{"timestamp":"2026-10-04T16:13:28.773Z","ordinal":14536,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a107b1-1745-7de0-ba10-9d140e9452d7","call_id":"call_KU7lKTRuWAhQLucFsg9105c1","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"c82c5a\",\"wall_time_seconds\":0.000007375,\"exit_code\":0,\"original_token_count\":1548,\"output\":\"5153: * Type-level representation returned by {@link middlewareDecoding}.\\n5158:export interface middlewareDecoding<S extends Constraint, RD> extends\\n5161:    middlewareDecoding<S, RD>,\\n5195: *   Schema.middlewareDecoding((effect) =>\\n5207:export function middlewareDecoding<S extends Constraint, RD>(\\n5213:  return (schema: S): middlewareDecoding<S, RD> =>\\n5215:      SchemaAST.middlewareDecoding(schema.ast, new SchemaTransformation.Middleware(decode, identity)),\\n5220: * Type-level representation returned by {@link middlewareEncoding}.\\n5225:export interface middlewareEncoding<S extends Constraint, RE> extends\\n5228:    middlewareEncoding<S, RE>,\\n5262: *   Schema.middlewareEncoding((effect) =>\\n5274:export function middlewareEncoding<S extends Constraint, RE>(\\n5280:  return (schema: S): middlewareEncoding<S, RE> =>\\n5282:      SchemaAST.middlewareEncoding(schema.ast, new SchemaTransformation.Middleware(identity, encode)),\\n5311:): (self: S) => middlewareDecoding<S, S[\\\"DecodingServices\\\"]> {\\n5329: * @see {@link middlewareDecoding} for intercepting or replacing the full decoding pipeline\\n5337:  return (self: S): middlewareDecoding<S, S[\\\"DecodingServices\\\"] | R> =>\\n5338:    middlewareDecoding<S, S[\\\"DecodingServices\\\"] | R>(Effect.catchEager(f))(self)\\n5354:): (self: S) => middlewareEncoding<S, S[\\\"EncodingServices\\\"]> {\\n5372: * @see {@link middlewareEncoding} for intercepting or replacing the full encoding pipeline\\n  readonly \\\"Iso\\\": S[\\\"Type\\\"] & Brand.Brand<B>\\n  readonly schema: S\\n  readonly identifier: string\\n}\\n/**\\n * Intersects a schema's output type with `Brand.Brand<B>` to prevent accidental\\n * mixing of structurally identical types.\\n *\\n * **When to use**\\n *\\n * Use to make values decoded by an existing schema nominally distinct when the\\n * schema already carries the runtime validation you need.\\n *\\n * **Gotchas**\\n *\\n * - `identifier` must be a single concrete string literal. Widened strings,\\n *   unions, and open template literal types are rejected.\\n * - `brand` only narrows the TypeScript output type. It does not change the\\n *   schema's runtime AST or add runtime checks.\\n * - Schema representations and generated schema code omit the brand. Reapply\\n *   `brand` after rebuilding or generating a schema when the nominal type is\\n *   still required.\\n *\\n * @see {@link fromBrand} for applying a Brand constructor's checks along with its branded type\\n *\\n * @category branding\\n * @since 3.10.0\\n */\\nexport function brand<B extends string>(identifier: B & EnsureSingleBrandKey<B>) {\\n  return <S extends ConstraintRebuildable>(schema: S): brand<S[\\\"Rebuild\\\"], B> =>\\n    make(schema.ast, { schema, identifier })\\n}\\n/**\\n * Creates a branded schema from a {@link Brand.Constructor}, applying the\\n * constructor's checks and branded type to the underlying schema.\\n *\\n * **When to use**\\n *\\n * Use to reuse the checks from a constructor with one concrete brand key.\\n *\\n * **Gotchas**\\n *\\n * `identifier` must match the constructor's only brand key. Apply `fromBrand`\\n * repeatedly to compose distinct brands, and use {@link Union} to represent\\n * alternatives.\\n *\\n * @see {@link brand} for adding a brand without constructor checks\\n *\\n * @category branding\\n * @since 3.10.0\\n */\\nexport function fromBrand<A extends Brand.Brand<any>>(\\n  identifier: Brand.Brand.Keys<A> & string,\\n  ctor: Brand.Constructor<A> & EnsureSingleBrandKey<FromBrandKeys<A>>\\n) {\\n  type B = Brand.Brand.Keys<A> & string\\n  return <S extends Top & { readonly \\\"Type\\\": Brand.Brand.Unbranded<A> }>(\\n    self: S\\n  ): brand<S[\\\"Rebuild\\\"], B> =>\\n    // The constructor already guarantees a single concrete brand key.\\n    (ctor.checks ? self.check(...ctor.checks) : self).pipe(brand<B>(identifier as B & EnsureSingleBrandKey<B>))\\n}\\n/**\\n * Type-level representation returned by {@link middlewareDecoding}.\\n *\\n * @category decoding\\n * @since 4.0.0\\n */\\nexport interface middlewareDecoding<S extends Constraint, RD> extends\\n  BottomLazy<\\n    S[\\\"ast\\\"],\\n    middlewareDecoding<S, RD>,\\n    S[\\\"~type.parameters\\\"],\\n    S[\\\"~type.mutability\\\"],\\n    S[\\\"~type.optionality\\\"],\\n    S[\\\"~type.constructor.default\\\"],\\n    S[\\\"~encoded.mutability\\\"],\\n    S[\\\"~encoded.optionality\\\"]\\n  >\\n{\\n  readonly \\\"Type\\\": S[\\\"Type\\\"]\\n  readonly \\\"Encoded\\\": S[\\\"Encoded\\\"]\\n  readonly \\\"DecodingServices\\\": RD\\n  readonly \\\"EncodingServices\\\": S[\\\"EncodingServices\\\"]\\n  readonly \\\"~type.make.in\\\": S[\\\"~type.make.in\\\"]\\n  readonly \\\"~type.make\\\": S[\\\"~type.make\\\"]\\n  readonly \\\"Iso\\\": S[\\\"Iso\\\"]\\n  readonly schema: S\\n}\\n/**\\n * Intercepts the decoding pipeline of a schema.\\n *\\n * **Details**\\n *\\n * The provided function receives the current decoding `Effect` and `ParseOptions`,\\n * and returns a new `Effect` — potentially adding service requirements (`RD`),\\n * recovering from errors, or augmenting the result.\\n *\\n * **Example** (Logging decode failures)\\n *\\n * ```ts import.meta.vitest\\n * import { Effect, Schema } from \\\"effect\\\"\\n *\\n * const events: Array<string> = []\\n * const Logged = Schema.String.pipe(\\n *   Schema.middlewareDecoding((effect) =>\\n *     Effect.tapError(effect, () => Effect.sync(() => events.push(\\\"decode failed\\\")))\\n *   )\\n * )\\n * Effect.runSync(Effect.result(Schema.decodeUnknownEffect(Logged)(42)))\\n * events // => [\\\"decode failed\\\"]\\n * ```\\n *\\n * @see {@link catchDecoding} for a simpler error-recovery variant\\n * @category decoding\\n * @since 4.0.0\\n */\\nexport function middlewareDecoding<S extends Constraint, RD>(\\n  decode: (\\n    effect: Effect.Effect<Option_.Option<S[\\\"Type\\\"]>, SchemaIssue.Issue, S[\\\"DecodingServices\\\"]>,\\n    options: SchemaAST.ParseOptions\\nimport { Effect, Layer } from \\\"effect\\\";\\nimport type { CalculatorsId } from \\\"@taxkit/calculators/schemas\\\";\\nimport * as EffectRpcTest from \\\"effect/unstable/rpc/RpcTest\\\";\\n\\nimport { ApiRpcGroup } from \\\"./group.js\\\";\\nimport { ApiRpcHandlersLive } from \\\"./handlers.js\\\";\\nimport { ApiRpcClient } from \\\"./service.js\\\";\\n\\nexport const ApiRpcClientTest = Layer.effect(\\n  ApiRpcClient,\\n  EffectRpcTest.makeClient(ApiRpcGroup).pipe(\\n    Effect.map((client) =>\\n      ApiRpcClient.of({\\n        get: Effect.fn(\\\"ApiRpcClient.get\\\")((id: CalculatorsId) => client.GetCalculators({ id })),\\n        list: Effect.fn(\\\"ApiRpcClient.list\\\")(() => client.ListCalculators()),\\n      }),\\n    ),\\n  ),\\n).pipe(Layer.provide(ApiRpcHandlersLive));\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","create_time":1791130408.773164}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
