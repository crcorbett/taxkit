code: SchemaGetter.Getter<S[\\\"Type\\\"], S[\\\"Type\\\"], RD>\\n  readonly encode: SchemaGetter.Getter<S[\\\"Type\\\"], S[\\\"Type\\\"], RE>\\n}) {\\n  return (self: S): decodeTo<toType<S>, S, RD, RE> => {\\n    return decodeTo<toType<S>, S, RD, RE>(toType(self), transformation)(self)\\n  }\\n}\\n/**\\n * Reverses a schema transformation so the encoded schema is supplied first.\\n *\\n * **When to use**\\n *\\n * Use to define a transformation by naming the encoded schema before the\\n * decoded schema.\\n *\\n * **Details**\\n *\\n * `encodeTo(to)(from)` is equivalent to `to.pipe(decodeTo(from))`. The `from`\\n * schema acts as the target decoded schema and `to` acts as the encoded source.\\n *\\n * **Example** (Encoding a number back to a string)\\n *\\n * ```ts import.meta.vitest\\n * import { Schema, SchemaGetter } from \\\"effect\\\"\\n *\\n * const NumberFromString = Schema.Number.pipe(\\n *   Schema.encodeTo(Schema.String, {\\n *     decode: SchemaGetter.transform((s: string) => Number(s)),\\n *     encode: SchemaGetter.transform((n: number) => String(n))\\n *   })\\n * )\\n * Schema.decodeSync(NumberFromString)(\\\"42\\\") // => 42\\n * ```\\n *\\n * @category transforming\\n * @since 4.0.0\\n */\\nexport function encodeTo<To extends Constraint>(\\n  to: To\\n): <From extends Constraint>(from: From) => compose<From, To>\\nexport function encodeTo<To extends Constraint, From extends Constraint, RD = never, RE = never>(\\n  to: To,\\n  transformation: {\\n    readonly decode: SchemaGetter.Getter<NoInfer<From[\\\"Encoded\\\"]>, NoInfer<To[\\\"Type\\\"]>, RD>\\n    readonly encode: SchemaGetter.Getter<NoInfer<To[\\\"Type\\\"]>, NoInfer<From[\\\"Encoded\\\"]>, RE>\\n  }\\n): (from: From) => decodeTo<From, To, RD, RE>\\n        ),\\n        (value) => send(client.id, responseEnvelope(requestId, tag, value), collector && collector.clearUnsafe())\\n      )\\n    return Effect.catchCause(write, (cause) => {\\n      client.schemas.delete(requestId)\\n      const defect = Cause.squash(Cause.map(cause, (e) => SchemaIssue.defaultFormatter(e.issue)))\\n      return Effect.andThen(\\n        sendRequestDefect(client, requestId, schemas.encodeDefect, defect),\\n        server.write(client.id, { _tag: \\\"Interrupt\\\", requestId, interruptors: [] })\\n      )\\n    })\\n  }\\n\\n  const sendRequestDefect = (\\n    client: Client,\\n    requestId: RequestId,\\n    encodeDefect: (u: unknown) => Effect.Effect<unknown, Schema.SchemaError>,\\n    defect: unknown\\n  ) =>\\n    Effect.catchCause(\\n      Effect.flatMap(encodeDefect(defect), (encodedDefect) =>\\n        send(client.id, {\\n          _tag: \\\"Exit\\\",\\n          requestId,\\n          exit: {\\n            _tag: \\\"Failure\\\",\\n            cause: [{\\n              _tag: \\\"Die\\\",\\n              defect: encodedDefect\\n            }]\\n          }\\n        })),\\n      (cause) => sendDefect(client, Cause.squash(cause))\\n    )\\n\\n  const sendDefect = (client: Client, defect: unknown) =>\\n    Effect.catchCause(\\n      send(client.id, ResponseDefectEncoded(encodeDefectUnsafe(defect))),\\n      (cause) =>\\n        Effect.annotateLogs(Effect.logDebug(cause), {\\n          module: \\\"RpcServer\\\",\\n          method: \\\"sendDefect\\\"\\n        })\\n    )\\n\\n  const writeDecodedRequest = (\\n                headers: Object.entries(message.headers)\\n              }, collector && collector.readUnsafe())\\n            )\\n          ) as Effect.Effect<void, RpcClientError>\\n        }\\n        case \\\"Ack\\\": {\\n          const entry = entries.get(message.requestId)\\n          if (!entry) return Effect.void\\n          return send(clientId, {\\n            _tag: \\\"Ack\\\",\\n            requestId: message.requestId\\n          }) as Effect.Effect<void, RpcClientError>\\n        }\\n        case \\\"Interrupt\\\": {\\n          const entry = entries.get(message.requestId)\\n          if (!entry) return Effect.void\\n          entries.delete(message.requestId)\\n          return send(clientId, {\\n            _tag: \\\"Interrupt\\\",\\n            requestId: message.requestId\\n          }) as Effect.Effect<void, RpcClientError>\\n        }\\n        case \\\"Eof\\\": {\\n          return Effect.void\\n        }\\n      }\\n    }\\n  })\\n\\n  yield* run(clientId, (message) => {\\n    switch (message._tag) {\\n      case \\\"Chunk\\\": {\\n        const requestId = RequestId(message.requestId)\\n        const entry = entries.get(requestId)\\n        if (!entry || Option.isNone(entry.schemas.decodeChunk)) return Effect.void\\n        return entry.schemas.decodeChunk.value(message.values).pipe(\\n          Effect.provideContext(entry.context),\\n          Effect.orDie,\\n          Effect.flatMap((chunk) =>\\n            write({ _tag: \\\"Chunk\\\", clientId: 0, requestId: RequestId(message.requestId), values: chunk })\\n          ),\\n          Effect.onError((cause) =>\\n            write({\\n              _tag: \\\"Exit\\\",\\n              clientId: 0,\\n              requestId: RequestId(message.requestId),\\n              exit: Exit.failCause(cause)\\n            })\\n          )\\n        ) as Effect.Effect<void>\\n      }\\n      case \\\"Exit\\\": {\\n        const requestId = RequestId(message.requestId)\\n        const entry = entries.get(requestId)\\n        if (!entry) return Effect.void\\n        entries.delete(requestId)\\n        return entry.schemas.decodeExit(message.exit).pipe(\\n          Effect.provideContext(entry.context),\\n          Effect.orDie,\\n          Effect.matchCauseEffect({\\n            onSuccess: (exit) => write({ _tag: \\\"Exit\\\", clientId: 0, requestId, exit }),\\n            onFailure: (cause) => write({ _tag: \\\"Exit\\\", clientId: 0, requestId, exit: Exit.failCause(cause) })\\n          })\\n        ) as Effect.Effect<void>\\n      }\\n      case \\\"Defect\\\": {\\n        return write({ _tag: \\\"Defect\\\", clientId: 0, defect: decodeDefect(message.defect as any) })\\n      }\\n      case \\\"ClientProtocolError\\\": {\\n        const exit = Exit.fail(message.error)\\n        return Effect.forEach(\\n          entries.keys(),\\n          (requestId) => write({ _tag: \\\"Exit\\\", clientId: 0, requestId, exit: exit as any })\\n        )\\n      }\\n      default: {\\n        return Effect.void\\n      }\\n    }\\n  }).pipe(\\n    Effect.catchCause(Effect.logError),\\n    Effect.interruptible,\\n    Effect.forkScoped\\n  )\\n\\n  return client\\n})\\n\\ninterface RpcSchemas {\\n  readonly decodeChunk: Option.Option<\\n    (chunk: ReadonlyArray<unknown>) => Effect.Effect<NonEmptyReadonlyArray<any>, Schema.SchemaError, unknown>\\n  >\\n  readonly encodePayload: (payload: any) => Effect.Effect<any, Schema.SchemaError, unknown>\\n  readonly decodeExit: (encoded: unknown) => Effect.Effect<Exit.Exit<any, any>, Schema.SchemaError, unknown>\\n}\\n// Codecs are compiled per client, because two protocols can fill the message\\n// holes with different codecs.\\nconst makeRpcSchemas = (codecFor: RpcSerialization.CodecFor) => {\\n  const cache = new WeakMap<Rpc.AnyWithProps, RpcSchemas>()\\n  return (rpc: Rpc.AnyWithProps): RpcSchemas => {\\n    let entry = cache.get(rpc)\\nimport { __DOMAIN_SYMBOL__UnavailableError, Invalid__DOMAIN_SYMBOL__ResponseError } from \\\"__DOMAIN_PACKAGE__/errors\\\";\\nimport { __DOMAIN_SYMBOL__ClientDeadline } from \\\"__DOMAIN_PACKAGE__/schemas\\\";\\nimport type { __DOMAIN_SYMBOL__ApiOrigin, __DOMAIN_SYMBOL__Id } from \\\"__DOMAIN_PACKAGE__/schemas\\\";\\nimport { Effect, Layer, Match, Option, Schema } from \\\"effect\\\";\\nimport { Rpc as EffectRpc, RpcClient as EffectRpcClient, RpcSerialization } from \\\"effect/unstable/rpc\\\";\\nimport type { RpcClientError } from \\\"effect/unstable/rpc/RpcClientError\\\";\\nimport { Get__DOMAIN_SYMBOL__, List__DOMAIN_SYMBOL__, __SYMBOL__Group } from \\\"./group.js\\\";\\nimport { __SYMBOL__Client } from \\\"./service.js\\\";\\n\\nclass RpcReplyDecodeDefect extends Schema.TaggedError<RpcReplyDecodeDefect>()(\\\"RpcReplyDecodeDefect\\\", {\\n  operation: Schema.Literals([\\\"get\\\", \\\"list\\\"]),\\n}) {}\\n\\n// rc.117 caches each native exit Schema. Mark failure only inside its reply decoder.\\n// Keep the native codecs and Ndjson parser; other SchemaError defects retain their identity.\\nconst replySerialization = Layer.succeed(RpcSerialization.RpcSerialization, RpcSerialization.RpcSerialization.of({\\n  ...RpcSerialization.ndjson,\\n  codecFor: <S extends Schema.Top>(schema: S) => {\\n    const operation = schema.ast === EffectRpc.exitSchema(Get__DOMAIN_SYMBOL__).ast ? Option.some<\\\"get\\\" | \\\"list\\\">(\\\"get\\\") :\\n      schema.ast === EffectRpc.exitSchema(List__DOMAIN_SYMBOL__).ast ? Option.some<\\\"get\\\" | \\\"list\\\">(\\\"list\\\") : Option.none<\\\"get\\\" | \\\"list\\\">();\\n    const codec = RpcSerialization.ndjson.codecFor(schema);\\n    return Schema.catchDecoding<typeof codec>((issue) => Option.match(operation, {\\n      onNone: () => Effect.fail(issue),\\n      onSome: (operation) => Effect.die(new RpcReplyDecodeDefect({ operation })),\\n    }))(codec);\\n  },\\n}));\\n\\nconst rpcFailure = (operation: \\\"get\\\" | \\\"list\\\", error: RpcClientError) => Match.value(error.reason).pipe(\\n  Match.tag(\\\"RpcClientDefect\\\", () => new Invalid__DOMAIN_SYMBOL__ResponseError({ operation })),\\n  Match.tag(\\\"HttpError\\\", (reason) => Match.value(reason.kind).pipe(\\n    Match.when(\\\"DecodeError\\\", () => new Invalid__DOMAIN_SYMBOL__ResponseError({ operation })),\\n    Match.when(\\\"EmptyBodyError\\\", () => new Invalid__DOMAIN_SYMBOL__ResponseError({ operation })),\\n    Match.orElse(() => new __DOMAIN_SYMBOL__UnavailableError({ operation })),\\n  )),\\n  Match.orElse(() => new __DOMAIN_SYMBOL__UnavailableError({ operation })),\\n);\\n\\n// The caller supplies its stage's HttpClient; the scoped native client stays private.\\nexport const __SYMBOL__ClientLive = (origin: __DOMAIN_SYMBOL__ApiOrigin) => Layer.