     }\n            return data\n          }\n          return JSON.stringify(response) + \"\\n\"\n        }\n      })\n    }\n  })\n}\n\n/**\n * Default newline-delimited JSON RPC serialization.\n *\n * @stability unstable\n * @category serialization\n * @since 4.0.0\n */\nexport const ndjson: RpcSerialization[\"Service\"] = makeNdjson()\n\n/**\n * Creates a JSON-RPC 2.0 serialization for RPC protocol messages without\n * additional message framing.\n *\n * @stability unstable\n * @category serialization\n * @since 4.0.0\n */\nexport const jsonRpc = (options?: {\n  readonly contentType?: string | undefined\n}): RpcSerialization[\"Service\"] =>\n  RpcSerialization.of({\n    contentType: options?.contentType ?? \"application/json\",\n    includesFraming: false,\n    codecFor: codecForJson,\n    makeUnsafe: () => {\n      const batches = new Map<string | number, {\n        readonly size: number\n        readonly responses: Map<string | number, RpcMessage.FromServerEncoded>\n      }>()\n      return {\n        decode: (bytes) => {\n          const decoded: unknown = JSON.parse(\n            typeof bytes === \"string\" ? bytes : decodeText(bytes)\n          )\n          return decodeJsonRpcRaw(decoded, batches)\n        },\n        encode: (response) => {\n          const encoded = encodeJsonRpcResponse(response as any, batches)\n          return encoded && JSON.stringify(encoded)\n        }\n      }\n    }\n  })\n\n/**\n * Creates a newline-delimited JSON-RPC 2.0 serialization for RPC protocol\n * messages.\n"},"started_at_ms":1791130329269,"completed_at_ms":1791130329269}}
{"timestamp":"2026-10-04T16:12:09.386Z","ordinal":14469,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","item":{"type":"CommandExecution","id":"exec-f8674ce5-ef7e-470c-9528-2bebe7021913","process_id":"5192","command":["/bin/zsh","-lc","cat .agents/skills/package-structure/references/renderer-and-safety.md; cat packages/api/http/src/handlers/calculators.ts; cat packages/api/http/tsconfig.json packages/api/http/tsconfig.build.json packages/testing/src/index.ts"],"cwd":"file:///Users/cooper/.codex/worktrees/aac7/taxkit","parsed_cmd":[{"type":"unknown","cmd":"cat .agents/skills/package-structure/references/renderer-and-safety.md; cat packages/api/http/src/handlers/calculators.ts; cat packages/api/http/tsconfig.json packages/api/http/tsconfig.build.json packages/testing/src/index.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"# Renderer and safety\n\n`render_package.py` accepts a kind, an absolute new target, a valid scoped\npackage name, a source condition, a JSON version snapshot, and—when needed—an\nexisting domain package name.\n\nIt refuses relative paths, lexical traversal, filesystem/home/repository roots,\nexisting targets, symlinked parents/assets, invalid names, and missing aligned\nEffect v4 versions. It renders in a sibling staging directory, validates, writes\n`package-structure.render.json`, then atomically renames. Failure removes the\nstaging directory. There is no force option.\n\nThe source condition must be a custom name such as `@scope/source`, not an\nempty, malformed or standard condition such as `types`, `default` or `node`.\nEvery compiled export keeps that recorded condition first and points it at an\nexisting source file. Repository and package receipts must agree on the name.\n\nThe version snapshot must contain an ISO date and an exact `effect` version.\nTemplates target DAW's qualified Effect `4.0.0-rc.117` API, including\n`Schema.TaggedError`. The renderer accepts current v4 RC/stable snapshots and\nhas no legacy API switch. A different selected release needs qualification of\nthe canonical templates before adoption.\nNetwork resolution belongs to repository snapshot maintenance, never rendering.\nThe render manifest records the snapshot date and content digest, never the\nabsolute installation or source path.\n\nUse an isolated temporary directory for smoke tests. Do not point the renderer\nat a dirty live package; audit and patch that package deliberately instead.\nimport { PublicCalculatorService } from \"@taxkit/calculators\";\nimport type { CalculatorId } from \"@taxkit/calculators\";\nimport {\n  AuAnnualIncomeTaxCalculation,\n  AuPayTakeHomeCalculation,\n  AuPayWithholdingsCalculation,\n} from \"@taxkit/sdk/au/effect\";\nimport { calculateRunRequest as calculateSdkRunRequest } from \"@taxkit/sdk/effect\";\nimport type { AnySdkCalculation } from \"@taxkit/sdk/effect\";\nimport { Array, Effect, HashMap, Option, Schema } from \"effect\";\nimport { HttpApiBuilder } from \"effect/http-api\";\n\nimport { TaxKitApi } from \"../api.js\";\nimport { CalculatorApiErrorEnvelopeData } from \"../groups/calculators.js\";\n\nconst SdkCalculations = [\n  AuPayTakeHomeCalculation,\n  AuPayWithholdingsCalculation,\n  AuAnnualIncomeTaxCalculation,\n] as const;\n\nconst sdkCalculationsById = HashMap.fromIterable(\n  Array.map(\n    SdkCalculations,\n    (calculation): readonly [CalculatorId, AnySdkCalculation] => [\n      calculation.calculatorId,\n      calculation,\n    ]\n  )\n);\n\nconst sdkCalculationFor = (calculatorId: CalculatorId): AnySdkCalculation =>\n  sdkCalculationsById.pipe(\n    HashMap.get(calculatorId),\n    Option.getOrThrowWith(\n      () => new Error(`Missing SDK calculation for ${calculatorId}`)\n    )\n  );\n\nexport const CalculatorApiHandlerLive = HttpApiBuilder.group(\n  TaxKitApi,\n  \"calculatorApi\",\n  (handlers) =>\n    Effect.succeed(\n      handlers\n        .handle(\"getJurisdictions\", () =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listJurisdictions();\n          })\n        )\n        .handle(\"getTaxYears\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listTaxYears(query);\n          })\n        )\n        .handle(\"listCalculators\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listCalculators(query);\n          })\n        )\n        .handle(\"getCalculator\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculator({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(\n            Effect.mapError(\n              (error) =>\n                new CalculatorApiErrorEnvelopeData({\n                  error,\n                })\n            )\n          )\n        )\n        .handle(\"getCalculatorSchema\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculatorSchema({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(\n            Effect.mapError(\n              (error) =>\n                new CalculatorApiErrorEnvelopeData({\n                  error,\n                })\n            )\n          )\n        )\n        .handle(\"getCalculatorGraph\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculatorGraph({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(\n            Effect.mapError(\n              (error) =>\n                new CalculatorApiErrorEnvelopeData({\n                  error,\n                })\n            )\n          )\n        )\n        .handle(\"calculate\", ({ params, payload, query }) =>\n          Effect.gen(function* () {\n            const sdkCalculation = sdkCalculationFor(params.calculatorId);\n            return yield* calculateSdkRunRequest(sdkCalculation, {\n              payload,\n              ...query,\n            }).pipe(Effect.catchIf(Schema.isSchemaError, Effect.die));\n          }).pipe(\n            Effect.mapError(\n              (error) =>\n                new CalculatorApiErrorEnvelopeData({\n                  error,\n                })\n            )\n          )\n        )\n        .handle(\"listFacts\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listFacts(query);\n          })\n        )\n        .handle(\"listRules\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listRules(query);\n          })\n        )\n    )\n);\n{\n  \"extends\": \"../../../tsconfig.base.json\",\n  \"include\": [\"src/**/*.ts\"],\n  \"compilerOptions\": {\n    \"rootDir\": \"src\",\n    \"outDir\": \"dist\",\n    \"tsBuildInfoFile\": \".tsbuildinfo\",\n    \"lib\": [\"ES2024\", \"DOM\", \"DOM.Iterable\"],\n    \"types\": [\"node\"]\n  }\n}\n{\n  \"extends\": \"./tsconfig.json\",\n  \"compilerOptions\": {\n    \"noEmit\": false,\n    \"strictNullChecks\": true\n  }\n}\nimport { expect } from \"@effect/vitest\";\nimport { Array, Option } from \"effect\";\n\nexport const expectAt = <A>(items: readonly A[], index: number): A =>\n  Array.get(items, index).pipe(\n    Option.flatMap(Option.fromUndefinedOr),\n    Option.getOrElse(() => expect.fail(`Expected item at index ${index}`))\n  );\n","stderr":"","aggregated_output":"# Renderer and safety\n\n`render_package.py` accepts a kind, an absolute new target, a valid scoped\npackage name, a source condition, a JSON version snapshot, and—when needed—an\nexisting domain package name.\n\nIt refuses relative paths, lexical traversal, filesystem/home/repository roots,\nexisting targets, symlinked parents/assets, invalid names, and missing aligned\nEffect v4 versions. It renders in a sibling staging directory, validates, writes\n`package-structure.render.json`, then atomically renames. Failure removes the\nstaging directory. There is no force option.\n\nThe source condition must be a custom name such as `@scope/source`, not an\nempty, malformed or standard condition such as `types`, `default` or `node`.\nEvery compiled export keeps that recorded condition first and points it at an\nexisting source file. Repository and package receipts must agree on the name.\n\nThe version snapshot must contain an ISO date and an exact `effect` version.\nTemplates target DAW's qualified Effect `4.0.0-rc.117` API, including\n`Schema.TaggedError`. The renderer accepts current v4 RC/stable snapshots and\nhas no legacy API switch. A different selected release needs qualification of\nthe canonical templates before adoption.\nNetwork resolution belongs to repository snapshot maintenance, never rendering.\nThe render manifest records the snapshot date and content digest, never the\nabsolute installation or source path.\n\nUse an isolated temporary directory for smoke tests. Do not point the renderer\nat a dirty live package; audit and patch that package deliberately instead.\nimport { PublicCalculatorService } from \"@taxkit/calculators\";\nimport type { CalculatorId } from \"@taxkit/calculators\";\nimport {\n  AuAnnualIncomeTaxCalculation,\n  AuPayTakeHomeCalculation,\n  AuPayWithholdingsCalculation,\n} from \"@taxkit/sdk/au/effect\";\nimport { calculateRunRequest as calculateSdkRunRequest } from \"@taxkit/sdk/effect\";\nimport type { AnySdkCalculation } from \"@taxkit/sdk/effect\";\nimport { Array, Effect, HashMap, Option, Schema } from \"effect\";\nimport { HttpApiBuilder } from \"effect/http-api\";\n\nimport { TaxKitApi } from \"../api.js\";\nimport { CalculatorApiErrorEnvelopeData } from \"../groups/calculators.js\";\n\nconst SdkCalculations = [\n  AuPayTakeHomeCalculation,\n  AuPayWithholdingsCalculation,\n  AuAnnualIncomeTaxCalculation,\n] as const;\n\nconst sdkCalculationsById = HashMap.fromIterable(\n  Array.map(\n    SdkCalculations,\n    (calculation): readonly [CalculatorId, AnySdkCalculation] => [\n      calculation.calculatorId,\n      calculation,\n    ]\n  )\n);\n\nconst sdkCalculationFor = (calculatorId: CalculatorId): AnySdkCalculation =>\n  sdkCalculationsById.pipe(\n    HashMap.get(calculatorId),\n    Option.getOrThrowWith(\n      () => new Error(`Missing SDK calculation for ${calculatorId}`)\n    )\n  );\n\nexport const CalculatorApiHandlerLive = HttpApiBuilder.group(\n  TaxKitApi,\n  \"calculatorApi\",\n  (handlers) =>\n    Effect.succeed(\n      handlers\n        .handle(\"getJurisdictions\", () =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listJurisdictions();\n          })\n        )\n        .handle(\"getTaxYears\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listTaxYears(query);\n          })\n        )\n        .handle(\"listCalculators\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listCalculators(query);\n          })\n        )\n        .handle(\"getCalculator\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculator({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(\n            Effect.mapError(\n              (error) =>\n                new CalculatorApiErrorEnvelopeData({\n                  error,\n                })\n            )\n          )\n        )\n        .handle(\"getCalculatorSchema\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculatorSchema({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(\n            Effect.mapError(\n              (error) =>\n                new CalculatorApiErrorEnvelopeData({\n                  error,\n                })\n            )\n          )\n        )\n        .handle(\"getCalculatorGraph\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculatorGraph({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(\n            Effect.mapError(\n              (error) =>\n                new CalculatorApiErrorEnvelopeData({\n                  error,\n                })\n            )\n          )\n        )\n        .handle(\"calculate\", ({ params, payload, query }) =>\n          Effect.gen(function* () {\n            const sdkCalculation = sdkCalculationFor(params.calculatorId);\n            return yield* calculateSdkRunRequest(sdkCalculation, {\n              payload,\n              ...query,\n            }).pipe(Effect.catchIf(Schema.isSchemaError, Effect.die));\n          }).pipe(\n            Effect.mapError(\n              (error) =>\n                new CalculatorApiErrorEnvelopeData({\n                  error,\n                })\n            )\n          )\n        )\n        .handle(\"listFacts\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listFacts(query);\n          })\n        )\n        .handle(\"listRules\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listRules(query);\n          })\n        )\n    )\n);\n{\n  \"extends\": \"../../../tsconfig.base.json\",\n  \"include\": [\"src/**/*.ts\"],\n  \"compilerOptions\": {\n    \"rootDir\": \"src\",\n    \"outDir\": \"dist\",\n    \"tsBuildInfoFile\": \".tsbuildinfo\",\n    \"lib\": [\"ES2024\", \"DOM\", \"DOM.Iterable\"],\n    \"types\": [\"node\"]\n  }\n}\n{\n  \"extends\": \"./tsconfig.json\",\n  \"compilerOptions\": {\n    \"noEmit\": false,\n    \"strictNullChecks\": true\n  }\n}\nimport { expect } from \"@effect/vitest\";\nimport { Array, Option } from \"effect\";\n\nexport const expectAt = <A>(items: readonly A[], index: number): A =>\n  Array.get(items, index).pipe(\n    Option.flatMap(Option.fromUndefinedOr),\n    Option.getOrElse(() => expect.fail(`Expected item at index ${index}`))\n  );\n","exit_code":0,"duration":{"secs":0,"nanos":7666},"formatted_output":"# Renderer and safety\n\n`render_package.py` accepts a kind, an absolute new target, a valid scoped\npackage name, a source condition, a JSON version snapshot, and—when needed—an\nexisting domain package name.\n\nIt refuses relative paths, lexical traversal, filesystem/home/repository roots,\nexisting targets, symlinked parents/assets, invalid names, and missing aligned\nEffect v4 versions. It renders in a sibling staging directory, validates, writes\n`package-structure.render.json`, then atomically renames. Failure removes the\nstaging directory. There is no force option.\n\nThe source condition must be a custom name such as `@scope/source`, not an\nempty, malformed or standard condition such as `types`, `default` or `node`.\nEvery compiled export keeps that recorded condition first and points it at an\nexisting source file. Repository and package receipts must agree on the name.\n\nThe version snapshot must contain an ISO date and an exact `effect` version.\nTemplates target DAW's qualified Effect `4.0.0-rc.117` API, including\n`Schema.TaggedError`. The renderer accepts current v4 RC/stable snapshots and\nhas no legacy API switch. A different selected release needs qualification of\nthe canonical templates before adoption.\nNetwork resolution belongs to repository snapshot maintenance, never rendering.\nThe render manifest records the snapshot date and content digest, never the\nabsolute installation or source path.\n\nUse an isolated temporary directory for smoke tests. Do not point the renderer\nat a dirty live package; audit and patch that package deliberately instead.\nimport { PublicCalculatorService } from \"@taxkit/calculators\";\nimport type { CalculatorId } from \"@taxkit/calculators\";\nimport {\n  AuAnnualIncomeTaxCalculation,\n  AuPayTakeHomeCalculation,\n  AuPayWithholdingsCalculation,\n} from \"@taxkit/sdk/au/effect\";\nimport { calculateRunRequest as calculateSdkRunRequest } from \"@taxkit/sdk/effect\";\nimport type { AnySdkCalculation } from \"@taxkit/sdk/effect\";\nimport { Array, Effect, HashMap, Option, Schema } from \"effect\";\nimport { HttpApiBuilder } from \"effect/http-api\";\n\nimport { TaxKitApi } from \"../api.js\";\nimport { CalculatorApiErrorEnvelopeData } from \"../groups/calculators.js\";\n\nconst SdkCalculations = [\n  AuPayTakeHomeCalculation,\n  AuPayWithholdingsCalculation,\n  AuAnnualIncomeTaxCalculation,\n] as const;\n\nconst sdkCalculationsById = HashMap.fromIterable(\n  Array.map(\n    SdkCalculations,\n    (calculation): readonly [CalculatorId, AnySdkCalculation] => [\n      calculation.calculatorId,\n      calculation,\n    ]\n  )\n);\n\nconst sdkCalculationFor = (calculatorId: CalculatorId): AnySdkCalculation =>\n  sdkCalculationsById.pipe(\n    HashMap.get(calculatorId),\n    Option.getOrThrowWith(\n      () => new Error(`Missing SDK calculation for ${calculatorId}`)\n    )\n  );\n\nexport const CalculatorApiHandlerLive = HttpApiBuilder.group(\n  TaxKitApi,\n  \"calculatorApi\",\n  (handlers) =>\n    Effect.succeed(\n      handlers\n        .handle(\"getJurisdictions\", () =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listJurisdictions();\n          })\n        )\n        .handle(\"getTaxYears\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listTaxYears(query);\n          })\n        )\n        .handle(\"listCalculators\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listCalculators(query);\n          })\n        )\n        .handle(\"getCalculator\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculator({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(\n            Effect.mapError(\n              (error) =>\n                new CalculatorApiErrorEnvelopeData({\n                  error,\n                })\n            )\n          )\n        )\n        .handle(\"getCalculatorSchema\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculatorSchema({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(\n            Effect.mapError(\n              (error) =>\n                new CalculatorApiErrorEnvelopeData({\n                  error,\n                })\n            )\n          )\n        )\n        .handle(\"getCalculatorGraph\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculatorGraph({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(\n            Effect.mapError(\n              (error) =>\n                new CalculatorApiErrorEnvelopeData({\n                  error,\n                })\n            )\n          )\n        )\n        .handle(\"calculate\", ({ params, payload, query }) =>\n          Effect.gen(function* () {\n            const sdkCalculation = sdkCalculationFor(params.calculatorId);\n            return yield* calculateSdkRunRequest(sdkCalculation, {\n              payload,\n              ...query,\n            }).pipe(Effect.catchIf(Schema.isSchemaError, Effect.die));\n          }).pipe(\n            Effect.mapError(\n              (error) =>\n                new CalculatorApiErrorEnvelopeData({\n                  error,\n                })\n            )\n          )\n        )\n        .handle(\"listFacts\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listFacts(query);\n          })\n        )\n        .handle(\"listRules\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listRules(query);\n          })\n        )\n    )\n);\n{\n  \"extends\": \"../../../tsconfig.base.json\",\n  \"include\": [\"src/**/*.ts\"],\n  \"compilerOptions\": {\n    \"rootDir\": \"src\",\n    \"outDir\": \"dist\",\n    \"tsBuildInfoFile\": \".tsbuildinfo\",\n    \"lib\": [\"ES2024\", \"DOM\", \"DOM.Iterable\"],\n    \"types\": [\"node\"]\n  }\n}\n{\n  \"extends\": \"./tsconfig.json\",\n  \"compilerOptions\": {\n    \"noEmit\": false,\n    \"strictNullChecks\": true\n  }\n}\nimport { expect } from \"@effect/vitest\";\nimport { Array, Option } from \"effect\";\n\nexport const expectAt = <A>(items: readonly A[], index: number): A =>\n  Array.get(items, index).pipe(\n    Option.flatMap(Option.fromUndefinedOr),\n    Option.getOrElse(() => expect.fail(`Expected item at index ${index}`))\n  );\n"},"started_at_ms":1791130329386,"completed_at_ms":1791130329386}}
{"timestamp":"2026-10-04T16:12:09.433Z","ordinal":14470,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a107af-e159-7b63-b897-ac79cd317325","call_id":"call_SOXaXwe3bLIrkFbPG5C1SFY2","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"060357\",\"wall_time_seconds\":0.000005916,\"exit_code\":0,\"original_token_count\":3695,\"output\":\"    infer _Requires\\n  > ? [_Success] extends [RpcSchema.Stream<infer _A, infer _E>] ? AsQueue extends true ? Effect.Effect<\\n          Queue.Dequeue<\\n            _A[\\\"Type\\\"],\\n            _E[\\\"Type\\\"] | _Error[\\\"Type\\\"] | E | _Middleware[\\\"error\\\"][\\\"Type\\\"] | _Middleware[\\\"~ClientError\\\"]\\n          >,\\n          never,\\n          | Scope.Scope\\n          | _Payload[\\\"EncodingServices\\\"]\\n          | _Success[\\\"DecodingServices\\\"]\\n          | _Error[\\\"DecodingServices\\\"]\\n          | _Middleware[\\\"error\\\"][\\\"DecodingServices\\\"]\\n        >\\n      : Stream.Stream<\\n        _A[\\\"Type\\\"],\\n        _E[\\\"Type\\\"] | _Error[\\\"Type\\\"] | E | _Middleware[\\\"error\\\"][\\\"Type\\\"] | _Middleware[\\\"~ClientError\\\"],\\n        | _Payload[\\\"EncodingServices\\\"]\\n        | _Success[\\\"DecodingServices\\\"]\\n        | _Error[\\\"DecodingServices\\\"]\\n        | _Middleware[\\\"error\\\"][\\\"DecodingServices\\\"]\\n      >\\n    : Effect.Effect<\\n      Discard extends true ? void : _Success[\\\"Type\\\"],\\n      (Discard extends true ? never : _Error[\\\"Type\\\"]) | E | _Middleware[\\\"error\\\"][\\\"Type\\\"] | _Middleware[\\\"~ClientError\\\"],\\n      | _Payload[\\\"EncodingServices\\\"]\\n      | _Success[\\\"DecodingServices\\\"]\\n      | _Error[\\\"DecodingServices\\\"]\\n      | _Middleware[\\\"error\\\"][\\\"DecodingServices\\\"]\\n    > :\\n    never\\n}\\n\\n/**\\n * Derives the object-shaped RPC client type for all RPCs contained in an\\n * `RpcGroup`.\\n *\\n * @stability unstable\\n * @category utility types\\n * @since 4.0.0\\n */\\nexport type FromGroup<Group, E = never> = RpcClient<RpcGroup.Rpcs<Group>, E>\\n\\nlet requestIdCounter = 0\\n\\n/**\\n * Creates an RPC client for an already-decoded message channel, returning the\\n * client API together with a `write` function for delivering server messages\\n * back to the client.\\n *\\n * @stability unstable\\n * @category constructors\\n * @since 4.0.0\\n */\\nexport const makeNoSerialization: <Rpcs extends Rpc.Any, E, const Flatten extends boolean = false>(\\n  group: RpcGroup.RpcGroup<Rpcs>,\\n  options: {\\n    readonly onFromClient: (\\n      options: {\\n        readonly message: FromClient<Rpcs>\\n        readonly context: Context.Context<never>\\n        readonly discard: boolean\\n      }\\n    ) => Effect.Effect<void, E>\\n    readonly supportsAck?: boolean | undefined\\n    readonly spanPrefix?: string | undefined\\n    readonly spanAttributes?: Record<string, unknown> | undefined\\n    readonly generateRequestId?: (() => RequestId) | undefined\\n    readonly disableTracing?: boolean | undefined\\n    readonly flatten?: Flatten | undefined\\n  }\\n) => Effect.Effect<\\n  {\\n    readonly client: Flatten extends true ? RpcClient.Flat<Rpcs, E> : RpcClient<Rpcs, E>\\n    readonly write: (message: FromServer<Rpcs>) => Effect.Effect<void>\\n  },\\n  never,\\n  Scope.Scope | Rpc.MiddlewareClient<Rpcs>\\n> = Effect.fnUntraced(function*<Rpcs extends Rpc.Any, E, const Flatten extends boolean = false>(\\n  group: RpcGroup.RpcGroup<Rpcs>,\\n  options: {\\n    readonly onFromClient: (\\n      options: {\\n        readonly message: FromClient<Rpcs>\\n        readonly context: Context.Context<never>\\n        readonly discard: boolean\\n      }\\n    ) => Effect.Effect<void, E>\\n    readonly supportsAck?: boolean | undefined\\n    readonly spanPrefix?: string | undefined\\n    readonly spanAttributes?: Record<string, unknown> | undefined\\n    readonly generateRequestId?: (() => RequestId) | undefined\\n  options?:\\n    | {\\n      readonly disableTracing?: boolean | undefined\\n      readonly spanPrefix?: string | undefined\\n      readonly spanAttributes?: Record<string, unknown> | undefined\\n      readonly concurrency?: number | \\\"unbounded\\\" | undefined\\n      readonly disableFatalDefects?: boolean | undefined\\n    }\\n    | undefined\\n) => Effect.Effect<\\n  never,\\n  never,\\n  | Protocol\\n  | Rpc.ToHandler<Rpcs>\\n  | Rpc.Middleware<Rpcs>\\n  | Rpc.ServicesServer<Rpcs>\\n> = Effect.fnUntraced(function*<Rpcs extends Rpc.Any>(\\n  group: RpcGroup.RpcGroup<Rpcs>,\\n  options?: {\\n    readonly disableTracing?: boolean | undefined\\n    readonly spanPrefix?: string | undefined\\n    readonly spanAttributes?: Record<string, unknown> | undefined\\n    readonly concurrency?: number | \\\"unbounded\\\" | undefined\\n    readonly disableFatalDefects?: boolean | undefined\\n  }\\n) {\\n  const {\\n    codecFor,\\n    disconnects,\\n    end,\\n    run,\\n    send,\\n    supportsAck,\\n    supportsSpanPropagation,\\n    supportsTransferables\\n  } = yield* Protocol\\n  const encodeDefectUnsafe = Schema.encodeSync(codecFor(Schema.Defect()))\\n  const services = yield* Effect.context<Rpc.ToHandler<Rpcs> | Rpc.Middleware<Rpcs>>()\\n  const scope = yield* Scope.make()\\n\\n  const server = yield* makeNoSerialization(group, {\\n    ...options,\\n    disableClientAcks: !supportsAck,\\n    disableSpanPropagation: !supportsSpanPropagation,\\n    onFromServer(response): Effect.Effect<void> {\\n      const client = clients.get(response.clientId)\\n      if (!client) return Effect.void\\n      switch (response._tag) {\\n        case \\\"Chunk\\\": {\\n          const schemas = client.schemas.get(response.requestId)\\n          if (!schemas) return Effect.void\\n          return handleEncode(\\n            client,\\n            response.requestId,\\n            schemas,\\n            schemas.encodeChunk(response.values),\\n            \\\"Chunk\\\"\\n          )\\n        }\\n        case \\\"Exit\\\": {\\n          const schemas = client.schemas.get(response.requestId)\\n      never,\\n      Scope.Scope | HttpServerRequest.HttpServerRequest\\n    >\\n  },\\n  never,\\n  RpcSerialization.RpcSerialization\\n> = Effect.fnUntraced(function*(options = {}) {\\n  const serialization = yield* RpcSerialization.RpcSerialization\\n  const encodeDefectUnsafe = Schema.encodeSync(serialization.codecFor(Schema.Defect()))\\n  const includesFraming = serialization.includesFraming\\n  const isBinary = !serialization.contentType.includes(\\\"json\\\")\\n\\n  const disconnects = yield* Queue.make<number>()\\n  let writeRequest!: (\\n    clientId: number,\\n    message: FromClientEncoded\\n  ) => Effect.Effect<void>\\n\\n  let clientId = 0\\n\\n  type Client = {\\n    readonly write: (bytes: FromServerEncoded) => Effect.Effect<void>\\n    readonly end: Effect.Effect<void>\\n  }\\n  const clients = new Map<number, Client>()\\n  const clientIds = new Set<number>()\\n\\n  const encoder = new TextEncoder()\\n\\n  const httpEffect: Effect.Effect<\\n    HttpServerResponse.HttpServerResponse,\\n    never,\\n    Scope.Scope | HttpServerRequest.HttpServerRequest\\n  > = Effect.gen(function*() {\\n    const fiber = Fiber.getCurrent()!\\n    const request = Context.getUnsafe(fiber.context, HttpServerRequest.HttpServerRequest)\\n    const scope = Context.getUnsafe(fiber.context, Scope.Scope)\\n    const requestHeaders = Object.entries(request.headers)\\n    const data = yield* Effect.orDie<string | Uint8Array, any, never>(\\n      isBinary ? Effect.map(request.arrayBuffer, (buf) => new Uint8Array(buf)) : request.text\\n    )\\n    const id = clientId++\\n    const queue = yield* Queue.make<Uint8Array | FromServerEncoded, Cause.Done>({\\n      capacity: includesFraming && options.streamBufferSize !== \\\"unbounded\\\"\\n        ? options.streamBufferSize ?? 16\\n        : undefined\\n    })\\n    const parser = serialization.makeUnsafe()\\n    const requestIds: Array<RequestId> = []\\n\\n    const offer = (data: Uint8Array | string) =>\\n      typeof data === \\\"string\\\" ? Queue.offer(queue, encoder.encode(data)) : Queue.offer(queue, data)\\n    const client: Client = {\\n      write: !includesFraming\\n        ? (response) =>\\n          // buffered responses cannot carry notifications, so they are dropped\\n          response._tag === \\\"Request\\\" && response.isNotification === true\\n            ? Effect.void\\n            : Queue.offer(queue, response)\\n        : (response) => {\\n          try {\\n            const encoded = parser.encode(response)\\n            if (encoded === undefined) return Effect.void\\n            return offer(encoded)\\n          } catch (cause) {\\n            return offer(parser.encode(ResponseDefectEncoded(encodeDefectUnsafe(cause)))!)\\n          }\\n        },\\n      end: Queue.end(queue)\\n    }\\n\\n    yield* Scope.addFinalizerExit(scope, () => {\\n      clients.delete(id)\\n      clientIds.delete(id)\\n      Queue.offerUnsafe(disconnects, id)\\n      if (queue.state._tag === \\\"Done\\\") return Effect.void\\n      return Effect.andThen(\\n        Queue.shutdown(queue),\\n        Effect.forEach(\\n          requestIds,\\n          (requestId) => writeRequest(id, { _tag: \\\"Interrupt\\\", requestId }),\\n          { discard: true }\\n        )\\n      )\\n    })\\n    clients.set(id, client)\\n    clientIds.add(id)\\n\\n    // @effect-diagnostics-next-line tryCatchInEffectGen:off\\n    try {\\n      const decoded = parser.decode(data) as ReadonlyArray<FromClientEncoded>\\n      for (let i = 0; i < decoded.length; i++) {\\n        const message = decoded[i]\\n        if (message._tag === \\\"Request\\\") {\\n          requestIds.push(RequestId(message.id))\\n          ;(message as Types.Mutable<RequestEncoded>).headers = requestHeaders.concat(message.headers)\\n        }\\n        yield* writeRequest(id, message)\\n      }\\n    } catch (cause) {\\n      yield* client.write(ResponseDefectEncoded(encodeDefectUnsafe(cause)))\\n    }\\n\\n    yield* writeRequest(id, constEof)\\n\\n    if (!includesFraming) {\\n      const responses = yield* Queue.collect(queue)\\n      // Notification-only batches encode without a response body.\\n      const encoded = parser.encode(responses)\\n      return HttpServerResponse.text(encoded === undefined ? \\\"\\\" : encoded as string, {\\n        contentType: serialization.contentType\\n      })\\n    }\\n\\n    const initialChunk = yield* Queue.takeAll(queue) as any as Effect.Effect<NonEmptyReadonlyArray<Uint8Array>>\\n    if (queue.state._tag === \\\"Done\\\") {\\n      return HttpServerResponse.uint8Array(mergeUint8Arrays(initialChunk), {\\n        contentType: serialization.contentType\\n      })\\n    }\\n\\n    return HttpServerResponse.stream(\\n      Stream.fromArray(initialChunk).pipe(\\n        Stream.concat(\\n          Stream.fromQueue(queue as Queue.Dequeue<Uint8Array, Cause.Done>)\\n        )\\n      ),\\n      { contentType: serialization.contentType }\\n    )\\n  })\\n\\n  const protocol = yield* Protocol.make((writeRequest_) => {\\n    writeRequest = writeRequest_\\n    return Effect.succeed({\\n      disconnects,\\n      send(clientId, response) {\\n        const client = clients.get(clientId)\\n        if (!client) return Effect.void\\n        return client.write(response)\\n      },\\n      end(clientId) {\\n        const client = clients.get(clientId)\\n        if (!client) return Effect.void\\n        return client.end\\n      },\\n      clientIds: Effect.sync(() => clientIds),\\n      initialMessage: Effect.succeedNone,\\n      supportsAck: false,\\n      supportsTransferables: false,\\n      supportsSpanPropagation: false,\\n      supportsNotifications: includesFraming,\\n      codecFor: serialization.codecFor\\n    })\\n  })\\n\\n  return { protocol, httpEffect } as const\\n})\\n\\nconst mergeUint8Arrays = (arrays: ReadonlyArray<Uint8Array>) => {\\n  if (arrays.length === 0) return new Uint8Array(0)\\n  if (arrays.length === 1) return arrays[0]\\n  const length = arrays.reduce((acc, arr) => acc + arr.length, 0)\\n  const result = new Uint8Array(length)\\n  let offset = 0\\n  for (const arr of arrays) {\\n    result.set(arr, offset)\\n    offset += arr.length\\n  }\\n  return result\\n}\\n\\n  contentType: \\\"application/json\\\",\\n  includesFraming: false,\\n  codecFor: codecForJson,\\n  makeUnsafe: () => ({\\n    decode: (bytes) => {\\n      const decoded = JSON.parse(typeof bytes === \\\"string\\\" ? bytes : decodeText(bytes))\\n      return Array.isArray(decoded) ? decoded : [decoded]\\n    },\\n    encode: (response) => JSON.stringify(response)\\n  })\\n})\\n\\n/**\\n * Serializes RPC protocol messages as newline-delimited JSON, framing each message\\n * with a trailing newline.\\n *\\n * @stability unstable\\n * @category serialization\\n * @since 4.0.0\\n */\\nexport const makeNdjson = (options?: StreamOptions): RpcSerialization[\\\"Service\\\"] => {\\n  const maxBufferSize = options?.maxBufferSize ?? defaultMaxBufferSize\\n  return RpcSerialization.of({\\n    contentType: \\\"application/ndjson\\\",\\n    includesFraming: true,\\n    codecFor: codecForJson,\\n    makeUnsafe: () => {\\n      // lazily created: string transports never need byte decoding\\n      let decoder: TextDecoder | undefined\\n      let buffer = \\\"\\\"\\n      const failMaxBufferSize = (maxBufferSize: number): never => {\\n        buffer = \\\"\\\"\\n        throw new MaxBufferSizeExceeded({ maxBufferSize })\\n      }\\n      return ({\\n        decode: (bytes) => {\\n          buffer += typeof bytes === \\\"string\\\" ? bytes : (decoder ??= new TextDecoder()).decode(bytes, { stream: true })\\n          let position = 0\\n          let nlIndex = buffer.indexOf(\\\"\\\\n\\\", position)\\n          const items: Array<unknown> = []\\n          while (nlIndex !== -1) {\\n            if (isBufferSizeExceeded(nlIndex - position, maxBufferSize)) {\\n              failMaxBufferSize(maxBufferSize)\\n            }\\n            const line = buffer.slice(position, nlIndex)\\n            position = nlIndex + 1\\n            try {\\n              items.push(JSON.parse(line))\\n            } catch {\\n            }\\n            nlIndex = buffer.indexOf(\\\"\\\\n\\\", position)\\n          }\\n          buffer = buffer.slice(position)\\n          if (isBufferSizeExceeded(buffer.length, maxBufferSize)) {\\n            failMaxBufferSize(maxBufferSize)\\n          }\\n          return items\\n        },\\n        encode: (response) => {\\n          if (Array.isArray(response)) {\\n            if (response.length === 0) return undefined\\n            let data = \\\"\\\"\\n            for (let i = 0; i < response.length; i++) {\\n              data += JSON.stringify(response[i]) + \\\"\\\\n\\\"\\n            }\\n            return data\\n          }\\n          return JSON.stringify(response) + \\\"\\\\n\\\"\\n        }\\n      })\\n    }\\n  })\\n}\\n\\n/**\\n * Default newline-delimited JSON RPC serialization.\\n *\\n * @stability unstable\\n * @category serialization\\n * @since 4.0.0\\n */\\nexport const ndjson: RpcSerialization[\\\"Service\\\"] = makeNdjson()\\n\\n/**\\n * Creates a JSON-RPC 2.0 serialization for RPC protocol messages without\\n * additional message framing.\\n *\\n * @stability unstable\\n * @category serialization\\n * @since 4.0.0\\n */\\nexport const jsonRpc = (options?: {\\n  readonly contentType?: string | undefined\\n}): RpcSerialization[\\\"Service\\\"] =>\\n  RpcSerialization.of({\\n    contentType: options?.contentType ?? \\\"application/json\\\",\\n    includesFraming: false,\\n    codecFor: codecForJson,\\n    makeUnsafe: () => {\\n      const batches = new Map<string | number, {\\n        readonly size: number\\n        readonly responses: Map<string | number, RpcMessage.FromServerEncoded>\\n      }>()\\n      return {\\n        decode: (bytes) => {\\n          const decoded: unknown = JSON.parse(\\n            typeof bytes === \\\"string\\\" ? bytes : decodeText(bytes)\\n          )\\n          return decodeJsonRpcRaw(decoded, batches)\\n        },\\n        encode: (response) => {\\n          const encoded = encodeJsonRpcResponse(response as any, batches)\\n          return encoded && JSON.stringify(encoded)\\n        }\\n      }\\n    }\\n  })\\n\\n/**\\n * Creates a newline-delimited JSON-RPC 2.0 serialization for RPC protocol\\n * messages.\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"94ecc6\",\"wall_time_seconds\":0.000007666,\"exit_code\":0,\"original_token_count\":1700,\"output\":\"# Renderer and safety\\n\\n`render_package.py` accepts a kind, an absolute new target, a valid scoped\\npackage name, a source condition, a JSON version snapshot, and—when needed—an\\nexisting domain package name.\\n\\nIt refuses relative paths, lexical traversal, filesystem/home/repository roots,\\nexisting targets, symlinked parents/assets, invalid names, and missing aligned\\nEffect v4 versions. It renders in a sibling staging directory, validates, writes\\n`package-structure.render.json`, then atomically renames. Failure removes the\\nstaging directory. There is no force option.\\n\\nThe source condition must be a custom name such as `@scope/source`, not an\\nempty, malformed or standard condition such as `types`, `default` or `node`.\\nEvery compiled export keeps that recorded condition first and points it at an\\nexisting source file. Repository and package receipts must agree on the name.\\n\\nThe version snapshot must contain an ISO date and an exact `effect` version.\\nTemplates target DAW's qualified Effect `4.0.0-rc.117` API, including\\n`Schema.TaggedError`. The renderer accepts current v4 RC/stable snapshots and\\nhas no legacy API switch. A different selected release needs qualification of\\nthe canonical templates before adoption.\\nNetwork resolution belongs to repository snapshot maintenance, never rendering.\\nThe render manifest records the snapshot date and content digest, never the\\nabsolute installation or source path.\\n\\nUse an isolated temporary directory for smoke tests. Do not point the renderer\\nat a dirty live package; audit and patch that package deliberately instead.\\nimport { PublicCalculatorService } from \\\"@taxkit/calculators\\\";\\nimport type { CalculatorId } from \\\"@taxkit/calculators\\\";\\nimport {\\n  AuAnnualIncomeTaxCalculation,\\n  AuPayTakeHomeCalculation,\\n  AuPayWithholdingsCalculation,\\n} from \\\"@taxkit/sdk/au/effect\\\";\\nimport { calculateRunRequest as calculateSdkRunRequest } from \\\"@taxkit/sdk/effect\\\";\\nimport type { AnySdkCalculation } from \\\"@taxkit/sdk/effect\\\";\\nimport { Array, Effect, HashMap, Option, Schema } from \\\"effect\\\";\\nimport { HttpApiBuilder } from \\\"effect/http-api\\\";\\n\\nimport { TaxKitApi } from \\\"../api.js\\\";\\nimport { CalculatorApiErrorEnvelopeData } from \\\"../groups/calculators.js\\\";\\n\\nconst SdkCalculations = [\\n  AuPayTakeHomeCalculation,\\n  AuPayWithholdingsCalculation,\\n  AuAnnualIncomeTaxCalculation,\\n] as const;\\n\\nconst sdkCalculationsById = HashMap.fromIterable(\\n  Array.map(\\n    SdkCalculations,\\n    (calculation): readonly [CalculatorId, AnySdkCalculation] => [\\n      calculation.calculatorId,\\n      calculation,\\n    ]\\n  )\\n);\\n\\nconst sdkCalculationFor = (calculatorId: CalculatorId): AnySdkCalculation =>\\n  sdkCalculationsById.pipe(\\n    HashMap.get(calculatorId),\\n    Option.getOrThrowWith(\\n      () => new Error(`Missing SDK calculation for ${calculatorId}`)\\n    )\\n  );\\n\\nexport const CalculatorApiHandlerLive = HttpApiBuilder.group(\\n  TaxKitApi,\\n  \\\"calculatorApi\\\",\\n  (handlers) =>\\n    Effect.succeed(\\n      handlers\\n        .handle(\\\"getJurisdictions\\\", () =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.listJurisdictions();\\n          })\\n        )\\n        .handle(\\\"getTaxYears\\\", ({ query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.listTaxYears(query);\\n          })\\n        )\\n        .handle(\\\"listCalculators\\\", ({ query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.listCalculators(query);\\n          })\\n        )\\n        .handle(\\\"getCalculator\\\", ({ params, query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.getCalculator({\\n              calculatorId: params.calculatorId,\\n              ...query,\\n            });\\n          }).pipe(\\n            Effect.mapError(\\n              (error) =>\\n                new CalculatorApiErrorEnvelopeData({\\n                  error,\\n                })\\n            )\\n          )\\n        )\\n        .handle(\\\"getCalculatorSchema\\\", ({ params, query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.getCalculatorSchema({\\n              calculatorId: params.calculatorId,\\n              ...query,\\n            });\\n          }).pipe(\\n            Effect.mapError(\\n              (error) =>\\n                new CalculatorApiErrorEnvelopeData({\\n                  error,\\n                })\\n            )\\n          )\\n        )\\n        .handle(\\\"getCalculatorGraph\\\", ({ params, query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.getCalculatorGraph({\\n              calculatorId: params.calculatorId,\\n              ...query,\\n            });\\n          }).pipe(\\n            Effect.mapError(\\n              (error) =>\\n                new CalculatorApiErrorEnvelopeData({\\n                  error,\\n                })\\n            )\\n          )\\n        )\\n        .handle(\\\"calculate\\\", ({ params, payload, query }) =>\\n          Effect.gen(function* () {\\n            const sdkCalculation = sdkCalculationFor(params.calculatorId);\\n            return yield* calculateSdkRunRequest(sdkCalculation, {\\n              payload,\\n              ...query,\\n            }).pipe(Effect.catchIf(Schema.isSchemaError, Effect.die));\\n          }).pipe(\\n            Effect.mapError(\\n              (error) =>\\n                new CalculatorApiErrorEnvelopeData({\\n                  error,\\n                })\\n            )\\n          )\\n        )\\n        .handle(\\\"listFacts\\\", ({ query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.listFacts(query);\\n          })\\n        )\\n        .handle(\\\"listRules\\\", ({ query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.listRules(query);\\n          })\\n        )\\n    )\\n);\\n{\\n  \\\"extends\\\": \\\"../../../tsconfig.base.json\\\",\\n  \\\"include\\\": [\\\"src/**/*.ts\\\"],\\n  \\\"compilerOptions\\\": {\\n    \\\"rootDir\\\": \\\"src\\\",\\n    \\\"outDir\\\": \\\"dist\\\",\\n    \\\"tsBuildInfoFile\\\": \\\".tsbuildinfo\\\",\\n    \\\"lib\\\": [\\\"ES2024\\\", \\\"DOM\\\", \\\"DOM.Iterable\\\"],\\n    \\\"types\\\": [\\\"node\\\"]\\n  }\\n}\\n{\\n  \\\"extends\\\": \\\"./tsconfig.json\\\",\\n  \\\"compilerOptions\\\": {\\n    \\\"noEmit\\\": false,\\n    \\\"strictNullChecks\\\": true\\n  }\\n}\\nimport { expect } from \\\"@effect/vitest\\\";\\nimport { Array, Option } from \\\"effect\\\";\\n\\nexport const expectAt = <A>(items: readonly A[], index: number): A =>\\n  Array.get(items, index).pipe(\\n    Option.flatMap(Option.fromUndefinedOr),\\n    Option.getOrElse(() => expect.fail(`Expected item at index ${index}`))\\n  );\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","create_time":1791130329.433311}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
