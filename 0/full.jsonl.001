change')+s.split('---\\n',2)[2].lstrip()\n    else:s=s.replace('last_reviewed: 2026-07-20','last_reviewed: 2026-10-05')\n    p.write_text(s)\nPY\npython3 /private/tmp/taxkit-local-toolchain/update-foundation-guides.py"}],"source":"unified_exec_startup","status":"completed","stdout":"","stderr":"","aggregated_output":"","exit_code":0,"duration":{"secs":0,"nanos":6708},"formatted_output":""},"started_at_ms":1791128441321,"completed_at_ms":1791128441321}}
