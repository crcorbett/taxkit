ath;\\n});\\n10:import { lintFiles, writeLintFixture } from \\\"./cli-fixture.js\\\";\\n1057:      yield* writeLintFixture(\\n1128:      yield* writeLintFixture(join(repositoryRoot, path), source);\\n1187:        yield* writeLintFixture(\\n1228:    yield* writeLintFixture(join(repositoryRoot, path), source);\\n1296:    yield* writeLintFixture(join(repositoryRoot, path), source);\\n1400:      yield* writeLintFixture(\\n1413:      yield* writeLintFixture(\\nimport { Schema } from \\\"effect\\\";\\n\\nimport { CalculatorUse, PageView } from \\\"../schemas.js\\\";\\n\\nexport const AnalyticsObservations = Schema.Struct({\\n  calculatorUses: Schema.Array(CalculatorUse),\\n  pageViews: Schema.Array(PageView),\\n});\\nexport type AnalyticsObservations = typeof AnalyticsObservations.Type;\\n67:      \\\"no-imperative-collections\\\",\\n85:      \\\"no-imperative-collections\\\",\\n130:      \\\"no-imperative-collections\\\",\\n149:      \\\"no-imperative-collections\\\",\\n192:      \\\"no-imperative-collections\\\",\\n215:      \\\"no-imperative-collections\\\",\\n233:      \\\"no-imperative-collections\\\",\\n252:      \\\"no-imperative-collections\\\",\\n270:      \\\"no-imperative-collections\\\",\\n299:      \\\"no-imperative-collections\\\",\\n323:      \\\"no-imperative-collections\\\",\\n362:      \\\"no-imperative-collections\\\",\\n401:      \\\"no-imperative-collections\\\",\\n429:      \\\"no-imperative-collections\\\",\\n484:      \\\"no-imperative-collections\\\",\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a11571-1a58-7282-903b-860cd96057b2","create_time":1791369559.442742}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
{"timestamp":"2026-10-07T10:39:19.443Z","ordinal":68531,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":1257895494,"cached_input_tokens":1232008576,"cache_write_input_tokens":0,"output_tokens":5652848,"reasoning_output_tokens":2837647,"total_tokens":1263548342},"last_token_usage":{"input_tokens":216033,"cached_input_tokens":213376,"cache_write_input_tokens":0,"output_tokens":961,"reasoning_output_tokens":792,"total_tokens":216994},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":14.0,"window_minutes":10080,"resets_at":1791948534},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"54659.4366035000"},"individual_limit":null,"spend_control_reached":null,"plan_type":null,"rate_limit_reached_type":null}}}
