ror(() => new AnalyticsCaptureError({operation:\"calculator-use\", reason:\"identity\"}))\n            );\n            const timestamp = yield* DateTime.now;\n            const body = yield* Schema.encodeEffect(Schema.toCodecJson(CalculatorCaptureBatch))({\n              api_key: Redacted.value(config.token),\n              batch: [{event:\"calculator_used\", uuid, distinct_id: uuid, timestamp,\n                properties: {project:\"taxkit\",application:\"api\",stage:config.stage,schema_version:1,\n                  calculator_id:input.calculatorId, calculator_name:input.calculatorName,\n                  $process_person_profile:false,$geoip_disable:true}}],\n            }).pipe(Effect.mapError(() => new AnalyticsCaptureError({operation:\"calculator-use\",reason:\"encoding\"})));\n            const response = yield* http.execute(\n              HttpClientRequest.post(\"https://us.i.posthog.com/batch/\").pipe(\n                HttpClientRequest.bodyText(body, \"application/json\"),\n                HttpClientRequest.setHeader(\"cache-control\", \"no-store\")\n              )\n            ).pipe(Effect.mapError(() => new AnalyticsCaptureError({operation:\"calculator-use\",reason:\"transport\"})));\n            if (response.status < 200 || response.status >= 300) {\n              return yield* new AnalyticsCaptureError({operation:\"calculator-use\",reason:\"rejected\"});\n            }\n            yield* response.stream.pipe(\n              Stream.limitBytes(CaptureResponseByteLimit, () => Stream.fail(\n                new AnalyticsCaptureError({operation:\"calculator-use\",reason:\"response-size\"})\n              )),\n              Stream.runDrain,\n              Effect.catchTag(\"HttpClientError\", () => Effect.fail(\n                new AnalyticsCaptureError({operation:\"calculator-use\",reason:\"transport\"})\n              ))\n            );\n            return \"accepted\" as const;\n          }, (effect) => effect.pipe(\n            Effect.scoped,\n            Effect.timeout(\"5 seconds\"),\n            Effect.catchTag(\"TimeoutError\", () => Effect.fail(\n              new AnalyticsCaptureError({operation:\"calculator-use\",reason:\"deadline\"})\n            ))\n          )),\n        });\n      })\n    )),\n    Match.exhaustive\n  );\n''',\n'src/test.layer.ts':'''import { Array, Effect, Layer, Ref } from \"effect\";\nimport type { CalculatorUse, PageView } from \"./schemas.js\";\nimport { BackendAnalytics, BrowserAnalytics } from \"./service.js\";\n\nexport const makeBackendAnalyticsTest = Effect.gen(function* () {\n  const uses = yield* Ref.make<ReadonlyArray<CalculatorUse>>([]);\n  return { uses, layer: Layer.succeed(BackendAnalytics, BackendAnalytics.of({\n    recordCalculatorUse: Effect.fn(\"BackendAnalytics.recordCalculatorUse\")(function* (input) {\n      yield* Ref.update(uses, (observed) => Array.append(observed, input));\n      return \"accepted\" as const;\n    }),\n  })) } as const;\n});\nexport const makeBrowserAnalyticsTest = Effect.gen(function* () {\n  const pages = yield* Ref.make<ReadonlyArray<PageView>>([]);\n  return { pages, layer: Layer.succeed(BrowserAnalytics, BrowserAnalytics.of({\n    getCollectionPolicy: Effect.succeed(\"allow\" as const),\n    recordPageView: Effect.fn(\"BrowserAnalytics.recordPageView\")(function* (input) {\n      yield* Ref.update(pages, (observed) => Array.append(observed, input));\n      return \"accepted\" as const;\n    }),\n  })) } as const;\n});\n''',\n'src/__testing__/fixtures.ts':'''import { Effect, Schema } from \"effect\";\nimport { AnalyticsSettings, CalculatorUse } from \"../schemas.js\";\n\nexport const productionAnalyticsFixture = Schema.decodeUnknownEffect(AnalyticsSettings)({\n  _tag:\"AnalyticsEnabled\",projectId:123,region:\"us\",environment:\"production\",stage:\"prod\",\n  token:\"phc_synthetic_taxkit_capture_fixture_only\",\n});\nexport const calculatorUseFixture = Schema.decodeUnknownEffect(CalculatorUse)({\n  calculatorId:\"au.pay.take-home\",calculatorName:\"AU take-home pay\",collectionPolicy:\"allow\",\n});\nexport const disabledAnalyticsFixture = Effect.succeed(AnalyticsSettings.members[0].make({}));\n''',\n'src/__testing__/observations.ts':'''import { Schema } from \"effect\";\nimport { CalculatorUse, PageView } from \"../schemas.js\";\n\nexport const AnalyticsObservations = Schema.Struct({\n  calculatorUses: Schema.Array(CalculatorUse),\n  pageViews: Schema.Array(PageView),\n});\nexport type AnalyticsObservations = typeof AnalyticsObservations.Type;\n''',\n}\nfor path,body in files.items():p=target/path;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(body)\np=pathlib.Path('docs/product-specs/clean-slate-foundation.tasks.json');d=json.loads(p.read_text());next(x for x in d['tasks'] if x['id']=='CSF-T008')['status']='in_progress';p.write_text(json.dumps(d,indent=2)+'\\n')\nprint(json.dumps({'newPackage':'@taxkit/analytics','canonicalRendererUsed':True,'captureConnectedToApps':False,'providerWritten':False}))\nPY"}],"source":"unified_exec_startup","status":"completed","stdout":"{\"newPackage\": \"@taxkit/analytics\", \"canonicalRendererUsed\": true, \"captureConnectedToApps\": false, \"providerWritten\": false}\n","stderr":"","aggregated_output":"{\"newPackage\": \"@taxkit/analytics\", \"canonicalRendererUsed\": true, \"captureConnectedToApps\": false, \"providerWritten\": false}\n","exit_code":0,"duration":{"secs":0,"nanos":7458},"formatted_output":"{\"newPackage\": \"@taxkit/analytics\", \"canonicalRendererUsed\": true, \"captureConnectedToApps\": false, \"providerWritten\": false}\n"},"started_at_ms":1791368096064,"completed_at_ms":1791368096064}}
