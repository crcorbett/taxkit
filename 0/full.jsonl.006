tring\\\\b\\\"),\\n    \\\"runtime class policy\\\": re.compile(r\\\"\\\\binstanceof\\\\b\\\"),\\n    \\\"legacy service tag\\\": re.compile(r\\\"Context\\\\.Tag\\\\b\\\"),\\n    \\\"legacy package builder\\\": re.compile(r\\\"\\\\btsdown\\\\b\\\"),\\n}\\nfailures: list[str] = []\\nfor path in root.rglob(\\\"*\\\"):\\n    if not path.is_file() or path.suffix not in {\\\".ts\\\", \\\".tsx\\\"}:\\n        continue\\n    if any(part in {\\\"node_modules\\\", \\\"dist\\\", \\\".git\\\", \\\"negative-fixtures\\\", \\\"vendor\\\"} for part in path.parts):\\n        continue\\n    if path.parts[-3:] == (\\\"tools\\\", \\\"oxlint\\\", \\\"policy.test.ts\\\") or path.parts[-3:] == (\\\"tools\\\", \\\"oxlint\\\", \\\"policy.ts\\\"):\\n        continue\\n    text = path.read_text(errors=\\\"ignore\\\")\\n    for label, pattern in patterns.items():\\n        if pattern.search(text):\\n            failures.append(f\\\"{path}: {label}\\\")\\nif failures:\\n    print(\\\"\\\\n\\\".join(failures), file=sys.stderr)\\n    raise SystemExit(1)\\nprint(f\\\"ecosystem scan passed: {root}\\\")\\n apps/api/README.md                                 | 35 ++++++++++++++++-\\n apps/api/package.json                              |  2 +\\n apps/api/src/mcp-session.layer.ts                  |  7 +++-\\n apps/api/src/worker.application.ts                 | 13 ++++++-\\n apps/api/src/worker.ts                             | 45 +++++++++++++++++++---\\n apps/api/test/worker.boundary.test.ts              |  2 +-\\n apps/web/package.json                              |  1 +\\n apps/web/vitest.native.config.ts                   |  1 +\\n bun.lock                                           | 20 ++++++++++\\n docs/architecture/api-and-sdk.md                   |  7 ++++\\n docs/architecture/effect-services.md               |  8 ++++\\n docs/architecture/package-ownership.md             | 11 ++++++\\n .../clean-slate-foundation.tasks.json              |  2 +-\\n oxlint.config.ts                                   | 28 ++++++++++++++\\n 14 files changed, 170 insertions(+), 12 deletions(-)\\n\"}"},{"type":"input_text","text":"{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"id\\\":\\\"DEV-79\\\",\\\"uuid\\\":\\\"85150329-9061-4690-8f80-bfbc7af57ebe\\\",\\\"title\\\":\\\"CSF-T008 — Track visits and calculator choice with minimal PostHog events\\\",\\\"description\\\":\\\"This issue tracks `CSF-T008` in the clean-slate rebuild plan.\\\\n\\\\nCooper wants traffic and calculator-use counts without sending the figures people enter or adding consent dialogs.\\\\n\\\\nWork to do:\\\\n\\\\n* Manage TaxKit Production and shared Preview PostHog projects through Alchemy with checked ownership and region.\\\\n* Send explicit pageviews from the website and one calculator_used event from the backend after a successful hosted calculation. Record which calculator was used, never its inputs or answer.\\\\n* Use a checked final field allowlist, memory-only browser identity and Do Not Track support. Disable automatic clicks, profiles, recordings and other unwanted capture; keep ordinary local/Preview capture off.\\\\n* Use the bounded same-origin event relay and owned Effect HTTP operations. Check the actual SDK transport, enrichment, retry identity and disposal so adapters do not count one action twice.\\\\n\\\\nAccept when:\\\\n\\\\n* Actual outbound payloads contain only approved page/usage fields, with no tax figures, free text or persistent browser identity.\\\\n* A successful calculation has one event owner; pure tax packages and local SDK use send no analytics.\\\\n* No consent dialog is introduced. Any provider event readback is proved separately in an approved Preview.\\\\n\\\\nRequired commands are recorded in the owning task: `bun run test`, `bun run test:oxlint`, `bun run check-types`, `bun run build`, `bun run check:docs`, `bun run check:runbooks`, `bun run verification`.\\\\n\\\\nDepends on `CSF-T004`, `CSF-T005`, `CSF-T006`. These will also be saved as native issue blockers.\\\\n\\\\nImplementation has started under Cooper’s approved continuation; the old whole-design hold is superseded. The prerequisite slices are locally accepted and delivered as reviewable drafts, including the deployed agent guide in <pull-request id=\\\\\\\"ebc88fb2-91a4-4b08-b8a7-503c330a40e5\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/review/dev-77-document-agent-setup-and-tested-cancellation-limits-4a0a6d3df773\\\\\\\">\\\\\\\\[DEV-77\\\\\\\\] Document agent setup and tested cancellation limits</pull-request> and checked deployment handover in <pull-request id=\\\\\\\"cf1c9900-6ac0-49aa-84a5-26d6fd1cff23\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/review/dev-78-align-native-deployment-handover-with-tested-local-operations-9525610e0f85\\\\\\\">DEV-78 align native deployment handover with tested local operations</pull-request>. Current PostHog browser SDK 1.438.2 and Distilled 1.0.0-rc.13 have been read from their official registry archives; installed Effect/Alchemy compatibility and actual transport still need local qualification. Read-only preparation finds the Cooper organisation but no TaxKit project among its six accessible projects; the organisation's region and complete management listing still need verification, and no PostHog configuration in taxkit/prd or taxkit/stg_preview. Prepare the private event rules, one backend successful-use owner, browser lifetime and bounded relay locally. Local/ordinary Preview capture stays disabled. New project setup, management credential and exact stored-event proof remain separate concrete provider operations; no provider or credential has been changed. Metrics remain deferred.\\\\n\\\\nOwning [task and checks](<https://github.com/crcorbett/taxkit/blob/8ed03f0e1a96d2cc258b68935b9f9be443666e1b/docs/product-specs/clean-slate-foundation.tasks.json#L607>), [design](<https://github.com/crcorbett/taxkit/blob/8ed03f0e1a96d2cc258b68935b9f9be443666e1b/docs/product-specs/clean-slate-foundation.md>) and [planning commit](<https://github.com/crcorbett/taxkit/commit/8ed03f0e1a96d2cc258b68935b9f9be443666e1b>).\\\",\\\"priority\\\":{\\\"value\\\":0,\\\"name\\\":\\\"No priority\\\"},\\\"url\\\":\\\"https://linear.app/coopers-personal/issue/DEV-79/csf-t008-track-visits-and-calculator-choice-with-minimal-posthog\\\",\\\"gitBranchName\\\":\\\"coopercorbett/dev-79-csf-t008-track-visits-and-calculator-choice-with-minimal\\\",\\\"createdAt\\\":\\\"2026-10-04T00:14:08.681Z\\\",\\\"updatedAt\\\":\\\"2026-10-07T10:54:31.313Z\\\",\\\"archivedAt\\\":null,\\\"completedAt\\\":null,\\\"startedAt\\\":\\\"2026-10-07T10:10:06.397Z\\\",\\\"canceledAt\\\":null,\\\"dueDate\\\":null,\\\"slaStartedAt\\\":null,\\\"slaMediumRiskAt\\\":null,\\\"slaHighRiskAt\\\":null,\\\"slaBreachesAt\\\":null,\\\"status\\\":\\\"In Progress\\\",\\\"statusType\\\":\\\"started\\\",\\\"labels\\\":[\\\"web\\\",\\\"analytics\\\"],\\\"attachments\\\":[],\\\"documents\\\":[],\\\"createdBy\\\":\\\"Cooper Corbett\\\",\\\"createdById\\\":\\\"d8b7eeef-6a21-42af-8081-66dca85ec9df\\\",\\\"project\\\":\\\"Taxkit\\\",\\\"projectId\\\":\\\"4e0eb6ef-1871-46d4-8f47-9c8f52a9c069\\\",\\\"team\\\":\\\"Development\\\",\\\"teamId\\\":\\\"ed6b68f2-2ec2-4db2-983f-bdc5951dc79a\\\"}\"}],\"isError\":false}"},{"type":"input_text","text":"{\"chunk_id\":\"5268d1\",\"wall_time_seconds\":1.004179584,\"session_id\":16783,\"original_token_count\":0,\"output\":\"\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a11571-1a58-7282-903b-860cd96057b2","create_time":1791370473.298276}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
