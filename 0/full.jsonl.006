;\n        }\n        yield* requirePostHogOwnership({ expected: news.marker, observed: observed.value.marker });\n        if (observed.value.organisation !== news.organisation) {\n          return yield* new PostHogManagementError({\n            operation: \"save-project\",\n            reason: \"foreign-resource\",\n          });\n        }\n        return yield* management.updateProject({ ...observed.value, ...news });\n      }),\n      delete: Effect.fn(\"PostHogProject.delete\")(() =>\n        Effect.fail(\n          new PostHogManagementError({ operation: \"save-project\", reason: \"retained-project\" }),\n        ),\n      ),\n    };\n  }),\n);\n\nexport const PostHogDashboardProvider = Provider.effect(\n  PostHogDashboard,\n  Effect.gen(function* () {\n    const management = yield* PostHogManagement;\n    return {\n      stables: [\"id\", \"project\"],\n      nuke: { skip: true },\n      list: () => Effect.succeed([]),\n      diff: Effect.fn(\"PostHogDashboard.diff\")(({ olds, news, output }) =>\n        Effect.sync(() => {\n          if (!Diff.isResolved(news)) {\n            return;\n          }\n          if (olds.project !== news.project) {\n            return { action: \"replace\" } satisfies Diff.Diff;\n          }\n          if (Option.exists(Option.fromNullishOr(output), (current) => current.deleted)) {\n            return { action: \"update\" } satisfies Diff.Diff;\n          }\n        }),\n      ),\n      read: Effect.fn(\"PostHogDashboard.read\")(function* ({ olds, output }) {\n        const state = Option.fromNullishOr(output);\n        if (Option.isNone(state)) {\n          return;\n        }\n        const current = yield* management.readDashboard(state.value);\n        if (Option.isNone(current)) {\n          return;\n        }\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.value.marker });\n        return current.value;\n      }),\n      reconcile: Effect.fn(\"PostHogDashboard.reconcile\")(function* ({ news, output }) {\n        const observed = yield* Option.match(Option.fromNullishOr(output), {\n          onNone: () => management.findDashboard(news),\n          onSome: management.readDashboard,\n        });\n        if (Option.isNone(observed)) {\n          return yield* management.createDashboard(news);\n        }\n        yield* requirePostHogOwnership({ expected: news.marker, observed: observed.value.marker });\n        return yield* management.updateDashboard({ ...observed.value, ...news });\n      }),\n      delete: Effect.fn(\"PostHogDashboard.delete\")(function* ({ olds, output }) {\n        const current = yield* management.readDashboard(output);\n        if (Option.isNone(current)) {\n          return;\n        }\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.value.marker });\n        yield* management.removeDashboard(current.value);\n      }),\n    };\n  }),\n);\n\nexport const PostHogInsightProvider = Provider.effect(\n  PostHogInsight,\n  Effect.gen(function* () {\n    const management = yield* PostHogManagement;\n    return {\n      stables: [\"id\", \"project\"],\n      nuke: { skip: true },\n      list: () => Effect.succeed([]),\n      diff: Effect.fn(\"PostHogInsight.diff\")(({ olds, news, output }) =>\n        Effect.sync(() => {\n          if (!Diff.isResolved(news)) {\n            return;\n          }\n          if (olds.project !== news.project) {\n            return { action: \"replace\" } satisfies Diff.Diff;\n          }\n          if (Option.exists(Option.fromNullishOr(output), (current) => current.deleted)) {\n            return { action: \"update\" } satisfies Diff.Diff;\n          }\n        }),\n      ),\n      read: Effect.fn(\"PostHogInsight.read\")(function* ({ olds, output }) {\n        const state = Option.fromNullishOr(output);\n        if (Option.isNone(state)) {\n          return;\n        }\n        const current = yield* management.readInsight(state.value);\n        if (Option.isNone(current)) {\n          return;\n        }\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.value.marker });\n        return current.value;\n      }),\n      reconcile: Effect.fn(\"PostHogInsight.reconcile\")(function* ({ news, output }) {\n        const observed = yield* Option.match(Option.fromNullishOr(output), {\n          onNone: () => management.findInsight(news),\n          onSome: management.readInsight,\n        });\n        if (Option.isNone(observed)) {\n          return yield* management.createInsight(news);\n        }\n        yield* requirePostHogOwnership({ expected: news.marker, observed: observed.value.marker });\n        return yield* management.updateInsight({ ...observed.value, ...news });\n      }),\n      delete: Effect.fn(\"PostHogInsight.delete\")(function* ({ olds, output }) {\n        const current = yield* management.readInsight(output);\n        if (Option.isNone(current)) {\n          return;\n        }\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.value.marker });\n        yield* management.removeInsight(current.value);\n      }),\n/**\n * PostHog credentials — hand-written.\n *\n * API-compatible port of the distilled repo's posthog credentials module:\n * the `Credentials` service holds an *effect* that resolves the current\n * credentials on every request. The protocol layer resolves it per request\n * and formats the `Authorization: Bearer <key>` header.\n */\nimport { ConfigError } from \"@distilled.cloud/core/errors\";\nimport * as EffectConfig from \"effect/Config\";\nimport * as Context from \"effect/Context\";\nimport * as Effect from \"effect/Effect\";\nimport * as Layer from \"effect/Layer\";\n\n/**\n * Default PostHog API host (US Cloud).\n *\n * Override per-region by setting `POSTHOG_HOST` (e.g. `https://eu.posthog.com`\n * for EU Cloud, or your self-hosted instance URL). Operation paths in the spec\n * already include the `/api/...` prefix, so the host should NOT include it.\n */\nexport const DEFAULT_API_BASE_URL = \"https://us.posthog.com\";\n\nexport interface Config {\n  /** PostHog Personal API key (sent as `Authorization: Bearer <key>`). */\n  readonly apiKey: string;\n  /** Base host URL, e.g. `https://us.posthog.com`. */\n  readonly apiBaseUrl: string;\n}\n\nexport class Credentials extends Context.Service<\n  Credentials,\n  Effect.Effect<Config>\n>()(\"PosthogCredentials\") {}\n\nconst envConfig = EffectConfig.all({\n  apiKey: EffectConfig.String(\"POSTHOG_API_KEY\"),\n  apiBaseUrl: EffectConfig.String(\"POSTHOG_HOST\").pipe(\n    EffectConfig.withDefault(DEFAULT_API_BASE_URL),\n  ),\n});\n\nexport const CredentialsFromEnv = Layer.succeed(\n  Credentials,\n  envConfig.pipe(\n    Effect.mapError(\n      () =>\n        new ConfigError({\n          message: \"POSTHOG_API_KEY environment variable is required\",\n        }),\n    ),\n    Effect.orDie,\n  ),\n);\n\n/** Convenience layer from a plain key + optional host override. */\nexport const credentials = (config: {\n  readonly apiKey: string;\n  readonly apiBaseUrl?: string;\n}): Layer.Layer<Credentials> =>\n  Layer.succeed(\n    Credentials,\n    Effect.succeed({\n      apiKey: config.apiKey,\n      apiBaseUrl: config.apiBaseUrl ?? DEFAULT_API_BASE_URL,\n    }),\n  );\n","exit_code":0,"duration":{"secs":0,"nanos":7333},"formatted_output":"/private/tmp/dev79-analytics-package-reference/distilled-posthog/package/src/services/organizations.ts\nimport * as Organisations from \"@distilled.cloud/posthog/organizations\";\nimport * as Dashboards from \"@distilled.cloud/posthog/dashboards\";\nimport * as Insights from \"@distilled.cloud/posthog/insights\";\nimport { Credentials } from \"@distilled.cloud/posthog/Credentials\";\nimport { Retry } from \"@distilled.cloud/posthog/Retry\";\nimport { CaptureKey } from \"@common-practice/analytics/schemas\";\nimport * as Array from \"effect/Array\";\nimport * as Config from \"effect/Config\";\nimport * as ConfigProvider from \"effect/ConfigProvider\";\nimport * as Effect from \"effect/Effect\";\nimport * as Function from \"effect/Function\";\nimport * as Layer from \"effect/Layer\";\nimport * as Match from \"effect/Match\";\nimport * as Option from \"effect/Option\";\nimport * as Redacted from \"effect/Redacted\";\nimport * as Schema from \"effect/Schema\";\nimport * as Stream from \"effect/Stream\";\nimport * as Boolean from \"effect/Boolean\";\nimport { PostHogManagementError } from \"./errors\";\nimport { PostHogManagement } from \"./service\";\nimport {\n  DashboardAddress,\n  DashboardDefinition,\n  DashboardId,\n  InsightAddress,\n  InsightDefinition,\n  InsightId,\n  ManagedDashboard,\n  ManagedInsight,\n  ManagedName,\n  ManagedProject,\n  ManagedTile,\n  OrganisationId,\n  OwnershipMarker,\n  ProjectAddress,\n  ProjectDefinition,\n  ProjectId,\n  TileDefinition,\n  TileId,\n} from \"./schemas\";\n\nconst ManagementKey = Schema.String.check(Schema.isMinLength(20)).pipe(\n  Schema.brand(\"PostHogManagementKey\"),\n);\nconst NextPage = Schema.String.pipe(Schema.brand(\"PostHogNextPage\"));\nconst ListedName = Schema.String.pipe(Schema.brand(\"PostHogListedName\"));\nconst ProjectResponse = Schema.Struct({\n  id: ProjectId,\n  organization: OrganisationId,\n  name: ManagedName,\n  product_description: OwnershipMarker,\n  api_token: Schema.Union([Schema.RedactedFromValue(CaptureKey), Schema.Redacted(CaptureKey)]),\n});\nconst ProjectPage = Schema.Struct({\n  results: Schema.Array(Schema.Struct({ id: ProjectId, name: ManagedName })),\n  next: Schema.optionalKey(Schema.OptionFromNullOr(NextPage)),\n});\nconst DashboardResponse = Schema.Struct({\n  id: DashboardId,\n  name: ManagedName,\n  description: OwnershipMarker,\n  deleted: Schema.Boolean,\n});\nconst DashboardPage = Schema.Struct({\n  results: Schema.Array(\n    Schema.Struct({ id: DashboardId, name: Schema.OptionFromOptionalNullOr(ListedName) }),\n  ),\n  next: Schema.optionalKey(Schema.OptionFromNullOr(NextPage)),\n});\nconst InsightResponse = Schema.Struct({\n  id: InsightId,\n  name: ManagedName,\n  description: OwnershipMarker,\n  deleted: Schema.Boolean,\n  dashboard_tiles: Schema.optionalKey(\n    Schema.Array(\n      Schema.Struct({\n        id: TileId,\n        dashboard_id: DashboardId,\n        deleted: Schema.optionalKey(Schema.OptionFromNullOr(Schema.Boolean)),\n      }),\n    ),\n  ),\n});\nconst InsightPage = Schema.Struct({\n  results: Schema.Array(\n    Schema.Struct({ id: InsightId, name: Schema.OptionFromOptionalNullOr(ListedName) }),\n  ),\n  next: Schema.optionalKey(Schema.OptionFromNullOr(NextPage)),\n});\ntype ProviderTile = NonNullable<typeof InsightResponse.Type.dashboard_tiles>[number];\n\nconst credentialsLayer = Layer.effect(\n  Credentials,\n  Effect.gen(function* () {\n    const key = yield* Config.schema(\n      Schema.RedactedFromValue(ManagementKey),\n      \"POSTHOG_API_KEY\",\n    ).pipe(\n      Effect.mapError(\n        () =>\n          new Config.ConfigError(\n            new ConfigProvider.SourceError({\n              message: \"PostHog management key is missing or invalid\",\n            }),\n          ),\n      ),\n    );\n    // Only the private SDK credential constructor sees the unwrapped secret.\n    // Distilled's Credentials service intentionally contains an Effect.\n    // @effect-diagnostics-next-line returnEffectInGen:off\n    return Effect.succeed({ apiKey: Redacted.value(key), apiBaseUrl: \"https://us.posthog.com\" });\n  }),\n);\n\nexport const PostHogManagementLive = Layer.effect(\n  PostHogManagement,\n  Effect.gen(function* () {\n    const projects = {\n      get: yield* Organisations.getOrganizationsProject,\n      list: yield* Organisations.listOrganizationsProjects,\n      create: yield* Organisations.createOrganizationsProject,\n      update: yield* Organisations.updateOrganizationsProjectsPartial,\n    };\n    const dashboards = {\n      get: yield* Dashboards.getDashboard,\n      list: yield* Dashboards.listDashboards,\n      create: yield* Dashboards.createDashboard,\n      update: yield* Dashboards.updateDashboardsPartial,\n      removeTile: yield* Dashboards.deleteDashboardTile,\n    };\n    const insights = {\n      get: yield* Insights.getInsight,\n      list: yield* Insights.listInsights,\n      create: yield* Insights.createInsight,\n      update: yield* Insights.updateInsightsPartial,\n    };\n\n    const readProject = Effect.fn(\"PostHogManagement.readProject\")(function* (\n      input: ProjectAddress,\n    ) {\n      const address = yield* Schema.encodeEffect(ProjectAddress)(input).pipe(\n        Effect.mapError(\n          () => new PostHogManagementError({ operation: \"read-project\", reason: \"invalid-data\" }),\n        ),\n      );\n      const response = yield* projects\n        .get({ organization_id: address.organisation, id: address.id })\n        .pipe(\n          Effect.asSome,\n          Effect.catchTag(\"NotFound\", () => Effect.succeedNone),\n          Effect.timeout(\"20 seconds\"),\n          Effect.mapError(\n            () => new PostHogManagementError({ operation: \"read-project\", reason: \"provider\" }),\n          ),\n        );\n      return yield* Option.match(response, {\n        onNone: () => Effect.succeedNone,\n        onSome: (value) =>\n          Schema.decodeUnknownEffect(ProjectResponse)(value).pipe(\n            Effect.map((project) =>\n              Option.some({\n                id: project.id,\n                organisation: project.organization,\n                name: project.name,\n                marker: project.product_description,\n                key: project.api_token,\n              }),\n            ),\n            Effect.mapError(\n              () =>\n                new PostHogManagementError({ operation: \"read-project\", reason: \"invalid-data\" }),\n            ),\n          ),\n      });\n    });\n    const readDashboard = Effect.fn(\"PostHogManagement.readDashboard\")(function* (\n      input: DashboardAddress,\n    ) {\n      const address = yield* Schema.encodeEffect(DashboardAddress)(input).pipe(\n        Effect.mapError(\n          () => new PostHogManagementError({ operation: \"read-dashboard\", reason: \"invalid-data\" }),\n        ),\n      );\n      const response = yield* dashboards\n        .get({ project_id: String(address.project), id: address.id })\n        .pipe(\n          Effect.asSome,\n          Effect.catchTag(\"NotFound\", () => Effect.succeedNone),\n          Effect.timeout(\"20 seconds\"),\n          Effect.mapError(\n            () => new PostHogManagementError({ operation: \"read-dashboard\", reason: \"provider\" }),\n          ),\n        );\n      return yield* Option.match(response, {\n        onNone: () => Effect.succeedNone,\n        onSome: (value) =>\n          Schema.decodeUnknownEffect(DashboardResponse)(value).pipe(\n            Effect.map((dashboard) =>\n              Option.some({\n                project: input.project,\n                id: dashboard.id,\n                name: dashboard.name,\n                marker: dashboard.description,\n                deleted: dashboard.deleted,\n              }),\n            ),\n            Effect.mapError(\n              () =>\n                new PostHogManagementError({ operation: \"read-dashboard\", reason: \"invalid-data\" }),\n            ),\n          ),\n      });\n    });\n    const readInsight = Effect.fn(\"PostHogManagement.readInsight\")(function* (\n      input: InsightAddress,\n    ) {\n      const address = yield* Schema.encodeEffect(InsightAddress)(input).pipe(\n        Effect.mapError(\n          () => new PostHogManagementError({ operation: \"read-insight\", reason: \"invalid-data\" }),\n        ),\n      );\n      const response = yield* insights\n        .get({ project_id: String(address.project), id: String(address.id) })\n        .pipe(\n          Effect.asSome,\n          Effect.catchTag(\"NotFound\", () => Effect.succeedNone),\n          Effect.timeout(\"20 seconds\"),\n          Effect.mapError(\n            () => new PostHogManagementError({ operation: \"read-insight\", reason: \"provider\" }),\n          ),\n        );\n      return yield* Option.match(response, {\n        onNone: () => Effect.succeedNone,\n        onSome: (value) =>\n          Schema.decodeUnknownEffect(InsightResponse)(value).pipe(\n            Effect.map((insight) =>\n              Option.some({\n                project: input.project,\n                id: insight.id,\n                name: insight.name,\n                marker: insight.description,\n                deleted: insight.deleted,\n                tiles: Function.pipe(\n                  Option.fromNullishOr(insight.dashboard_tiles),\n                  Option.getOrElse(() => Array.empty<ProviderTile>()),\n                  Array.filter(\n                    (tile) =>\n                      !Option.contains(Option.flatten(Option.fromNullishOr(tile.deleted)), true),\n                  ),\n                  Array.map((tile) => ({ id: tile.id, dashboard: tile.dashboard_id })),\n                ),\n              }),\n            ),\n            Effect.mapError(\n              () =>\n                new PostHogManagementError({ operation: \"read-insight\", reason: \"invalid-data\" }),\n            ),\n          ),\n      });\n    });\n    // Named lookups read all pages, never a search's first page or fuzzy first hit.\n    const findProject = Effect.fn(\"PostHogManagement.findProject\")(function* (\n      input: ProjectDefinition,\n    ) {\n      const desired = yield* Schema.encodeEffect(ProjectDefinition)(input).pipe(\n        Effect.mapError(\n          () => new PostHogManagementError({ operation: \"list-projects\", reason: \"invalid-data\" }),\n        ),\n      );\n      const found = yield* Stream.paginate(0, (offset) =>\n        Effect.gen(function* () {\n          if (offset > 10_000) {\n            return yield* new PostHogManagementError({\n              operation: \"list-projects\",\n              reason: \"pagination\",\n            });\n          }\n          const result = yield* projects\n            .list({ organization_id: desired.organisation, limit: 100, offset })\nimport * as Diff from \"alchemy/Diff\";\nimport * as Provider from \"alchemy/Provider\";\nimport { Resource } from \"alchemy/Resource\";\nimport * as Array from \"effect/Array\";\nimport * as Effect from \"effect/Effect\";\nimport * as Layer from \"effect/Layer\";\nimport * as Option from \"effect/Option\";\nimport { PostHogManagementError } from \"./errors\";\nimport { PostHogManagement } from \"./service\";\nimport { PostHogManagementLive } from \"./management.adapter.layer\";\nimport type {\n  DashboardDefinition,\n  InsightDefinition,\n  ManagedDashboard,\n  ManagedInsight,\n  ManagedProject,\n  ManagedTile,\n  ProjectDefinition,\n  TileDefinition,\n  OwnershipMarker,\n} from \"./schemas\";\n\nexport type PostHogProject = Resource<\"PostHog.Project\", ProjectDefinition, ManagedProject>;\nexport const PostHogProject = Resource<PostHogProject>(\"PostHog.Project\");\nexport type PostHogDashboard = Resource<\"PostHog.Dashboard\", DashboardDefinition, ManagedDashboard>;\nexport const PostHogDashboard = Resource<PostHogDashboard>(\"PostHog.Dashboard\");\nexport type PostHogInsight = Resource<\"PostHog.Insight\", InsightDefinition, ManagedInsight>;\nexport const PostHogInsight = Resource<PostHogInsight>(\"PostHog.Insight\");\nexport type PostHogTile = Resource<\"PostHog.Tile\", TileDefinition, ManagedTile>;\nexport const PostHogTile = Resource<PostHogTile>(\"PostHog.Tile\");\n\n// Only this exact prefix migration is allowed; project and resource identity must match.\nconst matchesOwnedMarker = (\n  expected: typeof OwnershipMarker.Type,\n  observed: typeof OwnershipMarker.Type,\n): boolean =>\n  expected === observed ||\n  expected === observed.replace(/^daw-alchemy:/u, \"common-practice-alchemy:\");\n\nexport const requirePostHogOwnership = Effect.fn(\"PostHog.requireOwnership\")(function* (\n  input: Readonly<{ expected: typeof OwnershipMarker.Type; observed: typeof OwnershipMarker.Type }>,\n) {\n  if (matchesOwnedMarker(input.expected, input.observed)) {\n    return;\n  }\n  return yield* new PostHogManagementError({\n    operation: \"read-project\",\n    reason: \"foreign-resource\",\n  });\n});\n\nexport const PostHogProjectProvider = Provider.effect(\n  PostHogProject,\n  Effect.gen(function* () {\n    const management = yield* PostHogManagement;\n    return {\n      stables: [\"id\", \"organisation\"],\n      nuke: { skip: true },\n      list: () => Effect.succeed([]),\n      diff: Effect.fn(\"PostHogProject.diff\")(function* ({ olds, news }) {\n        if (!Diff.isResolved(news)) {\n          return;\n        }\n        const previous = Option.fromNullishOr(olds);\n        if (\n          Option.isSome(previous) &&\n          (previous.value.organisation !== news.organisation ||\n            !matchesOwnedMarker(news.marker, previous.value.marker))\n        ) {\n          return yield* new PostHogManagementError({\n            operation: \"save-project\",\n            reason: \"replacement-refused\",\n          });\n        }\n      }),\n      read: Effect.fn(\"PostHogProject.read\")(function* ({ olds, output }) {\n        const state = Option.fromNullishOr(output);\n        if (Option.isNone(state)) {\n          return;\n        }\n        const current = yield* management.readProject(state.value).pipe(\n          Effect.flatMap(Effect.fromOption),\n          Effect.mapError(\n            () =>\n              new PostHogManagementError({\n                operation: \"read-project\",\n                reason: \"replacement-refused\",\n              }),\n          ),\n        );\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.marker });\n        if (current.organisation !== olds.organisation) {\n          return yield* new PostHogManagementError({\n            operation: \"read-project\",\n            reason: \"foreign-resource\",\n          });\n        }\n        return current;\n      }),\n      reconcile: Effect.fn(\"PostHogProject.reconcile\")(function* ({ news, output }) {\n        const state = Option.fromNullishOr(output);\n        const observed = yield* Option.match(state, {\n          onNone: () => management.findProject(news),\n          onSome: (current) => management.readProject(current),\n        });\n        if (Option.isNone(observed)) {\n          if (Option.isSome(state)) {\n            return yield* new PostHogManagementError({\n              operation: \"save-project\",\n              reason: \"replacement-refused\",\n            });\n          }\n          return yield* management.createProject(news);\n        }\n        yield* requirePostHogOwnership({ expected: news.marker, observed: observed.value.marker });\n        if (observed.value.organisation !== news.organisation) {\n          return yield* new PostHogManagementError({\n            operation: \"save-project\",\n            reason: \"foreign-resource\",\n          });\n        }\n        return yield* management.updateProject({ ...observed.value, ...news });\n      }),\n      delete: Effect.fn(\"PostHogProject.delete\")(() =>\n        Effect.fail(\n          new PostHogManagementError({ operation: \"save-project\", reason: \"retained-project\" }),\n        ),\n      ),\n    };\n  }),\n);\n\nexport const PostHogDashboardProvider = Provider.effect(\n  PostHogDashboard,\n  Effect.gen(function* () {\n    const management = yield* PostHogManagement;\n    return {\n      stables: [\"id\", \"project\"],\n      nuke: { skip: true },\n      list: () => Effect.succeed([]),\n      diff: Effect.fn(\"PostHogDashboard.diff\")(({ olds, news, output }) =>\n        Effect.sync(() => {\n          if (!Diff.isResolved(news)) {\n            return;\n          }\n          if (olds.project !== news.project) {\n            return { action: \"replace\" } satisfies Diff.Diff;\n          }\n          if (Option.exists(Option.fromNullishOr(output), (current) => current.deleted)) {\n            return { action: \"update\" } satisfies Diff.Diff;\n          }\n        }),\n      ),\n      read: Effect.fn(\"PostHogDashboard.read\")(function* ({ olds, output }) {\n        const state = Option.fromNullishOr(output);\n        if (Option.isNone(state)) {\n          return;\n        }\n        const current = yield* management.readDashboard(state.value);\n        if (Option.isNone(current)) {\n          return;\n        }\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.value.marker });\n        return current.value;\n      }),\n      reconcile: Effect.fn(\"PostHogDashboard.reconcile\")(function* ({ news, output }) {\n        const observed = yield* Option.match(Option.fromNullishOr(output), {\n          onNone: () => management.findDashboard(news),\n          onSome: management.readDashboard,\n        });\n        if (Option.isNone(observed)) {\n          return yield* management.createDashboard(news);\n        }\n        yield* requirePostHogOwnership({ expected: news.marker, observed: observed.value.marker });\n        return yield* management.updateDashboard({ ...observed.value, ...news });\n      }),\n      delete: Effect.fn(\"PostHogDashboard.delete\")(function* ({ olds, output }) {\n        const current = yield* management.readDashboard(output);\n        if (Option.isNone(current)) {\n          return;\n        }\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.value.marker });\n        yield* management.removeDashboard(current.value);\n      }),\n    };\n  }),\n);\n\nexport const PostHogInsightProvider = Provider.effect(\n  PostHogInsight,\n  Effect.gen(function* () {\n    const management = yield* PostHogManagement;\n    return {\n      stables: [\"id\", \"project\"],\n      nuke: { skip: true },\n      list: () => Effect.succeed([]),\n      diff: Effect.fn(\"PostHogInsight.diff\")(({ olds, news, output }) =>\n        Effect.sync(() => {\n          if (!Diff.isResolved(news)) {\n            return;\n          }\n          if (olds.project !== news.project) {\n            return { action: \"replace\" } satisfies Diff.Diff;\n          }\n          if (Option.exists(Option.fromNullishOr(output), (current) => current.deleted)) {\n            return { action: \"update\" } satisfies Diff.Diff;\n          }\n        }),\n      ),\n      read: Effect.fn(\"PostHogInsight.read\")(function* ({ olds, output }) {\n        const state = Option.fromNullishOr(output);\n        if (Option.isNone(state)) {\n          return;\n        }\n        const current = yield* management.readInsight(state.value);\n        if (Option.isNone(current)) {\n          return;\n        }\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.value.marker });\n        return current.value;\n      }),\n      reconcile: Effect.fn(\"PostHogInsight.reconcile\")(function* ({ news, output }) {\n        const observed = yield* Option.match(Option.fromNullishOr(output), {\n          onNone: () => management.findInsight(news),\n          onSome: management.readInsight,\n        });\n        if (Option.isNone(observed)) {\n          return yield* management.createInsight(news);\n        }\n        yield* requirePostHogOwnership({ expected: news.marker, observed: observed.value.marker });\n        return yield* management.updateInsight({ ...observed.value, ...news });\n      }),\n      delete: Effect.fn(\"PostHogInsight.delete\")(function* ({ olds, output }) {\n        const current = yield* management.readInsight(output);\n        if (Option.isNone(current)) {\n          return;\n        }\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.value.marker });\n        yield* management.removeInsight(current.value);\n      }),\n/**\n * PostHog credentials — hand-written.\n *\n * API-compatible port of the distilled repo's posthog credentials module:\n * the `Credentials` service holds an *effect* that resolves the current\n * credentials on every request. The protocol layer resolves it per request\n * and formats the `Authorization: Bearer <key>` header.\n */\nimport { ConfigError } from \"@distilled.cloud/core/errors\";\nimport * as EffectConfig from \"effect/Config\";\nimport * as Context from \"effect/Context\";\nimport * as Effect from \"effect/Effect\";\nimport * as Layer from \"effect/Layer\";\n\n/**\n * Default PostHog API host (US Cloud).\n *\n * Override per-region by setting `POSTHOG_HOST` (e.g. `https://eu.posthog.com`\n * for EU Cloud, or your self-hosted instance URL). Operation paths in the spec\n * already include the `/api/...` prefix, so the host should NOT include it.\n */\nexport const DEFAULT_API_BASE_URL = \"https://us.posthog.com\";\n\nexport interface Config {\n  /** PostHog Personal API key (sent as `Authorization: Bearer <key>`). */\n  readonly apiKey: string;\n  /** Base host URL, e.g. `https://us.posthog.com`. */\n  readonly apiBaseUrl: string;\n}\n\nexport class Credentials extends Context.Service<\n  Credentials,\n  Effect.Effect<Config>\n>()(\"PosthogCredentials\") {}\n\nconst envConfig = EffectConfig.all({\n  apiKey: EffectConfig.String(\"POSTHOG_API_KEY\"),\n  apiBaseUrl: EffectConfig.String(\"POSTHOG_HOST\").pipe(\n    EffectConfig.withDefault(DEFAULT_API_BASE_URL),\n  ),\n});\n\nexport const CredentialsFromEnv = Layer.succeed(\n  Credentials,\n  envConfig.pipe(\n    Effect.mapError(\n      () =>\n        new ConfigError({\n          message: \"POSTHOG_API_KEY environment variable is required\",\n        }),\n    ),\n    Effect.orDie,\n  ),\n);\n\n/** Convenience layer from a plain key + optional host override. */\nexport const credentials = (config: {\n  readonly apiKey: string;\n  readonly apiBaseUrl?: string;\n}): Layer.Layer<Credentials> =>\n  Layer.succeed(\n    Credentials,\n    Effect.succeed({\n      apiKey: config.apiKey,\n      apiBaseUrl: config.apiBaseUrl ?? DEFAULT_API_BASE_URL,\n    }),\n  );\n"},"started_at_ms":1791373161092,"completed_at_ms":1791373161092}}
{"timestamp":"2026-10-07T11:39:21.143Z","ordinal":69577,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a11629-32b7-7e61-96c1-373dde3f3ee5","call_id":"call_Jz8wScsnhvrj2zHUpYKb23KK","output":[{"type":"input_text","text":"Script completed\nWall time 0.8 seconds\nOutput:\n"},{"type":"input_text","text":"{\"i\":0,\"result\":{\"status\":\"fulfilled\",\"value\":{\"content\":[{\"type\":\"text\",\"text\":\"name: organization-get\\ntitle: Get organization details.\\ndescription: Get details of an organization by ID including name, membership level, member count, teams, and projects. If no ID is provided, returns the active organization.\\nannotations:\\n  destructiveHint: false\\n  idempotentHint: true\\n  openWorldHint: true\\n  readOnlyHint: true\\ninputSchema: '{\\\"$schema\\\":\\\"https://json-schema.org/draft/2020-12/schema\\\",\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"id\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"Organization ID. If omitted, uses the active organization.\\\"}}}'\\n\"}],\"isError\":false}}}"},{"type":"input_text","text":"{\"i\":1,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"8714d2\",\"wall_time_seconds\":0.000007333,\"exit_code\":0,\"original_token_count\":5449,\"output\":\"/private/tmp/dev79-analytics-package-reference/distilled-posthog/package/src/services/organizations.ts\\nimport * as Organisations from \\\"@distilled.cloud/posthog/organizations\\\";\\nimport * as Dashboards from \\\"@distilled.cloud/posthog/dashboards\\\";\\nimport * as Insights from \\\"@distilled.cloud/posthog/insights\\\";\\nimport { Credentials } from \\\"@distilled.cloud/posthog/Credentials\\\";\\nimport { Retry } from \\\"@distilled.cloud/posthog/Retry\\\";\\nimport { CaptureKey } from \\\"@common-practice/analytics/schemas\\\";\\nimport * as Array from \\\"effect/Array\\\";\\nimport * as Config from \\\"effect/Config\\\";\\nimport * as ConfigProvider from \\\"effect/ConfigProvider\\\";\\nimport * as Effect from \\\"effect/Effect\\\";\\nimport * as Function from \\\"effect/Function\\\";\\nimport * as Layer from \\\"effect/Layer\\\";\\nimport * as Match from \\\"effect/Match\\\";\\nimport * as Option from \\\"effect/Option\\\";\\nimport * as Redacted from \\\"effect/Redacted\\\";\\nimport * as Schema from \\\"effect/Schema\\\";\\nimport * as Stream from \\\"effect/Stream\\\";\\nimport * as Boolean from \\\"effect/Boolean\\\";\\nimport { PostHogManagementError } from \\\"./errors\\\";\\nimport { PostHogManagement } from \\\"./service\\\";\\nimport {\\n  DashboardAddress,\\n  DashboardDefinition,\\n  DashboardId,\\n  InsightAddress,\\n  InsightDefinition,\\n  InsightId,\\n  ManagedDashboard,\\n  ManagedInsight,\\n  ManagedName,\\n  ManagedProject,\\n  ManagedTile,\\n  OrganisationId,\\n  OwnershipMarker,\\n  ProjectAddress,\\n  ProjectDefinition,\\n  ProjectId,\\n  TileDefinition,\\n  TileId,\\n} from \\\"./schemas\\\";\\n\\nconst ManagementKey = Schema.String.check(Schema.isMinLength(20)).pipe(\\n  Schema.brand(\\\"PostHogManagementKey\\\"),\\n);\\nconst NextPage = Schema.String.pipe(Schema.brand(\\\"PostHogNextPage\\\"));\\nconst ListedName = Schema.String.pipe(Schema.brand(\\\"PostHogListedName\\\"));\\nconst ProjectResponse = Schema.Struct({\\n  id: ProjectId,\\n  organization: OrganisationId,\\n  name: ManagedName,\\n  product_description: OwnershipMarker,\\n  api_token: Schema.Union([Schema.RedactedFromValue(CaptureKey), Schema.Redacted(CaptureKey)]),\\n});\\nconst ProjectPage = Schema.Struct({\\n  results: Schema.Array(Schema.Struct({ id: ProjectId, name: ManagedName })),\\n  next: Schema.optionalKey(Schema.OptionFromNullOr(NextPage)),\\n});\\nconst DashboardResponse = Schema.Struct({\\n  id: DashboardId,\\n  name: ManagedName,\\n  description: OwnershipMarker,\\n  deleted: Schema.Boolean,\\n});\\nconst DashboardPage = Schema.Struct({\\n  results: Schema.Array(\\n    Schema.Struct({ id: DashboardId, name: Schema.OptionFromOptionalNullOr(ListedName) }),\\n  ),\\n  next: Schema.optionalKey(Schema.OptionFromNullOr(NextPage)),\\n});\\nconst InsightResponse = Schema.Struct({\\n  id: InsightId,\\n  name: ManagedName,\\n  description: OwnershipMarker,\\n  deleted: Schema.Boolean,\\n  dashboard_tiles: Schema.optionalKey(\\n    Schema.Array(\\n      Schema.Struct({\\n        id: TileId,\\n        dashboard_id: DashboardId,\\n        deleted: Schema.optionalKey(Schema.OptionFromNullOr(Schema.Boolean)),\\n      }),\\n    ),\\n  ),\\n});\\nconst InsightPage = Schema.Struct({\\n  results: Schema.Array(\\n    Schema.Struct({ id: InsightId, name: Schema.OptionFromOptionalNullOr(ListedName) }),\\n  ),\\n  next: Schema.optionalKey(Schema.OptionFromNullOr(NextPage)),\\n});\\ntype ProviderTile = NonNullable<typeof InsightResponse.Type.dashboard_tiles>[number];\\n\\nconst credentialsLayer = Layer.effect(\\n  Credentials,\\n  Effect.gen(function* () {\\n    const key = yield* Config.schema(\\n      Schema.RedactedFromValue(ManagementKey),\\n      \\\"POSTHOG_API_KEY\\\",\\n    ).pipe(\\n      Effect.mapError(\\n        () =>\\n          new Config.ConfigError(\\n            new ConfigProvider.SourceError({\\n              message: \\\"PostHog management key is missing or invalid\\\",\\n            }),\\n          ),\\n      ),\\n    );\\n    // Only the private SDK credential constructor sees the unwrapped secret.\\n    // Distilled's Credentials service intentionally contains an Effect.\\n    // @effect-diagnostics-next-line returnEffectInGen:off\\n    return Effect.succeed({ apiKey: Redacted.value(key), apiBaseUrl: \\\"https://us.posthog.com\\\" });\\n  }),\\n);\\n\\nexport const PostHogManagementLive = Layer.effect(\\n  PostHogManagement,\\n  Effect.gen(function* () {\\n    const projects = {\\n      get: yield* Organisations.getOrganizationsProject,\\n      list: yield* Organisations.listOrganizationsProjects,\\n      create: yield* Organisations.createOrganizationsProject,\\n      update: yield* Organisations.updateOrganizationsProjectsPartial,\\n    };\\n    const dashboards = {\\n      get: yield* Dashboards.getDashboard,\\n      list: yield* Dashboards.listDashboards,\\n      create: yield* Dashboards.createDashboard,\\n      update: yield* Dashboards.updateDashboardsPartial,\\n      removeTile: yield* Dashboards.deleteDashboardTile,\\n    };\\n    const insights = {\\n      get: yield* Insights.getInsight,\\n      list: yield* Insights.listInsights,\\n      create: yield* Insights.createInsight,\\n      update: yield* Insights.updateInsightsPartial,\\n    };\\n\\n    const readProject = Effect.fn(\\\"PostHogManagement.readProject\\\")(function* (\\n      input: ProjectAddress,\\n    ) {\\n      const address = yield* Schema.encodeEffect(ProjectAddress)(input).pipe(\\n        Effect.mapError(\\n          () => new PostHogManagementError({ operation: \\\"read-project\\\", reason: \\\"invalid-data\\\" }),\\n        ),\\n      );\\n      const response = yield* projects\\n        .get({ organization_id: address.organisation, id: address.id })\\n        .pipe(\\n          Effect.asSome,\\n          Effect.catchTag(\\\"NotFound\\\", () => Effect.succeedNone),\\n          Effect.timeout(\\\"20 seconds\\\"),\\n          Effect.mapError(\\n            () => new PostHogManagementError({ operation: \\\"read-project\\\", reason: \\\"provider\\\" }),\\n          ),\\n        );\\n      return yield* Option.match(response, {\\n        onNone: () => Effect.succeedNone,\\n        onSome: (value) =>\\n          Schema.decodeUnknownEffect(ProjectResponse)(value).pipe(\\n            Effect.map((project) =>\\n              Option.some({\\n                id: project.id,\\n                organisation: project.organization,\\n                name: project.name,\\n                marker: project.product_description,\\n                key: project.api_token,\\n              }),\\n            ),\\n            Effect.mapError(\\n              () =>\\n                new PostHogManagementError({ operation: \\\"read-project\\\", reason: \\\"invalid-data\\\" }),\\n            ),\\n          ),\\n      });\\n    });\\n    const readDashboard = Effect.fn(\\\"PostHogManagement.readDashboard\\\")(function* (\\n      input: DashboardAddress,\\n    ) {\\n      const address = yield* Schema.encodeEffect(DashboardAddress)(input).pipe(\\n        Effect.mapError(\\n          () => new PostHogManagementError({ operation: \\\"read-dashboard\\\", reason: \\\"invalid-data\\\" }),\\n        ),\\n      );\\n      const response = yield* dashboards\\n        .get({ project_id: String(address.project), id: address.id })\\n        .pipe(\\n          Effect.asSome,\\n          Effect.catchTag(\\\"NotFound\\\", () => Effect.succeedNone),\\n          Effect.timeout(\\\"20 seconds\\\"),\\n          Effect.mapError(\\n            () => new PostHogManagementError({ operation: \\\"read-dashboard\\\", reason: \\\"provider\\\" }),\\n          ),\\n        );\\n      return yield* Option.match(response, {\\n        onNone: () => Effect.succeedNone,\\n        onSome: (value) =>\\n          Schema.decodeUnknownEffect(DashboardResponse)(value).pipe(\\n            Effect.map((dashboard) =>\\n              Option.some({\\n                project: input.project,\\n                id: dashboard.id,\\n                name: dashboard.name,\\n                marker: dashboard.description,\\n                deleted: dashboard.deleted,\\n              }),\\n            ),\\n            Effect.mapError(\\n              () =>\\n                new PostHogManagementError({ operation: \\\"read-dashboard\\\", reason: \\\"invalid-data\\\" }),\\n            ),\\n          ),\\n      });\\n    });\\n    const readInsight = Effect.fn(\\\"PostHogManagement.readInsight\\\")(function* (\\n      input: InsightAddress,\\n    ) {\\n      const address = yield* Schema.encodeEffect(InsightAddress)(input).pipe(\\n        Effect.mapError(\\n          () => new PostHogManagementError({ operation: \\\"read-insight\\\", reason: \\\"invalid-data\\\" }),\\n        ),\\n      );\\n      const response = yield* insights\\n        .get({ project_id: String(address.project), id: String(address.id) })\\n        .pipe(\\n          Effect.asSome,\\n          Effect.catchTag(\\\"NotFound\\\", () => Effect.succeedNone),\\n          Effect.timeout(\\\"20 seconds\\\"),\\n          Effect.mapError(\\n            () => new PostHogManagementError({ operation: \\\"read-insight\\\", reason: \\\"provider\\\" }),\\n          ),\\n        );\\n      return yield* Option.match(response, {\\n        onNone: () => Effect.succeedNone,\\n        onSome: (value) =>\\n          Schema.decodeUnknownEffect(InsightResponse)(value).pipe(\\n            Effect.map((insight) =>\\n              Option.some({\\n                project: input.project,\\n                id: insight.id,\\n                name: insight.name,\\n                marker: insight.description,\\n                deleted: insight.deleted,\\n                tiles: Function.pipe(\\n                  Option.fromNullishOr(insight.dashboard_tiles),\\n                  Option.getOrElse(() => Array.empty<ProviderTile>()),\\n                  Array.filter(\\n                    (tile) =>\\n                      !Option.contains(Option.flatten(Option.fromNullishOr(tile.deleted)), true),\\n                  ),\\n                  Array.map((tile) => ({ id: tile.id, dashboard: tile.dashboard_id })),\\n                ),\\n              }),\\n            ),\\n            Effect.mapError(\\n              () =>\\n                new PostHogManagementError({ operation: \\\"read-insight\\\", reason: \\\"invalid-data\\\" }),\\n            ),\\n          ),\\n      });\\n    });\\n    // Named lookups read all pages, never a search's first page or fuzzy first hit.\\n    const findProject = Effect.fn(\\\"PostHogManagement.findProject\\\")(function* (\\n      input: ProjectDefinition,\\n    ) {\\n      const desired = yield* Schema.encodeEffect(ProjectDefinition)(input).pipe(\\n        Effect.mapError(\\n          () => new PostHogManagementError({ operation: \\\"list-projects\\\", reason: \\\"invalid-data\\\" }),\\n        ),\\n      );\\n      const found = yield* Stream.paginate(0, (offset) =>\\n        Effect.gen(function* () {\\n          if (offset > 10_000) {\\n            return yield* new PostHogManagementError({\\n              operation: \\\"list-projects\\\",\\n              reason: \\\"pagination\\\",\\n            });\\n          }\\n          const result = yield* projects\\n            .list({ organization_id: desired.organisation, limit: 100, offset })\\nimport * as Diff from \\\"alchemy/Diff\\\";\\nimport * as Provider from \\\"alchemy/Provider\\\";\\nimport { Resource } from \\\"alchemy/Resource\\\";\\nimport * as Array from \\\"effect/Array\\\";\\nimport * as Effect from \\\"effect/Effect\\\";\\nimport * as Layer from \\\"effect/Layer\\\";\\nimport * as Option from \\\"effect/Option\\\";\\nimport { PostHogManagementError } from \\\"./errors\\\";\\nimport { PostHogManagement } from \\\"./service\\\";\\nimport { PostHogManagementLive } from \\\"./management.adapter.layer\\\";\\nimport type {\\n  DashboardDefinition,\\n  InsightDefinition,\\n  ManagedDashboard,\\n  ManagedInsight,\\n  ManagedProject,\\n  ManagedTile,\\n  ProjectDefinition,\\n  TileDefinition,\\n  OwnershipMarker,\\n} from \\\"./schemas\\\";\\n\\nexport type PostHogProject = Resource<\\\"PostHog.Project\\\", ProjectDefinition, ManagedProject>;\\nexport const PostHogProject = Resource<PostHogProject>(\\\"PostHog.Project\\\");\\nexport type PostHogDashboard = Resource<\\\"PostHog.Dashboard\\\", DashboardDefinition, ManagedDashboard>;\\nexport const PostHogDashboard = Resource<PostHogDashboard>(\\\"PostHog.Dashboard\\\");\\nexport type PostHogInsight = Resource<\\\"PostHog.Insight\\\", InsightDefinition, ManagedInsight>;\\nexport const PostHogInsight = Resource<PostHogInsight>(\\\"PostHog.Insight\\\");\\nexport type PostHogTile = Resource<\\\"PostHog.Tile\\\", TileDefinition, ManagedTile>;\\nexport const PostHogTile = Resource<PostHogTile>(\\\"PostHog.Tile\\\");\\n\\n// Only this exact prefix migration is allowed; project and resource identity must match.\\nconst matchesOwnedMarker = (\\n  expected: typeof OwnershipMarker.Type,\\n  observed: typeof OwnershipMarker.Type,\\n): boolean =>\\n  expected === observed ||\\n  expected === observed.replace(/^daw-alchemy:/u, \\\"common-practice-alchemy:\\\");\\n\\nexport const requirePostHogOwnership = Effect.fn(\\\"PostHog.requireOwnership\\\")(function* (\\n  input: Readonly<{ expected: typeof OwnershipMarker.Type; observed: typeof OwnershipMarker.Type }>,\\n) {\\n  if (matchesOwnedMarker(input.expected, input.observed)) {\\n    return;\\n  }\\n  return yield* new PostHogManagementError({\\n    operation: \\\"read-project\\\",\\n    reason: \\\"foreign-resource\\\",\\n  });\\n});\\n\\nexport const PostHogProjectProvider = Provider.effect(\\n  PostHogProject,\\n  Effect.gen(function* () {\\n    const management = yield* PostHogManagement;\\n    return {\\n      stables: [\\\"id\\\", \\\"organisation\\\"],\\n      nuke: { skip: true },\\n      list: () => Effect.succeed([]),\\n      diff: Effect.fn(\\\"PostHogProject.diff\\\")(function* ({ olds, news }) {\\n        if (!Diff.isResolved(news)) {\\n          return;\\n        }\\n        const previous = Option.fromNullishOr(olds);\\n        if (\\n          Option.isSome(previous) &&\\n          (previous.value.organisation !== news.organisation ||\\n            !matchesOwnedMarker(news.marker, previous.value.marker))\\n        ) {\\n          return yield* new PostHogManagementError({\\n            operation: \\\"save-project\\\",\\n            reason: \\\"replacement-refused\\\",\\n          });\\n        }\\n      }),\\n      read: Effect.fn(\\\"PostHogProject.read\\\")(function* ({ olds, output }) {\\n        const state = Option.fromNullishOr(output);\\n        if (Option.isNone(state)) {\\n          return;\\n        }\\n        const current = yield* management.readProject(state.value).pipe(\\n          Effect.flatMap(Effect.fromOption),\\n          Effect.mapError(\\n            () =>\\n              new PostHogManagementError({\\n                operation: \\\"read-project\\\",\\n                reason: \\\"replacement-refused\\\",\\n              }),\\n          ),\\n        );\\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.marker });\\n        if (current.organisation !== olds.organisation) {\\n          return yield* new PostHogManagementError({\\n            operation: \\\"read-project\\\",\\n            reason: \\\"foreign-resource\\\",\\n          });\\n        }\\n        return current;\\n      }),\\n      reconcile: Effect.fn(\\\"PostHogProject.reconcile\\\")(function* ({ news, output }) {\\n        const state = Option.fromNullishOr(output);\\n        const observed = yield* Option.match(state, {\\n          onNone: () => management.findProject(news),\\n          onSome: (current) => management.readProject(current),\\n        });\\n        if (Option.isNone(observed)) {\\n          if (Option.isSome(state)) {\\n            return yield* new PostHogManagementError({\\n              operation: \\\"save-project\\\",\\n              reason: \\\"replacement-refused\\\",\\n            });\\n          }\\n          return yield* management.createProject(news);\\n        }\\n        yield* requirePostHogOwnership({ expected: news.marker, observed: observed.value.marker });\\n        if (observed.value.organisation !== news.organisation) {\\n          return yield* new PostHogManagementError({\\n            operation: \\\"save-project\\\",\\n            reason: \\\"foreign-resource\\\",\\n          });\\n        }\\n        return yield* management.updateProject({ ...observed.value, ...news });\\n      }),\\n      delete: Effect.fn(\\\"PostHogProject.delete\\\")(() =>\\n        Effect.fail(\\n          new PostHogManagementError({ operation: \\\"save-project\\\", reason: \\\"retained-project\\\" }),\\n        ),\\n      ),\\n    };\\n  }),\\n);\\n\\nexport const PostHogDashboardProvider = Provider.effect(\\n  PostHogDashboard,\\n  Effect.gen(function* () {\\n    const management = yield* PostHogManagement;\\n    return {\\n      stables: [\\\"id\\\", \\\"project\\\"],\\n      nuke: { skip: true },\\n      list: () => Effect.succeed([]),\\n      diff: Effect.fn(\\\"PostHogDashboard.diff\\\")(({ olds, news, output }) =>\\n        Effect.sync(() => {\\n          if (!Diff.isResolved(news)) {\\n            return;\\n          }\\n          if (olds.project !== news.project) {\\n            return { action: \\\"replace\\\" } satisfies Diff.Diff;\\n          }\\n          if (Option.exists(Option.fromNullishOr(output), (current) => current.deleted)) {\\n            return { action: \\\"update\\\" } satisfies Diff.Diff;\\n          }\\n        }),\\n      ),\\n      read: Effect.fn(\\\"PostHogDashboard.read\\\")(function* ({ olds, output }) {\\n        const state = Option.fromNullishOr(output);\\n        if (Option.isNone(state)) {\\n          return;\\n        }\\n        const current = yield* management.readDashboard(state.value);\\n        if (Option.isNone(current)) {\\n          return;\\n        }\\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.value.marker });\\n        return current.value;\\n      }),\\n      reconcile: Effect.fn(\\\"PostHogDashboard.reconcile\\\")(function* ({ news, output }) {\\n        const observed = yield* Option.match(Option.fromNullishOr(output), {\\n          onNone: () => management.findDashboard(news),\\n          onSome: management.readDashboard,\\n        });\\n        if (Option.isNone(observed)) {\\n          return yield* management.createDashboard(news);\\n        }\\n        yield* requirePostHogOwnership({ expected: news.marker, observed: observed.value.marker });\\n        return yield* management.updateDashboard({ ...observed.value, ...news });\\n      }),\\n      delete: Effect.fn(\\\"PostHogDashboard.delete\\\")(function* ({ olds, output }) {\\n        const current = yield* management.readDashboard(output);\\n        if (Option.isNone(current)) {\\n          return;\\n        }\\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.value.marker });\\n        yield* management.removeDashboard(current.value);\\n      }),\\n    };\\n  }),\\n);\\n\\nexport const PostHogInsightProvider = Provider.effect(\\n  PostHogInsight,\\n  Effect.gen(function* () {\\n    const management = yield* PostHogManagement;\\n    return {\\n      stables: [\\\"id\\\", \\\"project\\\"],\\n      nuke: { skip: true },\\n      list: () => Effect.succeed([]),\\n      diff: Effect.fn(\\\"PostHogInsight.diff\\\")(({ olds, news, output }) =>\\n        Effect.sync(() => {\\n          if (!Diff.isResolved(news)) {\\n            return;\\n          }\\n          if (olds.project !== news.project) {\\n            return { action: \\\"replace\\\" } satisfies Diff.Diff;\\n          }\\n          if (Option.exists(Option.fromNullishOr(output), (current) => current.deleted)) {\\n            return { action: \\\"update\\\" } satisfies Diff.Diff;\\n          }\\n        }),\\n      ),\\n      read: Effect.fn(\\\"PostHogInsight.read\\\")(function* ({ olds, output }) {\\n        const state = Option.fromNullishOr(output);\\n        if (Option.isNone(state)) {\\n          return;\\n        }\\n        const current = yield* management.readInsight(state.value);\\n        if (Option.isNone(current)) {\\n          return;\\n        }\\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.value.marker });\\n        return current.value;\\n      }),\\n      reconcile: Effect.fn(\\\"PostHogInsight.reconcile\\\")(function* ({ news, output }) {\\n        const observed = yield* Option.match(Option.fromNullishOr(output), {\\n          onNone: () => management.findInsight(news),\\n          onSome: management.readInsight,\\n        });\\n        if (Option.isNone(observed)) {\\n          return yield* management.createInsight(news);\\n        }\\n        yield* requirePostHogOwnership({ expected: news.marker, observed: observed.value.marker });\\n        return yield* management.updateInsight({ ...observed.value, ...news });\\n      }),\\n      delete: Effect.fn(\\\"PostHogInsight.delete\\\")(function* ({ olds, output }) {\\n        const current = yield* management.readInsight(output);\\n        if (Option.isNone(current)) {\\n          return;\\n        }\\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.value.marker });\\n        yield* management.removeInsight(current.value);\\n      }),\\n/**\\n * PostHog credentials — hand-written.\\n *\\n * API-compatible port of the distilled repo's posthog credentials module:\\n * the `Credentials` service holds an *effect* that resolves the current\\n * credentials on every request. The protocol layer resolves it per request\\n * and formats the `Authorization: Bearer <key>` header.\\n */\\nimport { ConfigError } from \\\"@distilled.cloud/core/errors\\\";\\nimport * as EffectConfig from \\\"effect/Config\\\";\\nimport * as Context from \\\"effect/Context\\\";\\nimport * as Effect from \\\"effect/Effect\\\";\\nimport * as Layer from \\\"effect/Layer\\\";\\n\\n/**\\n * Default PostHog API host (US Cloud).\\n *\\n * Override per-region by setting `POSTHOG_HOST` (e.g. `https://eu.posthog.com`\\n * for EU Cloud, or your self-hosted instance URL). Operation paths in the spec\\n * already include the `/api/...` prefix, so the host should NOT include it.\\n */\\nexport const DEFAULT_API_BASE_URL = \\\"https://us.posthog.com\\\";\\n\\nexport interface Config {\\n  /** PostHog Personal API key (sent as `Authorization: Bearer <key>`). */\\n  readonly apiKey: string;\\n  /** Base host URL, e.g. `https://us.posthog.com`. */\\n  readonly apiBaseUrl: string;\\n}\\n\\nexport class Credentials extends Context.Service<\\n  Credentials,\\n  Effect.Effect<Config>\\n>()(\\\"PosthogCredentials\\\") {}\\n\\nconst envConfig = EffectConfig.all({\\n  apiKey: EffectConfig.String(\\\"POSTHOG_API_KEY\\\"),\\n  apiBaseUrl: EffectConfig.String(\\\"POSTHOG_HOST\\\").pipe(\\n    EffectConfig.withDefault(DEFAULT_API_BASE_URL),\\n  ),\\n});\\n\\nexport const CredentialsFromEnv = Layer.succeed(\\n  Credentials,\\n  envConfig.pipe(\\n    Effect.mapError(\\n      () =>\\n        new ConfigError({\\n          message: \\\"POSTHOG_API_KEY environment variable is required\\\",\\n        }),\\n    ),\\n    Effect.orDie,\\n  ),\\n);\\n\\n/** Convenience layer from a plain key + optional host override. */\\nexport const credentials = (config: {\\n  readonly apiKey: string;\\n  readonly apiBaseUrl?: string;\\n}): Layer.Layer<Credentials> =>\\n  Layer.succeed(\\n    Credentials,\\n    Effect.succeed({\\n      apiKey: config.apiKey,\\n      apiBaseUrl: config.apiBaseUrl ?? DEFAULT_API_BASE_URL,\\n    }),\\n  );\\n\"}}}"},{"type":"input_text","text":"{\"i\":2,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"9b7fe3\",\"wall_time_seconds\":0.000007084,\"exit_code\":0,\"original_token_count\":2670,\"output\":\"import * as Context from \\\"effect/Context\\\";\\nimport * as Data from \\\"effect/Data\\\";\\nimport * as Effect from \\\"effect/Effect\\\";\\nimport * as Layer from \\\"effect/Layer\\\";\\nimport * as Option from \\\"effect/Option\\\";\\nimport * as Predicate from \\\"effect/Predicate\\\";\\nimport type * as Stream from \\\"effect/Stream\\\";\\nimport type { Artifacts } from \\\"./Artifacts.ts\\\";\\nimport type { ScopedPlanStatusSession } from \\\"./Report.ts\\\";\\nimport type { Diff } from \\\"./Diff.ts\\\";\\nimport type { Input } from \\\"./Input.ts\\\";\\nimport type { InstanceId } from \\\"./InstanceId.ts\\\";\\nimport type { State } from \\\"./State/State.ts\\\";\\nimport type { Platform } from \\\"./Platform.ts\\\";\\nimport { defaultProviderMode, type ProviderMode } from \\\"./ProviderMode.ts\\\";\\nimport type {\\n  ResourceBinding,\\n  ResourceClass,\\n  ResourceClassLike,\\n  ResourceLike,\\n} from \\\"./Resource.ts\\\";\\n\\nexport interface Provider<\\n  R extends ResourceLike = ResourceLike,\\n> extends Effect.Effect<ProviderService<R>, never, Provider<R>> {\\n  asEffect: () => Effect.Effect<ProviderService<R>, never, Provider<R>>;\\n  [Symbol.iterator]: () => Effect.EffectIterator<Provider<R>>;\\n  of: <\\n    ReadReq = never,\\n    DiffReq = never,\\n    PrecreateReq = never,\\n    ReconcileReq = never,\\n    DeleteReq = never,\\n    TailReq = never,\\n    LogsReq = never,\\n    ListReq = never,\\n  >(\\n    service: Omit<\\n      ProviderService<\\n        R,\\n        ReadReq,\\n        DiffReq,\\n        PrecreateReq,\\n        ReconcileReq,\\n        DeleteReq,\\n        TailReq,\\n        LogsReq,\\n        ListReq\\n      >,\\n      \\\"Type\\\"\\n    >,\\n  ) => ProviderService<\\n    R,\\n    ReadReq,\\n    DiffReq,\\n    PrecreateReq,\\n    ReconcileReq,\\n    DeleteReq,\\n    TailReq,\\n    LogsReq,\\n    ListReq\\n  >;\\n}\\n\\n// Supplied by the engine to every lifecycle operation (the stack's `state`\\n// layer is merged into the context lifecycle ops run under), so they are not\\n// requirements of the provider layer itself.\\ntype LifecycleServices = InstanceId | Artifacts | State;\\n\\nexport const Provider = <R extends ResourceLike>(\\n  type: R[\\\"Type\\\"],\\n): Provider<R> =>\\n  Context.Service<Provider<R>, ProviderService<R>>()(type) as any;\\n\\ntype BindingData<Res extends ResourceLike> = [Res] extends [\\n  { Binding: infer B },\\n]\\n  ? ResourceBinding<B>[]\\n  : any[];\\n\\ntype Props<Res extends ResourceLike> = keyof Res[\\\"Props\\\"] extends never\\n  ? Res[\\\"Props\\\"] | undefined\\n  : Res[\\\"Props\\\"];\\n\\nexport interface LogLine {\\n  timestamp: Date;\\n  message: string;\\n}\\n\\nexport interface LogsInput {\\n  since?: Date;\\n  limit?: number;\\n}\\n\\nexport interface ProviderService<\\n  Res extends ResourceLike = ResourceLike,\\n  ReadReq = never,\\n  DiffReq = never,\\n  PrecreateReq = never,\\n  ReconcileReq = never,\\n  DeleteReq = never,\\n  TailReq = never,\\n  LogsReq = never,\\n  ListReq = never,\\n> {\\n  /**\\n   * The version of the provider.\\n   *\\n   * @default 0\\n   */\\n  version?: number;\\n  /**\\n   * Legacy type names this provider also answers to. Copied from the\\n   * resource class's `aliases` option by {@link succeed}/{@link effect} so\\n   * state persisted under a pre-rename type (e.g. `\\\"Cloudflare.Queue\\\"`\\n   * before the `\\\"Cloudflare.Queues.Queue\\\"` rename) still resolves to this\\n   * provider via {@link tryFindProviderByType}.\\n   */\\n  aliases?: readonly string[];\\n  /**\\n   * The {@link ProviderMode} this service operates in.\\n   *\\n   * Set by `ProviderLayer.dual` registrations: the delegating service\\n   * registered in context carries the run's default mode, and each built\\n   * variant carries its concrete mode. Mode-agnostic providers (plain\\n   * {@link succeed}/{@link effect} registrations) leave it `undefined` —\\n   * their resources never persist a mode and never replace on a mode\\n   * switch.\\n   */\\n  mode?: ProviderMode;\\nimport * as Data from \\\"effect/Data\\\";\\nimport * as Effect from \\\"effect/Effect\\\";\\nimport * as Effectable from \\\"effect/Effectable\\\";\\nimport * as Layer from \\\"effect/Layer\\\";\\nimport * as Option from \\\"effect/Option\\\";\\nimport type { Pipeable } from \\\"effect/Pipeable\\\";\\nimport { AdoptPolicy } from \\\"./AdoptPolicy.ts\\\";\\nimport { toFqn } from \\\"./FQN.ts\\\";\\nimport type { Input, InputProps, PropsInput } from \\\"./Input.ts\\\";\\nimport { CurrentNamespace, type NamespaceNode } from \\\"./Namespace.ts\\\";\\nimport * as Output from \\\"./Output.ts\\\";\\nimport { Provider } from \\\"./Provider.ts\\\";\\nimport {\\n  ConflictingProviderModeError,\\n  ProviderModePolicy,\\n  type ProviderMode,\\n} from \\\"./ProviderMode.ts\\\";\\nimport { ref as makeRef } from \\\"./Ref.ts\\\";\\nimport { RemovalPolicy } from \\\"./RemovalPolicy.ts\\\";\\nimport { RenamePolicy } from \\\"./Rename.ts\\\";\\nimport { Self } from \\\"./Self.ts\\\";\\nimport { Stack } from \\\"./Stack.ts\\\";\\n\\nexport type ResourceConstructor<R extends ResourceLike, Req = never> = {\\n  Type: R[\\\"Type\\\"];\\n  Props: R[\\\"Props\\\"];\\n  <const Methods extends { [key: string]: any }>(\\n    methods: Methods,\\n  ): ResourceClassWithMethods<R, Methods>;\\n  (\\n    id: string,\\n    // PropsInput distributes over union Props so discriminated-union\\n    // resources keep the correlation between discriminant and payload.\\n    ...args: {} extends R[\\\"Props\\\"]\\n      ? [props?: PropsInput<R[\\\"Props\\\"]>]\\n      : [props: PropsInput<R[\\\"Props\\\"]>]\\n  ): Effect.Effect<R, never, Req>;\\n  <PropsReq = never>(\\n    id: string,\\n    props: Effect.Effect<InputProps<R[\\\"Props\\\"]>, never, PropsReq>,\\n  ): Effect.Effect<R, never, PropsReq | Req>;\\n};\\n\\nexport interface ResourceClassLike<R extends ResourceLike> {\\n  Type: R[\\\"Type\\\"];\\n  Props: R[\\\"Props\\\"];\\n  Self: Self<R>;\\n  Provider: Provider<R>;\\n  /**\\n   * Legacy type names this resource was previously registered under\\n   * (see {@link ResourceOptions.aliases}). Copied onto the\\n   * `ProviderService` by `Provider.succeed`/`Provider.effect` so provider\\n   * lookup can resolve state persisted under a pre-rename type.\\n   *\\n   * `undefined` is accepted explicitly so `ResourceClass` (whose `Aliases`\\n   * is `readonly string[] | undefined`) stays assignable to\\n   * `ResourceClassLike` under `exactOptionalPropertyTypes`.\\n   */\\n  Aliases?: readonly string[] | undefined;\\n}\\n\\nexport type ResourceClass<R extends ResourceLike> = ResourceConstructor<\\n  R,\\n  R[\\\"Providers\\\"] extends undefined ? Provider<R> : R[\\\"Providers\\\"]\\n> &\\n  Effect.Effect<ResourceConstructor<R>> & {\\n    Self: Self<R>;\\n    Provider: Provider<R>;\\n    Aliases: readonly string[] | undefined;\\n    ref(\\n      id: string,\\n      options?: { stage?: string; stack?: string },\\n    ): Effect.Effect<R>;\\n  };\\n\\nexport type ResourceClassWithMethods<\\n  R extends ResourceLike,\\n  Methods extends { [key: string]: any },\\n> = ResourceConstructor<\\n  R,\\n  R[\\\"Providers\\\"] extends undefined ? Provider<R> : R[\\\"Providers\\\"]\\n> &\\n  Effect.Effect<ResourceConstructor<R>> & {\\n    Self: Self<R>;\\n    Provider: Provider<R>;\\n    Aliases: readonly string[] | undefined;\\n    ref(\\n      id: string,\\n      options?: { stage?: string; stack?: string },\\n    ): Effect.Effect<R>;\\n  } & Methods;\\n\\nexport type LogicalId = string;\\n\\nexport interface ResourceBinding<Data = any> {\\n  sid: string;\\n  data: Data;\\n}\\n\\nexport interface ResourceLike<\\n  Type extends string = string,\\n  Props extends object | undefined = any,\\n  Attributes extends object = object,\\n  Binding = any,\\n  Providers = any,\\n> {\\n  /**\\n   * Namespace containing this Resource.\\n   */\\n  Namespace: NamespaceNode | undefined;\\n  /**\\n   * Fully Qualified Name (namespace path + logical ID).\\n   * Used as the unique key for state storage.\\n   */\\n  FQN: string;\\n  /**\\n   * Type of the Resource (e.g. AWS.Lambda.Function)\\n   */\\n  Type: Type;\\n  /**\\n   * Logical ID of the Resource (e.g. MyFunction)\\n   */\\n  LogicalId: LogicalId;\\n  /**\\n   * Properties of the Resource.\\n   */\\n  Props: Props;\\n  /**\\n   * Removal Policy of the Resource.\\n   */\\n  RemovalPolicy: RemovalPolicy[\\\"Service\\\"];\\n  /**\\n   * Per-resource adoption policy captured from the ambient {@link AdoptPolicy}\\n   * at registration time (e.g. via `.pipe(adopt(true))`). `undefined` means no\\n   * resource-scoped override — the planner falls back to the stack/CLI default.\\n   */\\n  Adopt: boolean | undefined;\\n  /**\\n   * Per-resource provider mode captured from the ambient\\n   * {@link ProviderModePolicy} at registration time. `\\\"live\\\"` when the\\n   * resource was pinned via `.pipe(remote())` (opting out of local emulation\\n   * during dev); `undefined` means the run default (`AlchemyContext.dev`).\\n   */\\n  Mode: ProviderMode | undefined;\\n  /**\\n   * Copied from {@link ResourceOptions.requiresImplementation} at\\n   * registration: `true` for platform-typed resources, whose registrations\\n   * must have resolved {@link Props} by plan time. `Plan.make` fails fast\\n   * with {@link MissingImplementationError} when this is set and `Props`\\n   * are still `undefined` after the whole program has evaluated — a bare\\n   * tag was yielded but its `.make(props, impl)` Layer was never provided.\\n   */\\n  RequiresImplementation: boolean | undefined;\\n  /**\\n   * Former FQNs this resource's state may still be persisted under,\\n   * captured from the ambient {@link RenamePolicy} at registration (via\\n   * `.pipe(renamedFrom(\\\"OldId\\\"))`) and resolved against the same namespace\\n   * as the resource's own FQN. The planner migrates a state row found at a\\n   * former FQN to {@link FQN} instead of planning a create+delete\\n   * replacement — see `renamedFrom` in Rename.ts for the full semantics.\\n   */\\n  FormerFqns: readonly string[] | undefined;\\n  /** @internal phantom */\\n  Attributes: Attributes;\\n  /** @internal phantom */\\n  Binding: Binding;\\n  /** @internal phantom */\\n  Providers: Providers;\\n}\\n\\nexport const isResource = (value: any): value is ResourceLike => {\\n  // Require the full resource identity (Type AND FQN), not just `Type`:\\n  // user-authored prop objects legitimately carry a `Type` field (e.g.\\n  // Amazon States Language states like `{ Type: \\\"Pass\\\", End: true }` in a\\n  // Step Functions definition) and must not be mistaken for resources.\\n  // Locally-declared resources always expose both as own keys; refs\\n  // (`Resource.ref(...)`) deliberately report neither via `in` so they keep\\n  // routing through Output resolution.\\n  return (\\n    typeof value === \\\"object\\\" &&\\n    value !== null &&\\n    \\\"Type\\\" in value &&\\n    \\\"FQN\\\" in value\\n  );\\n};\\n\\n/**\\n * Does `value` reference an instance of the resource type `type` —\\n * either a locally-declared resource or a `Resource.ref(...)` to one?\\n *\\n * Two constraints that ad-hoc guards get wrong for refs, which resolve\\n * to Output-expression proxies:\\n *\\n * - Read `.Type` via property access (never `in`): the proxy answers\\n *   property reads with statically-known values but deliberately does\\n *   not report key existence (so {@link isResource} keeps routing refs\\n *   through Output resolution instead of the upstream-node lookup).\\n * - Accept `typeof value === \\\"function\\\"`: the proxy's target is\\n *   callable (it needs an `apply` trap), so refs are not `\\\"object\\\"`.\\n *\\n\"}}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a11571-1a58-7282-903b-860cd96057b2","create_time":1791373161.143615}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
