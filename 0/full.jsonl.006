oto('http://taxkit.invalid/');\\n  await page.evaluate(async mode=> {\\n   window.fixtureDnt=mode==='signal-dnt-start'?'1':'0';\\n   Object.defineProperty(navigator,'doNotTrack',{configurable:true,get:()=>window.fixtureDnt});\\n   const {PostHog}=await import('/posthog.mjs');\\n   const client=new PostHog();const lifetime=new AbortController();\\n   window.fixtureClient=client;window.fixtureLifetime=lifetime;window.fixtureClosed=false;\\n   const fetchOptions={credentials:'omit',cache:'no-store',redirect:'manual',keepalive:false};\\n   if(mode.startsWith('signal')) Object.defineProperty(fetchOptions,'signal',{enumerable:true,get:()=>AbortSignal.any([lifetime.signal,AbortSignal.timeout(5000),navigator.doNotTrack==='1'?AbortSignal.abort(new DOMException('Collection disabled','AbortError')):new AbortController().signal])});\\n   client.init('phc_SYNTHETIC_ANALYTICS_79_BROWSER_FIXTURE',{\\n    api_host:'/ingest',ui_host:'https://us.posthog.com',autocapture:false,capture_pageview:false,capture_pageleave:false,\\n    disable_session_recording:true,person_profiles:'never',persistence:'memory',disable_persistence:true,\\n    opt_out_capturing_persistence_type:'memory',opt_out_persistence_by_default:true,respect_dnt:true,\\n    disable_surveys:true,disable_conversations:true,disable_product_tours:true,disable_web_experiments:true,\\n    disable_external_dependency_loading:true,advanced_disable_flags:true,advanced_disable_decide:true,\\n    advanced_disable_feature_flags:true,advanced_disable_feature_flags_on_first_load:true,\\n    capture_performance:false,error_tracking:{capture_exceptions:false,capture_console_errors:false,capture_unhandled_rejections:false},\\n    enable_recording_console_log:false,logs:{enabled:false},metrics:{enabled:false},\\n    save_campaign_params:false,save_referrer:false,ip:false,debug:false,request_batching:true,\\n    request_queue_config:{flush_interval_ms:3000},api_transport:'fetch',disable_beacon:true,fetch_options:fetchOptions,\\n    before_