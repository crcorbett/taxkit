{"timestamp":"2026-10-07T11:37:44.941Z","ordinal":69546,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":1277753780,"cached_input_tokens":1251472384,"cache_write_input_tokens":0,"output_tokens":5730142,"reasoning_output_tokens":2874397,"total_tokens":1283483922},"last_token_usage":{"input_tokens":181523,"cached_input_tokens":175104,"cache_write_input_tokens":0,"output_tokens":704,"reasoning_output_tokens":471,"total_tokens":182227},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":15.0,"window_minutes":10080,"resets_at":1791948534},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"54659.4366035000"},"individual_limit":null,"spend_control_reached":null,"plan_type":null,"rate_limit_reached_type":null}}}
