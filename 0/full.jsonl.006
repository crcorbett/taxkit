dProjectBackwardCompatBasicList,\\n  errors: [BadRequest, Forbidden, NotFound],\\n  protocol: PosthogProtocol,\\n  retry: Retry.Retry,\\n}));\\n\\nexport type ListOrganizationsProjectsEventIngestionRestrictionsError =\\n  PosthogOpError;\\n/** Projects for the current organization. */\\nexport const listOrganizationsProjectsEventIngestionRestrictions: API.OperationMethod<\\nexport const updateOrganizationsProjectsPartial: API.OperationMethod<\\n  UpdateOrganizationsProjectsPartialRequest,\\n  ProjectBackwardCompat,\\n  UpdateOrganizationsProjectsPartialError,\\n  PosthogOpContext\\n> = /*@__PURE__*/ API.make(() => ({\\n  input: UpdateOrganizationsProjectsPartialRequest,\\n  output: ProjectBackwardCompat,\\n  errors: [BadRequest, Forbidden, NotFound],\\n  protocol: PosthogProtocol,\\n  retry: Retry.Retry,\\n}));\\n\\nexport type UpdatePartialError =\\n  | BadRequest\\n  | Forbidden\\n  | NotFound\\n  | PosthogOpError;\\nexport const updatePartial: API.OperationMethod<\\n  UpdatePartialRequest,\\ncat: node_modules/.bun/@distilled.cloud+core@1.0.0-rc.13/node_modules/@distilled.cloud/core/package.json: No such file or directory\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a11571-1a58-7282-903b-860cd96057b2","create_time":1791375018.607229}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
