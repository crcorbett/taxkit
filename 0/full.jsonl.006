tools.boundary.ts:189:          Effect.catchTag(\\\"WebsiteBrowserToolRegistrationFailed\\\", (error) =>\\napps/web/src/lib/live.server.layer.ts:211:      Effect.catchTag(\\\"TaxKitWebConfigError\\\", (error) =>\\napps/web/src/lib/loaders.server.ts:88:      Effect.catchTag(\\\"DocsPageUnavailable\\\", () => Effect.die(missingPage)),\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a11571-1a58-7282-903b-860cd96057b2","create_time":1791374419.49221}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
