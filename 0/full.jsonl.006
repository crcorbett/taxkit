,\\n      \\\"default\\\": \\\"./dist/__testing__/observations.js\\\"\\n    }\\n  },\\n  \\\"publishConfig\\\": {\\n    \\\"exports\\\": {\\n      \\\"./schemas\\\": {\\n        \\\"types\\\": \\\"./dist/schemas.d.ts\\\",\\n        \\\"default\\\": \\\"./dist/schemas.js\\\"\\n      },\\n      \\\"./errors\\\": {\\n        \\\"types\\\": \\\"./dist/errors.d.ts\\\",\\n        \\\"default\\\": \\\"./dist/errors.js\\\"\\n      },\\n      \\\"./service\\\": {\\n        \\\"types\\\": \\\"./dist/service.d.ts\\\",\\n        \\\"default\\\": \\\"./dist/service.js\\\"\\n      },\\n      \\\"./live\\\": {\\n        \\\"types\\\": \\\"./dist/live.layer.d.ts\\\",\\n        \\\"default\\\": \\\"./dist/live.layer.js\\\"\\n      }\\n    }\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"rm -rf dist && tsc -p tsconfig.build.json\\\",\\n    \\\"check-types\\\": \\\"tsc --noEmit\\\",\\n    \\\"test\\\": \\\"vitest run\\\"\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"effect\\\": \\\"__EFFECT_VERSION__\\\"\\n  },\\n  \\\"devDependencies\\\": {\\n    \\\"@effect/vitest\\\": \\\"__EFFECT_VERSION__\\\",\\nrg: node_modules/@effect/platform-node-shared/src: IO error for operation on node_modules/@effect/platform-node-shared/src: No such file or directory (os error 2)\\n\"}"},{"type":"input_text","text":"{\"current_time\":\"2026-10-07 10:00:40 UTC\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a11571-1a58-7282-903b-860cd96057b2","create_time":1791367240.126536}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
