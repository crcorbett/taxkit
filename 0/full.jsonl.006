F-8 standalone=yes?><w:document xmlns:w=http://schemas.openxmlformats.org/wordprocessingml/2006/main><w:body><w:p><w:r><w:t>Evidence matrix browser template</w:t></w:r></w:p><w:sectPr/></w:body></w:document>'); const templateBytes = await template.generateAsync({ type: 'uint8array', compression: 'DEFLATE' }); const bundle = new JSZip(); bundle.file('scripts/generate.py', successScript); bundle.file('templates/evidence-matrix-template.docx', templateBytes); const bytes = await bundle.generateAsync({ type: 'uint8array', compression: 'DEFLATE' }); await writeFile('/private/tmp/mobius-evidence-matrix-browser-bundle.zip', bytes); console.log('/private/tmp/mobius-evidence-matrix-browser-bundle.zip', bytes.byteLength);"],["pnpm","--filter=@mobius/exports","exec","tsx","-e","import { evidenceMatrixInputDataStructureHash } from './src/document-generation/input-data.ts'; console.log(evidenceMatrixInputDataStructureHash());"],["pnpm","--filter=@mobius/exports","test:integration"],["pnpm","--filter=@tech-diagnostic/http-api","test"],["pnpm","--filter=admin","test","--","src/lib/components/configs/catalog-state.test.ts"],["pnpm","--filter=admin","test","--","src/lib/components/configs/document-generation-bundle.browser.test.tsx"],["pnpm","--filter=api","run","generate-token"],["pnpm","--filter=tech-diagnostic","dev:local"],["pnpm","build"],["pnpm","dev:admin:local"],["pnpm","dev:local"],["pnpm","dev:start:local"],["pnpm","exec","dotenvx"],["pnpm","exec","node"],["pnpm","exec","tsx"],["pnpm","exec","turbo","run","build"],["pnpm","exec","turbo","run","check-types"],["pnpm","exec","turbo","run","test"],["pnpm","exec","turbo","run","test","--filter=@frontend/clerk"],["pnpm","exec","vitest","run","--config","vitest.integration.config.ts","src/handlers/__tests__/configs.integration.test.ts","--silent=true"],["pnpm","install"],["pnpm","setup-environment"],["pnpm","test"],["pnpm","test:integration"],["pnpm","turbo","check-types","build"],["pnpm","vitest","run"],["portless","alias"],["po