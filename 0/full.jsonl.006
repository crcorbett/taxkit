lication\\\": \\\"web\\\",\\n          \\\"stage\\\": \\\"pr-179\\\",\\n          \\\"schema_version\\\": 1,\\n          \\\"page_path\\\": \\\"/\\\",\\n          \\\"source\\\": \\\"direct\\\",\\n          \\\"$process_person_profile\\\": false,\\n          \\\"$geoip_disable\\\": true\\n        }\\n      },\\n      \\\"cookies\\\": \\\"REDACTED\\\",\\n      \\\"localStorageLength\\\": 1,\\n      \\\"sessionStorageLength\\\": 0\\n    }\\n  },\\n  {\\n    \\\"mode\\\": \\\"signal-dnt-start\\\",\\n    \\\"outbound\\\": 0,\\n    \\\"paths\\\": [],\\n    \\\"pageErrors\\\": [],\\n    \\\"storage\\\": {\\n      \\\"closed\\\": true,\\n      \\\"before\\\": {\\n        \\\"capturing\\\": false,\\n        \\\"bot\\\": true,\\n        \\\"dnt\\\": \\\"1\\\",\\n        \\\"consent\\\": \\\"denied\\\"\\n      },\\n      \\\"loaded\\\": true,\\n      \\\"cookies\\\": \\\"REDACTED\\\",\\n      \\\"localStorageLength\\\": 1,\\n      \\\"sessionStorageLength\\\": 0\\n    }\\n  }\\n]\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"7205a3\",\"wall_time_seconds\":0.000006875,\"exit_code\":0,\"original_token_count\":2484,\"output\":\"from pathlib import Path\\nimport hashlib,json,re,datetime\\nh=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\\nresult_path=Path('/private/tmp/dev78-domain-whole-b-results.jsonl')\\nrows=[json.loads(x) for x in result_path.read_text().splitlines()]\\nassert [x['stage'] for x in rows]==['diff','release-graph'] and all(x['exitCode']==0 for x in rows), rows\\nfreeze=Path('/private/tmp/dev78-native-domains-freeze-a.json')\\nf=json.loads(freeze.read_text())\\nassert all(h(r['path'])==r['sha256'] for r in f['sources'])\\nlog=Path('/private/tmp/dev78-domain-whole-b-release-graph.log')\\ntext=log.read_text()\\nassert 'CI release graph passed 9 ordered checks' in text\\nchecks=[]\\nfor m in re.finditer(r'PASS \\\\[(?P<check>[^\\\\]]+)\\\\] target=(?P<label>.*?); stdout=(?P<out>\\\\S+) \\\\(sha256:(?P<outsha>[a-f0-9]{64})\\\\); stderr=(?P<err>\\\\S+) \\\\(sha256:(?P<errsha>[a-f0-9]{64})\\\\)',text):\\n artifacts=[]\\n for channel in ['out','err']:\\n  path=m[channel];p=Path(path); expected=m[channel+'sha']; assert h(p)==expected,(path,h(p),expected)\\n  content=p.read_text(errors='strict')\\n  artifacts.append({'channel':'stdout' if channel=='out' else 'stderr','path':path,'sha256':expected,'bytes':p.stat().st_size,'detailRead':True})\\n checks.append({'check':m['check'],'exitCode':0,'artifacts':artifacts})\\nassert len(checks)==9,checks\\nproof={'command':['bun','run','release:check','--','--ci'],'mode':'local execution of CI graph','exitCode':0,'durationSeconds':rows[-1]['durationSeconds'],'logSha256':h(log),'orderedChecks':checks,'detailArtifactCount':18,'allDetailDigestsVerified':True,'allDetailsRead':True,'frozenSourceCount':len(f['sources']),'sourceIdentitiesMatchedAfterChecks':True,'nonClaims':['hosted CI','provider plan','provider apply','deployment','publication','credential custody']}\\nreceipt=Path('docs/documentation-audit/clean-slate-foundation/2026-10-07-native-domains.json')\\ne=json.loads(receipt.read_text());e['observedAt']=datetime.datetime.now(datetime.timezone.utc).isoformat();e['fullLocalChecks']=proof;e['localCommandProbes']=json.loads(Path('/private/tmp/dev78-native-plan-cli/results.json').read_text());e['primaryReview']='Reviewed actual graph/provider/parser/runtime diff, supplied-identity limits, focused and nine-check local evidence, source identities, affected documentation owners and preservation requirements. Full T007 acceptance remains unfinished.'\\nreadme=Path('tools/docs-deployment/README.md');before=h(readme);s=readme.read_text()\\nchanges=[('Alchemy\\\\'s text plan output. It admits only the current native Website\\\\n  resource and fails closed on any other resource line.', 'Alchemy\\\\'s text plan output. Its retained version-two path admits only the\\\\n  retired `DocsWebsite` resource and rejects other resource lines. The\\\\n  replacement version-three path is described below.'),('remaining suites preserve their existing assertions under Vitest; their full\\\\nstrict migration is pending in DEV-73.', 'remaining suites preserve their existing assertions under Vitest. DEV-73\\\\nstrict enforcement is locally qualified; the active clean-slate plan owns its\\\\nexact evidence and remaining review.'),('regardless of ordering. Other policy/provider adapters remain pending strict work.', 'regardless of ordering. Strict-policy qualification and provider/runtime\\\\nbehaviour are separate claims; current native plan work is recorded below.'),('provider state. Provider inventory migration remains pending in DEV-73.', 'provider state. The retained provider inventory is historical; these local\\\\nchecks do not qualify a live inventory of the replacement app graph.'),('These tests make no current provider request. Other DEV-73 owners remain pending.', 'These tests make no current provider request. DEV-73 local qualification does\\\\nnot establish live provider state or complete the native T007 plan work.')]\\nfor old,new in changes:\\n assert s.count(old)==1,old;s=s.replace(old,new)\\nreadme.write_text(s)\\ne['postQualificationDocumentation']=[{'path':str(readme),'beforeSha256':before,'afterSha256':h(readme),'change':'Clarify retained v2 versus native v3 and replace stale DEV-73 planning claims with current bounded local qualification.','behaviourChanged':False,'checks':'pending focused documentation/path/runbook and diff checks'}]\\nreceipt.write_text(json.dumps(e,indent=2)+'\\\\n')\\nplan=Path('docs/exec-plans/active/clean-slate-foundation.md');s=plan.read_text()\\nold='exact-head hosted Quality is pending. Prompt modern remote cleanup and public setup remain unfinished.'\\nassert s.count(old)==1;s=s.replace(old,'exact-head hosted Quality `37574967845` passed at 05:29 UTC on 7 October. Prompt modern remote cleanup and public setup remain unfinished.')\\nold='Existing cf CLI profile independently reads the exact zone, DNS settings, DNSSEC and registrar. Production-only retained zone/domain declaration passes 34 focused infrastructure cases. Provider failure paths, current graph admission and complete qualification remain pending; no apply.'\\nassert s.count(old)==1;s=s.replace(old,'Existing cf CLI profile reads the exact zone and selected settings. Production-only retained graph, safe shared redirect read and native v3 projection passed 37 infrastructure and 42 plan/command cases, 621 policy cases and all nine local release checks. Real input calculation/writer, scoped Doppler custody and live no-apply plans remain unfinished; no apply.')\\ns+='\\\\n### T007 source-frozen local qualification\\\\n\\\\nThe 57 recorded source identities matched before and after the complete local\\\\n`bun run release:check -- --ci` execution. All nine ordered checks passed; all\\\\n18 sanitised detail artifacts were read and their digests independently matched.\\\\nBoth native application runs passed all 14 cases. The release-boundary mutation\\\\nsuite passed all 32 cases; its 13 real-command cases took about 10 minutes.\\\\nThese results qualify the local snapshot only, not hosted CI, credentials, a\\\\ncloud plan, provider adoption or public availability. Four actual local v3\\\\ncommand probes also passed their expected success/refusal outcomes with\\\\nsynthetic source identities and the real receiving patch digest.\\\\n\\\\nAfter full qualification, documentation-only corrections distinguish retained\\\\nv2 from native v3 and remove obsolete DEV-73 planning claims in the affected\\\\ntool README. The dated receipt retains before/after hashes and separate focused\\\\nchecks. Executable source remains identical to the fully checked snapshot.\\\\nNo new check framework, Changeset, credential, provider apply or deployment was\\\\nintroduced. A draft checkpoint does not complete T007: current writer/input\\\\ncalculation, real scoped Doppler custody and live no-apply plan proof remain.\\\\n'\\nplan.write_text(s)\\nprin