k_app_69a089a326dc8191b32a3f2553f5be2c","first_turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","server_name":"codex_apps","tool_name":"linear.get_project"},{"connector_id":"asdk_app_69a089a326dc8191b32a3f2553f5be2c","first_turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","server_name":"codex_apps","tool_name":"linear.save_comment"},{"first_turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","plugin_id":"codex-app-tools@openai-bundled","server_name":"codex_app","tool_name":"attach_artifact"},{"connector_id":"asdk_app_69a089a326dc8191b32a3f2553f5be2c","first_turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","server_name":"codex_apps","tool_name":"linear.save_status_update"},{"first_turn_id":"01a10e2a-6616-7a42-8b17-50e4af22487f","server_name":"executor-personal","tool_name":"skills"},{"first_turn_id":"01a10e2a-6616-7a42-8b17-50e4af22487f","server_name":"executor-personal","tool_name":"execute"}],"status":"complete"},"retained_source":{"complete":true,"id":{"message_id":"msg_01a10eaa-f994-7390-bfc4-e0aa97ccc7c9","role":"user","turn_id":"01a10e2a-6616-7a42-8b17-50e4af22487f"},"revision":"retained_01a10eaa-f994-7390-bfc4-e0c71863ea13"},"user_input_order":644},{"client_authored":false,"mcp_attribution":{"sources":[{"connector_id":"asdk_app_69a089a326dc8191b32a3f2553f5be2c","first_turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","server_name":"codex_apps","tool_name":"linear.get_issue"},{"connector_id":"asdk_app_69a089a326dc8191b32a3f2553f5be2c","first_turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","server_name":"codex_apps","tool_name":"linear.list_comments"},{"connector_id":"asdk_app_69a089a326dc8191b32a3f2553f5be2c","first_turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","server_name":"codex_apps","tool_name":"linear.get_workspace"},{"connector_id":"asdk_app_69a089a326dc8191b32a3f2553f5be2c","first_turn_id":"01a1055e-488d-75e2-ab79-097882eda37b","server_name":"codex_apps","tool_name":"linear.get_status_updates"},{"connector_id":"asdk_app_69a089a326dc8191b32a3f2553f5be2c","first