n              Match.when(\"absent\", () => ({\n                errors: [\n                  {\n                    code: 10_003,\n                    message:\n                      \"could not find entrypoint ruleset in the http_request_dynamic_redirect phase\",\n                  },\n                ],\n                result: null,\n                status: 404,\n              })),\n              Match.when(\"existing\", () =>\n                mockProviderSuccess({\n                  id: \"fixture-ruleset\",\n                  kind: \"zone\",\n                  name: \"zone entrypoint\",\n                  phase: \"http_request_dynamic_redirect\",\n                  rules: [foreign],\n                  version: \"1\",\n                })\n              ),\n              Match.exhaustive\n            )\n        ),\n        Match.when(\n          (v) =>\n            v.path.endsWith(\n              \"/rulesets/phases/http_request_dynamic_redirect/entrypoint\"\n","exit_code":0,"duration":{"secs":0,"nanos":7125},"formatted_output":"import { adopt } from \"alchemy/AdoptPolicy\";\nimport { ZoneDnsSettings } from \"alchemy/Cloudflare/DNS\";\nimport * as Website from \"alchemy/Cloudflare/Website\";\nimport { Worker } from \"alchemy/Cloudflare/Workers\";\nimport { Zone } from \"alchemy/Cloudflare/Zone\";\nimport * as Output from \"alchemy/Output\";\nimport { retain } from \"alchemy/RemovalPolicy\";\nimport { Stage } from \"alchemy/Stage\";\nimport type { CalculatorHostMode } from \"api/worker\";\nimport {\n  ApiWorkerNativeInit,\n  ApiWorkerObservability,\n  TaxKitApiWorker,\n} from \"api/worker\";\nimport { Context, Effect, Option } from \"effect\";\n\nimport { nativeAppsStage } from \"./apps-secrets.boundary.js\";\n\nexport const NativeAppsHostMode = Context.Reference<CalculatorHostMode>(\n  \"@taxkit/infrastructure/NativeAppsHostMode\",\n  { defaultValue: () => \"edge\" }\n);\n\nconst NativeProductionZone = Context.Reference<Option.Option<Zone>>(\n  \"@taxkit/infrastructure/NativeProductionZone\",\n  { defaultValue: Option.none }\n);\n\n// A forward API tag registers before its implementation Layer finishes. The\n// native planner retains both address Outputs, including the binding cycle.\nexport class TaxKitWebsite extends Website.Vite<TaxKitWebsite>()(\n  \"TaxKitWebsite\",\n  Effect.gen(function* () {\n    const api = yield* TaxKitApiWorker;\n    const apiOrigin = api.url.pipe(\n      Output.map((url) => Option.getOrNull(Option.fromNullishOr(url)))\n    );\n    return {\n      ...Option.match(yield* NativeProductionZone, {\n        onNone: () => ({}),\n        onSome: (zone) => ({\n          domain: {\n            name: \"taxkit.dev\",\n            redirects: [\"www.taxkit.dev\"],\n            zoneId: zone.zoneId,\n          },\n        }),\n      }),\n      compatibility: {\n        date: \"2026-10-04\",\n        flags: [\"nodejs_compat\"],\n      },\n      env: {\n        API_PUBLIC_ORIGIN: apiOrigin,\n        CALCULATOR_HOST_MODE: yield* NativeAppsHostMode,\n        TAXKIT_API: api,\n        WEBSITE_PUBLIC_ORIGIN: Worker.URL,\n      },\n      // The Website's platform records can include caller URLs independently\n      // of its fixed application reporter. Qualified exporters remain pending.\n      observability: {\n        enabled: false,\n        headSamplingRate: 0,\n        logs: {\n          enabled: false,\n          headSamplingRate: 0,\n          invocationLogs: false,\n          persist: false,\n        },\n        traces: { enabled: false, headSamplingRate: 0, persist: false },\n      },\n      rootDir: \"apps/web\",\n      workersDev: true,\n    };\n  })\n) {}\n\nconst NativeApiHostLive = TaxKitApiWorker.make(\n  Effect.gen(function* () {\n    const website = yield* TaxKitWebsite;\n    return {\n      ...Option.match(yield* NativeProductionZone, {\n        onNone: () => ({}),\n        onSome: (zone) => ({\n          domain: { name: \"api.taxkit.dev\", zoneId: zone.zoneId },\n        }),\n      }),\n      compatibility: {\n        date: \"2026-10-04\",\n        flags: [\"nodejs_compat\"],\n      },\n      env: {\n        API_PUBLIC_ORIGIN: Worker.URL,\n        CALCULATOR_HOST_MODE: yield* NativeAppsHostMode,\n        WEBSITE_PUBLIC_ORIGIN: website.url.pipe(\n          Output.map((url) => Option.getOrNull(Option.fromNullishOr(url)))\n        ),\n      },\n      // The app export owns its native entry; the graph crosses the workspace\n      // through that export rather than a relative filesystem import.\n      main: import.meta.resolve(\"api/worker\"),\n      observability: ApiWorkerObservability,\n      workersDev: true,\n    };\n  }),\n  ApiWorkerNativeInit\n);\n\nexport const declareNativeAppsStack = Effect.gen(function* () {\n  const stage = yield* nativeAppsStage(yield* Stage);\n  const zone =\n    stage === \"prod\"\n      ? Option.some(\n          yield* Zone(\"TaxKitProductionZone\", {\n            name: \"taxkit.dev\",\n            paused: false,\n            type: \"full\",\n          }).pipe(adopt(true), retain())\n        )\n      : Option.none<Zone>();\n  if (Option.isSome(zone)) {\n    // Preserve the DNS settings independently read on 7 October. This does\n    // not change DNSSEC, registrar, TLS, mail or verification records.\n    yield* ZoneDnsSettings(\"TaxKitProductionDnsSettings\", {\n      flattenAllCnames: false,\n      foundationDns: false,\n      multiProvider: false,\n      nameservers: { type: \"cloudflare.standard\" },\n      nsTtl: 86_400,\n      secondaryOverrides: false,\n      zoneId: zone.value.zoneId,\n      zoneMode: \"standard\",\n    }).pipe(retain());\n  }\n  return yield* Effect.gen(function* () {\n    const api = yield* TaxKitApiWorker;\n    const website = yield* TaxKitWebsite;\n    return { apiUrl: api.url, websiteUrl: website.url };\n  }).pipe(\n    Effect.provide(NativeApiHostLive),\n    Effect.provideService(NativeProductionZone, zone)\n  );\n});\nimport * as BunHttpServer from \"@effect/platform-bun/BunHttpServer\";\nimport { TaxKitServerLayer } from \"@taxkit/api-http/server\";\nimport { Effect, Layer } from \"effect\";\nimport * as HttpRouter from \"effect/http/HttpRouter\";\n\nimport { ApiServerConfig, ApiServerConfigLive } from \"./config.js\";\nimport { ApiContentLive } from \"./content.boundary.js\";\n\nconst BunHttpServerLive = Layer.unwrap(\n  ApiServerConfig.pipe(\n    Effect.map(({ address }) =>\n      BunHttpServer.layerServer({\n        hostname: address.hostname,\n        port: address.port,\n      })\n    )\n  )\n).pipe(Layer.provide(ApiServerConfigLive));\n\nconst ApiHttpServerLive = HttpRouter.serve(TaxKitServerLayer).pipe(\n  Layer.provide(ApiContentLive),\n  Layer.provide(BunHttpServerLive)\n);\n\nexport const ApiAppLayer = Layer.mergeAll(\n  ApiServerConfigLive,\n  ApiHttpServerLive\n);\n38:export class WorkerExecutionContext extends Context.Service<\n82:  waitUntil: <A, E, R>(effect: Effect.Effect<A, E, R>) =>\n131:  waitUntil: <A, E, R>(effect: Effect.Effect<A, E, R>) =>\n{\n  \"$schema\": \"./node_modules/knip/schema.json\",\n  \"ignoreWorkspaces\": [\"packages/tsconfig\"],\n  \"ignoreIssues\": {\n    \"packages/api/http/src/client/service.ts\": [\"duplicates\"],\n    \"packages/scripts/src/release-readiness/evidence.boundary.ts\": [\"exports\"]\n  },\n  \"workspaces\": {\n    \".\": {\n      \"entry\": [\n        \"alchemy.run.ts!\",\n        \"alchemy.apps.run.ts!\",\n        \"alchemy.apps.local.run.ts!\"\n      ],\n      \"project\": [\"alchemy.run.ts!\"]\n    },\n    \"apps/api\": {\n      \"entry\": [\"src/index.ts!\", \"src/worker.ts!\"],\n      \"project\": [\"src/**/*.ts!\"]\n    },\n    \"packages/api/http\": {\n      \"entry\": [\n        \"src/index.ts!\",\n        \"src/api.ts!\",\n        \"src/client/index.ts!\",\n        \"src/client/live.layer.ts!\",\n        \"src/client/server.layer.ts!\",\n        \"src/config.ts!\",\n        \"src/server.ts!\",\n        \"src/handlers/index.ts!\",\n        \"src/handlers/live.ts!\"\n      ],\n      \"project\": [\"src/**/*.ts!\"]\n    },\n    \"packages/calculators\": {\n      \"entry\": [\n        \"src/index.ts!\",\n        \"src/catalog.ts!\",\n        \"src/errors.ts!\",\n        \"src/metadata.ts!\",\n        \"src/service.ts!\",\n        \"src/live.layer.ts!\",\n        \"src/schemas.ts!\"\n      ],\n      \"project\": [\"src/**/*.ts!\"]\n    },\n    \"packages/core\": {\n      \"entry\": [\n        \"src/index.ts!\",\n        \"src/primitives/index.ts!\",\n        \"src/facts/index.ts!\",\n        \"src/parameters/index.ts!\",\n        \"src/errors/index.ts!\",\n        \"src/engine/index.ts!\",\n        \"src/rules/index.ts!\",\n        \"src/graph/index.ts!\",\n        \"src/trace/index.ts!\",\n        \"src/ledger/index.ts!\"\n      ],\n      \"project\": [\"src/**/*.ts!\"]\n    },\n    \"packages/docs-content\": {\n      \"entry\": [\n        \"source.config.ts!\",\n        \"src/client.ts!\",\n        \"src/errors.ts!\",\n        \"src/generated-source.layer.ts!\",\n        \"src/live.layer.ts!\",\n        \"src/schemas.ts!\",\n        \"src/server.ts!\",\n        \"src/service.ts!\",\n        \"src/validate.runtime.ts!\",\n        \"src/catalogue-index.runtime.ts!\",\n        \"src/catalogue-source.layer.ts!\"\n      ],\n      \"project\": [\n        \".source/browser.ts!\",\n        \".source/server.ts!\",\n        \"source.config.ts!\",\n        \"src/**/*.ts!\",\n        \"!src/**/*.test.ts!\",\n        \"!src/test.layer.ts!\"\n      ],\n      \"ignoreDependencies\": [\"vite/client\"]\n    },\n    \"packages/docs-fumadocs\": {\n      \"entry\": [\n        \"src/config.ts!\",\n        \"src/errors.ts!\",\n        \"src/live.layer.ts!\",\n        \"src/render/index.ts!\",\n        \"src/schemas.ts!\",\n        \"src/service.ts!\"\n      ],\n      \"project\": [\"src/**/*.ts!\", \"!src/**/*.test.ts!\", \"!src/test.layer.ts!\"]\n    },\n    \"packages/rules/au/income-tax\": {\n      \"entry\": [\n        \"src/index.ts!\",\n        \"src/facts/index.ts!\",\n        \"src/parameters/index.ts!\",\n        \"src/rules/index.ts!\",\n        \"src/rule-pack/index.ts!\",\n        \"src/calculator/index.ts!\"\n      ],\n      \"project\": [\"src/**/*.ts!\"]\n    },\n    \"packages/rules/au/pay\": {\n      \"entry\": [\n        \"src/index.ts!\",\n        \"src/facts/index.ts!\",\n        \"src/parameters/index.ts!\",\n        \"src/rules/index.ts!\",\n        \"src/calculator/index.ts!\",\n        \"src/rule-pack/index.ts!\"\n      ],\n      \"project\": [\"src/**/*.ts!\"]\n    },\n    \"packages/rules/au/stsl\": {\n      \"entry\": [\n        \"src/index.ts!\",\n        \"src/facts/index.ts!\",\n        \"src/parameters/index.ts!\",\n        \"src/rules/index.ts!\",\n        \"src/rule-pack/index.ts!\"\n      ],\n      \"project\": [\"src/**/*.ts!\"]\n    },\n    \"packages/scripts\": {\n      \"entry\": [\n        \"src/index.ts!\",\n        \"src/release-readiness/present.runtime.ts!\",\n        \"src/release-readiness/release-readiness.runtime.ts!\"\n      ],\n      \"project\": [\"src/**/*.ts!\", \"!src/release-readiness/test.layer.ts!\"]\nimport { BunServices } from \"@effect/platform-bun\";\nimport { describe, expect, it } from \"@effect/vitest\";\nimport { AlchemyContext } from \"alchemy/AlchemyContext\";\nimport {\n  ArtifactStore,\n  createArtifactStore,\n  scopedArtifacts,\n} from \"alchemy/Artifacts\";\nimport { AuthProviders } from \"alchemy/Auth/AuthProvider\";\nimport { CredentialsStore } from \"alchemy/Auth/Credentials\";\nimport { ProfileStore } from \"alchemy/Auth/Profile\";\nimport {\n  Providers,\n  Credentials,\n  CloudflareEnvironment,\n} from \"alchemy/Cloudflare\";\nimport { LiveWorkerProvider, Worker } from \"alchemy/Cloudflare/Workers\";\nimport { InstanceId } from \"alchemy/InstanceId\";\nimport { layerNonInteractive } from \"alchemy/Interaction\";\nimport * as Provider from \"alchemy/Provider\";\nimport * as Stack from \"alchemy/Stack\";\nimport { Stage } from \"alchemy/Stage\";\nimport { inMemoryState } from \"alchemy/State\";\nimport {\n  Array,\n  Cause,\n  Effect,\n  Exit,\n  FileSystem,\n  Layer,\n  Option,\n  Record,\n  Redacted,\n  Ref,\n  Match,\n  Predicate,\n  Schema,\n} from \"effect\";\nimport { HttpClient, HttpClientResponse } from \"effect/http\";\n\nconst account = \"00000000000000000000000000000078\";\nconst zone = \"00000000000000000000000000007800\";\nconst name = \"native-domain-provider-fixture\";\nconst foreign = {\n  action: \"redirect\",\n  action_parameters: {\n    from_value: {\n      preserve_query_string: true,\n      status_code: 301,\n      target_url: { value: \"https://other-target.example.com\" },\n    },\n  },\n  description: \"foreign-preserved-rule\",\n  enabled: true,\n  expression: 'http.host eq \"other.example.com\"',\n  id: \"foreign-rule-id\",\n  last_updated: \"2026-10-07T00:00:00Z\",\n  version: \"1\",\n};\nconst ProviderScenario = Schema.Literals([\"forbidden\", \"absent\", \"existing\"]);\nconst ProviderReply = Schema.fromJsonString(\n  Schema.Struct({\n    errors: Schema.Array(\n      Schema.Struct({ code: Schema.Int, message: Schema.String })\n    ),\n    messages: Schema.Array(Schema.String),\n    result: Schema.Unknown,\n    success: Schema.Boolean,\n  })\n);\nconst mockProviderSuccess = (result: typeof Schema.Unknown.Type) => ({\n  errors: [],\n  result,\n  status: 200,\n});\nconst providerFixture = Effect.fnUntraced(function* (\n  mode: typeof ProviderScenario.Type\n) {\n  const fs = yield* FileSystem.FileSystem;\n  const temp = yield* fs.makeTempDirectoryScoped({\n    prefix: \"taxkit-domain-provider-probe-\",\n  });\n  const main = `${temp}/fixture.mjs`;\n  yield* fs.writeFileString(\n    main,\n    'export default { fetch() { return new Response(\"fixture\") } };\\n'\n  );\n  const calls = yield* Ref.make<\n    readonly { method: string; path: string; body: string }[]\n  >([]);\n  const client = HttpClient.make((request) =>\n    Effect.gen(function* () {\n      const path = new URL(request.url).pathname;\n      const body = Match.value(request.body).pipe(\n        Match.tag(\"Uint8Array\", ({ body: bytes }) =>\n          new TextDecoder().decode(bytes)\n        ),\n        Match.orElse(({ _tag }) => _tag)\n      );\n      yield* Ref.update(calls, (x) =>\n        Array.append(x, { body, method: request.method, path })\n      );\n      const reply = Match.value({ method: request.method, path }).pipe(\n        Match.when(\n          (v) =>\n            v.path.endsWith(\n              \"/rulesets/phases/http_request_dynamic_redirect/entrypoint\"\n            ) && v.method === \"GET\",\n          () =>\n            Match.value(mode).pipe(\n              Match.when(\"forbidden\", () => ({\n                errors: [\n                  { code: 10_000, message: \"fixture authentication refused\" },\n                ],\n                result: null,\n                status: 403,\n              })),\n              Match.when(\"absent\", () => ({\n                errors: [\n                  {\n                    code: 10_003,\n                    message:\n                      \"could not find entrypoint ruleset in the http_request_dynamic_redirect phase\",\n                  },\n                ],\n                result: null,\n                status: 404,\n              })),\n              Match.when(\"existing\", () =>\n                mockProviderSuccess({\n                  id: \"fixture-ruleset\",\n                  kind: \"zone\",\n                  name: \"zone entrypoint\",\n                  phase: \"http_request_dynamic_redirect\",\n                  rules: [foreign],\n                  version: \"1\",\n                })\n              ),\n              Match.exhaustive\n            )\n        ),\n        Match.when(\n          (v) =>\n            v.path.endsWith(\n              \"/rulesets/phases/http_request_dynamic_redirect/entrypoint\"\n"},"started_at_ms":1791368820422,"completed_at_ms":1791368820422}}
{"timestamp":"2026-10-07T10:27:00.474Z","ordinal":68328,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a11571-1a58-7282-903b-860cd96057b2","item":{"type":"FileChange","id":"exec-1aa26a7f-2cda-48d5-863e-c7a6010f8d1e","changes":{"/Users/cooper/.codex/worktrees/aac7/taxkit/packages/analytics/README.md":{"type":"update","unified_diff":"@@ -1,5 +1,17 @@\n+---\n+document_type: package-readme\n+lifecycle: current\n+authority: canonical\n+owner: taxkit-analytics-owner\n+last_reviewed: 2026-10-07\n+review_trigger: analytics event, settings, service, export, transport or privacy change\n+---\n+\n # `@taxkit/analytics`\n \n-Effect service package with explicit contract, live, and deterministic test\n-boundaries.\n+Private compiled contracts for the accepted page visit and successful hosted\n+calculator events. The current backend Layer sends only the catalogue ID and\n+name, fixed application/stage labels, an event UUID and timestamp. It never\n+accepts tax inputs, results, browser identity, request URLs or request headers.\n+Tax rule packages and local SDK calculations do not depend on this package.\n \n@@ -9,2 +21,4 @@\n - `./errors`: public typed failures.\n+- `./config`: checked collection mode and capture settings. Off needs no token;\n+  invalid enabled settings fail with `AnalyticsConfigurationError`.\n - `./service`: public Effect service contract.\n@@ -15,8 +29,25 @@\n \n+The application supplies native `FetchHttpClient` and Effect `Crypto`. Each\n+backend send owns one scope and one five-second limit covering identity,\n+encoding, headers and the complete reply. Replies are limited to 64 KiB. A\n+request has one attempt, omits credentials, disables trace propagation and\n+refuses redirects. Disabled or denied collection makes no request and generates\n+no UUID. `accepted` means a successful HTTP response; stored provider events\n+require separate readback.\n+\n+The browser contract is shared so the Website adapter can keep its SDK private.\n+That adapter, the Website relay and the single API application event owner are\n+T008 work in progress. A test Layer is substitution proof, not SDK or browser\n+privacy proof.\n+\n ## Documentation impact\n \n-The package owns its semantic schemas and service contract. It does not own app\n-runtime execution, transport adapters, or provider runbooks. Update the nearest\n-repository architecture owner when a public schema or service operation changes;\n-update its proof/critical-journey owner when observable behavior changes.\n+Change required: this README, the repository\n+[package ownership](../../docs/architecture/package-ownership.md),\n+[Effect boundary owner](../../docs/architecture/effect-services.md) and\n+[active plan](../../docs/exec-plans/active/clean-slate-foundation.md) route these\n+contracts and pending application work. Preserve: tax Schemas, results, HTTP\n+and SDK contracts, public accepted documentation and the five existing runbook\n+procedures. This package is private and is not part of the published tax/SDK\n+closure, so its addition alone needs no Changeset.\n \n@@ -24,4 +55,8 @@\n \n-No operational runbook is required until this package acquires an external\n-system or consequential operation.\n+The [deployment runbook](../../docs/runbooks/docs-deployment.md) and\n+[recovery runbook](../../docs/runbooks/recovery.md) own later analytics resource\n+plans, authority, retained projects, recovery and readback. Tests use controlled\n+transports and synthetic capture tokens; they perform no provider operation.\n+Local and ordinary Preview collection must stay off. Production or a controlled\n+Preview requires checked settings and separately qualified app composition.\n \n@@ -29,3 +64,4 @@\n \n-These exports and tests do not prove app composition, transport behavior,\n-provider state, deployment, or a packed publisher artifact.\n+These package checks do not prove the real browser SDK, app composition,\n+provider project ownership, ingestion, deployment, release publication or\n+exactly-once storage. Shared Axiom metrics remain deferred by Cooper.\n","move_path":null},"/Users/cooper/.codex/worktrees/aac7/taxkit/docs/architecture/effect-services.md":{"type":"update","unified_diff":"@@ -19,2 +19,10 @@\n \n+The private [analytics package](../../packages/analytics/README.md) owns the\n+two accepted event contracts. Its native backend Layer encodes a fixed provider\n+request and maps transport failures to safe errors. The exact encoder admission\n+in `oxlint.config.ts` covers that provider egress and its safe error-byte test;\n+it does not admit runtime execution, raw JSON or decoding in neighbouring code.\n+The application owns when to capture and which checked collection policy applies.\n+T008 browser/application composition and provider readback remain pending.\n+\n ## Service shape\n","move_path":null},"/Users/cooper/.codex/worktrees/aac7/taxkit/docs/architecture/package-ownership.md":{"type":"update","unified_diff":"@@ -27,2 +27,3 @@\n - `packages/content`\n+- `packages/analytics`\n - `packages/docs-content`\n@@ -187,2 +188,12 @@\n \n+`packages/analytics`\n+: Private compiled owner of checked page/calculator events, collection policy,\n+  settings, safe errors and named browser/backend service contracts. Its native\n+  backend capture Layer has one bounded HTTP attempt. The application owns\n+  execution, best-effort delivery and successful-use placement; the Website\n+  owns its private browser SDK and relay; infrastructure owns retained provider\n+  projects. Calculators, rules and the local SDK have no analytics dependency.\n+  T008 application and provider qualification remain in progress; package tests\n+  alone do not prove browser privacy or ingestion.\n+\n `packages/docs-content`\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /Users/cooper/.codex/worktrees/aac7/taxkit/packages/analytics/README.md\nM /Users/cooper/.codex/worktrees/aac7/taxkit/docs/architecture/package-ownership.md\nM /Users/cooper/.codex/worktrees/aac7/taxkit/docs/architecture/effect-services.md\n","stderr":""},"started_at_ms":1791368820473,"completed_at_ms":1791368820474}}
{"timestamp":"2026-10-07T10:27:00.522Z","ordinal":68329,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a115e6-f72a-7611-8fba-f903aa2bfef8","call_id":"call_41ab9ef5270a49b0adbb35a249185907","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"be4ba2\",\"wall_time_seconds\":0.000007125,\"exit_code\":0,\"original_token_count\":3484,\"output\":\"import { adopt } from \\\"alchemy/AdoptPolicy\\\";\\nimport { ZoneDnsSettings } from \\\"alchemy/Cloudflare/DNS\\\";\\nimport * as Website from \\\"alchemy/Cloudflare/Website\\\";\\nimport { Worker } from \\\"alchemy/Cloudflare/Workers\\\";\\nimport { Zone } from \\\"alchemy/Cloudflare/Zone\\\";\\nimport * as Output from \\\"alchemy/Output\\\";\\nimport { retain } from \\\"alchemy/RemovalPolicy\\\";\\nimport { Stage } from \\\"alchemy/Stage\\\";\\nimport type { CalculatorHostMode } from \\\"api/worker\\\";\\nimport {\\n  ApiWorkerNativeInit,\\n  ApiWorkerObservability,\\n  TaxKitApiWorker,\\n} from \\\"api/worker\\\";\\nimport { Context, Effect, Option } from \\\"effect\\\";\\n\\nimport { nativeAppsStage } from \\\"./apps-secrets.boundary.js\\\";\\n\\nexport const NativeAppsHostMode = Context.Reference<CalculatorHostMode>(\\n  \\\"@taxkit/infrastructure/NativeAppsHostMode\\\",\\n  { defaultValue: () => \\\"edge\\\" }\\n);\\n\\nconst NativeProductionZone = Context.Reference<Option.Option<Zone>>(\\n  \\\"@taxkit/infrastructure/NativeProductionZone\\\",\\n  { defaultValue: Option.none }\\n);\\n\\n// A forward API tag registers before its implementation Layer finishes. The\\n// native planner retains both address Outputs, including the binding cycle.\\nexport class TaxKitWebsite extends Website.Vite<TaxKitWebsite>()(\\n  \\\"TaxKitWebsite\\\",\\n  Effect.gen(function* () {\\n    const api = yield* TaxKitApiWorker;\\n    const apiOrigin = api.url.pipe(\\n      Output.map((url) => Option.getOrNull(Option.fromNullishOr(url)))\\n    );\\n    return {\\n      ...Option.match(yield* NativeProductionZone, {\\n        onNone: () => ({}),\\n        onSome: (zone) => ({\\n          domain: {\\n            name: \\\"taxkit.dev\\\",\\n            redirects: [\\\"www.taxkit.dev\\\"],\\n            zoneId: zone.zoneId,\\n          },\\n        }),\\n      }),\\n      compatibility: {\\n        date: \\\"2026-10-04\\\",\\n        flags: [\\\"nodejs_compat\\\"],\\n      },\\n      env: {\\n        API_PUBLIC_ORIGIN: apiOrigin,\\n        CALCULATOR_HOST_MODE: yield* NativeAppsHostMode,\\n        TAXKIT_API: api,\\n        WEBSITE_PUBLIC_ORIGIN: Worker.URL,\\n      },\\n      // The Website's platform records can include caller URLs independently\\n      // of its fixed application reporter. Qualified exporters remain pending.\\n      observability: {\\n        enabled: false,\\n        headSamplingRate: 0,\\n        logs: {\\n          enabled: false,\\n          headSamplingRate: 0,\\n          invocationLogs: false,\\n          persist: false,\\n        },\\n        traces: { enabled: false, headSamplingRate: 0, persist: false },\\n      },\\n      rootDir: \\\"apps/web\\\",\\n      workersDev: true,\\n    };\\n  })\\n) {}\\n\\nconst NativeApiHostLive = TaxKitApiWorker.make(\\n  Effect.gen(function* () {\\n    const website = yield* TaxKitWebsite;\\n    return {\\n      ...Option.match(yield* NativeProductionZone, {\\n        onNone: () => ({}),\\n        onSome: (zone) => ({\\n          domain: { name: \\\"api.taxkit.dev\\\", zoneId: zone.zoneId },\\n        }),\\n      }),\\n      compatibility: {\\n        date: \\\"2026-10-04\\\",\\n        flags: [\\\"nodejs_compat\\\"],\\n      },\\n      env: {\\n        API_PUBLIC_ORIGIN: Worker.URL,\\n        CALCULATOR_HOST_MODE: yield* NativeAppsHostMode,\\n        WEBSITE_PUBLIC_ORIGIN: website.url.pipe(\\n          Output.map((url) => Option.getOrNull(Option.fromNullishOr(url)))\\n        ),\\n      },\\n      // The app export owns its native entry; the graph crosses the workspace\\n      // through that export rather than a relative filesystem import.\\n      main: import.meta.resolve(\\\"api/worker\\\"),\\n      observability: ApiWorkerObservability,\\n      workersDev: true,\\n    };\\n  }),\\n  ApiWorkerNativeInit\\n);\\n\\nexport const declareNativeAppsStack = Effect.gen(function* () {\\n  const stage = yield* nativeAppsStage(yield* Stage);\\n  const zone =\\n    stage === \\\"prod\\\"\\n      ? Option.some(\\n          yield* Zone(\\\"TaxKitProductionZone\\\", {\\n            name: \\\"taxkit.dev\\\",\\n            paused: false,\\n            type: \\\"full\\\",\\n          }).pipe(adopt(true), retain())\\n        )\\n      : Option.none<Zone>();\\n  if (Option.isSome(zone)) {\\n    // Preserve the DNS settings independently read on 7 October. This does\\n    // not change DNSSEC, registrar, TLS, mail or verification records.\\n    yield* ZoneDnsSettings(\\\"TaxKitProductionDnsSettings\\\", {\\n      flattenAllCnames: false,\\n      foundationDns: false,\\n      multiProvider: false,\\n      nameservers: { type: \\\"cloudflare.standard\\\" },\\n      nsTtl: 86_400,\\n      secondaryOverrides: false,\\n      zoneId: zone.value.zoneId,\\n      zoneMode: \\\"standard\\\",\\n    }).pipe(retain());\\n  }\\n  return yield* Effect.gen(function* () {\\n    const api = yield* TaxKitApiWorker;\\n    const website = yield* TaxKitWebsite;\\n    return { apiUrl: api.url, websiteUrl: website.url };\\n  }).pipe(\\n    Effect.provide(NativeApiHostLive),\\n    Effect.provideService(NativeProductionZone, zone)\\n  );\\n});\\nimport * as BunHttpServer from \\\"@effect/platform-bun/BunHttpServer\\\";\\nimport { TaxKitServerLayer } from \\\"@taxkit/api-http/server\\\";\\nimport { Effect, Layer } from \\\"effect\\\";\\nimport * as HttpRouter from \\\"effect/http/HttpRouter\\\";\\n\\nimport { ApiServerConfig, ApiServerConfigLive } from \\\"./config.js\\\";\\nimport { ApiContentLive } from \\\"./content.boundary.js\\\";\\n\\nconst BunHttpServerLive = Layer.unwrap(\\n  ApiServerConfig.pipe(\\n    Effect.map(({ address }) =>\\n      BunHttpServer.layerServer({\\n        hostname: address.hostname,\\n        port: address.port,\\n      })\\n    )\\n  )\\n).pipe(Layer.provide(ApiServerConfigLive));\\n\\nconst ApiHttpServerLive = HttpRouter.serve(TaxKitServerLayer).pipe(\\n  Layer.provide(ApiContentLive),\\n  Layer.provide(BunHttpServerLive)\\n);\\n\\nexport const ApiAppLayer = Layer.mergeAll(\\n  ApiServerConfigLive,\\n  ApiHttpServerLive\\n);\\n38:export class WorkerExecutionContext extends Context.Service<\\n82:  waitUntil: <A, E, R>(effect: Effect.Effect<A, E, R>) =>\\n131:  waitUntil: <A, E, R>(effect: Effect.Effect<A, E, R>) =>\\n{\\n  \\\"$schema\\\": \\\"./node_modules/knip/schema.json\\\",\\n  \\\"ignoreWorkspaces\\\": [\\\"packages/tsconfig\\\"],\\n  \\\"ignoreIssues\\\": {\\n    \\\"packages/api/http/src/client/service.ts\\\": [\\\"duplicates\\\"],\\n    \\\"packages/scripts/src/release-readiness/evidence.boundary.ts\\\": [\\\"exports\\\"]\\n  },\\n  \\\"workspaces\\\": {\\n    \\\".\\\": {\\n      \\\"entry\\\": [\\n        \\\"alchemy.run.ts!\\\",\\n        \\\"alchemy.apps.run.ts!\\\",\\n        \\\"alchemy.apps.local.run.ts!\\\"\\n      ],\\n      \\\"project\\\": [\\\"alchemy.run.ts!\\\"]\\n    },\\n    \\\"apps/api\\\": {\\n      \\\"entry\\\": [\\\"src/index.ts!\\\", \\\"src/worker.ts!\\\"],\\n      \\\"project\\\": [\\\"src/**/*.ts!\\\"]\\n    },\\n    \\\"packages/api/http\\\": {\\n      \\\"entry\\\": [\\n        \\\"src/index.ts!\\\",\\n        \\\"src/api.ts!\\\",\\n        \\\"src/client/index.ts!\\\",\\n        \\\"src/client/live.layer.ts!\\\",\\n        \\\"src/client/server.layer.ts!\\\",\\n        \\\"src/config.ts!\\\",\\n        \\\"src/server.ts!\\\",\\n        \\\"src/handlers/index.ts!\\\",\\n        \\\"src/handlers/live.ts!\\\"\\n      ],\\n      \\\"project\\\": [\\\"src/**/*.ts!\\\"]\\n    },\\n    \\\"packages/calculators\\\": {\\n      \\\"entry\\\": [\\n        \\\"src/index.ts!\\\",\\n        \\\"src/catalog.ts!\\\",\\n        \\\"src/errors.ts!\\\",\\n        \\\"src/metadata.ts!\\\",\\n        \\\"src/service.ts!\\\",\\n        \\\"src/live.layer.ts!\\\",\\n        \\\"src/schemas.ts!\\\"\\n      ],\\n      \\\"project\\\": [\\\"src/**/*.ts!\\\"]\\n    },\\n    \\\"packages/core\\\": {\\n      \\\"entry\\\": [\\n        \\\"src/index.ts!\\\",\\n        \\\"src/primitives/index.ts!\\\",\\n        \\\"src/facts/index.ts!\\\",\\n        \\\"src/parameters/index.ts!\\\",\\n        \\\"src/errors/index.ts!\\\",\\n        \\\"src/engine/index.ts!\\\",\\n        \\\"src/rules/index.ts!\\\",\\n        \\\"src/graph/index.ts!\\\",\\n        \\\"src/trace/index.ts!\\\",\\n        \\\"src/ledger/index.ts!\\\"\\n      ],\\n      \\\"project\\\": [\\\"src/**/*.ts!\\\"]\\n    },\\n    \\\"packages/docs-content\\\": {\\n      \\\"entry\\\": [\\n        \\\"source.config.ts!\\\",\\n        \\\"src/client.ts!\\\",\\n        \\\"src/errors.ts!\\\",\\n        \\\"src/generated-source.layer.ts!\\\",\\n        \\\"src/live.layer.ts!\\\",\\n        \\\"src/schemas.ts!\\\",\\n        \\\"src/server.ts!\\\",\\n        \\\"src/service.ts!\\\",\\n        \\\"src/validate.runtime.ts!\\\",\\n        \\\"src/catalogue-index.runtime.ts!\\\",\\n        \\\"src/catalogue-source.layer.ts!\\\"\\n      ],\\n      \\\"project\\\": [\\n        \\\".source/browser.ts!\\\",\\n        \\\".source/server.ts!\\\",\\n        \\\"source.config.ts!\\\",\\n        \\\"src/**/*.ts!\\\",\\n        \\\"!src/**/*.test.ts!\\\",\\n        \\\"!src/test.layer.ts!\\\"\\n      ],\\n      \\\"ignoreDependencies\\\": [\\\"vite/client\\\"]\\n    },\\n    \\\"packages/docs-fumadocs\\\": {\\n      \\\"entry\\\": [\\n        \\\"src/config.ts!\\\",\\n        \\\"src/errors.ts!\\\",\\n        \\\"src/live.layer.ts!\\\",\\n        \\\"src/render/index.ts!\\\",\\n        \\\"src/schemas.ts!\\\",\\n        \\\"src/service.ts!\\\"\\n      ],\\n      \\\"project\\\": [\\\"src/**/*.ts!\\\", \\\"!src/**/*.test.ts!\\\", \\\"!src/test.layer.ts!\\\"]\\n    },\\n    \\\"packages/rules/au/income-tax\\\": {\\n      \\\"entry\\\": [\\n        \\\"src/index.ts!\\\",\\n        \\\"src/facts/index.ts!\\\",\\n        \\\"src/parameters/index.ts!\\\",\\n        \\\"src/rules/index.ts!\\\",\\n        \\\"src/rule-pack/index.ts!\\\",\\n        \\\"src/calculator/index.ts!\\\"\\n      ],\\n      \\\"project\\\": [\\\"src/**/*.ts!\\\"]\\n    },\\n    \\\"packages/rules/au/pay\\\": {\\n      \\\"entry\\\": [\\n        \\\"src/index.ts!\\\",\\n        \\\"src/facts/index.ts!\\\",\\n        \\\"src/parameters/index.ts!\\\",\\n        \\\"src/rules/index.ts!\\\",\\n        \\\"src/calculator/index.ts!\\\",\\n        \\\"src/rule-pack/index.ts!\\\"\\n      ],\\n      \\\"project\\\": [\\\"src/**/*.ts!\\\"]\\n    },\\n    \\\"packages/rules/au/stsl\\\": {\\n      \\\"entry\\\": [\\n        \\\"src/index.ts!\\\",\\n        \\\"src/facts/index.ts!\\\",\\n        \\\"src/parameters/index.ts!\\\",\\n        \\\"src/rules/index.ts!\\\",\\n        \\\"src/rule-pack/index.ts!\\\"\\n      ],\\n      \\\"project\\\": [\\\"src/**/*.ts!\\\"]\\n    },\\n    \\\"packages/scripts\\\": {\\n      \\\"entry\\\": [\\n        \\\"src/index.ts!\\\",\\n        \\\"src/release-readiness/present.runtime.ts!\\\",\\n        \\\"src/release-readiness/release-readiness.runtime.ts!\\\"\\n      ],\\n      \\\"project\\\": [\\\"src/**/*.ts!\\\", \\\"!src/release-readiness/test.layer.ts!\\\"]\\nimport { BunServices } from \\\"@effect/platform-bun\\\";\\nimport { describe, expect, it } from \\\"@effect/vitest\\\";\\nimport { AlchemyContext } from \\\"alchemy/AlchemyContext\\\";\\nimport {\\n  ArtifactStore,\\n  createArtifactStore,\\n  scopedArtifacts,\\n} from \\\"alchemy/Artifacts\\\";\\nimport { AuthProviders } from \\\"alchemy/Auth/AuthProvider\\\";\\nimport { CredentialsStore } from \\\"alchemy/Auth/Credentials\\\";\\nimport { ProfileStore } from \\\"alchemy/Auth/Profile\\\";\\nimport {\\n  Providers,\\n  Credentials,\\n  CloudflareEnvironment,\\n} from \\\"alchemy/Cloudflare\\\";\\nimport { LiveWorkerProvider, Worker } from \\\"alchemy/Cloudflare/Workers\\\";\\nimport { InstanceId } from \\\"alchemy/InstanceId\\\";\\nimport { layerNonInteractive } from \\\"alchemy/Interaction\\\";\\nimport * as Provider from \\\"alchemy/Provider\\\";\\nimport * as Stack from \\\"alchemy/Stack\\\";\\nimport { Stage } from \\\"alchemy/Stage\\\";\\nimport { inMemoryState } from \\\"alchemy/State\\\";\\nimport {\\n  Array,\\n  Cause,\\n  Effect,\\n  Exit,\\n  FileSystem,\\n  Layer,\\n  Option,\\n  Record,\\n  Redacted,\\n  Ref,\\n  Match,\\n  Predicate,\\n  Schema,\\n} from \\\"effect\\\";\\nimport { HttpClient, HttpClientResponse } from \\\"effect/http\\\";\\n\\nconst account = \\\"00000000000000000000000000000078\\\";\\nconst zone = \\\"00000000000000000000000000007800\\\";\\nconst name = \\\"native-domain-provider-fixture\\\";\\nconst foreign = {\\n  action: \\\"redirect\\\",\\n  action_parameters: {\\n    from_value: {\\n      preserve_query_string: true,\\n      status_code: 301,\\n      target_url: { value: \\\"https://other-target.example.com\\\" },\\n    },\\n  },\\n  description: \\\"foreign-preserved-rule\\\",\\n  enabled: true,\\n  expression: 'http.host eq \\\"other.example.com\\\"',\\n  id: \\\"foreign-rule-id\\\",\\n  last_updated: \\\"2026-10-07T00:00:00Z\\\",\\n  version: \\\"1\\\",\\n};\\nconst ProviderScenario = Schema.Literals([\\\"forbidden\\\", \\\"absent\\\", \\\"existing\\\"]);\\nconst ProviderReply = Schema.fromJsonString(\\n  Schema.Struct({\\n    errors: Schema.Array(\\n      Schema.Struct({ code: Schema.Int, message: Schema.String })\\n    ),\\n    messages: Schema.Array(Schema.String),\\n    result: Schema.Unknown,\\n    success: Schema.Boolean,\\n  })\\n);\\nconst mockProviderSuccess = (result: typeof Schema.Unknown.Type) => ({\\n  errors: [],\\n  result,\\n  status: 200,\\n});\\nconst providerFixture = Effect.fnUntraced(function* (\\n  mode: typeof ProviderScenario.Type\\n) {\\n  const fs = yield* FileSystem.FileSystem;\\n  const temp = yield* fs.makeTempDirectoryScoped({\\n    prefix: \\\"taxkit-domain-provider-probe-\\\",\\n  });\\n  const main = `${temp}/fixture.mjs`;\\n  yield* fs.writeFileString(\\n    main,\\n    'export default { fetch() { return new Response(\\\"fixture\\\") } };\\\\n'\\n  );\\n  const calls = yield* Ref.make<\\n    readonly { method: string; path: string; body: string }[]\\n  >([]);\\n  const client = HttpClient.make((request) =>\\n    Effect.gen(function* () {\\n      const path = new URL(request.url).pathname;\\n      const body = Match.value(request.body).pipe(\\n        Match.tag(\\\"Uint8Array\\\", ({ body: bytes }) =>\\n          new TextDecoder().decode(bytes)\\n        ),\\n        Match.orElse(({ _tag }) => _tag)\\n      );\\n      yield* Ref.update(calls, (x) =>\\n        Array.append(x, { body, method: request.method, path })\\n      );\\n      const reply = Match.value({ method: request.method, path }).pipe(\\n        Match.when(\\n          (v) =>\\n            v.path.endsWith(\\n              \\\"/rulesets/phases/http_request_dynamic_redirect/entrypoint\\\"\\n            ) && v.method === \\\"GET\\\",\\n          () =>\\n            Match.value(mode).pipe(\\n              Match.when(\\\"forbidden\\\", () => ({\\n                errors: [\\n                  { code: 10_000, message: \\\"fixture authentication refused\\\" },\\n                ],\\n                result: null,\\n                status: 403,\\n              })),\\n              Match.when(\\\"absent\\\", () => ({\\n                errors: [\\n                  {\\n                    code: 10_003,\\n                    message:\\n                      \\\"could not find entrypoint ruleset in the http_request_dynamic_redirect phase\\\",\\n                  },\\n                ],\\n                result: null,\\n                status: 404,\\n              })),\\n              Match.when(\\\"existing\\\", () =>\\n                mockProviderSuccess({\\n                  id: \\\"fixture-ruleset\\\",\\n                  kind: \\\"zone\\\",\\n                  name: \\\"zone entrypoint\\\",\\n                  phase: \\\"http_request_dynamic_redirect\\\",\\n                  rules: [foreign],\\n                  version: \\\"1\\\",\\n                })\\n              ),\\n              Match.exhaustive\\n            )\\n        ),\\n        Match.when(\\n          (v) =>\\n            v.path.endsWith(\\n              \\\"/rulesets/phases/http_request_dynamic_redirect/entrypoint\\\"\\n\"}"},{"type":"input_text","text":"{}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a11571-1a58-7282-903b-860cd96057b2","create_time":1791368820.522066}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
