      Schema.decodeUnknownEffect(\n                              Schema.instanceOf(Response)\n                            )\n                          ),\n                          Effect.map((response) =>\n                            HttpClientResponse.fromWeb(request, response)\n                          ),\n                          Effect.mapError(\n                            () =>\n                              new HttpClientError.HttpClientError({\n                                reason: new HttpClientError.TransportError({\n                                  cause: new CalculatorAdmissionUnavailable(),\n                                  request,\n                                }),\n                              })\n                          )\n                        ),\n                    })\n                  )\n                )\n              )\n            )\n          );\n          return Layer.effect(\n            WebsiteServerApplication,\n            Effect.gen(function* () {\n              const client = yield* TaxKitRpcClient;\n              const docs = yield* DocsRpcClient;\n              return WebsiteServerApplication.of({\n                calculate: (request) =>\n                  CalculatorRequestRateKey.pipe(\n                    Effect.flatMap(\n                      Option.match({\n                        onNone: () =>\n                          Option.match(localKey, {\n                            onNone: () =>\n                              Effect.fail(new CalculatorAdmissionUnavailable()),\n                            onSome: (key) =>\n                              client\n                                .calculate(request)\n                                .pipe(\n                                  Effect.provideService(\n                                    CalculatorRequestRateKey,\n                                    Option.some(key)\n                                  )\n                                ),\n                          }),\n                        onSome: () => client.calculate(request),\n                      })\n                    )\n                  ),\n                catalogue: client.listCalculators(MetadataQuery.make({})),\n                docsDiscovery: docs.getDiscovery,\n                docsMarkdown: docs.getMarkdown,\n                docsNavigation: docs.getNavigation(),\n                docsPage: docs.getPage,\n                searchDocs: docs.searchPages,\n                settings: Effect.succeed(\nnode_modules/alchemy/src/Cloudflare/D1/Database.ts:336:                (db): db is (typeof page.result)[number] & { uuid: string } =>\nnode_modules/alchemy/src/Cloudflare/D1/Database.ts:337:                  db.uuid != null,\nnode_modules/alchemy/src/Cloudflare/D1/Database.ts:340:                databaseId: db.uuid,\nnode_modules/alchemy/src/Cloudflare/D1/Database.ts:341:                databaseName: db.name ?? db.uuid,\nnode_modules/alchemy/src/Cloudflare/D1/Database.ts:364:              databaseId: db.uuid ?? output.databaseId,\nnode_modules/alchemy/src/Cloudflare/D1/Database.ts:390:          databaseId: match.uuid!,\nnode_modules/alchemy/src/Cloudflare/D1/Database.ts:415:            uuid?: string | null;\nnode_modules/alchemy/src/Cloudflare/D1/Database.ts:476:        databaseId = db.uuid!;\nnode_modules/alchemy/src/Cloudflare/D1/Database.ts:479:        databaseId = observed.uuid ?? output!.databaseId;\nnode_modules/alchemy/src/Cloudflare/D1/Database.ts:499:        databaseId = updated.uuid ?? databaseId;\nnode_modules/alchemy/src/Cloudflare/D1/Database.ts:741:      if (!match?.uuid) {\nnode_modules/alchemy/src/Cloudflare/D1/Database.ts:746:      return match.uuid;\nnode_modules/alchemy/src/Cloudflare/Access/Context.ts:3:import type { WorkerExecutionContextAccess } from \"../Workers/WorkerAccess.ts\";\nnode_modules/alchemy/src/Cloudflare/Access/Context.ts:4:import { WorkerExecutionContext } from \"../Workers/Worker.ts\";\nnode_modules/alchemy/src/Cloudflare/Access/Contex