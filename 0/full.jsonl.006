.properties.pageCount);\\n      }\\n      if (value.event === \\\"common_practice_course_progress_reset\\\") {\\n        return value.properties.completedPageCount === 0;\\n      }\\n      return true;\\n    }),\\n  ),\\n  Schema.Struct({\\n    ...envelope,\\n    event: Schema.Literal(\\\"common_practice_page_completion_changed\\\"),\\n    properties: Schema.Struct({ ...properties, ...CompletionLearningFields }).check(\\n      pageCompletionCountCheck,\\n    ),\\n  }),\\n]);\\n\\n// The SDK requires a synchronous nullable callback. This exact consumer uses a\\n// non-throwing Schema decoder and copies only our allowlist. Extra SDK fields,\\n// full URLs, page text, session IDs and person properties cannot leave this callback.\\nexport const sanitiseBrowserCapture = (input: CaptureResult | null): CaptureResult | null =>\\n  Schema.decodeUnknownOption(BrowserCapture)(input).pipe(\\n    Option.match({\\n      onNone: () => null,\\n      onSome: (value) => value,\\n    }),\\n  );\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a11571-1a58-7282-903b-860cd96057b2","create_time":1791369428.416385}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
