ts\": \"off\",\n1396:    \"anti-slop/no-runtime-typeof\": \"error\",\n  calculator: CalculatorCatalogItem,\n  diagnostics: CalculationDiagnostics,\n  report: CalculatorRunReport,\n});\n\nexport type CalculatorRunResponse = typeof CalculatorRunResponse.Type;\n\nexport class CalculatorCatalogResponseData extends Data.Class<CalculatorCatalogResponse> {}\n\nexport class CalculatorRunResponseData extends Data.Class<CalculatorRunResponse> {}\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunFacts`.\n */\nexport const PublicCalculationFacts = CalculatorRunFacts.annotate({\n  title: \"PublicCalculationFacts\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunFacts`.\n */\nexport type PublicCalculationFacts = CalculatorRunFacts;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunRequest`.\n */\nexport const PublicCalculationRequest = CalculatorRunRequest.annotate({\n  title: \"PublicCalculationRequest\",\n});\n","exit_code":0,"duration":{"secs":0,"nanos":7334},"formatted_output":" * Effect-native view of the Workers Cache runtime API on the execution\n * context (`ctx.cache`). Only available when the Worker has Workers Cache\n * enabled (the `cache` prop or `yield* Cloudflare.cache()`).\n */\nexport interface WorkerExecutionContextCache {\n  /**\n   * Purge cached responses by `Cache-Tag`, path prefix, or everything.\n   */\n  purge(\n    options: cf.CachePurgeOptions,\n  ): Effect.Effect<cf.CachePurgeResult, CachePurgeError, RuntimeContext>;\n}\n\nexport class WorkerExecutionContext extends Context.Service<\n  WorkerExecutionContext,\n  {\n    /**\n     * Run an Effect in the background without blocking the response, keeping\n     * the Worker alive until it settles. The Effect runs with the caller's\n     * full context (services, tracing), and the resulting promise is\n     * registered with workerd's `ctx.waitUntil`.\n     */\n    waitUntil<A, E, R>(\n      effect: Effect.Effect<A, E, R>,\n    ): Effect.Effect<void, never, R | RuntimeContext>;\n    /**\n     * Forward the request to the origin if the Worker throws an unhandled\n     * exception, instead of returning an error page.\n     */\n    passThroughOnException(): Effect.Effect<void, never, RuntimeContext>;\n    /**\n     * The Workers Cache runtime API (`ctx.cache`).\n     */\n    readonly cache: WorkerExecutionContextCache;\n    /**\n     * The Cloudflare Access context for the current request (`ctx.access`),\n     * or `undefined` when the request did not pass through Access. Under\n     * `alchemy dev` the Worker's `dev.access` config simulates it.\n     */\n    readonly access: Effect.Effect<\n      WorkerExecutionContextAccess | undefined,\n      never,\n      RuntimeContext\n    >;\n    /**\n     * The raw workerd ExecutionContext, for interop with async APIs.\n     */\n    readonly raw: cf.ExecutionContext;\n  }\n>()(\"Cloudflare.Workers.WorkerExecutionContext\") {}\n\nexport const fromExecutionContext = (\n  ctx: cf.ExecutionContext,\n  env?: Record<string, unknown>,\n): WorkerExecutionContext[\"Service\"] => ({\n  raw: ctx,\n  access: Effect.sync(() => resolveAccessContext(ctx, env)),\n  waitUntil: <A, E, R>(effect: Effect.Effect<A, E, R>) =>\n    Effect.gen(function* () {\n      const context = yield* Effect.context<R>();\n      // Register the promise with workerd un-awaited — waitUntil extends the\n      // invocation's lifetime without blocking the response.\n      yield* Effect.sync(() =>\n        ctx.waitUntil(Effect.runPromise(effect.pipe(Effect.provide(context)))),\n      );\n    }),\n  passThroughOnException: () => Effect.sync(() => ctx.passThroughOnException()),\n  cache: {\n    purge: (options) =>\n      ctx.cache\n        ? Effect.tryPromise({\n            try: () => ctx.cache!.purge(options),\n            catch: (cause) =>\n              new CachePurgeError({\n                message:\n                  cause instanceof Error\n                    ? cause.message\n                    : \"Unknown cache purge error\",\n                cause,\n              }),\n          })\n        : Effect.fail(\n            new CachePurgeError({\n              message:\n                \"ctx.cache is not available — enable Workers Cache on this \" +\n                \"Worker (the `cache` prop or `yield* Cloudflare.cache()`) \" +\n                \"and note it is not supported in local dev.\",\n            }),\n          ),\n  },\n});\nnode_modules/alchemy/src/Cloudflare/Workers/DurableObjectBridge.ts:72:          build((promise) => void (state as any).waitUntil?.(promise)).then(\nnode_modules/alchemy/src/Cloudflare/Workers/DurableObjectBridge.ts:171:                // flushes when the scope closes into `waitUntil` below (the\nnode_modules/alchemy/src/Cloudflare/Workers/DurableObjectBridge.ts:193:              : this.ctx.waitUntil(\nnode_modules/alchemy/src/Cloudflare/Workers/DurableObject.ts:714: * registers the close promise with workerd's `state.waitUntil` — so\nnode_modules/alchemy/src/Cloudflare/Workers/DurableObject.ts:719: * For ad-hoc background work, `state.waitUntil(effect)` forks an Effect\nnode_modules/alchemy/src/Cloudflare/Workers/DurableObject.ts:740: *     yield* state.waitUntil(recomputeExpensiveView());\n{\n  \"name\": \"api\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"main\": \"dist/index.js\",\n  \"exports\": {\n    \"./worker\": {\n      \"source\": \"./src/worker.ts\",\n      \"types\": \"./dist/worker.d.ts\",\n      \"default\": \"./dist/worker.js\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"portless run --name api.taxkit bun --watch src/index.ts\",\n    \"start\": \"bun src/index.ts\",\n    \"build\": \"tsc -p tsconfig.json\",\n    \"check-types\": \"tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.tests.json\",\n    \"smoke\": \"bun run smoke:public-routes\",\n    \"smoke:public-routes\": \"bun scripts/smoke-public-routes.runtime.ts\",\n    \"clean\": \"rm -rf dist .turbo *.tsbuildinfo\",\n    \"test\": \"bun --bun vi