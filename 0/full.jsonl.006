"jsdom\": \"16.7.0\",\n    \"jsdom-global\": \"3.0.2\",\n    \"lightningcss\": \"^1.33.0\",\n    \"localStorage\": \"1.0.4\",\n    \"msw\": \"^1.3.3\",\n    \"node-fetch\": \"^2.6.11\",\n    \"posthog-js\": \"link:\",\n    \"preact-render-to-string\": \"^6.3.1\",\n    \"rolldown\": \"1.2.4\",\n    \"rolldown-plugin-dts\": \"0.27.14\",\n    \"rollup-plugin-visualizer\": \"^6.0.3\",\n    \"sinon\": \"9.0.2\",\n    \"testcafe\": \"^2.6.2\",\n    \"testcafe-browser-provider-browserstack\": \"^1.15.2\",\nimport * as Diff from \"alchemy/Diff\";\nimport * as Provider from \"alchemy/Provider\";\nimport { Resource } from \"alchemy/Resource\";\nimport * as Array from \"effect/Array\";\nimport * as Effect from \"effect/Effect\";\nimport * as Layer from \"effect/Layer\";\nimport * as Option from \"effect/Option\";\nimport { PostHogManagementError } from \"./errors\";\nimport { PostHogManagement } from \"./service\";\nimport { PostHogManagementLive } from \"./management.adapter.layer\";\nimport type {\n  DashboardDefinition,\n  InsightDefinition,\n  ManagedDashboard,\n  ManagedInsight,\n  ManagedProject,\n  ManagedTile,\n  ProjectDefinition,\n  TileDefinition,\n  OwnershipMarker,\n} from \"./schemas\";\n\nexport type PostHogProject = Resource<\"PostHog.Project\", ProjectDefinition, ManagedProject>;\nexport const PostHogProject = Resource<PostHogProject>(\"PostHog.Project\");\nexport type PostHogDashboard = Resource<\"PostHog.Dashboard\", DashboardDefinition, ManagedDashboard>;\nexport const PostHogDashboard = Resource<PostHogDashboard>(\"PostHog.Dashboard\");\nexport type PostHogInsight = Resource<\"PostHog.Insight\", InsightDefinition, ManagedInsight>;\nexport const PostHogInsight = Resource<PostHogInsight>(\"PostHog.Insight\");\nexport type PostHogTile = Resource<\"PostHog.Tile\", TileDefinition, ManagedTile>;\nexport const PostHogTile = Resource<PostHogTile>(\"PostHog.Tile\");\n\n// Only this exact prefix migration is allowed; project and resource identity must match.\nconst matchesOwnedMarker = (\n  expected: typeof OwnershipMarker.Type,\n  observed: typeof OwnershipMarker.Type,\n): boolean =>\n  expected === observed ||\n  expected === observed.replace(/^daw-alchemy:/u, \"common-practice-alchemy:\");\n\nexport const requirePostHogOwnership = Effect.fn(\"PostHog.requireOwnership\")(function* (\n  input: Readonly<{ expected: typeof OwnershipMarker.Type; observed: typeof OwnershipMarker.Type }>,\n) {\n  if (matchesOwnedMarker(input.expected, input.observed)) {\n    return;\n  }\n  return yield* new PostHogManagementError({\n    operation: \"read-project\",\n    reason: \"foreign-resource\",\n  });\n});\n\nexport const PostHogProjectProvider = Provider.effect(\n  PostHogProject,\n  Effect.gen(function* () {\n    const management = yield* PostHogManagement;\n    return {\n      stables: [\"id\", \"organisation\"],\n      nuke: { skip: true },\n      list: () => Effect.succeed([]),\n      diff: Effect.fn(\"PostHogProject.diff\")(function* ({ olds, news }) {\n        if (!Diff.isResolved(news)) {\n          return;\n        }\n        const previous = Option.fromNullishOr(olds);\n        if (\n          Option.isSome(previous) &&\n          (previous.value.organisation !== news.organisation ||\n            !matchesOwnedMarker(news.marker, previous.value.marker))\n        ) {\n          return yield* new PostHogManagementError({\n            operation: \"save-project\",\n            reason: \"replacement-refused\",\n          });\n        }\n      }),\n      read: Effect.fn(\"PostHogProject.read\")(function* ({ olds, output }) {\n        const state = Option.fromNullishOr(output);\n        if (Option.isNone(state)) {\n          return;\n        }\n        const current = yield* management.readProject(state.value).pipe(\n          Effect.flatMap(Effect.fromOption),\n          Effect.mapError(\n            () =>\n              new PostHogManagementError({\n                operation: \"read-project\",\n                reason: \"replacement-refused\",\n              }),\n          ),\n        );\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.marker });\n        if (current.organisation !== olds.organisation) {\n          return yield* new PostHogManagementError({\n            operation: \"read-project\",\n            reason: \"foreign-resource\",\n          });\n        }\n        return current;\n      }),\n      reconcile: Effect.fn(\"PostHogProject.reconcile\")(function* ({ news, output }) {\n        const state = Option.fromNullishOr(output);\n        const observed = yield* Option.match(state, {\n          onNone: () => management.findProject(news),\n          onSome: (current) => management.readProject(current),\n        });\n        if (Option.isNone(observed)) {\n          if (Option.isSome(state)) {\n            return yield* new PostHogManagementError({\n              operation: \"save-project\",\n              reason: \"replacement-refused\",\n            });\n          }\n          return yield* management.createProject(news);\n        }\n        yield* requirePostHogOwnership({ expected: news.marker, observed: observed.value.marker });\n        if (observed.value.organisation !== news.organisation) {\n          return yield* new PostHogManagementError({\n            operation: \"save-project\",\n            reason: \"foreign-resource\",\n          });\n"},"started_at_ms":1791366878263,"completed_at_ms":1791366878263}}
