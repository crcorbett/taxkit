DK. */\\n  autocapture_exceptions_opt_in?: boolean | null;\\n  /** Enables automatic capture of Core Web Vitals performance metrics. */\\n  autocapture_web_vitals_opt_in?: boolean | null;\\n  autocapture_web_vitals_allowed_metrics?: unknown;\\n  autocapture_exceptions_errors_to_ignore?: unknown;\\n  /** Enables capturing browser console logs alongside session replays. */\\n  capture_console_log_opt_in?: boolean | null;\\n  /** Enables capturing performance timing and network requests. */\\n  capture_performance_opt_in?: boolean | null;\\n  /** Enables session replay recording for this project. */\\n  session_recording_opt_in?: boolean;\\n  /** Fraction of sessions to record, as a decimal string between `0.00` and `1.00` (e.g. `0.1` = 10%). */\\n  session_recording_sample_rate?: string | null;\\n  /** Skip saving sessions shorter than this many milliseconds. */\\n  session_recording_minimum_duration_milliseconds?: number | null;\\n  session_recording_linked_flag?: unknown;\\n455:      createProject: Effect.fn(\\\"PostHogManagement.createProject\\\")(function* (input) {\\n466:            anonymize_ips: true,\\n468:            autocapture_opt_out: true,\\n469:            autocapture_exceptions_opt_in: false,\\n470:            autocapture_web_vitals_opt_in: false,\\n471:            session_recording_opt_in: false,\\n521:      updateProject: Effect.fn(\\\"PostHogManagement.updateProject\\\")(function* (input) {\\n533:            anonymize_ips: true,\\n535:            autocapture_opt_out: true,\\n536:            session_recording_opt_in: false,\\n537:            autocapture_exceptions_opt_in: false,\\n538:            autocapture_web_vitals_opt_in: false,\\n119:  aliases?: readonly string[];\\n137:   * e.g. a local-mode state row is always deleted by the local provider,\\n140:  modes?: { readonly [M in ProviderMode]: Effect.Effect<ProviderService<Res>> };\\n167:   * Account-wide teardown (`alchemy unsafe nuke`) behaviour. Providers whose\\n168:   * resources can't meaningfully be deleted opt out here so nuke doesn't\\n169:   * report an endless \\\"deleted but still there\\\" loop. `read`/import are\\n172:  nuke?: {\\n176:     * settings) whose `delete` only *resets* it to defaults rather than\\n177:     * removing a discrete resource. Skipped by nuke, since `list` always\\n183:     * The resource is skipped by nuke for any other reason — typically because\\n184:     * it can never actually be deleted (no delete API, like RealtimeKit Apps;\\n192:     * must still exist while this type is deleting. `alchemy unsafe nuke`\\n194:     * gone before any matching type starts deleting; if this type's deletes\\n195:     * fail, the matching types are held back rather than deleted out from\\n198:     * Example: SageMaker HyperPod deletes node ENIs by assuming the\\n204:     * actually present in the nuke target set; declaration cycles collapse\\n208:    dependsOn?: readonly string[];\\n214:   * the same shape {@link read} produces, so each item is directly usable\\n215:   * with {@link delete} without a follow-up read.\\n217:   * This powers account-wide operations such as `alchemy nuke`, which lists\\n218:   * everything and then deletes it. It takes no input and must paginate\\n259:  // different interface that is persistent, watching, reloads\\n262:  read?(input: {\\n277:  stables?: Extract<keyof Res[\\\"Attributes\\\"], string>[];\\n278:  diff?(input: {\\n287:    // Note: we do not resolve (Res[\\\"Props\\\"]) here because diff runs during plan\\n288:    // -> we need a way for the diff handlers to work with Outputs\\n311:   * pair. The engine dispatches `reconcile` for both intents — initial\\n319:   *   existing cloud resource (via {@link read}). The provider has never\\n325:   * Ownership has already been verified upstream — by the time `reconcile`\\n326:   * runs, the engine has confirmed (via `read` returning a non-`Unowned`\\n329:  reconcile(input: {\\n343:  delete(input: {\\n356:     * Set by account-wide teardown (`alchemy unsafe nuke`) to signal the\\n521:  readonly key: Identifier;\\n540:   * as `alchemy unsafe nuke` to enumerate and filter providers — the\\n543:  readonly providers: Record<string, ProviderService>;\\n601:  Predicate.hasProperty(value, \\\"reconcile\\\") &&\\n602:  Predicate.isFunction(value.reconcile) &&\\n603:  Predicate.hasProperty(value, \\\"delete\\\") &&\\nimport * as Schema from \\\"effect/Schema\\\";\\n\\nconst PreviewStage = Schema.String.check(Schema.isPattern(/^pr-[1-9]\\\\d*$/u));\\n\\nexport const DocsLocalDevelopmentStage = Schema.String.check(\\n  Schema.isPattern(/^dev_[a-z0-9]+(?:[-_a-z0-9]+)*$/iu)\\n).pipe(Schema.brand(\\\"taxkit/LocalDocsDevelopmentStage\\\"));\\n\\nexport const DocsDeploymentStage = Schema.Union([\\n  Schema.Literals([\\\"prod\\\"]),\\n  PreviewStage,\\n]).pipe(Schema.brand(\\\"taxkit/DocsDeploymentStage\\\"));\\n\"}"},{"type":"input_text","text":"{\"content\":[{\"type\":\"text\",\"text\":\"name: generate-app-url\\ntitle: Generate app URL\\ndescription: |-\\n  Build a correct, clickable PostHog app URL for any page or entity — run `info generate-app-url` for the full catalog of path templates.\\n  ALWAYS use this (or an existing `_posthogUrl` field on a tool result) instead of writing PostHog links by hand: slugs and project/host prefixes are easy to get wrong (a person UUID lives at `/persons/<uuid>`, not `/person/...`) and IDs must never be retyped into a path. Pass a `url` template from the catalog plus its `{placeholders}` as `params`; returns `{ url }` — surface it verbatim.\\nannotations:\\n  destructiveHint: false\\n  idempotentHint: true\\n  openWorldHint: false\\n  readOnlyHint: true\\ninputSchema: \\\"{\\\\\\\"$schema\\\\\\\":\\\\\\\"https://json-schema.org/draft/2020-12/schema\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"object\\\\\\\",\\\\\\\"properties\\\\\\\":{\\\\\\\"url\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"string\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"A path template copied verbatim from the catalog below (e.g. `/persons/{uuid}`). Its `{placeholders}` are filled from `params`. These slugs come from PostHog's canonical route table, so they are always correct — never pass a path that is not in this list.\\\\\\\\n\\\\\\\\n/account-connected/{kind}\\\\\\\\n/account/credential-review\\\\\\\\n/account/social-connected\\\\\\\\n/activity-logs\\\\\\\\n/activity/{tab}\\\\\\\\n/agentic/account-mismatch\\\\\\\\n/agentic/authorize\\\\\\\\n/ai\\\\\\\\n/ai-enrichment\\\\\\\\n/ai-evals/datasets\\\\\\\\n/ai-evals/datasets/{id}\\\\\\\\n/ai-evals/evaluations\\\\\\\\n/ai-evals/evaluations/offline/experiments\\\\\\\\n/ai-evals/evaluations/offline/experiments/{experimentId}\\\\\\\\n/ai-evals/evaluations/scorers\\\\\\\\n/ai-evals/evaluations/scorers/{scorerId}\\\\\\\\n/ai-evals/evaluations/scorers/{scorerId}/offline\\\\\\\\n/ai-evals/evaluations/templates\\\\\\\\n/ai-evals/evaluations/{id}\\\\\\\\n/ai-evals/taggers\\\\\\\\n/ai-evals/taggers/{id}\\\\\\\\n/ai-gateway\\\\\\\\n/ai-observability/clusters\\\\\\\\n/ai-observability/clusters/{runId}/{clusterId}\\\\\\\\n/ai-observability/dashboard\\\\\\\\n/ai-observability/errors\\\\\\\\n/ai-observability/generations\\\\\\\\n/ai-observability/playground\\\\\\\\n/ai-observability/reviews\\\\\\\\n/ai-observability/self-driving\\\\\\\\n/ai-observability/sentiment\\\\\\\\n/ai-observability/sessions\\\\\\\\n/ai-observability/sessions/{id}\\\\\\\\n/ai-observability/tools\\\\\\\\n/ai-observability/traces\\\\\\\\n/ai-observability/traces/{id}\\\\\\\\n/ai-observability/users\\\\\\\\n/ai/history\\\\\\\\n/alerts\\\\\\\\n/approvals/{id}\\\\\\\\n/autoresearch\\\\\\\\n/autoresearch/new\\\\\\\\n/autoresearch/{id}\\\\\\\\n/bi\\\\\\\\n/billing/authorization_status\\\\\\\\n/broadcasts\\\\\\\\n/broadcasts/new\\\\\\\\n/broadcasts/{id}\\\\\\\\n/business-knowledge\\\\\\\\n/business-knowledge/playground\\\\\\\\n/business-knowledge/settings\\\\\\\\n/business-knowledge/{id}\\\\\\\\n/canvas\\\\\\\\n/canvases\\\\\\\\n/canvases/new\\\\\\\\n/canvases/{id}\\\\\\\\n/cli/authorize\\\\\\\\n/cli/liv