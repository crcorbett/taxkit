kerSettings.make),\\n  Effect.mapError(\\n    () =>\\n      new Config.ConfigError(\\n        new ConfigProvider.SourceError({\\n          message: \\\"API Worker origins are missing or invalid\\\",\\n        })\\n      )\\n  )\\n);\\nnode_modules/alchemy/src/Cloudflare/Workers/Browser.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/WorkerLoader.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/RpcWebSocket.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/WorkerAccess.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/Rpc.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/WorkerBridge.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/DurableObjectStorage.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/WorkerBinding.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/DurableObjectBridge.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/Assets.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/AIBinding.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/SecretKeyBinding.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/EmailEventSource.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/AccountSetting.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/BrowserLocal.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/BindingLayer.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/InferEnv.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/ViteChild.shared.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/SqlMigrationsApply.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/Binding.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/CronEventSource.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/ViteChild.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/ConfigProvider.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/Source.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/RpcAsync.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/RateLimitBinding.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/CloudflareTracer.ts\\nnode_modules/alchemy/src/Cloudflare/Workers/RpcWebSocketClient.ts\\nnode_modules/alchem