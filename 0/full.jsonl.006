e-doppler.schemas.ts\ntools/evals/hgi-206-contradiction-fixtures.json\ntools/docs-deployment/fixtures/fake-doppler.runtime.ts\ntools/docs-deployment/fixtures/alchemy-beta.80/native-apps-preview.txt\ntools/docs-deployment/fixtures/alchemy-beta.80/native-apps-production.txt\ntools/docs-deployment/fixtures/alchemy-beta.64/delete.txt\ntools/docs-deployment/fixtures/alchemy-beta.64/update.txt\ntools/docs-deployment/fixtures/alchemy-beta.64/manifest.json\ntools/docs-deployment/fixtures/alchemy-beta.64/empty-destroy.txt\ntools/docs-deployment/fixtures/alchemy-beta.64/no-op.txt\ntools/docs-deployment/fixtures/alchemy-beta.64/create.txt\ncat: apps/web/vitest.native-pair.config.ts: No such file or directory\nimport { defaultServerConditions } from \"vite\";\nimport { defineConfig } from \"vitest/config\";\n\nexport default defineConfig({\n  resolve: { conditions: [\"source\", ...defaultServerConditions] },\n  // Vite's server loader resolves workspace exports separately from browser resolution.\n  // Fresh tool tests need the source export before any package build exists.\n  ssr: { resolve: { conditions: [\"source\", ...defaultServerConditions] } },\n  test: {\n    // These are source inputs for the actual CLI fixtures, not test suites.\n    exclude: [\"tools/oxlint/fixtures/**\"],\n    fileParallelism: false,\n    include: [\"tools/**/*.test.ts\"],\n    passWithNoTests: false,\n    pool: \"forks\",\n  },\n});\n","stderr":"","aggregated_output":"        \"Review this slice's actual call graph, package/export direction, canonical Schemas/types/brands/errors/Config, live/test/runtime separation and boundary decode/encode.\",\n        \"Inspect mutation/reassignment/loops/native mutators, readonly values, unsafe casts, raw provider/client escapes, nested runtimes and helper/module purpose. Verify actual-command rejected and accepted fixtures at the actual paths; exact host exceptions cannot silently disable other policy.\",\n        \"Check applicable route/container/leaf compos