ueue = function (queue, initStartTime) {\\n        var _a;\\n        var _this = this;\\n        var TIME_BUDGET_MS = 30; // Respect frame budget (~60fps = 16ms, but we're already deferred)\\n        while (queue.length > 0) {\\n            // Only time-slice if deferred init is enabled, otherwise run synchronously\\n            if (this.config.__preview_deferred_init_extensions) {\\n                // we don't support IE11 anymore, so performance.now is safe\\n                var elapsed = performance.now() - initStartTime;\\n                // Check if we've exceeded our time budget\\n                if (elapsed >= TIME_BUDGET_MS && queue.length > 0) {\\n                    // Yield to browser, then continue processing\\n                    setTimeout(function () {\\n                        _this._processInitTaskQueue(queue, initStartTime);\\n                    }, 0);\\n                    return;\\n                }\\n            }\\n            // Process next task\\n            var task = queue.shift();\\n            if (task) {\\n                try {\\n                    task();\\n                }\\n                catch (error) {\\n                    logger_1.logger.error('Error initializing extension:', error);\\n                }\\n            }\\n        }\\n        // All tasks complete - record timing for both sync and deferred modes\\n        // we don't support IE11 anymore, so performance.now is safe\\n        // oxlint-disable-next-line compat/compat\\n        var taskInitTiming = Math.round(performance.now() - initStartTime);\\n        this.register_for_session((_a = {},\\n            _a[constants_1.SDK_DEBUG_EXTENSIONS_INIT_METHOD] = this.config.__preview_deferred_init_extensions\\n                ? 'deferred'\\n                : 'synchronous',\\n            _a[constants_1.SDK_DEBUG_EXTENSIONS_INIT_TIME_MS] = taskInitTiming,\\n            _a));\\n        if (this.config.__preview_deferred_init_extensions) {\\n            logger_1.logger.info(\\\"PostHog extensions initialized (\\\".concat(taskInitTiming, \\\"ms)\\\"));\\n        }\\n    };\\n    PostHog.prototype._onRemoteConfig = function (result) {\\n        var _this = this;\\n        var _a, _b;\\n        if (!(globals_1.document && globals_1.document.body)) {\\n            logger_1.logger.info('document not ready yet, trying again in 500 milliseconds...');\\n            setTimeout(function () {\\n                _this._onRemoteConfig(result);\\nimport { QueuedRequestWithOptions, RequestQueueConfig } from './types';\\nexport declare const DEFAULT_FLUSH_INTERVAL_MS = 3000;\\nexport declare class RequestQueue {\\n    private _isPaused;\\n    private _queue;\\n    private _flushTimeout?;\\n    private _flushTimeoutMs;\\n    private _sendRequest;\\n    constructor(sendRequest: (req: QueuedRequestWithOptions, transportOverride?: QueuedRequestWithOptions['transport']) => void, config?: RequestQueueConfig);\\n    enqueue(req: QueuedRequestWithOptions): void;\\n    unload(): void;\\n    enable(): void;\\n    private _setFlushTimeout;\\n    private _flush;\\n    private _sendRequestSafely;\\n    private _clearFlushTimeout;\\n    private _formatQueue;\\n}\\n{\\n  \\\"name\\\": \\\"posthog-js\\\",\\n  \\\"version\\\": \\\"1.438.2\\\",\\n  \\\"bugs\\\": {\\n    \\\"url\\\": \\\"https://github.com/PostHog/posthog-js/issues\\\"\\n  },\\n  \\\"description\\\": \\\"Posthog-js allows you to automatically capture usage and send events to PostHog.\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/PostHog/posthog-js\\\"\\n  },\\n  \\\"author\\\": \\\"engineering@posthog.com\\\",\\n  \\\"license\\\": \\\"(Apache-2.0 AND MIT)\\\",\\n  \\\"homepage\\\": \\\"https://posthog.com/docs/libraries/js\\\",\\n  \\\"main\\\": \\\"dist/main.js\\\",\\n  \\\"module\\\": \\\"dist/module.mjs\\\",\\n  \\\"types\\\": \\\"dist/module.d.ts\\\",\\n  \\\"files\\\": [\\n    \\\"lib/*\\\",\\n    \\\"dist/*\\\",\\n    \\\"test-fixtures/*.json\\\",\\n    \\\"react/dist/**\\\",\\n    \\\"react/package.json\\\",\\n    \\\"react/surveys/package.json\\\",\\n    \\\"react/slim/package.json\\\",\\n    \\\"full/package.json\\\",\\n    \\\"full/no-external/package.json\\\",\\n    \\\"no-external/package.json\\\",\\n    \\\"customizations/package.json\\\",\\n    \\\"rrweb/package.json\\\",\\n    \\\"rrweb-types/package.json\\\",\\n    \\\"rrweb-plugin-console-record/package.json\\\"\\n  ],\\n  \\\"dependencies\\\": {\\n    \\\"core-js\\\": \\\"^3.49.0\\\",\\n    \\\"dompurify\\\": \\\"^3.4.13\\\",\\n    \\\"fflate\\\": \\\"^0.4.8\\\",\\n    \\\"preact\\\": \\\"^10.29.3\\\",\\n    \\\"query-selector-shadow-dom\\\": \\\"^1.0.1\\\",\\n    \\\"web-vitals\\\": \\\"^6.2.1\\\",\\n    \\\"web-vitals-soft-navs\\\": \\\"npm:web-vitals@6.2.1\\\",\\n    \\\"@posthog/browser-common\\\": \\\"^0.9.2\\\",\\n    \\\"@posthog/core\\\": \\\"^1.57.1\\\",\\n    \\\"@posthog/types\\\": \\\"^1.415.1\\\"\\n  },\\n  \\\"peerDependencies\\\": {\\n    \\\"@types/react\\\": \\\">=16.8.0\\\",\\n    \\\"react\\\": \\\">=16.8.0\\\"\\n  },\\n  \\\"peerDependenciesMeta\\\": {\\n    \\\"@types/react\\\": {\\n      \\\"optional\\\": true\\n    },\\n    \\\"react\\\": {\\n      \\\"optional\\\": true\\n    }\\n  },\\n  \\\"devDependencies\\\": {\\n    \\\"@babel/core\\\": \\\"^7.27.1\\\",\\n    \\\"@babel/plugin-syntax-decorators\\\": \\\"^7.27.1\\\",\\n    \\\"@babel/plugin-transform-exponentiation-operator\\\": \\\"^7.27.1\\\",\\n    \\\"@babel/plugin-transform-nullish-coalescing-operator\\\": \\\"^7.27.1\\\",\\n    \\\"@babel/plugin-transform-react-jsx\\\": \\\"^7.27.1\\\",\\n    \\\"@babel/preset-env\\\": \\\"^7.27.1\\\",\\n    \\\"@babel/preset-typescript\\\": \\\"^7.27.1\\\",\\n    \\\"@jridgewell/sourcemap-codec\\\": \\\"^1.5.5\\\",\\n    \\\"@playwright/test\\\": \\\"1.52.0\\\",\\n    \\\"@rollup/plugin-babel\\\": \\\"^6.0.4\\\",\\n    \\\"@sentry/types\\\": \\\"8.7.0\\\",\\n    \\\"@testing-library/dom\\\": \\\"^10.4.1\\\",\\n    \\\"@testing-library/jest-dom\\\": \\\"^6.9.1\\\",\\n    \\\"@testing-library/preact\\\": \\\"^3.2.4\\\",\\n    \\\"@types/dompurify\\\": \\\"^3.2.0\\\",\\n    \\\"@types/dotenv\\\": \\\"^8.2.3\\\",\\n    \\\"@types/node\\\": \\\"^22.5.0\\\",\\n    \\\"@types/query-selector-shadow-dom\\\": \\\"^1.0.4\\\",\\n    \\\"@types/sinon\\\": \\\"^17.0.1\\\",\\n    \\\"@types/web\\\": \\\"^0.0.222\\\",\\n    \\\"browserslist\\\": \\\"^4.28.8\\\",\\n    \\\"compare-versions\\\": \\\"^6.1.1\\\",\\n    \\\"date-fns\\\": \\\"^3.6.0\\\",\\n    \\\"dotenv\\\": \\\"^17.4.2\\\",\\n    \\\"expect\\\": \\\"^29.7.0\\\",\\n    \\\"fast-check\\\": \\\"^2.17.0\\\",\\n    \\\"http-server\\\": \\\"14.1.1\\\",\\n    \\\"identity-obj-proxy\\\": \\\"^3.0.0\\\",\\n    \\\"jsdom\\\": \\\"16.7.0\\\",\\n    \\\"jsdom-global\\\": \\\"3.0.2\\\",\\n    \\\"lightningcss\\\": \\\"^1.33.0\\\",\\n    \\\"localStorage\\\": \\\"1.0.4\\\",\\n    \\\"msw\\\": \\\"^1.3.3\\\",\\n    \\\"node-fetch\\\": \\\"^2.6.11\\\",\\n    \\\"posthog-js\\\": \\\"link:\\\",\\n    \\\"preact-render-to-string\\\": \\\"^6.3.1\\\",\\n    \\\"rolldown\\\": \\\"1.2.4\\\",\\n    \\\"rolldown-plugin-dts\\\": \\\"0.27.14\\\",\\n    \\\"rollup-plugin-visualizer\\\": \\\"^6.0.3\\\",\\n    \\\"sinon\\\": \\\"9.0.2\\\",\\n    \\\"testcafe\\\": \\\"^2.6.2\\\",\\n    \\\"testcafe-browser-provider-browserstack\\\": \\\"^1.15.2\\\",\\nimport * as Diff from \\\"alchemy/Diff\\\";\\nimport * as Provider from \\\"alchemy/Provider\\\";\\nimport { Resource } from \\\"alchemy/Resource\\\";\\nimport * as Array from \\\"effect/Array\\\";\\nimport * as Effect from \\\"effect/Effect\\\";\\nimport * as Layer from \\\"effect/Layer\\\";\\nimport * as Option from \\\"effect/Option\\\";\\nimport { PostHogManagementError } from \\\"./errors\\\";\\nimport { PostHogManagement } from \\\"./service\\\";\\nimport { PostHogManagementLive } from \\\"./management.adapter.layer\\\";\\nimport type {\\n  DashboardDefinition,\\n  InsightDefinition,\\n  ManagedDashboard,\\n  ManagedInsight,\\n  ManagedProject,\\n  ManagedTile,\\n  ProjectDefinition,\\n  TileDefinition,\\n  OwnershipMarker,\\n} from \\\"./schemas\\\";\\n\\nexport type PostHogProject = Resource<\\\"PostHog.Project\\\", ProjectDefinition, ManagedProject>;\\nexport const PostHogProject = Resource<PostHogProject>(\\\"PostHog.Project\\\");\\nexport type PostHogDashboard = Resource<\\\"PostHog.Dashboard\\\", DashboardDefinition, ManagedDashboard>;\\nexport const PostHogDashboard = Resource<PostHogDashboard>(\\\"PostHog.Dashboard\\\");\\nexport type PostHogInsight = Resource<\\\"PostHog.Insight\\\", InsightDefinition, ManagedInsight>;\\nexport const PostHogInsight = Resource<PostHogInsight>(\\\"PostHog.Insight\\\");\\nexport type PostHogTile = Resource<\\\"PostHog.Tile\\\", TileDefinition, ManagedTile>;\\nexport const PostHogTile = Resource<PostHogTile>(\\\"PostHog.Tile\\\");\\n\\n// Only this exact prefix migration is allowed; project and resource identity must match.\\nconst matchesOwnedMarker = (\\n  expected: typeof OwnershipMarker.Type,\\n  observed: typeof OwnershipMarker.Type,\\n): boolean =>\\n  expected === observed ||\\n  expected === observed.replace(/^daw-alchemy:/u, \\\"common-practice-alchemy:\\\");\\n\\nexport const requirePostHogOwnership = Effect.fn(\\\"PostHog.requireOwnership\\\")(function* (\\n  input: Readonly<{ expected: typeof OwnershipMarker.Type; observed: typeof OwnershipMarker.Type }>,\\n) {\\n  if (matchesOwnedMarker(input.expected, input.observed)) {\\n    return;\\n  }\\n  return yield* new PostHogManagementError({\\n    operation: \\\"read-project\\\",\\n    reason: \\\"foreign-resource\\\",\\n  });\\n});\\n\\nexport const PostHogProjectProvider = Provider.effect(\\n  PostHogProject,\\n  Effect.gen(function* () {\\n    const management = yield* PostHogManagement;\\n    return {\\n      stables: [\\\"id\\\", \\\"organisation\\\"],\\n      nuke: { skip: true },\\n      list: () => Effect.succeed([]),\\n      diff: Effect.fn(\\\"PostHogProject.diff\\\")(function* ({ olds, news }) {\\n        if (!Diff.isResolved(news)) {\\n          return;\\n        }\\n        const previous = Option.fromNullishOr(olds);\\n        if (\\n          Option.isSome(previous) &&\\n          (previous.value.organisation !== news.organisation ||\\n            !matchesOwnedMarker(news.marker, previous.value.marker))\\n        ) {\\n          return yield* new PostHogManagementError({\\n            operation: \\\"save-project\\\",\\n            reason: \\\"replacement-refused\\\",\\n          });\\n        }\\n      }),\\n      read: Effect.fn(\\\"PostHogProject.read\\\")(function* ({ olds, output }) {\\n        const state = Option.fromNullishOr(output);\\n        if (Option.isNone(state)) {\\n          return;\\n        }\\n        const current = yield* management.readProject(state.value).pipe(\\n          Effect.flatMap(Effect.fromOption),\\n          Effect.mapError(\\n            () =>\\n              new PostHogManagementError({\\n                operation: \\\"read-project\\\",\\n                reason: \\\"replacement-refused\\\",\\n              }),\\n          ),\\n        );\\n        yield* requirePostHogOwnership({ expected: olds.marker, observed: current.marker });\\n        if (current.organisation !== olds.organisation) {\\n          return yield* new PostHogManagementError({\\n            operation: \\\"read-project\\\",\\n            reason: \\\"foreign-resource\\\",\\n          });\\n        }\\n        return current;\\n      }),\\n      reconcile: Effect.fn(\\\"PostHogProject.reconcile\\\")(function* ({ news, output }) {\\n        const state = Option.fromNullishOr(output);\\n        const observed = yield* Option.match(state, {\\n          onNone: () => management.findProject(news),\\n          onSome: (current) => management.readProject(current),\\n        });\\n        if (Option.isNone(observed)) {\\n          if (Option.isSome(state)) {\\n            return yield* new PostHogManagementError({\\n              operation: \\\"save-project\\\",\\n              reason: \\\"replacement-refused\\\",\\n            });\\n          }\\n          return yield* management.createProject(news);\\n        }\\n        yield* requirePostHogOwnership({ expected: news.marker, observed: observed.value.marker });\\n        if (observed.value.organisation !== news.organisation) {\\n          return yield* new PostHogManagementError({\\n            operation: \\\"save-project\\\",\\n            reason: \\\"foreign-resource\\\",\\n          });\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"a8217e\",\"wall_time_seconds\":0.631503833,\"exit_code\":0,\"original_token_count\":2128,\"output\":\"rg: /Users/cooper/Projects/effect/packages/effect/examples: IO error for operation on /Users/cooper/Projects/effect/packages/effect/examples: No such file or directory (os error 2)\\n92f48401426694eb1d9d0552b2f7514b3978e7f4\\nimport * as Context from \\\"effect/Context\\\";\\nimport * as Data from \\\"effect/Data\\\";\\nimport * as Effect from \\\"effect/Effect\\\";\\nimport * as Layer from \\\"effect/Layer\\\";\\nimport * as Option from \\\"effect/Option\\\";\\nimport * as Predicate from \\\"effect/Predicate\\\";\\nimport type * as Stream from \\\"effect/Stream\\\";\\nimport type { Artifacts } from \\\"./Artifacts.ts\\\";\\nimport type { ScopedPlanStatusSession } from \\\"./Report.ts\\\";\\nimport type { Diff } from \\\"./Diff.ts\\\";\\nimport type { Input } from \\\"./Input.ts\\\";\\nimport type { InstanceId } from \\\"./InstanceId.ts\\\";\\nimport type { State } from \\\"./State/State.ts\\\";\\nimport type { Platform } from \\\"./Platform.ts\\\";\\nimport { defaultProviderMode, type ProviderMode } from \\\"./ProviderMode.ts\\\";\\nimport type {\\n  ResourceBinding,\\n  ResourceClass,\\n  ResourceClassLike,\\n  ResourceLike,\\n} from \\\"./Resource.ts\\\";\\n\\nexport interface Provider<\\n  R extends ResourceLike = ResourceLike,\\n> extends Effect.Effect<ProviderService<R>, never, Provider<R>> {\\n  asEffect: () => Effect.Effect<ProviderService<R>, never, Provider<R>>;\\n  [Symbol.iterator]: () => Effect.EffectIterator<Provider<R>>;\\n  of: <\\n    ReadReq = never,\\n    DiffReq = never,\\n    PrecreateReq = never,\\n    ReconcileReq = never,\\n    DeleteReq = never,\\n    TailReq = never,\\n    LogsReq = never,\\n    ListReq = never,\\n  >(\\n    service: Omit<\\n      ProviderService<\\n        R,\\n        ReadReq,\\n        DiffReq,\\n        PrecreateReq,\\n        ReconcileReq,\\n        DeleteReq,\\n        TailReq,\\n        LogsReq,\\n        ListReq\\n      >,\\n      \\\"Type\\\"\\n    >,\\n  ) => ProviderService<\\n    R,\\n    ReadReq,\\n    DiffReq,\\n    PrecreateReq,\\n    ReconcileReq,\\n    DeleteReq,\\n    TailReq,\\n    LogsReq,\\n    ListReq\\n  >;\\n}\\n\\n// Supplied by the engine to every lifecycle operation (the stack's `state`\\n// layer is merged into the context lifecycle ops run under), so they are not\\n// requirements of the provider layer itself.\\ntype LifecycleServices = InstanceId | Artifacts | State;\\n\\nexport const Provider = <R extends ResourceLike>(\\n  type: R[\\\"Type\\\"],\\n): Provider<R> =>\\n  Context.Service<Provider<R>, ProviderService<R>>()(type) as any;\\n\\ntype BindingData<Res extends ResourceLike> = [Res] extends [\\n  { Binding: infer B },\\n]\\n  ? ResourceBinding<B>[]\\n  : any[];\\n\\ntype Props<Res extends ResourceLike> = keyof Res[\\\"Props\\\"] extends never\\n  ? Res[\\\"Props\\\"] | undefined\\n  : Res[\\\"Props\\\"];\\n\\nexport interface LogLine {\\n  timestamp: Date;\\n  message: string;\\n}\\n\\nexport interface LogsInput {\\n  since?: Date;\\n  limit?: number;\\n}\\n\\nexport interface ProviderService<\\n  Res extends ResourceLike = ResourceLike,\\n  ReadReq = never,\\n  DiffReq = never,\\n  PrecreateReq = never,\\n  ReconcileReq = never,\\n  DeleteReq = never,\\n  TailReq = never,\\n  LogsReq = never,\\n  ListReq = never,\\n> {\\n  /**\\n   * The version of the provider.\\n   *\\n   * @default