/stage.ts\"\n    },\n    \"./website\": {\n      \"source\": \"./src/cloudflare/website.ts\",\n      \"types\": \"./src/cloudflare/website.ts\",\n      \"default\": \"./src/cloudflare/website.ts\"\n    },\n    \"./apps-stack\": {\n      \"source\": \"./src/apps-stack.ts\",\n      \"types\": \"./src/apps-stack.ts\",\n      \"default\": \"./src/apps-stack.ts\"\n    },\n    \"./apps-secrets\": {\n      \"source\": \"./src/apps-secrets.boundary.ts\",\n      \"types\": \"./src/apps-secrets.boundary.ts\",\n      \"default\": \"./src/apps-secrets.boundary.ts\"\n    }\n  },\n  \"scripts\": {\n    \"build\": \"tsc --noEmit\",\n    \"check-types\": \"tsc --noEmit\",\n    \"test\": \"bun --bun vitest run\"\n  },\n  \"dependencies\": {\n    \"alchemy\": \"catalog:\",\n    \"api\": \"workspace:*\",\n    \"effect\": \"catalog:\"\n  },\n  \"devDependencies\": {\n    \"@effect/platform-bun\": \"catalog:\",\n    \"@effect/vitest\": \"catalog:\",\n    \"@types/bun\": \"catalog:\",\n    \"typescript\": \"catalog:\",\n    \"vitest\": \"catalog:\"\n  }\n}\n/Users/cooper/Projects/common-practice/packages/infrastructure/src/posthog/management.adapter.layer.ts\n/Users/cooper/Projects/common-practice/packages/infrastructure/src/posthog/service.ts\n/Users/cooper/Projects/common-practice/packages/infrastructure/src/posthog/schemas.ts\n/Users/cooper/Projects/common-practice/packages/infrastructure/src/posthog/resources.ts\n/Users/cooper/Projects/common-practice/packages/infrastructure/src/posthog/errors.ts\n/Users/cooper/Projects/common-practice/packages/infrastructure/test/posthog/resources.test.ts\n/Users/cooper/Projects/common-practice/packages/infrastructure/test/posthog/management.adapter.test.ts\n"},"started_at_ms":1791373135537,"completed_at_ms":1791373135537}}
