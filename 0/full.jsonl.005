es-severity=error --disable-nested-config --no-error-on-unmatched-pattern\n//:lint:task: \n//:lint:task:   x typescript(no-invalid-void-type): Use `void` only as a return type or generic type argument.\n//:lint:task:     ,-[apps/web/src/lib/browser-tools.boundary.test.ts:80:42]\n//:lint:task:  79 |     Effect.gen(function* () {\n//:lint:task:  80 |       const ready = yield* Deferred.make<void>();\n//:lint:task:     :                                          ^^^^\n//:lint:task:  81 |       // This test scope owns the controlled host's pending callback, including\n//:lint:task:     `----\n//:lint:task:   help: Replace this `void` type with an allowed type, or keep `void` only in a valid return position.\n//:lint:task: \n//:lint:task:   x unicorn(no-useless-undefined): Do not use useless `undefined`.\n//:lint:task:      ,-[apps/web/src/lib/browser-tools.boundary.test.ts:115:38]\n//:lint:task:  114 |       expect(stalled.aborted).toBe(true);\n//:lint:task:  115 |       yield* Deferred.succeed(ready, undefined);\n//:lint:task:      :                                      ^^^^^^^^^\n//:lint:task:  116 |       expect(register).toHaveBeenCalledTimes(5);\n//:lint:task:      `----\n//:lint:task:   help: Consider removing `undefined` or using `null` instead.\n//:lint:task: \n//:lint:task: Found 0 warnings and 2 errors.\n//:lint:task: Finished in 2.8s on 512 files with 585 rules using 14 threads.\n//:lint:task: error: script \"lint:boundary-directives\" exited with code 1\n//:lint:task: error: script \"lint:task\" exited with code 1\n//#lint:task:  ERROR  command (/Users/cooper/.codex/worktrees/aac7/taxkit/) /private/tmp/taxkit-local-toolchain/bun-darwin-aarch64/bun run lint:task exited (1)\n\n Tasks:    0 successful, 1 total\nCached:    0 cached, 1 total\n  Time:    2.928s \nFailed:    //#lint:task\n\n ERROR  run failed: command  exited (1)\nerror: script \"lint\" exited with code 1\n\n","stderr":"","aggregated_output":"{\"stage\": \"format\", \"command\": [\"bun\", \"x\", \"o