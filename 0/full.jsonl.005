{"timestamp":"2026-10-07T01:49:58.610Z","ordinal":58514,"type":"token_usage_record","payload":{"thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","session_id":"01a1055e-4560-7b33-82d2-226827c76159","root_turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","response_id":"resp_02692a5b008ee3bd016ac5a53b937487d083c3b7e483c4c45d","usage":{"input_tokens":116600,"cached_input_tokens":110080,"cache_write_input_tokens":0,"output_tokens":403,"reasoning_output_tokens":194,"total_tokens":117003},"turn_token_usage":{"input_tokens":266999315,"cached_input_tokens":261916928,"cache_write_input_tokens":0,"output_tokens":1456743,"reasoning_output_tokens":736671,"total_tokens":268456058},"thread_token_usage":{"input_tokens":1102385854,"cached_input_tokens":1079755392,"cache_write_input_tokens":0,"output_tokens":5399723,"reasoning_output_tokens":2415715,"total_tokens":1107785577}}}
{"timestamp":"2026-10-07T01:49:58.691Z","ordinal":58515,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","item":{"type":"CommandExecution","id":"exec-d529f1a3-18e8-4736-be28-9c6e9c1c16a5","process_id":"57139","command":["/bin/zsh","-lc","python3 - <<'PY'\nimport json\nfrom pathlib import Path\nx=json.loads(Path('docs/product-specs/clean-slate-foundation.tasks.json').read_text())\nfor t in x.get('tasks',[]):\n if t.get('id')=='CSF-T006': print(json.dumps(t,indent=2))\nPY\nsed -n '140,200p' apps/web/README.md\nsed -n '198,229p' docs/verification/critical-journeys.json"],"cwd":"file:///Users/cooper/.codex/worktrees/aac7/taxkit","parsed_cmd":[{"type":"unknown","cmd":"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nx=json.loads(Path('docs/product-specs/clean-slate-foundation.tasks.json').read_text())\nfor t in x.get('tasks',[]):\n if t.get('id')=='CSF-T006': print(json.dumps(t,indent=2))\nPY\nsed -n '140,200p' apps/web/README.md\nsed -n '198,229p' docs/verification/critical-journeys.json"}],"source":"unified_exec_startup","status":"completed","stdout":"{\n  \"id\": \"CSF-T006\",\n  \"title\": \"Add remote MCP and visible browser agent tools\",\n  \"status\": \"in_progress\",\n  \"type\": \"vertical-slice\",\n  \"acceptedFindingIds\": [],\n  \"requirementIds\": [\n    \"CSF-005\",\n    \"CSF-006\"\n  ],\n  \"dependsOn\": [\n    \"CSF-T004\",\n    \"CSF-T005\"\n  ],\n  \"goal\": \"Tool names, schemas and descriptions reflect current catalogue/content and use the same calculation owner.\",\n  \"scope\": [\n    \"Add native Effect remote MCP for catalogue/docs discovery, checked calculator inputs, execution and results, reusing the same named operations and accepted Markdown.\",\n    \"Select and qualify native Effect v2026_07_28 stateless and v2025_11_25 stateful adapters before advertising them. Apply anonymous request limits, allowed origins, bounded request/stream lifetimes, cancellation, typed errors and safe tool descriptions; publish discovery and setup docs.\",\n    \"Register feature-detected page-owned WebMCP tools for find/read/fill/calculate/read-result. Reuse visible website commands and the checked RPC client; unregister/cancel on route change or unmount. Do not add direct SDK/backend calls or a duplicate calculation/event owner.\",\n    \"Document actual browser support and distinguish protocol/schema registration from a real agent journey; ordinary browser use must keep working.\"\n  ],\n  \"outputs\": [\n    \"apps/api native MCP adapter and justified contract exports at the existing package owners\",\n    \"apps/web page-owned WebMCP registration/command owner and cleanup tests\",\n    \"Public agent setup/Markdown docs, app/package READMEs, owning architecture and critical-journey updates\",\n    \"HTTP/MCP/WebMCP equality, origin/rate/cancellation and browser evidence\"\n  ],\n  \"implementationPrompt\": \"Read the proposed/accepted SPEC and its current/target/test call graphs before editing. Implement only this named slice after final shared understanding and its task prerequisites are settled. Use immutable canonical Schema-derived values, brands/errors/Config, closed named services, separate live/test Layers and application-owned execution. Keep lazy flat Effects and pipes where linear data flow is clearer; no local mutation, imperative loops, helper sprawl or generic callbacks. Necessary changing state has an explicit React/Effect owner and pure updates. Exact host exceptions admit only their required construct. Change owning docs, READMEs, exports, enforcement and operational pointers in the same slice. Report any design mismatch and update the SPEC/tasks before acceptance. Use bounded independent factual research/review only where authorised and justified.\",\n  \"mandatoryVerification\": [\n    \"bun run test\",\n    \"bun run test:oxlint\",\n    \"bun run check-types\",\n    \"bun run build\",\n    \"bun run check:docs\",\n    \"bun run verification\",\n    \"Appropriate Changeset for package-facing work; explicit no-Changeset rationale otherwise.\"\n  ],\n  \"browserVerification\": [\n    \"Exercise browser tools with the supported experimental browser/agent when available, including visible form changes and results.\",\n    \"Verify fallback in an unsupported browser, cleanup after navigation, cancellation and equivalent results to manual UI/API.\",\n    \"Run a real MCP client for each advertised adapter: current-version per-request metadata/list/read/call; older-version initialise/session/list/read/call. Prove version/header agreement, unsupported versions, origins/rates, real Worker session routing/expiry, streaming cancellation and cleanup; persist no tax figures in session metadata.\"\n  ],\n  \"qualityAudits\": [\n    \"Review this slice's actual call graph, package/export direction, canonical Schemas/types/brands/errors/Config, live/test/runtime separation and boundary decode/encode.\",\n    \"Inspect mutation/reassignment/loops/native mutators, readonly values, unsafe casts, raw provider/client escapes, nested runtimes and helper/module purpose. Verify actual-command rejected and accepted fixtures at the actual paths; exact host exceptions cannot silently disable other policy.\",\n    \"Check applicable route/container/leaf composition, browser-safe imports, interruption/resource disposal and bounded safe telemetry.\",\n    \"Apply the SPEC's path-evidenced downstream-impact rows to this slice; required docs/README/skill/lint/config/CI/runbook changes cannot be deferred to closeout.\"\n  ],\n  \"parentAudit\": {\n    \"required\": true,\n    \"basis\": \"Primary owner reviews the diff, named outcomes, focused and complete checks, applicable real journeys, source evidence and affected owner/pointer changes.\",\n    \"recovery\": \"Correct or re-scope a proved defect. Seek a decision only for a material unresolved product choice or consequential operation without authority; keep incomplete proof identifiable.\"\n  },\n  \"completionCriteria\": [\n    \"Tool names, schemas and descriptions reflect current catalogue/content and use the same calculation owner.\",\n    \"Remote and browser tools have actual caller evidence; lack of a supported browser is recorded as a proof gap, never a passed agent journey.\",\n    \"Anonymous access has bounded work and no required account or stored calculation.\"\n  ],\n  \"commitAfterPassing\": true\n}\n## Related owners\n\n- [Frontend architecture](../../docs/architecture/frontend.md)\n- [RPC package](../../packages/api/rpc/README.md)\n- [API app](../api/README.md)\n- [Native apps graph](../../packages/infrastructure/README.md)\n- [Active execution plan](../../docs/exec-plans/active/clean-slate-foundation.md)\n\nRetained 2025–26 results are unchanged. The Medicare decision, complete package/transport\nqualification and safe exported telemetry remain separate unfinished tasks.\nT003's local connection, failure/cancellation and disabled-platform acceptance\nis recorded in the [acceptance review](../../docs/documentation-audit/clean-slate-foundation/2026-10-05-native-connection-acceptance-review.json).\n\nThe settings server function accepts GET without query data or client Context.\nThe shared explicit route base is configured in Vite and checked at Worker\ningress. The native function's generated URL is the exact admitted address;\nunknown IDs, extra path parts and missing IDs get empty 404 before framework\nlookup/logging. Unexpected payloads get empty 400 responses; unsupported methods get\nempty 405 with `Allow: GET`. Unexpected internal settings failures pass through\nthe native HTTP matcher and fixed host reporter before TanStack serialisation.\n\nThe native builder also compiles a controlled `PRIVATE9` settings defect into\nignored `.alchemy/native-pair/settings-defect/server`. An Effect scope restores\nthe source byte-for-byte before rebuilding the ordinary pair. Do not run this\nbuilder concurrently with source scans or tests that replace source files.\nThe fault test requires the injected operation in the actual artifact, empty\n500 response, positive fixed log event and no marker in logs or replies.\n\nThe same builder also creates controlled API failure artifacts from the actual\nAPI entry: a real calculation followed by an unexpected defect, and one damaged\nreport field after native reply encoding. Scoped finalisers restore the entry\nbyte-for-byte before the ordinary build. Fresh owned output and reached-response\nchecks prevent an old bundle from standing in for the injected operation.\n\nThe native RPC failure test uses ports 4199 and 4200. Real Workers check malformed\nJSON, unknown procedures/envelopes, invalid identities, excess properties and\nbounded batches, plus procedure decoding, version disagreement and expected\ncalculator rejection. The fatal reply retains its native defect identity and\nfixed safe message; the Website returns empty 500 through the private binding.\nA damaged valid-JSON reply becomes the checked invalid-response error. Its real\nWorker-produced HTML loads in Chromium; editing clears the restored error\nwithout replaying a calculation, proving the browser has taken over the form.\nActual fixed API/Website log events must be present and omit the short marker\nand pay values. These are local observations; exported telemetry remains unfinished.\n\nThe native cancellation test uses ports 4201–4203. Two controlled API artifacts\nfirst run the real calculation and native reply encoder, then delay headers or\nthe rest of that same reply for twelve seconds. The generated client must reach\nits ten-second deadline in both cases. Chromium must abort its unfinished\nrequest after the deadline, on editing, and when browser Back leaves the form.\nThese checks establish caller and browser cancellation. They do not establish\nthat the upstream Worker stops its artificial delayed response.\n\nThe native log checks compare pay values against emitted messages. Numeric\nWorker timestamps can coincidentally contain a pay value; they are metadata,\nnot an emitted pay message. Private text markers remain checked across the\nwhole log record. The [dated cancellation receipt](../../docs/documentation-audit/clean-slate-foundation/2026-10-05-native-cancellation.json)\nrecords source-removal checks, restoration and the remaining\nexported-telemetry work.\n\nThe native graph and standalone `wrangler.jsonc` explicitly disable platform\n      \"expectedSideEffects\": [\n        \"Ignored native build files, scoped local Workers and Chromium only.\"\n      ],\n      \"preservedInvariants\": [\n        \"Retained tax results and existing docs operations stay unchanged.\",\n        \"No provider, state, credentials, deployment or publication operation.\"\n      ],\n      \"oracle\": \"Actual native built artifacts run in workerd; real Chromium independently confirms the exact RPC endpoint, no initial/replayed call, no trace/cookie headers and the retained answer. The API artifact contains the engine marker while browser artifacts must not. The generated native settings identity, short request marker and source-built internal defect require actual responses and positive fixed reporting; removing the owning failure boundary makes marker reflection fail the saved test. Unknown native function-address requests must return empty 404 and must omit the short request marker from actual native logs; removing exact-address admission restores that log leak. Actual built API global/procedure/fatal replies use fixed safe values; expected/version errors retain checked identity. A source-built damaged valid-JSON reply must restore a checked error through the genuine Website binding, with real Chromium editing and no replay. Positive fixed host logs omit the marker and pay values. Removal of each native encoder or the owned reply decoder must fail the saved test, followed by exact restoration and fresh dependency/artifact builds. Controlled API roots retain the real calculation/encoding and delay headers or the remaining body for twelve seconds. Actual generated clients must hit the ten-second deadline; Chromium must observe request abort after deadline, editing and actual Back route departure. Removing deadline or edit interruption fails the saved test; exact restoration and fresh builds pass. Pay-value checks inspect emitted log messages; private text checks inspect the whole record. Actual native mock-plan properties and saved real CLI state must contain the disabled collection policy; removing the API graph property fails the saved state Schema after runtime checks. These are declared-state checks, not cloud upload or exported-row proof. An actual successful browser answer survives edits, controlled unavailable retry and invalid form without being presented as current. Reverting figures makes no request and still needs one explicit real RPC to clear the stale message. Actual Worker-generated successful submission HTML hydrates without replay and retains its answer through editing and failed retry. The additional pages must independently return both known results via real API artifacts; no calculation fixture supplies them. Each page starts without the previous calculator's answer. Saved forms and report identity are checked together. Exact browser locator fill admissions have actual CLI positive and neighbouring-application negative fixtures. The size oracle uses multi-byte text below 65536 characters but above 65536 encoded bytes at both API paths and all three form paths. API boundary fixtures also accept exactly 65536 bytes and reject progressive streams without reading their tail. The bounded private client must classify an actual native 413 as the checked request-size error. Valid native calculator/catalogue replies at exactly 2 MiB succeed; over-limit streams stop before the tail and release. Status fixtures prove request-controller abort, safe serialized guidance and one call only. Six restored checked error variants hydrate with their guidance and no new calculation. The built shared-work fixture reaches eight calculations across one HTTP call and a seven-item RPC batch, refuses extra HTTP/SSR/public browser work, retains manual-retry guidance with no edit replay, emits checked HTTP 504/RPC timeouts at five seconds and reaches cleanup. The actual generated client preserves timeout identity. Direct scoped tests prove cancelled/failed place reuse and independent instance pools; timers do not claim forced CPU pre-emption. The owning native pair also reads detail/schema/graph/facts/rules/jurisdictions/tax years from the actual API artifact. The shared RPC corpus proves decoder, size, status, deadline, interruption and old-revision rejection for every named call. Documentation assertions inspect actual initial HTML for every page before independent Chromium navigation. Three source-built API variants retain valid checked pages but change Markdown, metadata or module identity; cold Website SSR and the actual native GET must detect each mismatch. A genuine server-function response is damaged in the browser to prove restoration rejects it. The API artifact must positively contain the executable calculator service identity and browser chunks must omit it; accepted documentation prose cannot stand in for an engine marker. Full-page images supplement functional observations only. Search SSR titles must match real built API results; the original URL resists a forged header. Native function identity is read from its compiled owner. A damaged genuine search reply must fail restoration. Actual form/result navigation and JavaScript-free submission are independently observed in Chromium. Focused browser navigation waits for rendered words before asserting checked outcomes; a bare router promise is insufficient. Bounded startup readiness cannot hide application errors or a persistent gateway failure. Actual built discovery GET bodies must equal the checked native client documents. Chromium XML parsing must produce the sitemap namespace and all 61 canonical addresses in catalogue order. Explicit HEAD 200 must have an empty body and GET-equivalent headers. A real unavailable API binding must return empty uncached 503. The actual RPC corpus rejects a valid document for a different requested path. The Markdown oracle compares all 61 same-page/file GET bodies and equal empty 200 HEAD headers with the owning processed catalogue. Real weighted/quoted/excluded/invalid Accept fields select actual HTML/text or empty safe errors; forged native page headers cannot change the original URL. Chromium independently parses alternate/visible links and opens the real file to exact processed text. Real unavailable binding and method/query/missing cases must fail safely. Share-asset proof reruns the actual build generator, compares every copied and served PNG byte, observes static GET/HEAD/cache/media and exactly accepted paths, decodes all 61 images in Chromium at 1200 by 630, and checks each actual head against the owning TechArticle Schema. Renderer/WebAssembly markers must be absent from Worker and browser outputs; encoded script text preserves unusual characters without closing the script. The actual official MCP network client runs against the source-built Worker, with native JSON/SSE parsing rather than handwritten frames. Its report/page decode through canonical Schemas and equal real HTTP replies; alternating transports exhaust the same local limiter. In-process real-client cancellation separately fills all eight places, cancels one, finishes a replacement and closes the others. This does not prove network cancellation or older session routing.\",\n      \"environment\": \"Local TaxKit checkout, native workerd and Chromium\",\n      \"authority\": \"none\",\n      \"evidence\": [\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-native-website.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-native-website-failures.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-native-local-development.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-native-trace-containment.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-stale-calculator-answer.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-take-home-explanation.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-calculator-catalogue-rpc.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-calculator-pages.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-request-body-policy.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-client-response-policy.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-calculation-work-policy.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-06-closed-rpc-operations.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-06-request-operation-protections.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-07-website-docs-connection.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-07-website-docs-search.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-07-website-docs-discovery.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-07-website-docs-markdown.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-07-website-docs-images.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-07-native-mcp.json\"\n      ],\n      \"nonClaims\": [\n","stderr":"","aggregated_output":"{\n  \"id\": \"CSF-T006\",\n  \"title\": \"Add remote MCP and visible browser agent tools\",\n  \"status\": \"in_progress\",\n  \"type\": \"vertical-slice\",\n  \"acceptedFindingIds\": [],\n  \"requirementIds\": [\n    \"CSF-005\",\n    \"CSF-006\"\n  ],\n  \"dependsOn\": [\n    \"CSF-T004\",\n    \"CSF-T005\"\n  ],\n  \"goal\": \"Tool names, schemas and descriptions reflect current catalogue/content and use the same calculation owner.\",\n  \"scope\": [\n    \"Add native Effect remote MCP for catalogue/docs discovery, checked calculator inputs, execution and results, reusing the same named operations and accepted Markdown.\",\n    \"Select and qualify native Effect v2026_07_28 stateless and v2025_11_25 stateful adapters before advertising them. Apply anonymous request limits, allowed origins, bounded request/stream lifetimes, cancellation, typed errors and safe tool descriptions; publish discovery and setup docs.\",\n    \"Register feature-detected page-owned WebMCP tools for find/read/fill/calculate/read-result. Reuse visible website commands and the checked RPC client; unregister/cancel on route change or unmount. Do not add direct SDK/backend calls or a duplicate calculation/event owner.\",\n    \"Document actual browser support and distinguish protocol/schema registration from a real agent journey; ordinary browser use must keep working.\"\n  ],\n  \"outputs\": [\n    \"apps/api native MCP adapter and justified contract exports at the existing package owners\",\n    \"apps/web page-owned WebMCP registration/command owner and cleanup tests\",\n    \"Public agent setup/Markdown docs, app/package READMEs, owning architecture and critical-journey updates\",\n    \"HTTP/MCP/WebMCP equality, origin/rate/cancellation and browser evidence\"\n  ],\n  \"implementationPrompt\": \"Read the proposed/accepted SPEC and its current/target/test call graphs before editing. Implement only this named slice after final shared understanding and its task prerequisites are settled. Use immutable canonical Schema-derived values, brands/errors/Config, closed named services, separate live/test Layers and application-owned execution. Keep lazy flat Effects and pipes where linear data flow is clearer; no local mutation, imperative loops, helper sprawl or generic callbacks. Necessary changing state has an explicit React/Effect owner and pure updates. Exact host exceptions admit only their required construct. Change owning docs, READMEs, exports, enforcement and operational pointers in the same slice. Report any design mismatch and update the SPEC/tasks before acceptance. Use bounded independent factual research/review only where authorised and justified.\",\n  \"mandatoryVerification\": [\n    \"bun run test\",\n    \"bun run test:oxlint\",\n    \"bun run check-types\",\n    \"bun run build\",\n    \"bun run check:docs\",\n    \"bun run verification\",\n    \"Appropriate Changeset for package-facing work; explicit no-Changeset rationale otherwise.\"\n  ],\n  \"browserVerification\": [\n    \"Exercise browser tools with the supported experimental browser/agent when available, including visible form changes and results.\",\n    \"Verify fallback in an unsupported browser, cleanup after navigation, cancellation and equivalent results to manual UI/API.\",\n    \"Run a real MCP client for each advertised adapter: current-version per-request metadata/list/read/call; older-version initialise/session/list/read/call. Prove version/header agreement, unsupported versions, origins/rates, real Worker session routing/expiry, streaming cancellation and cleanup; persist no tax figures in session metadata.\"\n  ],\n  \"qualityAudits\": [\n    \"Review this slice's actual call graph, package/export direction, canonical Schemas/types/brands/errors/Config, live/test/runtime separation and boundary decode/encode.\",\n    \"Inspect mutation/reassignment/loops/native mutators, readonly values, unsafe casts, raw provider/client escapes, nested runtimes and helper/module purpose. Verify actual-command rejected and accepted fixtures at the actual paths; exact host exceptions cannot silently disable other policy.\",\n    \"Check applicable route/container/leaf composition, browser-safe imports, interruption/resource disposal and bounded safe telemetry.\",\n    \"Apply the SPEC's path-evidenced downstream-impact rows to this slice; required docs/README/skill/lint/config/CI/runbook changes cannot be deferred to closeout.\"\n  ],\n  \"parentAudit\": {\n    \"required\": true,\n    \"basis\": \"Primary owner reviews the diff, named outcomes, focused and complete checks, applicable real journeys, source evidence and affected owner/pointer changes.\",\n    \"recovery\": \"Correct or re-scope a proved defect. Seek a decision only for a material unresolved product choice or consequential operation without authority; keep incomplete proof identifiable.\"\n  },\n  \"completionCriteria\": [\n    \"Tool names, schemas and descriptions reflect current catalogue/content and use the same calculation owner.\",\n    \"Remote and browser tools have actual caller evidence; lack of a supported browser is recorded as a proof gap, never a passed agent journey.\",\n    \"Anonymous access has bounded work and no required account or stored calculation.\"\n  ],\n  \"commitAfterPassing\": true\n}\n## Related owners\n\n- [Frontend architecture](../../docs/architecture/frontend.md)\n- [RPC package](../../packages/api/rpc/README.md)\n- [API app](../api/README.md)\n- [Native apps graph](../../packages/infrastructure/README.md)\n- [Active execution plan](../../docs/exec-plans/active/clean-slate-foundation.md)\n\nRetained 2025–26 results are unchanged. The Medicare decision, complete package/transport\nqualification and safe exported telemetry remain separate unfinished tasks.\nT003's local connection, failure/cancellation and disabled-platform acceptance\nis recorded in the [acceptance review](../../docs/documentation-audit/clean-slate-foundation/2026-10-05-native-connection-acceptance-review.json).\n\nThe settings server function accepts GET without query data or client Context.\nThe shared explicit route base is configured in Vite and checked at Worker\ningress. The native function's generated URL is the exact admitted address;\nunknown IDs, extra path parts and missing IDs get empty 404 before framework\nlookup/logging. Unexpected payloads get empty 400 responses; unsupported methods get\nempty 405 with `Allow: GET`. Unexpected internal settings failures pass through\nthe native HTTP matcher and fixed host reporter before TanStack serialisation.\n\nThe native builder also compiles a controlled `PRIVATE9` settings defect into\nignored `.alchemy/native-pair/settings-defect/server`. An Effect scope restores\nthe source byte-for-byte before rebuilding the ordinary pair. Do not run this\nbuilder concurrently with source scans or tests that replace source files.\nThe fault test requires the injected operation in the actual artifact, empty\n500 response, positive fixed log event and no marker in logs or replies.\n\nThe same builder also creates controlled API failure artifacts from the actual\nAPI entry: a real calculation followed by an unexpected defect, and one damaged\nreport field after native reply encoding. Scoped finalisers restore the entry\nbyte-for-byte before the ordinary build. Fresh owned output and reached-response\nchecks prevent an old bundle from standing in for the injected operation.\n\nThe native RPC failure test uses ports 4199 and 4200. Real Workers check malformed\nJSON, unknown procedures/envelopes, invalid identities, excess properties and\nbounded batches, plus procedure decoding, version disagreement and expected\ncalculator rejection. The fatal reply retains its native defect identity and\nfixed safe message; the Website returns empty 500 through the private binding.\nA damaged valid-JSON reply becomes the checked invalid-response error. Its real\nWorker-produced HTML loads in Chromium; editing clears the restored error\nwithout replaying a calculation, proving the browser has taken over the form.\nActual fixed API/Website log events must be present and omit the short marker\nand pay values. These are local observations; exported telemetry remains unfinished.\n\nThe native cancellation test uses ports 4201–4203. Two controlled API artifacts\nfirst run the real calculation and native reply encoder, then delay headers or\nthe rest of that same reply for twelve seconds. The generated client must reach\nits ten-second deadline in both cases. Chromium must abort its unfinished\nrequest after the deadline, on editing, and when browser Back leaves the form.\nThese checks establish caller and browser cancellation. They do not establish\nthat the upstream Worker stops its artificial delayed response.\n\nThe native log checks compare pay values against emitted messages. Numeric\nWorker timestamps can coincidentally contain a pay value; they are metadata,\nnot an emitted pay message. Private text markers remain checked across the\nwhole log record. The [dated cancellation receipt](../../docs/documentation-audit/clean-slate-foundation/2026-10-05-native-cancellation.json)\nrecords source-removal checks, restoration and the remaining\nexported-telemetry work.\n\nThe native graph and standalone `wrangler.jsonc` explicitly disable platform\n      \"expectedSideEffects\": [\n        \"Ignored native build files, scoped local Workers and Chromium only.\"\n      ],\n      \"preservedInvariants\": [\n        \"Retained tax results and existing docs operations stay unchanged.\",\n        \"No provider, state, credentials, deployment or publication operation.\"\n      ],\n      \"oracle\": \"Actual native built artifacts run in workerd; real Chromium independently confirms the exact RPC endpoint, no initial/replayed call, no trace/cookie headers and the retained answer. The API artifact contains the engine marker while browser artifacts must not. The generated native settings identity, short request marker and source-built internal defect require actual responses and positive fixed reporting; removing the owning failure boundary makes marker reflection fail the saved test. Unknown native function-address requests must return empty 404 and must omit the short request marker from actual native logs; removing exact-address admission restores that log leak. Actual built API global/procedure/fatal replies use fixed safe values; expected/version errors retain checked identity. A source-built damaged valid-JSON reply must restore a checked error through the genuine Website binding, with real Chromium editing and no replay. Positive fixed host logs omit the marker and pay values. Removal of each native encoder or the owned reply decoder must fail the saved test, followed by exact restoration and fresh dependency/artifact builds. Controlled API roots retain the real calculation/encoding and delay headers or the remaining body for twelve seconds. Actual generated clients must hit the ten-second deadline; Chromium must observe request abort after deadline, editing and actual Back route departure. Removing deadline or edit interruption fails the saved test; exact restoration and fresh builds pass. Pay-value checks inspect emitted log messages; private text checks inspect the whole record. Actual native mock-plan properties and saved real CLI state must contain the disabled collection policy; removing the API graph property fails the saved state Schema after runtime checks. These are declared-state checks, not cloud upload or exported-row proof. An actual successful browser answer survives edits, controlled unavailable retry and invalid form without being presented as current. Reverting figures makes no request and still needs one explicit real RPC to clear the stale message. Actual Worker-generated successful submission HTML hydrates without replay and retains its answer through editing and failed retry. The additional pages must independently return both known results via real API artifacts; no calculation fixture supplies them. Each page starts without the previous calculator's answer. Saved forms and report identity are checked together. Exact browser locator fill admissions have actual CLI positive and neighbouring-application negative fixtures. The size oracle uses multi-byte text below 65536 characters but above 65536 encoded bytes at both API paths and all three form paths. API boundary fixtures also accept exactly 65536 bytes and reject progressive streams without reading their tail. The bounded private client must classify an actual native 413 as the checked request-size error. Valid native calculator/catalogue replies at exactly 2 MiB succeed; over-limit streams stop before the tail and release. Status fixtures prove request-controller abort, safe serialized guidance and one call only. Six restored checked error variants hydrate with their guidance and no new calculation. The built shared-work fixture reaches eight calculations across one HTTP call and a seven-item RPC batch, refuses extra HTTP/SSR/public browser work, retains manual-retry guidance with no edit replay, emits checked HTTP 504/RPC timeouts at five seconds and reaches cleanup. The actual generated client preserves timeout identity. Direct scoped tests prove cancelled/failed place reuse and independent instance pools; timers do not claim forced CPU pre-emption. The owning native pair also reads detail/schema/graph/facts/rules/jurisdictions/tax years from the actual API artifact. The shared RPC corpus proves decoder, size, status, deadline, interruption and old-revision rejection for every named call. Documentation assertions inspect actual initial HTML for every page before independent Chromium navigation. Three source-built API variants retain valid checked pages but change Markdown, metadata or module identity; cold Website SSR and the actual native GET must detect each mismatch. A genuine server-function response is damaged in the browser to prove restoration rejects it. The API artifact must positively contain the executable calculator service identity and browser chunks must omit it; accepted documentation prose cannot stand in for an engine marker. Full-page images supplement functional observations only. Search SSR titles must match real built API results; the original URL resists a forged header. Native function identity is read from its compiled owner. A damaged genuine search reply must fail restoration. Actual form/result navigation and JavaScript-free submission are independently observed in Chromium. Focused browser navigation waits for rendered words before asserting checked outcomes; a bare router promise is insufficient. Bounded startup readiness cannot hide application errors or a persistent gateway failure. Actual built discovery GET bodies must equal the checked native client documents. Chromium XML parsing must produce the sitemap namespace and all 61 canonical addresses in catalogue order. Explicit HEAD 200 must have an empty body and GET-equivalent headers. A real unavailable API binding must return empty uncached 503. The actual RPC corpus rejects a valid document for a different requested path. The Markdown oracle compares all 61 same-page/file GET bodies and equal empty 200 HEAD headers with the owning processed catalogue. Real weighted/quoted/excluded/invalid Accept fields select actual HTML/text or empty safe errors; forged native page headers cannot change the original URL. Chromium independently parses alternate/visible links and opens the real file to exact processed text. Real unavailable binding and method/query/missing cases must fail safely. Share-asset proof reruns the actual build generator, compares every copied and served PNG byte, observes static GET/HEAD/cache/media and exactly accepted paths, decodes all 61 images in Chromium at 1200 by 630, and checks each actual head against the owning TechArticle Schema. Renderer/WebAssembly markers must be absent from Worker and browser outputs; encoded script text preserves unusual characters without closing the script. The actual official MCP network client runs against the source-built Worker, with native JSON/SSE parsing rather than handwritten frames. Its report/page decode through canonical Schemas and equal real HTTP replies; alternating transports exhaust the same local limiter. In-process real-client cancellation separately fills all eight places, cancels one, finishes a replacement and closes the others. This does not prove network cancellation or older session routing.\",\n      \"environment\": \"Local TaxKit checkout, native workerd and Chromium\",\n      \"authority\": \"none\",\n      \"evidence\": [\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-native-website.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-native-website-failures.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-native-local-development.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-native-trace-containment.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-stale-calculator-answer.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-take-home-explanation.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-calculator-catalogue-rpc.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-calculator-pages.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-request-body-policy.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-client-response-policy.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-05-calculation-work-policy.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-06-closed-rpc-operations.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-06-request-operation-protections.json\",\n        \"docs/documentation-audit/clean-slate-foundation/2026-10-07-website-docs-connection.json\",\n        \"docs/documentation-audit/clean-slate-f