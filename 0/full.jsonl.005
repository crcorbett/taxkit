 ns.jurisdiction(jurisdiction) as any),\\n        };\\n      });\\n\\n    // Class-form declarations (`DurableObject<Self>()(\\\"Name\\\", props?)`) can\\n    // carry `transferredFrom` so the host's local binding drives a\\n    // data-preserving transfer migration.\\n    const classProps =\\n      isClassForm && !Effect.isEffect(propsOrImpl)\\n        ? (propsOrImpl as\\n            | Pick<DurableObjectProps, \\\"transferredFrom\\\" | \\\"errors\\\">\\n            | undefined)\\n650:const MCP_SESSION_ID_HEADER = \\\"mcp-session-id\\\"\\n729:    sessionHeaders: Headers.Headers | undefined\\n870:    const session = runtime.resolveRequest(client.id, headers)\\n872:    if (!isInitialize && !session) {\\n890:    // without a session have been rejected above.\\n891:    const initializePayload = session?.initializePayload ?? payload as typeof McpSchema.Initialize.payloadSchema.Type\\n893:    const selectedProtocol = session?.protocol ??\\n899:    const profile: McpCore.NegotiatedProtocolProfile = session?.negotiatedProfile ?? {\\n1027:              const session = prepared.binding\\n1030:              // their session's adapter; modern requests carry their own version.\\n1034:                sessionHeaders: isHttp && headers[MCP_SESSION_ID_HEADER] !== undefined\\n1036:                  : clientState?.sessionHeaders\\n1045:              if (httpRequest !== undefined && session !== undefined) {\\n1051:                      session.protocol.protocolVersion\\n1059:                if (!session && selectedProtocol.runtime._tag === \\\"Stateful\\\") {\\n1081:                      if (session === undefined) {\\n1084:                      // Each HTTP POST has its own transport ID, but cancellation belongs to the session.\\n1086:                        requests.get(key)?.prepared.binding === session\\n1171:            const session = isHttp\\n1179:              isHttp ? key.profile === session?.negotiatedProfile : key.clientId === clientId\\n1231:          // HTTP UUID sessions are stored separately and outlive request-scoped client IDs.\\n1299:                clientStates.get(clientId)?.sessionHeaders ?? Headers.empty,\\n1368: * Unlike `layerStdio` and `layerHttp`, this layer does not install a concrete\\n1373: * @see {@link layerHttp} for an HTTP-backed layer that registers with `HttpRouter` and installs JSON-RPC serialization\\n1431: * @see {@link layerHttp} for the single-endpoint HTTP transport\\n1493:              selectedProtocol = McpRuntime.selectStatefulProtocol(protocols, offered)\\n1537: * `layerHttp` always implements the single-endpoint Streamable HTTP topology.\\n1540: * HTTP+SSE transport, GET SSE, event resumption, session expiry, or client\\n1541: * session termination.\\n1550:export const layerHttp = (options: {\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","create_time":1791341466.85814}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
