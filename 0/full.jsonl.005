 Effect.fail(\n          new McpProtocol.ProtocolError({\n            code: PublicMcpSchema.METHOD_NOT_FOUND_ERROR_CODE,\n            message: \"Resource subscriptions are not supported\"\n          })\n        )\n      }\n      return Effect.sync(() => subscriptions.delete(uri)).pipe(Effect.asVoid)\n    },\n    effectLogLevel,\n    canDeliver: (clientId, headers, notification, fallbackLogLevel) => {\n      const session = resolveSession(clientId, headers)\n      if (notification._tag === \"LoggingMessage\") {\n        const minimum = session?.logLevel\n        return minimum?._tag === \"Mcp\"\n          ? McpProtocol.mcpLogLevels[notification.level].order >= McpProtocol.mcpLogLevels[minimum.level].order\n          : LogLevel.isGreaterThanOrEqualTo(\n            McpProtocol.mcpLogLevels[notification.level].effect,\n            minimum?.level ?? fallbackLogLevel\n          )\n      }\n      return notification._tag !== \"ResourceUpdated\" || session?.resourceSubscriptions?.has(notification.uri) === true\n    },\n    markInitialized: (clientId) => {\n      initializedClientIds.add(clientId)\n    },\n    initializedClientIds: () => initializedClientIds.values(),\n    disconnect: (clientId) => {\n      byClientId.delete(clientId)\n      initializedClientIds.delete(clientId)\n    }\n  }\n}\n) as any;\n\nexport type DurableObjectStub<Shape> = {\n  // TODO(sam): do we need to transform? hopefully not\n  [key in keyof Shape]: Shape[key];\n} & {\n  fetch: (\n    request: HttpServerRequest.HttpServerRequest,\n  ) => Effect.Effect<\n    HttpServerResponse.HttpServerResponse,\n    HttpServerError,\n    never\n  >;\n};\n"},"started_at_ms":1791338182619,"completed_at_ms":1791338182619}}
{"timestamp":"2026-10-07T01:56:22.675Z","ordinal":58688,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a11413-7813-7023-ac15-e6d4bdc3ffff","call_id":"call_mJQC3xsozDAC1o8WEmLylymH","output":[{"type":"input_text","text":"Script completed\nWall time 2.9 seconds\nOutput:\n"},{"type":"input_text","text":"Use ReadableStream with Durable Object and Workers · Cloudflare Durable Objects docs (https://developers.cloudflare.com/durable-objects/examples/readable-stream/)\nciteturn50view0 [wordlim: 200] Crawled: today; Content type: text/html; Source: open({\"ref_id\":\"https://developers.cloudflare.com/durable-objects/examples/readable-stream/\",\"lineno\":null}); Total lines: 307\n--------------------------------------------------------------------------------\nCompatibility flags · Cloudflare Workers docs (https://developers.cloudflare.com/workers/configuration/compatibility-flags/)\nciteturn50view1 [wordlim: 200] Crawled: today; Content type: text/html; Source: open({\"ref_id\":\"https://developers.cloudflare.com/workers/configuration/compatibility-flags/\",\"lineno\":null}); Total lines: 2099\n--------------------------------------------------------------------------------\nCompatibility flags · Cloudflare Workers docs (https://developers.cloudflare.com/workers/configuration/compatibility-flags/)\nciteturn50view2 [wordlim: 200] Crawled: today; Content type: text/html; Source: find({\"ref_id\":\"https://developers.cloudflare.com/workers/configuration/compatibility-flags/\",\"pattern\":\"Enable Request.signal\"}); Total lines: 2099\nL1333: When this flag is enabled you can instruct Cloudflare to force its cache to revalidate the response from a subrequest you make from your Worker using the cite134†`fetch()` API :\nL1334: \nL1335: When `no-cache` is specified:\nL1336: \nL1340: Revalidating with the origin means that the Worker request will first look for a match in Cloudflare's cache, then:\nL1341:   * If there is a match, a conditional request is sent to the origin, regardless of whether or not the match is fresh or stale. If the resource has not changed, the cached version is returned. If the resource has changed, it will be downloaded from the origin, updated in the cache, and returned.\nL1342:   * If there is no match, Workers will make a standard request to the origin and cache the response.\nL1343: Examples using `cache: 'no-cache'`:\nL1344: \nL1345:     `const response = await fetch(\"https://example.com\", { cache: \"no-cache\" });`\nL1346: \nL1347: The cache value can also be set on a `Request` object.\nL1348: \nL1349:     `const request = new Request(\"https://example.com\", { cache: \"no-cache\" });\nL1350:     const response = await fetch(request);`\nL1351: ### Set the `this` value of EventTarget event handlers\nL1352: \nL1353: Default as of  | 2025-08-01\nL1354: Flag to enable  | `set_event_target_this`\nL1355: Flag to disable  | `no_set_event_target_this`\nL1356: \nL1357: When the `set_event_target_this` flag is se, Workers will set the `this` value of event handlers to the `EventTarget` instance that the event is being dispatched on. This is compliant with the specification.\nL1358: When then `no_set_event_target_this` flag is set, Workers will not set the `this` value of event handlers, and it will be `undefined` instead.\nL1359: ### Set forwardable email full headers\nL1360: \nL1361: Default as of  | 2025-08-01\nL1362: Flag to enable  | `set_forwardable_email_full_headers`\nL1363: Flag to disable  | `set_forwardable_email_single_headers`\nL1364: \nL1365: The original version of the headers sent to edgeworker were truncated to a single value for specific header names, such as To and Cc. With the `set_forwardable_email_full_headers` flag set, Workers will receive the full header values to the worker script.\nL1366: ### Pedantic Web Platform Tests (WPT) compliance\nL1367: \nL1368: Flag to enable  | `pedantic_wpt`\nL1369: Flag to disable  | `non_pedantic_wpt`\nL1370: \nL1371: The `pedantic_wpt` flag enables strict compliance with Web Platform Tests (WPT) in Workers. Initially this only effects `Event` and `EventTarget` APIs but will be expanded to other APIs in the future. There is no default enable date for this flag.\nL1372: ### Bind AsyncLocalStorage snapshots to the request\nL1373: \nL1374: Default as of  | 2025-06-16\nL1375: Flag to enable  | `bind_asynclocalstorage_snapshot_to_request`\nL1376: Flag to disable  | `do_not_bind_asynclocalstorage_snapshot_to`\nL1377: The AsyncLocalStorage frame can capture values that are bound to the current request context. This is not always in the users control since we use the ALS storage frame to propagate internal trace spans as well as user-provided values. When the `bind_asynclocalstorage_snapshot_to_request` flag is set, the runtime binds the snapshot / bound functions to the current request context and will throw an error if the bound functions are called outside of the request in which they were created.\nL1378: The `do_not_bind_asynclocalstorage_snapshot_to` flag disables this behavior.\nL1379: ### Throw on unrecognized import assertions\nL1380: \nL1381: Default as of  | 2025-06-16\nL1382: Flag to enable  | `throw_on_unrecognized_import_assertion`\nL1383: Flag to disable  | `ignore_unrecognized_import_assertion`\nL1384: The `throw_on_unrecognized_import_assertion` flag controls how Workers handle import attributes that are not recognized by the runtime. Previously, Workers would ignore all import attributes, which is not compliant with the specification. Runtimes are expected to throw an error when an import attribute is encountered that is not recognized.\nL1385: \nL1386: When the `ignore_unrecognized_import_assertion` flag is set, Workers will ignore unrecognized import attributes.\nL1387: ### Enable eval during startup\nL1388: \nL1389: Default as of  | 2025-06-01\nL1390: Flag to enable  | `allow_eval_during_startup`\nL1391: Flag to disable  | `disallow_eval_during_startup`\nL1392: \nL1393: When the `allow_eval_during_startup` flag is set, Workers can use `eval()` and `new Function(text)` during the startup phase of a Worker script. This allows for dynamic code execution at the beginning of a Worker lifecycle.\nL1394: When the `disallow_eval_during_startup` flag is set, using `eval()` or `new Function(text)` during the startup phase will throw an error.\nL1395: ### Enable `Request.signal` for incoming requests\nL1396: \nL1397: Flag to enable  | `enable_request_signal`\nL1398: Flag to disable  | `disable_request_signal`\nL1399: \nL1400: When you use the `enable_request_signal` compatibility flag, you can attach an event listener to cite168†`Request` objects, using the cite445†`signal` property ↗︎†developer.mozilla.org . This allows you to perform tasks when the request to your Worker is canceled by the client.\nL1401: ### Cache API request `cf` overrides cache rules\nL1402: \nL1403: Default as of  | 2025-05-19\nL1404: Flag to enable  | `cache_api_request_cf_overrides_cache_rules`\nL1405: Flag to disable  | `no_cache_api_request_cf_overrides_cache_rules`\nL1406: \nL1407: When `cache_api_request_cf_overrides_cache_rules` is enabled, cache settings specified in the `cf` object of a request passed to the cite129†Cache API will override cache rules. This applies only to user-owned or grey-clouded sites.\nL1408: This is the Cache API counterpart to the cite446†`request_cf_overrides_cache_rules` flag, which applies to the `fetch()` API.\nL1409: ### Enable `navigator.language`\nL1410: \nL1411: Default as of  | 2025-05-19\nL1412: Flag to enable  | `enable_navigator_language`\nL1413: Flag to disable  | `disable_navigator_language`\nL1414: \nL1415: When the `enable_navigator_language` flag is set, the `navigator.language` property will be available in Workers. For now, the value of `navigator.language` will always be `en`.\nL1416: \nL1417: When the `disable_navigator_language` flag is set, the `navigator.language` property will not be available.\nL1418: ### Disallowing importable environment\nL1419: \nL1420: Flag to enable  | `disallow_importable_env`\nL1421: Flag to disable  | `allow_importable_env`\nL1422: \nL1423: When the `disallow_importable_env` flag is enabled, Workers will not allow importing the environment variables via the `cloudflare:workers` module and will not populate the environment variables in the global `process.env` object when Node.js compatibility is enabled.\nL1424: \nL1425: There is no default enabled date for this flag.\nL1426: ### Enable `FinalizationRegistry` and `WeakRef`\nL1427: \nL1428: Default as of  | 2025-05-05\nL1429: Flag to enable  | `enable_weak_ref`\nL1430: Flag to disable  | `disable_weak_ref`\nL1431: \nL1432: Enables the use of cite447†`FinalizationRegistry` ↗︎†developer.mozilla.org and cite448†`WeakRef` ↗︎†developer.mozilla.org built-ins.\nL1433:   * `FinalizationRegistry` allows you to register a cleanup callback that runs after an object has been garbage-collected.\nL1434:   * `WeakRef` creates a weak reference to an object, allowing it to be garbage-collected if no other strong references exist.\nL1435: :::note[Behaviour] `FinalizationRegistry` cleanup callbacks may execute at any point during your request lifecycle, even after your invoked handler has completed (similar to `ctx.waitUntil()`). These callbacks do not have an associated async context. You cannot perform any I/O within them, including emitting events to a tail Worker. :::\nL1436: :::caution These APIs are fundamentally non-deterministic. The timing and execution of garbage collection are unpredictable, and you should not rely on them for essential program logic. Additionally, cleanup callbacks registered with `FinalizationRegistry` may never be executed, including but not limited to cases where garbage collection is not triggered, or your Worker gets evicted. :::\nL1437: ### Passthrough AbortSignal of incoming request to subrequests\nL1438: \nL1439: Flag to enable  | `request_signal_passthrough`\nL1440: Flag to disable  | `no_request_signal_passthrough`\nL1441: \nL1442: When the `request_signal_passthrough` flag set, the `AbortSignal` of an incoming request will be passed through to subrequests when the request is forwarded to a subrequest using the `fetch()` API.\nL1443: \nL1444: The the `no_request_signal_passthrough` flag is set, the `AbortSignal` of the incoming request will not be passed through.\nL1445: ### Spec-compliant URLPattern implementation\nL1446: \nL1447: Default as of  | 2025-05-01\nL1448: Flag to enable  | `urlpattern_standard`\nL1449: Flag to disable  | `urlpattern_original`\nL1450: \nL1451: The original `URLPattern` implementation was not fully compliant with the cite449†WHATWG URLPattern Standard ↗︎†urlpattern.spec.whatwg.org , leading to a number of issues reported by users.\nL1452: With `urlpattern_standard` enabled, Workers uses a spec-compliant URLPattern implementation. This is a breaking change from the original behavior, so it is gated behind a compatibility flag.\nL1453: \nL1454: If you are using `URLPattern` and encounter unexpected behavior changes after updating your compatibility date, you can set `urlpattern_original` to revert to the previous implementation.\nL1455: ### Navigation requests prefer asset serving\nL1456: \nL1457: Default as of  | 2025-04-01\nL1458: Flag to enable  | `assets_navigation_prefers_asset_serving`\nL1459: Flag to disable  | `assets_navigation_has_no_effect`\nL1460: For Workers with cite182†static assets and this compatibility flag enabled, navigation requests (requests which have a `Sec-Fetch-Mode: navigate` header) will prefer to be served by our asset-serving logic, even when an exact asset match cannot be found.\nL1461: This is particularly useful for applications which operate in either cite185†Single Page Application (SPA) mode or have cite450†custom 404 pages , as this now means the fallback pages of `200 /index.html` and `404 /404.html` will be served ahead of invoking a Worker script and will therefore avoid incurring a charge.\nL1462: Without this flag, the runtime will continue to apply the old behavior of invoking a Worker script (if present) for any requests which do not exactly match a static asset.\nL1463: \nL1464: When `assets.run_worker_first = true` is set, this compatibility flag has no effect. The `assets.run_worker_first = true` setting ensures the Worker script executes before any asset-serving logic.\nL1465: ### Enable auto-populating `process.env`\nL1466: \nL1467: Default as of  | 2025-04-01\nL1468: Flag to enable  | `nodejs_compat_populate_process_env`\nL1469: Flag to disable  | `nodejs_compat_do_not_populate_process_env`\nL1470: When you enable the `nodejs_compat_populate_process_env` compatibility flag and the cite145†`nodejs_compat` flag is also enabled, `process.env` will be populated with values from any bindings with text or JSON values. This means that if you have added cite33†environment variables , cite44†secrets , or cite127†version metadata bindings, these values can be accessed on `process.env`.\nL1471: \nL1472:     `const apiClient = ApiClient.new({ apiKey: process.env.API_KEY });\nL1473:     const LOG_LEVEL = process.env.LOG_LEVEL || \"info\";`\nL1474: This makes accessing these values easier and conforms to common Node.js patterns, which can reduce toil and help with compatibility for existing Node.js libraries.\nL1475: \nL1476: If users do not wish for these values to be accessible via `process.env`, they can use the `nodejs_compat_do_not_populate_process_env` flag. In this case, `process.env` will still be available, but will not have values automatically added.\nL1477: If the `disallow_importable_env` compatibility flag is set, the `process.env` will also not be populated.\nL1478: ### Queue consumers don't wait for `ctx.waitUntil()` to resolve\nL1479: \nL1480: Flag to enable  | `queue_consumer_no_wait_for_wait_until`\nL1481: \nL1482: By default, cite423†Queues Consumer Workers acknowledge messages only after promises passed to cite451†`ctx.waitUntil()` have resolved. This behavior can cause queue consumers which utilize `ctx.waitUntil()` to process messages slowly. The default behavior is documented in the cite452†Queues Consumer Configuration Guide .\nL1483: This Consumer Worker is an example of a Worker which utilizes `ctx.waitUntil()`. Under the default behavior, this consumer Worker will only acknowledge a batch of messages after the sleep function has resolved.\nL1484: \nL1485:     `export default {\nL1486:       async fetch(request, env, ctx) {\nL1487:         // omitted\nL1488:       },\nL1489: \nL1490:       async queue(batch, env, ctx) {\nL1491:         console.log(`received batch of ${batch.messages.length} messages to queue ${batch.queue}`);\nL1492:         for (let i = 0; i < batch.messages.length; ++i) {\nL1493:           console.log(`message #${i}: ${JSON.stringify(batch.messages[i])}`);\nL1494:         }\nL1495:         ctx.waitUntil(sleep(30 * 1000));\nL1496:       }\nL1497:     };\nL1498: \nL1499:     function sleep(ms) {\nL1500:       return new Promise(resolve => setTimeout(resolve, ms));\nL1501:     }`\nL1502: If the `queue_consumer_no_wait_for_wait_until` flag is enabled, Queues consumers will no longer wait for promises passed to `ctx.waitUntil()` to resolve before acknowledging messages. This can improve the performance of queue consumers which utilize `ctx.waitUntil()`. With the flag enabled, in the above example, the consumer Worker will acknowledge the batch without waiting for the sleep function to resolve.\nL1503: Using this flag will not affect the behavior of `ctx.waitUntil()`. `ctx.waitUntil()` will continue to extend the lifetime of your consumer Worker to continue to work even after the batch of messages has been acknowledged.\nL1504: ### Apply TransformStream backpressure fix\nL1505: \nL1506: Default as of  | 2024-12-16\nL1507: Flag to enable  | `fixup-transform-stream-backpressure`\nL1508: Flag to disable  | `original-transform-stream-backpressure`\nL1509: The original implementation of `TransformStream` included a bug that would cause backpressure signaling to fail after the first write to the transform. Unfortunately, the fix can cause existing code written to address the bug to fail. Therefore, the `fixup-transform-stream-backpressure` compat flag is provided to enable the fix.\nL1510: \nL1511: The fix is enabled by default with compatibility dates of 2024-12-16 or later.\n"},{"type":"input_text","text":"{\"chunk_id\":\"3dc4bb\",\"wall_time_seconds\":0.000007209,\"exit_code\":0,\"original_token_count\":1651,\"output\":\"/**\\n * Stateful lifecycle storage for MCP revisions before v2026-07-28.\\n *\\n * @internal\\n */\\nimport * as Effect from \\\"../../Effect.ts\\\"\\nimport type * as Headers from \\\"../../http/Headers.ts\\\"\\nimport * as LogLevel from \\\"../../LogLevel.ts\\\"\\nimport type * as PublicMcpProtocol from \\\"../McpProtocol.ts\\\"\\nimport * as PublicMcpSchema from \\\"../McpSchema.ts\\\"\\nimport type * as McpCore from \\\"./mcpCore.ts\\\"\\nimport * as McpProtocol from \\\"./mcpProtocol.ts\\\"\\n\\nconst MCP_SESSION_ID_HEADER = \\\"mcp-session-id\\\"\\n\\ntype SessionLogLevel =\\n  | { readonly _tag: \\\"Effect\\\"; readonly level: LogLevel.LogLevel }\\n  | { readonly _tag: \\\"Mcp\\\"; readonly level: PublicMcpSchema.LoggingLevel }\\n\\n/**\\n * @internal\\n */\\nexport interface Binding {\\n  readonly initializePayload: typeof PublicMcpSchema.Initialize.payloadSchema.Type\\n  readonly negotiatedProfile: McpCore.NegotiatedProtocolProfile\\n  readonly protocol: PublicMcpProtocol.ProtocolAdapter\\n}\\n\\ninterface Session extends Binding {\\n  readonly resourceSubscriptions: Set<string> | undefined\\n  logLevel: SessionLogLevel\\n}\\n\\n/**\\n * @internal\\n */\\nexport interface Registration extends Binding {\\n  readonly supportsResourceSubscriptions: boolean\\n  readonly logLevel: LogLevel.LogLevel\\n}\\n\\n/**\\n * @internal\\n */\\nexport interface StatefulRuntime {\\n  readonly registerHttp: (sessionId: string, registration: Registration) => Binding\\n  readonly registerConnection: (clientId: number, registration: Registration) => Binding\\n  readonly resolve: (clientId: number, headers: Headers.Headers) => Binding | undefined\\n  readonly resolveSessionId: (sessionId: string) => Binding | undefined\\n  readonly setLogLevel: (\\n    level: PublicMcpSchema.LoggingLevel,\\n    clientId: number,\\n    headers: Headers.Headers\\n  ) => Effect.Effect<void>\\n  readonly subscribe: (\\n    uri: string,\\n    clientId: number,\\n    headers: Headers.Headers\\n  ) => Effect.Effect<void, McpProtocol.ProtocolError>\\n  readonly unsubscribe: (\\n    uri: string,\\n    clientId: number,\\n    headers: Headers.Headers\\n  ) => Effect.Effect<void, McpProtocol.ProtocolError>\\n  readonly canDeliver: (\\n    clientId: number,\\n    headers: Headers.Headers,\\n    notification: McpCore.ServerNotification,\\n    fallbackLogLevel: LogLevel.LogLevel\\n  ) => boolean\\n  readonly effectLogLevel: (\\n    clientId: number,\\n    headers: Headers.Headers,\\n    fallback: LogLevel.LogLevel\\n  ) => LogLevel.LogLevel\\n  readonly markInitialized: (clientId: number) => void\\n  readonly initializedClientIds: () => Iterable<number>\\n  readonly disconnect: (clientId: number) => void\\n}\\n\\nconst makeSession = (registration: Registration): Session => ({\\n  initializePayload: registration.initializePayload,\\n  negotiatedProfile: registration.negotiatedProfile,\\n  protocol: registration.protocol,\\n  resourceSubscriptions: registration.supportsResourceSubscriptions ? new Set() : undefined,\\n  logLevel: { _tag: \\\"Effect\\\", level: registration.logLevel }\\n})\\n\\n/**\\n * @internal\\n */\\nexport const make = (): StatefulRuntime => {\\n  const bySessionId = new Map<string, Session>()\\n  const byClientId = new Map<number, Session>()\\n  const initializedClientIds = new Set<number>()\\n\\n  const resolveSession = (clientId: number, headers: Headers.Headers): Session | undefined => {\\n    const sessionId = headers[MCP_SESSION_ID_HEADER]\\n    return sessionId === undefined ? byClientId.get(clientId) : bySessionId.get(sessionId)\\n  }\\n\\n  const effectLogLevel = (\\n    clientId: number,\\n    headers: Headers.Headers,\\n    fallback: LogLevel.LogLevel\\n  ): LogLevel.LogLevel => {\\n    const session = resolveSession(clientId, headers)\\n    return session?.logLevel._tag === \\\"Mcp\\\"\\n      ? McpProtocol.mcpLogLevels[session.logLevel.level].effect\\n      : session?.logLevel.level ?? fallback\\n  }\\n\\n  return {\\n    registerHttp: (sessionId, registration) => {\\n      const session = makeSession(registration)\\n      bySessionId.set(sessionId, session)\\n      return session\\n    },\\n    registerConnection: (clientId, registration) => {\\n      const session = makeSession(registration)\\n      byClientId.set(clientId, session)\\n      return session\\n    },\\n    resolve: resolveSession,\\n    resolveSessionId: (sessionId) => bySessionId.get(sessionId),\\n    setLogLevel: (level, clientId, headers) =>\\n      Effect.sync(() => {\\n        const session = resolveSession(clientId, headers)\\n        if (session !== undefined) {\\n          session.logLevel = { _tag: \\\"Mcp\\\", level }\\n        }\\n      }),\\n    subscribe: (uri, clientId, headers) => {\\n      const subscriptions = resolveSession(clientId, headers)?.resourceSubscriptions\\n      if (subscriptions === undefined) {\\n        return Effect.fail(\\n          new McpProtocol.ProtocolError({\\n            code: PublicMcpSchema.METHOD_NOT_FOUND_ERROR_CODE,\\n            message: \\\"Resource subscriptions are not supported\\\"\\n          })\\n        )\\n      }\\n      return Effect.sync(() => subscriptions.add(uri)).pipe(Effect.asVoid)\\n    },\\n    unsubscribe: (uri, clientId, headers) => {\\n      const subscriptions = resolveSession(clientId, headers)?.resourceSubscriptions\\n      if (subscriptions === undefined) {\\n        return Effect.fail(\\n          new McpProtocol.ProtocolError({\\n            code: PublicMcpSchema.METHOD_NOT_FOUND_ERROR_CODE,\\n            message: \\\"Resource subscriptions are not supported\\\"\\n          })\\n        )\\n      }\\n      return Effect.sync(() => subscriptions.delete(uri)).pipe(Effect.asVoid)\\n    },\\n    effectLogLevel,\\n    canDeliver: (clientId, headers, notification, fallbackLogLevel) => {\\n      const session = resolveSession(clientId, headers)\\n      if (notification._tag === \\\"LoggingMessage\\\") {\\n        const minimum = session?.logLevel\\n        return minimum?._tag === \\\"Mcp\\\"\\n          ? McpProtocol.mcpLogLevels[notification.level].order >= McpProtocol.mcpLogLevels[minimum.level].order\\n          : LogLevel.isGreaterThanOrEqualTo(\\n            McpProtocol.mcpLogLevels[notification.level].effect,\\n            minimum?.level ?? fallbackLogLevel\\n          )\\n      }\\n      return notification._tag !== \\\"ResourceUpdated\\\" || session?.resourceSubscriptions?.has(notification.uri) === true\\n    },\\n    markInitialized: (clientId) => {\\n      initializedClientIds.add(clientId)\\n    },\\n    initializedClientIds: () => initializedClientIds.values(),\\n    disconnect: (clientId) => {\\n      byClientId.delete(clientId)\\n      initializedClientIds.delete(clientId)\\n    }\\n  }\\n}\\n) as any;\\n\\nexport type DurableObjectStub<Shape> = {\\n  // TODO(sam): do we need to transform? hopefully not\\n  [key in keyof Shape]: Shape[key];\\n} & {\\n  fetch: (\\n    request: HttpServerRequest.HttpServerRequest,\\n  ) => Effect.Effect<\\n    HttpServerResponse.HttpServerResponse,\\n    HttpServerError,\\n    never\\n  >;\\n};\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","create_time":1791338182.675464}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
