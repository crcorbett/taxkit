r',stderr,ehash)]:\n  p=(root/path).resolve()\n  if not p.is_relative_to(root/'tmp/release-readiness'):raise SystemExit('Unexpected detail path')\n  data=p.read_bytes();actual=hashlib.sha256(data).hexdigest()\n  if actual!=expected:raise SystemExit('Detail hash mismatch')\n  details[kind]={'path':path,'sha256':actual,'bytes':len(data)}\n checks.append({'id':id,'target':target,'command':commands[id],'exitCode':0,'terminalState':'success','sanitisedDetails':details})\nexpected=['verification','test','build','docs-validation','packed-artifact','downstream-consumer','api-smoke','docs-browser','changeset-status']\nif [r['id'] for r in checks]!=expected:raise SystemExit('Missing or reordered checks')\nrows=json.loads(Path('/private/tmp/dev77-browser-frozen-sources-a.json').read_text())\nif any(hashlib.sha256(Path(r['path']).read_bytes()).hexdigest()!=r['sha256'] for r in rows):raise SystemExit('Frozen source changed')\nrunner=json.loads(Path('/private/tmp/dev77-browser-frozen-release-a-results.jsonl').read_text().splitlines()[-1])\nif runner['exitCode']!=0:raise SystemExit('Failed wrapper')\nreceipt=Path('docs/documentation-audit/clean-slate-foundation/2026-10-07-browser-calculator-tools.json')\nx=json.loads(receipt.read_text());x['outcome']='Visible browser tools checkpoint passed the complete local nine-check graph; T006 remains in progress'\nx['candidate']['phase']='Frozen browser source a passed complete local CI-mode graph; final proof/plan closure is separately checked metadata'\nx['qualification']={'command':runner['command'],'exitCode':0,'durationSeconds':runner['durationSeconds'],'mode':'Report-only local CI graph; no release attempt or publication claim','wrapperLogIdentity':{'logId':log.name,'sha256':hashlib.sha256(log.read_bytes()).hexdigest(),'bytes':log.stat().st_size},'checks':checks,'sourceReadback':{'matched':len(rows),'mismatches':[],'afterWholeGraphBeforeClosure':True},'nativePair':{'files':9,'tests':13,'result':'All passed in complete verification and separate final built-app graph check'}}\nx['primaryReview']['result']='Static contracts, command/state parity, scope ownership, privacy and exact-path controls reviewed; complete frozen local nine-check graph passed'\nx['remaining']=['Commit/push/read back reviewable draft stacked on #156','Finish older MCP sessions, real remote cancellation and qualified public setup before T006 acceptance']\nx['parentHostedReadback']={'pr':156,'headSha':'4b349e0d1605687d0c5670af3edcd4ffdb82481e','runId':'37554420197','conclusion':'success','url':'https://github.com/crcorbett/taxkit/actions/runs/37554420197','scope':'Earlier remote-tools commit only; not this browser checkpoint'}\nx['postQualificationMetadata']={'paths':[str(receipt),'docs/exec-plans/active/clean-slate-foundation.md'],'scope':'Proof/plan closure only; tested application/configuration sources unchanged, closure checked separately before commit','checks':'Pending documentation/runbook/format checks'}\nreceipt.write_text(json.dumps(x,indent=2)+'\\n')\nplan=Path('docs/exec-plans/active/clean-slate-foundation.md')\nplan.write_text(plan.read_text()+f'''\\n\\nThe frozen visible-browser source passed all nine ordered local CI-mode checks\nin {runner['durationSeconds']} seconds. All eighteen exact returned stdout/stderr\nartifacts were read and hashed; all {len(rows)} frozen sources matched after the graph.\nComplete verification and the final fresh native app check both passed thirteen\ncases across nine files. The dated browser receipt owns sources, primary review,\nfailed focused attempts, corrections and exact detail/check identities.\n\nThis proof/plan closure is separately checked metadata. Tested commit/push and\nreviewable draft delivery stacked on #156 remain immediate work. The broader\nT006 task stays in progress for older remote sessions, actual remote cancellation\nand qualified public setup. Browser proof is native caller execution controlled\nby the test, not an autonomous model session, deployment or public availability.\nMetrics collection remains disabled and its approach deferred.\\n''')\nPath('/private/tmp/dev77-browser-qualification-summary.json').write_text(json.dumps(x['qualification'],indent=2)+'\\n')\nprint(json.dumps({'checks':len(checks),'detailsReadAndHashed':18,'frozenSourcesMatched':len(rows),'durationSeconds':runner['durationSeconds']}))\n{\n  \"document_type\": \"proof-receipt\",\n  \"lifecycle\": \"evidence\",\n  \"authority\": \"supporting\",\n  \"owner\": \"taxkit-implementation-owner\",\n  \"last_reviewed\": \"2026-10-07\",\n  \"review_trigger\": \"Browser tool contracts, page state, native host/caller, scope, receiving APIs or qualification change\",\n  \"outcome\": \"Focused actual native caller and saved-form browser checks passed; complete local graph is pending; T006 remains in progress\",\n  \"executionAuthority\": {\n    \"principal\": \"Cooper\",\n    \"scope\": \"Approved DEV-77 local implementation/checks, tested commit/push/draft PR and routine Linear tracking\",\n    \"excluded\": [\n      \"merge\",\n      \"deployment\",\n      \"publication\",\n      \"provider apply\",\n      \"credential changes\",\n      \"memory changes\"\n    ],\n    \"metrics\": \"Deferred; collection remains disabled\"\n  },\n  \"candidate\": {\n    \"repository\": \"crcorbett/taxkit\",\n    \"branch\": \"codex/dev-77-browser-tools\",\n    \"baseCommit\": \"4b349e0d1605687d0c5670af3edcd4ffdb82481e\",\n    \"phase\": \"Frozen browser source a; complete local CI-mode qualification pending\",\n    \"sources\": [\n      {\n        \"path\": \"apps/web/README.md\",\n        \"sha256\": \"b1343432cafc2d425fd05c43e5466fa1082bcfceca593e50c60ea0556cebb8cc\"\n      },\n      {\n        \"path\": \"apps/web/package.json\",\n        \"sha256\": \"96245085fd4ccba4a0093688af0327aa9c50e15b0af360e40de527bb5989d942\"\n      },\n      {\n        \"path\": \"apps/web/src/lib/browser-tools.atoms.ts\",\n        \"sha256\": \"ea465ae32e5acecc0f991036518bbdda57ef4d387e67abc1bee68c6cc