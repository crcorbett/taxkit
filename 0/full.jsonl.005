sumer','api-smoke','docs-browser','changeset-status']\\nif [r['id'] for r in checks]!=expected:raise SystemExit('Missing or reordered checks')\\nrows=json.loads(Path('/private/tmp/dev77-browser-frozen-sources-b.json').read_text())\\nif any(hashlib.sha256(Path(r['path']).read_bytes()).hexdigest()!=r['sha256'] for r in rows):raise SystemExit('Frozen source changed')\\nproof=json.loads(Path('/private/tmp/dev77-browser-frozen-proof-b.json').read_text())\\nif hashlib.sha256(Path(proof['path']).read_bytes()).hexdigest()!=proof['sha256']:raise SystemExit('Frozen proof metadata changed')\\nrunner=json.loads(Path('/private/tmp/dev77-browser-frozen-release-b-results.jsonl').read_text().splitlines()[-1])\\nif runner['exitCode']!=0:raise SystemExit('Failed wrapper')\\nreceipt=Path('docs/documentation-audit/clean-slate-foundation/2026-10-07-browser-calculator-tools.json')\\nx=json.loads(receipt.read_text());x['outcome']='Visible browser tools checkpoint passed the complete local nine-check graph; T006 remains in progress'\\nx['candidate']['phase']='Frozen corrected browser source b passed complete local CI-mode graph; final proof/plan closure is separately checked metadata'\\nx['qualification']={'command':runner['command'],'exitCode':0,'durationSeconds':runner['durationSeconds'],'mode':'Report-only local CI graph; no release attempt or publication claim','wrapperLogIdentity':{'logId':log.name,'sha256':hashlib.sha256(log.read_bytes()).hexdigest(),'bytes':log.stat().st_size},'checks':checks,'sourceReadback':{'matched':len(rows),'mismatches':[],'afterWholeGraphBeforeClosure':True,'preGraphProofIdentity':proof,'proofMatched':True},'nativePair':{'files':9,'tests':13,'result':'All passed in complete verification and separate final built-app graph check'}}\\nx['primaryReview']['result']='Static contracts, command/state parity, root-registry snapshot/page-execution lifetimes, privacy and exact-path controls reviewed; failed-graph root correction and strengthened direct oracle reviewed; 