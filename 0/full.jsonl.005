{"timestamp":"2026-10-07T02:52:14.031Z","ordinal":59943,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a11446-9b4e-7280-933c-cd974c63f360","call_id":"call_8037829883894519b6c262a2efb89e5d","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"123d65\",\"wall_time_seconds\":0.000006792,\"exit_code\":0,\"original_token_count\":1170,\"output\":\"        Req\\n      >,\\n      options?: {\\n        port?: number;\\n      },\\n    ) => Effect.Effect<\\n      void,\\n      never,\\n      Exclude<Req, HttpServerRequest> | Scope.Scope\\n    >;\\n  }\\n>()(\\\"HttpServer\\\") {}\\n\\nexport const safeHttpEffect = <Req = never>(\\n  handler: HttpEffect<Req> | Effect.Effect<HttpEffect<Req>>,\\n): Effect.Effect<\\n  HttpServerResponse.HttpServerResponse,\\n  never,\\n  Req | HttpServerRequest | Scope.Scope\\n> =>\\n  Effect.catchCause(\\n    handler.pipe(\\n      // @ts-expect-error\\n      Effect.flatMap((response) =>\\n        HttpServerResponse.isHttpServerResponse(response)\\n          ? Effect.succeed(response)\\n          : response,\\n      ),\\n    ) as any as HttpEffect<Req>,\\n    (cause) =>\\n      // `causeResponse` is effect's native failure boundary: Respondable\\n      // failures keep their intended response (e.g. RouteNotFound -> 404),\\n      // client aborts map to 499, and everything else becomes an empty 500 —\\n      // the cause is never echoed to the network, as it can contain sensitive\\n      // data (prompt contents, API keys baked into error messages, internal\\n      // file paths).\\n      causeResponse(cause).pipe(\\n        Effect.flatMap(([response, reportableCause]) =>\\n          Effect.withFiber((fiber) =>\\n            fiber.getRef(ErrorReporter.CurrentErrorReporters).size > 0\\n              ? ErrorReporter.report(reportableCause)\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:1468: *     fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:1509: *       fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:1683: *       fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:1744: *       fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:2057: *       fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:2183: *     fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:2240: *   fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:2254: *   fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:2273: *   fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:2301: *   fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:2319: *   fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:2340: *   fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/Worker.ts:2394: *   fetch: Effect.gen(function* () {\\nnode_modules/alchemy/src/Cloudflare/Workers/DurableObjectBridge.ts:198:                    Effect.runPromise(Scope.close(scope, Exit.void)),\\n// Private native platform/adapter preparation only; not TaxKit app acceptance.\\nimport { DurableObject } from \\\"cloudflare:workers\\\";\\nimport { Effect, Layer, Schema } from \\\"effect\\\";\\nimport { McpProtocol, McpServer, Tool, Toolkit } from \\\"effect/ai\\\";\\nimport { HttpRouter } from \\\"effect/http\\\";\\n\\nexport class SessionProbe extends DurableObject {\\n  started = 0;\\n  interrupted = 0;\\n  expired = false;\\n  server = this.makeServer();\\n  makeServer() {\\n    const toolkit = Toolkit.make(\\n      Tool.make(\\\"probe_read\\\", { parameters: Tool.EmptyParams, success: Schema.Struct({ kind: Schema.Literal(\\\"fixed\\\") }) }),\\n      Tool.make(\\\"probe_hold\\\", { parameters: Tool.EmptyParams, success: Schema.String })\\n    );\\n    const handlers = toolkit.toLayer({\\n      probe_read: () => Effect.succeed({ kind: \\\"fixed\\\" as const }),\\n      probe_hold: () => Effect.sync(() => { this.started++; }).pipe(Effect.andThen(Effect.never), Effect.onInterrupt(() => Effect.sync(() => { this.interrupted++; })))\\n    });\\n    const app = McpServer.toolkit(toolkit).pipe(\\n      Layer.provide(handlers),\\n      Layer.provide(McpServer.layerHttp({ name: \\\"private-native-session-probe\\\", version: \\\"0.0.0\\\", path: \\\"/mcp\\\", protocols: [McpProtocol.v2025_11_25] }))\\n    );\\n    return HttpRouter.toWebHandler(app, { disableLogger: true });\\n  }\\n  async fetch(request: Request) {\\n    const path = new URL(request.url).pathname;\\n    if (path === \\\"/status\\\") return Response.json({ started: this.started, interrupted: this.interrupted, expired: this.expired });\\n    if (path === \\\"/expire\\\") { this.expired = true; await this.server.dispose(); return new Response(null, { status: 204 }); }\\n    if (this.expired) return new Response(null, { status: 404 });\\n    return this.server.handler(request);\\n  }\\n}\\nexport default { fetch(request: Request, env: { OBJECT: DurableObjectNamespace }) { return env.OBJECT.getByName(\\\"fixed-native-host-fixture\\\").fetch(request); } };\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"16a2a7\",\"wall_time_seconds\":0.000007,\"exit_code\":0,\"original_token_count\":338,\"output\":\"node_modules/effect/src/ai/internal/mcpStatefulRuntime.ts:14:const MCP_SESSION_ID_HEADER = \\\"mcp-session-id\\\"\\nnode_modules/effect/src/ai/internal/mcpStatefulRuntime.ts:46:  readonly registerHttp: (sessionId: string, registration: Registration) => Binding\\nnode_modules/effect/src/ai/internal/mcpStatefulRuntime.ts:49:  readonly resolveSessionId: (sessionId: string) => Binding | undefined\\nnode_modules/effect/src/ai/internal/mcpState