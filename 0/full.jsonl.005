": \"/private/tmp/dev77-browser-description-green-c-lint.log\"}\n{\"stage\": \"browser\", \"command\": [\"bun\", \"run\", \"--cwd\", \"apps/web\", \"test:browser\"], \"exitCode\": 0, \"durationSeconds\": 5.39, \"log\": \"/private/tmp/dev77-browser-description-green-c-browser.log\"}\n{\"stage\": \"native-build\", \"command\": [\"bun\", \"run\", \"--cwd\", \"apps/web\", \"build:native-pair\"], \"exitCode\": 0, \"durationSeconds\": 15.42, \"log\": \"/private/tmp/dev77-browser-description-green-c-native-build.log\"}\n","stderr":"","aggregated_output":"{\"stage\": \"format\", \"command\": [\"bun\", \"x\", \"oxfmt\", \"-c\", \"oxfmt.config.ts\", \"apps/web/src/lib/calculator.atoms.ts\"], \"exitCode\": 0, \"durationSeconds\": 0.08, \"log\": \"/private/tmp/dev77-browser-description-green-c-format.log\"}\n{\"stage\": \"types\", \"command\": [\"bun\", \"run\", \"--cwd\", \"apps/web\", \"check-types\"], \"exitCode\": 0, \"durationSeconds\": 1.42, \"log\": \"/private/tmp/dev77-browser-description-green-c-types.log\"}\n{\"stage\": \"lint\", \"command\": [\"bun\", \"run\", \"lint\"], \"exitCode\": 0, \"durationSeconds\": 5.4, \"log\": \"/private/tmp/dev77-browser-description-green-c-lint.log\"}\n{\"stage\": \"browser\", \"command\": [\"bun\", \"run\", \"--cwd\", \"apps/web\", \"test:browser\"], \"exitCode\": 0, \"durationSeconds\": 5.39, \"log\": \"/private/tmp/dev77-browser-description-green-c-browser.log\"}\n{\"stage\": \"native-build\", \"command\": [\"bun\", \"run\", \"--cwd\", \"apps/web\", \"build:native-pair\"], \"exitCode\": 0, \"durationSeconds\": 15.42, \"log\": \"/private/tmp/dev77-browser-description-green-c-native-build.log\"}\n","exit_code":0,"duration":{"secs":27,"nanos":622267250},"formatted_output":"{\"stage\": \"format\", \"command\": [\"bun\", \"x\", \"oxfmt\", \"-c\", \"oxfmt.config.ts\", \"apps/web/src/lib/calculator.atoms.ts\"], \"exitCode\": 0, \"durationSeconds\": 0.08, \"log\": \"/private/tmp/dev77-browser-description-green-c-format.log\"}\n{\"stage\": \"