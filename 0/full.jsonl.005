onFailed extends Schema.TaggedError<WebsiteBrowserToolRegistrationFailed>()(\n  \"WebsiteBrowserToolRegistrationFailed\",\n  {\n    reason: Schema.Literals([\n      \"AbortError\",\n      \"DataCloneError\",\n      \"InvalidStateError\",\n      \"NotAllowedError\",\n      \"NotSupportedError\",\n      \"SecurityError\",\n      \"registration-timeout\",\n      \"unexpected-host-refusal\",\n    ]),\n    tool: Schema.String.check(Schema.isMaxLength(128)),\n  }\n) {}\n apps/web/README.md                                 |  39 +++++-\n apps/web/package.json                              |   1 +\n apps/web/src/lib/calculator-page.container.tsx     |  77 +++++------\n apps/web/src/lib/calculator.atoms.ts               | 154 ++++++++++++++++-----\n .../src/lib/calculator.boundary.browser.test.tsx   |  39 +++++-\n apps/web/src/lib/schemas.ts                        |  12 ++\n apps/web/src/lib/take-home.container.tsx           | 111 ++++++---------\n apps/web/src/routes/__root.tsx                     |  10 +-\n apps/web/src/routes/calculators.$calculatorId.tsx  |  20 +--\n apps/web/vitest.native.config.ts                   |   1 +\n bun.lock                                           |   3 +\n docs/architecture/frontend.md                      |  50 +++++--\n docs/architecture/testing-and-quality.md           |  29 ++++\n docs/documentation-audit/README.md                 |   8 ++\n docs/exec-plans/active/clean-slate-foundation.md   |  47 +++++++\n docs/standards/tooling.md                          |  11 ++\n oxlint.config.ts                                   |  17 +++\n tools/oxlint/portable-rules.test.ts                | 102 ++++++++++++++\n 18 files changed, 548 insertions(+), 183 deletions(-)\n","exit_code":0,"duration":{"secs":0,"nanos":6000},"formatted_output":"import { CalculatorCatalogResponse } from \"@taxkit/api-rpc/schemas\";\nimport { Schema } from \"effect\";\nimport { Tool, Toolkit } from \"effect/ai\";\n\nimport { WebsiteBrowserToolFailure } from \"./browser-tools.