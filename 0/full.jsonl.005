{"timestamp":"2026-10-07T02:29:10.225Z","ordinal":59478,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a11431-7dd1-7e22-897d-56174c0ba62e","call_id":"call_iZXlFPUTUXEkI2J9CSBC6T0l","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"20b862\",\"wall_time_seconds\":0.000009417,\"exit_code\":0,\"original_token_count\":1667,\"output\":\"650:const MCP_SESSION_ID_HEADER = \\\"mcp-session-id\\\"\\n729:    sessionHeaders: Headers.Headers | undefined\\n870:    const session = runtime.resolveRequest(client.id, headers)\\n872:    if (!isInitialize && !session) {\\n886:      return Effect.die(new Error(`Mcp-Session-Id does not exist`))\\n890:    // without a session have been rejected above.\\n891:    const initializePayload = session?.initializePayload ?? payload as typeof McpSchema.Initialize.payloadSchema.Type\\n893:    const selectedProtocol = session?.protocol ??\\n899:    const profile: McpCore.NegotiatedProtocolProfile = session?.negotiatedProfile ?? {\\n1027:              const session = prepared.binding\\n1030:              // their session's adapter; modern requests carry their own version.\\n1034:                sessionHeaders: isHttp && headers[MCP_SESSION_ID_HEADER] !== undefined\\n1036:                  : clientState?.sessionHeaders\\n1045:              if (httpRequest !== undefined && session !== undefined) {\\n1051:                      session.protocol.protocolVersion\\n1059:                if (!session && selectedProtocol.runtime._tag === \\\"Stateful\\\") {\\n1081:                      if (session === undefined) {\\n1084:                      // Each HTTP POST has its own transport ID, but cancellation belongs to the session.\\n1086:                        requests.get(key)?.prepared.binding === session\\n1171:            const session = isHttp\\n1179:              isHttp ? key.profile === session?.negotiatedProfile : key.clientId === clientId\\n1231:          // HTTP UUID sessions are stored separately and outlive request-scoped client IDs.\\n1276:            notification._tag === \\\"Progress\\\" && selectedProtocol.runtime._tag === \\\"Stateless\\\" &&\\n1281:          if (notification._tag === \\\"LoggingMessage\\\" && selectedProtocol.runtime._tag === \\\"Stateless\\\") {\\n1299:                clientStates.get(clientId)?.sessionHeaders ?? Headers.empty,\\n1368: * Unlike `layerStdio` and `layerHttp`, this layer does not install a concrete\\n1373: * @see {@link layerHttp} for an HTTP-backed layer that registers with `HttpRouter` and installs JSON-RPC serialization\\n1431: * @see {@link layerHttp} for the single-endpoint HTTP transport\\n1537: * `layerHttp` always implements the single-endpoint Streamable HTTP topology.\\n1540: * HTTP+SSE transport, GET SSE, event resumption, session expiry, or client\\n1541: * session termination.\\n1550:export const layerHttp = (options: {\\n27:const MCP_SESSION_ID_HEADER = \\\"mcp-session-id\\\"\\n233:    const sessionId = headers[MCP_SESSION_ID_HEADER]\\n302:    const binding = sessionId === undefined ? undefined : stateful?.resolveSessionId(sessionId)\\n303:    if (sessionId !== undefined && binding === undefined) {\\n492:          return yield* Effect.die(\\\"MCP sessionful runtime invariant failed\\\")\\n525:                const sessionId = crypto.randomUUID()\\n526:                stateful.registerHttp(sessionId, registration)\\n531:                      [MCP_SESSION_ID_HEADER]: sessionId,\\n          }\\n          const encoded = parser.encode(response)\\n          if (typeof encoded !== \\\"string\\\") return encoded\\n          if (cancelledIds.size === 0 && !encoded.includes(\\\"\\\\\\\"_tag\\\\\\\":\\\\\\\"Cause\\\\\\\"\\\")) return encoded\\n          let message: unknown = JSON.parse(encoded)\\n          if (cancelledIds.size > 0) {\\n            // Count cancelled completions toward the batch, but never write their responses.\\n            // https://modelcontextprotocol.io/specification/2025-03-26/basic/utilities/cancellation\\n            const keep = (message: unknown) =>\\n              !(Predicate.isReadonlyObject(message) && !Predicate.hasProperty(message, \\\"method\\\") &&\\n                (typeof message.id === \\\"string\\\" || typeof message.id === \\\"number\\\") && cancelledIds.delete(message.id))\\n            if (Array.isArray(message)) {\\n              const remaining = message.filter(keep)\\n              if (remaining.length === 0) return undefined\\n              message = remaining\\n            } else if (!keep(message)) {\\n              return undefined\\n            }\\n          }\\n          return JSON.stringify(normalizeMcpJsonRpcResponse(message))\\n        }\\n      }\\n    }\\n  })\\n}\\n\\nconst toServerSentEvents = (response: HttpServerResponse.HttpServerResponse) => {\\n  const encoder = new TextEncoder()\\n  const decoder = new TextDecoder()\\n  const frame = (data: Uint8Array) =>\\n    encoder.encode(decoder.decode(data).trimEnd().split(\\\"\\\\n\\\").map((message) => `data: ${message}\\\\n\\\\n`).join(\\\"\\\"))\\n  const options = {\\n    status: response.status,\\n    statusText: response.statusText,\\n    headers: Headers.remove(response.headers, \\\"content-type\\\"),\\n    cookies: response.cookies,\\n    contentType: \\\"text/event-stream\\\"\\n  }\\n  if (response.body._tag === \\\"Stream\\\") {\\n    return HttpServerResponse.stream(response.body.stream.pipe(Stream.map(frame)), options)\\n  }\\n  if (response.body._tag === \\\"Uint8Array\\\") {\\n    return HttpServerResponse.uint8Array(frame(response.body.body), options)\\n  }\\n  return HttpServerResponse.setHeader(response, \\\"content-type\\\", \\\"text/event-stream\\\")\\n}\\n\\nconst isAllowedMcpOrigin = (\\n  request: HttpServerRequest.HttpServerRequest,\\n  allowedOrigins: ReadonlyArray<string> | undefined\\n): boolean => {\\n  const origin = request.headers[\\\"origin\\\"]\\n  return origin === undefined || (allowedOrigins ?? []).includes(origin)\\n}\\n\\nconst mcpMediaTypes = (header: string | undefined): ReadonlyArray<string> =>\\n  header === undefined\\n    ? []\\n    : header.split(\\\",\\\").flatMap((part) => {\\n      const [mediaType, ...parameters] = part.split(\\\";\\\")\\n      const quality = parameters\\n        .map((parameter) => parameter.trim().toLowerCase())\\n        .find((parameter) => parameter.startsWith(\\\"q=\\\"))\\n      if (quality !== undefined) {\\n        const value = Number(quality.slice(2))\\n        if (!Number.isFinite(value) || value <= 0 || value > 1) {\\n          return []\\n        }\\n      }\\n      return [mediaType.trim().toLowerCase()]\\n    })\\n\\nconst InitializeJsonRpcMessage = Schema.Struct({\\n  method: Schema.Literal(\\\"initialize\\\")\\n})\\n\\nconst isInitializeJsonRpcMessage = (message: unknown): boolean =>\\n  Result.isSuccess(Schema.decodeUnknownResult(InitializeJsonRpcMessage)(message))\\n\\nconst JsonRpcProtocolVersion = Schema.Struct({\\n  params: Schema.Struct({\\n    protocolVersion: Schema.String\\n  })\\n})\\n\\nconst getJsonRpcProtocolVersion = (message: unknown): string | undefined => {\\n  const decoded = Schema.decodeUnknownResult(JsonRpcProtocolVersion)(message)\\n  return Result.isSuccess(decoded) ? decoded.success.params.protocolVersion : undefined\\n}\\n\\nconst INTERNAL_TOOL_ERROR_MESSAGE = \\\"Tool execution failed due to an internal server error.\\\"\\n$ bun run --filter=@taxkit/scripts release:check --ci\\n@taxkit/scripts release:check: RUN  [verification] bun run verification\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","create_time":1791340150.225905}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
