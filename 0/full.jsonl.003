*/\n237-  dynamic?: boolean;\n238-}\n239-interface IndexFilePlugin {\n240-  ['index-file']?: {\n241-    generateTypeConfig?: (this: PluginContext) => string | void;\n242-  };\n243-}\n244-declare function indexFile(options?: IndexFilePluginOptions): Plugin;\n245-//#endregion\n246-//#region src/macro/eval.d.ts\n247-interface MacroEvaluatorOptions {\n248-  /**\n249-   * absolute path of the entry module\n250-   */\n251-  entry: string;\n252-  /**\n253-   * Apply the config-mode transform on a module of the graph.\n254-   *\n255-   * @returns `null` when it's not a macro module.\n256-   */\n257-  transform: (code: string, file: string) => Promise<string | null>;\n258-}\n259-type MacroEvaluator = (options: MacroEvaluatorOptions) => Promise<{\n260-  /**\n261-   * absolute paths of evaluated modules, for cache invalidation\n262-   */\n263-  inputs: string[];\n264-}>;\n265-interface MacroCollectorOptions {\n266-  root: string;\n267-  outDir: string;\n268-  isDev: boolean;\n269-  evaluator: MacroEvaluator;\n270-}\n271-interface ResolvedMacroCollection {\n272-  collection: CollectionItem;\n273-  /**\n274-   * absolute paths of modules involved, add them as dependencies for invalidation\n275-   */\n276-  inputs: string[];\n277-}\n278-/**\n279- * Collects macro collections declared across the app, keyed by macro id\n280- * (`<module path relative to root>#<variable name>`).\n--\n369:interface CoreOptions {\n370-  root?: string;\n371-  environment: string;\n372-  plugins?: PluginOption[];\n373-  /**\n374-   * @defaultValue source.config.ts\n375-   */\n376-  configPath?: string;\n377-  /**\n378-   * Output directory of generated files\n379-   *\n380-   * @defaultValue '.source'\n381-   */\n382-  outDir?: string;\n383-  /**\n384-   * the workspace info if this instance is created as a workspace\n385-   */\n386-  workspace?: {\n387-    parent: Core;\n388-    name: string;\n389-    dir: string;\n390-  };\n391-}\n392-interface EmitOptions {\n393-  /**\n394-   * filter the plugins to 