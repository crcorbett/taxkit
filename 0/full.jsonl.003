{"timestamp":"2026-10-06T04:49:06.927Z","ordinal":37804,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a10e2a-6616-7a42-8b17-50e4af22487f","item":{"type":"CommandExecution","id":"exec-738b905b-1207-439f-976f-51c042509612","process_id":"92269","command":["/bin/zsh","-lc","cat packages/infrastructure/src/apps-stack.ts; cat packages/infrastructure/src/stage.ts; cat node_modules/alchemy/src/Cloudflare/Workers/RateLimit.ts; cat packages/infrastructure/src/cloudflare/website.ts; cat packages/calculators/src/schemas.ts | tail -110; cat .agents/skills/alchemy-iac/references/providers/cloudflare.md | head -160; tail -10 /private/tmp/dev75-domain-closeout-full-release-ci-graph.log"],"cwd":"file:///Users/cooper/.codex/worktrees/aac7/taxkit","parsed_cmd":[{"type":"unknown","cmd":"cat packages/infrastructure/src/apps-stack.ts; cat packages/infrastructure/src/stage.ts; cat node_modules/alchemy/src/Cloudflare/Workers/RateLimit.ts; cat packages/infrastructure/src/cloudflare/website.ts; cat packages/calculators/src/schemas.ts | tail -110; cat .agents/skills/alchemy-iac/references/providers/cloudflare.md | head -160; tail -10 /private/tmp/dev75-domain-closeout-full-release-ci-graph.log"}],"source":"unified_exec_startup","status":"completed","stdout":"import * as Website from \"alchemy/Cloudflare/Website\";\nimport { Worker } from \"alchemy/Cloudflare/Workers\";\nimport * as Output from \"alchemy/Output\";\nimport {\n  ApiWorkerInit,\n  ApiWorkerObservability,\n  TaxKitApiWorker,\n} from \"api/worker\";\nimport { Effect, Option } from \"effect\";\n\n// A forward API tag registers before its implementation Layer finishes. The\n// native planner retains both address Outputs, including the binding cycle.\nexport class TaxKitWebsite extends Website.Vite<TaxKitWebsite>()(\n  \"TaxKitWebsite\",\n  Effect.gen(function* () {\n    const api = yield* TaxKitApiWorker;\n    const apiOrigin = api.url.pipe(\n      Output.map((url) => Option.getOrNull(Option.fromNullishOr(url)))\n    );\n    return {\n      compatibility: {\n        date: \"2026-10-04\",\n        flags: [\"nodejs_compat\"],\n      },\n      env: {\n        API_PUBLIC_ORIGIN: apiOrigin,\n        TAXKIT_API: api,\n        WEBSITE_PUBLIC_ORIGIN: Worker.URL,\n      },\n      // The Website's platform records can include caller URLs independently\n      // of its fixed application reporter. Qualified exporters remain pending.\n      observability: {\n        enabled: false,\n        headSamplingRate: 0,\n        logs: {\n          enabled: false,\n          headSamplingRate: 0,\n          invocationLogs: false,\n          persist: false,\n        },\n        traces: { enabled: false, headSamplingRate: 0, persist: false },\n      },\n      rootDir: \"apps/web\",\n      workersDev: true,\n    };\n  })\n) {}\n\nconst NativeApiHostLive = TaxKitApiWorker.make(\n  Effect.gen(function* () {\n    const website = yield* TaxKitWebsite;\n    return {\n      compatibility: {\n        date: \"2026-10-04\",\n        flags: [\"nodejs_compat\"],\n      },\n      env: {\n        API_PUBLIC_ORIGIN: Worker.URL,\n        WEBSITE_PUBLIC_ORIGIN: website.url.pipe(\n          Output.map((url) => Option.getOrNull(Option.fromNullishOr(url)))\n        ),\n      },\n      // The app export owns its native entry; the graph crosses the workspace\n      // through that export rather than a relative filesystem import.\n      main: import.meta.resolve(\"api/worker\"),\n      observability: ApiWorkerObservability,\n      workersDev: true,\n    };\n  }),\n  ApiWorkerInit\n);\n\nexport const declareNativeAppsStack = Effect.gen(function* () {\n  const api = yield* TaxKitApiWorker;\n  const website = yield* TaxKitWebsite;\n  return { apiUrl: api.url, websiteUrl: website.url };\n}).pipe(Effect.provide(NativeApiHostLive));\nimport * as Schema from \"effect/Schema\";\n\nconst PreviewStage = Schema.String.check(Schema.isPattern(/^pr-[1-9]\\d*$/u));\n\nexport const DocsLocalDevelopmentStage = Schema.String.check(\n  Schema.isPattern(/^dev_[a-z0-9]+(?:[-_a-z0-9]+)*$/iu)\n).pipe(Schema.brand(\"taxkit/LocalDocsDevelopmentStage\"));\n\nexport const DocsDeploymentStage = Schema.Union([\n  Schema.Literals([\"prod\"]),\n  PreviewStage,\n]).pipe(Schema.brand(\"taxkit/DocsDeploymentStage\"));\nimport type * as cf from \"@cloudflare/workers-types\";\nimport * as Data from \"effect/Data\";\nimport type * as Effect from \"effect/Effect\";\nimport type { RuntimeContext } from \"../../RuntimeContext.ts\";\nimport * as Binding from \"./Binding.ts\";\nimport type { RateLimitBinding } from \"./RateLimitBinding.ts\";\n\nconst TypeId = \"Cloudflare.RateLimit\" as const;\ntype TypeId = typeof TypeId;\n\nexport type RateLimitPeriod = 10 | 60;\n\nexport class RateLimitError extends Data.TaggedError(\"RateLimitError\")<{\n  message: string;\n  cause: unknown;\n}> {}\n\n/**\n * Effect-native client for a Cloudflare Rate Limit binding. Wraps the runtime\n * `cf.RateLimit` so `limit` returns an `Effect` tagged with {@link RateLimitError}.\n */\nexport interface RateLimitClient {\n  /** Effect resolving to the raw Cloudflare runtime binding. */\n  raw: Effect.Effect<cf.RateLimit, never, RuntimeContext>;\n  limit(\n    options: Parameters<cf.RateLimit[\"limit\"]>[0],\n  ): Effect.Effect<\n    Awaited<ReturnType<cf.RateLimit[\"limit\"]>>,\n    RateLimitError,\n    RuntimeContext\n  >;\n}\n\nexport type RateLimitProps = {\n  /**\n   * Positive integer or string that uniquely identifies this rate limit\n   * configuration.\n   */\n  namespaceId: number | string;\n  /** Simple rate limiting configuration. */\n  simple: {\n    /** The number of requests allowed within the period. */\n    limit: number;\n    /** The period, in seconds, over which requests are counted. */\n    period: RateLimitPeriod;\n  };\n};\n\n/**\n * A Cloudflare Rate Limit binding for counting arbitrary keys inside Workers — a\n * Worker-only binding with no backing cloud resource.\n *\n * `RateLimit` is a single value that is at once the `Binding.Service` tag, the\n * callable that produces a {@link RateLimitBinding}, and the type. Declare it on\n * a Worker's `env` (it flows through `InferEnv` → the native `cf.RateLimit`) or\n * `yield*` it inside an Effect-native Worker to attach the binding and obtain\n * the {@link RateLimitClient}.\n *\n * ### Declaring on a Worker's env\n * **Example:** Async (non-Effect) Worker\n * ```typescript\n * export const Worker = Cloudflare.Worker(\"Worker\", {\n *   main: \"./src/worker.ts\",\n *   env: {\n *     THROTTLE: Cloudflare.RateLimit(\"THROTTLE\", {\n *       namespaceId: 1001,\n *       simple: { limit: 10, period: 60 },\n *     }),\n *   },\n * });\n *\n * export type WorkerEnv = Cloudflare.InferEnv<typeof Worker>;\n * //   { THROTTLE: RateLimit } — the native Cloudflare binding\n *\n * // worker.ts\n * export default {\n *   fetch: async (req: Request, env: WorkerEnv) => {\n *     const { success } = await env.THROTTLE.limit({ key: \"ip\" });\n *     return new Response(success ? \"ok\" : \"rate limited\");\n *   },\n * };\n * ```\n *\n * ### Binding inside an Effect-native Worker\n * **Example:** yield* RateLimit does the binding\n * ```typescript\n * Cloudflare.Worker(\"Worker\", { main: \"./src/worker.ts\" },\n *   Effect.gen(function* () {\n *     // Attaches the binding to this Worker AND returns the runtime client.\n *     const throttle = yield* Cloudflare.RateLimit(\"THROTTLE\", {\n *       namespaceId: 1001,\n *       simple: { limit: 10, period: 60 },\n *     });\n *\n *     return {\n *       fetch: Effect.gen(function* () {\n *         const { success } = yield* throttle.limit({ key: \"ip\" });\n *         return HttpServerResponse.text(success ? \"ok\" : \"rate limited\");\n *       }),\n *     };\n *   }).pipe(Effect.provide(Cloudflare.Workers.RateLimitBinding)),\n * );\n * ```\n *\n * @see https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/\n *\n * @binding\n * @product Rate Limiting\n * @category Application Security\n */\nexport interface RateLimit extends Binding.Service<\n  RateLimit,\n  TypeId,\n  RateLimitClient\n> {\n  /**\n   * @param name Binding name (logical id) — the `env` key it resolves to.\n   * @param props Rate limit namespace + simple config.\n   */\n  (name: string, props: RateLimitProps): RateLimitBinding;\n}\n\nexport const RateLimit = Binding.Service<\n  RateLimit,\n  { namespaceId: string; simple: { limit: number; period: RateLimitPeriod } }\n>({\n  id: TypeId,\n  defaultName: \"RATE_LIMIT\",\n  parse: (name: string, props: RateLimitProps) => ({\n    name,\n    namespaceId: String(props.namespaceId),\n    simple: props.simple,\n  }),\n  toWorkerBinding: (binding) => ({\n    type: \"ratelimit\",\n    name: binding.name,\n    namespaceId: binding.namespaceId,\n    simple: binding.simple,\n  }),\n});\n\nexport const isRateLimit = (value: unknown): value is RateLimitBinding =>\n  Binding.isBinding(value) && value.kind === TypeId;\nimport * as Config from \"effect/Config\";\nimport * as Effect from \"effect/Effect\";\nimport * as Schema from \"effect/Schema\";\n\nimport { DocsDeploymentStage, DocsLocalDevelopmentStage } from \"../stage.js\";\n\nexport const DocsCloudflareStackStage = Schema.Union([\n  DocsDeploymentStage,\n  DocsLocalDevelopmentStage,\n]);\n\nexport type DocsCloudflareStackStage = typeof DocsCloudflareStackStage.Type;\n\nexport const docsCloudflareStackName = \"TaxKitDocsCloudflare\";\nexport const docsWorkerResourceId = \"DocsWebsite\";\nexport const docsWorkerCompatibilityDate = \"2026-06-24\";\nexport const docsWorkerCompatibilityFlags = [\"nodejs_compat\"] as const;\nexport const docsWorkerAssetHeaders =\n  \"/assets/*\\n  Cache-Control: public, max-age=31536000, immutable\\n\";\nexport const docsWorkerMemo = {\n  include: [\"**/*\"],\n  lockfile: true,\n  workspaces: [\n    {\n      cwd: \"../../packages/docs-content\",\n      include: [\"**/*\"],\n      lockfile: false,\n    },\n    {\n      cwd: \"../../packages/docs-fumadocs\",\n      include: [\"**/*\"],\n      lockfile: false,\n    },\n  ],\n} as const;\n\nexport const decodeDocsCloudflareStackStage = (\n  value: typeof Schema.Unknown.Type\n) =>\n  Schema.decodeUnknownEffect(DocsCloudflareStackStage)(value).pipe(\n    Effect.mapError((error) => new Config.ConfigError(error))\n  );\n\nexport const docsWorkerObservability = {\n  enabled: true,\n  headSamplingRate: 1,\n  logs: {\n    enabled: true,\n    headSamplingRate: 1,\n    invocationLogs: true,\n    persist: true,\n  },\n  traces: {\n    enabled: false,\n    headSamplingRate: 0,\n    persist: false,\n  },\n} as const;\n  facts: CalculatorRunFacts,\n  ...OptionalCalculatorContextFields,\n});\n\nexport type CalculatorRunRequest = typeof CalculatorRunRequest.Type;\n\n/**\n * Service-level calculation request after route params, query params and JSON\n * body have been decoded by the HTTP API package.\n */\nexport const CalculatorRunServiceRequest = Schema.Struct({\n  calculatorId: CalculatorId,\n  help: Schema.OptionFromOptionalKey(\n    Schema.OptionFromUndefinedOr(HelpMode)\n  ).pipe(Schema.withConstructorDefault(Effect.succeedNone)),\n  payload: CalculatorRunRequest,\n});\n\nexport type CalculatorRunServiceRequest =\n  typeof CalculatorRunServiceRequest.Type;\n\nexport const CalculatorRunReport = Schema.Union([\n  TakeHomePayReport,\n  PayWithholdingsLedger,\n  AnnualTaxReport,\n]);\n\nexport type CalculatorRunReport = typeof CalculatorRunReport.Type;\n\n/**\n * Calculator run response with catalog metadata, diagnostics and the typed\n * calculator-specific report.\n */\nexport const CalculatorRunResponse = Schema.Struct({\n  calculator: CalculatorCatalogItem,\n  diagnostics: CalculationDiagnostics,\n  report: CalculatorRunReport,\n});\n\nexport type CalculatorRunResponse = typeof CalculatorRunResponse.Type;\n\nexport class CalculatorCatalogResponseData extends Data.Class<CalculatorCatalogResponse> {}\n\nexport class CalculatorRunResponseData extends Data.Class<CalculatorRunResponse> {}\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunFacts`.\n */\nexport const PublicCalculationFacts = CalculatorRunFacts.annotate({\n  title: \"PublicCalculationFacts\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunFacts`.\n */\nexport type PublicCalculationFacts = CalculatorRunFacts;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunRequest`.\n */\nexport const PublicCalculationRequest = CalculatorRunRequest.annotate({\n  title: \"PublicCalculationRequest\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunRequest`.\n */\nexport type PublicCalculationRequest = CalculatorRunRequest;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunServiceRequest`.\n */\nexport const PublicCalculationServiceRequest =\n  CalculatorRunServiceRequest.annotate({\n    title: \"PublicCalculationServiceRequest\",\n  });\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunServiceRequest`.\n */\nexport type PublicCalculationServiceRequest = CalculatorRunServiceRequest;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunReport`.\n */\nexport const PublicCalculationReport = CalculatorRunReport.annotate({\n  title: \"PublicCalculationReport\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunReport`.\n */\nexport type PublicCalculationReport = CalculatorRunReport;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunResponse`.\n */\nexport const PublicCalculationResponse = CalculatorRunResponse.annotate({\n  title: \"PublicCalculationResponse\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunResponse`.\n */\nexport type PublicCalculationResponse = CalculatorRunResponse;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunResponseData`.\n */\nexport class PublicCalculationResponseData extends CalculatorRunResponseData {}\n# Cloudflare\n\n## Contents\n\n- [Ownership decisions](#ownership-decisions)\n- [File ownership](#file-ownership)\n- [Worker and asset semantics](#worker-and-asset-semantics)\n- [Routes zones and domains](#routes-zones-and-domains)\n- [Bindings and storage](#bindings-and-storage)\n- [Website origin rules](#website-origin-rules)\n- [Secrets](#secrets)\n- [Observability](#observability)\n- [State](#state)\n- [Readback checklist](#readback-checklist)\n\n## Ownership decisions\n\nDeclare which system owns each Cloudflare lifecycle:\n\n- Worker or static-asset deployment;\n- routes and custom domains;\n- DNS/zone configuration;\n- R2, D1, KV, Durable Objects, Queues, or Secrets Store;\n- environment secrets and bindings;\n- logs, metrics, traces, and observability destinations;\n- remote state infrastructure.\n\nDo not assume Alchemy owns all Cloudflare resources because it owns one Worker.\n\n## File ownership\n\nFor a small graph:\n\n```text\nsrc/lib/build/cloudflare.ts\n```\n\nFor a substantial graph:\n\n```text\nsrc/lib/build/cloudflare/\n  stack.ts\n  website.ts\n  worker.ts\n  storage.ts\n  routes.ts\n  secrets.ts\n  observability.ts\n```\n\nKeep stage/config Schemas outside provider declarations when other providers share them.\n\n## Worker and asset semantics\n\nMake asset routing policy explicit. In particular, distinguish asset-first and Worker-first behaviour and test the intended choice. A deployed Worker and green CI do not prove that static assets return the correct content type or bypass the Worker.\n\nTest:\n\n- root document;\n- hashed CSS and JavaScript assets;\n- missing assets;\n- API paths;\n- redirects;\n- cache headers;\n- content types;\n- route precedence.\n\nRecord compatibility date, compatibility flags, runtime limits, module format, and bundler inputs in a stable typed owner. Keep application and deployment configuration aligned through one contract or an invariant test.\n\n## Routes, zones, and domains\n\nTreat a zone or domain as foreign unless this repository creates and owns it.\n\n- Read the target zone before applying routes.\n- Adopt only under explicit authority.\n- Default adopted zones and routes to retain.\n- Restrict Production route adoption to the Production stage.\n- Reject a route whose account/zone does not match the authority record.\n- Read back the route pattern and bound Worker after apply.\n- Prove the public host independently.\n\nDo not infer route correctness from a Worker URL.\n\n## Bindings and storage\n\nModel each binding as typed desired state:\n\n- binding name;\n- resource kind;\n- physical resource identity;\n- stage/environment;\n- creation/adoption policy;\n- removal policy.\n\nAssert that application code and deployment configuration use the same binding names. For Durable Objects, include class name, migration/tag policy, and deployment sequencing. For R2/D1/KV, make data retention explicit and default destructive deletion to forbidden until authorised.\n\n## Website origin rules\n\nAn origin is the protocol and host, with an optional port, such as\n`http://127.0.0.1:3210`. The deployed host owns that address. Applications must\nnever hard-code it or build it from a stage, Worker name, account subdomain,\ncustom domain or development port.\n\nFor Alchemy `2.0.0-beta.79`, use the native self URL binding on the host that\nneeds its own address:\n\n```typescript\nconst website =\n  yield *\n  Cloudflare.Website.Vite(\"Website\", {\n    rootDir: \"apps/web\",\n    env: { PUBLIC_ORIGIN: Cloudflare.Worker.URL },\n  });\n\n// The same binding works in a native Worker declaration.\nconst api =\n  yield *\n  Cloudflare.Worker(\"Api\", {\n    main: \"./src/worker.ts\",\n    env: { PUBLIC_ORIGIN: Cloudflare.Worker.URL },\n  });\n```\n\nAlchemy resolves this binding to the local development proxy during local\ndevelopment, the deployed `workers.dev` address, or the configured custom\ndomain. Do not add separate local/cloud address formulas or a copied-address\nfallback. For Vite browser code, a `VITE_`-prefixed self URL binding uses the\nsame native resolution before the client bundle is built.\n\nIt is valid to declare a chosen custom domain as infrastructure input, for\nexample `domain: \"app.example.com\"`. Keep the application's own\n`PUBLIC_ORIGIN` bound to `Cloudflare.Worker.URL`; do not repeat that domain in\nits environment or build `\"https://\" + domain` there. Aliases and incoming\nrequest origins are separate from the host's configured canonical address.\n\nFor a different host, use that resource's native Output, such as `api.url`.\nPass the Output to the receiving resource; check its resolved value with the\nowning Schema when application code reads the binding. If the native address\ncan be absent, preserve that absence as `null` for an env binding and reject it\nwith the Schema. Do not replace an absent Output with a guessed address.\n\nKeep expected validation failures typed. Beta.79's `Output.mapEffect` callback\naccepts no expected errors, so do not force Schema decoding into it with\n`Effect.orDie`. `Output.map` may select a checked resource attribute or represent\nabsence; it must not reconstruct the hostname. Resolve and decode Outputs\nseparately before writing workflow or receipt values.\n\nCheck the selected Alchemy version's self URL, Vite, native Worker and local\nprovider APIs before copying this example. See the\n[matching primary sources](../sources.md#cloudflare-website-origins).\nLocal source/type checks do not prove live domain routing.\n\n## Separate Website and native API Workers\n\nUse standard Website.Vite for the frontend and a native Effect Worker for the\nAPI. The root stack deploys both with exact same-stage service/public bindings.\nPreview has its own API; a Website preview parent does not authorise using the\nProduction API. Do not wrap TanStack in a backend Worker or recreate an API\nruntime around the native incoming request fibre.\n\n@taxkit/scripts release:check: $ turbo run //#lint:task\n@taxkit/scripts release:check: $ turbo run //#format:check:task\n@taxkit/scripts release:check: //#format:check:task:  ERROR  command (<home>/.codex/worktrees/aac7/taxkit/) /private/tmp/taxkit-local-toolchain/bun-darwin-aarch64/bun run format:check:task exited (1)\n@taxkit/scripts release:check:  ERROR  run failed: command  exited (1)\n@taxkit/scripts release:check: error: script \"format:check\" exited with code 1\n@taxkit/scripts release:check: error: script \"verification\" exited with code 1\n@taxkit/scripts release:check: \n@taxkit/scripts release:check: recovery: repair the named local boundary and rerun CI; no candidate or attempt receipt exists in CI mode.\n@taxkit/scripts release:check: Exited with code 1\nerror: script \"release:check\" exited with code 1\n","stderr":"","aggregated_output":"import * as Website from \"alchemy/Cloudflare/Website\";\nimport { Worker } from \"alchemy/Cloudflare/Workers\";\nimport * as Output from \"alchemy/Output\";\nimport {\n  ApiWorkerInit,\n  ApiWorkerObservability,\n  TaxKitApiWorker,\n} from \"api/worker\";\nimport { Effect, Option } from \"effect\";\n\n// A forward API tag registers before its implementation Layer finishes. The\n// native planner retains both address Outputs, including the binding cycle.\nexport class TaxKitWebsite extends Website.Vite<TaxKitWebsite>()(\n  \"TaxKitWebsite\",\n  Effect.gen(function* () {\n    const api = yield* TaxKitApiWorker;\n    const apiOrigin = api.url.pipe(\n      Output.map((url) => Option.getOrNull(Option.fromNullishOr(url)))\n    );\n    return {\n      compatibility: {\n        date: \"2026-10-04\",\n        flags: [\"nodejs_compat\"],\n      },\n      env: {\n        API_PUBLIC_ORIGIN: apiOrigin,\n        TAXKIT_API: api,\n        WEBSITE_PUBLIC_ORIGIN: Worker.URL,\n      },\n      // The Website's platform records can include caller URLs independently\n      // of its fixed application reporter. Qualified exporters remain pending.\n      observability: {\n        enabled: false,\n        headSamplingRate: 0,\n        logs: {\n          enabled: false,\n          headSamplingRate: 0,\n          invocationLogs: false,\n          persist: false,\n        },\n        traces: { enabled: false, headSamplingRate: 0, persist: false },\n      },\n      rootDir: \"apps/web\",\n      workersDev: true,\n    };\n  })\n) {}\n\nconst NativeApiHostLive = TaxKitApiWorker.make(\n  Effect.gen(function* () {\n    const website = yield* TaxKitWebsite;\n    return {\n      compatibility: {\n        date: \"2026-10-04\",\n        flags: [\"nodejs_compat\"],\n      },\n      env: {\n        API_PUBLIC_ORIGIN: Worker.URL,\n        WEBSITE_PUBLIC_ORIGIN: website.url.pipe(\n          Output.map((url) => Option.getOrNull(Option.fromNullishOr(url)))\n        ),\n      },\n      // The app export owns its native entry; the graph crosses the workspace\n      // through that export rather than a relative filesystem import.\n      main: import.meta.resolve(\"api/worker\"),\n      observability: ApiWorkerObservability,\n      workersDev: true,\n    };\n  }),\n  ApiWorkerInit\n);\n\nexport const declareNativeAppsStack = Effect.gen(function* () {\n  const api = yield* TaxKitApiWorker;\n  const website = yield* TaxKitWebsite;\n  return { apiUrl: api.url, websiteUrl: website.url };\n}).pipe(Effect.provide(NativeApiHostLive));\nimport * as Schema from \"effect/Schema\";\n\nconst PreviewStage = Schema.String.check(Schema.isPattern(/^pr-[1-9]\\d*$/u));\n\nexport const DocsLocalDevelopmentStage = Schema.String.check(\n  Schema.isPattern(/^dev_[a-z0-9]+(?:[-_a-z0-9]+)*$/iu)\n).pipe(Schema.brand(\"taxkit/LocalDocsDevelopmentStage\"));\n\nexport const DocsDeploymentStage = Schema.Union([\n  Schema.Literals([\"prod\"]),\n  PreviewStage,\n]).pipe(Schema.brand(\"taxkit/DocsDeploymentStage\"));\nimport type * as cf from \"@cloudflare/workers-types\";\nimport * as Data from \"effect/Data\";\nimport type * as Effect from \"effect/Effect\";\nimport type { RuntimeContext } from \"../../RuntimeContext.ts\";\nimport * as Binding from \"./Binding.ts\";\nimport type { RateLimitBinding } from \"./RateLimitBinding.ts\";\n\nconst TypeId = \"Cloudflare.RateLimit\" as const;\ntype TypeId = typeof TypeId;\n\nexport type RateLimitPeriod = 10 | 60;\n\nexport class RateLimitError extends Data.TaggedError(\"RateLimitError\")<{\n  message: string;\n  cause: unknown;\n}> {}\n\n/**\n * Effect-native client for a Cloudflare Rate Limit binding. Wraps the runtime\n * `cf.RateLimit` so `limit` returns an `Effect` tagged with {@link RateLimitError}.\n */\nexport interface RateLimitClient {\n  /** Effect resolving to the raw Cloudflare runtime binding. */\n  raw: Effect.Effect<cf.RateLimit, never, RuntimeContext>;\n  limit(\n    options: Parameters<cf.RateLimit[\"limit\"]>[0],\n  ): Effect.Effect<\n    Awaited<ReturnType<cf.RateLimit[\"limit\"]>>,\n    RateLimitError,\n    RuntimeContext\n  >;\n}\n\nexport type RateLimitProps = {\n  /**\n   * Positive integer or string that uniquely identifies this rate limit\n   * configuration.\n   */\n  namespaceId: number | string;\n  /** Simple rate limiting configuration. */\n  simple: {\n    /** The number of requests allowed within the period. */\n    limit: number;\n    /** The period, in seconds, over which requests are counted. */\n    period: RateLimitPeriod;\n  };\n};\n\n/**\n * A Cloudflare Rate Limit binding for counting arbitrary keys inside Workers — a\n * Worker-only binding with no backing cloud resource.\n *\n * `RateLimit` is a single value that is at once the `Binding.Service` tag, the\n * callable that produces a {@link RateLimitBinding}, and the type. Declare it on\n * a Worker's `env` (it flows through `InferEnv` → the native `cf.RateLimit`) or\n * `yield*` it inside an Effect-native Worker to attach the binding and obtain\n * the {@link RateLimitClient}.\n *\n * ### Declaring on a Worker's env\n * **Example:** Async (non-Effect) Worker\n * ```typescript\n * export const Worker = Cloudflare.Worker(\"Worker\", {\n *   main: \"./src/worker.ts\",\n *   env: {\n *     THROTTLE: Cloudflare.RateLimit(\"THROTTLE\", {\n *       namespaceId: 1001,\n *       simple: { limit: 10, period: 60 },\n *     }),\n *   },\n * });\n *\n * export type WorkerEnv = Cloudflare.InferEnv<typeof Worker>;\n * //   { THROTTLE: RateLimit } — the native Cloudflare binding\n *\n * // worker.ts\n * export default {\n *   fetch: async (req: Request, env: WorkerEnv) => {\n *     const { success } = await env.THROTTLE.limit({ key: \"ip\" });\n *     return new Response(success ? \"ok\" : \"rate limited\");\n *   },\n * };\n * ```\n *\n * ### Binding inside an Effect-native Worker\n * **Example:** yield* RateLimit does the binding\n * ```typescript\n * Cloudflare.Worker(\"Worker\", { main: \"./src/worker.ts\" },\n *   Effect.gen(function* () {\n *     // Attaches the binding to this Worker AND returns the runtime client.\n *     const throttle = yield* Cloudflare.RateLimit(\"THROTTLE\", {\n *       namespaceId: 1001,\n *       simple: { limit: 10, period: 60 },\n *     });\n *\n *     return {\n *       fetch: Effect.gen(function* () {\n *         const { success } = yield* throttle.limit({ key: \"ip\" });\n *         return HttpServerResponse.text(success ? \"ok\" : \"rate limited\");\n *       }),\n *     };\n *   }).pipe(Effect.provide(Cloudflare.Workers.RateLimitBinding)),\n * );\n * ```\n *\n * @see https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/\n *\n * @binding\n * @product Rate Limiting\n * @category Application Security\n */\nexport interface RateLimit extends Binding.Service<\n  RateLimit,\n  TypeId,\n  RateLimitClient\n> {\n  /**\n   * @param name Binding name (logical id) — the `env` key it resolves to.\n   * @param props Rate limit namespace + simple config.\n   */\n  (name: string, props: RateLimitProps): RateLimitBinding;\n}\n\nexport const RateLimit = Binding.Service<\n  RateLimit,\n  { namespaceId: string; simple: { limit: number; period: RateLimitPeriod } }\n>({\n  id: TypeId,\n  defaultName: \"RATE_LIMIT\",\n  parse: (name: string, props: RateLimitProps) => ({\n    name,\n    namespaceId: String(props.namespaceId),\n    simple: props.simple,\n  }),\n  toWorkerBinding: (binding) => ({\n    type: \"ratelimit\",\n    name: binding.name,\n    namespaceId: binding.namespaceId,\n    simple: binding.simple,\n  }),\n});\n\nexport const isRateLimit = (value: unknown): value is RateLimitBinding =>\n  Binding.isBinding(value) && value.kind === TypeId;\nimport * as Config from \"effect/Config\";\nimport * as Effect from \"effect/Effect\";\nimport * as Schema from \"effect/Schema\";\n\nimport { DocsDeploymentStage, DocsLocalDevelopmentStage } from \"../stage.js\";\n\nexport const DocsCloudflareStackStage = Schema.Union([\n  DocsDeploymentStage,\n  DocsLocalDevelopmentStage,\n]);\n\nexport type DocsCloudflareStackStage = typeof DocsCloudflareStackStage.Type;\n\nexport const docsCloudflareStackName = \"TaxKitDocsCloudflare\";\nexport const docsWorkerResourceId = \"DocsWebsite\";\nexport const docsWorkerCompatibilityDate = \"2026-06-24\";\nexport const docsWorkerCompatibilityFlags = [\"nodejs_compat\"] as const;\nexport const docsWorkerAssetHeaders =\n  \"/assets/*\\n  Cache-Control: public, max-age=31536000, immutable\\n\";\nexport const docsWorkerMemo = {\n  include: [\"**/*\"],\n  lockfile: true,\n  workspaces: [\n    {\n      cwd: \"../../packages/docs-content\",\n      include: [\"**/*\"],\n      lockfile: false,\n    },\n    {\n      cwd: \"../../packages/docs-fumadocs\",\n      include: [\"**/*\"],\n      lockfile: false,\n    },\n  ],\n} as const;\n\nexport const decodeDocsCloudflareStackStage = (\n  value: typeof Schema.Unknown.Type\n) =>\n  Schema.decodeUnknownEffect(DocsCloudflareStackStage)(value).pipe(\n    Effect.mapError((error) => new Config.ConfigError(error))\n  );\n\nexport const docsWorkerObservability = {\n  enabled: true,\n  headSamplingRate: 1,\n  logs: {\n    enabled: true,\n    headSamplingRate: 1,\n    invocationLogs: true,\n    persist: true,\n  },\n  traces: {\n    enabled: false,\n    headSamplingRate: 0,\n    persist: false,\n  },\n} as const;\n  facts: CalculatorRunFacts,\n  ...OptionalCalculatorContextFields,\n});\n\nexport type CalculatorRunRequest = typeof CalculatorRunRequest.Type;\n\n/**\n * Service-level calculation request after route params, query params and JSON\n * body have been decoded by the HTTP API package.\n */\nexport const CalculatorRunServiceRequest = Schema.Struct({\n  calculatorId: CalculatorId,\n  help: Schema.OptionFromOptionalKey(\n    Schema.OptionFromUndefinedOr(HelpMode)\n  ).pipe(Schema.withConstructorDefault(Effect.succeedNone)),\n  payload: CalculatorRunRequest,\n});\n\nexport type CalculatorRunServiceRequest =\n  typeof CalculatorRunServiceRequest.Type;\n\nexport const CalculatorRunReport = Schema.Union([\n  TakeHomePayReport,\n  PayWithholdingsLedger,\n  AnnualTaxReport,\n]);\n\nexport type CalculatorRunReport = typeof CalculatorRunReport.Type;\n\n/**\n * Calculator run response with catalog metadata, diagnostics and the typed\n * calculator-specific report.\n */\nexport const CalculatorRunResponse = Schema.Struct({\n  calculator: CalculatorCatalogItem,\n  diagnostics: CalculationDiagnostics,\n  report: CalculatorRunReport,\n});\n\nexport type CalculatorRunResponse = typeof CalculatorRunResponse.Type;\n\nexport class CalculatorCatalogResponseData extends Data.Class<CalculatorCatalogResponse> {}\n\nexport class CalculatorRunResponseData extends Data.Class<CalculatorRunResponse> {}\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunFacts`.\n */\nexport const PublicCalculationFacts = CalculatorRunFacts.annotate({\n  title: \"PublicCalculationFacts\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunFacts`.\n */\nexport type PublicCalculationFacts = CalculatorRunFacts;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunRequest`.\n */\nexport const PublicCalculationRequest = CalculatorRunRequest.annotate({\n  title: \"PublicCalculationRequest\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunRequest`.\n */\nexport type PublicCalculationRequest = CalculatorRunRequest;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunServiceRequest`.\n */\nexport const PublicCalculationServiceRequest =\n  CalculatorRunServiceRequest.annotate({\n    title: \"PublicCalculationServiceRequest\",\n  });\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunServiceRequest`.\n */\nexport type PublicCalculationServiceRequest = CalculatorRunServiceRequest;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunReport`.\n */\nexport const PublicCalculationReport = CalculatorRunReport.annotate({\n  title: \"PublicCalculationReport\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunReport`.\n */\nexport type PublicCalculationReport = CalculatorRunReport;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunResponse`.\n */\nexport const PublicCalculationResponse = CalculatorRunResponse.annotate({\n  title: \"PublicCalculationResponse\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunResponse`.\n */\nexport type PublicCalculationResponse = CalculatorRunResponse;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunResponseData`.\n */\nexport class PublicCalculationResponseData extends CalculatorRunResponseData {}\n# Cloudflare\n\n## Contents\n\n- [Ownership decisions](#ownership-decisions)\n- [File ownership](#file-ownership)\n- [Worker and asset semantics](#worker-and-asset-semantics)\n- [Routes zones and domains](#routes-zones-and-domains)\n- [Bindings and storage](#bindings-and-storage)\n- [Website origin rules](#website-origin-rules)\n- [Secrets](#secrets)\n- [Observability](#observability)\n- [State](#state)\n- [Readback checklist](#readback-checklist)\n\n## Ownership decisions\n\nDeclare which system owns each Cloudflare lifecycle:\n\n- Worker or static-asset deployment;\n- routes and custom domains;\n- DNS/zone configuration;\n- R2, D1, KV, Durable Objects, Queues, or Secrets Store;\n- environment secrets and bindings;\n- logs, metrics, traces, and observability destinations;\n- remote state infrastructure.\n\nDo not assume Alchemy owns all Cloudflare resources because it owns one Worker.\n\n## File ownership\n\nFor a small graph:\n\n```text\nsrc/lib/build/cloudflare.ts\n```\n\nFor a substantial graph:\n\n```text\nsrc/lib/build/cloudflare/\n  stack.ts\n  website.ts\n  worker.ts\n  storage.ts\n  routes.ts\n  secrets.ts\n  observability.ts\n```\n\nKeep stage/config Schemas outside provider declarations when other providers share them.\n\n## Worker and asset semantics\n\nMake asset routing policy explicit. In particular, distinguish asset-first and Worker-first behaviour and test the intended choice. A deployed Worker and green CI do not prove that static assets return the correct content type or bypass the Worker.\n\nTest:\n\n- root document;\n- hashed CSS and JavaScript assets;\n- missing assets;\n- API paths;\n- redirects;\n- cache headers;\n- content types;\n- route precedence.\n\nRecord compatibility date, compatibility flags, runtime limits, module format, and bundler inputs in a stable typed owner. Keep application and deployment configuration aligned through one contract or an invariant test.\n\n## Routes, zones, and domains\n\nTreat a zone or domain as foreign unless this repository creates and owns it.\n\n- Read the target zone before applying routes.\n- Adopt only under explicit authority.\n- Default adopted zones and routes to retain.\n- Restrict Production route adoption to the Production stage.\n- Reject a route whose account/zone does not match the authority record.\n- Read back the route pattern and bound Worker after apply.\n- Prove the public host independently.\n\nDo not infer route correctness from a Worker URL.\n\n## Bindings and storage\n\nModel each binding as typed desired state:\n\n- binding name;\n- resource kind;\n- physical resource identity;\n- stage/environment;\n- creation/adoption policy;\n- removal policy.\n\nAssert that application code and deployment configuration use the same binding names. For Durable Objects, include class name, migration/tag policy, and deployment sequencing. For R2/D1/KV, make data retention explicit and default destructive deletion to forbidden until authorised.\n\n## Website origin rules\n\nAn origin is the protocol and host, with an optional port, such as\n`http://127.0.0.1:3210`. The deployed host owns that address. Applications must\nnever hard-code it or build it from a stage, Worker name, account subdomain,\ncustom domain or development port.\n\nFor Alchemy `2.0.0-beta.79`, use the native self URL binding on the host that\nneeds its own address:\n\n```typescript\nconst website =\n  yield *\n  Cloudflare.Website.Vite(\"Website\", {\n    rootDir: \"apps/web\",\n    env: { PUBLIC_ORIGIN: Cloudflare.Worker.URL },\n  });\n\n// The same binding works in a native Worker declaration.\nconst api =\n  yield *\n  Cloudflare.Worker(\"Api\", {\n    main: \"./src/worker.ts\",\n    env: { PUBLIC_ORIGIN: Cloudflare.Worker.URL },\n  });\n```\n\nAlchemy resolves this binding to the local development proxy during local\ndevelopment, the deployed `workers.dev` address, or the configured custom\ndomain. Do not add separate local/cloud address formulas or a copied-address\nfallback. For Vite browser code, a `VITE_`-prefixed self URL binding uses the\nsame native resolution before the client bundle is built.\n\nIt is valid to declare a chosen custom domain as infrastructure input, for\nexample `domain: \"app.example.com\"`. Keep the application's own\n`PUBLIC_ORIGIN` bound to `Cloudflare.Worker.URL`; do not repeat that domain in\nits environment or build `\"https://\" + domain` there. Aliases and incoming\nrequest origins are separate from the host's configured canonical address.\n\nFor a different host, use that resource's native Output, such as `api.url`.\nPass the Output to the receiving resource; check its resolved value with the\nowning Schema when application code reads the binding. If the native address\ncan be absent, preserve that absence as `null` for an env binding and reject it\nwith the Schema. Do not replace an absent Output with a guessed address.\n\nKeep expected validation failures typed. Beta.79's `Output.mapEffect` callback\naccepts no expected errors, so do not force Schema decoding into it with\n`Effect.orDie`. `Output.map` may select a checked resource attribute or represent\nabsence; it must not reconstruct the hostname. Resolve and decode Outputs\nseparately before writing workflow or receipt values.\n\nCheck the selected Alchemy version's self URL, Vite, native Worker and local\nprovider APIs before copying this example. See the\n[matching primary sources](../sources.md#cloudflare-website-origins).\nLocal source/type checks do not prove live domain routing.\n\n## Separate Website and native API Workers\n\nUse standard Website.Vite for the frontend and a native Effect Worker for the\nAPI. The root stack deploys both with exact same-stage service/public bindings.\nPreview has its own API; a Website preview parent does not authorise using the\nProduction API. Do not wrap TanStack in a backend Worker or recreate an API\nruntime around the native incoming request fibre.\n\n@taxkit/scripts release:check: $ turbo run //#lint:task\n@taxkit/scripts release:check: $ turbo run //#format:check:task\n@taxkit/scripts release:check: //#format:check:task:  ERROR  command (<home>/.codex/worktrees/aac7/taxkit/) /private/tmp/taxkit-local-toolchain/bun-darwin-aarch64/bun run format:check:task exited (1)\n@taxkit/scripts release:check:  ERROR  run failed: command  exited (1)\n@taxkit/scripts release:check: error: script \"format:check\" exited with code 1\n@taxkit/scripts release:check: error: script \"verification\" exited with code 1\n@taxkit/scripts release:check: \n@taxkit/scripts release:check: recovery: repair the named local boundary and rerun CI; no candidate or attempt receipt exists in CI mode.\n@taxkit/scripts release:check: Exited with code 1\nerror: script \"release:check\" exited with code 1\n","exit_code":0,"duration":{"secs":0,"nanos":7208},"formatted_output":"import * as Website from \"alchemy/Cloudflare/Website\";\nimport { Worker } from \"alchemy/Cloudflare/Workers\";\nimport * as Output from \"alchemy/Output\";\nimport {\n  ApiWorkerInit,\n  ApiWorkerObservability,\n  TaxKitApiWorker,\n} from \"api/worker\";\nimport { Effect, Option } from \"effect\";\n\n// A forward API tag registers before its implementation Layer finishes. The\n// native planner retains both address Outputs, including the binding cycle.\nexport class TaxKitWebsite extends Website.Vite<TaxKitWebsite>()(\n  \"TaxKitWebsite\",\n  Effect.gen(function* () {\n    const api = yield* TaxKitApiWorker;\n    const apiOrigin = api.url.pipe(\n      Output.map((url) => Option.getOrNull(Option.fromNullishOr(url)))\n    );\n    return {\n      compatibility: {\n        date: \"2026-10-04\",\n        flags: [\"nodejs_compat\"],\n      },\n      env: {\n        API_PUBLIC_ORIGIN: apiOrigin,\n        TAXKIT_API: api,\n        WEBSITE_PUBLIC_ORIGIN: Worker.URL,\n      },\n      // The Website's platform records can include caller URLs independently\n      // of its fixed application reporter. Qualified exporters remain pending.\n      observability: {\n        enabled: false,\n        headSamplingRate: 0,\n        logs: {\n          enabled: false,\n          headSamplingRate: 0,\n          invocationLogs: false,\n          persist: false,\n        },\n        traces: { enabled: false, headSamplingRate: 0, persist: false },\n      },\n      rootDir: \"apps/web\",\n      workersDev: true,\n    };\n  })\n) {}\n\nconst NativeApiHostLive = TaxKitApiWorker.make(\n  Effect.gen(function* () {\n    const website = yield* TaxKitWebsite;\n    return {\n      compatibility: {\n        date: \"2026-10-04\",\n        flags: [\"nodejs_compat\"],\n      },\n      env: {\n        API_PUBLIC_ORIGIN: Worker.URL,\n        WEBSITE_PUBLIC_ORIGIN: website.url.pipe(\n          Output.map((url) => Option.getOrNull(Option.fromNullishOr(url)))\n        ),\n      },\n      // The app export owns its native entry; the graph crosses the workspace\n      // through that export rather than a relative filesystem import.\n      main: import.meta.resolve(\"api/worker\"),\n      observability: ApiWorkerObservability,\n      workersDev: true,\n    };\n  }),\n  ApiWorkerInit\n);\n\nexport const declareNativeAppsStack = Effect.gen(function* () {\n  const api = yield* TaxKitApiWorker;\n  const website = yield* TaxKitWebsite;\n  return { apiUrl: api.url, websiteUrl: website.url };\n}).pipe(Effect.provide(NativeApiHostLive));\nimport * as Schema from \"effect/Schema\";\n\nconst PreviewStage = Schema.String.check(Schema.isPattern(/^pr-[1-9]\\d*$/u));\n\nexport const DocsLocalDevelopmentStage = Schema.String.check(\n  Schema.isPattern(/^dev_[a-z0-9]+(?:[-_a-z0-9]+)*$/iu)\n).pipe(Schema.brand(\"taxkit/LocalDocsDevelopmentStage\"));\n\nexport const DocsDeploymentStage = Schema.Union([\n  Schema.Literals([\"prod\"]),\n  PreviewStage,\n]).pipe(Schema.brand(\"taxkit/DocsDeploymentStage\"));\nimport type * as cf from \"@cloudflare/workers-types\";\nimport * as Data from \"effect/Data\";\nimport type * as Effect from \"effect/Effect\";\nimport type { RuntimeContext } from \"../../RuntimeContext.ts\";\nimport * as Binding from \"./Binding.ts\";\nimport type { RateLimitBinding } from \"./RateLimitBinding.ts\";\n\nconst TypeId = \"Cloudflare.RateLimit\" as const;\ntype TypeId = typeof TypeId;\n\nexport type RateLimitPeriod = 10 | 60;\n\nexport class RateLimitError extends Data.TaggedError(\"RateLimitError\")<{\n  message: string;\n  cause: unknown;\n}> {}\n\n/**\n * Effect-native client for a Cloudflare Rate Limit binding. Wraps the runtime\n * `cf.RateLimit` so `limit` returns an `Effect` tagged with {@link RateLimitError}.\n */\nexport interface RateLimitClient {\n  /** Effect resolving to the raw Cloudflare runtime binding. */\n  raw: Effect.Effect<cf.RateLimit, never, RuntimeContext>;\n  limit(\n    options: Parameters<cf.RateLimit[\"limit\"]>[0],\n  ): Effect.Effect<\n    Awaited<ReturnType<cf.RateLimit[\"limit\"]>>,\n    RateLimitError,\n    RuntimeContext\n  >;\n}\n\nexport type RateLimitProps = {\n  /**\n   * Positive integer or string that uniquely identifies this rate limit\n   * configuration.\n   */\n  namespaceId: number | string;\n  /** Simple rate limiting configuration. */\n  simple: {\n    /** The number of requests allowed within the period. */\n    limit: number;\n    /** The period, in seconds, over which requests are counted. */\n    period: RateLimitPeriod;\n  };\n};\n\n/**\n * A Cloudflare Rate Limit binding for counting arbitrary keys inside Workers — a\n * Worker-only binding with no backing cloud resource.\n *\n * `RateLimit` is a single value that is at once the `Binding.Service` tag, the\n * callable that produces a {@link RateLimitBinding}, and the type. Declare it on\n * a Worker's `env` (it flows through `InferEnv` → the native `cf.RateLimit`) or\n * `yield*` it inside an Effect-native Worker to attach the binding and obtain\n * the {@link RateLimitClient}.\n *\n * ### Declaring on a Worker's env\n * **Example:** Async (non-Effect) Worker\n * ```typescript\n * export const Worker = Cloudflare.Worker(\"Worker\", {\n *   main: \"./src/worker.ts\",\n *   env: {\n *     THROTTLE: Cloudflare.RateLimit(\"THROTTLE\", {\n *       namespaceId: 1001,\n *       simple: { limit: 10, period: 60 },\n *     }),\n *   },\n * });\n *\n * export type WorkerEnv = Cloudflare.InferEnv<typeof Worker>;\n * //   { THROTTLE: RateLimit } — the native Cloudflare binding\n *\n * // worker.ts\n * export default {\n *   fetch: async (req: Request, env: WorkerEnv) => {\n *     const { success } = await env.THROTTLE.limit({ key: \"ip\" });\n *     return new Response(success ? \"ok\" : \"rate limited\");\n *   },\n * };\n * ```\n *\n * ### Binding inside an Effect-native Worker\n * **Example:** yield* RateLimit does the binding\n * ```typescript\n * Cloudflare.Worker(\"Worker\", { main: \"./src/worker.ts\" },\n *   Effect.gen(function* () {\n *     // Attaches the binding to this Worker AND returns the runtime client.\n *     const throttle = yield* Cloudflare.RateLimit(\"THROTTLE\", {\n *       namespaceId: 1001,\n *       simple: { limit: 10, period: 60 },\n *     });\n *\n *     return {\n *       fetch: Effect.gen(function* () {\n *         const { success } = yield* throttle.limit({ key: \"ip\" });\n *         return HttpServerResponse.text(success ? \"ok\" : \"rate limited\");\n *       }),\n *     };\n *   }).pipe(Effect.provide(Cloudflare.Workers.RateLimitBinding)),\n * );\n * ```\n *\n * @see https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/\n *\n * @binding\n * @product Rate Limiting\n * @category Application Security\n */\nexport interface RateLimit extends Binding.Service<\n  RateLimit,\n  TypeId,\n  RateLimitClient\n> {\n  /**\n   * @param name Binding name (logical id) — the `env` key it resolves to.\n   * @param props Rate limit namespace + simple config.\n   */\n  (name: string, props: RateLimitProps): RateLimitBinding;\n}\n\nexport const RateLimit = Binding.Service<\n  RateLimit,\n  { namespaceId: string; simple: { limit: number; period: RateLimitPeriod } }\n>({\n  id: TypeId,\n  defaultName: \"RATE_LIMIT\",\n  parse: (name: string, props: RateLimitProps) => ({\n    name,\n    namespaceId: String(props.namespaceId),\n    simple: props.simple,\n  }),\n  toWorkerBinding: (binding) => ({\n    type: \"ratelimit\",\n    name: binding.name,\n    namespaceId: binding.namespaceId,\n    simple: binding.simple,\n  }),\n});\n\nexport const isRateLimit = (value: unknown): value is RateLimitBinding =>\n  Binding.isBinding(value) && value.kind === TypeId;\nimport * as Config from \"effect/Config\";\nimport * as Effect from \"effect/Effect\";\nimport * as Schema from \"effect/Schema\";\n\nimport { DocsDeploymentStage, DocsLocalDevelopmentStage } from \"../stage.js\";\n\nexport const DocsCloudflareStackStage = Schema.Union([\n  DocsDeploymentStage,\n  DocsLocalDevelopmentStage,\n]);\n\nexport type DocsCloudflareStackStage = typeof DocsCloudflareStackStage.Type;\n\nexport const docsCloudflareStackName = \"TaxKitDocsCloudflare\";\nexport const docsWorkerResourceId = \"DocsWebsite\";\nexport const docsWorkerCompatibilityDate = \"2026-06-24\";\nexport const docsWorkerCompatibilityFlags = [\"nodejs_compat\"] as const;\nexport const docsWorkerAssetHeaders =\n  \"/assets/*\\n  Cache-Control: public, max-age=31536000, immutable\\n\";\nexport const docsWorkerMemo = {\n  include: [\"**/*\"],\n  lockfile: true,\n  workspaces: [\n    {\n      cwd: \"../../packages/docs-content\",\n      include: [\"**/*\"],\n      lockfile: false,\n    },\n    {\n      cwd: \"../../packages/docs-fumadocs\",\n      include: [\"**/*\"],\n      lockfile: false,\n    },\n  ],\n} as const;\n\nexport const decodeDocsCloudflareStackStage = (\n  value: typeof Schema.Unknown.Type\n) =>\n  Schema.decodeUnknownEffect(DocsCloudflareStackStage)(value).pipe(\n    Effect.mapError((error) => new Config.ConfigError(error))\n  );\n\nexport const docsWorkerObservability = {\n  enabled: true,\n  headSamplingRate: 1,\n  logs: {\n    enabled: true,\n    headSamplingRate: 1,\n    invocationLogs: true,\n    persist: true,\n  },\n  traces: {\n    enabled: false,\n    headSamplingRate: 0,\n    persist: false,\n  },\n} as const;\n  facts: CalculatorRunFacts,\n  ...OptionalCalculatorContextFields,\n});\n\nexport type CalculatorRunRequest = typeof CalculatorRunRequest.Type;\n\n/**\n * Service-level calculation request after route params, query params and JSON\n * body have been decoded by the HTTP API package.\n */\nexport const CalculatorRunServiceRequest = Schema.Struct({\n  calculatorId: CalculatorId,\n  help: Schema.OptionFromOptionalKey(\n    Schema.OptionFromUndefinedOr(HelpMode)\n  ).pipe(Schema.withConstructorDefault(Effect.succeedNone)),\n  payload: CalculatorRunRequest,\n});\n\nexport type CalculatorRunServiceRequest =\n  typeof CalculatorRunServiceRequest.Type;\n\nexport const CalculatorRunReport = Schema.Union([\n  TakeHomePayReport,\n  PayWithholdingsLedger,\n  AnnualTaxReport,\n]);\n\nexport type CalculatorRunReport = typeof CalculatorRunReport.Type;\n\n/**\n * Calculator run response with catalog metadata, diagnostics and the typed\n * calculator-specific report.\n */\nexport const CalculatorRunResponse = Schema.Struct({\n  calculator: CalculatorCatalogItem,\n  diagnostics: CalculationDiagnostics,\n  report: CalculatorRunReport,\n});\n\nexport type CalculatorRunResponse = typeof CalculatorRunResponse.Type;\n\nexport class CalculatorCatalogResponseData extends Data.Class<CalculatorCatalogResponse> {}\n\nexport class CalculatorRunResponseData extends Data.Class<CalculatorRunResponse> {}\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunFacts`.\n */\nexport const PublicCalculationFacts = CalculatorRunFacts.annotate({\n  title: \"PublicCalculationFacts\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunFacts`.\n */\nexport type PublicCalculationFacts = CalculatorRunFacts;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunRequest`.\n */\nexport const PublicCalculationRequest = CalculatorRunRequest.annotate({\n  title: \"PublicCalculationRequest\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunRequest`.\n */\nexport type PublicCalculationRequest = CalculatorRunRequest;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunServiceRequest`.\n */\nexport const PublicCalculationServiceRequest =\n  CalculatorRunServiceRequest.annotate({\n    title: \"PublicCalculationServiceRequest\",\n  });\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunServiceRequest`.\n */\nexport type PublicCalculationServiceRequest = CalculatorRunServiceRequest;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunReport`.\n */\nexport const PublicCalculationReport = CalculatorRunReport.annotate({\n  title: \"PublicCalculationReport\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunReport`.\n */\nexport type PublicCalculationReport = CalculatorRunReport;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunResponse`.\n */\nexport const PublicCalculationResponse = CalculatorRunResponse.annotate({\n  title: \"PublicCalculationResponse\",\n});\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunResponse`.\n */\nexport type PublicCalculationResponse = CalculatorRunResponse;\n\n/**\n * @deprecated Transitional API-era alias. Use `CalculatorRunResponseData`.\n */\nexport class PublicCalculationResponseData extends CalculatorRunResponseData {}\n# Cloudflare\n\n## Contents\n\n- [Ownership decisions](#ownership-decisions)\n- [File ownership](#file-ownership)\n- [Worker and asset semantics](#worker-and-asset-semantics)\n- [Routes zones and domains](#routes-zones-and-domains)\n- [Bindings and storage](#bindings-and-storage)\n- [Website origin rules](#website-origin-rules)\n- [Secrets](#secrets)\n- [Observability](#observability)\n- [State](#state)\n- [Readback checklist](#readback-checklist)\n\n## Ownership decisions\n\nDeclare which system owns each Cloudflare lifecycle:\n\n- Worker or static-asset deployment;\n- routes and custom domains;\n- DNS/zone configuration;\n- R2, D1, KV, Durable Objects, Queues, or Secrets Store;\n- environment secrets and bindings;\n- logs, metrics, traces, and observability destinations;\n- remote state infrastructure.\n\nDo not assume Alchemy owns all Cloudflare resources because it owns one Worker.\n\n## File ownership\n\nFor a small graph:\n\n```text\nsrc/lib/build/cloudflare.ts\n```\n\nFor a substantial graph:\n\n```text\nsrc/lib/build/cloudflare/\n  stack.ts\n  website.ts\n  worker.ts\n  storage.ts\n  routes.ts\n  secrets.ts\n  observability.ts\n```\n\nKeep stage/config Schemas outside provider declarations when other providers share them.\n\n## Worker and asset semantics\n\nMake asset routing policy explicit. In particular, distinguish asset-first and Worker-first behaviour and test the intended choice. A deployed Worker and green CI do not prove that static assets return the correct content type or bypass the Worker.\n\nTest:\n\n- root document;\n- hashed CSS and JavaScript assets;\n- missing assets;\n- API paths;\n- redirects;\n- cache headers;\n- content types;\n- route precedence.\n\nRecord compatibility date, compatibility flags, runtime limits, module format, and bundler inputs in a stable typed owner. Keep application and deployment configuration aligned through one contract or an invariant test.\n\n## Routes, zones, and domains\n\nTreat a zone or domain as foreign unless this repository creates and owns it.\n\n- Read the target zone before applying routes.\n- Adopt only under explicit authority.\n- Default adopted zones and routes to retain.\n- Restrict Production route adoption to the Production stage.\n- Reject a route whose account/zone does not match the authority record.\n- Read back the route pattern and bound Worker after apply.\n- Prove the public host independently.\n\nDo not infer route correctness from a Worker URL.\n\n## Bindings and storage\n\nModel each binding as typed desired state:\n\n- binding name;\n- resource kind;\n- physical resource identity;\n- stage/environment;\n- creation/adoption policy;\n- removal policy.\n\nAssert that application code and deployment configuration use the same binding names. For Durable Objects, include class name, migration/tag policy, and deployment sequencing. For R2/D1/KV, make data retention explicit and default destructive deletion to forbidden until authorised.\n\n## Website origin rules\n\nAn origin is the protocol and host, with an optional port, such as\n`http://127.0.0.1:3210`. The deployed host owns that address. Applications must\nnever hard-code it or build it from a stage, Worker name, account subdomain,\ncustom domain or development port.\n\nFor Alchemy `2.0.0-beta.79`, use the native self URL binding on the host that\nneeds its own address:\n\n```typescript\nconst website =\n  yield *\n  Cloudflare.Website.Vite(\"Website\", {\n    rootDir: \"apps/web\",\n    env: { PUBLIC_ORIGIN: Cloudflare.Worker.URL },\n  });\n\n// The same binding works in a native Worker declaration.\nconst api =\n  yield *\n  Cloudflare.Worker(\"Api\", {\n    main: \"./src/worker.ts\",\n    env: { PUBLIC_ORIGIN: Cloudflare.Worker.URL },\n  });\n```\n\nAlchemy resolves this binding to the local development proxy during local\ndevelopment, the deployed `workers.dev` address, or the configured custom\ndomain. Do not add separate local/cloud address formulas or a copied-address\nfallback. For Vite browser code, a `VITE_`-prefixed self URL binding uses the\nsame native resolution before the client bundle is built.\n\nIt is valid to declare a chosen custom domain as infrastructure input, for\nexample `domain: \"app.example.com\"`. Keep the application's own\n`PUBLIC_ORIGIN` bound to `Cloudflare.Worker.URL`; do not repeat that domain in\nits environment or build `\"https://\" + domain` there. Aliases and incoming\nrequest origins are separate from the host's configured canonical address.\n\nFor a different host, use that resource's native Output, such as `api.url`.\nPass the Output to the receiving resource; check its resolved value with the\nowning Schema when application code reads the binding. If the native address\ncan be absent, preserve that absence as `null` for an env binding and reject it\nwith the Schema. Do not replace an absent Output with a guessed address.\n\nKeep expected validation failures typed. Beta.79's `Output.mapEffect` callback\naccepts no expected errors, so do not force Schema decoding into it with\n`Effect.orDie`. `Output.map` may select a checked resource attribute or represent\nabsence; it must not reconstruct the hostname. Resolve and decode Outputs\nseparately before writing workflow or receipt values.\n\nCheck the selected Alchemy version's self URL, Vite, native Worker and local\nprovider APIs before copying this example. See the\n[matching primary sources](../sources.md#cloudflare-website-origins).\nLocal source/type checks do not prove live domain routing.\n\n## Separate Website and native API Workers\n\nUse standard Website.Vite for the frontend and a native Effect Worker for the\nAPI. The root stack deploys both with exact same-stage service/public bindings.\nPreview has its own API; a Website preview parent does not authorise using the\nProduction API. Do not wrap TanStack in a backend Worker or recreate an API\nruntime around the native incoming request fibre.\n\n@taxkit/scripts release:check: $ turbo run //#lint:task\n@taxkit/scripts release:check: $ turbo run //#format:check:task\n@taxkit/scripts release:check: //#format:check:task:  ERROR  command (<home>/.codex/worktrees/aac7/taxkit/) /private/tmp/taxkit-local-toolchain/bun-darwin-aarch64/bun run format:check:task exited (1)\n@taxkit/scripts release:check:  ERROR  run failed: command  exited (1)\n@taxkit/scripts release:check: error: script \"format:check\" exited with code 1\n@taxkit/scripts release:check: error: script \"verification\" exited with code 1\n@taxkit/scripts release:check: \n@taxkit/scripts release:check: recovery: repair the named local boundary and rerun CI; no candidate or attempt receipt exists in CI mode.\n@taxkit/scripts release:check: Exited with code 1\nerror: script \"release:check\" exited with code 1\n"},"started_at_ms":1791262146927,"completed_at_ms":1791262146927}}
{"timestamp":"2026-10-06T04:49:06.979Z","ordinal":37805,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a10f8b-41a3-7392-936b-f07d529501b3","call_id":"call_MLg9hFHZkEPEaziAvDp0VaLU","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"f26afa\",\"wall_time_seconds\":0.000007208,\"exit_code\":0,\"original_token_count\":4687,\"output\":\"import * as Website from \\\"alchemy/Cloudflare/Website\\\";\\nimport { Worker } from \\\"alchemy/Cloudflare/Workers\\\";\\nimport * as Output from \\\"alchemy/Output\\\";\\nimport {\\n  ApiWorkerInit,\\n  ApiWorkerObservability,\\n  TaxKitApiWorker,\\n} from \\\"api/worker\\\";\\nimport { Effect, Option } from \\\"effect\\\";\\n\\n// A forward API tag registers before its implementation Layer finishes. The\\n// native planner retains both address Outputs, including the binding cycle.\\nexport class TaxKitWebsite extends Website.Vite<TaxKitWebsite>()(\\n  \\\"TaxKitWebsite\\\",\\n  Effect.gen(function* () {\\n    const api = yield* TaxKitApiWorker;\\n    const apiOrigin = api.url.pipe(\\n      Output.map((url) => Option.getOrNull(Option.fromNullishOr(url)))\\n    );\\n    return {\\n      compatibility: {\\n        date: \\\"2026-10-04\\\",\\n        flags: [\\\"nodejs_compat\\\"],\\n      },\\n      env: {\\n        API_PUBLIC_ORIGIN: apiOrigin,\\n        TAXKIT_API: api,\\n        WEBSITE_PUBLIC_ORIGIN: Worker.URL,\\n      },\\n      // The Website's platform records can include caller URLs independently\\n      // of its fixed application reporter. Qualified exporters remain pending.\\n      observability: {\\n        enabled: false,\\n        headSamplingRate: 0,\\n        logs: {\\n          enabled: false,\\n          headSamplingRate: 0,\\n          invocationLogs: false,\\n          persist: false,\\n        },\\n        traces: { enabled: false, headSamplingRate: 0, persist: false },\\n      },\\n      rootDir: \\\"apps/web\\\",\\n      workersDev: true,\\n    };\\n  })\\n) {}\\n\\nconst NativeApiHostLive = TaxKitApiWorker.make(\\n  Effect.gen(function* () {\\n    const website = yield* TaxKitWebsite;\\n    return {\\n      compatibility: {\\n        date: \\\"2026-10-04\\\",\\n        flags: [\\\"nodejs_compat\\\"],\\n      },\\n      env: {\\n        API_PUBLIC_ORIGIN: Worker.URL,\\n        WEBSITE_PUBLIC_ORIGIN: website.url.pipe(\\n          Output.map((url) => Option.getOrNull(Option.fromNullishOr(url)))\\n        ),\\n      },\\n      // The app export owns its native entry; the graph crosses the workspace\\n      // through that export rather than a relative filesystem import.\\n      main: import.meta.resolve(\\\"api/worker\\\"),\\n      observability: ApiWorkerObservability,\\n      workersDev: true,\\n    };\\n  }),\\n  ApiWorkerInit\\n);\\n\\nexport const declareNativeAppsStack = Effect.gen(function* () {\\n  const api = yield* TaxKitApiWorker;\\n  const website = yield* TaxKitWebsite;\\n  return { apiUrl: api.url, websiteUrl: website.url };\\n}).pipe(Effect.provide(NativeApiHostLive));\\nimport * as Schema from \\\"effect/Schema\\\";\\n\\nconst PreviewStage = Schema.String.check(Schema.isPattern(/^pr-[1-9]\\\\d*$/u));\\n\\nexport const DocsLocalDevelopmentStage = Schema.String.check(\\n  Schema.isPattern(/^dev_[a-z0-9]+(?:[-_a-z0-9]+)*$/iu)\\n).pipe(Schema.brand(\\\"taxkit/LocalDocsDevelopmentStage\\\"));\\n\\nexport const DocsDeploymentStage = Schema.Union([\\n  Schema.Literals([\\\"prod\\\"]),\\n  PreviewStage,\\n]).pipe(Schema.brand(\\\"taxkit/DocsDeploymentStage\\\"));\\nimport type * as cf from \\\"@cloudflare/workers-types\\\";\\nimport * as Data from \\\"effect/Data\\\";\\nimport type * as Effect from \\\"effect/Effect\\\";\\nimport type { RuntimeContext } from \\\"../../RuntimeContext.ts\\\";\\nimport * as Binding from \\\"./Binding.ts\\\";\\nimport type { RateLimitBinding } from \\\"./RateLimitBinding.ts\\\";\\n\\nconst TypeId = \\\"Cloudflare.RateLimit\\\" as const;\\ntype TypeId = typeof TypeId;\\n\\nexport type RateLimitPeriod = 10 | 60;\\n\\nexport class RateLimitError extends Data.TaggedError(\\\"RateLimitError\\\")<{\\n  message: string;\\n  cause: unknown;\\n}> {}\\n\\n/**\\n * Effect-native client for a Cloudflare Rate Limit binding. Wraps the runtime\\n * `cf.RateLimit` so `limit` returns an `Effect` tagged with {@link RateLimitError}.\\n */\\nexport interface RateLimitClient {\\n  /** Effect resolving to the raw Cloudflare runtime binding. */\\n  raw: Effect.Effect<cf.RateLimit, never, RuntimeContext>;\\n  limit(\\n    options: Parameters<cf.RateLimit[\\\"limit\\\"]>[0],\\n  ): Effect.Effect<\\n    Awaited<ReturnType<cf.RateLimit[\\\"limit\\\"]>>,\\n    RateLimitError,\\n    RuntimeContext\\n  >;\\n}\\n\\nexport type RateLimitProps = {\\n  /**\\n   * Positive integer or string that uniquely identifies this rate limit\\n   * configuration.\\n   */\\n  namespaceId: number | string;\\n  /** Simple rate limiting configuration. */\\n  simple: {\\n    /** The number of requests allowed within the period. */\\n    limit: number;\\n    /** The period, in seconds, over which requests are counted. */\\n    period: RateLimitPeriod;\\n  };\\n};\\n\\n/**\\n * A Cloudflare Rate Limit binding for counting arbitrary keys inside Workers — a\\n * Worker-only binding with no backing cloud resource.\\n *\\n * `RateLimit` is a single value that is at once the `Binding.Service` tag, the\\n * callable that produces a {@link RateLimitBinding}, and the type. Declare it on\\n * a Worker's `env` (it flows through `InferEnv` → the native `cf.RateLimit`) or\\n * `yield*` it inside an Effect-native Worker to attach the binding and obtain\\n * the {@link RateLimitClient}.\\n *\\n * ### Declaring on a Worker's env\\n * **Example:** Async (non-Effect) Worker\\n * ```typescript\\n * export const Worker = Cloudflare.Worker(\\\"Worker\\\", {\\n *   main: \\\"./src/worker.ts\\\",\\n *   env: {\\n *     THROTTLE: Cloudflare.RateLimit(\\\"THROTTLE\\\", {\\n *       namespaceId: 1001,\\n *       simple: { limit: 10, period: 60 },\\n *     }),\\n *   },\\n * });\\n *\\n * export type WorkerEnv = Cloudflare.InferEnv<typeof Worker>;\\n * //   { THROTTLE: RateLimit } — the native Cloudflare binding\\n *\\n * // worker.ts\\n * export default {\\n *   fetch: async (req: Request, env: WorkerEnv) => {\\n *     const { success } = await env.THROTTLE.limit({ key: \\\"ip\\\" });\\n *     return new Response(success ? \\\"ok\\\" : \\\"rate limited\\\");\\n *   },\\n * };\\n * ```\\n *\\n * ### Binding inside an Effect-native Worker\\n * **Example:** yield* RateLimit does the binding\\n * ```typescript\\n * Cloudflare.Worker(\\\"Worker\\\", { main: \\\"./src/worker.ts\\\" },\\n *   Effect.gen(function* () {\\n *     // Attaches the binding to this Worker AND returns the runtime client.\\n *     const throttle = yield* Cloudflare.RateLimit(\\\"THROTTLE\\\", {\\n *       namespaceId: 1001,\\n *       simple: { limit: 10, period: 60 },\\n *     });\\n *\\n *     return {\\n *       fetch: Effect.gen(function* () {\\n *         const { success } = yield* throttle.limit({ key: \\\"ip\\\" });\\n *         return HttpServerResponse.text(success ? \\\"ok\\\" : \\\"rate limited\\\");\\n *       }),\\n *     };\\n *   }).pipe(Effect.provide(Cloudflare.Workers.RateLimitBinding)),\\n * );\\n * ```\\n *\\n * @see https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/\\n *\\n * @binding\\n * @product Rate Limiting\\n * @category Application Security\\n */\\nexport interface RateLimit extends Binding.Service<\\n  RateLimit,\\n  TypeId,\\n  RateLimitClient\\n> {\\n  /**\\n   * @param name Binding name (logical id) — the `env` key it resolves to.\\n   * @param props Rate limit namespace + simple config.\\n   */\\n  (name: string, props: RateLimitProps): RateLimitBinding;\\n}\\n\\nexport const RateLimit = Binding.Service<\\n  RateLimit,\\n  { namespaceId: string; simple: { limit: number; period: RateLimitPeriod } }\\n>({\\n  id: TypeId,\\n  defaultName: \\\"RATE_LIMIT\\\",\\n  parse: (name: string, props: RateLimitProps) => ({\\n    name,\\n    namespaceId: String(props.namespaceId),\\n    simple: props.simple,\\n  }),\\n  toWorkerBinding: (binding) => ({\\n    type: \\\"ratelimit\\\",\\n    name: binding.name,\\n    namespaceId: binding.namespaceId,\\n    simple: binding.simple,\\n  }),\\n});\\n\\nexport const isRateLimit = (value: unknown): value is RateLimitBinding =>\\n  Binding.isBinding(value) && value.kind === TypeId;\\nimport * as Config from \\\"effect/Config\\\";\\nimport * as Effect from \\\"effect/Effect\\\";\\nimport * as Schema from \\\"effect/Schema\\\";\\n\\nimport { DocsDeploymentStage, DocsLocalDevelopmentStage } from \\\"../stage.js\\\";\\n\\nexport const DocsCloudflareStackStage = Schema.Union([\\n  DocsDeploymentStage,\\n  DocsLocalDevelopmentStage,\\n]);\\n\\nexport type DocsCloudflareStackStage = typeof DocsCloudflareStackStage.Type;\\n\\nexport const docsCloudflareStackName = \\\"TaxKitDocsCloudflare\\\";\\nexport const docsWorkerResourceId = \\\"DocsWebsite\\\";\\nexport const docsWorkerCompatibilityDate = \\\"2026-06-24\\\";\\nexport const docsWorkerCompatibilityFlags = [\\\"nodejs_compat\\\"] as const;\\nexport const docsWorkerAssetHeaders =\\n  \\\"/assets/*\\\\n  Cache-Control: public, max-age=31536000, immutable\\\\n\\\";\\nexport const docsWorkerMemo = {\\n  include: [\\\"**/*\\\"],\\n  lockfile: true,\\n  workspaces: [\\n    {\\n      cwd: \\\"../../packages/docs-content\\\",\\n      include: [\\\"**/*\\\"],\\n      lockfile: false,\\n    },\\n    {\\n      cwd: \\\"../../packages/docs-fumadocs\\\",\\n      include: [\\\"**/*\\\"],\\n      lockfile: false,\\n    },\\n  ],\\n} as const;\\n\\nexport const decodeDocsCloudflareStackStage = (\\n  value: typeof Schema.Unknown.Type\\n) =>\\n  Schema.decodeUnknownEffect(DocsCloudflareStackStage)(value).pipe(\\n    Effect.mapError((error) => new Config.ConfigError(error))\\n  );\\n\\nexport const docsWorkerObservability = {\\n  enabled: true,\\n  headSamplingRate: 1,\\n  logs: {\\n    enabled: true,\\n    headSamplingRate: 1,\\n    invocationLogs: true,\\n    persist: true,\\n  },\\n  traces: {\\n    enabled: false,\\n    headSamplingRate: 0,\\n    persist: false,\\n  },\\n} as const;\\n  facts: CalculatorRunFacts,\\n  ...OptionalCalculatorContextFields,\\n});\\n\\nexport type CalculatorRunRequest = typeof CalculatorRunRequest.Type;\\n\\n/**\\n * Service-level calculation request after route params, query params and JSON\\n * body have been decoded by the HTTP API package.\\n */\\nexport const CalculatorRunServiceRequest = Schema.Struct({\\n  calculatorId: CalculatorId,\\n  help: Schema.OptionFromOptionalKey(\\n    Schema.OptionFromUndefinedOr(HelpMode)\\n  ).pipe(Schema.withConstructorDefault(Effect.succeedNone)),\\n  payload: CalculatorRunRequest,\\n});\\n\\nexport type CalculatorRunServiceRequest =\\n  typeof CalculatorRunServiceRequest.Type;\\n\\nexport const CalculatorRunReport = Schema.Union([\\n  TakeHomePayReport,\\n  PayWithholdingsLedger,\\n  AnnualTaxReport,\\n]);\\n\\nexport type CalculatorRunReport = typeof CalculatorRunReport.Type;\\n\\n/**\\n * Calculator run response with catalog metadata, diagnostics and the typed\\n * calculator-specific report.\\n */\\nexport const CalculatorRunResponse = Schema.Struct({\\n  calculator: CalculatorCatalogItem,\\n  diagnostics: CalculationDiagnostics,\\n  report: CalculatorRunReport,\\n});\\n\\nexport type CalculatorRunResponse = typeof CalculatorRunResponse.Type;\\n\\nexport class CalculatorCatalogResponseData extends Data.Class<CalculatorCatalogResponse> {}\\n\\nexport class CalculatorRunResponseData extends Data.Class<CalculatorRunResponse> {}\\n\\n/**\\n * @deprecated Transitional API-era alias. Use `CalculatorRunFacts`.\\n */\\nexport const PublicCalculationFacts = CalculatorRunFacts.annotate({\\n  title: \\\"PublicCalculationFacts\\\",\\n});\\n\\n/**\\n * @deprecated Transitional API-era alias. Use `CalculatorRunFacts`.\\n */\\nexport type PublicCalculationFacts = CalculatorRunFacts;\\n\\n/**\\n * @deprecated Transitional API-era alias. Use `CalculatorRunRequest`.\\n */\\nexport const PublicCalculationRequest = CalculatorRunRequest.annotate({\\n  title: \\\"PublicCalculationRequest\\\",\\n});\\n\\n/**\\n * @deprecated Transitional API-era alias. Use `CalculatorRunRequest`.\\n */\\nexport type PublicCalculationRequest = CalculatorRunRequest;\\n\\n/**\\n * @deprecated Transitional API-era alias. Use `CalculatorRunServiceRequest`.\\n */\\nexport const PublicCalculationServiceRequest =\\n  CalculatorRunServiceRequest.annotate({\\n    title: \\\"PublicCalculationServiceRequest\\\",\\n  });\\n\\n/**\\n * @deprecated Transitional API-era alias. Use `CalculatorRunServiceRequest`.\\n */\\nexport type PublicCalculationServiceRequest = CalculatorRunServiceRequest;\\n\\n/**\\n * @deprecated Transitional API-era alias. Use `CalculatorRunReport`.\\n */\\nexport const PublicCalculationReport = CalculatorRunReport.annotate({\\n  title: \\\"PublicCalculationReport\\\",\\n});\\n\\n/**\\n * @deprecated Transitional API-era alias. Use `CalculatorRunReport`.\\n */\\nexport type PublicCalculationReport = CalculatorRunReport;\\n\\n/**\\n * @deprecated Transitional API-era alias. Use `CalculatorRunResponse`.\\n */\\nexport const PublicCalculationResponse = CalculatorRunResponse.annotate({\\n  title: \\\"PublicCalculationResponse\\\",\\n});\\n\\n/**\\n * @deprecated Transitional API-era alias. Use `CalculatorRunResponse`.\\n */\\nexport type PublicCalculationResponse = CalculatorRunResponse;\\n\\n/**\\n * @deprecated Transitional API-era alias. Use `CalculatorRunResponseData`.\\n */\\nexport class PublicCalculationResponseData extends CalculatorRunResponseData {}\\n# Cloudflare\\n\\n## Contents\\n\\n- [Ownership decisions](#ownership-decisions)\\n- [File ownership](#file-ownership)\\n- [Worker and asset semantics](#worker-and-asset-semantics)\\n- [Routes zones and domains](#routes-zones-and-domains)\\n- [Bindings and storage](#bindings-and-storage)\\n- [Website origin rules](#website-origin-rules)\\n- [Secrets](#secrets)\\n- [Observability](#observability)\\n- [State](#state)\\n- [Readback checklist](#readback-checklist)\\n\\n## Ownership decisions\\n\\nDeclare which system owns each Cloudflare lifecycle:\\n\\n- Worker or static-asset deployment;\\n- routes and custom domains;\\n- DNS/zone configuration;\\n- R2, D1, KV, Durable Objects, Queues, or Secrets Store;\\n- environment secrets and bindings;\\n- logs, metrics, traces, and observability destinations;\\n- remote state infrastructure.\\n\\nDo not assume Alchemy owns all Cloudflare resources because it owns one Worker.\\n\\n## File ownership\\n\\nFor a small graph:\\n\\n```text\\nsrc/lib/build/cloudflare.ts\\n```\\n\\nFor a substantial graph:\\n\\n```text\\nsrc/lib/build/cloudflare/\\n  stack.ts\\n  website.ts\\n  worker.ts\\n  storage.ts\\n  routes.ts\\n  secrets.ts\\n  observability.ts\\n```\\n\\nKeep stage/config Schemas outside provider declarations when other providers share them.\\n\\n## Worker and asset semantics\\n\\nMake asset routing policy explicit. In particular, distinguish asset-first and Worker-first behaviour and test the intended choice. A deployed Worker and green CI do not prove that static assets return the correct content type or bypass the Worker.\\n\\nTest:\\n\\n- root document;\\n- hashed CSS and JavaScript assets;\\n- missing assets;\\n- API paths;\\n- redirects;\\n- cache headers;\\n- content types;\\n- route precedence.\\n\\nRecord compatibility date, compatibility flags, runtime limits, module format, and bundler inputs in a stable typed owner. Keep application and deployment configuration aligned through one contract or an invariant test.\\n\\n## Routes, zones, and domains\\n\\nTreat a zone or domain as foreign unless this repository creates and owns it.\\n\\n- Read the target zone before applying routes.\\n- Adopt only under explicit authority.\\n- Default adopted zones and routes to retain.\\n- Restrict Production route adoption to the Production stage.\\n- Reject a route whose account/zone does not match the authority record.\\n- Read back the route pattern and bound Worker after apply.\\n- Prove the public host independently.\\n\\nDo not infer route correctness from a Worker URL.\\n\\n## Bindings and storage\\n\\nModel each binding as typed desired state:\\n\\n- binding name;\\n- resource kind;\\n- physical resource identity;\\n- stage/environment;\\n- creation/adoption policy;\\n- removal policy.\\n\\nAssert that application code and deployment configuration use the same binding names. For Durable Objects, include class name, migration/tag policy, and deployment sequencing. For R2/D1/KV, make data retention explicit and default destructive deletion to forbidden until authorised.\\n\\n## Website origin rules\\n\\nAn origin is the protocol and host, with an optional port, such as\\n`http://127.0.0.1:3210`. The deployed host owns that address. Applications must\\nnever hard-code it or build it from a stage, Worker name, account subdomain,\\ncustom domain or development port.\\n\\nFor Alchemy `2.0.0-beta.79`, use the native self URL binding on the host that\\nneeds its own address:\\n\\n```typescript\\nconst website =\\n  yield *\\n  Cloudflare.Website.Vite(\\\"Website\\\", {\\n    rootDir: \\\"apps/web\\\",\\n    env: { PUBLIC_ORIGIN: Cloudflare.Worker.URL },\\n  });\\n\\n// The same binding works in a native Worker declaration.\\nconst api =\\n  yield *\\n  Cloudflare.Worker(\\\"Api\\\", {\\n    main: \\\"./src/worker.ts\\\",\\n    env: { PUBLIC_ORIGIN: Cloudflare.Worker.URL },\\n  });\\n```\\n\\nAlchemy resolves this binding to the local development proxy during local\\ndevelopment, the deployed `workers.dev` address, or the configured custom\\ndomain. Do not add separate local/cloud address formulas or a copied-address\\nfallback. For Vite browser code, a `VITE_`-prefixed self URL binding uses the\\nsame native resolution before the client bundle is built.\\n\\nIt is valid to declare a chosen custom domain as infrastructure input, for\\nexample `domain: \\\"app.example.com\\\"`. Keep the application's own\\n`PUBLIC_ORIGIN` bound to `Cloudflare.Worker.URL`; do not repeat that domain in\\nits environment or build `\\\"https://\\\" + domain` there. Aliases and incoming\\nrequest origins are separate from the host's configured canonical address.\\n\\nFor a different host, use that resource's native Output, such as `api.url`.\\nPass the Output to the receiving resource; check its resolved value with the\\nowning Schema when application code reads the binding. If the native address\\ncan be absent, preserve that absence as `null` for an env binding and reject it\\nwith the Schema. Do not replace an absent Output with a guessed address.\\n\\nKeep expected validation failures typed. Beta.79's `Output.mapEffect` callback\\naccepts no expected errors, so do not force Schema decoding into it with\\n`Effect.orDie`. `Output.map` may select a checked resource attribute or represent\\nabsence; it must not reconstruct the hostname. Resolve and decode Outputs\\nseparately before writing workflow or receipt values.\\n\\nCheck the selected Alchemy version's self URL, Vite, native Worker and local\\nprovider APIs before copying this example. See the\\n[matching primary sources](../sources.md#cloudflare-website-origins).\\nLocal source/type checks do not prove live domain routing.\\n\\n## Separate Website and native API Workers\\n\\nUse standard Website.Vite for the frontend and a native Effect Worker for the\\nAPI. The root stack deploys both with exact same-stage service/public bindings.\\nPreview has its own API; a Website preview parent does not authorise using the\\nProduction API. Do not wrap TanStack in a backend Worker or recreate an API\\nruntime around the native incoming request fibre.\\n\\n@taxkit/scripts release:check: $ turbo run //#lint:task\\n@taxkit/scripts release:check: $ turbo run //#format:check:task\\n@taxkit/scripts release:check: //#format:check:task:  ERROR  command (<home>/.codex/worktrees/aac7/taxkit/) /private/tmp/taxkit-local-toolchain/bun-darwin-aarch64/bun run format:check:task exited (1)\\n@taxkit/scripts release:check:  ERROR  run failed: command  exited (1)\\n@taxkit/scripts release:check: error: script \\\"format:check\\\" exited with code 1\\n@taxkit/scripts release:check: error: script \\\"verification\\\" exited with code 1\\n@taxkit/scripts release:check: \\n@taxkit/scripts release:check: recovery: repair the named local boundary and rerun CI; no candidate or attempt receipt exists in CI mode.\\n@taxkit/scripts release:check: Exited with code 1\\nerror: script \\\"release:check\\\" exited with code 1\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10e2a-6616-7a42-8b17-50e4af22487f","create_time":1791262146.979968}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
