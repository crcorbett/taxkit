checked in source and packed declarations.\\\",\\n    \\\"restoration\\\": \\\"All 21 frozen sources match exact frozen bytes; Worker entry, lockfile and OpenAPI match parent.\\\",\\n    \\\"screenshots\\\": \\\"All four images match inspected parent bytes.\\\",\\n    \\\"scope\\\": \\\"T004 trusted native rate identity/limits and DEV-76 to DEV-81 remain unfinished.\\\"\\n  },\\n  \\\"artifacts\\\": [\\n    {\\n      \\\"root\\\": \\\".alchemy/native-pair/bundles/TaxKitApi\\\",\\n      \\\"files\\\": 167,\\n      \\\"sha256\\\": \\\"9fd8da28008c8417c82cd8ad23cfbcbbd89b885cc2fa752c6365e0d307825100\\\"\\n    },\\n    {\\n      \\\"root\\\": \\\"apps/web/dist/server\\\",\\n      \\\"files\\\": 20,\\n      \\\"sha256\\\": \\\"1c82ab07696849af31e7b99fed38a8deeb2b0b9805901b3d9d493126d69741d8\\\"\\n    },\\n    {\\n      \\\"root\\\": \\\"apps/web/dist/client\\\",\\n      \\\"files\\\": 9,\\n      \\\"sha256\\\": \\\"6126822072769eec4ffee149c7affa90c696c1a1c7790b24d07b400876cfe39d\\\"\\n    },\\n    {\\n      \\\"root\\\": \\\".alchemy/native-pair/settings-defect/server\\\",\\n      \\\"files\\\": 20,\\n      \\\"sha256\\\": \\\"54cb5253de9d8af883e036ed16ea74b83a737b3f5954d14139a92c467c9372cf\\\"\\n    },\\n    {\\n      \\\"root\\\": \\\".alchemy/native-pair/bundles/TaxKitApiRpcDefect\\\",\\n      \\\"files\\\": 39,\\n      \\\"sha256\\\": \\\"1e839ee5c73a0e01faa93da9bc30c1945e8d62ab73d3a606aaf69b9fd855fcbf\\\"\\n    },\\n    {\\n      \\\"root\\\": \\\".alchemy/native-pair/bundles/TaxKitApiInvalidReply\\\",\\n      \\\"files\\\": 39,\\n      \\\"sha256\\\": \\\"6980dc0b6f819f1bd4746160203d8121981633a48a698199471d2214b99c9e3c\\\"\\n    },\\n    {\\n      \\\"root\\\": \\\".alchemy/native-pair/bundles/TaxKitApiStalledHeaders\\\",\\n      \\\"files\\\": 39,\\n      \\\"sha256\\\": \\\"aba653c3ced7206be88b3c4e73d79e442c187c277463a642857c9724af3ae405\\\"\\n    },\\n    {\\n      \\\"root\\\": \\\".alchemy/native-pair/bundles/TaxKitApiStalledBody\\\",\\n      \\\"files\\\": 39