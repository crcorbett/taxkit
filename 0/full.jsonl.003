n\\nexport const isScopeEjected = (scope: Scope.Scope) => scopeEjected in scope;\\n\\nexport const serve = <Req = never>(\\n  handler: Effect.Effect<\\n    HttpServerResponse.HttpServerResponse,\\n    HttpServerError | HttpBodyError,\\n    HttpServerRequest | Scope.Scope | Req\\n  >,\\n) =>\\n  Effect.serviceOption(HttpServer).pipe(\\n    Effect.map(Option.getOrUndefined),\\n    Effect.flatMap((http) =>\\n      http\\n        ? // `HttpServer.serve` registers the server on the ambient Scope and\\n          // RETURNS; the server lives until that scope closes. A host program\\n          // (ECS task/service, EC2 instance) must therefore park forever after\\n          // a successful registration — otherwise a pure `{ fetch }` program\\n          // completes immediately, `Effect.scoped` closes the scope, and the\\n          // container exits 0 in a crash-loop. (One-shot `{ run }` programs\\n          // never call `serve`, so they still exit when `run` completes.)\\n          Effect.andThen(http.serve(handler), Effect.never)\\n        : Effect.void,\\n    ),\\n  );\\n\\nexport class HttpServer extends Context.Service<\\n  HttpServer,\\n  {\\n    serve: <Req = never>(\\n      handler: Effect.Effect<\\n        HttpServerResponse.HttpServerResponse,\\n        HttpServerError | HttpBodyError,\\n        Req\\n      >,\\n      options?: {\\n        port?: number;\\n      },\\n    ) => Effect.Effect<\\n      void,\\n      never,\\n      Exclude<Req, HttpServerRequest> | Scope.Scope\\n    >;\\n  }\\n>()(\\\"HttpServer\\\") {}\\n\\nexport const safeHttpEffect = <Req = never>(\\n  handler: HttpEffect<Req> | Effect.Effect<HttpEffect<Req>>,\\n): Effect.Effect<\\n  HttpServerResponse.HttpServerResponse,\\n  never,\\n  Req | HttpServerRequest | Scope.Scope\\n> =>\\n  Effect.catchCause(\\n    handler.pipe(\\n      // @ts-expect-error\\n      Effect.flatMap((response) =>\\n        HttpServerResponse.isHttpServerResponse(response)\\n          ? Effect.succeed(response)\\n          : response,\\n      ),\\n    ) as any as HttpEffect<Req>,\\n    (cause) =>\\n      // `causeResponse` is effect's native failure boundary: Respondable\\n      Effect.provideService(ConfigProvider.ConfigProvider, settings),\\n      Effect.scoped\\n    )\\n  );\\n\\n  it.effect(\\\"defers address reads during construction and decodes once\\\", () =>\\n    Effect.gen(function* () {\\n      const reads = yield* Ref.make(0);\\n      const provider = ConfigProvider.make((path) =>\\n        settings\\n          .load(path)\\n          .pipe(Effect.tap(() => Ref.update(reads, (count) => count + 1)))\\n      );\\n      const app = yield* ApiWorkerInit.pipe(\\n        Effect.provideService(ConfigProvider.ConfigProvider, provider)\\n      );\\n      expect(yield* Ref.get(reads)).toBe(0);\\n      const request = HttpServerRequest.fromWeb(\\n        new Request(\\\"https://api.example.com/api/health\\\")\\n      );\\n      const first = yield* app.fetch.pipe(\\n        Effect.provideService(ConfigProvider.ConfigProvider, provider),\\n        Effect.provideService(HttpServerR…267 tokens truncated…pect(\\n          yield* Effect.promise(() => HttpServerResponse.toWeb(response).text())\\n        ).toBe(\\\"\\\");\\n      }).pipe(\\n        Effect.provideService(\\n          ConfigProvider.ConfigProvider,\\n          ConfigProvider.fromUnknown({})\\n        ),\\n        Effect.scoped\\n      )\\n  );\\n\\n  it.effect(\\n    \\\"returns safe global protocol errors with no native console output\\\",\\n    () =>\\n      Effect.gen(function* () {\\n        const app = yield* ApiWorkerInit;\\n        const request = yield* Schema.encodeEffect(NativeRequest)(\\n        })\\n      );\\n      const response = yield* app.fetch.pipe(\\n        Effect.provideService(\\n          HttpServerRequest.HttpServerRequest,\\n          HttpServerRequest.fromWeb(\\n            new Request(\\\"https://api.example.com/rpc\\\", {\\n              body,\\n              headers: { \\\"content-type\\\": \\\"application/json\\\" },\\n              method: \\\"POST\\\",\\n            })\\n          )\\n        ),\\n        Effect.scoped\\n      );\\n      const text = yield* Effect.promise(() =>\\n        HttpServerResponse.toWeb(response).text()\\n      );\\n      const lines = yield* TestConsole.logLines;\\n      expect(text).toContain(\\\"Calculation service failed\\\");\\n      expect(text).not.toContain(sensitiveSentinel);\\n      expect(lines.length).toBeGreaterThan(0);\\n      expect(yield* Schema.encodeEffect(Json)(lines)).not.toContain(\\n        sensitiveSentinel\\n      );\\n    }).pipe(\\n      Effect.provideService(ConfigProvider.ConfigProvider, settings),\\n      Effect.provide(TestConsole.layer),\\n      Effect.scoped\\n    )\\n  );\\n});\\ncat: apps/web/src/vite-env.d.ts: No such file or directory\\n{\\n  \\\"$schema\\\": \\\"node_modules/wrangler/config-schema.json\\\",\\n  \\\"name\\\": \\\"taxkit-website-local-candidate\\\",\\n  \\\"main\\\": \\\"src/server.ts\\\",\\n  \\\"compatibility_date\\\": \\\"2026-10-04\\\",\\n  \\\"compatibility_flags\\\": [\\\"nodejs_compat\\\"],\\n  \\\"observability\\\": {\\n    \\\"enabled\\\": false,\\n    \\\"head_sampling_rate\\\": 0,\\n    \\\"logs\\\": {\\n      \\\"enabled\\\": false,\\n      \\\"head_sampling_rate\\\": 0,\\n      \\\"invocation_logs\\\": false,\\n      \\\"persist\\\": false,\\n    },\\n    \\\"traces\\\": {\\n      \\\"enabled\\\": false,\\n      \\\"head_sampling_rate\\\": 0,\\n      \\\"persist\\\": false,\\n    },\\n  },\\n  \\\"services\\\": [\\n    { \\\"binding\\\": \\\"TAXKIT_API\\\", \\\"service\\\": \\\"taxkit-api-local-candidate\\\" },\\n  ],\\n  \\\"vars\\\": {\\n    \\\"API_PUBLIC_ORIGIN\\\": \\\"http://127.0.0.1:4101\\\",\\n    \\\"WEBSITE_PUBLIC_ORIGIN\\\": \\\"http://127.0.0.1:4100\\\",\\n  },\\n}\\n136:export class Override\\n137:  extends Context.Service<Override, Record<string, unknown>>()(\\\"effect/http-api/OpenApi/Override\\\")\\n227:  override: Override,\\n397:      processAnnotation(group.annotations, Override, (override) => {\\n434:      function processResponseBodies(bodies: ResponseBodies, defaultDescription: () => string) {\\n592:      processResponseBodies(\\n593:        extractSuccessResponseBodies(endpoint),\\n596:      processResponseBodies(\\n597:        extractResponseBodies(\\n621:        processAnnotation(endpoint.annotations, Override, (override) => {\\n666:  processAnnotation(api.annotations, Override, (override) => {\\n822:type ResponseBodies = Map<\\n834:function extractSuccessResponseBodies(endpoint: HttpApiEndpoint.Top): ResponseBodies {\\n835:  return extractResponseBodies(\\n842:function extractResponseBodies(\\n846:): ResponseBodies {\\n872:        HttpApiSchema.getResponseEncodingSchema(schema),\\n1214:export type OpenAPISpecResponses = Record<number, OpenApiSpecResponse>\\n736:      readonly headers: Schema.Struct<Headers>\\n742: * Encodes a schema as a `{ body, headers }` pair, folding response headers into\\n747: * The encoded side is the pair of the body schema and the headers fields; the\\n759: * **Example** (Encoding an error with headers)\\n772: *     headers: {\\n776: *     decode: ({ headers }) => new UserNotFound({ userId: headers[\\\"x-user-id\\\"] }),\\n778: *       headers: { \\\"x-user-id\\\": error.userId },\\n785: * encoded // => { body: undefined, headers: { \\\"x-user-id\\\": 123 } }\\n801:  readonly headers: Headers\\n804:    value: Schema.Struct.Type<{ readonly body: Body; readonly headers: Schema.Struct<Headers> }>\\n808:  ) => Schema.Struct.Type<{ readonly body: Body; readonly headers: Schema.Struct<Headers> }>\\n812:    const headers = Schema.Struct(options.headers)\\n815:    return Schema.Struct({ body, headers }).pipe(\\n823:        headers,\\n825:        headersCodec: headers,\\n\"}"},{"type":"input_text","text":"Rate Limiting · Cloudflare Workers docs (https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/)\nciteturn26view0 [wordlim: 200] Crawled: today; Content type: text/html; Source: find({\"ref_id\":\"turn25view0\",\"pattern\":\"eventually\"}); Total lines: 846\nL771: For example, if a request comes in from Sydney, Australia, to the Worker shown above, after 100 requests in a 60 second window, any further requests for a particular path would be rejected, and a 429 HTTP status code returned. But this would only apply to requests served in Sydney. For each unique key you pass to your rate limiting binding, there is a unique limit per Cloudflare location.\nL772: ## Performance\nL773: \nL774: The Rate Limiting API in Workers is designed to be fast.\nL775: \nL776: The underlying counters are cached on the same machine that your Worker runs in, and updated asynchronously in the background by communicating with a backing store that is within the same Cloudflare location.\nL777: \nL778: This means that while in your code you `await` a call to the `limit()` method:\nL779: \nL780:     `const { success } = await env.MY_RATE_LIMITER.limit({ key: customerId })`\nL781: You are not waiting on a network request. You can use the Rate Limiting API without introducing any meaningful latency to your Worker.\nL782: ## Accuracy\nL783: \nL784: The above also means that the Rate Limiting API is permissive, eventually consistent, and intentionally designed to not be used as an accurate accounting system.\nL785: For example, if many requests come in to your Worker in a single Cloudflare location, all rate limited on the same key, the cite400†isolate that serves each request will check against its locally cached value of the rate limit. Very quickly, but not immediately, these requests will count towards the rate limit within that Cloudflare location.\nL786: ## Monitoring\nL787: \nL788: Rate limiting bindings are not currently visible in the Cloudflare dashboard. To monitor rate-limited requests from your Worker:\nL789:   * cite234†Workers Observability — Use cite237†Workers Logs and cite241†Traces to observe HTTP 429 responses returned by your Worker when rate limits are exceeded.\nL790:   * cite105†Workers Analytics Engine — Add an Analytics Engine binding to your Worker and emit custom data points (for example, a `rate_limited` event) when `limit()` returns `{ success: false }`. This lets you build dashboards and query rate limiting metrics over time.\nL791: ## Examples\nL792:   * cite401†`@elithrar/workers-hono-rate-limit` ↗︎†github.com — Middleware that lets you easily add rate limits to routes in your cite402†Hono ↗︎†hono.dev application.\nL793:   * cite403†`@hono-rate-limiter/cloudflare` ↗︎†github.com — Middleware that lets you easily add rate limits to routes in your cite402†Hono ↗︎†hono.dev application, with multiple data stores to choose from.\nL794:   * cite404†`hono-cf-rate-limit` ↗︎†github.com — Middleware for Hono applications that applies rate limiting in Cloudflare Workers, powered by Wrangler’s built-in features.\nL795: cite119†PreviousR2 ↗︎ cite44†NextSecrets ↗︎ L796: \nL797: Was this helpful?\nL798: \nL799: Yes No\nL800: \nL801: cite405†Edit page†github.com cite406†Report issue†github.com L802: ## On this page\nL803: \nL804:   * cite407†Overview L805:   * cite408†Get started L806:   * cite409†Configuration L807:   * cite410†Best practices L808:   * cite411†Locality L809:   * cite412†Performance L810:   * cite413†Accuracy L811:   * cite414†Monitoring L812:   * cite415†Examples L813: \nL814: cite405†Edit page†github.com cite406†Report issue†github.com L815: \nL816: Getting started\n--------------------------------------------------------------------------------\nCloudflare HTTP headers · Cloudflare Fundamentals docs (https://developers.cloudflare.com/fundamentals/reference/http-headers/)\nciteturn26view1 [wordlim: 200] Crawled: today; Content type: text/html; Source: find({\"ref_id\":\"turn25view1\",\"pattern\":\"same-zone\"}); Total lines: 417\nL215: ### Accept-Encoding\nL216: \nL217: For incoming requests, the value of this header will always be set to `accept-encoding: br, gzip`. If the client set a different value, such as `accept-encoding: deflate`, it will be overwritten and the original value will be available in `request.cf.clientAcceptEncoding`.\nL218: ### CF-Connecting-IP\nL219: \nL220: `CF-Connecting-IP` provides the client IP address connecting to Cloudflare to the origin web server. This header will only be sent on the traffic from Cloudflare's edge to your origin web server.\nL221: \nL222: For guidance on logging your visitor's original IP address, refer to cite138†Restoring original visitor IPs .\nL223: Alternatively, if you do not wish to receive the `CF-Connecting-IP` header or any HTTP header that may contain the visitor's IP address, cite139†enable the Remove visitor IP headers Managed Transform .\nL224: #### CF-Connecting-IP in Worker subrequests\nL225: \nL226: In same-zone Worker subrequests, the value of `CF-Connecting-IP` reflects the value of `x-real-ip` (the client's IP). `x-real-ip` can be altered by the user in their Worker script.\nL227: \nL228: In cross-zone subrequests from one Cloudflare zone to another Cloudflare zone, the `CF-Connecting-IP` value will be set to the Worker client IP address `'2a06:98c0:3600::103'` for security reasons.\nL229: For Worker subrequests destined for a non-Cloudflare customer zone, the `CF-Connecting-IP` and `x-real-ip` headers will both reflect the client's IP address, with only the `x-real-ip` header able to be altered.\nL230: \nL231: When no Worker subrequest is triggered, `cf-connecting-ip` reflects the client's IP address and the `x-real-ip` header is stripped.\nL232: ### CF-Connecting-IPv6\nL233: \nL234: Cloudflare provides cite140†free IPv6 support to all domains without requiring additional configuration or hardware. To support migrating to IPv6, Cloudflare's cite141†Pseudo IPv4 provides an IPv6 to IPv4 translation service for all Cloudflare domains.\nL235: \nL236: If Pseudo IPv4 is set to `Overwrite Headers` - Cloudflare overwrites the existing `Cf-Connecting-IP` and `X-Forwarded-For` headers with a pseudo IPv4 address while preserving the real IPv6 address in `CF-Connecting-IPv6` header.\nL237: ### CF-EW-Via\nL238: \nL239: This header is used for loop detection, similar to the `CDN-Loop` cite142†header ↗︎†blog.cloudflare.com .\nL240: \nL241: ### CF-Pseudo-IPv4\nL242: \nL243: If cite141†Pseudo IPv4 is set to `Add Header` - Cloudflare automatically adds the `CF-Pseudo-IPv4` header with a Class E IPv4 address hashed from the original IPv6 address.\nL244: ### True-Client-IP (Enterprise plan only)\nL245: \nL246: `True-Client-IP` provides the original client IP address to the origin web server. `True-Client-IP` is only available on an Enterprise plan. In the example below, `203.0.113.1` is the original visitor IP address. For example: `True-Client-IP: 203.0.113.1`\nL247: There is no difference between the `True-Client-IP` and `CF-Connecting-IP` headers besides the name of the header. Some Enterprise customers with legacy devices need `True-Client-IP` to avoid updating firewalls or load-balancers to read a custom header name.\nL248: \nL249: To add a `True-Client-IP` HTTP header to requests, cite139†enable the Add \"True-Client-IP\" header Managed Transform .\n--------------------------------------------------------------------------------\nCloudflare HTTP headers · Cloudflare Fundamentals docs (https://developers.cloudflare.com/fundamentals/reference/http-headers/)\nciteturn26view2 [wordlim: 200] Crawled: today; Content type: text/html; Source: find({\"ref_id\":\"turn25view1\",\"pattern\":\"CF-Worker\"}); Total lines: 417\nL291: To add this header to requests, along with other HTTP headers with location information for the visitor's IP address, cite139†enable the Add visitor location headers Managed Transform .\nL292: \nL293: Note\nL294: \nL295: The `CF-IPCountry` header is removed from requests made from a Worker to an origin that is not proxied behind Cloudflare.\nL296: ### CF-Visitor\nL297: \nL298: Currently, this header is a JSON object, containing only one key called `scheme`. The header will be either HTTP or HTTPS, and it is only relevant if you need to enable Flexible SSL in your Cloudflare settings. For example: `CF-Visitor: { \\\"scheme\\\":\\\"https\\\"}`.\nL299: \nL300: ### CDN-Loop\nL301: \nL302: `CDN-Loop` allows Cloudflare to specify how many times a request can enter Cloudflare's network before it is blocked as a looping request. For example: `CDN-Loop: cloudflare`.\nL303: ### CF-Connecting-O2O\nL304: \nL305: If cite150†SSL for SaaS is used for cite151†the SaaS provider-owned zone , a HTTP header will be set to `cf-connecting-o2o: 1`.\nL306: ### CF-Worker\nL307: \nL308: The `CF-Worker` request header is added to an edge Worker subrequest that identifies the host that spawned the subrequest. For example: `CF-Worker: example.com`.\nL309: \nL310: You can add `CF-Worker` header on server logs similar to the way you add the cite147†`CF-RAY` header. To do that, add `$http_cf_worker` in the log format file: `log_format cf_custom \"CF-Worker:$http_cf_worker\"'`\nL311: `CF-Worker` is added to all Worker subrequests sent via `fetch()`. It is set to the name of the zone which owns the Worker making the subrequest. For example, a Worker script on route for `foo.example.com/*` from `example.com` will have all subrequests with the header:\nL312: \nL313:     `CF-Worker: example.com`\nL314: The intended purpose of this header is to provide a means for recipients (for example, origins, load balancers, other Workers) to recognize, filter, and route traffic generated by Workers on specific zones.\nL315: \nL316: Note\nL317: \nL318: When configuring WAF custom rules, do not match on this header. These rules are applied before Cloudflare adds the `CF-Worker` header. Instead, use the cite152†`cf.worker.upstream_zone` field, which contains the same value and exists for the same purpose.\nL319: To block a specific Worker, add a `Block` action triggered by the expression `cf.worker.upstream_zone eq \"example.com\"`.\nL320: \nL321: To block all Worker subrequests except those from your own zone's Worker, add a `Block` action triggered by the expression `not (cf.worker.upstream_zone in {\"\" \"customer-zone.com\"})`.\nL322: ### Connection\nL323: \nL324: For incoming requests, the value of this header will always be set to `Keep-Alive`. If the client set a different value, such as `close`, it will be overwritten. Note that is also the case when the client uses HTTP/2 or HTTP/3 to connect.\nL325: ### Considerations for Spectrum\nL326: \nL327: When using Spectrum with a TCP application, these headers are not visible at the origin as they are HTTP headers. If you wish to utilize these in your application, there are two options:\nL328: \nL329:   * Use an HTTP or HTTPS Spectrum app instead of TCP\nL330:   * Use the cite153†Proxy Protocol feature L331: \nL332: ## Response headers\nL333: \nL334: Cloudflare will remove some HTTP headers from the response sent back to the visitor and add some Cloudflare-specific HTTP headers.\nL335: ### Removed response headers\nL336: \nL337: Cloudflare passes all HTTP headers in the response from the origin server back to the visitor with the exception of the following headers:\nL338: \nL339:   * `X-Accel-Buffering`\nL340:   * `X-Accel-Charset`\nL341:   * `X-Accel-Limit-Rate`\nL342:   * `X-Accel-Redirect`\nL343:   * `Alt-Svc`\nL344: \nL345: ### Added response headers\nL346: \nL347: Cloudflare adds the HTTP headers specified below to the response sent to the visitor.\nL348: #### Cf-Ray\nL349: \nL350: The `Cf-Ray` value returned to the visitor will be the same `Cf-Ray` value that was sent to the origin server.\nL351: \nL352: #### Cf-Cache-Status\nL353: \nL354: A list of all possible `Cf-Cache-Status` values is contained in cite154†Cloudflare cache responses .\nL355: \nL356: cite109†PreviousCloudflare crawlers cite111†NextCloudflare Ray ID L357: \nL358: Was this helpful?\nL359: \nL360: Yes No\nL361: \nL362: cite155†Edit page†github.com cite156†Report issue†github.com L363: ## On this page\nL364:   * cite157†Overview L365:   * cite158†Request headers L366:   * cite159†Accept-Encoding L367:   * cite160†CF-Connecting-IP L368:   * cite161†CF-Connecting-IPv6 L369:   * cite162†CF-EW-Via L370:   * cite163†CF-Pseudo-IPv4 L371:   * cite164†True-Client-IP (Enterprise plan only) L372:   * cite165†X-Forwarded-For L373:   * cite166†X-Forwarded-Proto L374:   * cite167†Cf-Ray L375:   * cite168†CF-IPCountry L376:   * cite169†CF-Visitor L377:   * cite170†CDN-Loop L378:   * cite171†CF-Connecting-O2O L379:   * cite172†CF-Worker L380:   * cite173†Connection L381:   * cite174†Considerations for Spectrum L382:   * cite175†Response headers L383:   * cite176†Removed response headers L384:   * cite177†Added response headers L385: cite155†Edit page†github.com cite156†Report issue†github.com L386: \nL387: Getting started\nL388: \nL389: cite178†Plans†www.cloudflare.com cite179†Contact sales†www.cloudflare.com cite180†Partners†www.cloudflare.com cite181†Find a partner†partnerlocator.cloudflare.com cite182†Startups†www.cloudflare.com cite183†Under attack?†www.cloudflare.com cite184†Domain name search†domains.cloudflare.com L390: \nL391: Company\nL392: cite185†About†www.cloudflare.com cite186†Careers†www.cloudflare.com cite187†Investors†cloudflare.net cite188†Press†www.cloudflare.com cite189†Press kit†www.cloudflare.com cite190†Global network†www.cloudflare.com L393: \nL394: Public interest\nL395: \nL396: cite191†Project Galileo†www.cloudflare.com cite192†Athenian Project†www.cloudflare.com cite193†Cloudflare for Campaigns†www.cloudflare.com cite194†Project Fairshot†www.cloudflare.com cite195†Impact/ESG†www.cloudflare.com L397: \nL398: Compliance\nL399: cite196†Compliance resources†www.cloudflare.com 