{"timestamp":"2026-10-06T04:48:57.376Z","ordinal":37797,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a10e2a-6616-7a42-8b17-50e4af22487f","item":{"type":"CommandExecution","id":"exec-bba6f744-48ef-406f-b1a5-8d55080f48e5","process_id":"76705","command":["/bin/zsh","-lc","cat /private/tmp/dev75-alchemy-rate-probe/entry.ts; cat apps/web/src/lib/loaders.server.ts; cat apps/web/src/server.ts; cat apps/web/src/lib/config.server.ts; rg --files packages/infrastructure | head -30; cat packages/api/rpc/src/client-response.boundary.ts; cat packages/api/http/src/groups/calculators.ts | tail -80; cat packages/api/http/src/handlers/calculators.ts"],"cwd":"file:///Users/cooper/.codex/worktrees/aac7/taxkit","parsed_cmd":[{"type":"read","cmd":"cat /private/tmp/dev75-alchemy-rate-probe/entry.ts","name":"entry.ts","path":"/private/tmp/dev75-alchemy-rate-probe/entry.ts"},{"type":"read","cmd":"cat apps/web/src/lib/loaders.server.ts","name":"loaders.server.ts","path":"apps/web/src/lib/loaders.server.ts"},{"type":"read","cmd":"cat apps/web/src/server.ts","name":"server.ts","path":"apps/web/src/server.ts"},{"type":"read","cmd":"cat apps/web/src/lib/config.server.ts","name":"config.server.ts","path":"apps/web/src/lib/config.server.ts"},{"type":"list_files","cmd":"rg --files packages/infrastructure","path":"infrastructure"},{"type":"read","cmd":"cat packages/api/rpc/src/client-response.boundary.ts","name":"client-response.boundary.ts","path":"packages/api/rpc/src/client-response.boundary.ts"},{"type":"read","cmd":"cat packages/api/http/src/groups/calculators.ts","name":"calculators.ts","path":"packages/api/http/src/groups/calculators.ts"},{"type":"read","cmd":"cat packages/api/http/src/handlers/calculators.ts","name":"calculators.ts","path":"packages/api/http/src/handlers/calculators.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"import { Worker, RateLimit, RateLimitBinding } from 'alchemy/Cloudflare/Workers';\nimport { Effect, Schema } from 'effect';\nimport { HttpServerRequest, HttpServerResponse } from 'effect/http';\nconst init = Effect.gen(function* () {\n const limiter = yield* RateLimit('RATE', {namespaceId:10075,simple:{limit:60,period:60}});\n const calculatorRequest = (request: Request, key: string) => Effect.gen(function* () {\n  yield* Effect.addFinalizer(() => Effect.logInfo('rate-bridge-preparation: released'));\n  const body = yield* Effect.promise(() => request.text());\n  const result = yield* limiter.limit({key}).pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({success:Schema.Boolean}))));\n  if(new URL(request.url).pathname === '/signal') {\n   yield* Effect.sleep('1 second');\n   yield* Effect.logInfo(request.signal.aborted ? 'rate-bridge-preparation: signal aborted' : 'rate-bridge-preparation: signal live');\n  }\n  return new Response(result.success ? body : 'Rate limit reached',{status:result.success?200:429,headers:{'content-type':'application/json'}});\n });\n return {\n  calculatorRequest,\n  fetch: Effect.gen(function* () {\n   const request = yield* HttpServerRequest.HttpServerRequest;\n   const native = yield* HttpServerRequest.toWeb(request);\n   return HttpServerResponse.fromWeb(yield* calculatorRequest(native,'fixture-A'));\n  }),\n };\n}).pipe(Effect.provide(RateLimitBinding));\nclass RateBridgePreparation extends Worker<RateBridgePreparation>()('TaxKitRateBridgePreparation') {}\nexport default RateBridgePreparation.make({main:import.meta.url,compatibility:{date:'2026-10-04',flags:['nodejs_compat']}},init);\nimport \"@tanstack/react-start/server-only\";\nimport { getRequest } from \"@tanstack/react-start/server\";\nimport { Effect, ErrorReporter, Schema } from \"effect\";\nimport { HttpServerError, HttpServerResponse } from \"effect/http\";\n\nimport { appRuntime } from \"./runtime.server\";\nimport { WebsiteCatalogueTransport, WebsiteSettingsTransport } from \"./schemas\";\nimport { WebsiteServerApplication } from \"./service.server\";\n\nexport const loadWebsiteSettingsServer = () =>\n  appRuntime.runPromise(\n    WebsiteServerApplication.pipe(\n      Effect.flatMap((application) =>\n        Effect.gen(function* () {\n          const settings = yield* application.settings.pipe(\n            Effect.result,\n            Effect.flatMap(Schema.encodeEffect(WebsiteSettingsTransport))\n          );\n          const catalogue = yield* application.catalogue.pipe(\n            Effect.result,\n            Effect.flatMap(Schema.encodeEffect(WebsiteCatalogueTransport))\n          );\n          return { catalogue, settings };\n        })\n      ),\n      Effect.orDie,\n      // Expected settings errors remain checked values. An unexpected failure\n      // reaches the host reporter and native empty response before TanStack can\n      // log or serialise an arbitrary Cause as a server-function error.\n      Effect.catchCause((cause) =>\n        HttpServerError.causeResponse(cause).pipe(\n          Effect.flatMap(([response, reportable]) =>\n            ErrorReporter.report(reportable).pipe(\n              Effect.as(HttpServerResponse.toWeb(response))\n            )\n          )\n        )\n      )\n    ),\n    { signal: getRequest().signal }\n  );\nimport {\n  createStartHandler,\n  defaultStreamHandler,\n} from \"@tanstack/react-start/server\";\nimport {\n  CalculatorRequestBodyPolicy,\n  withCalculatorRequestBodyLimit,\n} from \"@taxkit/api-http/request-boundary\";\nimport { AuAnnualTaxCalculatorId } from \"@taxkit/rules-au-income-tax/schemas\";\nimport { AuPayCalculatorId } from \"@taxkit/rules-au-pay/schemas\";\nimport { Effect, ErrorReporter, Match, Schema } from \"effect\";\nimport {\n  HttpServerError,\n  HttpServerRequest,\n  HttpServerResponse,\n} from \"effect/http\";\n\nimport { WebsiteServerFunctionBase } from \"./lib/config\";\nimport {\n  takeHomeRequestFromForm,\n  annualTaxRequestFromForm,\n  AnnualTaxForm,\n  TakeHomeForm,\n  WebsiteInputError,\n} from \"./lib/form.boundary\";\nimport type { WebsiteCalculatorForm } from \"./lib/form.boundary\";\nimport { WebsiteSettingsFunctionPath } from \"./lib/loaders\";\nimport { appRuntime } from \"./lib/runtime.server\";\nimport { WebsiteSubmission, WebsiteSubmissionTransport } from \"./lib/schemas\";\nimport type { WebsiteServerRenderContext } from \"./lib/schemas\";\nimport { WebsiteServerApplication } from \"./lib/service.server\";\n\nconst render = createStartHandler<{\n  server: { requestContext: WebsiteServerRenderContext };\n}>(defaultStreamHandler);\n\nexport default {\n  fetch: (request: Request) =>\n    // A standard HTML form remains usable without JavaScript. Its checked\n    // request reaches the same named RPC client through the private binding.\n    // Only plain, Schema-encoded form/report data reaches TanStack rendering.\n    appRuntime.runPromise(\n      Effect.gen(function* websiteRequest() {\n        const url = new URL(request.url);\n        const calculatorId = Match.value(url.pathname).pipe(\n          Match.when(\"/calculators/au.income-tax.annual\", () =>\n            AuAnnualTaxCalculatorId.make(\"au.income-tax.annual\")\n          ),\n          Match.when(\"/calculators/au.pay.withholdings\", () =>\n            AuPayCalculatorId.make(\"au.pay.withholdings\")\n          ),\n          Match.when(\"/\", () => AuPayCalculatorId.make(\"au.pay.take-home\")),\n          Match.orElse(() => null)\n        );\n        if (url.pathname.startsWith(`${WebsiteServerFunctionBase}/`)) {\n          if (url.pathname !== WebsiteSettingsFunctionPath) {\n            return HttpServerResponse.empty({ status: 404 });\n          }\n          // The only native server function reads settings and takes no data or\n          // client Context. Reject representation input before the framework's\n          // JSON/FormData parser can reflect it in an unexpected error.\n          if (request.method !== \"GET\") {\n            return HttpServerResponse.empty({\n              headers: { allow: \"GET\" },\n              status: 405,\n            });\n          }\n          if (url.search !== \"\") {\n            return HttpServerResponse.empty({ status: 400 });\n          }\n        }\n        if (request.method === \"POST\" && calculatorId === null) {\n          return HttpServerResponse.empty({ status: 404 });\n        }\n        return yield* request.method !== \"POST\" || calculatorId === null\n          ? Effect.promise(() =>\n              Promise.resolve(render(request, { context: {} }))\n            ).pipe(Effect.map(HttpServerResponse.fromWeb))\n          : withCalculatorRequestBodyLimit(\n              Effect.gen(function* () {\n                const incoming = yield* HttpServerRequest.HttpServerRequest;\n                const bounded = yield* HttpServerRequest.toWeb(incoming, {\n                  signal: request.signal,\n                });\n                const data = yield* Effect.tryPromise({\n                  catch: () =>\n                    new WebsiteInputError({\n                      message: \"Enter a valid pay amount and pay period.\",\n                    }),\n                  try: () => bounded.formData(),\n                });\n                const decodedForm: Effect.Effect<\n                  WebsiteCalculatorForm,\n                  Schema.SchemaError\n                > =\n                  calculatorId === \"au.income-tax.annual\"\n                    ? Schema.decodeUnknownEffect(AnnualTaxForm)({\n                        taxableDollars: data.get(\"taxableDollars\"),\n                      })\n                    : Schema.decodeUnknownEffect(TakeHomeForm)({\n                        grossDollars: data.get(\"grossDollars\"),\n                        period: data.get(\"period\"),\n                        taxFreeThresholdClaimed:\n                          data.get(\"taxFreeThresholdClaimed\") === \"on\",\n                      });\n                const form = yield* decodedForm.pipe(\n                  Effect.mapError(\n                    () =>\n                      new WebsiteInputError({\n                        message: \"Enter a valid pay amount and pay period.\",\n                      })\n                  )\n                );\n                const result = yield* (\n                  Schema.is(AnnualTaxForm)(form)\n                    ? annualTaxRequestFromForm(form)\n                    : takeHomeRequestFromForm(\n                        form,\n                        AuPayCalculatorId.make(\n                          calculatorId === \"au.pay.withholdings\"\n                            ? \"au.pay.withholdings\"\n                            : \"au.pay.take-home\"\n                        )\n                      )\n                ).pipe(\n                  Effect.fromResult,\n                  Effect.flatMap((input) =>\n                    WebsiteServerApplication.pipe(\n                      Effect.flatMap((application) =>\n                        application.calculate(input)\n                      )\n                    )\n                  ),\n                  Effect.result\n                );\n                const submission = yield* Schema.encodeEffect(\n                  WebsiteSubmissionTransport\n                )(WebsiteSubmission.make({ calculatorId, form, result })).pipe(\n                  Effect.orDie\n                );\n                const headers = new Headers(request.headers);\n                headers.delete(\"content-length\");\n                headers.delete(\"content-type\");\n                const response = yield* Effect.promise(() =>\n                  Promise.resolve(\n                    render(\n                      new Request(request.url, {\n                        headers,\n                        method: \"GET\",\n                        signal: request.signal,\n                      }),\n                      { context: { submission } }\n                    )\n                  )\n                );\n                return HttpServerResponse.fromWeb(response);\n              }),\n              CalculatorRequestBodyPolicy.make({ responseFormat: \"html\" })\n            ).pipe(\n              Effect.catchTag(\"WebsiteInputError\", () =>\n                Effect.succeed(HttpServerResponse.empty({ status: 400 }))\n              )\n            );\n      }).pipe(\n        // Native HTTP failure matching preserves aborts and safe empty errors.\n        // The installed host reporter discards arbitrary Causes before logging.\n        Effect.catchCause((cause) =>\n          HttpServerError.causeResponse(cause).pipe(\n            Effect.flatMap(([response, reportable]) =>\n              ErrorReporter.report(reportable).pipe(Effect.as(response))\n            )\n          )\n        ),\n        Effect.provideService(\n          HttpServerRequest.HttpServerRequest,\n          HttpServerRequest.fromWeb(request)\n        ),\n        Effect.scoped,\n        Effect.map(HttpServerResponse.toWeb)\n      ),\n      { signal: request.signal }\n    ),\n};\nimport \"@tanstack/react-start/server-only\";\nimport type { fromCloudflareFetcher } from \"alchemy/Cloudflare/Bridge\";\nimport { Config, Effect, Predicate, Schema } from \"effect\";\n\nimport { TaxKitWebConfigError } from \"./config\";\nimport { WebsiteHostOrigins } from \"./schemas\";\n\n// This is the native SDK capability boundary. Preserve the original Fetcher\n// object (and method receiver); a Struct would copy its methods off the binding.\nconst PrivateApiBinding: Schema.Codec<\n  Parameters<typeof fromCloudflareFetcher>[0]\n> = Schema.declare<Parameters<typeof fromCloudflareFetcher>[0]>(\n  (value): value is Parameters<typeof fromCloudflareFetcher>[0] =>\n    Predicate.isObject(value) &&\n    Predicate.hasProperty(value, \"fetch\") &&\n    Predicate.isFunction(value.fetch) &&\n    Predicate.hasProperty(value, \"connect\") &&\n    Predicate.isFunction(value.connect)\n);\nexport const TaxKitWebServerConfig = (\n  rawBinding: unknown\n): Effect.Effect<\n  typeof WebsiteHostOrigins.Type & {\n    readonly binding: typeof PrivateApiBinding.Type;\n  },\n  TaxKitWebConfigError\n> =>\n  Effect.all({\n    apiOrigin: Config.schema(\n      WebsiteHostOrigins.fields.apiOrigin,\n      \"API_PUBLIC_ORIGIN\"\n    ),\n    binding: Schema.decodeUnknownEffect(PrivateApiBinding)(rawBinding),\n    websiteOrigin: Config.schema(\n      WebsiteHostOrigins.fields.websiteOrigin,\n      \"WEBSITE_PUBLIC_ORIGIN\"\n    ),\n  }).pipe(\n    Effect.mapError(\n      () =>\n        new TaxKitWebConfigError({\n          message: \"TaxKit web settings are missing or invalid.\",\n          operation: \"settings\",\n          runtime: \"server\",\n        })\n    )\n  );\npackages/infrastructure/src/apps-secrets.boundary.ts\npackages/infrastructure/src/apps-stack.test.ts\npackages/infrastructure/src/stack.ts\npackages/infrastructure/src/cloudflare/website.test.ts\npackages/infrastructure/src/cloudflare/website.ts\npackages/infrastructure/src/apps-stack.ts\npackages/infrastructure/src/stage.ts\npackages/infrastructure/tsconfig.json\npackages/infrastructure/package.json\npackages/infrastructure/README.md\nimport { ByteSize, Effect, Match, Option, Schema, Stream } from \"effect\";\nimport { HttpClient, HttpClientError, HttpClientResponse } from \"effect/http\";\nimport type { RpcClientError } from \"effect/rpc\";\n\nimport {\n  CalculatorRpcInvalidResponse,\n  CalculatorRpcUnavailable,\n  CalculatorRpcRequestTooLarge,\n  CalculatorRpcRateLimited,\n  CalculatorRpcRequestTimedOut,\n  CalculatorRpcResponseTooLarge,\n} from \"./errors.js\";\nimport { CalculatorRpcResponseLimit } from \"./schemas.js\";\n\n// Native RPC retains the HTTP reason as an unknown cause. Read only the safe\n// status/size projection once; never expose its request, headers or body.\nconst RejectedHttpStatus = Schema.TaggedStruct(\"StatusCodeError\", {\n  response: Schema.Struct({ status: Schema.Literals([408, 413, 429]) }),\n});\nconst OversizedHttpReply = Schema.TaggedStruct(\"DecodeError\", {\n  cause: CalculatorRpcResponseTooLarge,\n});\n\nexport const calculatorRpcTransportFailure = (\n  error: RpcClientError.RpcClientError\n) =>\n  Match.value(error.reason).pipe(\n    Match.tag(\"RpcClientDefect\", () => new CalculatorRpcInvalidResponse()),\n    Match.tag(\"HttpError\", (reason) =>\n      Schema.decodeUnknownOption(\n        Schema.Union([RejectedHttpStatus, OversizedHttpReply])\n      )(reason.cause).pipe(\n        Option.match({\n          onNone: () =>\n            Match.value(reason.kind).pipe(\n              Match.whenOr(\n                \"DecodeError\",\n                \"EmptyBodyError\",\n                () => new CalculatorRpcInvalidResponse()\n              ),\n              Match.orElse(() => new CalculatorRpcUnavailable())\n            ),\n          onSome: (rejection) =>\n            Match.value(rejection).pipe(\n              Match.tag(\n                \"DecodeError\",\n                () => new CalculatorRpcResponseTooLarge()\n              ),\n              Match.tag(\"StatusCodeError\", ({ response }) =>\n                Match.value(response.status).pipe(\n                  Match.when(408, () => new CalculatorRpcRequestTimedOut()),\n                  Match.when(413, () => new CalculatorRpcRequestTooLarge()),\n                  Match.when(429, () => new CalculatorRpcRateLimited()),\n                  Match.exhaustive\n                )\n              ),\n              Match.exhaustive\n            ),\n        })\n      )\n    ),\n    Match.orElse(() => new CalculatorRpcUnavailable())\n  );\n\n// One concrete private HTTP adapter for all closed native operations. Keep\n// the native Protocol/parser/exit Schemas; count bytes before materialisation.\nexport const boundedCalculatorRpcHttpClient = (client: HttpClient.HttpClient) =>\n  client.pipe(\n    HttpClient.withScope,\n    HttpClient.filterStatusOk,\n    HttpClient.transformResponse(\n      Effect.flatMap((response) =>\n        response.stream.pipe(\n          Stream.mapAccumEffect(\n            () => ByteSize.bytes(0),\n            (total, chunk) => {\n              const next = ByteSize.sum(\n                total,\n                ByteSize.bytes(chunk.byteLength)\n              );\n              return ByteSize.isGreaterThan(next, CalculatorRpcResponseLimit)\n                ? Effect.fail(\n                    new HttpClientError.HttpClientError({\n                      reason: new HttpClientError.DecodeError({\n                        cause: new CalculatorRpcResponseTooLarge(),\n                        request: response.request,\n                        response,\n                      }),\n                    })\n                  )\n                : Effect.succeed([next, [chunk]] as const);\n            }\n          ),\n          Stream.mkUint8Array,\n          // This native Web reader ignores MaxBodySize. After the bounded read,\n          // reuse its Response adapter. The byte copy owns an ArrayBuffer body.\n          Effect.map((bytes) =>\n            HttpClientResponse.fromWeb(\n              response.request,\n              new Response(new Uint8Array(bytes), {\n                headers: response.headers,\n              })\n            )\n          )\n        )\n      )\n    ),\n    // Close the actual HTTP request after the bounded body read, or on status\n    // rejection/interruption, before native RPC parses the retained bytes.\n    HttpClient.transformResponse(Effect.scoped)\n  );\n    error: CalculatorApiMetadataErrorEnvelopes,\n    params: CalculatorParams,\n    query: HelpQuery,\n    success: CalculatorCatalogItem,\n  }\n).annotate(OpenApi.Description, \"Return one public calculator catalog entry.\");\n\nconst GetCalculatorSchemaEndpoint = HttpApiEndpoint.get(\n  \"getCalculatorSchema\",\n  \"/calculators/:calculatorId/schema\",\n  {\n    error: CalculatorApiMetadataErrorEnvelopes,\n    params: CalculatorParams,\n    query: HelpQuery,\n    success: CalculatorSchemaResponse,\n  }\n).annotate(\n  OpenApi.Description,\n  \"Return fact, rule and report schema metadata for one calculator.\"\n);\n\nconst GetCalculatorGraphEndpoint = HttpApiEndpoint.get(\n  \"getCalculatorGraph\",\n  \"/calculators/:calculatorId/graph\",\n  {\n    error: CalculatorApiMetadataErrorEnvelopes,\n    params: CalculatorParams,\n    query: MetadataQuery,\n    success: CalculatorGraphResponse,\n  }\n).annotate(\n  OpenApi.Description,\n  \"Return graph edges and canonical graph validation diagnostics for one calculator.\"\n);\n\nconst CalculateEndpoint = HttpApiEndpoint.post(\n  \"calculate\",\n  \"/calculators/:calculatorId/calculate\",\n  {\n    error: CalculatorApiErrorEnvelopes,\n    params: CalculatorParams,\n    payload: CalculatorRunRequest,\n    query: CalculationQuery,\n    success: CalculatorRunResponse,\n  }\n).annotate(\n  OpenApi.Description,\n  \"Run one public calculator using canonical scenario decoding and rule-pack layers.\"\n);\n\nconst ListFactsEndpoint = HttpApiEndpoint.get(\"listFacts\", \"/facts\", {\n  error: CalculatorApiTimeoutEnvelope,\n  query: DescriptorFilterQuery,\n  success: FactsResponse,\n}).annotate(\n  OpenApi.Description,\n  \"List canonical fact descriptors, optionally filtered by calculator context.\"\n);\n\nconst ListRulesEndpoint = HttpApiEndpoint.get(\"listRules\", \"/rules\", {\n  error: CalculatorApiTimeoutEnvelope,\n  query: DescriptorFilterQuery,\n  success: RulesResponse,\n}).annotate(\n  OpenApi.Description,\n  \"List canonical rule descriptors, optionally filtered by calculator context.\"\n);\n\nexport class CalculatorApiGroup extends HttpApiGroup.make(\"calculatorApi\")\n  .add(GetJurisdictionsEndpoint)\n  .add(GetTaxYearsEndpoint)\n  .add(ListCalculatorsEndpoint)\n  .add(GetCalculatorEndpoint)\n  .add(GetCalculatorSchemaEndpoint)\n  .add(GetCalculatorGraphEndpoint)\n  .add(CalculateEndpoint)\n  .add(ListFactsEndpoint)\n  .add(ListRulesEndpoint)\n  .prefix(\"/api/v1\")\n  .annotate(OpenApi.Title, \"Calculator API\") {}\nimport { PublicCalculatorService } from \"@taxkit/calculators\";\nimport type { CalculatorMetadataError } from \"@taxkit/calculators\";\nimport { Effect, Match } from \"effect\";\nimport { HttpApiBuilder } from \"effect/http-api\";\n\nimport { TaxKitApi } from \"../api.js\";\nimport { CalculatorApiErrorEnvelopeData } from \"../groups/calculators.js\";\n\nconst calculatorApiMetadataFailure = (error: CalculatorMetadataError) =>\n  Match.value(error).pipe(\n    Match.tag(\n      \"CalculatorOperationTimedOut\",\n      (failure) => new CalculatorApiErrorEnvelopeData({ error: failure })\n    ),\n    Match.orElse(\n      (failure) => new CalculatorApiErrorEnvelopeData({ error: failure })\n    )\n  );\n\nexport const CalculatorApiHandlerLive = HttpApiBuilder.group(\n  TaxKitApi,\n  \"calculatorApi\",\n  (handlers) =>\n    Effect.succeed(\n      handlers\n        .handle(\"getJurisdictions\", () =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listJurisdictions();\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n        .handle(\"getTaxYears\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listTaxYears(query);\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n        .handle(\"listCalculators\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listCalculators(query);\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n        .handle(\"getCalculator\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculator({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(Effect.mapError(calculatorApiMetadataFailure))\n        )\n        .handle(\"getCalculatorSchema\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculatorSchema({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(Effect.mapError(calculatorApiMetadataFailure))\n        )\n        .handle(\"getCalculatorGraph\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculatorGraph({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(Effect.mapError(calculatorApiMetadataFailure))\n        )\n        .handle(\"calculate\", ({ params, payload, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.calculate({\n              calculatorId: params.calculatorId,\n              payload,\n              ...query,\n            });\n          }).pipe(\n            Effect.mapError((error) =>\n              Match.value(error).pipe(\n                Match.tag(\n                  \"CalculatorCapacityExceeded\",\n                  (failure) =>\n                    new CalculatorApiErrorEnvelopeData({ error: failure })\n                ),\n                Match.tag(\n                  \"CalculatorOperationTimedOut\",\n                  (failure) =>\n                    new CalculatorApiErrorEnvelopeData({ error: failure })\n                ),\n                Match.orElse(\n                  (failure) =>\n                    new CalculatorApiErrorEnvelopeData({ error: failure })\n                )\n              )\n            )\n          )\n        )\n        .handle(\"listFacts\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listFacts(query);\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n        .handle(\"listRules\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listRules(query);\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n    )\n);\n","stderr":"","aggregated_output":"import { Worker, RateLimit, RateLimitBinding } from 'alchemy/Cloudflare/Workers';\nimport { Effect, Schema } from 'effect';\nimport { HttpServerRequest, HttpServerResponse } from 'effect/http';\nconst init = Effect.gen(function* () {\n const limiter = yield* RateLimit('RATE', {namespaceId:10075,simple:{limit:60,period:60}});\n const calculatorRequest = (request: Request, key: string) => Effect.gen(function* () {\n  yield* Effect.addFinalizer(() => Effect.logInfo('rate-bridge-preparation: released'));\n  const body = yield* Effect.promise(() => request.text());\n  const result = yield* limiter.limit({key}).pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({success:Schema.Boolean}))));\n  if(new URL(request.url).pathname === '/signal') {\n   yield* Effect.sleep('1 second');\n   yield* Effect.logInfo(request.signal.aborted ? 'rate-bridge-preparation: signal aborted' : 'rate-bridge-preparation: signal live');\n  }\n  return new Response(result.success ? body : 'Rate limit reached',{status:result.success?200:429,headers:{'content-type':'application/json'}});\n });\n return {\n  calculatorRequest,\n  fetch: Effect.gen(function* () {\n   const request = yield* HttpServerRequest.HttpServerRequest;\n   const native = yield* HttpServerRequest.toWeb(request);\n   return HttpServerResponse.fromWeb(yield* calculatorRequest(native,'fixture-A'));\n  }),\n };\n}).pipe(Effect.provide(RateLimitBinding));\nclass RateBridgePreparation extends Worker<RateBridgePreparation>()('TaxKitRateBridgePreparation') {}\nexport default RateBridgePreparation.make({main:import.meta.url,compatibility:{date:'2026-10-04',flags:['nodejs_compat']}},init);\nimport \"@tanstack/react-start/server-only\";\nimport { getRequest } from \"@tanstack/react-start/server\";\nimport { Effect, ErrorReporter, Schema } from \"effect\";\nimport { HttpServerError, HttpServerResponse } from \"effect/http\";\n\nimport { appRuntime } from \"./runtime.server\";\nimport { WebsiteCatalogueTransport, WebsiteSettingsTransport } from \"./schemas\";\nimport { WebsiteServerApplication } from \"./service.server\";\n\nexport const loadWebsiteSettingsServer = () =>\n  appRuntime.runPromise(\n    WebsiteServerApplication.pipe(\n      Effect.flatMap((application) =>\n        Effect.gen(function* () {\n          const settings = yield* application.settings.pipe(\n            Effect.result,\n            Effect.flatMap(Schema.encodeEffect(WebsiteSettingsTransport))\n          );\n          const catalogue = yield* application.catalogue.pipe(\n            Effect.result,\n            Effect.flatMap(Schema.encodeEffect(WebsiteCatalogueTransport))\n          );\n          return { catalogue, settings };\n        })\n      ),\n      Effect.orDie,\n      // Expected settings errors remain checked values. An unexpected failure\n      // reaches the host reporter and native empty response before TanStack can\n      // log or serialise an arbitrary Cause as a server-function error.\n      Effect.catchCause((cause) =>\n        HttpServerError.causeResponse(cause).pipe(\n          Effect.flatMap(([response, reportable]) =>\n            ErrorReporter.report(reportable).pipe(\n              Effect.as(HttpServerResponse.toWeb(response))\n            )\n          )\n        )\n      )\n    ),\n    { signal: getRequest().signal }\n  );\nimport {\n  createStartHandler,\n  defaultStreamHandler,\n} from \"@tanstack/react-start/server\";\nimport {\n  CalculatorRequestBodyPolicy,\n  withCalculatorRequestBodyLimit,\n} from \"@taxkit/api-http/request-boundary\";\nimport { AuAnnualTaxCalculatorId } from \"@taxkit/rules-au-income-tax/schemas\";\nimport { AuPayCalculatorId } from \"@taxkit/rules-au-pay/schemas\";\nimport { Effect, ErrorReporter, Match, Schema } from \"effect\";\nimport {\n  HttpServerError,\n  HttpServerRequest,\n  HttpServerResponse,\n} from \"effect/http\";\n\nimport { WebsiteServerFunctionBase } from \"./lib/config\";\nimport {\n  takeHomeRequestFromForm,\n  annualTaxRequestFromForm,\n  AnnualTaxForm,\n  TakeHomeForm,\n  WebsiteInputError,\n} from \"./lib/form.boundary\";\nimport type { WebsiteCalculatorForm } from \"./lib/form.boundary\";\nimport { WebsiteSettingsFunctionPath } from \"./lib/loaders\";\nimport { appRuntime } from \"./lib/runtime.server\";\nimport { WebsiteSubmission, WebsiteSubmissionTransport } from \"./lib/schemas\";\nimport type { WebsiteServerRenderContext } from \"./lib/schemas\";\nimport { WebsiteServerApplication } from \"./lib/service.server\";\n\nconst render = createStartHandler<{\n  server: { requestContext: WebsiteServerRenderContext };\n}>(defaultStreamHandler);\n\nexport default {\n  fetch: (request: Request) =>\n    // A standard HTML form remains usable without JavaScript. Its checked\n    // request reaches the same named RPC client through the private binding.\n    // Only plain, Schema-encoded form/report data reaches TanStack rendering.\n    appRuntime.runPromise(\n      Effect.gen(function* websiteRequest() {\n        const url = new URL(request.url);\n        const calculatorId = Match.value(url.pathname).pipe(\n          Match.when(\"/calculators/au.income-tax.annual\", () =>\n            AuAnnualTaxCalculatorId.make(\"au.income-tax.annual\")\n          ),\n          Match.when(\"/calculators/au.pay.withholdings\", () =>\n            AuPayCalculatorId.make(\"au.pay.withholdings\")\n          ),\n          Match.when(\"/\", () => AuPayCalculatorId.make(\"au.pay.take-home\")),\n          Match.orElse(() => null)\n        );\n        if (url.pathname.startsWith(`${WebsiteServerFunctionBase}/`)) {\n          if (url.pathname !== WebsiteSettingsFunctionPath) {\n            return HttpServerResponse.empty({ status: 404 });\n          }\n          // The only native server function reads settings and takes no data or\n          // client Context. Reject representation input before the framework's\n          // JSON/FormData parser can reflect it in an unexpected error.\n          if (request.method !== \"GET\") {\n            return HttpServerResponse.empty({\n              headers: { allow: \"GET\" },\n              status: 405,\n            });\n          }\n          if (url.search !== \"\") {\n            return HttpServerResponse.empty({ status: 400 });\n          }\n        }\n        if (request.method === \"POST\" && calculatorId === null) {\n          return HttpServerResponse.empty({ status: 404 });\n        }\n        return yield* request.method !== \"POST\" || calculatorId === null\n          ? Effect.promise(() =>\n              Promise.resolve(render(request, { context: {} }))\n            ).pipe(Effect.map(HttpServerResponse.fromWeb))\n          : withCalculatorRequestBodyLimit(\n              Effect.gen(function* () {\n                const incoming = yield* HttpServerRequest.HttpServerRequest;\n                const bounded = yield* HttpServerRequest.toWeb(incoming, {\n                  signal: request.signal,\n                });\n                const data = yield* Effect.tryPromise({\n                  catch: () =>\n                    new WebsiteInputError({\n                      message: \"Enter a valid pay amount and pay period.\",\n                    }),\n                  try: () => bounded.formData(),\n                });\n                const decodedForm: Effect.Effect<\n                  WebsiteCalculatorForm,\n                  Schema.SchemaError\n                > =\n                  calculatorId === \"au.income-tax.annual\"\n                    ? Schema.decodeUnknownEffect(AnnualTaxForm)({\n                        taxableDollars: data.get(\"taxableDollars\"),\n                      })\n                    : Schema.decodeUnknownEffect(TakeHomeForm)({\n                        grossDollars: data.get(\"grossDollars\"),\n                        period: data.get(\"period\"),\n                        taxFreeThresholdClaimed:\n                          data.get(\"taxFreeThresholdClaimed\") === \"on\",\n                      });\n                const form = yield* decodedForm.pipe(\n                  Effect.mapError(\n                    () =>\n                      new WebsiteInputError({\n                        message: \"Enter a valid pay amount and pay period.\",\n                      })\n                  )\n                );\n                const result = yield* (\n                  Schema.is(AnnualTaxForm)(form)\n                    ? annualTaxRequestFromForm(form)\n                    : takeHomeRequestFromForm(\n                        form,\n                        AuPayCalculatorId.make(\n                          calculatorId === \"au.pay.withholdings\"\n                            ? \"au.pay.withholdings\"\n                            : \"au.pay.take-home\"\n                        )\n                      )\n                ).pipe(\n                  Effect.fromResult,\n                  Effect.flatMap((input) =>\n                    WebsiteServerApplication.pipe(\n                      Effect.flatMap((application) =>\n                        application.calculate(input)\n                      )\n                    )\n                  ),\n                  Effect.result\n                );\n                const submission = yield* Schema.encodeEffect(\n                  WebsiteSubmissionTransport\n                )(WebsiteSubmission.make({ calculatorId, form, result })).pipe(\n                  Effect.orDie\n                );\n                const headers = new Headers(request.headers);\n                headers.delete(\"content-length\");\n                headers.delete(\"content-type\");\n                const response = yield* Effect.promise(() =>\n                  Promise.resolve(\n                    render(\n                      new Request(request.url, {\n                        headers,\n                        method: \"GET\",\n                        signal: request.signal,\n                      }),\n                      { context: { submission } }\n                    )\n                  )\n                );\n                return HttpServerResponse.fromWeb(response);\n              }),\n              CalculatorRequestBodyPolicy.make({ responseFormat: \"html\" })\n            ).pipe(\n              Effect.catchTag(\"WebsiteInputError\", () =>\n                Effect.succeed(HttpServerResponse.empty({ status: 400 }))\n              )\n            );\n      }).pipe(\n        // Native HTTP failure matching preserves aborts and safe empty errors.\n        // The installed host reporter discards arbitrary Causes before logging.\n        Effect.catchCause((cause) =>\n          HttpServerError.causeResponse(cause).pipe(\n            Effect.flatMap(([response, reportable]) =>\n              ErrorReporter.report(reportable).pipe(Effect.as(response))\n            )\n          )\n        ),\n        Effect.provideService(\n          HttpServerRequest.HttpServerRequest,\n          HttpServerRequest.fromWeb(request)\n        ),\n        Effect.scoped,\n        Effect.map(HttpServerResponse.toWeb)\n      ),\n      { signal: request.signal }\n    ),\n};\nimport \"@tanstack/react-start/server-only\";\nimport type { fromCloudflareFetcher } from \"alchemy/Cloudflare/Bridge\";\nimport { Config, Effect, Predicate, Schema } from \"effect\";\n\nimport { TaxKitWebConfigError } from \"./config\";\nimport { WebsiteHostOrigins } from \"./schemas\";\n\n// This is the native SDK capability boundary. Preserve the original Fetcher\n// object (and method receiver); a Struct would copy its methods off the binding.\nconst PrivateApiBinding: Schema.Codec<\n  Parameters<typeof fromCloudflareFetcher>[0]\n> = Schema.declare<Parameters<typeof fromCloudflareFetcher>[0]>(\n  (value): value is Parameters<typeof fromCloudflareFetcher>[0] =>\n    Predicate.isObject(value) &&\n    Predicate.hasProperty(value, \"fetch\") &&\n    Predicate.isFunction(value.fetch) &&\n    Predicate.hasProperty(value, \"connect\") &&\n    Predicate.isFunction(value.connect)\n);\nexport const TaxKitWebServerConfig = (\n  rawBinding: unknown\n): Effect.Effect<\n  typeof WebsiteHostOrigins.Type & {\n    readonly binding: typeof PrivateApiBinding.Type;\n  },\n  TaxKitWebConfigError\n> =>\n  Effect.all({\n    apiOrigin: Config.schema(\n      WebsiteHostOrigins.fields.apiOrigin,\n      \"API_PUBLIC_ORIGIN\"\n    ),\n    binding: Schema.decodeUnknownEffect(PrivateApiBinding)(rawBinding),\n    websiteOrigin: Config.schema(\n      WebsiteHostOrigins.fields.websiteOrigin,\n      \"WEBSITE_PUBLIC_ORIGIN\"\n    ),\n  }).pipe(\n    Effect.mapError(\n      () =>\n        new TaxKitWebConfigError({\n          message: \"TaxKit web settings are missing or invalid.\",\n          operation: \"settings\",\n          runtime: \"server\",\n        })\n    )\n  );\npackages/infrastructure/src/apps-secrets.boundary.ts\npackages/infrastructure/src/apps-stack.test.ts\npackages/infrastructure/src/stack.ts\npackages/infrastructure/src/cloudflare/website.test.ts\npackages/infrastructure/src/cloudflare/website.ts\npackages/infrastructure/src/apps-stack.ts\npackages/infrastructure/src/stage.ts\npackages/infrastructure/tsconfig.json\npackages/infrastructure/package.json\npackages/infrastructure/README.md\nimport { ByteSize, Effect, Match, Option, Schema, Stream } from \"effect\";\nimport { HttpClient, HttpClientError, HttpClientResponse } from \"effect/http\";\nimport type { RpcClientError } from \"effect/rpc\";\n\nimport {\n  CalculatorRpcInvalidResponse,\n  CalculatorRpcUnavailable,\n  CalculatorRpcRequestTooLarge,\n  CalculatorRpcRateLimited,\n  CalculatorRpcRequestTimedOut,\n  CalculatorRpcResponseTooLarge,\n} from \"./errors.js\";\nimport { CalculatorRpcResponseLimit } from \"./schemas.js\";\n\n// Native RPC retains the HTTP reason as an unknown cause. Read only the safe\n// status/size projection once; never expose its request, headers or body.\nconst RejectedHttpStatus = Schema.TaggedStruct(\"StatusCodeError\", {\n  response: Schema.Struct({ status: Schema.Literals([408, 413, 429]) }),\n});\nconst OversizedHttpReply = Schema.TaggedStruct(\"DecodeError\", {\n  cause: CalculatorRpcResponseTooLarge,\n});\n\nexport const calculatorRpcTransportFailure = (\n  error: RpcClientError.RpcClientError\n) =>\n  Match.value(error.reason).pipe(\n    Match.tag(\"RpcClientDefect\", () => new CalculatorRpcInvalidResponse()),\n    Match.tag(\"HttpError\", (reason) =>\n      Schema.decodeUnknownOption(\n        Schema.Union([RejectedHttpStatus, OversizedHttpReply])\n      )(reason.cause).pipe(\n        Option.match({\n          onNone: () =>\n            Match.value(reason.kind).pipe(\n              Match.whenOr(\n                \"DecodeError\",\n                \"EmptyBodyError\",\n                () => new CalculatorRpcInvalidResponse()\n              ),\n              Match.orElse(() => new CalculatorRpcUnavailable())\n            ),\n          onSome: (rejection) =>\n            Match.value(rejection).pipe(\n              Match.tag(\n                \"DecodeError\",\n                () => new CalculatorRpcResponseTooLarge()\n              ),\n              Match.tag(\"StatusCodeError\", ({ response }) =>\n                Match.value(response.status).pipe(\n                  Match.when(408, () => new CalculatorRpcRequestTimedOut()),\n                  Match.when(413, () => new CalculatorRpcRequestTooLarge()),\n                  Match.when(429, () => new CalculatorRpcRateLimited()),\n                  Match.exhaustive\n                )\n              ),\n              Match.exhaustive\n            ),\n        })\n      )\n    ),\n    Match.orElse(() => new CalculatorRpcUnavailable())\n  );\n\n// One concrete private HTTP adapter for all closed native operations. Keep\n// the native Protocol/parser/exit Schemas; count bytes before materialisation.\nexport const boundedCalculatorRpcHttpClient = (client: HttpClient.HttpClient) =>\n  client.pipe(\n    HttpClient.withScope,\n    HttpClient.filterStatusOk,\n    HttpClient.transformResponse(\n      Effect.flatMap((response) =>\n        response.stream.pipe(\n          Stream.mapAccumEffect(\n            () => ByteSize.bytes(0),\n            (total, chunk) => {\n              const next = ByteSize.sum(\n                total,\n                ByteSize.bytes(chunk.byteLength)\n              );\n              return ByteSize.isGreaterThan(next, CalculatorRpcResponseLimit)\n                ? Effect.fail(\n                    new HttpClientError.HttpClientError({\n                      reason: new HttpClientError.DecodeError({\n                        cause: new CalculatorRpcResponseTooLarge(),\n                        request: response.request,\n                        response,\n                      }),\n                    })\n                  )\n                : Effect.succeed([next, [chunk]] as const);\n            }\n          ),\n          Stream.mkUint8Array,\n          // This native Web reader ignores MaxBodySize. After the bounded read,\n          // reuse its Response adapter. The byte copy owns an ArrayBuffer body.\n          Effect.map((bytes) =>\n            HttpClientResponse.fromWeb(\n              response.request,\n              new Response(new Uint8Array(bytes), {\n                headers: response.headers,\n              })\n            )\n          )\n        )\n      )\n    ),\n    // Close the actual HTTP request after the bounded body read, or on status\n    // rejection/interruption, before native RPC parses the retained bytes.\n    HttpClient.transformResponse(Effect.scoped)\n  );\n    error: CalculatorApiMetadataErrorEnvelopes,\n    params: CalculatorParams,\n    query: HelpQuery,\n    success: CalculatorCatalogItem,\n  }\n).annotate(OpenApi.Description, \"Return one public calculator catalog entry.\");\n\nconst GetCalculatorSchemaEndpoint = HttpApiEndpoint.get(\n  \"getCalculatorSchema\",\n  \"/calculators/:calculatorId/schema\",\n  {\n    error: CalculatorApiMetadataErrorEnvelopes,\n    params: CalculatorParams,\n    query: HelpQuery,\n    success: CalculatorSchemaResponse,\n  }\n).annotate(\n  OpenApi.Description,\n  \"Return fact, rule and report schema metadata for one calculator.\"\n);\n\nconst GetCalculatorGraphEndpoint = HttpApiEndpoint.get(\n  \"getCalculatorGraph\",\n  \"/calculators/:calculatorId/graph\",\n  {\n    error: CalculatorApiMetadataErrorEnvelopes,\n    params: CalculatorParams,\n    query: MetadataQuery,\n    success: CalculatorGraphResponse,\n  }\n).annotate(\n  OpenApi.Description,\n  \"Return graph edges and canonical graph validation diagnostics for one calculator.\"\n);\n\nconst CalculateEndpoint = HttpApiEndpoint.post(\n  \"calculate\",\n  \"/calculators/:calculatorId/calculate\",\n  {\n    error: CalculatorApiErrorEnvelopes,\n    params: CalculatorParams,\n    payload: CalculatorRunRequest,\n    query: CalculationQuery,\n    success: CalculatorRunResponse,\n  }\n).annotate(\n  OpenApi.Description,\n  \"Run one public calculator using canonical scenario decoding and rule-pack layers.\"\n);\n\nconst ListFactsEndpoint = HttpApiEndpoint.get(\"listFacts\", \"/facts\", {\n  error: CalculatorApiTimeoutEnvelope,\n  query: DescriptorFilterQuery,\n  success: FactsResponse,\n}).annotate(\n  OpenApi.Description,\n  \"List canonical fact descriptors, optionally filtered by calculator context.\"\n);\n\nconst ListRulesEndpoint = HttpApiEndpoint.get(\"listRules\", \"/rules\", {\n  error: CalculatorApiTimeoutEnvelope,\n  query: DescriptorFilterQuery,\n  success: RulesResponse,\n}).annotate(\n  OpenApi.Description,\n  \"List canonical rule descriptors, optionally filtered by calculator context.\"\n);\n\nexport class CalculatorApiGroup extends HttpApiGroup.make(\"calculatorApi\")\n  .add(GetJurisdictionsEndpoint)\n  .add(GetTaxYearsEndpoint)\n  .add(ListCalculatorsEndpoint)\n  .add(GetCalculatorEndpoint)\n  .add(GetCalculatorSchemaEndpoint)\n  .add(GetCalculatorGraphEndpoint)\n  .add(CalculateEndpoint)\n  .add(ListFactsEndpoint)\n  .add(ListRulesEndpoint)\n  .prefix(\"/api/v1\")\n  .annotate(OpenApi.Title, \"Calculator API\") {}\nimport { PublicCalculatorService } from \"@taxkit/calculators\";\nimport type { CalculatorMetadataError } from \"@taxkit/calculators\";\nimport { Effect, Match } from \"effect\";\nimport { HttpApiBuilder } from \"effect/http-api\";\n\nimport { TaxKitApi } from \"../api.js\";\nimport { CalculatorApiErrorEnvelopeData } from \"../groups/calculators.js\";\n\nconst calculatorApiMetadataFailure = (error: CalculatorMetadataError) =>\n  Match.value(error).pipe(\n    Match.tag(\n      \"CalculatorOperationTimedOut\",\n      (failure) => new CalculatorApiErrorEnvelopeData({ error: failure })\n    ),\n    Match.orElse(\n      (failure) => new CalculatorApiErrorEnvelopeData({ error: failure })\n    )\n  );\n\nexport const CalculatorApiHandlerLive = HttpApiBuilder.group(\n  TaxKitApi,\n  \"calculatorApi\",\n  (handlers) =>\n    Effect.succeed(\n      handlers\n        .handle(\"getJurisdictions\", () =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listJurisdictions();\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n        .handle(\"getTaxYears\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listTaxYears(query);\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n        .handle(\"listCalculators\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listCalculators(query);\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n        .handle(\"getCalculator\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculator({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(Effect.mapError(calculatorApiMetadataFailure))\n        )\n        .handle(\"getCalculatorSchema\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculatorSchema({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(Effect.mapError(calculatorApiMetadataFailure))\n        )\n        .handle(\"getCalculatorGraph\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculatorGraph({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(Effect.mapError(calculatorApiMetadataFailure))\n        )\n        .handle(\"calculate\", ({ params, payload, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.calculate({\n              calculatorId: params.calculatorId,\n              payload,\n              ...query,\n            });\n          }).pipe(\n            Effect.mapError((error) =>\n              Match.value(error).pipe(\n                Match.tag(\n                  \"CalculatorCapacityExceeded\",\n                  (failure) =>\n                    new CalculatorApiErrorEnvelopeData({ error: failure })\n                ),\n                Match.tag(\n                  \"CalculatorOperationTimedOut\",\n                  (failure) =>\n                    new CalculatorApiErrorEnvelopeData({ error: failure })\n                ),\n                Match.orElse(\n                  (failure) =>\n                    new CalculatorApiErrorEnvelopeData({ error: failure })\n                )\n              )\n            )\n          )\n        )\n        .handle(\"listFacts\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listFacts(query);\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n        .handle(\"listRules\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listRules(query);\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n    )\n);\n","exit_code":0,"duration":{"secs":0,"nanos":5334},"formatted_output":"import { Worker, RateLimit, RateLimitBinding } from 'alchemy/Cloudflare/Workers';\nimport { Effect, Schema } from 'effect';\nimport { HttpServerRequest, HttpServerResponse } from 'effect/http';\nconst init = Effect.gen(function* () {\n const limiter = yield* RateLimit('RATE', {namespaceId:10075,simple:{limit:60,period:60}});\n const calculatorRequest = (request: Request, key: string) => Effect.gen(function* () {\n  yield* Effect.addFinalizer(() => Effect.logInfo('rate-bridge-preparation: released'));\n  const body = yield* Effect.promise(() => request.text());\n  const result = yield* limiter.limit({key}).pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({success:Schema.Boolean}))));\n  if(new URL(request.url).pathname === '/signal') {\n   yield* Effect.sleep('1 second');\n   yield* Effect.logInfo(request.signal.aborted ? 'rate-bridge-preparation: signal aborted' : 'rate-bridge-preparation: signal live');\n  }\n  return new Response(result.success ? body : 'Rate limit reached',{status:result.success?200:429,headers:{'content-type':'application/json'}});\n });\n return {\n  calculatorRequest,\n  fetch: Effect.gen(function* () {\n   const request = yield* HttpServerRequest.HttpServerRequest;\n   const native = yield* HttpServerRequest.toWeb(request);\n   return HttpServerResponse.fromWeb(yield* calculatorRequest(native,'fixture-A'));\n  }),\n };\n}).pipe(Effect.provide(RateLimitBinding));\nclass RateBridgePreparation extends Worker<RateBridgePreparation>()('TaxKitRateBridgePreparation') {}\nexport default RateBridgePreparation.make({main:import.meta.url,compatibility:{date:'2026-10-04',flags:['nodejs_compat']}},init);\nimport \"@tanstack/react-start/server-only\";\nimport { getRequest } from \"@tanstack/react-start/server\";\nimport { Effect, ErrorReporter, Schema } from \"effect\";\nimport { HttpServerError, HttpServerResponse } from \"effect/http\";\n\nimport { appRuntime } from \"./runtime.server\";\nimport { WebsiteCatalogueTransport, WebsiteSettingsTransport } from \"./schemas\";\nimport { WebsiteServerApplication } from \"./service.server\";\n\nexport const loadWebsiteSettingsServer = () =>\n  appRuntime.runPromise(\n    WebsiteServerApplication.pipe(\n      Effect.flatMap((application) =>\n        Effect.gen(function* () {\n          const settings = yield* application.settings.pipe(\n            Effect.result,\n            Effect.flatMap(Schema.encodeEffect(WebsiteSettingsTransport))\n          );\n          const catalogue = yield* application.catalogue.pipe(\n            Effect.result,\n            Effect.flatMap(Schema.encodeEffect(WebsiteCatalogueTransport))\n          );\n          return { catalogue, settings };\n        })\n      ),\n      Effect.orDie,\n      // Expected settings errors remain checked values. An unexpected failure\n      // reaches the host reporter and native empty response before TanStack can\n      // log or serialise an arbitrary Cause as a server-function error.\n      Effect.catchCause((cause) =>\n        HttpServerError.causeResponse(cause).pipe(\n          Effect.flatMap(([response, reportable]) =>\n            ErrorReporter.report(reportable).pipe(\n              Effect.as(HttpServerResponse.toWeb(response))\n            )\n          )\n        )\n      )\n    ),\n    { signal: getRequest().signal }\n  );\nimport {\n  createStartHandler,\n  defaultStreamHandler,\n} from \"@tanstack/react-start/server\";\nimport {\n  CalculatorRequestBodyPolicy,\n  withCalculatorRequestBodyLimit,\n} from \"@taxkit/api-http/request-boundary\";\nimport { AuAnnualTaxCalculatorId } from \"@taxkit/rules-au-income-tax/schemas\";\nimport { AuPayCalculatorId } from \"@taxkit/rules-au-pay/schemas\";\nimport { Effect, ErrorReporter, Match, Schema } from \"effect\";\nimport {\n  HttpServerError,\n  HttpServerRequest,\n  HttpServerResponse,\n} from \"effect/http\";\n\nimport { WebsiteServerFunctionBase } from \"./lib/config\";\nimport {\n  takeHomeRequestFromForm,\n  annualTaxRequestFromForm,\n  AnnualTaxForm,\n  TakeHomeForm,\n  WebsiteInputError,\n} from \"./lib/form.boundary\";\nimport type { WebsiteCalculatorForm } from \"./lib/form.boundary\";\nimport { WebsiteSettingsFunctionPath } from \"./lib/loaders\";\nimport { appRuntime } from \"./lib/runtime.server\";\nimport { WebsiteSubmission, WebsiteSubmissionTransport } from \"./lib/schemas\";\nimport type { WebsiteServerRenderContext } from \"./lib/schemas\";\nimport { WebsiteServerApplication } from \"./lib/service.server\";\n\nconst render = createStartHandler<{\n  server: { requestContext: WebsiteServerRenderContext };\n}>(defaultStreamHandler);\n\nexport default {\n  fetch: (request: Request) =>\n    // A standard HTML form remains usable without JavaScript. Its checked\n    // request reaches the same named RPC client through the private binding.\n    // Only plain, Schema-encoded form/report data reaches TanStack rendering.\n    appRuntime.runPromise(\n      Effect.gen(function* websiteRequest() {\n        const url = new URL(request.url);\n        const calculatorId = Match.value(url.pathname).pipe(\n          Match.when(\"/calculators/au.income-tax.annual\", () =>\n            AuAnnualTaxCalculatorId.make(\"au.income-tax.annual\")\n          ),\n          Match.when(\"/calculators/au.pay.withholdings\", () =>\n            AuPayCalculatorId.make(\"au.pay.withholdings\")\n          ),\n          Match.when(\"/\", () => AuPayCalculatorId.make(\"au.pay.take-home\")),\n          Match.orElse(() => null)\n        );\n        if (url.pathname.startsWith(`${WebsiteServerFunctionBase}/`)) {\n          if (url.pathname !== WebsiteSettingsFunctionPath) {\n            return HttpServerResponse.empty({ status: 404 });\n          }\n          // The only native server function reads settings and takes no data or\n          // client Context. Reject representation input before the framework's\n          // JSON/FormData parser can reflect it in an unexpected error.\n          if (request.method !== \"GET\") {\n            return HttpServerResponse.empty({\n              headers: { allow: \"GET\" },\n              status: 405,\n            });\n          }\n          if (url.search !== \"\") {\n            return HttpServerResponse.empty({ status: 400 });\n          }\n        }\n        if (request.method === \"POST\" && calculatorId === null) {\n          return HttpServerResponse.empty({ status: 404 });\n        }\n        return yield* request.method !== \"POST\" || calculatorId === null\n          ? Effect.promise(() =>\n              Promise.resolve(render(request, { context: {} }))\n            ).pipe(Effect.map(HttpServerResponse.fromWeb))\n          : withCalculatorRequestBodyLimit(\n              Effect.gen(function* () {\n                const incoming = yield* HttpServerRequest.HttpServerRequest;\n                const bounded = yield* HttpServerRequest.toWeb(incoming, {\n                  signal: request.signal,\n                });\n                const data = yield* Effect.tryPromise({\n                  catch: () =>\n                    new WebsiteInputError({\n                      message: \"Enter a valid pay amount and pay period.\",\n                    }),\n                  try: () => bounded.formData(),\n                });\n                const decodedForm: Effect.Effect<\n                  WebsiteCalculatorForm,\n                  Schema.SchemaError\n                > =\n                  calculatorId === \"au.income-tax.annual\"\n                    ? Schema.decodeUnknownEffect(AnnualTaxForm)({\n                        taxableDollars: data.get(\"taxableDollars\"),\n                      })\n                    : Schema.decodeUnknownEffect(TakeHomeForm)({\n                        grossDollars: data.get(\"grossDollars\"),\n                        period: data.get(\"period\"),\n                        taxFreeThresholdClaimed:\n                          data.get(\"taxFreeThresholdClaimed\") === \"on\",\n                      });\n                const form = yield* decodedForm.pipe(\n                  Effect.mapError(\n                    () =>\n                      new WebsiteInputError({\n                        message: \"Enter a valid pay amount and pay period.\",\n                      })\n                  )\n                );\n                const result = yield* (\n                  Schema.is(AnnualTaxForm)(form)\n                    ? annualTaxRequestFromForm(form)\n                    : takeHomeRequestFromForm(\n                        form,\n                        AuPayCalculatorId.make(\n                          calculatorId === \"au.pay.withholdings\"\n                            ? \"au.pay.withholdings\"\n                            : \"au.pay.take-home\"\n                        )\n                      )\n                ).pipe(\n                  Effect.fromResult,\n                  Effect.flatMap((input) =>\n                    WebsiteServerApplication.pipe(\n                      Effect.flatMap((application) =>\n                        application.calculate(input)\n                      )\n                    )\n                  ),\n                  Effect.result\n                );\n                const submission = yield* Schema.encodeEffect(\n                  WebsiteSubmissionTransport\n                )(WebsiteSubmission.make({ calculatorId, form, result })).pipe(\n                  Effect.orDie\n                );\n                const headers = new Headers(request.headers);\n                headers.delete(\"content-length\");\n                headers.delete(\"content-type\");\n                const response = yield* Effect.promise(() =>\n                  Promise.resolve(\n                    render(\n                      new Request(request.url, {\n                        headers,\n                        method: \"GET\",\n                        signal: request.signal,\n                      }),\n                      { context: { submission } }\n                    )\n                  )\n                );\n                return HttpServerResponse.fromWeb(response);\n              }),\n              CalculatorRequestBodyPolicy.make({ responseFormat: \"html\" })\n            ).pipe(\n              Effect.catchTag(\"WebsiteInputError\", () =>\n                Effect.succeed(HttpServerResponse.empty({ status: 400 }))\n              )\n            );\n      }).pipe(\n        // Native HTTP failure matching preserves aborts and safe empty errors.\n        // The installed host reporter discards arbitrary Causes before logging.\n        Effect.catchCause((cause) =>\n          HttpServerError.causeResponse(cause).pipe(\n            Effect.flatMap(([response, reportable]) =>\n              ErrorReporter.report(reportable).pipe(Effect.as(response))\n            )\n          )\n        ),\n        Effect.provideService(\n          HttpServerRequest.HttpServerRequest,\n          HttpServerRequest.fromWeb(request)\n        ),\n        Effect.scoped,\n        Effect.map(HttpServerResponse.toWeb)\n      ),\n      { signal: request.signal }\n    ),\n};\nimport \"@tanstack/react-start/server-only\";\nimport type { fromCloudflareFetcher } from \"alchemy/Cloudflare/Bridge\";\nimport { Config, Effect, Predicate, Schema } from \"effect\";\n\nimport { TaxKitWebConfigError } from \"./config\";\nimport { WebsiteHostOrigins } from \"./schemas\";\n\n// This is the native SDK capability boundary. Preserve the original Fetcher\n// object (and method receiver); a Struct would copy its methods off the binding.\nconst PrivateApiBinding: Schema.Codec<\n  Parameters<typeof fromCloudflareFetcher>[0]\n> = Schema.declare<Parameters<typeof fromCloudflareFetcher>[0]>(\n  (value): value is Parameters<typeof fromCloudflareFetcher>[0] =>\n    Predicate.isObject(value) &&\n    Predicate.hasProperty(value, \"fetch\") &&\n    Predicate.isFunction(value.fetch) &&\n    Predicate.hasProperty(value, \"connect\") &&\n    Predicate.isFunction(value.connect)\n);\nexport const TaxKitWebServerConfig = (\n  rawBinding: unknown\n): Effect.Effect<\n  typeof WebsiteHostOrigins.Type & {\n    readonly binding: typeof PrivateApiBinding.Type;\n  },\n  TaxKitWebConfigError\n> =>\n  Effect.all({\n    apiOrigin: Config.schema(\n      WebsiteHostOrigins.fields.apiOrigin,\n      \"API_PUBLIC_ORIGIN\"\n    ),\n    binding: Schema.decodeUnknownEffect(PrivateApiBinding)(rawBinding),\n    websiteOrigin: Config.schema(\n      WebsiteHostOrigins.fields.websiteOrigin,\n      \"WEBSITE_PUBLIC_ORIGIN\"\n    ),\n  }).pipe(\n    Effect.mapError(\n      () =>\n        new TaxKitWebConfigError({\n          message: \"TaxKit web settings are missing or invalid.\",\n          operation: \"settings\",\n          runtime: \"server\",\n        })\n    )\n  );\npackages/infrastructure/src/apps-secrets.boundary.ts\npackages/infrastructure/src/apps-stack.test.ts\npackages/infrastructure/src/stack.ts\npackages/infrastructure/src/cloudflare/website.test.ts\npackages/infrastructure/src/cloudflare/website.ts\npackages/infrastructure/src/apps-stack.ts\npackages/infrastructure/src/stage.ts\npackages/infrastructure/tsconfig.json\npackages/infrastructure/package.json\npackages/infrastructure/README.md\nimport { ByteSize, Effect, Match, Option, Schema, Stream } from \"effect\";\nimport { HttpClient, HttpClientError, HttpClientResponse } from \"effect/http\";\nimport type { RpcClientError } from \"effect/rpc\";\n\nimport {\n  CalculatorRpcInvalidResponse,\n  CalculatorRpcUnavailable,\n  CalculatorRpcRequestTooLarge,\n  CalculatorRpcRateLimited,\n  CalculatorRpcRequestTimedOut,\n  CalculatorRpcResponseTooLarge,\n} from \"./errors.js\";\nimport { CalculatorRpcResponseLimit } from \"./schemas.js\";\n\n// Native RPC retains the HTTP reason as an unknown cause. Read only the safe\n// status/size projection once; never expose its request, headers or body.\nconst RejectedHttpStatus = Schema.TaggedStruct(\"StatusCodeError\", {\n  response: Schema.Struct({ status: Schema.Literals([408, 413, 429]) }),\n});\nconst OversizedHttpReply = Schema.TaggedStruct(\"DecodeError\", {\n  cause: CalculatorRpcResponseTooLarge,\n});\n\nexport const calculatorRpcTransportFailure = (\n  error: RpcClientError.RpcClientError\n) =>\n  Match.value(error.reason).pipe(\n    Match.tag(\"RpcClientDefect\", () => new CalculatorRpcInvalidResponse()),\n    Match.tag(\"HttpError\", (reason) =>\n      Schema.decodeUnknownOption(\n        Schema.Union([RejectedHttpStatus, OversizedHttpReply])\n      )(reason.cause).pipe(\n        Option.match({\n          onNone: () =>\n            Match.value(reason.kind).pipe(\n              Match.whenOr(\n                \"DecodeError\",\n                \"EmptyBodyError\",\n                () => new CalculatorRpcInvalidResponse()\n              ),\n              Match.orElse(() => new CalculatorRpcUnavailable())\n            ),\n          onSome: (rejection) =>\n            Match.value(rejection).pipe(\n              Match.tag(\n                \"DecodeError\",\n                () => new CalculatorRpcResponseTooLarge()\n              ),\n              Match.tag(\"StatusCodeError\", ({ response }) =>\n                Match.value(response.status).pipe(\n                  Match.when(408, () => new CalculatorRpcRequestTimedOut()),\n                  Match.when(413, () => new CalculatorRpcRequestTooLarge()),\n                  Match.when(429, () => new CalculatorRpcRateLimited()),\n                  Match.exhaustive\n                )\n              ),\n              Match.exhaustive\n            ),\n        })\n      )\n    ),\n    Match.orElse(() => new CalculatorRpcUnavailable())\n  );\n\n// One concrete private HTTP adapter for all closed native operations. Keep\n// the native Protocol/parser/exit Schemas; count bytes before materialisation.\nexport const boundedCalculatorRpcHttpClient = (client: HttpClient.HttpClient) =>\n  client.pipe(\n    HttpClient.withScope,\n    HttpClient.filterStatusOk,\n    HttpClient.transformResponse(\n      Effect.flatMap((response) =>\n        response.stream.pipe(\n          Stream.mapAccumEffect(\n            () => ByteSize.bytes(0),\n            (total, chunk) => {\n              const next = ByteSize.sum(\n                total,\n                ByteSize.bytes(chunk.byteLength)\n              );\n              return ByteSize.isGreaterThan(next, CalculatorRpcResponseLimit)\n                ? Effect.fail(\n                    new HttpClientError.HttpClientError({\n                      reason: new HttpClientError.DecodeError({\n                        cause: new CalculatorRpcResponseTooLarge(),\n                        request: response.request,\n                        response,\n                      }),\n                    })\n                  )\n                : Effect.succeed([next, [chunk]] as const);\n            }\n          ),\n          Stream.mkUint8Array,\n          // This native Web reader ignores MaxBodySize. After the bounded read,\n          // reuse its Response adapter. The byte copy owns an ArrayBuffer body.\n          Effect.map((bytes) =>\n            HttpClientResponse.fromWeb(\n              response.request,\n              new Response(new Uint8Array(bytes), {\n                headers: response.headers,\n              })\n            )\n          )\n        )\n      )\n    ),\n    // Close the actual HTTP request after the bounded body read, or on status\n    // rejection/interruption, before native RPC parses the retained bytes.\n    HttpClient.transformResponse(Effect.scoped)\n  );\n    error: CalculatorApiMetadataErrorEnvelopes,\n    params: CalculatorParams,\n    query: HelpQuery,\n    success: CalculatorCatalogItem,\n  }\n).annotate(OpenApi.Description, \"Return one public calculator catalog entry.\");\n\nconst GetCalculatorSchemaEndpoint = HttpApiEndpoint.get(\n  \"getCalculatorSchema\",\n  \"/calculators/:calculatorId/schema\",\n  {\n    error: CalculatorApiMetadataErrorEnvelopes,\n    params: CalculatorParams,\n    query: HelpQuery,\n    success: CalculatorSchemaResponse,\n  }\n).annotate(\n  OpenApi.Description,\n  \"Return fact, rule and report schema metadata for one calculator.\"\n);\n\nconst GetCalculatorGraphEndpoint = HttpApiEndpoint.get(\n  \"getCalculatorGraph\",\n  \"/calculators/:calculatorId/graph\",\n  {\n    error: CalculatorApiMetadataErrorEnvelopes,\n    params: CalculatorParams,\n    query: MetadataQuery,\n    success: CalculatorGraphResponse,\n  }\n).annotate(\n  OpenApi.Description,\n  \"Return graph edges and canonical graph validation diagnostics for one calculator.\"\n);\n\nconst CalculateEndpoint = HttpApiEndpoint.post(\n  \"calculate\",\n  \"/calculators/:calculatorId/calculate\",\n  {\n    error: CalculatorApiErrorEnvelopes,\n    params: CalculatorParams,\n    payload: CalculatorRunRequest,\n    query: CalculationQuery,\n    success: CalculatorRunResponse,\n  }\n).annotate(\n  OpenApi.Description,\n  \"Run one public calculator using canonical scenario decoding and rule-pack layers.\"\n);\n\nconst ListFactsEndpoint = HttpApiEndpoint.get(\"listFacts\", \"/facts\", {\n  error: CalculatorApiTimeoutEnvelope,\n  query: DescriptorFilterQuery,\n  success: FactsResponse,\n}).annotate(\n  OpenApi.Description,\n  \"List canonical fact descriptors, optionally filtered by calculator context.\"\n);\n\nconst ListRulesEndpoint = HttpApiEndpoint.get(\"listRules\", \"/rules\", {\n  error: CalculatorApiTimeoutEnvelope,\n  query: DescriptorFilterQuery,\n  success: RulesResponse,\n}).annotate(\n  OpenApi.Description,\n  \"List canonical rule descriptors, optionally filtered by calculator context.\"\n);\n\nexport class CalculatorApiGroup extends HttpApiGroup.make(\"calculatorApi\")\n  .add(GetJurisdictionsEndpoint)\n  .add(GetTaxYearsEndpoint)\n  .add(ListCalculatorsEndpoint)\n  .add(GetCalculatorEndpoint)\n  .add(GetCalculatorSchemaEndpoint)\n  .add(GetCalculatorGraphEndpoint)\n  .add(CalculateEndpoint)\n  .add(ListFactsEndpoint)\n  .add(ListRulesEndpoint)\n  .prefix(\"/api/v1\")\n  .annotate(OpenApi.Title, \"Calculator API\") {}\nimport { PublicCalculatorService } from \"@taxkit/calculators\";\nimport type { CalculatorMetadataError } from \"@taxkit/calculators\";\nimport { Effect, Match } from \"effect\";\nimport { HttpApiBuilder } from \"effect/http-api\";\n\nimport { TaxKitApi } from \"../api.js\";\nimport { CalculatorApiErrorEnvelopeData } from \"../groups/calculators.js\";\n\nconst calculatorApiMetadataFailure = (error: CalculatorMetadataError) =>\n  Match.value(error).pipe(\n    Match.tag(\n      \"CalculatorOperationTimedOut\",\n      (failure) => new CalculatorApiErrorEnvelopeData({ error: failure })\n    ),\n    Match.orElse(\n      (failure) => new CalculatorApiErrorEnvelopeData({ error: failure })\n    )\n  );\n\nexport const CalculatorApiHandlerLive = HttpApiBuilder.group(\n  TaxKitApi,\n  \"calculatorApi\",\n  (handlers) =>\n    Effect.succeed(\n      handlers\n        .handle(\"getJurisdictions\", () =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listJurisdictions();\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n        .handle(\"getTaxYears\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listTaxYears(query);\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n        .handle(\"listCalculators\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listCalculators(query);\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n        .handle(\"getCalculator\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculator({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(Effect.mapError(calculatorApiMetadataFailure))\n        )\n        .handle(\"getCalculatorSchema\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculatorSchema({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(Effect.mapError(calculatorApiMetadataFailure))\n        )\n        .handle(\"getCalculatorGraph\", ({ params, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.getCalculatorGraph({\n              calculatorId: params.calculatorId,\n              ...query,\n            });\n          }).pipe(Effect.mapError(calculatorApiMetadataFailure))\n        )\n        .handle(\"calculate\", ({ params, payload, query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.calculate({\n              calculatorId: params.calculatorId,\n              payload,\n              ...query,\n            });\n          }).pipe(\n            Effect.mapError((error) =>\n              Match.value(error).pipe(\n                Match.tag(\n                  \"CalculatorCapacityExceeded\",\n                  (failure) =>\n                    new CalculatorApiErrorEnvelopeData({ error: failure })\n                ),\n                Match.tag(\n                  \"CalculatorOperationTimedOut\",\n                  (failure) =>\n                    new CalculatorApiErrorEnvelopeData({ error: failure })\n                ),\n                Match.orElse(\n                  (failure) =>\n                    new CalculatorApiErrorEnvelopeData({ error: failure })\n                )\n              )\n            )\n          )\n        )\n        .handle(\"listFacts\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listFacts(query);\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n        .handle(\"listRules\", ({ query }) =>\n          Effect.gen(function* () {\n            const service = yield* PublicCalculatorService;\n            return yield* service.listRules(query);\n          }).pipe(\n            Effect.mapError(\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\n            )\n          )\n        )\n    )\n);\n"},"started_at_ms":1791262137376,"completed_at_ms":1791262137376}}
{"timestamp":"2026-10-06T04:48:57.428Z","ordinal":37798,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a10f8b-1c54-77f0-97cf-ec21cef08e92","call_id":"call_KPS7porUGIIFthqzW1PqYlFO","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"ed938f\",\"wall_time_seconds\":0.000005334,\"exit_code\":0,\"original_token_count\":6016,\"output\":\"import { Worker, RateLimit, RateLimitBinding } from 'alchemy/Cloudflare/Workers';\\nimport { Effect, Schema } from 'effect';\\nimport { HttpServerRequest, HttpServerResponse } from 'effect/http';\\nconst init = Effect.gen(function* () {\\n const limiter = yield* RateLimit('RATE', {namespaceId:10075,simple:{limit:60,period:60}});\\n const calculatorRequest = (request: Request, key: string) => Effect.gen(function* () {\\n  yield* Effect.addFinalizer(() => Effect.logInfo('rate-bridge-preparation: released'));\\n  const body = yield* Effect.promise(() => request.text());\\n  const result = yield* limiter.limit({key}).pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.Struct({success:Schema.Boolean}))));\\n  if(new URL(request.url).pathname === '/signal') {\\n   yield* Effect.sleep('1 second');\\n   yield* Effect.logInfo(request.signal.aborted ? 'rate-bridge-preparation: signal aborted' : 'rate-bridge-preparation: signal live');\\n  }\\n  return new Response(result.success ? body : 'Rate limit reached',{status:result.success?200:429,headers:{'content-type':'application/json'}});\\n });\\n return {\\n  calculatorRequest,\\n  fetch: Effect.gen(function* () {\\n   const request = yield* HttpServerRequest.HttpServerRequest;\\n   const native = yield* HttpServerRequest.toWeb(request);\\n   return HttpServerResponse.fromWeb(yield* calculatorRequest(native,'fixture-A'));\\n  }),\\n };\\n}).pipe(Effect.provide(RateLimitBinding));\\nclass RateBridgePreparation extends Worker<RateBridgePreparation>()('TaxKitRateBridgePreparation') {}\\nexport default RateBridgePreparation.make({main:import.meta.url,compatibility:{date:'2026-10-04',flags:['nodejs_compat']}},init);\\nimport \\\"@tanstack/react-start/server-only\\\";\\nimport { getRequest } from \\\"@tanstack/react-start/server\\\";\\nimport { Effect, ErrorReporter, Schema } from \\\"effect\\\";\\nimport { HttpServerError, HttpServerResponse } from \\\"effect/http\\\";\\n\\nimport { appRuntime } from \\\"./runtime.server\\\";\\nimport { WebsiteCatalogueTransport, WebsiteSettingsTransport } from \\\"./schemas\\\";\\nimport { WebsiteServerApplication } from \\\"./service.server\\\";\\n\\nexport const loadWebsiteSettingsServer = () =>\\n  appRuntime.runPromise(\\n    WebsiteServerApplication.pipe(\\n      Effect.flatMap((application) =>\\n        Effect.gen(function* () {\\n          const settings = yield* application.settings.pipe(\\n            Effect.result,\\n            Effect.flatMap(Schema.encodeEffect(WebsiteSettingsTransport))\\n          );\\n          const catalogue = yield* application.catalogue.pipe(\\n            Effect.result,\\n            Effect.flatMap(Schema.encodeEffect(WebsiteCatalogueTransport))\\n          );\\n          return { catalogue, settings };\\n        })\\n      ),\\n      Effect.orDie,\\n      // Expected settings errors remain checked values. An unexpected failure\\n      // reaches the host reporter and native empty response before TanStack can\\n      // log or serialise an arbitrary Cause as a server-function error.\\n      Effect.catchCause((cause) =>\\n        HttpServerError.causeResponse(cause).pipe(\\n          Effect.flatMap(([response, reportable]) =>\\n            ErrorReporter.report(reportable).pipe(\\n              Effect.as(HttpServerResponse.toWeb(response))\\n            )\\n          )\\n        )\\n      )\\n    ),\\n    { signal: getRequest().signal }\\n  );\\nimport {\\n  createStartHandler,\\n  defaultStreamHandler,\\n} from \\\"@tanstack/react-start/server\\\";\\nimport {\\n  CalculatorRequestBodyPolicy,\\n  withCalculatorRequestBodyLimit,\\n} from \\\"@taxkit/api-http/request-boundary\\\";\\nimport { AuAnnualTaxCalculatorId } from \\\"@taxkit/rules-au-income-tax/schemas\\\";\\nimport { AuPayCalculatorId } from \\\"@taxkit/rules-au-pay/schemas\\\";\\nimport { Effect, ErrorReporter, Match, Schema } from \\\"effect\\\";\\nimport {\\n  HttpServerError,\\n  HttpServerRequest,\\n  HttpServerResponse,\\n} from \\\"effect/http\\\";\\n\\nimport { WebsiteServerFunctionBase } from \\\"./lib/config\\\";\\nimport {\\n  takeHomeRequestFromForm,\\n  annualTaxRequestFromForm,\\n  AnnualTaxForm,\\n  TakeHomeForm,\\n  WebsiteInputError,\\n} from \\\"./lib/form.boundary\\\";\\nimport type { WebsiteCalculatorForm } from \\\"./lib/form.boundary\\\";\\nimport { WebsiteSettingsFunctionPath } from \\\"./lib/loaders\\\";\\nimport { appRuntime } from \\\"./lib/runtime.server\\\";\\nimport { WebsiteSubmission, WebsiteSubmissionTransport } from \\\"./lib/schemas\\\";\\nimport type { WebsiteServerRenderContext } from \\\"./lib/schemas\\\";\\nimport { WebsiteServerApplication } from \\\"./lib/service.server\\\";\\n\\nconst render = createStartHandler<{\\n  server: { requestContext: WebsiteServerRenderContext };\\n}>(defaultStreamHandler);\\n\\nexport default {\\n  fetch: (request: Request) =>\\n    // A standard HTML form remains usable without JavaScript. Its checked\\n    // request reaches the same named RPC client through the private binding.\\n    // Only plain, Schema-encoded form/report data reaches TanStack rendering.\\n    appRuntime.runPromise(\\n      Effect.gen(function* websiteRequest() {\\n        const url = new URL(request.url);\\n        const calculatorId = Match.value(url.pathname).pipe(\\n          Match.when(\\\"/calculators/au.income-tax.annual\\\", () =>\\n            AuAnnualTaxCalculatorId.make(\\\"au.income-tax.annual\\\")\\n          ),\\n          Match.when(\\\"/calculators/au.pay.withholdings\\\", () =>\\n            AuPayCalculatorId.make(\\\"au.pay.withholdings\\\")\\n          ),\\n          Match.when(\\\"/\\\", () => AuPayCalculatorId.make(\\\"au.pay.take-home\\\")),\\n          Match.orElse(() => null)\\n        );\\n        if (url.pathname.startsWith(`${WebsiteServerFunctionBase}/`)) {\\n          if (url.pathname !== WebsiteSettingsFunctionPath) {\\n            return HttpServerResponse.empty({ status: 404 });\\n          }\\n          // The only native server function reads settings and takes no data or\\n          // client Context. Reject representation input before the framework's\\n          // JSON/FormData parser can reflect it in an unexpected error.\\n          if (request.method !== \\\"GET\\\") {\\n            return HttpServerResponse.empty({\\n              headers: { allow: \\\"GET\\\" },\\n              status: 405,\\n            });\\n          }\\n          if (url.search !== \\\"\\\") {\\n            return HttpServerResponse.empty({ status: 400 });\\n          }\\n        }\\n        if (request.method === \\\"POST\\\" && calculatorId === null) {\\n          return HttpServerResponse.empty({ status: 404 });\\n        }\\n        return yield* request.method !== \\\"POST\\\" || calculatorId === null\\n          ? Effect.promise(() =>\\n              Promise.resolve(render(request, { context: {} }))\\n            ).pipe(Effect.map(HttpServerResponse.fromWeb))\\n          : withCalculatorRequestBodyLimit(\\n              Effect.gen(function* () {\\n                const incoming = yield* HttpServerRequest.HttpServerRequest;\\n                const bounded = yield* HttpServerRequest.toWeb(incoming, {\\n                  signal: request.signal,\\n                });\\n                const data = yield* Effect.tryPromise({\\n                  catch: () =>\\n                    new WebsiteInputError({\\n                      message: \\\"Enter a valid pay amount and pay period.\\\",\\n                    }),\\n                  try: () => bounded.formData(),\\n                });\\n                const decodedForm: Effect.Effect<\\n                  WebsiteCalculatorForm,\\n                  Schema.SchemaError\\n                > =\\n                  calculatorId === \\\"au.income-tax.annual\\\"\\n                    ? Schema.decodeUnknownEffect(AnnualTaxForm)({\\n                        taxableDollars: data.get(\\\"taxableDollars\\\"),\\n                      })\\n                    : Schema.decodeUnknownEffect(TakeHomeForm)({\\n                        grossDollars: data.get(\\\"grossDollars\\\"),\\n                        period: data.get(\\\"period\\\"),\\n                        taxFreeThresholdClaimed:\\n                          data.get(\\\"taxFreeThresholdClaimed\\\") === \\\"on\\\",\\n                      });\\n                const form = yield* decodedForm.pipe(\\n                  Effect.mapError(\\n                    () =>\\n                      new WebsiteInputError({\\n                        message: \\\"Enter a valid pay amount and pay period.\\\",\\n                      })\\n                  )\\n                );\\n                const result = yield* (\\n                  Schema.is(AnnualTaxForm)(form)\\n                    ? annualTaxRequestFromForm(form)\\n                    : takeHomeRequestFromForm(\\n                        form,\\n                        AuPayCalculatorId.make(\\n                          calculatorId === \\\"au.pay.withholdings\\\"\\n                            ? \\\"au.pay.withholdings\\\"\\n                            : \\\"au.pay.take-home\\\"\\n                        )\\n                      )\\n                ).pipe(\\n                  Effect.fromResult,\\n                  Effect.flatMap((input) =>\\n                    WebsiteServerApplication.pipe(\\n                      Effect.flatMap((application) =>\\n                        application.calculate(input)\\n                      )\\n                    )\\n                  ),\\n                  Effect.result\\n                );\\n                const submission = yield* Schema.encodeEffect(\\n                  WebsiteSubmissionTransport\\n                )(WebsiteSubmission.make({ calculatorId, form, result })).pipe(\\n                  Effect.orDie\\n                );\\n                const headers = new Headers(request.headers);\\n                headers.delete(\\\"content-length\\\");\\n                headers.delete(\\\"content-type\\\");\\n                const response = yield* Effect.promise(() =>\\n                  Promise.resolve(\\n                    render(\\n                      new Request(request.url, {\\n                        headers,\\n                        method: \\\"GET\\\",\\n                        signal: request.signal,\\n                      }),\\n                      { context: { submission } }\\n                    )\\n                  )\\n                );\\n                return HttpServerResponse.fromWeb(response);\\n              }),\\n              CalculatorRequestBodyPolicy.make({ responseFormat: \\\"html\\\" })\\n            ).pipe(\\n              Effect.catchTag(\\\"WebsiteInputError\\\", () =>\\n                Effect.succeed(HttpServerResponse.empty({ status: 400 }))\\n              )\\n            );\\n      }).pipe(\\n        // Native HTTP failure matching preserves aborts and safe empty errors.\\n        // The installed host reporter discards arbitrary Causes before logging.\\n        Effect.catchCause((cause) =>\\n          HttpServerError.causeResponse(cause).pipe(\\n            Effect.flatMap(([response, reportable]) =>\\n              ErrorReporter.report(reportable).pipe(Effect.as(response))\\n            )\\n          )\\n        ),\\n        Effect.provideService(\\n          HttpServerRequest.HttpServerRequest,\\n          HttpServerRequest.fromWeb(request)\\n        ),\\n        Effect.scoped,\\n        Effect.map(HttpServerResponse.toWeb)\\n      ),\\n      { signal: request.signal }\\n    ),\\n};\\nimport \\\"@tanstack/react-start/server-only\\\";\\nimport type { fromCloudflareFetcher } from \\\"alchemy/Cloudflare/Bridge\\\";\\nimport { Config, Effect, Predicate, Schema } from \\\"effect\\\";\\n\\nimport { TaxKitWebConfigError } from \\\"./config\\\";\\nimport { WebsiteHostOrigins } from \\\"./schemas\\\";\\n\\n// This is the native SDK capability boundary. Preserve the original Fetcher\\n// object (and method receiver); a Struct would copy its methods off the binding.\\nconst PrivateApiBinding: Schema.Codec<\\n  Parameters<typeof fromCloudflareFetcher>[0]\\n> = Schema.declare<Parameters<typeof fromCloudflareFetcher>[0]>(\\n  (value): value is Parameters<typeof fromCloudflareFetcher>[0] =>\\n    Predicate.isObject(value) &&\\n    Predicate.hasProperty(value, \\\"fetch\\\") &&\\n    Predicate.isFunction(value.fetch) &&\\n    Predicate.hasProperty(value, \\\"connect\\\") &&\\n    Predicate.isFunction(value.connect)\\n);\\nexport const TaxKitWebServerConfig = (\\n  rawBinding: unknown\\n): Effect.Effect<\\n  typeof WebsiteHostOrigins.Type & {\\n    readonly binding: typeof PrivateApiBinding.Type;\\n  },\\n  TaxKitWebConfigError\\n> =>\\n  Effect.all({\\n    apiOrigin: Config.schema(\\n      WebsiteHostOrigins.fields.apiOrigin,\\n      \\\"API_PUBLIC_ORIGIN\\\"\\n    ),\\n    binding: Schema.decodeUnknownEffect(PrivateApiBinding)(rawBinding),\\n    websiteOrigin: Config.schema(\\n      WebsiteHostOrigins.fields.websiteOrigin,\\n      \\\"WEBSITE_PUBLIC_ORIGIN\\\"\\n    ),\\n  }).pipe(\\n    Effect.mapError(\\n      () =>\\n        new TaxKitWebConfigError({\\n          message: \\\"TaxKit web settings are missing or invalid.\\\",\\n          operation: \\\"settings\\\",\\n          runtime: \\\"server\\\",\\n        })\\n    )\\n  );\\npackages/infrastructure/src/apps-secrets.boundary.ts\\npackages/infrastructure/src/apps-stack.test.ts\\npackages/infrastructure/src/stack.ts\\npackages/infrastructure/src/cloudflare/website.test.ts\\npackages/infrastructure/src/cloudflare/website.ts\\npackages/infrastructure/src/apps-stack.ts\\npackages/infrastructure/src/stage.ts\\npackages/infrastructure/tsconfig.json\\npackages/infrastructure/package.json\\npackages/infrastructure/README.md\\nimport { ByteSize, Effect, Match, Option, Schema, Stream } from \\\"effect\\\";\\nimport { HttpClient, HttpClientError, HttpClientResponse } from \\\"effect/http\\\";\\nimport type { RpcClientError } from \\\"effect/rpc\\\";\\n\\nimport {\\n  CalculatorRpcInvalidResponse,\\n  CalculatorRpcUnavailable,\\n  CalculatorRpcRequestTooLarge,\\n  CalculatorRpcRateLimited,\\n  CalculatorRpcRequestTimedOut,\\n  CalculatorRpcResponseTooLarge,\\n} from \\\"./errors.js\\\";\\nimport { CalculatorRpcResponseLimit } from \\\"./schemas.js\\\";\\n\\n// Native RPC retains the HTTP reason as an unknown cause. Read only the safe\\n// status/size projection once; never expose its request, headers or body.\\nconst RejectedHttpStatus = Schema.TaggedStruct(\\\"StatusCodeError\\\", {\\n  response: Schema.Struct({ status: Schema.Literals([408, 413, 429]) }),\\n});\\nconst OversizedHttpReply = Schema.TaggedStruct(\\\"DecodeError\\\", {\\n  cause: CalculatorRpcResponseTooLarge,\\n});\\n\\nexport const calculatorRpcTransportFailure = (\\n  error: RpcClientError.RpcClientError\\n) =>\\n  Match.value(error.reason).pipe(\\n    Match.tag(\\\"RpcClientDefect\\\", () => new CalculatorRpcInvalidResponse()),\\n    Match.tag(\\\"HttpError\\\", (reason) =>\\n      Schema.decodeUnknownOption(\\n        Schema.Union([RejectedHttpStatus, OversizedHttpReply])\\n      )(reason.cause).pipe(\\n        Option.match({\\n          onNone: () =>\\n            Match.value(reason.kind).pipe(\\n              Match.whenOr(\\n                \\\"DecodeError\\\",\\n                \\\"EmptyBodyError\\\",\\n                () => new CalculatorRpcInvalidResponse()\\n              ),\\n              Match.orElse(() => new CalculatorRpcUnavailable())\\n            ),\\n          onSome: (rejection) =>\\n            Match.value(rejection).pipe(\\n              Match.tag(\\n                \\\"DecodeError\\\",\\n                () => new CalculatorRpcResponseTooLarge()\\n              ),\\n              Match.tag(\\\"StatusCodeError\\\", ({ response }) =>\\n                Match.value(response.status).pipe(\\n                  Match.when(408, () => new CalculatorRpcRequestTimedOut()),\\n                  Match.when(413, () => new CalculatorRpcRequestTooLarge()),\\n                  Match.when(429, () => new CalculatorRpcRateLimited()),\\n                  Match.exhaustive\\n                )\\n              ),\\n              Match.exhaustive\\n            ),\\n        })\\n      )\\n    ),\\n    Match.orElse(() => new CalculatorRpcUnavailable())\\n  );\\n\\n// One concrete private HTTP adapter for all closed native operations. Keep\\n// the native Protocol/parser/exit Schemas; count bytes before materialisation.\\nexport const boundedCalculatorRpcHttpClient = (client: HttpClient.HttpClient) =>\\n  client.pipe(\\n    HttpClient.withScope,\\n    HttpClient.filterStatusOk,\\n    HttpClient.transformResponse(\\n      Effect.flatMap((response) =>\\n        response.stream.pipe(\\n          Stream.mapAccumEffect(\\n            () => ByteSize.bytes(0),\\n            (total, chunk) => {\\n              const next = ByteSize.sum(\\n                total,\\n                ByteSize.bytes(chunk.byteLength)\\n              );\\n              return ByteSize.isGreaterThan(next, CalculatorRpcResponseLimit)\\n                ? Effect.fail(\\n                    new HttpClientError.HttpClientError({\\n                      reason: new HttpClientError.DecodeError({\\n                        cause: new CalculatorRpcResponseTooLarge(),\\n                        request: response.request,\\n                        response,\\n                      }),\\n                    })\\n                  )\\n                : Effect.succeed([next, [chunk]] as const);\\n            }\\n          ),\\n          Stream.mkUint8Array,\\n          // This native Web reader ignores MaxBodySize. After the bounded read,\\n          // reuse its Response adapter. The byte copy owns an ArrayBuffer body.\\n          Effect.map((bytes) =>\\n            HttpClientResponse.fromWeb(\\n              response.request,\\n              new Response(new Uint8Array(bytes), {\\n                headers: response.headers,\\n              })\\n            )\\n          )\\n        )\\n      )\\n    ),\\n    // Close the actual HTTP request after the bounded body read, or on status\\n    // rejection/interruption, before native RPC parses the retained bytes.\\n    HttpClient.transformResponse(Effect.scoped)\\n  );\\n    error: CalculatorApiMetadataErrorEnvelopes,\\n    params: CalculatorParams,\\n    query: HelpQuery,\\n    success: CalculatorCatalogItem,\\n  }\\n).annotate(OpenApi.Description, \\\"Return one public calculator catalog entry.\\\");\\n\\nconst GetCalculatorSchemaEndpoint = HttpApiEndpoint.get(\\n  \\\"getCalculatorSchema\\\",\\n  \\\"/calculators/:calculatorId/schema\\\",\\n  {\\n    error: CalculatorApiMetadataErrorEnvelopes,\\n    params: CalculatorParams,\\n    query: HelpQuery,\\n    success: CalculatorSchemaResponse,\\n  }\\n).annotate(\\n  OpenApi.Description,\\n  \\\"Return fact, rule and report schema metadata for one calculator.\\\"\\n);\\n\\nconst GetCalculatorGraphEndpoint = HttpApiEndpoint.get(\\n  \\\"getCalculatorGraph\\\",\\n  \\\"/calculators/:calculatorId/graph\\\",\\n  {\\n    error: CalculatorApiMetadataErrorEnvelopes,\\n    params: CalculatorParams,\\n    query: MetadataQuery,\\n    success: CalculatorGraphResponse,\\n  }\\n).annotate(\\n  OpenApi.Description,\\n  \\\"Return graph edges and canonical graph validation diagnostics for one calculator.\\\"\\n);\\n\\nconst CalculateEndpoint = HttpApiEndpoint.post(\\n  \\\"calculate\\\",\\n  \\\"/calculators/:calculatorId/calculate\\\",\\n  {\\n    error: CalculatorApiErrorEnvelopes,\\n    params: CalculatorParams,\\n    payload: CalculatorRunRequest,\\n    query: CalculationQuery,\\n    success: CalculatorRunResponse,\\n  }\\n).annotate(\\n  OpenApi.Description,\\n  \\\"Run one public calculator using canonical scenario decoding and rule-pack layers.\\\"\\n);\\n\\nconst ListFactsEndpoint = HttpApiEndpoint.get(\\\"listFacts\\\", \\\"/facts\\\", {\\n  error: CalculatorApiTimeoutEnvelope,\\n  query: DescriptorFilterQuery,\\n  success: FactsResponse,\\n}).annotate(\\n  OpenApi.Description,\\n  \\\"List canonical fact descriptors, optionally filtered by calculator context.\\\"\\n);\\n\\nconst ListRulesEndpoint = HttpApiEndpoint.get(\\\"listRules\\\", \\\"/rules\\\", {\\n  error: CalculatorApiTimeoutEnvelope,\\n  query: DescriptorFilterQuery,\\n  success: RulesResponse,\\n}).annotate(\\n  OpenApi.Description,\\n  \\\"List canonical rule descriptors, optionally filtered by calculator context.\\\"\\n);\\n\\nexport class CalculatorApiGroup extends HttpApiGroup.make(\\\"calculatorApi\\\")\\n  .add(GetJurisdictionsEndpoint)\\n  .add(GetTaxYearsEndpoint)\\n  .add(ListCalculatorsEndpoint)\\n  .add(GetCalculatorEndpoint)\\n  .add(GetCalculatorSchemaEndpoint)\\n  .add(GetCalculatorGraphEndpoint)\\n  .add(CalculateEndpoint)\\n  .add(ListFactsEndpoint)\\n  .add(ListRulesEndpoint)\\n  .prefix(\\\"/api/v1\\\")\\n  .annotate(OpenApi.Title, \\\"Calculator API\\\") {}\\nimport { PublicCalculatorService } from \\\"@taxkit/calculators\\\";\\nimport type { CalculatorMetadataError } from \\\"@taxkit/calculators\\\";\\nimport { Effect, Match } from \\\"effect\\\";\\nimport { HttpApiBuilder } from \\\"effect/http-api\\\";\\n\\nimport { TaxKitApi } from \\\"../api.js\\\";\\nimport { CalculatorApiErrorEnvelopeData } from \\\"../groups/calculators.js\\\";\\n\\nconst calculatorApiMetadataFailure = (error: CalculatorMetadataError) =>\\n  Match.value(error).pipe(\\n    Match.tag(\\n      \\\"CalculatorOperationTimedOut\\\",\\n      (failure) => new CalculatorApiErrorEnvelopeData({ error: failure })\\n    ),\\n    Match.orElse(\\n      (failure) => new CalculatorApiErrorEnvelopeData({ error: failure })\\n    )\\n  );\\n\\nexport const CalculatorApiHandlerLive = HttpApiBuilder.group(\\n  TaxKitApi,\\n  \\\"calculatorApi\\\",\\n  (handlers) =>\\n    Effect.succeed(\\n      handlers\\n        .handle(\\\"getJurisdictions\\\", () =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.listJurisdictions();\\n          }).pipe(\\n            Effect.mapError(\\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\\n            )\\n          )\\n        )\\n        .handle(\\\"getTaxYears\\\", ({ query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.listTaxYears(query);\\n          }).pipe(\\n            Effect.mapError(\\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\\n            )\\n          )\\n        )\\n        .handle(\\\"listCalculators\\\", ({ query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.listCalculators(query);\\n          }).pipe(\\n            Effect.mapError(\\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\\n            )\\n          )\\n        )\\n        .handle(\\\"getCalculator\\\", ({ params, query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.getCalculator({\\n              calculatorId: params.calculatorId,\\n              ...query,\\n            });\\n          }).pipe(Effect.mapError(calculatorApiMetadataFailure))\\n        )\\n        .handle(\\\"getCalculatorSchema\\\", ({ params, query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.getCalculatorSchema({\\n              calculatorId: params.calculatorId,\\n              ...query,\\n            });\\n          }).pipe(Effect.mapError(calculatorApiMetadataFailure))\\n        )\\n        .handle(\\\"getCalculatorGraph\\\", ({ params, query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.getCalculatorGraph({\\n              calculatorId: params.calculatorId,\\n              ...query,\\n            });\\n          }).pipe(Effect.mapError(calculatorApiMetadataFailure))\\n        )\\n        .handle(\\\"calculate\\\", ({ params, payload, query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.calculate({\\n              calculatorId: params.calculatorId,\\n              payload,\\n              ...query,\\n            });\\n          }).pipe(\\n            Effect.mapError((error) =>\\n              Match.value(error).pipe(\\n                Match.tag(\\n                  \\\"CalculatorCapacityExceeded\\\",\\n                  (failure) =>\\n                    new CalculatorApiErrorEnvelopeData({ error: failure })\\n                ),\\n                Match.tag(\\n                  \\\"CalculatorOperationTimedOut\\\",\\n                  (failure) =>\\n                    new CalculatorApiErrorEnvelopeData({ error: failure })\\n                ),\\n                Match.orElse(\\n                  (failure) =>\\n                    new CalculatorApiErrorEnvelopeData({ error: failure })\\n                )\\n              )\\n            )\\n          )\\n        )\\n        .handle(\\\"listFacts\\\", ({ query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.listFacts(query);\\n          }).pipe(\\n            Effect.mapError(\\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\\n            )\\n          )\\n        )\\n        .handle(\\\"listRules\\\", ({ query }) =>\\n          Effect.gen(function* () {\\n            const service = yield* PublicCalculatorService;\\n            return yield* service.listRules(query);\\n          }).pipe(\\n            Effect.mapError(\\n              (error) => new CalculatorApiErrorEnvelopeData({ error })\\n            )\\n          )\\n        )\\n    )\\n);\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10e2a-6616-7a42-8b17-50e4af22487f","create_time":1791262137.428795}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
