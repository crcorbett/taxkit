      EffectRecord.toEntries(object),\\n                EffectArray.sortWith(([key]) => key, Order.String),\\n                EffectArray.map(\\n                  ([key, child]): readonly [string, Schema.Json] => [\\n                    key,\\n                    normalizeJsonValue(child),\\n                  ]\\n                ),\\n                EffectRecord.fromEntries\\n              ),\\n          })\\n        ),\\n      onSome: (array) => EffectArray.map(array, normalizeJsonValue),\\n    })\\n  );\\n\\n3:import { AlchemyContext } from \\\"alchemy/AlchemyContext\\\";\\n17:import { StackConfigOverrides } from \\\"alchemy/Util/ConfigProvider\\\";\\n277:        Effect.provideService(AlchemyContext, localContext),\\n296:      Effect.provideService(AlchemyContext, localContext),\\n351:      Effect.provideService(AlchemyContext, localContext),\\n373:      Effect.provideService(StackConfigOverrides, {\\n376:      Effect.provideService(AlchemyContext, localContext),\\n403:        Effect.provideService(AlchemyContext, localContext),\\n\"}"},{"type":"input_text","text":"{}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10fab-f789-7f30-a7de-963ccee8ae9f","create_time":1791265324.93384}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
