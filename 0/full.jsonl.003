teSettingsTransport } from \"./schemas\";\n\nconst binding = { connect: vi.fn(), fetch: vi.fn() };\nconst settings = {\n  API_PUBLIC_ORIGIN: \"https://api.taxkit.example\",\n  TAXKIT_API: binding,\n  WEBSITE_PUBLIC_ORIGIN: \"https://taxkit.example\",\n};\ndescribe(\"native website settings boundary\", () => {\n  it.effect(\n    \"retains the binding receiver and restores branded origins through JSON\",\n    () =>\n      Effect.gen(function* () {\n        const checked = yield* TaxKitWebServerConfig(binding).pipe(\n          Effect.provideService(\n            ConfigProvider.ConfigProvider,\n            ConfigProvider.fromUnknown(settings)\n          )\n        );\n        expect(checked.binding).toBe(binding);\n        expect(checked.apiOrigin.href).toBe(\"https://api.taxkit.example/\");\n        const encoded = yield* Schema.encodeEffect(\n          Schema.fromJsonString(WebsiteSettingsTransport)\n        )(\n          Result.succeed(\n            WebsitePublicSettings.make({ apiOrigin: checked.apiOrigin })\n          )\n        );\n        const restored = yield* Schema.decodeUnknownEffect(\n          Schema.fromJsonString(WebsiteSettingsTransport)\n        )(encoded);\n        expect(Result.isSuccess(restored)).toBe(true);\n        if (Result.isSuccess(restored)) {\n          expect(restored.success.apiOrigin).toBeInstanceOf(URL);\n        }\n      })\n  );\n  it.effect.each([\n    { ...settings, API_PUBLIC_ORIGIN: undefined },\n    {\n      ...settings,\n      API_PUBLIC_ORIGIN:\n        \"https://api.taxkit.example/secret-canary?token=secret-canary\",\n    },\n    { ...settings, WEBSITE_PUBLIC_ORIGIN: \"secret-canary\" },\n    { ...settings, TAXKIT_API: { fetch: vi.fn() } },\n    { ...settings, TAXKIT_API: \"secret-canary\" },\n  ])(\n    \"rejects missing or invalid settings without carrying raw input\",\n    (input) =>\n      Effect.gen(function* () {\n        const checked = yield* TaxKitWebServerConfig(input.TAXKIT_API).pipe(\n          Effect.provideService(\n            ConfigProvider.ConfigProvider,\n            ConfigProvider.fromUnknown(input)\n          ),\n          Effect.result\n        );\n        expect(Result.isFailure(checked)).toBe(true);\n        if (Result.isFailure(checked)) {\n          expect(checked.failure.message).toBe(\n            \"TaxKit web settings are missing or invalid.\"\n          );\n          const encoded = yield* Schema.encodeEffect(\n            Schema.fromJsonString(WebsiteSettingsTransport)\n          )(checked);\n          expect(encoded).not.toContain(\"secret-canary\");\n        }\n      })\n  );\n});\ncat: apps/web/scripts/native-pair.shared.ts: No such file or directory\n","exit_code":0,"duration":{"secs":0,"nanos":7542},"formatted_output":"Warning: truncated output (original token count: 262152)\nTotal output lines: 86\n\nrg: node_modules/effect/src/unstable/httpapi: No such file or directory (os error 2)\nrg: node_modules/effect/src/unstable/http/HttpServerResponse.ts: No such file or directory (os error 2)\nnode_modules/effect/src/http-api/HttpApiBuilder.ts:902:      return Response.setHeaders(encoded, encodedHeaders as any)\nnode_modules/effect/src/http-api/HttpApiBuilder.ts:1312:            (headers) => Response.setHeaders(response, headers as any)\nnode_modules/effect/src/http-api/HttpApiBuilder.ts:1365:            Response.setHeader(\"content-type\", encoding.contentType)\nnode_modules/effect/src/http-api/HttpApiClient.ts:469:              httpRequest = HttpClientRequest.setHeaders(httpRequest, headers)\nnode_modules/effect/src/http-api/internal/httpApiSwagger.ts:7:  \"/*! For license information please see swagger-ui-bundle.js.LICENSE.txt */\\n!function webpackUniversalModuleDefinition(s,o){\\\"object\\\"==typeof exports&&\\\"object\\\"==typeof module?module.exports=o():\\\"function\\\"==typeof define&&define.amd?define([],o):\\\"object\\\"==typeof exports?exports.SwaggerUIBundle=o():s.SwaggerUIBundle=o()}(this,(()=>(()=>{var s={251:(s,o)=>{o.read=function(s,o,i,a,u)