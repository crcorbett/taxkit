\n    { ...settings, TAXKIT_API: { fetch: vi.fn() } },\n    { ...settings, TAXKIT_API: \"secret-canary\" },\n  ])(\n    \"rejects missing or invalid settings without carrying raw input\",\n    (input) =>\n      Effect.gen(function* () {\n        const checked = yield* TaxKitWebServerConfig(input.TAXKIT_API).pipe(\n          Effect.provideService(\n            ConfigProvider.ConfigProvider,\n            ConfigProvider.fromUnknown(input)\n          ),\n          Effect.result\n        );\n        expect(Result.isFailure(checked)).toBe(true);\n        if (Result.isFailure(checked)) {\n          expect(checked.failure.message).toBe(\n            \"TaxKit web settings are missing or invalid.\"\n          );\n          const encoded = yield* Schema.encodeEffect(\n            Schema.fromJsonString(WebsiteSettingsTransport)\n          )(checked);\n          expect(encoded).not.toContain(\"secret-canary\");\n        }\n      })\n  );\n});\ncat: apps/web/scripts/native-pair.shared.ts: No such file or directory\n","stderr":"","aggregated_output":"rg: node_modules/effect/src/unstable/httpapi: No such file or directory (os error 2)\nrg: node_modules/effect/src/unstable/http/HttpServerResponse.ts: No such file or directory (os error 2)\nnode_modules/effect/src/http-api/HttpApiBuilder.ts:902:      return Response.setHeaders(encoded, encodedHeaders as any)\nnode_modules/effect/src/http-api/HttpApiBuilder.ts:1312:            (headers) => Response.setHeaders(response, headers as any)\nnode_modules/effect/src/http-api/HttpApiBuilder.ts:1365:            Response.setHeader(\"content-type\", encoding.contentType)\nnode_modules/effect/src/http-api/HttpApiClient.ts:469:              httpRequest = HttpClientRequest.setHeaders(httpRequest, headers)\nnode_modules/effect/src/http-api/internal/httpApiSwagger.ts:7:  \"/*! For license information please see swagger-ui-bundle.js.LICENSE.txt */\\n!function webpackUniversalModuleDefinition(s,o){\\\"object\\\"==typeof exports&&\\\"object\\\"==typeof 