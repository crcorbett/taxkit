t { Array, Match, Option, Result, pipe } from \"effect\";\nimport { useState } from \"react\";\n\nimport {\n  DocsRecoverableError,\n  DocsRouteError,\n  DocsRouteNotFound,\n  DocsRoutePending,\n} from \"#/components/docs-route-states\";\nimport { loadDocsPage } from \"#/lib/docs/loaders\";\nimport { docsPageRouteBoundary } from \"#/lib/docs/route-boundary\";\nimport { MdxDocument } from \"#/lib/mdx/client-loader\";\nimport { requestDocsNavigationFocus } from \"#/lib/navigation-focus\";\nimport { useHydrated } from \"#/lib/use-hydrated\";\n\ntype DocsPageRouteError = Result.Result.Failure<\n  ReturnType<typeof docsPageRouteBoundary.restore>\n>;\n\nconst DocsRouteFailure = ({\n  error,\n  onRetry,\n}: Readonly<{\n  error: DocsPageRouteError;\n  onRetry: () => void;\n}>) =>\n  Match.value(error).pipe(\n    Match.tags({\n      DocsContentPreloadError: (preloadError) => (\n        <DocsRecoverableError\n          message={preloadError.message}\n          onRetry={onRetry}\n        />\n      ),\n      DocsRouteTransportError: () => (\n        <DocsRecoverableError\n          message=\"The documentation route data could not be read.\"\n          onRetry={onRetry}\n        />\n      ),\n      DocsSourceError: () => (\n        <DocsRecoverableError\n          message=\"The documentation source could not be loaded.\"\n          onRetry={onRetry}\n        />\n      ),\n    }),\n    Match.exhaustive\n  );\n\nconst DocsNavigation = ({\n  currentPath,\n  interactive,\n  navigation,\n  onNavigate,\n  onToggle,\n  open,\n}: Readonly<{\n  currentPath: DocsContentPage[\"path\"];\n  interactive: boolean;\n  navigation: DocsNavigationValue;\n  onNavigate: () => void;\n  onToggle: () => void;\n  open: boolean;\n}>) => (\n  <>\n    <header className=\"docs-mobile-header\">\n      <Link className=\"docs-nav__home\" to=\"/\">\n        TaxKit Docs\n      </Link>\n      <button\n        aria-controls=\"docs-navigation\"\n        aria-expanded={open}\n        className=\"docs-nav-toggle\"\n        onClick={onToggle}\n        type=\"button\"\n      >\n        {open ? \"Close navigation\" : \"Open navigation\"}\n      </button>\n    </header>\n    <nav\n      aria-label=\"Documentation\"\n      className=\"docs-nav\"\n      data-open={open}\n      data-tk-navigation-interactive={interactive ? \"true\" : \"false\"}\n---\ntitle: \"Overview\"\ndescription: \"Learn where to start with the TaxKit SDK and HTTP API.\"\nstatus: \"draft\"\n---\n\n# Overview\n\nUse TaxKit when you need source-backed tax calculations from TypeScript or\nover HTTP. Start with the TypeScript SDK when your application can import\nTaxKit packages. Use the HTTP API when the caller is a browser, another\nlanguage or a service boundary that should not run the SDK in-process.\n\n## Choose your first path\n\n| You need to                                          | Start with                                        |\n| ---------------------------------------------------- | ------------------------------------------------- |\n| Run one calculation from TypeScript                  | [Quickstart](./quickstart.mdx)                    |\n| Add TaxKit to a server application                   | [Plain SDK](../sdk/plain-sdk.mdx)                 |\n| Return typed success or failure values               | [Safe SDK](../sdk/safe-sdk.mdx)                   |\n| Compose TaxKit inside an Effect application          | [Effect SDK](../sdk/effect-sdk.mdx)               |\n| Call TaxKit from a browser or non-TypeScript service | [Choose SDK or HTTP API](./choose-sdk-or-api.mdx) |\n\n## How the public surfaces fit\n\n```ts\nProduction: public integration surfaces\n\nTypeScript application\n  -> @taxkit/sdk plain facade\n    -> calculator service\n\nEffect application or in-process transport\n  -> @taxkit/sdk/effect\n    -> calculator service\n\nBrowser or non-TypeScript caller\n  -> HTTP API\n    -> @taxkit/sdk/effect\n      -> calculator service\n```\n\nThe SDK and API use the same calculator-owned schemas and branded values. This\nkeeps request validation, calculator reports and expected errors aligned across\nsurfaces.\n\n## Current release status\n\nThe TypeScript SDK package is still private until release approval. The docs\nshow the intended public package shape and the current workspace exports.\n\n## Next steps\n\n- Run your first calculation with the [quickstart](./quickstart.mdx).\n- Compare integration surfaces in [Choose SDK or HTTP API](./choose-sdk-or-api.mdx).\n- Read the [TypeScript SDK](../sdk/typescript-sdk.mdx) page for the SDK surface.\n","exit_code":0,"duration":{"secs":0,"nanos":8750},"formatted_output":"{\n  \"name\": \"fumadocs-mdx\",\n  \"version\": \"15.4.6\",\n  \"description\": \"The built-in source for Fumadocs\",\n  \"keywords\": [\n    \"Docs\",\n    \"fumadocs\"\n  ],\n  \"homepage\": \"https://fumadocs.dev\",\n  \"bugs\": {\n    \"url\": \"https://github.com/fuma-nama/fumadocs/issues\"\n  },\n  \"license\": \"MIT\",\n  \"author\": \"Fuma Nama\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"github:fuma-nama/fumadocs\"\n  },\n  \"bin\": {\n    \"fumadocs-mdx\": \"./bin.js\"\n  },\n  \"files\": [\n    \"dist\",\n    \"bin.js\"\n  ],\n  \"type\": \"module\",\n  \"sideEffects\": false,\n  \"exports\": {\n    \".\": \"./dist/index.js\",\n    \"./bin\": \"./dist/bin.js\",\n    \"./bun\": \"./dist/bun/index.js\",\n    \"./config\": \"./dist/config/index.js\",\n    \"./macro\": \"./dist/macro/index.js\",\n    \"./next\": \"./dist/next/index.js\",\n    \"./node\": \"./dist/node/index.js\",\n    \"./node/_loader\": \"./dist/node/_loader.js\",\n    \"./node/loader\": \"./dist/node/loader.js\",\n    \"./plugins/index-file\": \"./dist/plugins/index-file.js\",\n    \"./plugins/json-schema\": \"./dist/plugins/json-schema.js\",\n    \"./plugins/last-modified\": \"./dist/plugins/last-modified.js\",\n    \"./rolldown\": \"./dist/rolldown/index.js\",\n    \"./runtime/browser\": \"./dist/runtime/browser.js\",\n    \"./runtime/dynamic\": \"./dist/runtime/dynamic.js\",\n    \"./runtime/macro\": \"./dist/runtime/macro.js\",\n    \"./runtime/server\": \"./dist/runtime/server.js\",\n    \"./runtime/types\": \"./dist/runtime/types.js\",\n    \"./vite\": \"./dist/vite/index.js\",\n    \"./webpack/macro\": \"./dist/webpack/macro.js\",\n    \"./webpack/mdx\": \"./dist/webpack/mdx.js\",\n    \"./webpack/meta\": \"./dist/webpack/meta.js\",\n    \"./package.json\": \"./package.json\"\n  },\n  \"publishConfig\": {\n    \"access\": \"public\"\n  },\n  \"dependencies\": {\n    \"@mdx-js/mdx\": \"^3.1.1\",\n    \"@standard-schema/spec\": \"^1.1.0\",\n    \"chokidar\": \"^5.0.0\",\n    \"esbuild\": \"^0.28.2\",\n    \"estree-util-value-to-estree\": \"^3.5.0\",\n    \"github-slugger\": \"^2.0.0\",\n    \"magic-string\": \"^1.4.1\",\n    \"mdast-util-mdx\": \"^3.0.0\",\n    \"picocolors\": \"^1.1.1\",\n    \"picomatch\": \"^4.0.7\",\n    \"tinyexec\": \"^1.3.1\",\n    \"tinyglobby\": \"^0.2.17\",\n    \"unified\": \"^11.0.5\",\n    \"unist-util-remove-position\": \"^5.0.0\",\n    \"unist-util-visit\": \"^5.1.0\",\n    \"vfile\": \"^6.0.3\",\n    \"yaml\": \"^2.9.1\",\n    \"yuku-analyzer\": \"^0.10.2\",\n    \"zod\": \"^4.6.5\"\n  },\n  \"devDependencies\": {\n    \"@fumadocs/satteri\": \"0.5.1\",\n    \"@fumadocs/vite\": \"0.1.0\",\n    \"@types/bun\": \"^1.4.2\",\n    \"@types/mdast\": \"^4.0.4\",\n    \"@types/mdx\": \"^2.0.14\",\n    \"@types/node\": \"^26.6.1\",\n    \"@types/picomatch\": \"^4.0.3\",\n    \"@types/react\": \"^19.3.0\",\n    \"fumadocs-core\": \"16.15.18\",\n    \"mdast-util-directive\": \"^3.1.0\",\n    \"next\": \"^16.3.5\",\n    \"react\": \"^19.3.0\",\n    \"remark\": \"^15.0.1\",\n    \"remark-directive\": \"^4.0.0\",\n    \"remark-mdx\": \"^3.1.1\",\n    \"rolldown\": \"^1.2.9\",\n    \"satteri\": \"^0.10.5\",\n    \"tsconfig\": \"0.0.0\",\n    \"tsdown\": \"0.23.0\",\n    \"vite\": \"^8.3.0\",\n    \"webpack\": \"^5.111.1\"\n  },\n  \"peerDependencies\": {\n    \"@fumadocs/satteri\": \"0.x.x\",