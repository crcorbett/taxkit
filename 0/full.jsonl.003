{"timestamp":"2026-10-06T05:30:01.621Z","ordinal":38588,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a10fab-f789-7f30-a7de-963ccee8ae9f","item":{"type":"McpToolCall","id":"exec-2f34e9f5-72c8-4798-bc27-8a134768a56a","server":"executor-personal","tool":"execute","arguments":{"code":"return await tools.describe.tool({path:'linear_mcp.user.personallinearmcp.list_comments'});"},"status":"completed","result":{"content":[{"type":"text","text":"{\n  \"path\": \"linear_mcp.user.personallinearmcp.list_comments\",\n  \"name\": \"list_comments\",\n  \"description\": \"List comments on a Linear issue, project, initiative, document, project milestone, or project/initiative status update. Provide exactly one of `issueId`, `projectId`, `initiativeId`, `documentId`, `milestoneId`, or `statusUpdateId`. For issues, projects, and initiatives this returns both top-level discussion threads and inline description comments. Inline (anchored) comments carry a non-null `quotedText` set to the snippet of description text they reference. Returned comments include `author` and nullable `onBehalfOf`; when set, `onBehalfOf` identifies the user the agent author acted for. Files uploaded in comment bodies are returned in `attachments` with titles and download URLs, not issue attachment IDs. Signed upload URLs expire after five minutes; call list_comments again to refresh them. Download documents using these URLs and process them with your own file tools.\",\n  \"inputTypeScript\": \"{ limit?: number; cursor?: string; orderBy?: \\\"createdAt\\\" | \\\"updatedAt\\\"; issueId?: string; projectId?: string; initiativeId?: string; documentId?: string; milestoneId?: string; statusUpdateId?: string; statusUpdateType?: \\\"project\\\" | \\\"initiative\\\"; }\",\n  \"outputTypeScript\": \"{ ok: true; data: { _meta?: { \\\"io.modelcontextprotocol/serverInfo\\\"?: { name: string; title?: string; icons?: { src: string; mimeType?: string; sizes?: string[]; theme?: \\\"light\\\" | \\\"dark\\\"; }[]; version: string; websiteUrl?: string; description?: string; }; [k: string]: unknown; }; content: ({ type: \\\"text\\\"; text: string; annotations?: { audience?: (\\\"user\\\" | \\\"assistant\\\")[]; priority?: number; lastModified?: string; }; _meta?: { [k: string]: unknown; }; } | { type: \\\"image\\\"; data: string; mimeType: string; annotations?: { audience?: (\\\"user\\\" | \\\"assistant\\\")[]; priority?: number; lastModified?: string; }; _meta?: { [k: string]: unknown; }; } | { type: \\\"audio\\\"; data: string; mimeType: string; annotations?: { audience?: (\\\"user\\\" | \\\"assistant\\\")[]; priority?: number; lastModified?: string; }; _meta?: { [k: string]: unknown; }; } | { name: string; title?: string; icons?: { src: string; mimeType?: string; sizes?: string[]; theme?: (\\\"light\\\" | \\\"dark\\\"); }[]; uri: string; description?: string; mimeType?: string; size?: number; annotations?: { audience?: (\\\"user\\\" | \\\"assistant\\\")[]; priority?: number; lastModified?: string; }; _meta?: { [k: string]: unknown; }; type: \\\"resource_link\\\"; } | { type: \\\"resource\\\"; resource: ({ uri: string; mimeType?: string; _meta?: { [k: string]: unknown; }; text: string; } | { uri: string; mimeType?: string; _meta?: { [k: string]: unknown; }; blob: string; }); annotations?: { audience?: (\\\"user\\\" | \\\"assistant\\\")[]; priority?: number; lastModified?: string; }; _meta?: { [k: string]: unknown; }; })[]; structuredContent?: unknown; isError?: false; [k: string]: unknown; }; http?: ToolHttpMeta } | { ok: false; error: ToolError }\",\n  \"typeScriptDefinitions\": {\n    \"ToolError\": \"{ code: string; message: string; status?: number; details?: unknown; retryable?: boolean }\",\n    \"ToolHttpMeta\": \"{ status: number; headers: { [k: string]: string; } }\",\n    \"ToolFile\": \"{ _tag: \\\"ToolFile\\\"; name?: string; mimeType: string; encoding: \\\"base64\\\"; data: string; byteLength: number; }\"\n  },\n  \"annotations\": {\n    \"requiresApproval\": false\n  }\n}"}],"structuredContent":{"status":"completed","result":{"path":"linear_mcp.user.personallinearmcp.list_comments","name":"list_comments","description":"List comments on a Linear issue, project, initiative, document, project milestone, or project/initiative status update. Provide exactly one of `issueId`, `projectId`, `initiativeId`, `documentId`, `milestoneId`, or `statusUpdateId`. For issues, projects, and initiatives this returns both top-level discussion threads and inline description comments. Inline (anchored) comments carry a non-null `quotedText` set to the snippet of description text they reference. Returned comments include `author` and nullable `onBehalfOf`; when set, `onBehalfOf` identifies the user the agent author acted for. Files uploaded in comment bodies are returned in `attachments` with titles and download URLs, not issue attachment IDs. Signed upload URLs expire after five minutes; call list_comments again to refresh them. Download documents using these URLs and process them with your own file tools.","inputTypeScript":"{ limit?: number; cursor?: string; orderBy?: \"createdAt\" | \"updatedAt\"; issueId?: string; projectId?: string; initiativeId?: string; documentId?: string; milestoneId?: string; statusUpdateId?: string; statusUpdateType?: \"project\" | \"initiative\"; }","outputTypeScript":"{ ok: true; data: { _meta?: { \"io.modelcontextprotocol/serverInfo\"?: { name: string; title?: string; icons?: { src: string; mimeType?: string; sizes?: string[]; theme?: \"light\" | \"dark\"; }[]; version: string; websiteUrl?: string; description?: string; }; [k: string]: unknown; }; content: ({ type: \"text\"; text: string; annotations?: { audience?: (\"user\" | \"assistant\")[]; priority?: number; lastModified?: string; }; _meta?: { [k: string]: unknown; }; } | { type: \"image\"; data: string; mimeType: string; annotations?: { audience?: (\"user\" | \"assistant\")[]; priority?: number; lastModified?: string; }; _meta?: { [k: string]: unknown; }; } | { type: \"audio\"; data: string; mimeType: string; annotations?: { audience?: (\"user\" | \"assistant\")[]; priority?: number; lastModified?: string; }; _meta?: { [k: string]: unknown; }; } | { name: string; title?: string; icons?: { src: string; mimeType?: string; sizes?: string[]; theme?: (\"light\" | \"dark\"); }[]; uri: string; description?: string; mimeType?: string; size?: number; annotations?: { audience?: (\"user\" | \"assistant\")[]; priority?: number; lastModified?: string; }; _meta?: { [k: string]: unknown; }; type: \"resource_link\"; } | { type: \"resource\"; resource: ({ uri: string; mimeType?: string; _meta?: { [k: string]: unknown; }; text: string; } | { uri: string; mimeType?: string; _meta?: { [k: string]: unknown; }; blob: string; }); annotations?: { audience?: (\"user\" | \"assistant\")[]; priority?: number; lastModified?: string; }; _meta?: { [k: string]: unknown; }; })[]; structuredContent?: unknown; isError?: false; [k: string]: unknown; }; http?: ToolHttpMeta } | { ok: false; error: ToolError }","typeScriptDefinitions":{"ToolError":"{ code: string; message: string; status?: number; details?: unknown; retryable?: boolean }","ToolHttpMeta":"{ status: number; headers: { [k: string]: string; } }","ToolFile":"{ _tag: \"ToolFile\"; name?: string; mimeType: string; encoding: \"base64\"; data: string; byteLength: number; }"},"annotations":{"requiresApproval":false}},"logs":[]}},"duration":{"secs":4,"nanos":111392708}},"started_at_ms":1791264597509,"completed_at_ms":1791264601620}}
