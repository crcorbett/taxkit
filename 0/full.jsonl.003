{"timestamp":"2026-10-06T06:10:38.918Z","ordinal":39556,"type":"token_usage_record","payload":{"thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a10fab-f789-7f30-a7de-963ccee8ae9f","session_id":"01a1055e-4560-7b33-82d2-226827c76159","root_turn_id":"01a10fab-f789-7f30-a7de-963ccee8ae9f","response_id":"resp_02692a5b008ee3bd016ac490c60c6c87d0b21757abf1ceaf45","usage":{"input_tokens":138199,"cached_input_tokens":135168,"cache_write_input_tokens":0,"output_tokens":795,"reasoning_output_tokens":516,"total_tokens":138994},"turn_token_usage":{"input_tokens":18305549,"cached_input_tokens":17753984,"cache_write_input_tokens":0,"output_tokens":77330,"reasoning_output_tokens":23656,"total_tokens":18382879},"thread_token_usage":{"input_tokens":762508722,"cached_input_tokens":746790272,"cache_write_input_tokens":0,"output_tokens":3582334,"reasoning_output_tokens":1506075,"total_tokens":766091056}}}
{"timestamp":"2026-10-06T06:10:40.139Z","ordinal":39557,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a10fab-f789-7f30-a7de-963ccee8ae9f","item":{"type":"CommandExecution","id":"exec-fd5fa422-9a0a-4fd2-93b4-66dccb527c3f","process_id":"13906","command":["/bin/zsh","-lc","rg -n 'RateLimit' node_modules/.bun/alchemy*/node_modules/alchemy/src/Cloudflare/Workers/index.ts; sed -n '1,125p' packages/calculators/__tests__/calculation-admission.test.ts; sed -n '1,80p' node_modules/.bun/alchemy*/node_modules/alchemy/src/Cloudflare/Workers/Binding.ts; sed -n '1,110p' apps/api/src/worker-admission.layer.ts"],"cwd":"file:///Users/cooper/.codex/worktrees/aac7/taxkit","parsed_cmd":[{"type":"unknown","cmd":"rg -n 'RateLimit' node_modules/.bun/alchemy*/node_modules/alchemy/src/Cloudflare/Workers/index.ts; sed -n '1,125p' packages/calculators/__tests__/calculation-admission.test.ts; sed -n '1,80p' node_modules/.bun/alchemy*/node_modules/alchemy/src/Cloudflare/Workers/Binding.ts; sed -n '1,110p' apps/api/src/worker-admission.layer.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"23:export * from \"./RateLimit.ts\";\n24:export * from \"./RateLimitBinding.ts\";\nimport { describe, expect, it } from \"@effect/vitest\";\nimport { CalculationEngineLive } from \"@taxkit/core\";\nimport { Cents, Money } from \"@taxkit/core/primitives\";\nimport { AuPayCalculatorId, GrossPay } from \"@taxkit/rules-au-pay\";\nimport { Deferred, Effect, Fiber, Layer, Option, Ref, Result, Schema } from \"effect\";\nimport { TestClock } from \"effect/testing\";\n\nimport { PublicCalculatorServiceRateLimited } from \"../src/admission.layer.js\";\nimport { CalculatorClientRateKey } from \"../src/admission.schemas.js\";\nimport { CalculatorAdmission, CalculatorRequestRateKey } from \"../src/admission.service.js\";\nimport { PublicCalculatorServiceLive } from \"../src/live.layer.js\";\nimport { CalculatorAdmissionUnavailable, CalculatorRateLimited, CalculatorRunServiceRequest, MetadataQuery } from \"../src/schemas.js\";\nimport { PublicCalculatorService } from \"../src/service.js\";\nimport { PublicCalculatorServiceBounded } from \"../src/work.layer.js\";\n\nconst request = CalculatorRunServiceRequest.make({\n  calculatorId: AuPayCalculatorId.make(\"au.pay.take-home\"),\n  payload: {\n    facts: {\n      grossPay: new GrossPay({ amount: new Money({ cents: Cents.make(165_400), currency: \"AUD\" }), period: \"weekly\" }),\n      taxFreeThresholdClaimed: true,\n    },\n  },\n});\n\nconst calculators = PublicCalculatorServiceRateLimited.pipe(\n  Layer.provide(PublicCalculatorServiceLive),\n  Layer.provide(CalculationEngineLive)\n);\n\ndescribe(\"anonymous calculation admission\", () => {\n  it.effect(\"canonicalises IPv6 and prevents ordinary key serialisation\", () =>\n    Effect.gen(function* () {\n      const first = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\"2001:db8::75\");\n      const second = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\"2001:0db8:0000:0000:0000:0000:0000:0075\");\n      expect(first).toEqual(second);\n      expect(String(first)).not.toContain(\"2001:\");\n      expect(Result.isFailure(yield* Schema.encodeEffect(CalculatorClientRateKey)(first).pipe(Effect.result))).toBe(true);\n      yield* Effect.forEach([\"\", \"999.0.0.1\", \"203.0.113.1, 203.0.113.2\", \"private-canary\"], (invalid) =>\n        Schema.decodeUnknownEffect(CalculatorClientRateKey)(invalid).pipe(\n          Effect.result,\n          Effect.tap((result) => Effect.sync(() => expect(Result.isFailure(result)).toBe(true)))\n        )\n      );\n    })\n  );\n\n  it.effect(\"missing identity rejects calculation while metadata consumes no unit\", () =>\n    Effect.gen(function* () {\n      const calls = yield* Ref.make(0);\n      const service = yield* PublicCalculatorService.pipe(\n        Effect.provide(calculators.pipe(Layer.provide(Layer.succeed(CalculatorAdmission, CalculatorAdmission.of({\n          admitCalculation: () => Ref.update(calls, (count) => count + 1),\n        })))))\n      );\n      const result = yield* service.calculate(request).pipe(Effect.result);\n      expect(result).toEqual(Result.fail(new CalculatorAdmissionUnavailable()));\n      expect((yield* service.listCalculators(MetadataQuery.make({}))).calculators.length).toBe(3);\n      expect(yield* Ref.get(calls)).toBe(0);\n    })\n  );\n\n  it.effect(\"rejected admission does no calculation work and carries fixed safe guidance\", () =>\n    Effect.gen(function* () {\n      const live = yield* PublicCalculatorService;\n      const worked = yield* Ref.make(0);\n      const key = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\"203.0.113.75\");\n      const service = yield* PublicCalculatorService.pipe(Effect.provide(\n        PublicCalculatorServiceRateLimited.pipe(\n          Layer.provide(Layer.succeed(PublicCalculatorService, PublicCalculatorService.of({\n            ...live,\n            calculate: () => Ref.update(worked, (count) => count + 1).pipe(Effect.andThen(Effect.never)),\n          }))),\n          Layer.provide(Layer.succeed(CalculatorAdmission, CalculatorAdmission.of({\n            admitCalculation: () => Effect.fail(new CalculatorRateLimited()),\n          })))\n        )\n      ));\n      const result = yield* service.calculate(request).pipe(Effect.provideService(CalculatorRequestRateKey, Option.some(key)), Effect.result);\n      expect(result).toEqual(Result.fail(new CalculatorRateLimited()));\n      expect(yield* Ref.get(worked)).toBe(0);\n      const encoded = yield* Schema.encodeEffect(Schema.fromJsonString(CalculatorRateLimited))(new CalculatorRateLimited());\n      expect(encoded).not.toContain(\"203.0.113.75\");\n      expect(encoded).not.toContain(\"165400\");\n    }).pipe(Effect.provide(PublicCalculatorServiceLive.pipe(Layer.provide(CalculationEngineLive))))\n  );\n\n  it.effect(\"the five-second work budget includes stalled admission and its cleanup\", () =>\n    Effect.gen(function* () {\n      const started = yield* Deferred.make<void>();\n      const released = yield* Ref.make(false);\n      const key = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\"203.0.113.75\");\n      const service = yield* PublicCalculatorService.pipe(Effect.provide(\n        PublicCalculatorServiceBounded.pipe(Layer.provide(calculators), Layer.provide(Layer.succeed(CalculatorAdmission, CalculatorAdmission.of({\n          admitCalculation: () => Deferred.succeed(started, undefined).pipe(\n            Effect.andThen(Effect.never),\n            Effect.ensuring(Ref.set(released, true))\n          ),\n        }))))\n      ));\n      const pending = yield* service.calculate(request).pipe(Effect.provideService(CalculatorRequestRateKey, Option.some(key)), Effect.result, Effect.forkChild);\n      yield* Deferred.await(started);\n      yield* TestClock.adjust(\"5 seconds\");\n      const result = yield* Fiber.join(pending);\n      expect(Result.isFailure(result)).toBe(true);\n      if (Result.isFailure(result)) expect(result.failure._tag).toBe(\"CalculatorOperationTimedOut\");\n      expect(yield* Ref.get(released)).toBe(true);\n    })\n  );\n});\nimport * as Effect from \"effect/Effect\";\nimport * as Option from \"effect/Option\";\nimport { SingleShotGen } from \"effect/Utils\";\nimport * as CoreBinding from \"../../Binding.ts\";\nimport { ProviderModePolicy } from \"../../ProviderMode.ts\";\nimport { taggedFunction } from \"../../Util/effect.ts\";\nimport type { WorkerBinding } from \"./WorkerBinding.ts\";\n\n/**\n * A Cloudflare **Worker-only binding** — the plain data value produced by\n * calling a {@link Service} (e.g. `Cloudflare.Images.Images(name)`).\n *\n * These bindings (`Browser`, `Images`, `VersionMetadata`, `RateLimit`,\n * `Artifacts.Namespace`, …) have **no backing cloud resource**; they are only\n * configuration on a Worker's script metadata. A binding value is therefore\n * both:\n *\n * - **declarable on a Worker's `env`** — `InferEnv` maps the per-binding type to\n *   its native runtime type, and {@link bindWorkerAsyncBindings} emits its wire\n *   spec via {@link toWorkerBinding}, and\n * - **`yield*`-able inside an Effect-native Worker** — its iterator attaches the\n *   binding to the surrounding Worker and resolves to the runtime client.\n */\nexport interface Binding<\n  Kind extends string = string,\n  Client = unknown,\n  Service = unknown,\n> {\n  readonly kind: Kind;\n  /** Binding name; the object key when declared on `env`. */\n  readonly name: string;\n  /**\n   * Alchemy-internal: opt this binding out of local emulation in\n   * `alchemy dev` — the `Alchemy.remote()` decoration captured by\n   * {@link pipe} on capabilities with a local simulator (Browser, Images,\n   * Stream). Registered on the host Worker via the binding-data `devRemote`\n   * channel, never on the wire binding itself.\n   */\n  readonly devRemote?: boolean;\n  /** Attach the binding to the surrounding Worker and resolve to the client. */\n  asEffect(): Effect.Effect<Client, never, Service>;\n  [Symbol.iterator](): Generator<Effect.Effect<Client, never, Service>, Client>;\n  /** Wire metadata emitted into the Worker script's `metadata.bindings`. */\n  toWorkerBinding(): WorkerBinding;\n  /**\n   * Lift the binding into an Effect ({@link BindingEffect}) so registration\n   * aspects can decorate it — most notably `Alchemy.remote()`, which opts\n   * the binding out of local emulation in `alchemy dev`:\n   *\n   * ```ts\n   * // Effect-native Worker — resolves to the runtime client:\n   * const browser = yield* Cloudflare.Browser(\"BROWSER\").pipe(Alchemy.remote());\n   *\n   * // async Worker env — declares the decorated binding:\n   * env: { IMAGES: Cloudflare.Images.Images(\"IMAGES\").pipe(Alchemy.remote()) }\n   * ```\n   */\n  pipe(): BindingEffect<this>;\n  pipe<A>(ab: (self: BindingEffect<this>) => A): A;\n  pipe<A, B>(ab: (self: BindingEffect<this>) => A, bc: (a: A) => B): B;\n  pipe<A, B, C>(\n    ab: (self: BindingEffect<this>) => A,\n    bc: (a: A) => B,\n    cd: (b: B) => C,\n  ): C;\n}\n\n/**\n * A Worker-only {@link Binding} lifted into an Effect by {@link Binding.pipe},\n * with the ambient {@link ProviderModePolicy} (`Alchemy.remote()`) captured\n * when it runs.\n *\n * Context-adaptive resolution: inside an Effect-native Worker (where the\n * binding's implementation layer is provided) it registers the binding on the\n * host and resolves to the runtime `Client` — same one-`yield*` shape as the\n * bare binding value. Anywhere else (an async Worker's `env`, resolved by the\n * engine) it resolves to the decorated binding *value*; the\n * `\"~alchemy/Binding\"` brand lets `InferEnv` map it to the native runtime\n * type.\n */\nimport { CalculatorAdmission } from \"@taxkit/calculators/admission.service\";\nimport {\n  CalculatorAdmissionUnavailable,\n  CalculatorRateLimited,\n} from \"@taxkit/calculators/schemas\";\nimport { RateLimit, RateLimitBinding } from \"alchemy/Cloudflare/Workers\";\nimport { CurrentRuntimeContext, RuntimeContext } from \"alchemy/RuntimeContext\";\nimport { Config, Effect, Layer, Redacted, Schema } from \"effect\";\nimport { NetAddress } from \"effect/net\";\n\nexport const CalculatorRateNamespace = Schema.String.check(\n  Schema.isPattern(/^[1-9]\\d*$/u)\n).pipe(Schema.brand(\"api/CalculatorRateNamespace\"));\n\n// Config is captured by Alchemy's native planning/runtime bridge. The operator\n// owns its account-wide unique stage value; no Production value is invented.\nexport const ApiCalculatorAdmissionLive = Layer.effect(\n  CalculatorAdmission,\n  Effect.gen(function* () {\n    const namespace = yield* Config.schema(\n      CalculatorRateNamespace,\n      \"CALCULATOR_RATE_NAMESPACE\"\n    );\n    const limiter = yield* RateLimit(\"CALCULATOR_RATE_LIMIT\", {\n      namespaceId: namespace,\n      simple: { limit: 60, period: 60 },\n    });\n    const runtime = yield* CurrentRuntimeContext;\n    if (runtime === undefined) {\n      return CalculatorAdmission.of({\n        admitCalculation: () => Effect.fail(new CalculatorAdmissionUnavailable()),\n      });\n    }\n    return CalculatorAdmission.of({\n      admitCalculation: Effect.fn(\"CalculatorAdmission.admitCalculation\")(\n        (key) =>\n          Effect.suspend(() => limiter\n            .limit({ key: NetAddress.formatIp(Redacted.value(key)) }))\n            .pipe(\n              Effect.provideService(RuntimeContext, runtime),\n              Effect.flatMap(\n                Schema.decodeUnknownEffect(Schema.Struct({ success: Schema.Boolean }))\n              ),\n              Effect.mapError(() => new CalculatorAdmissionUnavailable()),\n              Effect.catchDefect(() => Effect.fail(new CalculatorAdmissionUnavailable())),\n              Effect.flatMap((reply) =>\n                reply.success\n                  ? Effect.void\n                  : Effect.fail(new CalculatorRateLimited())\n              )\n            )\n      ),\n    });\n  })\n).pipe(Layer.provide(RateLimitBinding));\n","stderr":"","aggregated_output":"23:export * from \"./RateLimit.ts\";\n24:export * from \"./RateLimitBinding.ts\";\nimport { describe, expect, it } from \"@effect/vitest\";\nimport { CalculationEngineLive } from \"@taxkit/core\";\nimport { Cents, Money } from \"@taxkit/core/primitives\";\nimport { AuPayCalculatorId, GrossPay } from \"@taxkit/rules-au-pay\";\nimport { Deferred, Effect, Fiber, Layer, Option, Ref, Result, Schema } from \"effect\";\nimport { TestClock } from \"effect/testing\";\n\nimport { PublicCalculatorServiceRateLimited } from \"../src/admission.layer.js\";\nimport { CalculatorClientRateKey } from \"../src/admission.schemas.js\";\nimport { CalculatorAdmission, CalculatorRequestRateKey } from \"../src/admission.service.js\";\nimport { PublicCalculatorServiceLive } from \"../src/live.layer.js\";\nimport { CalculatorAdmissionUnavailable, CalculatorRateLimited, CalculatorRunServiceRequest, MetadataQuery } from \"../src/schemas.js\";\nimport { PublicCalculatorService } from \"../src/service.js\";\nimport { PublicCalculatorServiceBounded } from \"../src/work.layer.js\";\n\nconst request = CalculatorRunServiceRequest.make({\n  calculatorId: AuPayCalculatorId.make(\"au.pay.take-home\"),\n  payload: {\n    facts: {\n      grossPay: new GrossPay({ amount: new Money({ cents: Cents.make(165_400), currency: \"AUD\" }), period: \"weekly\" }),\n      taxFreeThresholdClaimed: true,\n    },\n  },\n});\n\nconst calculators = PublicCalculatorServiceRateLimited.pipe(\n  Layer.provide(PublicCalculatorServiceLive),\n  Layer.provide(CalculationEngineLive)\n);\n\ndescribe(\"anonymous calculation admission\", () => {\n  it.effect(\"canonicalises IPv6 and prevents ordinary key serialisation\", () =>\n    Effect.gen(function* () {\n      const first = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\"2001:db8::75\");\n      const second = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\"2001:0db8:0000:0000:0000:0000:0000:0075\");\n      expect(first).toEqual(second);\n      expect(String(first)).not.toContain(\"2001:\");\n      expect(Result.isFailure(yield* Schema.encodeEffect(CalculatorClientRateKey)(first).pipe(Effect.result))).toBe(true);\n      yield* Effect.forEach([\"\", \"999.0.0.1\", \"203.0.113.1, 203.0.113.2\", \"private-canary\"], (invalid) =>\n        Schema.decodeUnknownEffect(CalculatorClientRateKey)(invalid).pipe(\n          Effect.result,\n          Effect.tap((result) => Effect.sync(() => expect(Result.isFailure(result)).toBe(true)))\n        )\n      );\n    })\n  );\n\n  it.effect(\"missing identity rejects calculation while metadata consumes no unit\", () =>\n    Effect.gen(function* () {\n      const calls = yield* Ref.make(0);\n      const service = yield* PublicCalculatorService.pipe(\n        Effect.provide(calculators.pipe(Layer.provide(Layer.succeed(CalculatorAdmission, CalculatorAdmission.of({\n          admitCalculation: () => Ref.update(calls, (count) => count + 1),\n        })))))\n      );\n      const result = yield* service.calculate(request).pipe(Effect.result);\n      expect(result).toEqual(Result.fail(new CalculatorAdmissionUnavailable()));\n      expect((yield* service.listCalculators(MetadataQuery.make({}))).calculators.length).toBe(3);\n      expect(yield* Ref.get(calls)).toBe(0);\n    })\n  );\n\n  it.effect(\"rejected admission does no calculation work and carries fixed safe guidance\", () =>\n    Effect.gen(function* () {\n      const live = yield* PublicCalculatorService;\n      const worked = yield* Ref.make(0);\n      const key = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\"203.0.113.75\");\n      const service = yield* PublicCalculatorService.pipe(Effect.provide(\n        PublicCalculatorServiceRateLimited.pipe(\n          Layer.provide(Layer.succeed(PublicCalculatorService, PublicCalculatorService.of({\n            ...live,\n            calculate: () => Ref.update(worked, (count) => count + 1).pipe(Effect.andThen(Effect.never)),\n          }))),\n          Layer.provide(Layer.succeed(CalculatorAdmission, CalculatorAdmission.of({\n            admitCalculation: () => Effect.fail(new CalculatorRateLimited()),\n          })))\n        )\n      ));\n      const result = yield* service.calculate(request).pipe(Effect.provideService(CalculatorRequestRateKey, Option.some(key)), Effect.result);\n      expect(result).toEqual(Result.fail(new CalculatorRateLimited()));\n      expect(yield* Ref.get(worked)).toBe(0);\n      const encoded = yield* Schema.encodeEffect(Schema.fromJsonString(CalculatorRateLimited))(new CalculatorRateLimited());\n      expect(encoded).not.toContain(\"203.0.113.75\");\n      expect(encoded).not.toContain(\"165400\");\n    }).pipe(Effect.provide(PublicCalculatorServiceLive.pipe(Layer.provide(CalculationEngineLive))))\n  );\n\n  it.effect(\"the five-second work budget includes stalled admission and its cleanup\", () =>\n    Effect.gen(function* () {\n      const started = yield* Deferred.make<void>();\n      const released = yield* Ref.make(false);\n      const key = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\"203.0.113.75\");\n      const service = yield* PublicCalculatorService.pipe(Effect.provide(\n        PublicCalculatorServiceBounded.pipe(Layer.provide(calculators), Layer.provide(Layer.succeed(CalculatorAdmission, CalculatorAdmission.of({\n          admitCalculation: () => Deferred.succeed(started, undefined).pipe(\n            Effect.andThen(Effect.never),\n            Effect.ensuring(Ref.set(released, true))\n          ),\n        }))))\n      ));\n      const pending = yield* service.calculate(request).pipe(Effect.provideService(CalculatorRequestRateKey, Option.some(key)), Effect.result, Effect.forkChild);\n      yield* Deferred.await(started);\n      yield* TestClock.adjust(\"5 seconds\");\n      const result = yield* Fiber.join(pending);\n      expect(Result.isFailure(result)).toBe(true);\n      if (Result.isFailure(result)) expect(result.failure._tag).toBe(\"CalculatorOperationTimedOut\");\n      expect(yield* Ref.get(released)).toBe(true);\n    })\n  );\n});\nimport * as Effect from \"effect/Effect\";\nimport * as Option from \"effect/Option\";\nimport { SingleShotGen } from \"effect/Utils\";\nimport * as CoreBinding from \"../../Binding.ts\";\nimport { ProviderModePolicy } from \"../../ProviderMode.ts\";\nimport { taggedFunction } from \"../../Util/effect.ts\";\nimport type { WorkerBinding } from \"./WorkerBinding.ts\";\n\n/**\n * A Cloudflare **Worker-only binding** — the plain data value produced by\n * calling a {@link Service} (e.g. `Cloudflare.Images.Images(name)`).\n *\n * These bindings (`Browser`, `Images`, `VersionMetadata`, `RateLimit`,\n * `Artifacts.Namespace`, …) have **no backing cloud resource**; they are only\n * configuration on a Worker's script metadata. A binding value is therefore\n * both:\n *\n * - **declarable on a Worker's `env`** — `InferEnv` maps the per-binding type to\n *   its native runtime type, and {@link bindWorkerAsyncBindings} emits its wire\n *   spec via {@link toWorkerBinding}, and\n * - **`yield*`-able inside an Effect-native Worker** — its iterator attaches the\n *   binding to the surrounding Worker and resolves to the runtime client.\n */\nexport interface Binding<\n  Kind extends string = string,\n  Client = unknown,\n  Service = unknown,\n> {\n  readonly kind: Kind;\n  /** Binding name; the object key when declared on `env`. */\n  readonly name: string;\n  /**\n   * Alchemy-internal: opt this binding out of local emulation in\n   * `alchemy dev` — the `Alchemy.remote()` decoration captured by\n   * {@link pipe} on capabilities with a local simulator (Browser, Images,\n   * Stream). Registered on the host Worker via the binding-data `devRemote`\n   * channel, never on the wire binding itself.\n   */\n  readonly devRemote?: boolean;\n  /** Attach the binding to the surrounding Worker and resolve to the client. */\n  asEffect(): Effect.Effect<Client, never, Service>;\n  [Symbol.iterator](): Generator<Effect.Effect<Client, never, Service>, Client>;\n  /** Wire metadata emitted into the Worker script's `metadata.bindings`. */\n  toWorkerBinding(): WorkerBinding;\n  /**\n   * Lift the binding into an Effect ({@link BindingEffect}) so registration\n   * aspects can decorate it — most notably `Alchemy.remote()`, which opts\n   * the binding out of local emulation in `alchemy dev`:\n   *\n   * ```ts\n   * // Effect-native Worker — resolves to the runtime client:\n   * const browser = yield* Cloudflare.Browser(\"BROWSER\").pipe(Alchemy.remote());\n   *\n   * // async Worker env — declares the decorated binding:\n   * env: { IMAGES: Cloudflare.Images.Images(\"IMAGES\").pipe(Alchemy.remote()) }\n   * ```\n   */\n  pipe(): BindingEffect<this>;\n  pipe<A>(ab: (self: BindingEffect<this>) => A): A;\n  pipe<A, B>(ab: (self: BindingEffect<this>) => A, bc: (a: A) => B): B;\n  pipe<A, B, C>(\n    ab: (self: BindingEffect<this>) => A,\n    bc: (a: A) => B,\n    cd: (b: B) => C,\n  ): C;\n}\n\n/**\n * A Worker-only {@link Binding} lifted into an Effect by {@link Binding.pipe},\n * with the ambient {@link ProviderModePolicy} (`Alchemy.remote()`) captured\n * when it runs.\n *\n * Context-adaptive resolution: inside an Effect-native Worker (where the\n * binding's implementation layer is provided) it registers the binding on the\n * host and resolves to the runtime `Client` — same one-`yield*` shape as the\n * bare binding value. Anywhere else (an async Worker's `env`, resolved by the\n * engine) it resolves to the decorated binding *value*; the\n * `\"~alchemy/Binding\"` brand lets `InferEnv` map it to the native runtime\n * type.\n */\nimport { CalculatorAdmission } from \"@taxkit/calculators/admission.service\";\nimport {\n  CalculatorAdmissionUnavailable,\n  CalculatorRateLimited,\n} from \"@taxkit/calculators/schemas\";\nimport { RateLimit, RateLimitBinding } from \"alchemy/Cloudflare/Workers\";\nimport { CurrentRuntimeContext, RuntimeContext } from \"alchemy/RuntimeContext\";\nimport { Config, Effect, Layer, Redacted, Schema } from \"effect\";\nimport { NetAddress } from \"effect/net\";\n\nexport const CalculatorRateNamespace = Schema.String.check(\n  Schema.isPattern(/^[1-9]\\d*$/u)\n).pipe(Schema.brand(\"api/CalculatorRateNamespace\"));\n\n// Config is captured by Alchemy's native planning/runtime bridge. The operator\n// owns its account-wide unique stage value; no Production value is invented.\nexport const ApiCalculatorAdmissionLive = Layer.effect(\n  CalculatorAdmission,\n  Effect.gen(function* () {\n    const namespace = yield* Config.schema(\n      CalculatorRateNamespace,\n      \"CALCULATOR_RATE_NAMESPACE\"\n    );\n    const limiter = yield* RateLimit(\"CALCULATOR_RATE_LIMIT\", {\n      namespaceId: namespace,\n      simple: { limit: 60, period: 60 },\n    });\n    const runtime = yield* CurrentRuntimeContext;\n    if (runtime === undefined) {\n      return CalculatorAdmission.of({\n        admitCalculation: () => Effect.fail(new CalculatorAdmissionUnavailable()),\n      });\n    }\n    return CalculatorAdmission.of({\n      admitCalculation: Effect.fn(\"CalculatorAdmission.admitCalculation\")(\n        (key) =>\n          Effect.suspend(() => limiter\n            .limit({ key: NetAddress.formatIp(Redacted.value(key)) }))\n            .pipe(\n              Effect.provideService(RuntimeContext, runtime),\n              Effect.flatMap(\n                Schema.decodeUnknownEffect(Schema.Struct({ success: Schema.Boolean }))\n              ),\n              Effect.mapError(() => new CalculatorAdmissionUnavailable()),\n              Effect.catchDefect(() => Effect.fail(new CalculatorAdmissionUnavailable())),\n              Effect.flatMap((reply) =>\n                reply.success\n                  ? Effect.void\n                  : Effect.fail(new CalculatorRateLimited())\n              )\n            )\n      ),\n    });\n  })\n).pipe(Layer.provide(RateLimitBinding));\n","exit_code":0,"duration":{"secs":0,"nanos":6625},"formatted_output":"23:export * from \"./RateLimit.ts\";\n24:export * from \"./RateLimitBinding.ts\";\nimport { describe, expect, it } from \"@effect/vitest\";\nimport { CalculationEngineLive } from \"@taxkit/core\";\nimport { Cents, Money } from \"@taxkit/core/primitives\";\nimport { AuPayCalculatorId, GrossPay } from \"@taxkit/rules-au-pay\";\nimport { Deferred, Effect, Fiber, Layer, Option, Ref, Result, Schema } from \"effect\";\nimport { TestClock } from \"effect/testing\";\n\nimport { PublicCalculatorServiceRateLimited } from \"../src/admission.layer.js\";\nimport { CalculatorClientRateKey } from \"../src/admission.schemas.js\";\nimport { CalculatorAdmission, CalculatorRequestRateKey } from \"../src/admission.service.js\";\nimport { PublicCalculatorServiceLive } from \"../src/live.layer.js\";\nimport { CalculatorAdmissionUnavailable, CalculatorRateLimited, CalculatorRunServiceRequest, MetadataQuery } from \"../src/schemas.js\";\nimport { PublicCalculatorService } from \"../src/service.js\";\nimport { PublicCalculatorServiceBounded } from \"../src/work.layer.js\";\n\nconst request = CalculatorRunServiceRequest.make({\n  calculatorId: AuPayCalculatorId.make(\"au.pay.take-home\"),\n  payload: {\n    facts: {\n      grossPay: new GrossPay({ amount: new Money({ cents: Cents.make(165_400), currency: \"AUD\" }), period: \"weekly\" }),\n      taxFreeThresholdClaimed: true,\n    },\n  },\n});\n\nconst calculators = PublicCalculatorServiceRateLimited.pipe(\n  Layer.provide(PublicCalculatorServiceLive),\n  Layer.provide(CalculationEngineLive)\n);\n\ndescribe(\"anonymous calculation admission\", () => {\n  it.effect(\"canonicalises IPv6 and prevents ordinary key serialisation\", () =>\n    Effect.gen(function* () {\n      const first = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\"2001:db8::75\");\n      const second = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\"2001:0db8:0000:0000:0000:0000:0000:0075\");\n      expect(first).toEqual(second);\n      expect(String(first)).not.toContain(\"2001:\");\n      expect(Result.isFailure(yield* Schema.encodeEffect(CalculatorClientRateKey)(first).pipe(Effect.result))).toBe(true);\n      yield* Effect.forEach([\"\", \"999.0.0.1\", \"203.0.113.1, 203.0.113.2\", \"private-canary\"], (invalid) =>\n        Schema.decodeUnknownEffect(CalculatorClientRateKey)(invalid).pipe(\n          Effect.result,\n          Effect.tap((result) => Effect.sync(() => expect(Result.isFailure(result)).toBe(true)))\n        )\n      );\n    })\n  );\n\n  it.effect(\"missing identity rejects calculation while metadata consumes no unit\", () =>\n    Effect.gen(function* () {\n      const calls = yield* Ref.make(0);\n      const service = yield* PublicCalculatorService.pipe(\n        Effect.provide(calculators.pipe(Layer.provide(Layer.succeed(CalculatorAdmission, CalculatorAdmission.of({\n          admitCalculation: () => Ref.update(calls, (count) => count + 1),\n        })))))\n      );\n      const result = yield* service.calculate(request).pipe(Effect.result);\n      expect(result).toEqual(Result.fail(new CalculatorAdmissionUnavailable()));\n      expect((yield* service.listCalculators(MetadataQuery.make({}))).calculators.length).toBe(3);\n      expect(yield* Ref.get(calls)).toBe(0);\n    })\n  );\n\n  it.effect(\"rejected admission does no calculation work and carries fixed safe guidance\", () =>\n    Effect.gen(function* () {\n      const live = yield* PublicCalculatorService;\n      const worked = yield* Ref.make(0);\n      const key = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\"203.0.113.75\");\n      const service = yield* PublicCalculatorService.pipe(Effect.provide(\n        PublicCalculatorServiceRateLimited.pipe(\n          Layer.provide(Layer.succeed(PublicCalculatorService, PublicCalculatorService.of({\n            ...live,\n            calculate: () => Ref.update(worked, (count) => count + 1).pipe(Effect.andThen(Effect.never)),\n          }))),\n          Layer.provide(Layer.succeed(CalculatorAdmission, CalculatorAdmission.of({\n            admitCalculation: () => Effect.fail(new CalculatorRateLimited()),\n          })))\n        )\n      ));\n      const result = yield* service.calculate(request).pipe(Effect.provideService(CalculatorRequestRateKey, Option.some(key)), Effect.result);\n      expect(result).toEqual(Result.fail(new CalculatorRateLimited()));\n      expect(yield* Ref.get(worked)).toBe(0);\n      const encoded = yield* Schema.encodeEffect(Schema.fromJsonString(CalculatorRateLimited))(new CalculatorRateLimited());\n      expect(encoded).not.toContain(\"203.0.113.75\");\n      expect(encoded).not.toContain(\"165400\");\n    }).pipe(Effect.provide(PublicCalculatorServiceLive.pipe(Layer.provide(CalculationEngineLive))))\n  );\n\n  it.effect(\"the five-second work budget includes stalled admission and its cleanup\", () =>\n    Effect.gen(function* () {\n      const started = yield* Deferred.make<void>();\n      const released = yield* Ref.make(false);\n      const key = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\"203.0.113.75\");\n      const service = yield* PublicCalculatorService.pipe(Effect.provide(\n        PublicCalculatorServiceBounded.pipe(Layer.provide(calculators), Layer.provide(Layer.succeed(CalculatorAdmission, CalculatorAdmission.of({\n          admitCalculation: () => Deferred.succeed(started, undefined).pipe(\n            Effect.andThen(Effect.never),\n            Effect.ensuring(Ref.set(released, true))\n          ),\n        }))))\n      ));\n      const pending = yield* service.calculate(request).pipe(Effect.provideService(CalculatorRequestRateKey, Option.some(key)), Effect.result, Effect.forkChild);\n      yield* Deferred.await(started);\n      yield* TestClock.adjust(\"5 seconds\");\n      const result = yield* Fiber.join(pending);\n      expect(Result.isFailure(result)).toBe(true);\n      if (Result.isFailure(result)) expect(result.failure._tag).toBe(\"CalculatorOperationTimedOut\");\n      expect(yield* Ref.get(released)).toBe(true);\n    })\n  );\n});\nimport * as Effect from \"effect/Effect\";\nimport * as Option from \"effect/Option\";\nimport { SingleShotGen } from \"effect/Utils\";\nimport * as CoreBinding from \"../../Binding.ts\";\nimport { ProviderModePolicy } from \"../../ProviderMode.ts\";\nimport { taggedFunction } from \"../../Util/effect.ts\";\nimport type { WorkerBinding } from \"./WorkerBinding.ts\";\n\n/**\n * A Cloudflare **Worker-only binding** — the plain data value produced by\n * calling a {@link Service} (e.g. `Cloudflare.Images.Images(name)`).\n *\n * These bindings (`Browser`, `Images`, `VersionMetadata`, `RateLimit`,\n * `Artifacts.Namespace`, …) have **no backing cloud resource**; they are only\n * configuration on a Worker's script metadata. A binding value is therefore\n * both:\n *\n * - **declarable on a Worker's `env`** — `InferEnv` maps the per-binding type to\n *   its native runtime type, and {@link bindWorkerAsyncBindings} emits its wire\n *   spec via {@link toWorkerBinding}, and\n * - **`yield*`-able inside an Effect-native Worker** — its iterator attaches the\n *   binding to the surrounding Worker and resolves to the runtime client.\n */\nexport interface Binding<\n  Kind extends string = string,\n  Client = unknown,\n  Service = unknown,\n> {\n  readonly kind: Kind;\n  /** Binding name; the object key when declared on `env`. */\n  readonly name: string;\n  /**\n   * Alchemy-internal: opt this binding out of local emulation in\n   * `alchemy dev` — the `Alchemy.remote()` decoration captured by\n   * {@link pipe} on capabilities with a local simulator (Browser, Images,\n   * Stream). Registered on the host Worker via the binding-data `devRemote`\n   * channel, never on the wire binding itself.\n   */\n  readonly devRemote?: boolean;\n  /** Attach the binding to the surrounding Worker and resolve to the client. */\n  asEffect(): Effect.Effect<Client, never, Service>;\n  [Symbol.iterator](): Generator<Effect.Effect<Client, never, Service>, Client>;\n  /** Wire metadata emitted into the Worker script's `metadata.bindings`. */\n  toWorkerBinding(): WorkerBinding;\n  /**\n   * Lift the binding into an Effect ({@link BindingEffect}) so registration\n   * aspects can decorate it — most notably `Alchemy.remote()`, which opts\n   * the binding out of local emulation in `alchemy dev`:\n   *\n   * ```ts\n   * // Effect-native Worker — resolves to the runtime client:\n   * const browser = yield* Cloudflare.Browser(\"BROWSER\").pipe(Alchemy.remote());\n   *\n   * // async Worker env — declares the decorated binding:\n   * env: { IMAGES: Cloudflare.Images.Images(\"IMAGES\").pipe(Alchemy.remote()) }\n   * ```\n   */\n  pipe(): BindingEffect<this>;\n  pipe<A>(ab: (self: BindingEffect<this>) => A): A;\n  pipe<A, B>(ab: (self: BindingEffect<this>) => A, bc: (a: A) => B): B;\n  pipe<A, B, C>(\n    ab: (self: BindingEffect<this>) => A,\n    bc: (a: A) => B,\n    cd: (b: B) => C,\n  ): C;\n}\n\n/**\n * A Worker-only {@link Binding} lifted into an Effect by {@link Binding.pipe},\n * with the ambient {@link ProviderModePolicy} (`Alchemy.remote()`) captured\n * when it runs.\n *\n * Context-adaptive resolution: inside an Effect-native Worker (where the\n * binding's implementation layer is provided) it registers the binding on the\n * host and resolves to the runtime `Client` — same one-`yield*` shape as the\n * bare binding value. Anywhere else (an async Worker's `env`, resolved by the\n * engine) it resolves to the decorated binding *value*; the\n * `\"~alchemy/Binding\"` brand lets `InferEnv` map it to the native runtime\n * type.\n */\nimport { CalculatorAdmission } from \"@taxkit/calculators/admission.service\";\nimport {\n  CalculatorAdmissionUnavailable,\n  CalculatorRateLimited,\n} from \"@taxkit/calculators/schemas\";\nimport { RateLimit, RateLimitBinding } from \"alchemy/Cloudflare/Workers\";\nimport { CurrentRuntimeContext, RuntimeContext } from \"alchemy/RuntimeContext\";\nimport { Config, Effect, Layer, Redacted, Schema } from \"effect\";\nimport { NetAddress } from \"effect/net\";\n\nexport const CalculatorRateNamespace = Schema.String.check(\n  Schema.isPattern(/^[1-9]\\d*$/u)\n).pipe(Schema.brand(\"api/CalculatorRateNamespace\"));\n\n// Config is captured by Alchemy's native planning/runtime bridge. The operator\n// owns its account-wide unique stage value; no Production value is invented.\nexport const ApiCalculatorAdmissionLive = Layer.effect(\n  CalculatorAdmission,\n  Effect.gen(function* () {\n    const namespace = yield* Config.schema(\n      CalculatorRateNamespace,\n      \"CALCULATOR_RATE_NAMESPACE\"\n    );\n    const limiter = yield* RateLimit(\"CALCULATOR_RATE_LIMIT\", {\n      namespaceId: namespace,\n      simple: { limit: 60, period: 60 },\n    });\n    const runtime = yield* CurrentRuntimeContext;\n    if (runtime === undefined) {\n      return CalculatorAdmission.of({\n        admitCalculation: () => Effect.fail(new CalculatorAdmissionUnavailable()),\n      });\n    }\n    return CalculatorAdmission.of({\n      admitCalculation: Effect.fn(\"CalculatorAdmission.admitCalculation\")(\n        (key) =>\n          Effect.suspend(() => limiter\n            .limit({ key: NetAddress.formatIp(Redacted.value(key)) }))\n            .pipe(\n              Effect.provideService(RuntimeContext, runtime),\n              Effect.flatMap(\n                Schema.decodeUnknownEffect(Schema.Struct({ success: Schema.Boolean }))\n              ),\n              Effect.mapError(() => new CalculatorAdmissionUnavailable()),\n              Effect.catchDefect(() => Effect.fail(new CalculatorAdmissionUnavailable())),\n              Effect.flatMap((reply) =>\n                reply.success\n                  ? Effect.void\n                  : Effect.fail(new CalculatorRateLimited())\n              )\n            )\n      ),\n    });\n  })\n).pipe(Layer.provide(RateLimitBinding));\n"},"started_at_ms":1791267040139,"completed_at_ms":1791267040139}}
{"timestamp":"2026-10-06T06:10:40.189Z","ordinal":39558,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a10fd5-ebbd-7153-9346-890ed9a2bfe7","call_id":"call_Upg7onVirr2lqKKBDoFqUCcq","output":[{"type":"input_text","text":"Script completed\nWall time 1.3 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"10f5a0\",\"wall_time_seconds\":1.00205275,\"session_id\":25848,\"original_token_count\":0,\"output\":\"\"}"},{"type":"input_text","text":"{\"chunk_id\":\"af8ea5\",\"wall_time_seconds\":0.000006625,\"exit_code\":0,\"original_token_count\":2894,\"output\":\"23:export * from \\\"./RateLimit.ts\\\";\\n24:export * from \\\"./RateLimitBinding.ts\\\";\\nimport { describe, expect, it } from \\\"@effect/vitest\\\";\\nimport { CalculationEngineLive } from \\\"@taxkit/core\\\";\\nimport { Cents, Money } from \\\"@taxkit/core/primitives\\\";\\nimport { AuPayCalculatorId, GrossPay } from \\\"@taxkit/rules-au-pay\\\";\\nimport { Deferred, Effect, Fiber, Layer, Option, Ref, Result, Schema } from \\\"effect\\\";\\nimport { TestClock } from \\\"effect/testing\\\";\\n\\nimport { PublicCalculatorServiceRateLimited } from \\\"../src/admission.layer.js\\\";\\nimport { CalculatorClientRateKey } from \\\"../src/admission.schemas.js\\\";\\nimport { CalculatorAdmission, CalculatorRequestRateKey } from \\\"../src/admission.service.js\\\";\\nimport { PublicCalculatorServiceLive } from \\\"../src/live.layer.js\\\";\\nimport { CalculatorAdmissionUnavailable, CalculatorRateLimited, CalculatorRunServiceRequest, MetadataQuery } from \\\"../src/schemas.js\\\";\\nimport { PublicCalculatorService } from \\\"../src/service.js\\\";\\nimport { PublicCalculatorServiceBounded } from \\\"../src/work.layer.js\\\";\\n\\nconst request = CalculatorRunServiceRequest.make({\\n  calculatorId: AuPayCalculatorId.make(\\\"au.pay.take-home\\\"),\\n  payload: {\\n    facts: {\\n      grossPay: new GrossPay({ amount: new Money({ cents: Cents.make(165_400), currency: \\\"AUD\\\" }), period: \\\"weekly\\\" }),\\n      taxFreeThresholdClaimed: true,\\n    },\\n  },\\n});\\n\\nconst calculators = PublicCalculatorServiceRateLimited.pipe(\\n  Layer.provide(PublicCalculatorServiceLive),\\n  Layer.provide(CalculationEngineLive)\\n);\\n\\ndescribe(\\\"anonymous calculation admission\\\", () => {\\n  it.effect(\\\"canonicalises IPv6 and prevents ordinary key serialisation\\\", () =>\\n    Effect.gen(function* () {\\n      const first = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\\\"2001:db8::75\\\");\\n      const second = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\\\"2001:0db8:0000:0000:0000:0000:0000:0075\\\");\\n      expect(first).toEqual(second);\\n      expect(String(first)).not.toContain(\\\"2001:\\\");\\n      expect(Result.isFailure(yield* Schema.encodeEffect(CalculatorClientRateKey)(first).pipe(Effect.result))).toBe(true);\\n      yield* Effect.forEach([\\\"\\\", \\\"999.0.0.1\\\", \\\"203.0.113.1, 203.0.113.2\\\", \\\"private-canary\\\"], (invalid) =>\\n        Schema.decodeUnknownEffect(CalculatorClientRateKey)(invalid).pipe(\\n          Effect.result,\\n          Effect.tap((result) => Effect.sync(() => expect(Result.isFailure(result)).toBe(true)))\\n        )\\n      );\\n    })\\n  );\\n\\n  it.effect(\\\"missing identity rejects calculation while metadata consumes no unit\\\", () =>\\n    Effect.gen(function* () {\\n      const calls = yield* Ref.make(0);\\n      const service = yield* PublicCalculatorService.pipe(\\n        Effect.provide(calculators.pipe(Layer.provide(Layer.succeed(CalculatorAdmission, CalculatorAdmission.of({\\n          admitCalculation: () => Ref.update(calls, (count) => count + 1),\\n        })))))\\n      );\\n      const result = yield* service.calculate(request).pipe(Effect.result);\\n      expect(result).toEqual(Result.fail(new CalculatorAdmissionUnavailable()));\\n      expect((yield* service.listCalculators(MetadataQuery.make({}))).calculators.length).toBe(3);\\n      expect(yield* Ref.get(calls)).toBe(0);\\n    })\\n  );\\n\\n  it.effect(\\\"rejected admission does no calculation work and carries fixed safe guidance\\\", () =>\\n    Effect.gen(function* () {\\n      const live = yield* PublicCalculatorService;\\n      const worked = yield* Ref.make(0);\\n      const key = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\\\"203.0.113.75\\\");\\n      const service = yield* PublicCalculatorService.pipe(Effect.provide(\\n        PublicCalculatorServiceRateLimited.pipe(\\n          Layer.provide(Layer.succeed(PublicCalculatorService, PublicCalculatorService.of({\\n            ...live,\\n            calculate: () => Ref.update(worked, (count) => count + 1).pipe(Effect.andThen(Effect.never)),\\n          }))),\\n          Layer.provide(Layer.succeed(CalculatorAdmission, CalculatorAdmission.of({\\n            admitCalculation: () => Effect.fail(new CalculatorRateLimited()),\\n          })))\\n        )\\n      ));\\n      const result = yield* service.calculate(request).pipe(Effect.provideService(CalculatorRequestRateKey, Option.some(key)), Effect.result);\\n      expect(result).toEqual(Result.fail(new CalculatorRateLimited()));\\n      expect(yield* Ref.get(worked)).toBe(0);\\n      const encoded = yield* Schema.encodeEffect(Schema.fromJsonString(CalculatorRateLimited))(new CalculatorRateLimited());\\n      expect(encoded).not.toContain(\\\"203.0.113.75\\\");\\n      expect(encoded).not.toContain(\\\"165400\\\");\\n    }).pipe(Effect.provide(PublicCalculatorServiceLive.pipe(Layer.provide(CalculationEngineLive))))\\n  );\\n\\n  it.effect(\\\"the five-second work budget includes stalled admission and its cleanup\\\", () =>\\n    Effect.gen(function* () {\\n      const started = yield* Deferred.make<void>();\\n      const released = yield* Ref.make(false);\\n      const key = yield* Schema.decodeUnknownEffect(CalculatorClientRateKey)(\\\"203.0.113.75\\\");\\n      const service = yield* PublicCalculatorService.pipe(Effect.provide(\\n        PublicCalculatorServiceBounded.pipe(Layer.provide(calculators), Layer.provide(Layer.succeed(CalculatorAdmission, CalculatorAdmission.of({\\n          admitCalculation: () => Deferred.succeed(started, undefined).pipe(\\n            Effect.andThen(Effect.never),\\n            Effect.ensuring(Ref.set(released, true))\\n          ),\\n        }))))\\n      ));\\n      const pending = yield* service.calculate(request).pipe(Effect.provideService(CalculatorRequestRateKey, Option.some(key)), Effect.result, Effect.forkChild);\\n      yield* Deferred.await(started);\\n      yield* TestClock.adjust(\\\"5 seconds\\\");\\n      const result = yield* Fiber.join(pending);\\n      expect(Result.isFailure(result)).toBe(true);\\n      if (Result.isFailure(result)) expect(result.failure._tag).toBe(\\\"CalculatorOperationTimedOut\\\");\\n      expect(yield* Ref.get(released)).toBe(true);\\n    })\\n  );\\n});\\nimport * as Effect from \\\"effect/Effect\\\";\\nimport * as Option from \\\"effect/Option\\\";\\nimport { SingleShotGen } from \\\"effect/Utils\\\";\\nimport * as CoreBinding from \\\"../../Binding.ts\\\";\\nimport { ProviderModePolicy } from \\\"../../ProviderMode.ts\\\";\\nimport { taggedFunction } from \\\"../../Util/effect.ts\\\";\\nimport type { WorkerBinding } from \\\"./WorkerBinding.ts\\\";\\n\\n/**\\n * A Cloudflare **Worker-only binding** — the plain data value produced by\\n * calling a {@link Service} (e.g. `Cloudflare.Images.Images(name)`).\\n *\\n * These bindings (`Browser`, `Images`, `VersionMetadata`, `RateLimit`,\\n * `Artifacts.Namespace`, …) have **no backing cloud resource**; they are only\\n * configuration on a Worker's script metadata. A binding value is therefore\\n * both:\\n *\\n * - **declarable on a Worker's `env`** — `InferEnv` maps the per-binding type to\\n *   its native runtime type, and {@link bindWorkerAsyncBindings} emits its wire\\n *   spec via {@link toWorkerBinding}, and\\n * - **`yield*`-able inside an Effect-native Worker** — its iterator attaches the\\n *   binding to the surrounding Worker and resolves to the runtime client.\\n */\\nexport interface Binding<\\n  Kind extends string = string,\\n  Client = unknown,\\n  Service = unknown,\\n> {\\n  readonly kind: Kind;\\n  /** Binding name; the object key when declared on `env`. */\\n  readonly name: string;\\n  /**\\n   * Alchemy-internal: opt this binding out of local emulation in\\n   * `alchemy dev` — the `Alchemy.remote()` decoration captured by\\n   * {@link pipe} on capabilities with a local simulator (Browser, Images,\\n   * Stream). Registered on the host Worker via the binding-data `devRemote`\\n   * channel, never on the wire binding itself.\\n   */\\n  readonly devRemote?: boolean;\\n  /** Attach the binding to the surrounding Worker and resolve to the client. */\\n  asEffect(): Effect.Effect<Client, never, Service>;\\n  [Symbol.iterator](): Generator<Effect.Effect<Client, never, Service>, Client>;\\n  /** Wire metadata emitted into the Worker script's `metadata.bindings`. */\\n  toWorkerBinding(): WorkerBinding;\\n  /**\\n   * Lift the binding into an Effect ({@link BindingEffect}) so registration\\n   * aspects can decorate it — most notably `Alchemy.remote()`, which opts\\n   * the binding out of local emulation in `alchemy dev`:\\n   *\\n   * ```ts\\n   * // Effect-native Worker — resolves to the runtime client:\\n   * const browser = yield* Cloudflare.Browser(\\\"BROWSER\\\").pipe(Alchemy.remote());\\n   *\\n   * // async Worker env — declares the decorated binding:\\n   * env: { IMAGES: Cloudflare.Images.Images(\\\"IMAGES\\\").pipe(Alchemy.remote()) }\\n   * ```\\n   */\\n  pipe(): BindingEffect<this>;\\n  pipe<A>(ab: (self: BindingEffect<this>) => A): A;\\n  pipe<A, B>(ab: (self: BindingEffect<this>) => A, bc: (a: A) => B): B;\\n  pipe<A, B, C>(\\n    ab: (self: BindingEffect<this>) => A,\\n    bc: (a: A) => B,\\n    cd: (b: B) => C,\\n  ): C;\\n}\\n\\n/**\\n * A Worker-only {@link Binding} lifted into an Effect by {@link Binding.pipe},\\n * with the ambient {@link ProviderModePolicy} (`Alchemy.remote()`) captured\\n * when it runs.\\n *\\n * Context-adaptive resolution: inside an Effect-native Worker (where the\\n * binding's implementation layer is provided) it registers the binding on the\\n * host and resolves to the runtime `Client` — same one-`yield*` shape as the\\n * bare binding value. Anywhere else (an async Worker's `env`, resolved by the\\n * engine) it resolves to the decorated binding *value*; the\\n * `\\\"~alchemy/Binding\\\"` brand lets `InferEnv` map it to the native runtime\\n * type.\\n */\\nimport { CalculatorAdmission } from \\\"@taxkit/calculators/admission.service\\\";\\nimport {\\n  CalculatorAdmissionUnavailable,\\n  CalculatorRateLimited,\\n} from \\\"@taxkit/calculators/schemas\\\";\\nimport { RateLimit, RateLimitBinding } from \\\"alchemy/Cloudflare/Workers\\\";\\nimport { CurrentRuntimeContext, RuntimeContext } from \\\"alchemy/RuntimeContext\\\";\\nimport { Config, Effect, Layer, Redacted, Schema } from \\\"effect\\\";\\nimport { NetAddress } from \\\"effect/net\\\";\\n\\nexport const CalculatorRateNamespace = Schema.String.check(\\n  Schema.isPattern(/^[1-9]\\\\d*$/u)\\n).pipe(Schema.brand(\\\"api/CalculatorRateNamespace\\\"));\\n\\n// Config is captured by Alchemy's native planning/runtime bridge. The operator\\n// owns its account-wide unique stage value; no Production value is invented.\\nexport const ApiCalculatorAdmissionLive = Layer.effect(\\n  CalculatorAdmission,\\n  Effect.gen(function* () {\\n    const namespace = yield* Config.schema(\\n      CalculatorRateNamespace,\\n      \\\"CALCULATOR_RATE_NAMESPACE\\\"\\n    );\\n    const limiter = yield* RateLimit(\\\"CALCULATOR_RATE_LIMIT\\\", {\\n      namespaceId: namespace,\\n      simple: { limit: 60, period: 60 },\\n    });\\n    const runtime = yield* CurrentRuntimeContext;\\n    if (runtime === undefined) {\\n      return CalculatorAdmission.of({\\n        admitCalculation: () => Effect.fail(new CalculatorAdmissionUnavailable()),\\n      });\\n    }\\n    return CalculatorAdmission.of({\\n      admitCalculation: Effect.fn(\\\"CalculatorAdmission.admitCalculation\\\")(\\n        (key) =>\\n          Effect.suspend(() => limiter\\n            .limit({ key: NetAddress.formatIp(Redacted.value(key)) }))\\n            .pipe(\\n              Effect.provideService(RuntimeContext, runtime),\\n              Effect.flatMap(\\n                Schema.decodeUnknownEffect(Schema.Struct({ success: Schema.Boolean }))\\n              ),\\n              Effect.mapError(() => new CalculatorAdmissionUnavailable()),\\n              Effect.catchDefect(() => Effect.fail(new CalculatorAdmissionUnavailable())),\\n              Effect.flatMap((reply) =>\\n                reply.success\\n                  ? Effect.void\\n                  : Effect.fail(new CalculatorRateLimited())\\n              )\\n            )\\n      ),\\n    });\\n  })\\n).pipe(Layer.provide(RateLimitBinding));\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10fab-f789-7f30-a7de-963ccee8ae9f","create_time":1791267040.189914}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
