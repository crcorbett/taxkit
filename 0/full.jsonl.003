        // JSON/FormData parser can reflect it in an unexpected error.\n          if (request.method !== \"GET\") {\n            return HttpServerResponse.empty({\n              headers: { allow: \"GET\" },\n              status: 405,\n            });\n          }\n          if (url.search !== \"\") {\n            return HttpServerResponse.empty({ status: 400 });\n          }\n        }\n        if (request.method === \"POST\" && calculatorId === null) {\n          return HttpServerResponse.empty({ status: 404 });\n        }\n        return yield* request.method !== \"POST\" || calculatorId === null\n          ? Effect.promise(() =>\n              Promise.resolve(render(request, { context: {} }))\n            ).pipe(Effect.map(HttpServerResponse.fromWeb))\n          : withCalculatorRequestBodyLimit(\n              Effect.gen(function* () {\n                const incoming = yield* HttpServerRequest.HttpServerRequest;\n                const bounded = yield* HttpServerRequest.toWeb(incoming, {\n                  signal: request.signal,\n                });\n                const data = yield* Effect.tryPromise({\n                  catch: () =>\n                    new WebsiteInputError({\n                      message: \"Enter a valid pay amount and pay period.\",\n                    }),\n                  try: () => bounded.formData(),\n                });\n                const decodedForm: Effect.Effect<\n                  WebsiteCalculatorForm,\n                  Schema.SchemaError\n                > =\n                  calculatorId === \"au.income-tax.annual\"\n                    ? Schema.decodeUnknownEffect(AnnualTaxForm)({\n                        taxableDollars: data.get(\"taxableDollars\"),\n                      })\n                    : Schema.decodeUnknownEffect(TakeHomeForm)({\n                        grossDollars: data.get(\"grossDollars\"),\n                        period: data.get(\"period\"),\n                        taxFreeThresholdClaimed:\n                          data.get(\"taxFreeThresholdClaimed\") === \"on\",\n                      });\n                const form = yield* decodedForm.pipe(\n                  Effect.mapError(\n                    () =>\n                      new WebsiteInputError({\n                        message: \"Enter a valid pay amount and pay period.\",\n                      })\n                  )\n                );\n                const result = yield* (\n                  Schema.is(AnnualTaxForm)(form)\n                    ? annualTaxRequestFromForm(form)\n                    : takeHomeRequestFromForm(\n                        form,\n                        AuPayCalculatorId.make(\n                          calculatorId === \"au.pay.withholdings\"\n                            ? \"au.pay.withholdings\"\n                            : \"au.pay.take-home\"\n                        )\n                      )\n                ).pipe(\n                  Effect.fromResult,\n                  Effect.flatMap((input) =>\n                    WebsiteServerApplication.pipe(\n                      Effect.flatMap((application) =>\n                        application.calculate(input)\n                      )\n                    )\n                  ),\n                  Effect.result\n                );\n                const submission = yield* Schema.encodeEffect(\n                  WebsiteSubmissionTransport\n                )(WebsiteSubmission.make({ calculatorId, form, result })).pipe(\n                  Effect.orDie\n                );\n                const headers = new Headers(request.headers);\n                headers.delete(\"content-length\");\n                headers.delete(\"content-type\");\n                const response = yield* Effect.promise(() =>\n                  Promise.resolve(\n                    render(\n                      new Request(request.url, {\n                        headers,\n                        method: \"GET\",\n                        signal: request.signal,\n                      }),\n                      { context: { submission } }\n                    )\n                  )\n                );\n                return HttpServerResponse.fromWeb(response);\n              }),\n              CalculatorRequestBodyPolicy.make({ responseFormat: \"html\" })\n            ).pipe(\n              Effect.catchTag(\"WebsiteInputError\", () =>\n                Effect.succeed(HttpServerResponse.empty({ status: 400 }))\n              )\n            );\n      }).pipe(\n        // Native HTTP failure matching preserves aborts and safe empty errors.\n        // The installed host reporter discards arbitrary Causes before logging.\n        Effect.catchCause((cause) =>\n          HttpServerError.causeResponse(cause).pipe(\n            Effect.flatMap(([response, reportable]) =>\n              ErrorReporter.report(reportable).pipe(Effect.as(response))\n            )\n          )\n        ),\n        Effect.provideService(\n          HttpServerRequest.HttpServerRequest,\n          HttpServerRequest.fromWeb(request)\n        ),\n        Effect.scoped,\n        Effect.map(HttpServerResponse.toWeb)\n      ),\n      { signal: request.signal }\n    ),\n};\nimport { describe, expect, it } from \"@effect/vitest\";\nimport { CalculationEngineLive } from \"@taxkit/core\";\nimport { Money, Cents } from \"@taxkit/core/primitives\";\nimport { AuPayCalculatorId, GrossPay } from \"@taxkit/rules-au-pay\";\nimport { expectAt } from \"@taxkit/testing\";\nimport {\n  Array,\n  Cause,\n  Clock,\n  Context,\n  Deferred,\n  Effect,\n  Exit,\n  Fiber,\n  Layer,\n  Match,\n  Option,\n  Ref,\n  Result,\n} from \"effect\";\nimport { TestClock } from \"effect/testing\";\n\nimport { PublicCalculatorServiceLive } from \"../src/live.layer.js\";\nimport {\n  CalculatorCapacityExceeded,\n  CalculatorOperationTimedOut,\n  CalculatorRunServiceRequest,\n  MetadataQuery,\n  DescriptorFilterQuery,\n  GetCalculatorRequest,\n  GetCalculatorGraphRequest,\n  UnsupportedCalculatorError,\n} from \"../src/schemas.js\";\nimport { PublicCalculatorService } from \"../src/service.js\";\nimport { PublicCalculatorServiceBounded } from \"../src/work.layer.js\";\n\nconst Request = CalculatorRunServiceRequest.make({\n  calculatorId: AuPayCalculatorId.make(\"au.pay.take-home\"),\n  payload: {\n    facts: {\n      grossPay: new GrossPay({\n        amount: new Money({ cents: Cents.make(165_400), currency: \"AUD\" }),\n        period: \"weekly\",\n      }),\n      taxFreeThresholdClaimed: true,\n    },\n  },\n});\nconst MetadataWorkCases = [\n  {\n    invoke: (service: PublicCalculatorService[\"Service\"]) =>\n      service\n        .getCalculator(\n          GetCalculatorRequest.make({ calculatorId: Request.calculatorId })\n        )\n        .pipe(Effect.asVoid),\n    operation: \"getCalculator\",\n    substitute: (\n      service: PublicCalculatorService[\"Service\"],\n      work: Effect.Effect<never>\n    ) => PublicCalculatorService.of({ ...service, getCalculator: () => work }),\n  },\n  {\n    invoke: (service: PublicCalculatorService[\"Service\"]) =>\n      service\n        .getCalculatorGraph(\n          GetCalculatorGraphRequest.make({ calculatorId: Request.calculatorId })\n        )\n        .pipe(Effect.asVoid),\n    operation: \"getCalculatorGraph\",\n    substitute: (\n      service: PublicCalculatorService[\"Service\"],\n      work: Effect.Effect<never>\n    ) =>\n      PublicCalculatorService.of({\n        ...service,\n        getCalculatorGraph: () => work,\n      }),\n  },\n  {\n    invoke: (service: PublicCalculatorService[\"Service\"]) =>\n      service\n        .getCalculatorSchema(\n          GetCalculatorRequest.make({ calculatorId: Request.calculatorId })\n        )\n        .pipe(Effect.asVoid),\n    operation: \"getCalculatorSchema\",\n    substitute: (\n      service: PublicCalculatorService[\"Service\"],\n      work: Effect.Effect<never>\n    ) =>\n      PublicCalculatorService.of({\n        ...service,\n        getCalculatorSchema: () => work,\n      }),\n  },\n  {\n    invoke: (service: PublicCalculatorService[\"Service\"]) =>\n      service.listCalculators(MetadataQuery.make({})).pipe(Effect.asVoid),\n    operation: \"listCalculators\",\n    substitute: (\n      service: PublicCalculatorService[\"Service\"],\n      work: Effect.Effect<never>\n    ) =>\n      PublicCalculatorService.of({ ...service, listCalculators: () => work }),\n  },\n  {\n    invoke: (service: PublicCalculatorService[\"Service\"]) =>\n      service.listFacts(DescriptorFilterQuery.make({})).pipe(Effect.asVoid),\n    operation: \"listFacts\",\n    substitute: (\n      service: PublicCalculatorService[\"Service\"],\n      work: Effect.Effect<never>\n    ) => PublicCalculatorService.of({ ...service, listFacts: () => work }),\n  },\n  {\n    invoke: (service: PublicCalculatorService[\"Service\"]) =>\n      service.listJurisdictions().pipe(Effect.asVoid),\n    operation: \"listJurisdictions\",\n    substitute: (\n      service: PublicCalculatorService[\"Service\"],\n      work: Effect.Effect<never>\n    ) =>\n      PublicCalculatorService.of({ ...service, listJurisdictions: () => work }),\n  },\n"},"started_at_ms":1791264646668,"completed_at_ms":1791264646668}}
{"timestamp":"2026-10-06T05:30:46.815Z","ordinal":38635,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a10fab-f789-7f30-a7de-963ccee8ae9f","item":{"type":"CommandExecution","id":"exec-5cf6a495-43d7-46c2-8bd4-4d46c14ada18","process_id":"85887","command":["/bin/zsh","-lc","cat packages/infrastructure/src/apps-stack.test.ts; cat apps/web/src/lib/loaders.server.ts; sed -n '1,125p' packages/api/http/src/request-boundary.ts; sed -n '80,128p' node_modules/alchemy/src/Cloudflare/Workers/WorkerBridge.ts"],"cwd":"file:///Users/cooper/.codex/worktrees/aac7/taxkit","parsed_cmd":[{"type":"read","cmd":"cat packages/infrastructure/src/apps-stack.test.ts","name":"apps-stack.test.ts","path":"packages/infrastructure/src/apps-stack.test.ts"},{"type":"read","cmd":"cat apps/web/src/lib/loaders.server.ts","name":"loaders.server.ts","path":"apps/web/src/lib/loaders.server.ts"},{"type":"read","cmd":"sed -n '1,125p' packages/api/http/src/request-boundary.ts","name":"request-boundary.ts","path":"packages/api/http/src/request-boundary.ts"},{"type":"read","cmd":"sed -n '80,128p' node_modules/alchemy/src/Cloudflare/Workers/WorkerBridge.ts","name":"WorkerBridge.ts","path":"node_modules/alchemy/src/Cloudflare/Workers/WorkerBridge.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"import { BunServices } from \"@effect/platform-bun\";\nimport { describe, expect, it } from \"@effect/vitest\";\nimport { AlchemyContext } from \"alchemy/AlchemyContext\";\nimport { ArtifactStore, createArtifactStore } from \"alchemy/Artifacts\";\nimport { AuthProviders } from \"alchemy/Auth/AuthProvider\";\nimport { CredentialsStore } from \"alchemy/Auth/Credentials\";\nimport { ProfileStore } from \"alchemy/Auth/Profile\";\nimport { Providers } from \"alchemy/Cloudflare\";\nimport { Worker, isSelfUrl } from \"alchemy/Cloudflare/Workers\";\nimport { layerNonInteractive } from \"alchemy/Interaction\";\nimport * as Output from \"alchemy/Output\";\nimport * as Plan from \"alchemy/Plan\";\nimport * as Provider from \"alchemy/Provider\";\nimport * as Stack from \"alchemy/Stack\";\nimport { Stage } from \"alchemy/Stage\";\nimport { inMemoryState, State } from \"alchemy/State\";\nimport { StackConfigOverrides } from \"alchemy/Util/ConfigProvider\";\nimport {\n  Array,\n  Cause,\n  Config,\n  ConfigProvider,\n  Effect,\n  Exit,\n  Layer,\n  Option,\n  Order,\n  Predicate,\n  Record,\n  Ref,\n  Result,\n  Schema,\n} from \"effect\";\nimport { HttpClient } from \"effect/http\";\n\nimport {\n  nativeAppsDopplerSelection,\n  nativeAppsSecrets,\n} from \"./apps-secrets.boundary.js\";\nimport { declareNativeAppsStack } from \"./apps-stack.js\";\n\nconst graphFixture = Effect.fnUntraced(function* (\n  mode: \"create\" | \"noop\" | \"update\" | \"without-precreate\"\n) {\n  const providerWrites = yield* Ref.make(0);\n  const forbiddenWrite = Ref.update(providerWrites, (count) => count + 1).pipe(\n    Effect.andThen(Effect.die(\"Provider writes are forbidden in graph proof\"))\n  );\n  const workerService = Worker.Provider.of({\n    delete: () => forbiddenWrite,\n    diff: () =>\n      Effect.succeed(\n        mode === \"update\"\n          ? { action: \"update\", stables: [\"workerId\"] }\n          : { action: \"noop\" }\n      ),\n    list: () => Effect.die(\"Unexpected provider enumeration\"),\n    read: ({ output }: { readonly output: Worker[\"Attributes\"] | undefined }) =>\n      Effect.succeed(output),\n    reconcile: () => forbiddenWrite,\n  });\n  const workerProvider = Provider.effect(\n    Worker,\n    Effect.succeed(\n      mode === \"without-precreate\"\n        ? workerService\n        : { ...workerService, precreate: () => forbiddenWrite }\n    )\n  );\n  const stateLayer = inMemoryState();\n  const providers = Layer.merge(\n    Layer.effect(\n      Providers,\n      Provider.collection([Worker]).pipe(Effect.provide(workerProvider))\n    ),\n    stateLayer\n  );\n  // The actual graph uses only Worker providers. Its public upstream type names\n  // the complete Cloudflare provider union; absent providers would still fail\n  // native planning rather than receive invented services.\n  const compiled = yield* Stack.make<Providers | State>({\n    name: \"TaxKitAppsGraphProof\",\n    providers,\n    state: stateLayer,\n  })(declareNativeAppsStack);\n  if (mode === \"noop\" || mode === \"update\") {\n    const state = yield* State.pipe(Effect.provideContext(compiled.services));\n    const store = yield* state;\n    yield* Effect.forEach(Record.values(compiled.resources), (resource) =>\n      store.set({\n        fqn: resource.FQN,\n        stack: compiled.name,\n        stage: compiled.stage,\n        value: {\n          attr: {\n            accountId: \"graph-proof-account\",\n            crons: [],\n            durableObjectNamespaces: {},\n            routes: [],\n            url:\n              resource.LogicalId === \"TaxKitApi\"\n                ? \"https://api.example.com\"\n                : \"https://website.example.com\",\n            urls: [],\n            workerId: `proof-${resource.LogicalId}`,\n            workerName: resource.LogicalId,\n          },\n          bindings: [],\n          downstream: [],\n          fqn: resource.FQN,\n          instanceId: `proof-${resource.LogicalId}`,\n          logicalId: resource.LogicalId,\n          namespace: resource.Namespace,\n          props: {},\n          providerVersion: 0,\n          resourceType: resource.Type,\n          status: \"created\",\n        },\n      })\n    );\n  }\n  const planned = yield* Plan.make(compiled).pipe(\n    Effect.provideContext(compiled.services),\n    Effect.timeout(\"1 second\"),\n    Effect.exit\n  );\n  return { compiled, planned, providerWrites: yield* Ref.get(providerWrites) };\n});\n\nconst graphEnvironment = Effect.provide(\n  Layer.mergeAll(\n    BunServices.layer,\n    Layer.succeed(ArtifactStore, createArtifactStore()),\n    Layer.succeed(AuthProviders, {}),\n    layerNonInteractive(),\n    Layer.succeed(\n      ProfileStore,\n      ProfileStore.of({\n        createProfile: () => Effect.die(\"Unexpected profile write\"),\n        current: Effect.die(\"Unexpected profile read\"),\n        deleteProfile: () => Effect.die(\"Unexpected profile write\"),\n        deleteProviderConfig: () => Effect.die(\"Unexpected profile write\"),\n        ensureProfile: () => Effect.die(\"Unexpected profile write\"),\n        getProfile: () => Effect.die(\"Unexpected profile read\"),\n        loadProviderConfig: () => Effect.die(\"Unexpected profile read\"),\n        readManifest: Effect.die(\"Unexpected profile read\"),\n        renameProfile: () => Effect.die(\"Unexpected profile write\"),\n        setProviderConfig: () => Effect.die(\"Unexpected profile write\"),\n      })\n    ),\n    Layer.succeed(\n      CredentialsStore,\n      CredentialsStore.of({\n        delete: () => Effect.die(\"Unexpected credential write\"),\n        deleteProfile: () => Effect.die(\"Unexpected credential write\"),\n        read: () => Effect.die(\"Unexpected credential read\"),\n        write: () => Effect.die(\"Unexpected credential write\"),\n      })\n    ),\n    HttpClient.layerMergedContext(\n      Effect.succeed(\n        HttpClient.make(() => Effect.die(\"Unexpected network access\"))\n      )\n    )\n  )\n);\nconst localContext = {\n  adopt: false,\n  dev: false,\n  dotAlchemy: \"tmp/native-apps-graph-proof\",\n};\n\ndescribe(\"native paired app graph and planner\", () => {\n  it.live.each([\"create\", \"noop\", \"update\"] as const)(\n    \"keeps the actual circular address graph live for %s\",\n    (mode) =>\n      Effect.gen(function* () {\n        const result = yield* graphFixture(mode);\n        expect(result.providerWrites).toBe(0);\n        const plan = yield* result.planned;\n        expect(Array.sort(Record.keys(plan.resources), Order.String)).toEqual([\n          \"TaxKitApi\",\n          \"TaxKitWebsite\",\n        ]);\n        expect(\n          Array.sort(Array.fromIterable(plan.cycleMembers), Order.String)\n        ).toEqual([\"TaxKitApi\", \"TaxKitWebsite\"]);\n        expect(\n          Array.map(Record.values(plan.resources), ({ resource, action }) => ({\n            action,\n            id: resource.LogicalId,\n          }))\n        ).toEqual([\n          { action: mode, id: \"TaxKitWebsite\" },\n          { action: mode, id: \"TaxKitApi\" },\n        ]);\n        const api = Record.get(result.compiled.resources, \"TaxKitApi\").pipe(\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        const website = Record.get(\n          result.compiled.resources,\n          \"TaxKitWebsite\"\n        ).pipe(\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        expect(api.Props).toBeDefined();\n        expect(website.Props).toBeDefined();\n        expect(isSelfUrl(api.Props.env?.API_PUBLIC_ORIGIN)).toBe(true);\n        expect(isSelfUrl(website.Props.env?.WEBSITE_PUBLIC_ORIGIN)).toBe(true);\n        expect(Record.keys(website.Props.env ?? {})).toEqual([\n          \"API_PUBLIC_ORIGIN\",\n          \"TAXKIT_API\",\n          \"WEBSITE_PUBLIC_ORIGIN\",\n        ]);\n        const apiNode = Record.get(plan.resources, \"TaxKitApi\").pipe(\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        const websiteNode = Record.get(plan.resources, \"TaxKitWebsite\").pipe(\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        const apiProps = \"props\" in apiNode ? apiNode.props : api.Props;\n        const websiteProps =\n          \"props\" in websiteNode ? websiteNode.props : website.Props;\n        // This is the actual native planned graph, not an assertion against\n        // an unused policy constant. Omitted metadata invokes SDK defaults.\n        const disabledPlatformTelemetry = Schema.Struct({\n          enabled: Schema.Literal(false),\n          headSamplingRate: Schema.Literal(0),\n          logs: Schema.Struct({\n            enabled: Schema.Literal(false),\n            headSamplingRate: Schema.Literal(0),\n            invocationLogs: Schema.Literal(false),\n            persist: Schema.Literal(false),\n          }),\n          traces: Schema.Struct({\n            enabled: Schema.Literal(false),\n            headSamplingRate: Schema.Literal(0),\n            persist: Schema.Literal(false),\n          }),\n        });\n        expect(\n          Schema.is(disabledPlatformTelemetry)(apiProps.observability)\n        ).toBe(true);\n        expect(\n          Schema.is(disabledPlatformTelemetry)(websiteProps.observability)\n        ).toBe(true);\n        const privateBinding = Option.fromNullishOr(website.Props.env).pipe(\n          Option.flatMap((env) => Record.get(env, \"TAXKIT_API\")),\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        expect(privateBinding).toBe(api);\n        expect(result.compiled.stage).toBe(\"dev_native_graph_proof\");\n        expect(result.compiled.name).toBe(\"TaxKitAppsGraphProof\");\n        const absent = yield* Output.evaluate(\n          {\n            api: websiteProps.env?.API_PUBLIC_ORIGIN,\n            website: apiProps.env?.WEBSITE_PUBLIC_ORIGIN,\n          },\n          { TaxKitApi: { url: undefined }, TaxKitWebsite: { url: null } }\n        ).pipe(Effect.provideContext(result.compiled.services));\n        expect(absent).toEqual({ api: null, website: null });\n        const resolved = yield* Output.evaluate(\n          {\n            api: websiteProps.env?.API_PUBLIC_ORIGIN,\n            website: apiProps.env?.WEBSITE_PUBLIC_ORIGIN,\n          },\n          {\n            TaxKitApi: { url: \"https://fresh-api.example.com\" },\n            TaxKitWebsite: { url: \"https://fresh-website.example.com\" },\n          }\n        ).pipe(Effect.provideContext(result.compiled.services));\n        expect(resolved).toEqual({\n          api: \"https://fresh-api.example.com\",\n          website: \"https://fresh-website.example.com\",\n        });\n      }).pipe(\n        Effect.provideService(AlchemyContext, localContext),\n        Effect.provideService(Stage, \"dev_native_graph_proof\"),\n        graphEnvironment,\n        Effect.scoped\n      )\n  );\n  it.live(\"refuses a cycle whose provider cannot precreate\", () =>\n    Effect.gen(function* () {\n      const result = yield* graphFixture(\"without-precreate\");\n      expect(result.providerWrites).toBe(0);\n      expect(Exit.isFailure(result.planned)).toBe(true);\n      expect(Exit.hasDies(result.planned)).toBe(true);\n      if (Exit.isFailure(result.planned)) {\n        const die = Cause.findDie(result.planned.cause).pipe(Result.getOrThrow);\n        expect(Predicate.isTagged(die.defect, \"UnsatisfiedResourceCycle\")).toBe(\n          true\n        );\n      }\n    }).pipe(\n      Effect.provideService(AlchemyContext, localContext),\n      Effect.provideService(Stage, \"dev_native_graph_proof\"),\n      graphEnvironment,\n      Effect.scoped\n    )\n  );\n});\n\ndescribe(\"native app root secret selection\", () => {\n  it.effect.each([\n    { config: \"prd\", stage: \"prod\" },\n    { config: \"stg_preview\", stage: \"pr-214\" },\n    { config: \"dev\", stage: \"dev_ci_user\" },\n  ])(\"selects taxkit/$config for $stage\", ({ config, stage }) =>\n    Effect.gen(function* () {\n      expect(yield* nativeAppsDopplerSelection(stage)).toEqual({\n        config,\n        project: \"taxkit\",\n      });\n    })\n  );\n  it.effect.each([\"prod-2\", \"pr-0\", \"dev\", \"private-stage-sentinel\"])(\n    \"rejects an invalid stage without retaining its value: %s\",\n    (stage) =>\n      Effect.gen(function* () {\n        const exit = yield* nativeAppsDopplerSelection(stage).pipe(Effect.exit);\n        expect(Exit.isFailure(exit)).toBe(true);\n        if (Exit.isFailure(exit)) {\n          expect(Cause.pretty(exit.cause)).toContain(\n            \"Native app stack stage is missing or invalid\"\n          );\n          expect(Cause.pretty(exit.cause)).not.toContain(stage);\n        }\n      })\n  );\n  it.live(\"keeps the selected configuration ahead of ambient PATH\", () =>\n    Effect.gen(function* () {\n      const compiled = yield* Stack.make({\n        name: \"TaxKitAppsSecretsProof\",\n        providers: Layer.empty,\n        secrets: (context) => [\n          ConfigProvider.layerAdd(\n            ConfigProvider.fromUnknown({ PATH: \"first-fixture-source\" }),\n            { asPrimary: true }\n          ),\n          ConfigProvider.layerAdd(\n            ConfigProvider.fromUnknown({ PATH: \"selected-doppler-fixture\" }),\n            { asPrimary: true }\n          ),\n          ...Array.drop(nativeAppsSecrets(context), 1),\n        ],\n        state: inMemoryState(),\n      })(Config.schema(Schema.String, \"PATH\"));\n      expect(compiled.output).toBe(\"selected-doppler-fixture\");\n    }).pipe(\n      Effect.provideService(AlchemyContext, localContext),\n      Effect.provideService(Stage, \"dev_native_graph_proof\"),\n      graphEnvironment,\n      Effect.scoped\n    )\n  );\n  it.live(\"rejects env-file selection before any credential or HTTP call\", () =>\n    Effect.gen(function* () {\n      const exit = yield* Stack.make({\n        name: \"TaxKitAppsSecretsProof\",\n        providers: Layer.empty,\n        secrets: nativeAppsSecrets,\n        state: inMemoryState(),\n      })(Effect.void).pipe(Effect.exit);\n      expect(Exit.isFailure(exit)).toBe(true);\n      if (Exit.isFailure(exit)) {\n        expect(Cause.pretty(exit.cause)).toContain(\n          \"--env-file cannot be combined\"\n        );\n        expect(Cause.pretty(exit.cause)).not.toContain(\"Unexpected\");\n      }\n    }).pipe(\n      Effect.provideService(StackConfigOverrides, {\n        envFile: \"native-proof.env\",\n      }),\n      Effect.provideService(AlchemyContext, localContext),\n      Effect.provideService(Stage, \"dev_native_graph_proof\"),\n      graphEnvironment,\n      Effect.scoped\n    )\n  );\n  it.live(\n    \"rejects the actual root stage before a credential or HTTP call\",\n    () =>\n      Effect.gen(function* () {\n        const exit = yield* Stack.make({\n          name: \"TaxKitAppsSecretsProof\",\n          providers: Layer.empty,\n          secrets: nativeAppsSecrets,\n          state: inMemoryState(),\n        })(Effect.void).pipe(Effect.exit);\n        expect(Exit.isFailure(exit)).toBe(true);\n        if (Exit.isFailure(exit)) {\n          expect(Cause.pretty(exit.cause)).toContain(\n            \"Native app stack stage is missing or invalid\"\n          );\n          expect(Cause.pretty(exit.cause)).not.toContain(\n            \"private-stage-sentinel\"\n          );\n          expect(Cause.pretty(exit.cause)).not.toContain(\"Unexpected\");\n        }\n      }).pipe(\n        Effect.provideService(AlchemyContext, localContext),\n        Effect.provideService(Stage, \"private-stage-sentinel\"),\n        graphEnvironment,\n        Effect.scoped\n      )\n  );\n});\nimport \"@tanstack/react-start/server-only\";\nimport { getRequest } from \"@tanstack/react-start/server\";\nimport { Effect, ErrorReporter, Schema } from \"effect\";\nimport { HttpServerError, HttpServerResponse } from \"effect/http\";\n\nimport { appRuntime } from \"./runtime.server\";\nimport { WebsiteCatalogueTransport, WebsiteSettingsTransport } from \"./schemas\";\nimport { WebsiteServerApplication } from \"./service.server\";\n\nexport const loadWebsiteSettingsServer = () =>\n  appRuntime.runPromise(\n    WebsiteServerApplication.pipe(\n      Effect.flatMap((application) =>\n        Effect.gen(function* () {\n          const settings = yield* application.settings.pipe(\n            Effect.result,\n            Effect.flatMap(Schema.encodeEffect(WebsiteSettingsTransport))\n          );\n          const catalogue = yield* application.catalogue.pipe(\n            Effect.result,\n            Effect.flatMap(Schema.encodeEffect(WebsiteCatalogueTransport))\n          );\n          return { catalogue, settings };\n        })\n      ),\n      Effect.orDie,\n      // Expected settings errors remain checked values. An unexpected failure\n      // reaches the host reporter and native empty response before TanStack can\n      // log or serialise an arbitrary Cause as a server-function error.\n      Effect.catchCause((cause) =>\n        HttpServerError.causeResponse(cause).pipe(\n          Effect.flatMap(([response, reportable]) =>\n            ErrorReporter.report(reportable).pipe(\n              Effect.as(HttpServerResponse.toWeb(response))\n            )\n          )\n        )\n      )\n    ),\n    { signal: getRequest().signal }\n  );\nimport {\n  Clock,\n  ByteSize,\n  Duration,\n  Effect,\n  Option,\n  Result,\n  Stream,\n} from \"effect\";\nimport {\n  Headers,\n  HttpClientRequest,\n  HttpServerRequest,\n  HttpServerResponse,\n} from \"effect/http\";\n\nimport {\n  CalculatorRequestBodyRejected,\n  CalculatorRequestBodyErrorEnvelope,\n  CalculatorRequestBodyPolicy,\n  CalculatorRequestBodyTimedOut,\n  CalculatorRequestBodyTooLarge,\n} from \"./schemas.js\";\n\nexport {\n  CalculatorRequestBodyRejected,\n  CalculatorRequestBodyErrorEnvelope,\n  CalculatorRequestBodyPolicy,\n  CalculatorRequestBodyTimedOut,\n  CalculatorRequestBodyTooLarge,\n} from \"./schemas.js\";\n\nexport const CalculatorRequestBodyLimit = ByteSize.kibibytes(64);\nexport const CalculatorRequestBodyDeadline = Duration.seconds(5);\n\n// Native web-request readers do not use MaxBodySize in this selected version.\n// Bound the native stream before materialising bytes, then reuse the native\n// request conversion rather than replacing JSON parsing or RPC framing.\nexport const withCalculatorRequestBodyLimit = <E, R>(\n  handler: Effect.Effect<HttpServerResponse.HttpServerResponse, E, R>,\n  policy: CalculatorRequestBodyPolicy = CalculatorRequestBodyPolicy.make({\n    responseFormat: \"json\",\n  })\n) =>\n  Effect.gen(function* () {\n    const incoming = yield* HttpServerRequest.HttpServerRequest;\n    if (incoming.method !== \"POST\") {\n      return yield* handler;\n    }\n    const started = yield* Clock.monotonicTimeNanos;\n    const readResult = yield* incoming.stream.pipe(\n      Stream.mapAccumEffect(\n        () => ByteSize.bytes(0),\n        (total, chunk) => {\n          const next = ByteSize.sum(total, ByteSize.bytes(chunk.byteLength));\n          return ByteSize.isGreaterThan(next, CalculatorRequestBodyLimit)\n            ? Effect.fail(new CalculatorRequestBodyRejected({ reason: \"size\" }))\n            : Effect.succeed([next, [chunk]] as const);\n        }\n      ),\n      Stream.mkUint8Array,\n      Effect.timeoutOrElse({\n        duration: CalculatorRequestBodyDeadline,\n        orElse: () =>\n          Effect.fail(\n            new CalculatorRequestBodyRejected({ reason: \"deadline\" })\n          ),\n      }),\n      Effect.map(Result.succeed),\n      Effect.catchTag(\"CalculatorRequestBodyRejected\", (error) =>\n        Effect.succeed(Result.fail(error))\n      )\n    );\n    const finished = yield* Clock.monotonicTimeNanos;\n    // Reject late synchronous reads once JavaScript returns control as well.\n    const read =\n      Result.isSuccess(readResult) &&\n      Duration.isGreaterThanOrEqualTo(\n        Duration.nanos(finished - started),\n        CalculatorRequestBodyDeadline\n      )\n        ? Result.fail(new CalculatorRequestBodyRejected({ reason: \"deadline\" }))\n        : readResult;\n    if (Result.isFailure(read)) {\n      const error =\n        read.failure.reason === \"size\"\n          ? new CalculatorRequestBodyTooLarge()\n          : new CalculatorRequestBodyTimedOut();\n      const status = read.failure.reason === \"size\" ? 413 : 408;\n      if (policy.responseFormat === \"html\") {\n        // Only fixed Schema-owned messages enter this page; never reflect input,\n        // request URLs, headers or private diagnostics into a rejected request.\n        return yield* HttpServerResponse.html`<!doctype html>\n          <html lang=\"en-AU\"><head><meta charset=\"utf-8\">\n          <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n          <title>Request could not be read | TaxKit</title></head>\n          <body><main><h1>Request could not be read</h1><p>${error.message}</p>\n          <a href=\"/\">Return to the calculators</a></main></body></html>`.pipe(\n          Effect.map((response) =>\n            HttpServerResponse.setStatus(response, status)\n          )\n        );\n      }\n      return yield* HttpServerResponse.schemaJson(\n        CalculatorRequestBodyErrorEnvelope\n      )({ error }, { status }).pipe(Effect.orDie);\n    }\n    const bytes = read.success;\n    const bounded = HttpServerRequest.toClientRequest(incoming)\n      .pipe(\n        HttpClientRequest.bodyUint8Array(\n          bytes,\n          Headers.get(incoming.headers, \"content-type\").pipe(\n            Option.getOrUndefined\n          )\n        ),\n        HttpServerRequest.fromClientRequest\n      )\n      .modify({ remoteAddress: incoming.remoteAddress, url: incoming.url });\n    return yield* handler.pipe(\n      Effect.provideService(HttpServerRequest.HttpServerRequest, bounded)\n    );\n  });\n\n  const processEvent = <T>(\n    makeEffect: (\n      build: WorkerBuild,\n    ) => readonly [Effect.Effect<any, any, any>, Context.Context<never>],\n    ctx: cf.ExecutionContext,\n    env: Record<string, unknown> | undefined,\n    onExit: (\n      exit: Exit.Exit<any, any>,\n      scope: Scope.Closeable,\n    ) => T | Promise<T>,\n  ): Promise<T> => {\n    const scope = Scope.makeUnsafe();\n    return build((promise) => ctx.waitUntil(promise as Promise<any>))\n      .then(\n        (built) => {\n          const [eff, services] = makeEffect(built);\n          return eff.pipe(\n            // Per-event services take precedence over the captured services\n            // and the built isolate context: the isolate context carries the\n            // *deferred* WorkerExecutionContext (yieldable in the top-level\n            // closure), which must be shadowed by the real per-event one\n            // here, and the fresh request `Scope` so `Effect.addFinalizer`\n            // in a handler attaches to the request scope (closed into\n            // `ctx.waitUntil` below).\n            Effect.provide(\n              Layer.mergeAll(\n                Layer.succeed(\n                  WorkerExecutionContext,\n                  fromExecutionContext(ctx, env),\n                ),\n                Layer.succeed(Scope.Scope, scope),\n                Layer.succeed(RuntimeContext, built.runtimeContext),\n                // The configured telemetry exporters. Constructed as part\n                // of this per-event layer, but `buildEventTelemetry`\n                // attaches their batching fibers and flush finalizers to\n                // the request `scope` (not this build's transient scope),\n                // so buffered telemetry flushes when the scope closes into\n                // `ctx.waitUntil` below — never on workerd's ephemeral\n                // isolate scope.\n                Layer.effectContext(\n                  buildEventTelemetry(built.context, scope, built.telemetry()),\n                ),\n              ).pipe(\n                Layer.provideMerge(Layer.succeedContext(services)),\n                Layer.provideMerge(Layer.succeedContext(built.context)),\n              ),\n            ),\n            Effect.runPromiseExit,\n","stderr":"","aggregated_output":"import { BunServices } from \"@effect/platform-bun\";\nimport { describe, expect, it } from \"@effect/vitest\";\nimport { AlchemyContext } from \"alchemy/AlchemyContext\";\nimport { ArtifactStore, createArtifactStore } from \"alchemy/Artifacts\";\nimport { AuthProviders } from \"alchemy/Auth/AuthProvider\";\nimport { CredentialsStore } from \"alchemy/Auth/Credentials\";\nimport { ProfileStore } from \"alchemy/Auth/Profile\";\nimport { Providers } from \"alchemy/Cloudflare\";\nimport { Worker, isSelfUrl } from \"alchemy/Cloudflare/Workers\";\nimport { layerNonInteractive } from \"alchemy/Interaction\";\nimport * as Output from \"alchemy/Output\";\nimport * as Plan from \"alchemy/Plan\";\nimport * as Provider from \"alchemy/Provider\";\nimport * as Stack from \"alchemy/Stack\";\nimport { Stage } from \"alchemy/Stage\";\nimport { inMemoryState, State } from \"alchemy/State\";\nimport { StackConfigOverrides } from \"alchemy/Util/ConfigProvider\";\nimport {\n  Array,\n  Cause,\n  Config,\n  ConfigProvider,\n  Effect,\n  Exit,\n  Layer,\n  Option,\n  Order,\n  Predicate,\n  Record,\n  Ref,\n  Result,\n  Schema,\n} from \"effect\";\nimport { HttpClient } from \"effect/http\";\n\nimport {\n  nativeAppsDopplerSelection,\n  nativeAppsSecrets,\n} from \"./apps-secrets.boundary.js\";\nimport { declareNativeAppsStack } from \"./apps-stack.js\";\n\nconst graphFixture = Effect.fnUntraced(function* (\n  mode: \"create\" | \"noop\" | \"update\" | \"without-precreate\"\n) {\n  const providerWrites = yield* Ref.make(0);\n  const forbiddenWrite = Ref.update(providerWrites, (count) => count + 1).pipe(\n    Effect.andThen(Effect.die(\"Provider writes are forbidden in graph proof\"))\n  );\n  const workerService = Worker.Provider.of({\n    delete: () => forbiddenWrite,\n    diff: () =>\n      Effect.succeed(\n        mode === \"update\"\n          ? { action: \"update\", stables: [\"workerId\"] }\n          : { action: \"noop\" }\n      ),\n    list: () => Effect.die(\"Unexpected provider enumeration\"),\n    read: ({ output }: { readonly output: Worker[\"Attributes\"] | undefined }) =>\n      Effect.succeed(output),\n    reconcile: () => forbiddenWrite,\n  });\n  const workerProvider = Provider.effect(\n    Worker,\n    Effect.succeed(\n      mode === \"without-precreate\"\n        ? workerService\n        : { ...workerService, precreate: () => forbiddenWrite }\n    )\n  );\n  const stateLayer = inMemoryState();\n  const providers = Layer.merge(\n    Layer.effect(\n      Providers,\n      Provider.collection([Worker]).pipe(Effect.provide(workerProvider))\n    ),\n    stateLayer\n  );\n  // The actual graph uses only Worker providers. Its public upstream type names\n  // the complete Cloudflare provider union; absent providers would still fail\n  // native planning rather than receive invented services.\n  const compiled = yield* Stack.make<Providers | State>({\n    name: \"TaxKitAppsGraphProof\",\n    providers,\n    state: stateLayer,\n  })(declareNativeAppsStack);\n  if (mode === \"noop\" || mode === \"update\") {\n    const state = yield* State.pipe(Effect.provideContext(compiled.services));\n    const store = yield* state;\n    yield* Effect.forEach(Record.values(compiled.resources), (resource) =>\n      store.set({\n        fqn: resource.FQN,\n        stack: compiled.name,\n        stage: compiled.stage,\n        value: {\n          attr: {\n            accountId: \"graph-proof-account\",\n            crons: [],\n            durableObjectNamespaces: {},\n            routes: [],\n            url:\n              resource.LogicalId === \"TaxKitApi\"\n                ? \"https://api.example.com\"\n                : \"https://website.example.com\",\n            urls: [],\n            workerId: `proof-${resource.LogicalId}`,\n            workerName: resource.LogicalId,\n          },\n          bindings: [],\n          downstream: [],\n          fqn: resource.FQN,\n          instanceId: `proof-${resource.LogicalId}`,\n          logicalId: resource.LogicalId,\n          namespace: resource.Namespace,\n          props: {},\n          providerVersion: 0,\n          resourceType: resource.Type,\n          status: \"created\",\n        },\n      })\n    );\n  }\n  const planned = yield* Plan.make(compiled).pipe(\n    Effect.provideContext(compiled.services),\n    Effect.timeout(\"1 second\"),\n    Effect.exit\n  );\n  return { compiled, planned, providerWrites: yield* Ref.get(providerWrites) };\n});\n\nconst graphEnvironment = Effect.provide(\n  Layer.mergeAll(\n    BunServices.layer,\n    Layer.succeed(ArtifactStore, createArtifactStore()),\n    Layer.succeed(AuthProviders, {}),\n    layerNonInteractive(),\n    Layer.succeed(\n      ProfileStore,\n      ProfileStore.of({\n        createProfile: () => Effect.die(\"Unexpected profile write\"),\n        current: Effect.die(\"Unexpected profile read\"),\n        deleteProfile: () => Effect.die(\"Unexpected profile write\"),\n        deleteProviderConfig: () => Effect.die(\"Unexpected profile write\"),\n        ensureProfile: () => Effect.die(\"Unexpected profile write\"),\n        getProfile: () => Effect.die(\"Unexpected profile read\"),\n        loadProviderConfig: () => Effect.die(\"Unexpected profile read\"),\n        readManifest: Effect.die(\"Unexpected profile read\"),\n        renameProfile: () => Effect.die(\"Unexpected profile write\"),\n        setProviderConfig: () => Effect.die(\"Unexpected profile write\"),\n      })\n    ),\n    Layer.succeed(\n      CredentialsStore,\n      CredentialsStore.of({\n        delete: () => Effect.die(\"Unexpected credential write\"),\n        deleteProfile: () => Effect.die(\"Unexpected credential write\"),\n        read: () => Effect.die(\"Unexpected credential read\"),\n        write: () => Effect.die(\"Unexpected credential write\"),\n      })\n    ),\n    HttpClient.layerMergedContext(\n      Effect.succeed(\n        HttpClient.make(() => Effect.die(\"Unexpected network access\"))\n      )\n    )\n  )\n);\nconst localContext = {\n  adopt: false,\n  dev: false,\n  dotAlchemy: \"tmp/native-apps-graph-proof\",\n};\n\ndescribe(\"native paired app graph and planner\", () => {\n  it.live.each([\"create\", \"noop\", \"update\"] as const)(\n    \"keeps the actual circular address graph live for %s\",\n    (mode) =>\n      Effect.gen(function* () {\n        const result = yield* graphFixture(mode);\n        expect(result.providerWrites).toBe(0);\n        const plan = yield* result.planned;\n        expect(Array.sort(Record.keys(plan.resources), Order.String)).toEqual([\n          \"TaxKitApi\",\n          \"TaxKitWebsite\",\n        ]);\n        expect(\n          Array.sort(Array.fromIterable(plan.cycleMembers), Order.String)\n        ).toEqual([\"TaxKitApi\", \"TaxKitWebsite\"]);\n        expect(\n          Array.map(Record.values(plan.resources), ({ resource, action }) => ({\n            action,\n            id: resource.LogicalId,\n          }))\n        ).toEqual([\n          { action: mode, id: \"TaxKitWebsite\" },\n          { action: mode, id: \"TaxKitApi\" },\n        ]);\n        const api = Record.get(result.compiled.resources, \"TaxKitApi\").pipe(\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        const website = Record.get(\n          result.compiled.resources,\n          \"TaxKitWebsite\"\n        ).pipe(\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        expect(api.Props).toBeDefined();\n        expect(website.Props).toBeDefined();\n        expect(isSelfUrl(api.Props.env?.API_PUBLIC_ORIGIN)).toBe(true);\n        expect(isSelfUrl(website.Props.env?.WEBSITE_PUBLIC_ORIGIN)).toBe(true);\n        expect(Record.keys(website.Props.env ?? {})).toEqual([\n          \"API_PUBLIC_ORIGIN\",\n          \"TAXKIT_API\",\n          \"WEBSITE_PUBLIC_ORIGIN\",\n        ]);\n        const apiNode = Record.get(plan.resources, \"TaxKitApi\").pipe(\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        const websiteNode = Record.get(plan.resources, \"TaxKitWebsite\").pipe(\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        const apiProps = \"props\" in apiNode ? apiNode.props : api.Props;\n        const websiteProps =\n          \"props\" in websiteNode ? websiteNode.props : website.Props;\n        // This is the actual native planned graph, not an assertion against\n        // an unused policy constant. Omitted metadata invokes SDK defaults.\n        const disabledPlatformTelemetry = Schema.Struct({\n          enabled: Schema.Literal(false),\n          headSamplingRate: Schema.Literal(0),\n          logs: Schema.Struct({\n            enabled: Schema.Literal(false),\n            headSamplingRate: Schema.Literal(0),\n            invocationLogs: Schema.Literal(false),\n            persist: Schema.Literal(false),\n          }),\n          traces: Schema.Struct({\n            enabled: Schema.Literal(false),\n            headSamplingRate: Schema.Literal(0),\n            persist: Schema.Literal(false),\n          }),\n        });\n        expect(\n          Schema.is(disabledPlatformTelemetry)(apiProps.observability)\n        ).toBe(true);\n        expect(\n          Schema.is(disabledPlatformTelemetry)(websiteProps.observability)\n        ).toBe(true);\n        const privateBinding = Option.fromNullishOr(website.Props.env).pipe(\n          Option.flatMap((env) => Record.get(env, \"TAXKIT_API\")),\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        expect(privateBinding).toBe(api);\n        expect(result.compiled.stage).toBe(\"dev_native_graph_proof\");\n        expect(result.compiled.name).toBe(\"TaxKitAppsGraphProof\");\n        const absent = yield* Output.evaluate(\n          {\n            api: websiteProps.env?.API_PUBLIC_ORIGIN,\n            website: apiProps.env?.WEBSITE_PUBLIC_ORIGIN,\n          },\n          { TaxKitApi: { url: undefined }, TaxKitWebsite: { url: null } }\n        ).pipe(Effect.provideContext(result.compiled.services));\n        expect(absent).toEqual({ api: null, website: null });\n        const resolved = yield* Output.evaluate(\n          {\n            api: websiteProps.env?.API_PUBLIC_ORIGIN,\n            website: apiProps.env?.WEBSITE_PUBLIC_ORIGIN,\n          },\n          {\n            TaxKitApi: { url: \"https://fresh-api.example.com\" },\n            TaxKitWebsite: { url: \"https://fresh-website.example.com\" },\n          }\n        ).pipe(Effect.provideContext(result.compiled.services));\n        expect(resolved).toEqual({\n          api: \"https://fresh-api.example.com\",\n          website: \"https://fresh-website.example.com\",\n        });\n      }).pipe(\n        Effect.provideService(AlchemyContext, localContext),\n        Effect.provideService(Stage, \"dev_native_graph_proof\"),\n        graphEnvironment,\n        Effect.scoped\n      )\n  );\n  it.live(\"refuses a cycle whose provider cannot precreate\", () =>\n    Effect.gen(function* () {\n      const result = yield* graphFixture(\"without-precreate\");\n      expect(result.providerWrites).toBe(0);\n      expect(Exit.isFailure(result.planned)).toBe(true);\n      expect(Exit.hasDies(result.planned)).toBe(true);\n      if (Exit.isFailure(result.planned)) {\n        const die = Cause.findDie(result.planned.cause).pipe(Result.getOrThrow);\n        expect(Predicate.isTagged(die.defect, \"UnsatisfiedResourceCycle\")).toBe(\n          true\n        );\n      }\n    }).pipe(\n      Effect.provideService(AlchemyContext, localContext),\n      Effect.provideService(Stage, \"dev_native_graph_proof\"),\n      graphEnvironment,\n      Effect.scoped\n    )\n  );\n});\n\ndescribe(\"native app root secret selection\", () => {\n  it.effect.each([\n    { config: \"prd\", stage: \"prod\" },\n    { config: \"stg_preview\", stage: \"pr-214\" },\n    { config: \"dev\", stage: \"dev_ci_user\" },\n  ])(\"selects taxkit/$config for $stage\", ({ config, stage }) =>\n    Effect.gen(function* () {\n      expect(yield* nativeAppsDopplerSelection(stage)).toEqual({\n        config,\n        project: \"taxkit\",\n      });\n    })\n  );\n  it.effect.each([\"prod-2\", \"pr-0\", \"dev\", \"private-stage-sentinel\"])(\n    \"rejects an invalid stage without retaining its value: %s\",\n    (stage) =>\n      Effect.gen(function* () {\n        const exit = yield* nativeAppsDopplerSelection(stage).pipe(Effect.exit);\n        expect(Exit.isFailure(exit)).toBe(true);\n        if (Exit.isFailure(exit)) {\n          expect(Cause.pretty(exit.cause)).toContain(\n            \"Native app stack stage is missing or invalid\"\n          );\n          expect(Cause.pretty(exit.cause)).not.toContain(stage);\n        }\n      })\n  );\n  it.live(\"keeps the selected configuration ahead of ambient PATH\", () =>\n    Effect.gen(function* () {\n      const compiled = yield* Stack.make({\n        name: \"TaxKitAppsSecretsProof\",\n        providers: Layer.empty,\n        secrets: (context) => [\n          ConfigProvider.layerAdd(\n            ConfigProvider.fromUnknown({ PATH: \"first-fixture-source\" }),\n            { asPrimary: true }\n          ),\n          ConfigProvider.layerAdd(\n            ConfigProvider.fromUnknown({ PATH: \"selected-doppler-fixture\" }),\n            { asPrimary: true }\n          ),\n          ...Array.drop(nativeAppsSecrets(context), 1),\n        ],\n        state: inMemoryState(),\n      })(Config.schema(Schema.String, \"PATH\"));\n      expect(compiled.output).toBe(\"selected-doppler-fixture\");\n    }).pipe(\n      Effect.provideService(AlchemyContext, localContext),\n      Effect.provideService(Stage, \"dev_native_graph_proof\"),\n      graphEnvironment,\n      Effect.scoped\n    )\n  );\n  it.live(\"rejects env-file selection before any credential or HTTP call\", () =>\n    Effect.gen(function* () {\n      const exit = yield* Stack.make({\n        name: \"TaxKitAppsSecretsProof\",\n        providers: Layer.empty,\n        secrets: nativeAppsSecrets,\n        state: inMemoryState(),\n      })(Effect.void).pipe(Effect.exit);\n      expect(Exit.isFailure(exit)).toBe(true);\n      if (Exit.isFailure(exit)) {\n        expect(Cause.pretty(exit.cause)).toContain(\n          \"--env-file cannot be combined\"\n        );\n        expect(Cause.pretty(exit.cause)).not.toContain(\"Unexpected\");\n      }\n    }).pipe(\n      Effect.provideService(StackConfigOverrides, {\n        envFile: \"native-proof.env\",\n      }),\n      Effect.provideService(AlchemyContext, localContext),\n      Effect.provideService(Stage, \"dev_native_graph_proof\"),\n      graphEnvironment,\n      Effect.scoped\n    )\n  );\n  it.live(\n    \"rejects the actual root stage before a credential or HTTP call\",\n    () =>\n      Effect.gen(function* () {\n        const exit = yield* Stack.make({\n          name: \"TaxKitAppsSecretsProof\",\n          providers: Layer.empty,\n          secrets: nativeAppsSecrets,\n          state: inMemoryState(),\n        })(Effect.void).pipe(Effect.exit);\n        expect(Exit.isFailure(exit)).toBe(true);\n        if (Exit.isFailure(exit)) {\n          expect(Cause.pretty(exit.cause)).toContain(\n            \"Native app stack stage is missing or invalid\"\n          );\n          expect(Cause.pretty(exit.cause)).not.toContain(\n            \"private-stage-sentinel\"\n          );\n          expect(Cause.pretty(exit.cause)).not.toContain(\"Unexpected\");\n        }\n      }).pipe(\n        Effect.provideService(AlchemyContext, localContext),\n        Effect.provideService(Stage, \"private-stage-sentinel\"),\n        graphEnvironment,\n        Effect.scoped\n      )\n  );\n});\nimport \"@tanstack/react-start/server-only\";\nimport { getRequest } from \"@tanstack/react-start/server\";\nimport { Effect, ErrorReporter, Schema } from \"effect\";\nimport { HttpServerError, HttpServerResponse } from \"effect/http\";\n\nimport { appRuntime } from \"./runtime.server\";\nimport { WebsiteCatalogueTransport, WebsiteSettingsTransport } from \"./schemas\";\nimport { WebsiteServerApplication } from \"./service.server\";\n\nexport const loadWebsiteSettingsServer = () =>\n  appRuntime.runPromise(\n    WebsiteServerApplication.pipe(\n      Effect.flatMap((application) =>\n        Effect.gen(function* () {\n          const settings = yield* application.settings.pipe(\n            Effect.result,\n            Effect.flatMap(Schema.encodeEffect(WebsiteSettingsTransport))\n          );\n          const catalogue = yield* application.catalogue.pipe(\n            Effect.result,\n            Effect.flatMap(Schema.encodeEffect(WebsiteCatalogueTransport))\n          );\n          return { catalogue, settings };\n        })\n      ),\n      Effect.orDie,\n      // Expected settings errors remain checked values. An unexpected failure\n      // reaches the host reporter and native empty response before TanStack can\n      // log or serialise an arbitrary Cause as a server-function error.\n      Effect.catchCause((cause) =>\n        HttpServerError.causeResponse(cause).pipe(\n          Effect.flatMap(([response, reportable]) =>\n            ErrorReporter.report(reportable).pipe(\n              Effect.as(HttpServerResponse.toWeb(response))\n            )\n          )\n        )\n      )\n    ),\n    { signal: getRequest().signal }\n  );\nimport {\n  Clock,\n  ByteSize,\n  Duration,\n  Effect,\n  Option,\n  Result,\n  Stream,\n} from \"effect\";\nimport {\n  Headers,\n  HttpClientRequest,\n  HttpServerRequest,\n  HttpServerResponse,\n} from \"effect/http\";\n\nimport {\n  CalculatorRequestBodyRejected,\n  CalculatorRequestBodyErrorEnvelope,\n  CalculatorRequestBodyPolicy,\n  CalculatorRequestBodyTimedOut,\n  CalculatorRequestBodyTooLarge,\n} from \"./schemas.js\";\n\nexport {\n  CalculatorRequestBodyRejected,\n  CalculatorRequestBodyErrorEnvelope,\n  CalculatorRequestBodyPolicy,\n  CalculatorRequestBodyTimedOut,\n  CalculatorRequestBodyTooLarge,\n} from \"./schemas.js\";\n\nexport const CalculatorRequestBodyLimit = ByteSize.kibibytes(64);\nexport const CalculatorRequestBodyDeadline = Duration.seconds(5);\n\n// Native web-request readers do not use MaxBodySize in this selected version.\n// Bound the native stream before materialising bytes, then reuse the native\n// request conversion rather than replacing JSON parsing or RPC framing.\nexport const withCalculatorRequestBodyLimit = <E, R>(\n  handler: Effect.Effect<HttpServerResponse.HttpServerResponse, E, R>,\n  policy: CalculatorRequestBodyPolicy = CalculatorRequestBodyPolicy.make({\n    responseFormat: \"json\",\n  })\n) =>\n  Effect.gen(function* () {\n    const incoming = yield* HttpServerRequest.HttpServerRequest;\n    if (incoming.method !== \"POST\") {\n      return yield* handler;\n    }\n    const started = yield* Clock.monotonicTimeNanos;\n    const readResult = yield* incoming.stream.pipe(\n      Stream.mapAccumEffect(\n        () => ByteSize.bytes(0),\n        (total, chunk) => {\n          const next = ByteSize.sum(total, ByteSize.bytes(chunk.byteLength));\n          return ByteSize.isGreaterThan(next, CalculatorRequestBodyLimit)\n            ? Effect.fail(new CalculatorRequestBodyRejected({ reason: \"size\" }))\n            : Effect.succeed([next, [chunk]] as const);\n        }\n      ),\n      Stream.mkUint8Array,\n      Effect.timeoutOrElse({\n        duration: CalculatorRequestBodyDeadline,\n        orElse: () =>\n          Effect.fail(\n            new CalculatorRequestBodyRejected({ reason: \"deadline\" })\n          ),\n      }),\n      Effect.map(Result.succeed),\n      Effect.catchTag(\"CalculatorRequestBodyRejected\", (error) =>\n        Effect.succeed(Result.fail(error))\n      )\n    );\n    const finished = yield* Clock.monotonicTimeNanos;\n    // Reject late synchronous reads once JavaScript returns control as well.\n    const read =\n      Result.isSuccess(readResult) &&\n      Duration.isGreaterThanOrEqualTo(\n        Duration.nanos(finished - started),\n        CalculatorRequestBodyDeadline\n      )\n        ? Result.fail(new CalculatorRequestBodyRejected({ reason: \"deadline\" }))\n        : readResult;\n    if (Result.isFailure(read)) {\n      const error =\n        read.failure.reason === \"size\"\n          ? new CalculatorRequestBodyTooLarge()\n          : new CalculatorRequestBodyTimedOut();\n      const status = read.failure.reason === \"size\" ? 413 : 408;\n      if (policy.responseFormat === \"html\") {\n        // Only fixed Schema-owned messages enter this page; never reflect input,\n        // request URLs, headers or private diagnostics into a rejected request.\n        return yield* HttpServerResponse.html`<!doctype html>\n          <html lang=\"en-AU\"><head><meta charset=\"utf-8\">\n          <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n          <title>Request could not be read | TaxKit</title></head>\n          <body><main><h1>Request could not be read</h1><p>${error.message}</p>\n          <a href=\"/\">Return to the calculators</a></main></body></html>`.pipe(\n          Effect.map((response) =>\n            HttpServerResponse.setStatus(response, status)\n          )\n        );\n      }\n      return yield* HttpServerResponse.schemaJson(\n        CalculatorRequestBodyErrorEnvelope\n      )({ error }, { status }).pipe(Effect.orDie);\n    }\n    const bytes = read.success;\n    const bounded = HttpServerRequest.toClientRequest(incoming)\n      .pipe(\n        HttpClientRequest.bodyUint8Array(\n          bytes,\n          Headers.get(incoming.headers, \"content-type\").pipe(\n            Option.getOrUndefined\n          )\n        ),\n        HttpServerRequest.fromClientRequest\n      )\n      .modify({ remoteAddress: incoming.remoteAddress, url: incoming.url });\n    return yield* handler.pipe(\n      Effect.provideService(HttpServerRequest.HttpServerRequest, bounded)\n    );\n  });\n\n  const processEvent = <T>(\n    makeEffect: (\n      build: WorkerBuild,\n    ) => readonly [Effect.Effect<any, any, any>, Context.Context<never>],\n    ctx: cf.ExecutionContext,\n    env: Record<string, unknown> | undefined,\n    onExit: (\n      exit: Exit.Exit<any, any>,\n      scope: Scope.Closeable,\n    ) => T | Promise<T>,\n  ): Promise<T> => {\n    const scope = Scope.makeUnsafe();\n    return build((promise) => ctx.waitUntil(promise as Promise<any>))\n      .then(\n        (built) => {\n          const [eff, services] = makeEffect(built);\n          return eff.pipe(\n            // Per-event services take precedence over the captured services\n            // and the built isolate context: the isolate context carries the\n            // *deferred* WorkerExecutionContext (yieldable in the top-level\n            // closure), which must be shadowed by the real per-event one\n            // here, and the fresh request `Scope` so `Effect.addFinalizer`\n            // in a handler attaches to the request scope (closed into\n            // `ctx.waitUntil` below).\n            Effect.provide(\n              Layer.mergeAll(\n                Layer.succeed(\n                  WorkerExecutionContext,\n                  fromExecutionContext(ctx, env),\n                ),\n                Layer.succeed(Scope.Scope, scope),\n                Layer.succeed(RuntimeContext, built.runtimeContext),\n                // The configured telemetry exporters. Constructed as part\n                // of this per-event layer, but `buildEventTelemetry`\n                // attaches their batching fibers and flush finalizers to\n                // the request `scope` (not this build's transient scope),\n                // so buffered telemetry flushes when the scope closes into\n                // `ctx.waitUntil` below — never on workerd's ephemeral\n                // isolate scope.\n                Layer.effectContext(\n                  buildEventTelemetry(built.context, scope, built.telemetry()),\n                ),\n              ).pipe(\n                Layer.provideMerge(Layer.succeedContext(services)),\n                Layer.provideMerge(Layer.succeedContext(built.context)),\n              ),\n            ),\n            Effect.runPromiseExit,\n","exit_code":0,"duration":{"secs":0,"nanos":8750},"formatted_output":"import { BunServices } from \"@effect/platform-bun\";\nimport { describe, expect, it } from \"@effect/vitest\";\nimport { AlchemyContext } from \"alchemy/AlchemyContext\";\nimport { ArtifactStore, createArtifactStore } from \"alchemy/Artifacts\";\nimport { AuthProviders } from \"alchemy/Auth/AuthProvider\";\nimport { CredentialsStore } from \"alchemy/Auth/Credentials\";\nimport { ProfileStore } from \"alchemy/Auth/Profile\";\nimport { Providers } from \"alchemy/Cloudflare\";\nimport { Worker, isSelfUrl } from \"alchemy/Cloudflare/Workers\";\nimport { layerNonInteractive } from \"alchemy/Interaction\";\nimport * as Output from \"alchemy/Output\";\nimport * as Plan from \"alchemy/Plan\";\nimport * as Provider from \"alchemy/Provider\";\nimport * as Stack from \"alchemy/Stack\";\nimport { Stage } from \"alchemy/Stage\";\nimport { inMemoryState, State } from \"alchemy/State\";\nimport { StackConfigOverrides } from \"alchemy/Util/ConfigProvider\";\nimport {\n  Array,\n  Cause,\n  Config,\n  ConfigProvider,\n  Effect,\n  Exit,\n  Layer,\n  Option,\n  Order,\n  Predicate,\n  Record,\n  Ref,\n  Result,\n  Schema,\n} from \"effect\";\nimport { HttpClient } from \"effect/http\";\n\nimport {\n  nativeAppsDopplerSelection,\n  nativeAppsSecrets,\n} from \"./apps-secrets.boundary.js\";\nimport { declareNativeAppsStack } from \"./apps-stack.js\";\n\nconst graphFixture = Effect.fnUntraced(function* (\n  mode: \"create\" | \"noop\" | \"update\" | \"without-precreate\"\n) {\n  const providerWrites = yield* Ref.make(0);\n  const forbiddenWrite = Ref.update(providerWrites, (count) => count + 1).pipe(\n    Effect.andThen(Effect.die(\"Provider writes are forbidden in graph proof\"))\n  );\n  const workerService = Worker.Provider.of({\n    delete: () => forbiddenWrite,\n    diff: () =>\n      Effect.succeed(\n        mode === \"update\"\n          ? { action: \"update\", stables: [\"workerId\"] }\n          : { action: \"noop\" }\n      ),\n    list: () => Effect.die(\"Unexpected provider enumeration\"),\n    read: ({ output }: { readonly output: Worker[\"Attributes\"] | undefined }) =>\n      Effect.succeed(output),\n    reconcile: () => forbiddenWrite,\n  });\n  const workerProvider = Provider.effect(\n    Worker,\n    Effect.succeed(\n      mode === \"without-precreate\"\n        ? workerService\n        : { ...workerService, precreate: () => forbiddenWrite }\n    )\n  );\n  const stateLayer = inMemoryState();\n  const providers = Layer.merge(\n    Layer.effect(\n      Providers,\n      Provider.collection([Worker]).pipe(Effect.provide(workerProvider))\n    ),\n    stateLayer\n  );\n  // The actual graph uses only Worker providers. Its public upstream type names\n  // the complete Cloudflare provider union; absent providers would still fail\n  // native planning rather than receive invented services.\n  const compiled = yield* Stack.make<Providers | State>({\n    name: \"TaxKitAppsGraphProof\",\n    providers,\n    state: stateLayer,\n  })(declareNativeAppsStack);\n  if (mode === \"noop\" || mode === \"update\") {\n    const state = yield* State.pipe(Effect.provideContext(compiled.services));\n    const store = yield* state;\n    yield* Effect.forEach(Record.values(compiled.resources), (resource) =>\n      store.set({\n        fqn: resource.FQN,\n        stack: compiled.name,\n        stage: compiled.stage,\n        value: {\n          attr: {\n            accountId: \"graph-proof-account\",\n            crons: [],\n            durableObjectNamespaces: {},\n            routes: [],\n            url:\n              resource.LogicalId === \"TaxKitApi\"\n                ? \"https://api.example.com\"\n                : \"https://website.example.com\",\n            urls: [],\n            workerId: `proof-${resource.LogicalId}`,\n            workerName: resource.LogicalId,\n          },\n          bindings: [],\n          downstream: [],\n          fqn: resource.FQN,\n          instanceId: `proof-${resource.LogicalId}`,\n          logicalId: resource.LogicalId,\n          namespace: resource.Namespace,\n          props: {},\n          providerVersion: 0,\n          resourceType: resource.Type,\n          status: \"created\",\n        },\n      })\n    );\n  }\n  const planned = yield* Plan.make(compiled).pipe(\n    Effect.provideContext(compiled.services),\n    Effect.timeout(\"1 second\"),\n    Effect.exit\n  );\n  return { compiled, planned, providerWrites: yield* Ref.get(providerWrites) };\n});\n\nconst graphEnvironment = Effect.provide(\n  Layer.mergeAll(\n    BunServices.layer,\n    Layer.succeed(ArtifactStore, createArtifactStore()),\n    Layer.succeed(AuthProviders, {}),\n    layerNonInteractive(),\n    Layer.succeed(\n      ProfileStore,\n      ProfileStore.of({\n        createProfile: () => Effect.die(\"Unexpected profile write\"),\n        current: Effect.die(\"Unexpected profile read\"),\n        deleteProfile: () => Effect.die(\"Unexpected profile write\"),\n        deleteProviderConfig: () => Effect.die(\"Unexpected profile write\"),\n        ensureProfile: () => Effect.die(\"Unexpected profile write\"),\n        getProfile: () => Effect.die(\"Unexpected profile read\"),\n        loadProviderConfig: () => Effect.die(\"Unexpected profile read\"),\n        readManifest: Effect.die(\"Unexpected profile read\"),\n        renameProfile: () => Effect.die(\"Unexpected profile write\"),\n        setProviderConfig: () => Effect.die(\"Unexpected profile write\"),\n      })\n    ),\n    Layer.succeed(\n      CredentialsStore,\n      CredentialsStore.of({\n        delete: () => Effect.die(\"Unexpected credential write\"),\n        deleteProfile: () => Effect.die(\"Unexpected credential write\"),\n        read: () => Effect.die(\"Unexpected credential read\"),\n        write: () => Effect.die(\"Unexpected credential write\"),\n      })\n    ),\n    HttpClient.layerMergedContext(\n      Effect.succeed(\n        HttpClient.make(() => Effect.die(\"Unexpected network access\"))\n      )\n    )\n  )\n);\nconst localContext = {\n  adopt: false,\n  dev: false,\n  dotAlchemy: \"tmp/native-apps-graph-proof\",\n};\n\ndescribe(\"native paired app graph and planner\", () => {\n  it.live.each([\"create\", \"noop\", \"update\"] as const)(\n    \"keeps the actual circular address graph live for %s\",\n    (mode) =>\n      Effect.gen(function* () {\n        const result = yield* graphFixture(mode);\n        expect(result.providerWrites).toBe(0);\n        const plan = yield* result.planned;\n        expect(Array.sort(Record.keys(plan.resources), Order.String)).toEqual([\n          \"TaxKitApi\",\n          \"TaxKitWebsite\",\n        ]);\n        expect(\n          Array.sort(Array.fromIterable(plan.cycleMembers), Order.String)\n        ).toEqual([\"TaxKitApi\", \"TaxKitWebsite\"]);\n        expect(\n          Array.map(Record.values(plan.resources), ({ resource, action }) => ({\n            action,\n            id: resource.LogicalId,\n          }))\n        ).toEqual([\n          { action: mode, id: \"TaxKitWebsite\" },\n          { action: mode, id: \"TaxKitApi\" },\n        ]);\n        const api = Record.get(result.compiled.resources, \"TaxKitApi\").pipe(\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        const website = Record.get(\n          result.compiled.resources,\n          \"TaxKitWebsite\"\n        ).pipe(\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        expect(api.Props).toBeDefined();\n        expect(website.Props).toBeDefined();\n        expect(isSelfUrl(api.Props.env?.API_PUBLIC_ORIGIN)).toBe(true);\n        expect(isSelfUrl(website.Props.env?.WEBSITE_PUBLIC_ORIGIN)).toBe(true);\n        expect(Record.keys(website.Props.env ?? {})).toEqual([\n          \"API_PUBLIC_ORIGIN\",\n          \"TAXKIT_API\",\n          \"WEBSITE_PUBLIC_ORIGIN\",\n        ]);\n        const apiNode = Record.get(plan.resources, \"TaxKitApi\").pipe(\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        const websiteNode = Record.get(plan.resources, \"TaxKitWebsite\").pipe(\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        const apiProps = \"props\" in apiNode ? apiNode.props : api.Props;\n        const websiteProps =\n          \"props\" in websiteNode ? websiteNode.props : website.Props;\n        // This is the actual native planned graph, not an assertion against\n        // an unused policy constant. Omitted metadata invokes SDK defaults.\n        const disabledPlatformTelemetry = Schema.Struct({\n          enabled: Schema.Literal(false),\n          headSamplingRate: Schema.Literal(0),\n          logs: Schema.Struct({\n            enabled: Schema.Literal(false),\n            headSamplingRate: Schema.Literal(0),\n            invocationLogs: Schema.Literal(false),\n            persist: Schema.Literal(false),\n          }),\n          traces: Schema.Struct({\n            enabled: Schema.Literal(false),\n            headSamplingRate: Schema.Literal(0),\n            persist: Schema.Literal(false),\n          }),\n        });\n        expect(\n          Schema.is(disabledPlatformTelemetry)(apiProps.observability)\n        ).toBe(true);\n        expect(\n          Schema.is(disabledPlatformTelemetry)(websiteProps.observability)\n        ).toBe(true);\n        const privateBinding = Option.fromNullishOr(website.Props.env).pipe(\n          Option.flatMap((env) => Record.get(env, \"TAXKIT_API\")),\n          Option.getOrElse(() => expect.fail(\"Expected native graph member\"))\n        );\n        expect(privateBinding).toBe(api);\n        expect(result.compiled.stage).toBe(\"dev_native_graph_proof\");\n        expect(result.compiled.name).toBe(\"TaxKitAppsGraphProof\");\n        const absent = yield* Output.evaluate(\n          {\n            api: websiteProps.env?.API_PUBLIC_ORIGIN,\n            website: apiProps.env?.WEBSITE_PUBLIC_ORIGIN,\n          },\n          { TaxKitApi: { url: undefined }, TaxKitWebsite: { url: null } }\n        ).pipe(Effect.provideContext(result.compiled.services));\n        expect(absent).toEqual({ api: null, website: null });\n        const resolved = yield* Output.evaluate(\n          {\n            api: websiteProps.env?.API_PUBLIC_ORIGIN,\n            website: apiProps.env?.WEBSITE_PUBLIC_ORIGIN,\n          },\n          {\n            TaxKitApi: { url: \"https://fresh-api.example.com\" },\n            TaxKitWebsite: { url: \"https://fresh-website.example.com\" },\n          }\n        ).pipe(Effect.provideContext(result.compiled.services));\n        expect(resolved).toEqual({\n          api: \"https://fresh-api.example.com\",\n          website: \"https://fresh-website.example.com\",\n        });\n      }).pipe(\n        Effect.provideService(AlchemyContext, localContext),\n        Effect.provideService(Stage, \"dev_native_graph_proof\"),\n        graphEnvironment,\n        Effect.scoped\n      )\n  );\n  it.live(\"refuses a cycle whose provider cannot precreate\", () =>\n    Effect.gen(function* () {\n      const result = yield* graphFixture(\"without-precreate\");\n      expect(result.providerWrites).toBe(0);\n      expect(Exit.isFailure(result.planned)).toBe(true);\n      expect(Exit.hasDies(result.planned)).toBe(true);\n      if (Exit.isFailure(result.planned)) {\n        const die = Cause.findDie(result.planned.cause).pipe(Result.getOrThrow);\n        expect(Predicate.isTagged(die.defect, \"UnsatisfiedResourceCycle\")).toBe(\n          true\n        );\n      }\n    }).pipe(\n      Effect.provideService(AlchemyContext, localContext),\n      Effect.provideService(Stage, \"dev_native_graph_proof\"),\n      graphEnvironment,\n      Effect.scoped\n    )\n  );\n});\n\ndescribe(\"native app root secret selection\", () => {\n  it.effect.each([\n    { config: \"prd\", stage: \"prod\" },\n    { config: \"stg_preview\", stage: \"pr-214\" },\n    { config: \"dev\", stage: \"dev_ci_user\" },\n  ])(\"selects taxkit/$config for $stage\", ({ config, stage }) =>\n    Effect.gen(function* () {\n      expect(yield* nativeAppsDopplerSelection(stage)).toEqual({\n        config,\n        project: \"taxkit\",\n      });\n    })\n  );\n  it.effect.each([\"prod-2\", \"pr-0\", \"dev\", \"private-stage-sentinel\"])(\n    \"rejects an invalid stage without retaining its value: %s\",\n    (stage) =>\n      Effect.gen(function* () {\n        const exit = yield* nativeAppsDopplerSelection(stage).pipe(Effect.exit);\n        expect(Exit.isFailure(exit)).toBe(true);\n        if (Exit.isFailure(exit)) {\n          expect(Cause.pretty(exit.cause)).toContain(\n            \"Native app stack stage is missing or invalid\"\n          );\n          expect(Cause.pretty(exit.cause)).not.toContain(stage);\n        }\n      })\n  );\n  it.live(\"keeps the selected configuration ahead of ambient PATH\", () =>\n    Effect.gen(function* () {\n      const compiled = yield* Stack.make({\n        name: \"TaxKitAppsSecretsProof\",\n        providers: Layer.empty,\n        secrets: (context) => [\n          ConfigProvider.layerAdd(\n            ConfigProvider.fromUnknown({ PATH: \"first-fixture-source\" }),\n            { asPrimary: true }\n          ),\n          ConfigProvider.layerAdd(\n            ConfigProvider.fromUnknown({ PATH: \"selected-doppler-fixture\" }),\n            { asPrimary: true }\n          ),\n          ...Array.drop(nativeAppsSecrets(context), 1),\n        ],\n        state: inMemoryState(),\n      })(Config.schema(Schema.String, \"PATH\"));\n      expect(compiled.output).toBe(\"selected-doppler-fixture\");\n    }).pipe(\n      Effect.provideService(AlchemyContext, localContext),\n      Effect.provideService(Stage, \"dev_native_graph_proof\"),\n      graphEnvironment,\n      Effect.scoped\n    )\n  );\n  it.live(\"rejects env-file selection before any credential or HTTP call\", () =>\n    Effect.gen(function* () {\n      const exit = yield* Stack.make({\n        name: \"TaxKitAppsSecretsProof\",\n        providers: Layer.empty,\n        secrets: nativeAppsSecrets,\n        state: inMemoryState(),\n      })(Effect.void).pipe(Effect.exit);\n      expect(Exit.isFailure(exit)).toBe(true);\n      if (Exit.isFailure(exit)) {\n        expect(Cause.pretty(exit.cause)).toContain(\n          \"--env-file cannot be combined\"\n        );\n        expect(Cause.pretty(exit.cause)).not.toContain(\"Unexpected\");\n      }\n    }).pipe(\n      Effect.provideService(StackConfigOverrides, {\n        envFile: \"native-proof.env\",\n      }),\n      Effect.provideService(AlchemyContext, localContext),\n      Effect.provideService(Stage, \"dev_native_graph_proof\"),\n      graphEnvironment,\n      Effect.scoped\n    )\n  );\n  it.live(\n    \"rejects the actual root stage before a credential or HTTP call\",\n    () =>\n      Effect.gen(function* () {\n        const exit = yield* Stack.make({\n          name: \"TaxKitAppsSecretsProof\",\n          providers: Layer.empty,\n          secrets: nativeAppsSecrets,\n          state: inMemoryState(),\n        })(Effect.void).pipe(Effect.exit);\n        expect(Exit.isFailure(exit)).toBe(true);\n        if (Exit.isFailure(exit)) {\n          expect(Cause.pretty(exit.cause)).toContain(\n            \"Native app stack stage is missing or invalid\"\n          );\n          expect(Cause.pretty(exit.cause)).not.toContain(\n            \"private-stage-sentinel\"\n          );\n          expect(Cause.pretty(exit.cause)).not.toContain(\"Unexpected\");\n        }\n      }).pipe(\n        Effect.provideService(AlchemyContext, localContext),\n        Effect.provideService(Stage, \"private-stage-sentinel\"),\n        graphEnvironment,\n        Effect.scoped\n      )\n  );\n});\nimport \"@tanstack/react-start/server-only\";\nimport { getRequest } from \"@tanstack/react-start/server\";\nimport { Effect, ErrorReporter, Schema } from \"effect\";\nimport { HttpServerError, HttpServerResponse } from \"effect/http\";\n\nimport { appRuntime } from \"./runtime.server\";\nimport { WebsiteCatalogueTransport, WebsiteSettingsTransport } from \"./schemas\";\nimport { WebsiteServerApplication } from \"./service.server\";\n\nexport const loadWebsiteSettingsServer = () =>\n  appRuntime.runPromise(\n    WebsiteServerApplication.pipe(\n      Effect.flatMap((application) =>\n        Effect.gen(function* () {\n          const settings = yield* application.settings.pipe(\n            Effect.result,\n            Effect.flatMap(Schema.encodeEffect(WebsiteSettingsTransport))\n          );\n          const catalogue = yield* application.catalogue.pipe(\n            Effect.result,\n            Effect.flatMap(Schema.encodeEffect(WebsiteCatalogueTransport))\n          );\n          return { catalogue, settings };\n        })\n      ),\n      Effect.orDie,\n      // Expected settings errors remain checked values. An unexpected failure\n      // reaches the host reporter and native empty response before TanStack can\n      // log or serialise an arbitrary Cause as a server-function error.\n      Effect.catchCause((cause) =>\n        HttpServerError.causeResponse(cause).pipe(\n          Effect.flatMap(([response, reportable]) =>\n            ErrorReporter.report(reportable).pipe(\n              Effect.as(HttpServerResponse.toWeb(response))\n            )\n          )\n        )\n      )\n    ),\n    { signal: getRequest().signal }\n  );\nimport {\n  Clock,\n  ByteSize,\n  Duration,\n  Effect,\n  Option,\n  Result,\n  Stream,\n} from \"effect\";\nimport {\n  Headers,\n  HttpClientRequest,\n  HttpServerRequest,\n  HttpServerResponse,\n} from \"effect/http\";\n\nimport {\n  CalculatorRequestBodyRejected,\n  CalculatorRequestBodyErrorEnvelope,\n  CalculatorRequestBodyPolicy,\n  CalculatorRequestBodyTimedOut,\n  CalculatorRequestBodyTooLarge,\n} from \"./schemas.js\";\n\nexport {\n  CalculatorRequestBodyRejected,\n  CalculatorRequestBodyErrorEnvelope,\n  CalculatorRequestBodyPolicy,\n  CalculatorRequestBodyTimedOut,\n  CalculatorRequestBodyTooLarge,\n} from \"./schemas.js\";\n\nexport const CalculatorRequestBodyLimit = ByteSize.kibibytes(64);\nexport const CalculatorRequestBodyDeadline = Duration.seconds(5);\n\n// Native web-request readers do not use MaxBodySize in this selected version.\n// Bound the native stream before materialising bytes, then reuse the native\n// request conversion rather than replacing JSON parsing or RPC framing.\nexport const withCalculatorRequestBodyLimit = <E, R>(\n  handler: Effect.Effect<HttpServerResponse.HttpServerResponse, E, R>,\n  policy: CalculatorRequestBodyPolicy = CalculatorRequestBodyPolicy.make({\n    responseFormat: \"json\",\n  })\n) =>\n  Effect.gen(function* () {\n    const incoming = yield* HttpServerRequest.HttpServerRequest;\n    if (incoming.method !== \"POST\") {\n      return yield* handler;\n    }\n    const started = yield* Clock.monotonicTimeNanos;\n    const readResult = yield* incoming.stream.pipe(\n      Stream.mapAccumEffect(\n        () => ByteSize.bytes(0),\n        (total, chunk) => {\n          const next = ByteSize.sum(total, ByteSize.bytes(chunk.byteLength));\n          return ByteSize.isGreaterThan(next, CalculatorRequestBodyLimit)\n            ? Effect.fail(new CalculatorRequestBodyRejected({ reason: \"size\" }))\n            : Effect.succeed([next, [chunk]] as const);\n        }\n      ),\n      Stream.mkUint8Array,\n      Effect.timeoutOrElse({\n        duration: CalculatorRequestBodyDeadline,\n        orElse: () =>\n          Effect.fail(\n            new CalculatorRequestBodyRejected({ reason: \"deadline\" })\n          ),\n      }),\n      Effect.map(Result.succeed),\n      Effect.catchTag(\"CalculatorRequestBodyRejected\", (error) =>\n        Effect.succeed(Result.fail(error))\n      )\n    );\n    const finished = yield* Clock.monotonicTimeNanos;\n    // Reject late synchronous reads once JavaScript returns control as well.\n    const read =\n      Result.isSuccess(readResult) &&\n      Duration.isGreaterThanOrEqualTo(\n        Duration.nanos(finished - started),\n        CalculatorRequestBodyDeadline\n      )\n        ? Result.fail(new CalculatorRequestBodyRejected({ reason: \"deadline\" }))\n        : readResult;\n    if (Result.isFailure(read)) {\n      const error =\n        read.failure.reason === \"size\"\n          ? new CalculatorRequestBodyTooLarge()\n          : new CalculatorRequestBodyTimedOut();\n      const status = read.failure.reason === \"size\" ? 413 : 408;\n      if (policy.responseFormat === \"html\") {\n        // Only fixed Schema-owned messages enter this page; never reflect input,\n        // request URLs, headers or private diagnostics into a rejected request.\n        return yield* HttpServerResponse.html`<!doctype html>\n          <html lang=\"en-AU\"><head><meta charset=\"utf-8\">\n          <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n          <title>Request could not be read | TaxKit</title></head>\n          <body><main><h1>Request could not be read</h1><p>${error.message}</p>\n          <a href=\"/\">Return to the calculators</a></main></body></html>`.pipe(\n          Effect.map((response) =>\n            HttpServerResponse.setStatus(response, status)\n          )\n        );\n      }\n      return yield* HttpServerResponse.schemaJson(\n        CalculatorRequestBodyErrorEnvelope\n      )({ error }, { status }).pipe(Effect.orDie);\n    }\n    const bytes = read.success;\n    const bounded = HttpServerRequest.toClientRequest(incoming)\n      .pipe(\n        HttpClientRequest.bodyUint8Array(\n          bytes,\n          Headers.get(incoming.headers, \"content-type\").pipe(\n            Option.getOrUndefined\n          )\n        ),\n        HttpServerRequest.fromClientRequest\n      )\n      .modify({ remoteAddress: incoming.remoteAddress, url: incoming.url });\n    return yield* handler.pipe(\n      Effect.provideService(HttpServerRequest.HttpServerRequest, bounded)\n    );\n  });\n\n  const processEvent = <T>(\n    makeEffect: (\n      build: WorkerBuild,\n    ) => readonly [Effect.Effect<any, any, any>, Context.Context<never>],\n    ctx: cf.ExecutionContext,\n    env: Record<string, unknown> | undefined,\n    onExit: (\n      exit: Exit.Exit<any, any>,\n      scope: Scope.Closeable,\n    ) => T | Promise<T>,\n  ): Promise<T> => {\n    const scope = Scope.makeUnsafe();\n    return build((promise) => ctx.waitUntil(promise as Promise<any>))\n      .then(\n        (built) => {\n          const [eff, services] = makeEffect(built);\n          return eff.pipe(\n            // Per-event services take precedence over the captured services\n            // and the built isolate context: the isolate context carries the\n            // *deferred* WorkerExecutionContext (yieldable in the top-level\n            // closure), which must be shadowed by the real per-event one\n            // here, and the fresh request `Scope` so `Effect.addFinalizer`\n            // in a handler attaches to the request scope (closed into\n            // `ctx.waitUntil` below).\n            Effect.provide(\n              Layer.mergeAll(\n                Layer.succeed(\n                  WorkerExecutionContext,\n                  fromExecutionContext(ctx, env),\n                ),\n                Layer.succeed(Scope.Scope, scope),\n                Layer.succeed(RuntimeContext, built.runtimeContext),\n                // The configured telemetry exporters. Constructed as part\n                // of this per-event layer, but `buildEventTelemetry`\n                // attaches their batching fibers and flush finalizers to\n                // the request `scope` (not this build's transient scope),\n                // so buffered telemetry flushes when the scope closes into\n                // `ctx.waitUntil` below — never on workerd's ephemeral\n                // isolate scope.\n                Layer.effectContext(\n                  buildEventTelemetry(built.context, scope, built.telemetry()),\n                ),\n              ).pipe(\n                Layer.provideMerge(Layer.succeedContext(services)),\n                Layer.provideMerge(Layer.succeedContext(built.context)),\n              ),\n            ),\n            Effect.runPromiseExit,\n"},"started_at_ms":1791264646814,"completed_at_ms":1791264646815}}
{"timestamp":"2026-10-06T05:30:46.881Z","ordinal":38636,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a10fb1-66e1-70f0-9a2e-60c9305b8f80","call_id":"call_cLm8TyuL8C2U13S9sLgsNhVL","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"d9ed22\",\"wall_time_seconds\":0.000008167,\"exit_code\":0,\"original_token_count\":4282,\"output\":\"Warning: truncated output (original token count: 4282)\\nTotal output lines: 472\\n\\nimport type * as cf from \\\"@cloudflare/workers-types\\\";\\nimport * as Effect from \\\"effect/Effect\\\";\\nimport type * as Binding from \\\"./Binding.ts\\\";\\nimport { makeBindingLayer } from \\\"./BindingLayer.ts\\\";\\nimport {\\n  RateLimit,\\n  RateLimitError,\\n  type RateLimitClient,\\n  type RateLimitPeriod,\\n} from \\\"./RateLimit.ts\\\";\\n\\n/** The binding value produced by calling {@link RateLimit} (declared on `env` or `yield*`-ed). */\\nexport type RateLimitBinding = Binding.Binding<\\n  RateLimit[\\\"key\\\"],\\n  RateLimitClient,\\n  RateLimit\\n> & {\\n  readonly namespaceId: string;\\n  readonly simple: { limit: number; period: RateLimitPeriod };\\n};\\n\\n/**\\n * The layer that provides the Effect-native interface for the Cloudflare\\n * Workers Rate Limit binding.\\n *\\n * Provide it on the Worker effect (`Effect.provide(Cloudflare.Workers.RateLimitBinding)`)\\n * so that yielding a {@link RateLimit} binding attaches the native `ratelimit`\\n * binding to the surrounding Worker at deploy time and, at runtime, resolves to\\n * the Effect-native {@link RateLimitClient}.\\n */\\nexport const RateLimitBinding = makeBindingLayer<\\n  RateLimit,\\n  cf.RateLimit,\\n  RateLimitClient\\n>(RateLimit, (raw) => ({\\n  raw,\\n  limit: (options) =>\\n    raw.pipe(\\n      Effect.flatMap((binding) =>\\n        Effect.tryPromise({\\n          try: () => binding.limit(options),\\n          catch: (error) =>\\n            new RateLimitError({\\n              message:\\n                error instanceof Error\\n                  ? error.message\\n                  : \\\"Unknown RateLimit error\\\",\\n              cause: error,\\n            }),\\n        }),\\n      ),\\n    ),\\n}));\\nrg: node_modules/alchemy/src/Cloudflare/Workers/Bindings.ts: No such file or directory (os error 2)\\nimport * as Context from \\\"effect/Context\\\";\\nimport * as Effect from \\\"effect/Effect\\\";\\nimport * as Layer from \\\"effect/Layer\\\";\\nimport * as Option from \\\"effect/Option\\\";\\nimport * as Redacted from \\\"effect/Redacted\\\";\\nimport type { HttpEffect } from \\\"./Http.ts\\\";\\nimport type { CallbackFactory } from \\\"./Callback.ts\\\";\\nimport type { Output } from \\\"./Output.ts\\\";\\n\\nexport interface BaseRuntimeContext {\\n  Type: string;\\n  id: string;\\n  env: Record<string, any>;\\n  /**\\n   * Read a value by its (already-canonical) key. The key is used verbatim;\\n   * callers must {@link sanitizeKey} first. See {@link sanitizeKey}.\\n   */\\n  get<T>(key: string): Effect.Effect<T | undefined>;\\n  /**\\n   * Store an output under the given (already-canonical) key, returning the key.\\n   * The key is used verbatim; callers must {@link sanitizeKey} first.\\n   */\\n  set(id: string, output: Output): Effect.Effect<string>;\\n  exports?: Effect.Effect<Record<string, any>>;\\n  /** Register a durable callback in the current host instance, when supported. */\\n  makeCallback?: CallbackFactory;\\n  serve?<Req = never>(\\n    handler: HttpEffect<Req>,\\n    options?: { shape?: Record<string, unknown> },\\n  ): Effect.Effect<void, never, Req>;\\n  shape?: () => Record<string, unknown>;\\n  /** additional services to provide to the plan  */\\n  planServices?: Layer.Layer<any>;\\n  /**\\n   * Telemetry exporter Layer registered during init via\\n   * `Telemetry.layer(...)` / `Telemetry.layerOtlp(...)` (see Telemetry.ts).\\n   * The runtime bridges build it into every event's request scope,\\n   * overriding the env-driven default.\\n   */\\n  telemetry?: Layer.Layer<never, any, any>;\\n}\\n\\n/**\\n * Keys a Platform's Init captured through {@link BaseRuntimeContext.set}\\n * (`yield* Config.x(...)`, `yield* output`). `Platform.make` attaches the\\n * runtime context to the resource and merges these values into its\\n * `props.env`.\\n */\\nexport const capturedEnvKeys = (resource: unknown): string[] => {\\n  const ctx = (resource as { RuntimeContext?: Partial<BaseRuntimeContext> })\\n    ?.RuntimeContext;\\n  return ctx?.env ? Object.keys(ctx.env) : [];\\n};\\n\\n/**\\n * Canonicalize a logical key into a key that is safe to use as the name of an\\n * environment variable / binding (`[a-zA-Z][a-zA-Z0-9_]*`).\\n *\\n * `RuntimeContext.set`/`get` are dumb key/value stores: they read and write the\\n * key **verbatim**. It is the *caller's* responsibility to hand them a\\n * canonical key, since the caller is the one that knows the logical key may\\n * contain `.`/`-` (e.g. a dotted config name from `Platform`, or an\\n * `Output.toString()` like `\\\"QueueSinkQueue.queueUrl\\\"`). Callers run the key\\n * through this before calling `set`/`get` so both sides agree.\\n */\\nexport const sanitizeKey = (key: string): string =>\\n  key.replaceAll(/[^a-zA-Z0-9]/g, \\\"_\\\");\\n\\n/**\\n * The wire format `RuntimeContext.set`/`get` use to carry a `Redacted` value\\n * through an environment variable. `JSON.stringify(Redacted)` emits the\\n * literal string `\\\"<redacted>\\\"` and loses the value, so secrets are\\n * serialized as this marker and the runtime `get` path rebuilds the wrapper.\\n */\\nexport interface RedactedMarker {\\n  readonly _tag: \\\"Redacted\\\";\\n  readonly value: unknown;\\n}\\n\\n/**\\n * Detect the (already JSON-parsed) {@link RedactedMarker} shape. After\\n * `JSON.parse` the marker is a plain object — `Redacted.isRedacted` is\\n * always `false` on it — so detection is structural.\\n */\\nexport const isRedactedMarker = (value: unknown): value is RedactedMarker =>\\n  typeof value === \\\"object\\\" &&\\n  value !== null &&\\n  (value as { _tag?: unknown })._tag === \\\"Redacted\\\" &&\\n  \\\"value\\\" in value;\\n\\n/**\\n * Returns true when {@link unpackEnvValue}'s `JSON.parse` would reinterpret\\n * the raw string as something other than itself — a number (`\\\"123\\\"`), a\\n * boolean, `null`, or a JSON document. Such strings must stay\\n * `JSON.stringify`-packed; everything else round-trips verbatim through the\\n * parse-failure fallback.\\n */\\nconst parsesAsJson = (value: string): boolean => {\\n  try {\\n    JSON.parse(value);\\n    return true;\\n  } catch {\\n    return false;\\n  }\\n};\\n\\n/**\\n * Serialize a binding value for an env var: `Redacted` values are packed as\\n * a {@link RedactedMarker}, non-string values as JSON.\\n *\\nimport {\\n  createStartHandler,\\n  defaultStreamHandler,\\n} from \\\"@tanstack/react-start/server\\\";\\nimport {\\n  CalculatorRequestBodyPolicy,\\n  withCalculatorRequestBodyLimit,\\n} from \\\"@taxkit/api-http/request-boundary\\\";\\nimport { AuAnnualTaxCalculatorId } from \\\"@taxkit/rules-au-income-tax/schemas\\\";\\nimport { AuPayCalculatorId } from \\\"@taxkit/rules-au-pay/schemas\\\";\\nimport { Effect, ErrorReporter, Match, Schema } from \\\"effect\\\";\\nimport {\\n  HttpServerError,\\n  HttpServerRequest,\\n  HttpServerResponse,\\n} from \\\"effect/http\\\";\\n\\nimport { WebsiteServerFunctionBase } from \\\"./lib/config\\\";\\nimport {\\n  takeHomeRequestFromForm,\\n  annualTaxRequestFromForm,\\n  AnnualTaxForm,\\n  TakeHomeForm,\\n  WebsiteInputError,\\n} from \\\"./lib/form.boundary\\\";\\nimport type { WebsiteCalculatorForm } from \\\"./lib/form.boundary\\\";\\nimport { WebsiteSettingsFunctionPath } from \\\"./lib/loaders\\\";\\nimport { appRuntime } from \\\"./lib/runtime.server\\\";\\nimport { WebsiteSubmission, WebsiteSubmissionTransport } from \\\"./lib/schemas\\\";\\nimport type { WebsiteServerRenderContext } from \\\"./lib/schemas\\\";\\nimport { WebsiteServerApplication } from \\\"./lib/service.server\\\";\\n\\nconst render = createStartHandler<{\\n  server: { requestContext: WebsiteServerRenderContext };\\n}>(defaultStreamHandler);\\n\\nexport default {\\n  fetch: (request: Request) =>\\n    // A standard HTML form remains usable without JavaScript. Its checked\\n    // request reaches the same named RPC client through the private binding.\\n    // Only plain, Schema-encoded form/report data reaches TanStack rendering.\\n    appRuntime.runPromise(\\n      Effect.gen(function* websiteRequest() {\\n        const url = new URL(request.url);\\n        const calculatorId = Match.value(url.pathname).pipe(\\n          Match.when(\\\"/calculators/au.income-tax.annual\\\", () =>\\n            AuAnnualTaxCalculatorId.make(\\\"au.income-tax.annual\\\")\\n          ),\\n          Match.when(\\\"/calculators/au.pay.withholdings\\\", () =>\\n            AuPayCalculatorId.make(\\\"au.pay.withholdings\\\")\\n          ),\\n          Match.when(\\\"/\\\", () => AuPayCalculatorId.make(\\\"au.pay.take-home\\\")),\\n          Match.orElse(() => null)\\n        );\\n        if (url.pathname.startsWith(`${WebsiteServerFunctionBase}/`)) {\\n          if (url.pathname !== WebsiteSettingsFunctionPath) {\\n            return HttpServerResponse.empty({ status: 404 });\\n          }\\n          // The only native server function reads settings and takes no data or\\n          // client Context. Reject representation input before the framework's\\n          // JSON/FormData parser can reflect it in an unexpected error.\\n          if (requ…82 tokens truncated…calculatorId === null) {\\n          return HttpServerResponse.empty({ status: 404 });\\n        }\\n        return yield* request.method !== \\\"POST\\\" || calculatorId === null\\n          ? Effect.promise(() =>\\n              Promise.resolve(render(request, { context: {} }))\\n            ).pipe(Effect.map(HttpServerResponse.fromWeb))\\n          : withCalculatorRequestBodyLimit(\\n              Effect.gen(function* () {\\n                const incoming = yield* HttpServerRequest.HttpServerRequest;\\n                const bounded = yield* HttpServerRequest.toWeb(incoming, {\\n                  signal: request.signal,\\n                });\\n                const data = yield* Effect.tryPromise({\\n                  catch: () =>\\n                    new WebsiteInputError({\\n                      message: \\\"Enter a valid pay amount and pay period.\\\",\\n                    }),\\n                  try: () => bounded.formData(),\\n                });\\n                const decodedForm: Effect.Effect<\\n                  WebsiteCalculatorForm,\\n                  Schema.SchemaError\\n                > =\\n                  calculatorId === \\\"au.income-tax.annual\\\"\\n                    ? Schema.decodeUnknownEffect(AnnualTaxForm)({\\n                        taxableDollars: data.get(\\\"taxableDollars\\\"),\\n                      })\\n                    : Schema.decodeUnknownEffect(TakeHomeForm)({\\n                        grossDollars: data.get(\\\"grossDollars\\\"),\\n                        period: data.get(\\\"period\\\"),\\n                        taxFreeThresholdClaimed:\\n                          data.get(\\\"taxFreeThresholdClaimed\\\") === \\\"on\\\",\\n                      });\\n                const form = yield* decodedForm.pipe(\\n                  Effect.mapError(\\n                    () =>\\n                      new WebsiteInputError({\\n                        message: \\\"Enter a valid pay amount and pay period.\\\",\\n                      })\\n                  )\\n                );\\n                const result = yield* (\\n                  Schema.is(AnnualTaxForm)(form)\\n                    ? annualTaxRequestFromForm(form)\\n                    : takeHomeRequestFromForm(\\n                        form,\\n                        AuPayCalculatorId.make(\\n                          calculatorId === \\\"au.pay.withholdings\\\"\\n                            ? \\\"au.pay.withholdings\\\"\\n                            : \\\"au.pay.take-home\\\"\\n                        )\\n                      )\\n                ).pipe(\\n                  Effect.fromResult,\\n                  Effect.flatMap((input) =>\\n                    WebsiteServerApplication.pipe(\\n                      Effect.flatMap((application) =>\\n                        application.calculate(input)\\n                      )\\n                    )\\n                  ),\\n                  Effect.result\\n                );\\n                const submission = yield* Schema.encodeEffect(\\n                  WebsiteSubmissionTransport\\n                )(WebsiteSubmission.make({ calculatorId, form, result })).pipe(\\n                  Effect.orDie\\n                );\\n                const headers = new Headers(request.headers);\\n                headers.delete(\\\"content-length\\\");\\n                headers.delete(\\\"content-type\\\");\\n                const response = yield* Effect.promise(() =>\\n                  Promise.resolve(\\n                    render(\\n                      new Request(request.url, {\\n                        headers,\\n                        method: \\\"GET\\\",\\n                        signal: request.signal,\\n                      }),\\n                      { context: { submission } }\\n                    )\\n                  )\\n                );\\n                return HttpServerResponse.fromWeb(response);\\n              }),\\n              CalculatorRequestBodyPolicy.make({ responseFormat: \\\"html\\\" })\\n            ).pipe(\\n              Effect.catchTag(\\\"WebsiteInputError\\\", () =>\\n                Effect.succeed(HttpServerResponse.empty({ status: 400 }))\\n              )\\n            );\\n      }).pipe(\\n        // Native HTTP failure matching preserves aborts and safe empty errors.\\n        // The installed host reporter discards arbitrary Causes before logging.\\n        Effect.catchCause((cause) =>\\n          HttpServerError.causeResponse(cause).pipe(\\n            Effect.flatMap(([response, reportable]) =>\\n              ErrorReporter.report(reportable).pipe(Effect.as(response))\\n            )\\n          )\\n        ),\\n        Effect.provideService(\\n          HttpServerRequest.HttpServerRequest,\\n          HttpServerRequest.fromWeb(request)\\n        ),\\n        Effect.scoped,\\n        Effect.map(HttpServerResponse.toWeb)\\n      ),\\n      { signal: request.signal }\\n    ),\\n};\\nimport { describe, expect, it } from \\\"@effect/vitest\\\";\\nimport { CalculationEngineLive } from \\\"@taxkit/core\\\";\\nimport { Money, Cents } from \\\"@taxkit/core/primitives\\\";\\nimport { AuPayCalculatorId, GrossPay } from \\\"@taxkit/rules-au-pay\\\";\\nimport { expectAt } from \\\"@taxkit/testing\\\";\\nimport {\\n  Array,\\n  Cause,\\n  Clock,\\n  Context,\\n  Deferred,\\n  Effect,\\n  Exit,\\n  Fiber,\\n  Layer,\\n  Match,\\n  Option,\\n  Ref,\\n  Result,\\n} from \\\"effect\\\";\\nimport { TestClock } from \\\"effect/testing\\\";\\n\\nimport { PublicCalculatorServiceLive } from \\\"../src/live.layer.js\\\";\\nimport {\\n  CalculatorCapacityExceeded,\\n  CalculatorOperationTimedOut,\\n  CalculatorRunServiceRequest,\\n  MetadataQuery,\\n  DescriptorFilterQuery,\\n  GetCalculatorRequest,\\n  GetCalculatorGraphRequest,\\n  UnsupportedCalculatorError,\\n} from \\\"../src/schemas.js\\\";\\nimport { PublicCalculatorService } from \\\"../src/service.js\\\";\\nimport { PublicCalculatorServiceBounded } from \\\"../src/work.layer.js\\\";\\n\\nconst Request = CalculatorRunServiceRequest.make({\\n  calculatorId: AuPayCalculatorId.make(\\\"au.pay.take-home\\\"),\\n  payload: {\\n    facts: {\\n      grossPay: new GrossPay({\\n        amount: new Money({ cents: Cents.make(165_400), currency: \\\"AUD\\\" }),\\n        period: \\\"weekly\\\",\\n      }),\\n      taxFreeThresholdClaimed: true,\\n    },\\n  },\\n});\\nconst MetadataWorkCases = [\\n  {\\n    invoke: (service: PublicCalculatorService[\\\"Service\\\"]) =>\\n      service\\n        .getCalculator(\\n          GetCalculatorRequest.make({ calculatorId: Request.calculatorId })\\n        )\\n        .pipe(Effect.asVoid),\\n    operation: \\\"getCalculator\\\",\\n    substitute: (\\n      service: PublicCalculatorService[\\\"Service\\\"],\\n      work: Effect.Effect<never>\\n    ) => PublicCalculatorService.of({ ...service, getCalculator: () => work }),\\n  },\\n  {\\n    invoke: (service: PublicCalculatorService[\\\"Service\\\"]) =>\\n      service\\n        .getCalculatorGraph(\\n          GetCalculatorGraphRequest.make({ calculatorId: Request.calculatorId })\\n        )\\n        .pipe(Effect.asVoid),\\n    operation: \\\"getCalculatorGraph\\\",\\n    substitute: (\\n      service: PublicCalculatorService[\\\"Service\\\"],\\n      work: Effect.Effect<never>\\n    ) =>\\n      PublicCalculatorService.of({\\n        ...service,\\n        getCalculatorGraph: () => work,\\n      }),\\n  },\\n  {\\n    invoke: (service: PublicCalculatorService[\\\"Service\\\"]) =>\\n      service\\n        .getCalculatorSchema(\\n          GetCalculatorRequest.make({ calculatorId: Request.calculatorId })\\n        )\\n        .pipe(Effect.asVoid),\\n    operation: \\\"getCalculatorSchema\\\",\\n    substitute: (\\n      service: PublicCalculatorService[\\\"Service\\\"],\\n      work: Effect.Effect<never>\\n    ) =>\\n      PublicCalculatorService.of({\\n        ...service,\\n        getCalculatorSchema: () => work,\\n      }),\\n  },\\n  {\\n    invoke: (service: PublicCalculatorService[\\\"Service\\\"]) =>\\n      service.listCalculators(MetadataQuery.make({})).pipe(Effect.asVoid),\\n    operation: \\\"listCalculators\\\",\\n    substitute: (\\n      service: PublicCalculatorService[\\\"Service\\\"],\\n      work: Effect.Effect<never>\\n    ) =>\\n      PublicCalculatorService.of({ ...service, listCalculators: () => work }),\\n  },\\n  {\\n    invoke: (service: PublicCalculatorService[\\\"Service\\\"]) =>\\n      service.listFacts(DescriptorFilterQuery.make({})).pipe(Effect.asVoid),\\n    operation: \\\"listFacts\\\",\\n    substitute: (\\n      service: PublicCalculatorService[\\\"Service\\\"],\\n      work: Effect.Effect<never>\\n    ) => PublicCalculatorService.of({ ...service, listFacts: () => work }),\\n  },\\n  {\\n    invoke: (service: PublicCalculatorService[\\\"Service\\\"]) =>\\n      service.listJurisdictions().pipe(Effect.asVoid),\\n    operation: \\\"listJurisdictions\\\",\\n    substitute: (\\n      service: PublicCalculatorService[\\\"Service\\\"],\\n      work: Effect.Effect<never>\\n    ) =>\\n      PublicCalculatorService.of({ ...service, listJurisdictions: () => work }),\\n  },\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"e509fd\",\"wall_time_seconds\":0.00000875,\"exit_code\":0,\"original_token_count\":5826,\"output\":\"Warning: truncated output (original token count: 5826)\\nTotal output lines: 622\\n\\nimport { BunServices } from \\\"@effect/platform-bun\\\";\\nimport { describe, expect, it } from \\\"@effect/vitest\\\";\\nimport { AlchemyContext } from \\\"alchemy/AlchemyContext\\\";\\nimport { ArtifactStore, createArtifactStore } from \\\"alchemy/Artifacts\\\";\\nimport { AuthProviders } from \\\"alchemy/Auth/AuthProvider\\\";\\nimport { CredentialsStore } from \\\"alchemy/Auth/Credentials\\\";\\nimport { ProfileStore } from \\\"alchemy/Auth/Profile\\\";\\nimport { Providers } from \\\"alchemy/Cloudflare\\\";\\nimport { Worker, isSelfUrl } from \\\"alchemy/Cloudflare/Workers\\\";\\nimport { layerNonInteractive } from \\\"alchemy/Interaction\\\";\\nimport * as Output from \\\"alchemy/Output\\\";\\nimport * as Plan from \\\"alchemy/Plan\\\";\\nimport * as Provider from \\\"alchemy/Provider\\\";\\nimport * as Stack from \\\"alchemy/Stack\\\";\\nimport { Stage } from \\\"alchemy/Stage\\\";\\nimport { inMemoryState, State } from \\\"alchemy/State\\\";\\nimport { StackConfigOverrides } from \\\"alchemy/Util/ConfigProvider\\\";\\nimport {\\n  Array,\\n  Cause,\\n  Config,\\n  ConfigProvider,\\n  Effect,\\n  Exit,\\n  Layer,\\n  Option,\\n  Order,\\n  Predicate,\\n  Record,\\n  Ref,\\n  Result,\\n  Schema,\\n} from \\\"effect\\\";\\nimport { HttpClient } from \\\"effect/http\\\";\\n\\nimport {\\n  nativeAppsDopplerSelection,\\n  nativeAppsSecrets,\\n} from \\\"./apps-secrets.boundary.js\\\";\\nimport { declareNativeAppsStack } from \\\"./apps-stack.js\\\";\\n\\nconst graphFixture = Effect.fnUntraced(function* (\\n  mode: \\\"create\\\" | \\\"noop\\\" | \\\"update\\\" | \\\"without-precreate\\\"\\n) {\\n  const providerWrites = yield* Ref.make(0);\\n  const forbiddenWrite = Ref.update(providerWrites, (count) => count + 1).pipe(\\n    Effect.andThen(Effect.die(\\\"Provider writes are forbidden in graph proof\\\"))\\n  );\\n  const workerService = Worker.Provider.of({\\n    delete: () => forbiddenWrite,\\n    diff: () =>\\n      Effect.succeed(\\n        mode === \\\"update\\\"\\n          ? { action: \\\"update\\\", stables: [\\\"workerId\\\"] }\\n          : { action: \\\"noop\\\" }\\n      ),\\n    list: () => Effect.die(\\\"Unexpected provider enumeration\\\"),\\n    read: ({ output }: { readonly output: Worker[\\\"Attributes\\\"] | undefined }) =>\\n      Effect.succeed(output),\\n    reconcile: () => forbiddenWrite,\\n  });\\n  const workerProvider = Provider.effect(\\n    Worker,\\n    Effect.succeed(\\n      mode === \\\"without-precreate\\\"\\n        ? workerService\\n        : { ...workerService, precreate: () => forbiddenWrite }\\n    )\\n  );\\n  const stateLayer = inMemoryState();\\n  const providers = Layer.merge(\\n    Layer.effect(\\n      Providers,\\n      Provider.collection([Worker]).pipe(Effect.provide(workerProvider))\\n    ),\\n    stateLayer\\n  );\\n  // The actual graph uses only Worker providers. Its public upstream type names\\n  // the complete Cloudflare provider union; absent providers would still fail\\n  // native planning rather than receive invented services.\\n  const compiled = yield* Stack.make<Providers | State>({\\n    name: \\\"TaxKitAppsGraphProof\\\",\\n    providers,\\n    state: stateLayer,\\n  })(declareNativeAppsStack);\\n  if (mode === \\\"noop\\\" || mode === \\\"update\\\") {\\n    const state = yield* State.pipe(Effect.provideContext(compiled.services));\\n    const store = yield* state;\\n    yield* Effect.forEach(Record.values(compiled.resources), (resource) =>\\n      store.set({\\n        fqn: resource.FQN,\\n        stack: compiled.name,\\n        stage: compiled.stage,\\n        value: {\\n          attr: {\\n            accountId: \\\"graph-proof-account\\\",\\n            crons: [],\\n            durableObjectNamespaces: {},\\n            routes: [],\\n            url:\\n              resource.LogicalId === \\\"TaxKitApi\\\"\\n                ? \\\"https://api.example.com\\\"\\n                : \\\"https://website.example.com\\\",\\n            urls: [],\\n            workerId: `proof-${resource.LogicalId}`,\\n            workerName: resource.LogicalId,\\n          },\\n          bindings: [],\\n          downstream: [],\\n          fqn: resource.FQN,\\n          instanceId: `proof-${resource.LogicalId}`,\\n          logicalId: resource.LogicalId,\\n          namespace: resource.Namespace,\\n          props: {},\\n          providerVersion: 0,\\n          resourceType: resource.Type,\\n          status: \\\"created\\\",\\n        },\\n      })\\n    );\\n  }\\n  const planned = yield* Plan.make(compiled).pipe(\\n    Effect.provideContext(compiled.services),\\n    Effect.timeout(\\\"1 second\\\"),\\n    Effect.exit\\n  );\\n  return { compiled, planned, providerWrites: yield* Ref.get(providerWrites) };\\n});\\n\\nconst graphEnvironment = Effect.provide(\\n  Layer.mergeAll(\\n    BunServices.layer,\\n    Layer.succeed(ArtifactStore, createArtifactStore()),\\n    Layer.succeed(AuthProviders, {}),\\n    layerNonInteractive(),\\n    Layer.succeed(\\n      ProfileStore,\\n      ProfileStore.of({\\n        createProfile: () => Effect.die(\\\"Unexpected profile write\\\"),\\n        current: Effect.die(\\\"Unexpected profile read\\\"),\\n        deleteProfile: () => Effect.die(\\\"Unexpected profile write\\\"),\\n        deleteProviderConfig: () => Effect.die(\\\"Unexpected profile write\\\"),\\n        ensureProfile: () => Effect.die(\\\"Unexpected profile write\\\"),\\n        getProfile: () => Effect.die(\\\"Unexpected profile read\\\"),\\n        loadProviderConfig: () => Effect.die(\\\"Unexpected profile read\\\"),\\n        readManifest: Effect.die(\\\"Unexpected profile read\\\"),\\n        renameProfile: () => Effect.die(\\\"Unexpected profile write\\\"),\\n        setProviderConfig: () => Effect.die(\\\"Unexpected profile write\\\"),\\n      })\\n    ),\\n    Layer.succeed(\\n      CredentialsStore,\\n      CredentialsStore.of({\\n        delete: () => Effect.die(\\\"Unexpected credential write\\\"),\\n        deleteProfile: () => Effect.die(\\\"Unexpected credential write\\\"),\\n        read: () => Effect.die(\\\"Unexpected credential read\\\"),\\n        write: () => Effect.die(\\\"Unexpected credential write\\\"),\\n      })\\n    ),\\n    HttpClient.layerMergedContext(\\n      Effect.succeed(\\n        HttpClient.make(() => Effect.die(\\\"Unexpected network access\\\"))\\n      )\\n    )\\n  )\\n);\\nconst localContext = {\\n  adopt: false,\\n  dev: false,\\n  dotAlchemy: \\\"tmp/native-apps-graph-proof\\\",\\n};\\n\\ndescribe(\\\"native paired app graph and planner\\\", () => {\\n  it.live.each([\\\"create\\\", \\\"noop\\\", \\\"update\\\"] as const)(\\n    \\\"keeps the actual circular address graph live for %s\\\",\\n    (mode) =>\\n      Effect.gen(function* () {\\n        const result = yield* graphFixture(mode);\\n        expect(result.providerWrites).toBe(0);\\n        const plan = yield* result.planned;\\n        expect(Array.sort(Record.keys(plan.resources), Order.String)).toEqual([\\n          \\\"TaxKitApi\\\",\\n          \\\"TaxKitWebsite\\\",\\n        ]);\\n        expect(\\n          Array.sort(Array.fromIterable(plan.cycleMembers), Order.String)\\n   …2626 tokens truncated…latorRequestBodyRejected,\\n  CalculatorRequestBodyErrorEnvelope,\\n  CalculatorRequestBodyPolicy,\\n  CalculatorRequestBodyTimedOut,\\n  CalculatorRequestBodyTooLarge,\\n} from \\\"./schemas.js\\\";\\n\\nexport {\\n  CalculatorRequestBodyRejected,\\n  CalculatorRequestBodyErrorEnvelope,\\n  CalculatorRequestBodyPolicy,\\n  CalculatorRequestBodyTimedOut,\\n  CalculatorRequestBodyTooLarge,\\n} from \\\"./schemas.js\\\";\\n\\nexport const CalculatorRequestBodyLimit = ByteSize.kibibytes(64);\\nexport const CalculatorRequestBodyDeadline = Duration.seconds(5);\\n\\n// Native web-request readers do not use MaxBodySize in this selected version.\\n// Bound the native stream before materialising bytes, then reuse the native\\n// request conversion rather than replacing JSON parsing or RPC framing.\\nexport const withCalculatorRequestBodyLimit = <E, R>(\\n  handler: Effect.Effect<HttpServerResponse.HttpServerResponse, E, R>,\\n  policy: CalculatorRequestBodyPolicy = CalculatorRequestBodyPolicy.make({\\n    responseFormat: \\\"json\\\",\\n  })\\n) =>\\n  Effect.gen(function* () {\\n    const incoming = yield* HttpServerRequest.HttpServerRequest;\\n    if (incoming.method !== \\\"POST\\\") {\\n      return yield* handler;\\n    }\\n    const started = yield* Clock.monotonicTimeNanos;\\n    const readResult = yield* incoming.stream.pipe(\\n      Stream.mapAccumEffect(\\n        () => ByteSize.bytes(0),\\n        (total, chunk) => {\\n          const next = ByteSize.sum(total, ByteSize.bytes(chunk.byteLength));\\n          return ByteSize.isGreaterThan(next, CalculatorRequestBodyLimit)\\n            ? Effect.fail(new CalculatorRequestBodyRejected({ reason: \\\"size\\\" }))\\n            : Effect.succeed([next, [chunk]] as const);\\n        }\\n      ),\\n      Stream.mkUint8Array,\\n      Effect.timeoutOrElse({\\n        duration: CalculatorRequestBodyDeadline,\\n        orElse: () =>\\n          Effect.fail(\\n            new CalculatorRequestBodyRejected({ reason: \\\"deadline\\\" })\\n          ),\\n      }),\\n      Effect.map(Result.succeed),\\n      Effect.catchTag(\\\"CalculatorRequestBodyRejected\\\", (error) =>\\n        Effect.succeed(Result.fail(error))\\n      )\\n    );\\n    const finished = yield* Clock.monotonicTimeNanos;\\n    // Reject late synchronous reads once JavaScript returns control as well.\\n    const read =\\n      Result.isSuccess(readResult) &&\\n      Duration.isGreaterThanOrEqualTo(\\n        Duration.nanos(finished - started),\\n        CalculatorRequestBodyDeadline\\n      )\\n        ? Result.fail(new CalculatorRequestBodyRejected({ reason: \\\"deadline\\\" }))\\n        : readResult;\\n    if (Result.isFailure(read)) {\\n      const error =\\n        read.failure.reason === \\\"size\\\"\\n          ? new CalculatorRequestBodyTooLarge()\\n          : new CalculatorRequestBodyTimedOut();\\n      const status = read.failure.reason === \\\"size\\\" ? 413 : 408;\\n      if (policy.responseFormat === \\\"html\\\") {\\n        // Only fixed Schema-owned messages enter this page; never reflect input,\\n        // request URLs, headers or private diagnostics into a rejected request.\\n        return yield* HttpServerResponse.html`<!doctype html>\\n          <html lang=\\\"en-AU\\\"><head><meta charset=\\\"utf-8\\\">\\n          <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n          <title>Request could not be read | TaxKit</title></head>\\n          <body><main><h1>Request could not be read</h1><p>${error.message}</p>\\n          <a href=\\\"/\\\">Return to the calculators</a></main></body></html>`.pipe(\\n          Effect.map((response) =>\\n            HttpServerResponse.setStatus(response, status)\\n          )\\n        );\\n      }\\n      return yield* HttpServerResponse.schemaJson(\\n        CalculatorRequestBodyErrorEnvelope\\n      )({ error }, { status }).pipe(Effect.orDie);\\n    }\\n    const bytes = read.success;\\n    const bounded = HttpServerRequest.toClientRequest(incoming)\\n      .pipe(\\n        HttpClientRequest.bodyUint8Array(\\n          bytes,\\n          Headers.get(incoming.headers, \\\"content-type\\\").pipe(\\n            Option.getOrUndefined\\n          )\\n        ),\\n        HttpServerRequest.fromClientRequest\\n      )\\n      .modify({ remoteAddress: incoming.remoteAddress, url: incoming.url });\\n    return yield* handler.pipe(\\n      Effect.provideService(HttpServerRequest.HttpServerRequest, bounded)\\n    );\\n  });\\n\\n  const processEvent = <T>(\\n    makeEffect: (\\n      build: WorkerBuild,\\n    ) => readonly [Effect.Effect<any, any, any>, Context.Context<never>],\\n    ctx: cf.ExecutionContext,\\n    env: Record<string, unknown> | undefined,\\n    onExit: (\\n      exit: Exit.Exit<any, any>,\\n      scope: Scope.Closeable,\\n    ) => T | Promise<T>,\\n  ): Promise<T> => {\\n    const scope = Scope.makeUnsafe();\\n    return build((promise) => ctx.waitUntil(promise as Promise<any>))\\n      .then(\\n        (built) => {\\n          const [eff, services] = makeEffect(built);\\n          return eff.pipe(\\n            // Per-event services take precedence over the captured services\\n            // and the built isolate context: the isolate context carries the\\n            // *deferred* WorkerExecutionContext (yieldable in the top-level\\n            // closure), which must be shadowed by the real per-event one\\n            // here, and the fresh request `Scope` so `Effect.addFinalizer`\\n            // in a handler attaches to the request scope (closed into\\n            // `ctx.waitUntil` below).\\n            Effect.provide(\\n              Layer.mergeAll(\\n                Layer.succeed(\\n                  WorkerExecutionContext,\\n                  fromExecutionContext(ctx, env),\\n                ),\\n                Layer.succeed(Scope.Scope, scope),\\n                Layer.succeed(RuntimeContext, built.runtimeContext),\\n                // The configured telemetry exporters. Constructed as part\\n                // of this per-event layer, but `buildEventTelemetry`\\n                // attaches their batching fibers and flush finalizers to\\n                // the request `scope` (not this build's transient scope),\\n                // so buffered telemetry flushes when the scope closes into\\n                // `ctx.waitUntil` below — never on workerd's ephemeral\\n                // isolate scope.\\n                Layer.effectContext(\\n                  buildEventTelemetry(built.context, scope, built.telemetry()),\\n                ),\\n              ).pipe(\\n                Layer.provideMerge(Layer.succeedContext(services)),\\n                Layer.provideMerge(Layer.succeedContext(built.context)),\\n              ),\\n            ),\\n            Effect.runPromiseExit,\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10fab-f789-7f30-a7de-963ccee8ae9f","create_time":1791264646.881313}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
