erge, publication, deployment, provider mutation or Medicare correction is included.\\nweb test:native-pair: stdout | test/native-rpc-failures.boundary.test.ts > shares native HTTP, RPC batch and browser work limits\\nweb test:native-pair: [16:48:53.115] ERROR (#19): [Error [AssertionError]: expected '\\\"{\\\\\\\"event\\\\\\\":\\\\\\\"api.runtime.event\\\\\\\",\\\\\\\"l…' to contain 'Warn'] {\\nweb test:native-pair:   actual: '\\\"{\\\\\\\\\\\"event\\\\\\\\\\\":\\\\\\\\\\\"api.runtime.event\\\\\\\\\\\",\\\\\\\\\\\"level\\\\\\\\\\\":\\\\\\\\\\\"Error\\\\\\\\\\\",\\\\\\\\\\\"timestamp\\\\\\\\\\\":\\\\\\\\\\\"2026-10-06T05:48:53.086Z\\\\\\\\\\\"}\\\"',\\nweb test:native-pair:   expected: 'Warn',\\nweb test:native-pair:   showDiff: true,\\nweb test:native-pair:   operator: 'strictEqual',\\nweb test:native-pair:   [cause]: undefined\\nweb test:native-pair: }\\nweb test:native-pair: \\nweb test:native-pair:  ❯ test/native-rpc-failures.boundary.test.ts (2 tests | 2 failed) 1672ms\\nweb test:native-pair:    × contains native global, procedure and fatal RPC replies in real Workers 792ms\\nweb test:native-pair:    × shares native HTTP, RPC batch and browser work limits 879ms\\n        const operation =\\n          phase === \\\"body\\\"\\n            ? `Effect.map((response) => ${reply})`\\n            : `Effect.flatMap((response) => Effect.logWarning(\\\"PRIVATE9 headers\\\").pipe(\\n              Effect.andThen(Effect.sleep(\\\"12 seconds\\\")),\\n              Effect.as(response),\\n              Effect.provideContext(telemetry)\\n            ))`;\\n        const injected = original\\n          .replace(\\n            imports,\\n            'import { Effect, Layer, Stream } from \\\"effect\\\";\\\\nimport { Headers, HttpServerResponse } from \\\"effect/http\\\";\\\\nimport { ApiSafeTelemetryLive } from \\\"./worker-telemetry.layer.js\\\";'\\n          )\\n          .replace(\\n            declaration,\\n            `${declaration}\\n          Effect.flatMap((application) => Effect.gen(function* () {\\n            const telemetry = yield* Layer.build(ApiSafeTelemetryLive);\\n            return { fetch: application.fetch.pipe(${operation}) };\\n          })),`\\n          );\\n        yield* fs.writeFileString(owner, injected);\\n        const fixtureId =\\n          phase === \\\"body\\\" ? \\\"TaxKitApiStalledBody\\\" : \\\"TaxKitApiStalledHeaders\\\";\\n        yield* fs.remove(path.join(output, \\\"bundles\\\", fixtureId), {\\n          force: true,\\n          recursive: true,\\n        });\\n        const props = {\\n          compatibility,\\n          main: import.meta.resolve(\\\"api/worker\\\"),\\n        };\\n        const artifacts = scopedArtifacts(fixtureId);\\n        const source = yield* resolveSource(props).pipe(\\n          Effect.provide(artifacts)\\n        );\\n        yield* source\\n          .build(\\n138:  bindings: BindingNode<R[\\\"Binding\\\"]>[];\\n316:const describeBinding = (binding: BindingNode): PlannedBinding => ({\\n317:  sid: binding.sid,\\n318:  action: binding.action,\\n327:  bindings: node.bindings.map(describeBinding),\\n351: * bindings and provider modes, orphan deletions, and stack actions.\\n383:   * and binding dependencies. An empty selection is an error. Other rows\\n390:   * Historical bindings require selecting every persisted resource and Action\\n391:   * for replacement/GC. Clearing the last binding evidence also requires that\\n392:   * complete selection, since stored payloads cannot recover binding-cycle edges.\\n393:   * Only already-persisted, continuously retained bindings count as evidence.\\n438:            : [node.Props, stack.bindings[node.FQN] ?? []],\\n561:    // Updating snapshots also retain prior bindings and downstream metadata.\\n564:      bindings?: ReadonlyArray<unknown>;\\n842:              // A fresh resource has no stable output. A member of a binding\\n871:              // Normalize both sides through `dedupeBindings` so the binding\\n875:              const oldBindings = dedupeBindings(oldState.bindings ?? []);\\n876:              const bindings = stack.bindings[resource.FQN] ?? [];\\n879:                  ? bindings\\n880:                  : yield* resolveInput(bindings),\\n920:                      (binding) => binding.action !== \\\"noop\\\",\\n937:              // consumer's plan props and binding data, so consumers would\\n1193:    // Map FQN -> list of upstream FQNs from bindings\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"0c29e9\",\"wall_time_seconds\":0.000006333,\"exit_code\":0,\"original_token_count\":775,\"output\":\" M alchemy.apps.local.run.ts\\n M apps/api/src/worker.application.ts\\n M apps/api/src/worker.ts\\n M apps/api/test/worker.boundary.test.ts\\n M apps/web/src/lib/calculation-failure.ts\\n M apps/web/src/lib/calculator.boundary.browser.test.tsx\\n M apps/web/src/lib/config.boundary.test.ts\\n M apps/web/src/lib/config.server.ts\\n M apps/web/src/lib/live.server.layer.ts\\n M apps/web/src/server.ts\\n M apps/web/test/native-cancellation.boundary.test.ts\\n M apps/web/test/native-pair.boundary.test.ts\\n M apps/web/test/native-rpc-failures.boundary.test.ts\\n M docs/exec-plans/active/clean-slate-foundation.md\\n M packages/api/http/src/groups/calculators.ts\\n M packages/api/http/src/handlers/calculators.ts\\n M packages/api/rpc/package.json\\n M packages/api/rpc/src/client-response.boundary.ts\\n M packages/api/rpc/src/errors.ts\\n M packages/api/rpc/src/handlers.ts\\n M packages/api/rpc/src/schemas.ts\\n M packages/api/rpc/test/handlers.test.ts\\n M packages/calculators/package.json\\n M packages/calculators/src/index.ts\\n M packages/calculators/src/schemas.ts\\n M packages/infrastructure/src/apps-stack.test.ts\\n M packages/infrastructure/src/apps-stack.ts\\n?? apps/api/src/worker-admission.layer.ts\\n?? apps/api/test/rate-admission.boundary.test.ts\\n?? apps/web/test/native-rate.fixture.ts\\n?? packages/api/rpc/src/rate-identity.boundary.ts\\n?? packages/calculators/__tests__/calculatio