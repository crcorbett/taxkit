s,\\n@@\\n-import { ContentCatalogue, ContentService } from \\\"./service.js\\\";\\n+import { ContentCatalogue, ContentDiscovery, ContentService } from \\\"./service.js\\\";\\n@@\\n });\\n+\\n+export const makeContentDiscoveryTest = Effect.fnUntraced(function* (\\n+  catalogue: DocsPublicCatalogue,\\n+  settings: DocsDiscoverySettings\\n+) {\\n+  const service = yield* ContentDiscovery.pipe(\\n+    Effect.provide(ContentDiscoveryLive(Effect.succeed(settings)).pipe(\\n+      Layer.provide(Layer.succeed(ContentCatalogue, catalogue))\\n+    ))\\n+  );\\n+  const requestedDocuments = yield* Ref.make<readonly DocsDiscoveryPath[]>([]);\\n+  return {\\n+    layer: Layer.succeed(ContentDiscovery, ContentDiscovery.of({\\n+      getDocument: Effect.fn(\\\"ContentDiscovery.getDocument\\\")(function* (path) {\\n+        yield* Ref.update(requestedDocuments, Array.append(path));\\n+        return yield* service.getDocument(path);\\n+      }),\\n+    })),\\n+    observations: { requestedDocuments },\\n+  };\\n+});\\n*** End Patch\"));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","create_time":1791310731.770972}}}
