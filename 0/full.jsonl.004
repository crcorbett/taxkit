dren:`packages/sdk/typescript/src/effect.ts`})})]}),`\nweb test:native-pair: + `]}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`used-by`,children:`Used by`}),`\nweb test:native-pair: + `,(0,t.jsxs)(n.ul,{children:[`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/start/run-your-first-calculation`,children:`Run your first calculation`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/sdk/plain-sdk`,children:`Plain SDK`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/sdk/effect-sdk`,children:`Effect SDK`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/reference/examples`,children:`Examples`})}),`\nweb test:native-pair: + `]})]})}function s(e={}){let{wrapper:n}=e.components||{};return n?(0,t.jsx)(n,{...e,children:(0,t.jsx)(o,{...e})}):o(e)}export{r as _markdown,s as default,n as frontmatter,i as structuredData,a as toc};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Understand where SDK, HTTP and calculator service responsibilities sit.`,status:`published`,title:`SDK, HTTP API and calculators service boundary`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # SDK, HTTP API and calculators service boundary [#sdk-http-api-and-calculators-service-boundary]\nweb test:native-pair: +\nweb test:native-pair: + TaxKit has one calculator boundary with multiple caller surfaces. The SDK is\nweb test:native-pair: + the primary in-process surface. HTTP is a transport over that same calculator\nweb test:native-pair: + path.\nweb test:native-pair: +\nweb test:native-pair: + ## When this matters [#when-this-matters]\nweb test:native-pair: +\nweb test:native-pair: + Use this model when deciding where code should live. Tax logic belongs in\nweb test:native-pair: + rules and calculators, not in HTTP handlers, browser clients or docs examples.\nweb test:native-pair: +\nweb test:native-pair: + ## How it works [#how-it-works]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + Production: SDK and HTTP boundary\nweb test:native-pair: +\nweb test:native-pair: + Plain TypeScript caller\nweb test:native-pair: +   -> TaxKit.calculate / TaxKit.safe.calculate / au.incomeTax.annual\nweb test:native-pair: +     -> @taxkit/sdk/effect calculateReportRequest\nweb test:native-pair: +       -> @taxkit/sdk/effect calculateRunRequest\nweb test:native-pair: +         -> PublicCalculatorService.calculate\nweb test:native-pair: +           -> CalculationEngine\nweb test:native-pair: +\nweb test:native-pair: + HTTP caller\nweb test:native-pair: +   -> @taxkit/api-http route contract\nweb test:native-pair: +     -> CalculatorApiHandlerLive\nweb test:native-pair: +       -> PublicCalculatorService.calculate\nweb test:native-pair: +         -> CalculationEngine\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + The HTTP calculate route calls \\`PublicCalculatorService.calculate\\` directly.\nweb test:native-pair: + The SDK helpers call the same service. HTTP does not depend on the SDK helpers.\nweb test:native-pair: +\nweb test:native-pair: + ## Boundary rules [#boundary-rules]\nweb test:native-pair: +\nweb test:native-pair: + * Use the SDK when TypeScript can run in-process.\nweb test:native-pair: + * Use HTTP when the caller needs transport or OpenAPI.\nweb test:native-pair: + * Keep endpoint field detail in generated OpenAPI.\nweb test:native-pair: + * Keep canonical facts, reports and \\`CalculatorServiceError\\` in the owning\nweb test:native-pair: +   calculator packages.\nweb test:native-pair: +\nweb test:native-pair: + ## Related concepts [#related-concepts]\nweb test:native-pair: +\nweb test:native-pair: + * [API overview](/api/overview)\nweb test:native-pair: + * [Plain SDK](/sdk/plain-sdk)\nweb test:native-pair: + * [Effect SDK](/sdk/effect-sdk)\nweb test:native-pair: + * [API and SDK architecture](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/api-and-sdk.md)\nweb test:native-pair: + `,i={contents:[{heading:`sdk-http-api-and-calculators-service-boundary`,content:`TaxKit has one calculator boundary with multiple caller surfaces. The SDK is\nweb test:native-pair: + the primary in-process surface. HTTP is a transport over that same calculator\nweb test:native-pair: + path.`},{heading:`when-this-matters`,content:`Use this model when deciding where code should live. Tax logic belongs in\nweb test:native-pair: + rules and calculators, not in HTTP handlers, browser clients or docs examples.`},{heading:`how-it-works`,content:\"The HTTP calculate route calls `PublicCalculatorService.calculate` directly.\\nThe SDK helpers call the same service. HTTP does not depend on the SDK helpers.\"},{heading:`boundary-rules`,content:`Use the SDK when TypeScript can run in-process.`},{heading:`boundary-rules`,content:`Use HTTP when the caller needs transport or OpenAPI.`},{heading:`boundary-rules`,content:`Keep endpoint field detail in generated OpenAPI.`},{heading:`boundary-rules`,content:\"Keep canonical facts, reports and `CalculatorServiceError` in the owning\\ncalculator packages.\"},{heading:`related-concepts`,content:`API overview`},{heading:`related-concepts`,content:`Plain SDK`},{heading:`related-concepts`,content:`Effect SDK`},{heading:`related-concepts`,content:`API and SDK architecture`}],headings:[{id:`sdk-http-api-and-calculators-service-boundary`,content:`SDK, HTTP API and calculators service boundary`},{id:`when-this-matters`,content:`When this matters`},{id:`how-it-works`,content:`How it works`},{id:`boundary-rules`,content:`Boundary rules`},{id:`related-concepts`,content:`Related concepts`}]},a=[{depth:1,url:`#sdk-http-api-and-calculators-service-boundary`,title:(0,t.jsx)(t.Fragment,{children:`SDK, HTTP API and calculators service boundary`})},{depth:2,url:`#when-this-matters`,title:(0,t.jsx)(t.Fragment,{children:`When this mat