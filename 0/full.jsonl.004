ortRequest(...)\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Return the full run response [#return-the-full-run-response]\nweb test:native-pair: +\nweb test:native-pair: + Use \\`calculateRunRequest\\` when you need the canonical \\`CalculatorRunResponse\\`\nweb test:native-pair: + shape with a descriptor-decoded report type. Omitted request fields use their\nweb test:native-pair: + Schema defaults. Explicit context and help use nested Options: outer \\`None\\`\nweb test:native-pair: + means a missing key, \\`Some(None)\\` means a present undefined key and\nweb test:native-pair: + \\`Some(Some(value))\\` means a present value. JSON clients keep the usual optional\nweb test:native-pair: + fields; the codec handles this conversion.\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { audFromCents } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { calculateRunRequest } from \"@taxkit/sdk/effect\";\nweb test:native-pair: + import { AuAnnualIncomeTaxCalculation } from \"@taxkit/sdk/au/effect\";\nweb test:native-pair: + import { Effect, Option } from \"effect\";\nweb test:native-pair: +\nweb test:native-pair: + const effect = Effect.gen(function* () {\nweb test:native-pair: +   const taxableIncome = yield* audFromCents(9_000_000);\nweb test:native-pair: +   return yield* calculateRunRequest(AuAnnualIncomeTaxCalculation, {\nweb test:native-pair: +     payload: {\nweb test:native-pair: +       facts: { taxableIncome },\nweb test:native-pair: +       jurisdiction: Option.some(\nweb test:native-pair: +         Option.some(AuAnnualIncomeTaxCalculation.jurisdiction)\nweb test:native-pair: +       ),\nweb test:native-pair: +       taxYear: Option.some(Option.some(AuAnnualIncomeTaxCalculation.taxYear)),\nweb test:native-pair: +     },\nweb test:native-pair: +   });\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Return only the report [#return-only-the-report]\nweb test:native-pair: +\nweb test:native-pair: + Use \\`calculateReportRequest\\` when you have a full request payload but only need\nweb test:native-pair: + the report.\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { audFromCents } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { calculateReportRequest } from \"@taxkit/sdk/effect\";\nweb test:native-pair: + import { AuAnnualIncomeTaxCalculation } from \"@taxkit/sdk/au/effect\";\nweb test:native-pair: + import { Effect, Option } from \"effect\";\nweb test:native-pair: +\nweb test:native-pair: + const effect = Effect.gen(function* () {\nweb test:native-pair: +   const taxableIncome = yield* audFromCents(9_000_000);\nweb test:native-pair: +   return yield* calculateReportRequest(AuAnnualIncomeTaxCalculation, {\nweb test:native-pair: +     payload: {\nweb test:native-pair: +       facts: { taxableIncome },\nweb test:native-pair: +       jurisdiction: Option.some(\nweb test:native-pair: +         Option.some(AuAnnualIncomeTaxCalculation.jurisdiction)\nweb test:native-pair: +       ),\nweb test:native-pair: +       taxYear: Option.some(Option.some(AuAnnualIncomeTaxCalculation.taxYear)),\nweb test:native-pair: +     },\nweb test:native-pair: +   });\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + Use \\`calculateReport\\` when you already have descriptor-typed facts:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { calculateReport } from \"@taxkit/sdk/effect\";\nweb test:native-pair: + import { AuAnnualIncomeTaxCalculation } from \"@taxkit/sdk/au/effect\";\nweb test:native-pair: +\nweb test:native-pair: + const effect = calculateReport(AuAnnualIncomeTaxCalculation, {\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Use an Effect client [#use-an-effect-client]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { createClient } from \"@taxkit/sdk/effect\";\nweb test:native-pair: + import {\nweb test:native-pair: +   AuIncomeTax2025_26Module,\nweb test:native-pair: +   AuAnnualIncomeTaxCalculation,\nweb test:native-pair: + } from \"@taxkit/sdk/au/effect\";\nweb test:native-pair: +\nweb test:native-pair: + const client = createClient(AuIncomeTax2025_26Module);\nweb test:native-pair: +\nweb test:native-pair: + const effect = client.calculations.calculateReport(\nweb test:native-pair: +   AuAnnualIncomeTaxCalculation,\nweb test:native-pair: +   { taxableIncome: aud(Cents.make(9_000_000)) }\nweb test:native-pair: + );\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Requirements [#requirements]\nweb test:native-pair: +\nweb test:native-pair: + Effect helpers require \\`PublicCalculatorService\\` in the environment. Each\nweb test:native-pair: + plain SDK client owns its runtime and must be disposed when finished; direct\nweb test:native-pair: + helpers clean up before returning. The Effect SDK leaves service provision to the\nweb test:native-pair: + consumer so application layers and tests can choose the calculator service\nweb test:native-pair: + implementation.\nweb test:native-pair: +\nweb test:native-pair: + ## Related pages [#related-pages]\nweb test:native-pair: +\nweb test:native-pair: + * [Plain SDK](/sdk/plain-sdk)\nweb test:native-pair: + * [Schemas](/sdk/schemas)\nweb test:native-pair: + * [Choose SDK or HTTP API](/start/choose-sdk-or-api)\nweb test:native-pair: + `,i={contents:[{heading:`effect-sdk`,content:`Use the Effect SDK when your application already composes services with Effect,\nweb test:native-pair: + or when an in-process transport needs the full calculator run response. Most\nweb test:native-pair: + server-side TypeScript applications should start with the Plain SDK.`},{heading:`return-the-full-run-response`,content:\"Use `calculateRunRequest` when you need the canonical `CalculatorRunResponse`\\nshape with a descriptor-decoded report type. Omitted request fields use their\\nSchema defaults. Explicit context and help use nested Options: outer `None`\\nmeans a missing key, `Some(None)` means a present undefined key and\\n`Some(Some(value))` means a present value. JSON clients keep the usual optional\\nfields; the codec handles this conversion.\"},{heading:`return-only-the-report`,content:\"Use `calculateReportRequest` when you have a full request payload but only need\\nthe report.\"},{heading:`return-only-the-report`,content:\"Use `calculateReport` when you already have descriptor-typed facts:\"},{heading:`requirements`,content:`Effect helpers require \\`PublicCalculatorService\\` in the environment. Each\nweb test:native-pair: + plain SDK client owns its runtime and must be disposed when finished; direct\nweb test:native-pair: + helpers clean up before returning. The Effect SDK leaves service provision to the\nweb test:native-pair: + consumer so application layers and tests can choose the calculator service\nweb test:native-pair: + implementation.`},{heading:`related-pages`,content:`Plain SDK`},{heading:`related-pages`,content:`Schemas`},{heading:`related-pages`,content:`Choose SDK or HTTP API`}],headings:[{id:`effect-sdk`,content:`Effect SDK`},{id:`runtime-graph`,content:`Runtime graph`},{id:`return-the-full-run-response`,content:`Return the full run response`},{id:`return-only-the-report`,content:`Return only the report`},{id:`use-an-effect-client`,content:`Use an Effect client`},{id:`requirements`,content:`Requirements`},{id:`related-pages`,content:`Related pages`}]},a=[{depth:1,url:`#effect-sdk`,title:(0,t.jsx)(t.Frag