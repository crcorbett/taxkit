vg viewBox=\"0 0 24 24\"><path d=\"M 6,1 C 4.354992,1 3,2.354992 3,4 v 16 c 0,1.645008 1.354992,3 3,3 h 12 c 1.645008,0 3,-1.354992 3,-3 V 8 7 A 1.0001,1.0001 0 0 0 20.707031,6.2929687 l -5,-5 A 1.0001,1.0001 0 0 0 15,1 h -1 z m 0,2 h 7 v 3 c 0,1.645008 1.354992,3 3,3 h 3 v 11 c 0,0.564129 -0.435871,1 -1,1 H 6 C 5.4358712,21 5,20.564129 5,20 V 4 C 5,3.4358712 5.4358712,3 6,3 Z M 15,3.4140625 18.585937,7 H 16 C 15.435871,7 15,6.5641288 15,6 Z\" fill=\"currentColor\" /></svg>`,children:(0,t.jsx)(n.code,{children:(0,t.jsx)(n.span,{className:`line`,children:(0,t.jsx)(n.span,{children:`0`})})})})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`trace-and-graph-data`,children:`Trace and graph data`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`Trace data records which rule ran, what it used, what it produced and which\nweb test:native-pair: + sources support it. Graph data exposes dependency edges and validation issues\nweb test:native-pair: + through the calculator graph endpoint.`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`related-concepts`,children:`Related concepts`}),`\nweb test:native-pair: + `,(0,t.jsxs)(n.ul,{children:[`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/concepts/reports`,children:`Reports`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/concepts/rules`,children:`Rules`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/graph-trace-ledgers.md`,children:`Graph, trace and ledgers architecture`})}),`\nweb test:native-pair: + `]})]})}function s(e={}){let{wrapper:n}=e.components||{};return n?(0,t.jsx)(n,{...e,children:(0,t.jsx)(o,{...e})}):o(e)}export{r as _markdown,s as default,n as frontmatter,i as structuredData,a as toc};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Compose TaxKit calculations in Effect applications and in-process transports.`,status:`published`,title:`Effect SDK`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # Effect SDK [#effect-sdk]\nweb test:native-pair: +\nweb test:native-pair: + Use the Effect SDK when your application already composes services with Effect,\nweb test:native-pair: + or when an in-process transport needs the full calculator run response. Most\nweb test:native-pair: + server-side TypeScript applications should start with the [Plain SDK](/sdk/plain-sdk).\nweb test:native-pair: +\nweb test:native-pair: + ## Runtime graph [#runtime-graph]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + Production: SDK Effect full run\nweb test:native-pair: +\nweb test:native-pair: + Effect consumer\nweb test:native-pair: +   -> calculateRunRequest(descriptor, request)\nweb test:native-pair: +     -> PublicCalculatorService.calculate\nweb test:native-pair: +       -> CalculatorRunResponse\nweb test:native-pair: +     -> descriptor output decode for response.report\nweb test:native-pair: +     -> typed CalculatorRunResponse with narrowed report\nweb test:native-pair: +\nweb test:native-pair: + Report-only helpers\nweb test:native-pair: +   -> calculateReportRequest(...)\nweb test:native-pair: +     -> calculateRunRequest(...)\nweb test:native-pair: +     -> response.report\nweb test:native-pair: +   -> calculateReport(...)\nweb test:native-pair: +     -> calculateReportRequest(...)\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Return the full run response [#return-the-full-run-response]\nweb test:native-pair: +\nweb test:native-pair: + Use \\`calculateRunRequest\\` when you need the canonical \\`CalculatorRunResponse\\`\nweb test:native-pair: + shape with a descriptor-decoded report type. Omitted request fields use their\nweb test:native-pair: + Schema defaults. Explicit context and help use nested Options: outer \\`None\\`\nweb test:native-pair: + means a missing key, \\`Some(None)\\` means a present undefined key and\nweb test:native-pair: + \\`Some(Some(value))\\` means a present value. JSON clients keep the usual optional\nweb test:native-pair: + fields; the codec handles this conversion.\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { audFromCents } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { calculateRunRequest } from \"@taxkit/sdk/effect\";\nweb test:native-pair: + import { AuAnnualIncomeTaxCalculation } from \"@taxkit/sdk/au/effect\";\nweb test:native-pair: + import { Effect, Option } from \"effect\";\nweb test:native-pair: +\nweb test:native-pair: + const effect = Effect.gen(function* () {\nweb test:native-pair: +   const taxableIncome = yield* audFromCents(9_000_000);\nweb test:native-pair: +   return yield* calculateRunRequest(AuAnnualIncomeTaxCalculation, {\nweb test:native-pair: +     payload: {\nweb test:native-pair: +       facts: { taxableIncome },\nweb test:native-pair: +       jurisdiction: Option.some(\nweb test:native-pair: +         Option.some(AuAnnualIncomeTaxCalculation.jurisdiction)\nweb test:native-pair: +       ),\nweb test:native-pair: +       taxYear: Option.some(Option.some(AuAnnualIncomeTaxCalculation.taxYear)),\nweb test:native-pair: +     },\nweb test:native-pair: +   });\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Return only the report [#return-only-the-report]\nweb test:native-pair: +\nweb test:native-pair: + Use \\`calculateReportRequest\\` when you have a full request payload but only need\nweb test:native-pair: + the report.\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { audFromCents } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { calculateReportRequest } from \"@taxkit/sdk/effect\";\nweb test:native-pair: + import { AuAnnualIncomeTaxCalculation } from \"@taxkit/sdk/au/effect\";\nweb test:native-pair: + import { Effect, Option } from \"effect\";\nweb test:native-pair: +\nweb test:native-pair: + const effect = Effect.gen(function* () {\nweb test:native-pair: +   const taxableIncome = yield* audFromCents(9_000_000);\nweb test:native-pair: +   return yield* calculateReportRequest(AuAnnualIncomeTaxCalculation, {\nweb test:native-pair: +     payload: {\nweb test:native-pair: +       facts: { taxableIncome },\nweb test:native-pair: +       jurisdiction: Option.some(\nweb test:native-pair: +         Option.some(AuAnnualIncomeTaxCalculation.jurisdiction)\nweb test:native-pair: +       ),\nweb test:native-pair: +       taxYear: Option.some(Option.some(AuAnnualIncomeTaxCalculation.taxYear)),\nweb test:native-pair: +     },\nweb test:native-pair: +   });\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + Use \\`calculateReport\\` when you already have descriptor-typed facts:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { calculateReport } from \"@taxkit/sdk/effect\";\nweb test:native-pair: + import { AuAnnualIncomeTaxCalculation } from \"@taxkit/sdk/au/effect\";\nweb test:native-pair: +\nweb test:native-pair: + const effect = calculateReport(AuAnnualIncomeTaxCalculation, {\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Use an Effect client [#use-an-effect-client]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { createClient } from \"@taxkit/sdk/effect\";\nweb test:native-pair: + import {\nweb test:native-pair: +   AuIncomeTax2025_26Module,\nweb test:native-pair: +   AuAnnualIncomeTaxCalculation,\nweb test:native-pair: + } from \"@taxkit/sdk/au/effect\";\nweb test:native-pair: +\nweb test:native-pair: + const client = createClient(AuIncomeTax2025_26Module);\nweb test:native-pair: +\nweb test:native-pair: + const effect = client.calculations.calculateReport(\nweb test:native-pair: +   AuAnnualIncomeTaxCalculation,\nweb test:native-pair: +   { taxableIncome: aud(Cents.make(9_000_000)) }\nweb test:native-pair: + );\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Requirements [#requirements]\nweb test:native-pair: +\nweb test:native-pair: + Effect helpers require \\`PublicCalculatorService\\` in the environment. Each\nweb test:native-pair: + plain SDK client owns its runtime and must be disposed when finished; direct\nweb test:native-pair: + helpers clean up before returning. The Effect SDK leaves service provision to the\nweb test:native-pair: + consumer so application layers and tests can choose the calculator service\nweb test:native-pair: + implementation.\nweb test:native-pair: +\nweb test:native-pair: + ## Related pages [#related-pages]\nweb test:native-pair: +\nweb test:native-pair: + * [Plain SDK](/sdk/plain-sdk)\nweb test:native-pair: + * [Schemas](/sdk/schemas)\nweb test:native-pair: + * [Choose SDK or HTTP API](/start/choose-sdk-or-api)\nweb test:native-pair: + `,i={contents:[{heading:`effect-sdk`,content:`Use the Effect SDK when your application already composes services with Effect,\nweb test:native-pair: + or when an in-process transport needs the full calculator run response. Most\nweb test:native-pair: + server-side TypeScript applications should start with the Plain SDK.`},{heading:`return-the-full-run-response`,content:\"Use `calculateRunRequest` when you need the canonical `CalculatorRunResponse`\\nshape with a descriptor-decoded report type. Omitted request fields use their\\nSchema defaults. Explicit context and help use nested Options: outer `None`\\nmeans a missing key, `Some(None)` means a present undefined key and\\n`Some(Some(value))` means a present value. JSON clients keep the usual optional\\nfields; the codec handles this conversion.\"},{heading:`return-only-the-report`,content:\"Use `calculateReportRequest` when you have a full request payload but only need\\nthe report.\"},{heading:`return-only-the-report`,content:\"Use `calculateReport` when you already have descriptor-typed facts:\"},{heading:`requirements`,content:`Effect helpers require \\`PublicCalculatorService\\` in the environment. Each\nweb test:native-pair: + plain SDK client owns its runtime and must be disposed when finished; direct\nweb test:native-pair: + helpers clean up before returning. The Effect SDK leaves service provision to the\nweb test:native-pair: + consumer so application layers and tests can choose the calculator service\nweb test:native-pair: + implementation.`},{heading:`related-pages`,content:`Plain SDK`},{heading:`related-pages`,content:`Schemas`},{heading:`related-pages`,content:`Choose SDK or HTTP API`}],headings:[{id:`effect-sdk`,content:`Effect SDK`},{id:`runtime-graph`,content:`Runtime graph`},{id:`return-the-full-run-response`,content:`Return the full run response`},{id:`return-only-the-report`,content:`Return only the report`},{id:`use-an-effect-client`,content:`Use an Effect client`},{id:`requirements`,content:`Requirements`},{id:`related-pages`,content:`Related pages`}]},a=[{depth:1,url:`#effect-sdk`,title:(0,t.jsx)(t.Fragment,{children:`Effect SDK`})},{depth:2,url:`#runtime-graph`,title:(0,t.jsx)(t.Fragment,{children:`Runtime graph`})},{depth:2,url:`#return-the-full-run-response`,title:(0,t.jsx)(t.Fragment,{children:`Return the full run response`})},{depth:2,url:`#return-only-the-report`,title:(0,t.jsx)(t.Fragment,{children:`Return only the report`})},{depth:2,url:`#use-an-effect-client`,title:(0,t.jsx)(t.Fragment,{children:`Use an Effect client`})},{depth:2,url:`#requirements`,title:(0,t.jsx)(t.Fragment,{children:`Requirements`})},{depth:2,url:`#rel