entication and deployment assumptions](/api/authentication-and-deployment-assumptions).\nweb test:native-pair: + * Use canonical JSON values for tagged facts.\nweb test:native-pair: +\nweb test:native-pair: + ## Steps [#steps]\nweb test:native-pair: +\nweb test:native-pair: + 1. Supply your API base URL as a \\`URL\\` value.\nweb test:native-pair: + 2. Construct canonical facts and explicit context/help Options for the typed API client.\nweb test:native-pair: + 3. Run the returned Effect at your application host.\nweb test:native-pair: + 4. Render the report or handle its typed failure channel.\nweb test:native-pair: +\nweb test:native-pair: + ## Example [#example]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { createTaxKitApiClient } from \"@taxkit/api-http/client\";\nweb test:native-pair: + import { audFromCents } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { GrossPay } from \"@taxkit/rules-au-pay\";\nweb test:native-pair: + import { AuPayTakeHomeCalculation } from \"@taxkit/sdk/au/effect\";\nweb test:native-pair: + import { Effect, Option } from \"effect\";\nweb test:native-pair: + import * as FetchHttpClient from \"effect/http/FetchHttpClient\";\nweb test:native-pair: +\nweb test:native-pair: + export const calculateTakeHomePay = (baseUrl: URL) =>\nweb test:native-pair: +   Effect.gen(function* () {\nweb test:native-pair: +     const client = yield* createTaxKitApiClient({ baseUrl });\nweb test:native-pair: +     const amount = yield* audFromCents(346_200);\nweb test:native-pair: +     return yield* client.calculatorApi.calculate({\nweb test:native-pair: +       params: { calculatorId: AuPayTakeHomeCalculation.calculatorId },\nweb test:native-pair: +       payload: {\nweb test:native-pair: +         facts: {\nweb test:native-pair: +           grossPay: new GrossPay({\nweb test:native-pair: +             amount,\nweb test:native-pair: +             period: \"fortnightly\",\nweb test:native-pair: +           }),\nweb test:native-pair: +           taxFreeThresholdClaimed: true,\nweb test:native-pair: +         },\nweb test:native-pair: +         jurisdiction: Option.some(\nweb test:native-pair: +           Option.some(AuPayTakeHomeCalculation.jurisdiction)\nweb test:native-pair: +         ),\nweb test:native-pair: +         taxYear: Option.some(Option.some(AuPayTakeHomeCalculation.taxYear)),\nweb test:native-pair: +       },\nweb test:native-pair: +       query: { help: Option.some(Option.some(\"errors\")) },\nweb test:native-pair: +     });\nweb test:native-pair: +   }).pipe(Effect.provide(FetchHttpClient.layer));\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Verify the result [#verify-the-result]\nweb test:native-pair: +\nweb test:native-pair: + Call \\`calculateTakeHomePay(new URL(\"http://127.0.0.1:4000\"))\\` for your local\nweb test:native-pair: + API, or supply your deployed URL explicitly. The example has no default server\nweb test:native-pair: + and reads no browser environment variables. The returned response contains\nweb test:native-pair: + \\`report.netPay.cents\\` with the expected value:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`txt\nweb test:native-pair: + 270600\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Handle errors [#handle-errors]\nweb test:native-pair: +\nweb test:native-pair: + For invalid facts, the API returns \\`CalculatorApiErrorEnvelope\\` with a\nweb test:native-pair: + \\`CalculatorServiceError\\` in \\`error\\`. Add \\`?help=errors\\` when you want\nweb test:native-pair: + descriptor-backed field help.\nweb test:native-pair: +\nweb test:native-pair: + ## Related pages [#related-pages]\nweb test:native-pair: +\nweb test:native-pair: + * [API overview](/api/overview)\nweb test:native-pair: + * [Endpoints](/api/endpoints)\nweb test:native-pair: + * [API errors](/api/errors)\nweb test:native-pair: + `,i={contents:[{heading:`build-a-browser-app-with-the-http-api`,content:`Use this guide when a browser client needs the server to run a calculation.\nweb test:native-pair: + The browser-safe SDK can run calculations on the device instead; compare the\nweb test:native-pair: + choices in Choose SDK or HTTP API.`},{heading:`before-you-start`,content:`Run the API app locally or point at your deployed API base URL.`},{heading:`before-you-start`,content:`Read Authentication and deployment assumptions.`},{heading:`before-you-start`,content:`Use canonical JSON values for tagged facts.`},{heading:`steps`,content:\"Supply your API base URL as a `URL` value.\"},{heading:`steps`,content:`Construct canonical facts and explicit context/help Options for the typed API client.`},{heading:`steps`,content:`Run the returned Effect at your application host.`},{heading:`steps`,content:`Render the report or handle its typed failure channel.`},{heading:`verify-the-result`,content:'Call `calculateTakeHomePay(new URL(\"http://127.0.0.1:4000\"))` for your local\\nAPI, or supply your deployed URL explicitly. The example has no default server\\nand reads no browser environment variables. The returned response contains\\n`report.netPay.cents` with the expected value:'},{heading:`handle-errors`,content:\"For invalid facts, the API returns `CalculatorApiErrorEnvelope` with a\\n`CalculatorServiceError` in `error`. Add `?help=errors` when you want\\ndescriptor-backed field help.\"},{heading:`related-pages`,content:`API overview`},{heading:`related-pages`,content:`Endpoints`},{heading:`related-pages`,content:`API errors`}],headings:[{id:`build-a-browser-app-with-the-http-api`,content:`Build a browser app with the HTTP API`},{id:`before-you-start`,content:`Before you start`},{id:`steps`,content:`Steps`},{id:`example`,content:`Example`},{id:`verify-the-result`,content:`Verify the result`},{id:`handle-errors`,content:`Handle errors`},{id:`related-pages`,content:`Related pages`}]},a=[{depth:1,url:`#build-a-browser-app-with-the-htt