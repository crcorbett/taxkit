st:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/sdk`,children:`SDK`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/guides`,children:`Guides`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/reference`,children:`Reference`})}),`\nweb test:native-pair: + `]})]})}function s(e={}){let{wrapper:n}=e.components||{};return n?(0,t.jsx)(n,{...e,children:(0,t.jsx)(o,{...e})}):o(e)}export{r as _markdown,s as default,n as frontmatter,i as structuredData,a as toc};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Add smoke tests for SDK or HTTP calculator integration.`,status:`published`,title:`Test your integration`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # Test your integration [#test-your-integration]\nweb test:native-pair: +\nweb test:native-pair: + Use this guide when you need evidence that your application still calls\nweb test:native-pair: + TaxKit with the expected facts and handles expected failures.\nweb test:native-pair: +\nweb test:native-pair: + ## Before you start [#before-you-start]\nweb test:native-pair: +\nweb test:native-pair: + * Choose SDK or HTTP in [Choose SDK or HTTP API](/start/choose-sdk-or-api).\nweb test:native-pair: + * Keep one success case and one validation failure case.\nweb test:native-pair: + * Assert cents, report tags and error tags instead of snapshotting a full\nweb test:native-pair: +   report.\nweb test:native-pair: +\nweb test:native-pair: + ## Steps [#steps]\nweb test:native-pair: +\nweb test:native-pair: + 1. Add a success test for the calculator you call.\nweb test:native-pair: + 2. Add a validation failure test that checks external input before calculation.\nweb test:native-pair: + 3. Run your app tests and the relevant TaxKit package test when working in\nweb test:native-pair: +    this repo.\nweb test:native-pair: +\nweb test:native-pair: + ## Example [#example]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { assert, it } from \"@effect/vitest\";\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { GrossPay } from \"@taxkit/rules-au-pay\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: + import { Effect, Schema } from \"effect\";\nweb test:native-pair: +\nweb test:native-pair: + it.effect(\"calculates weekly take-home pay\", () =>\nweb test:native-pair: +   Effect.promise(() =>\nweb test:native-pair: +     au.pay.takeHomePay({\nweb test:native-pair: +       grossPay: new GrossPay({\nweb test:native-pair: +         amount: aud(Cents.make(165_400)),\nweb test:native-pair: +         period: \"weekly\",\nweb test:native-pair: +       }),\nweb test:native-pair: +       taxFreeThresholdClaimed: true,\nweb test:native-pair: +     })\nweb test:native-pair: +   ).pipe(\nweb test:native-pair: +     Effect.tap((report) =>\nweb test:native-pair: +       Effect.sync(() => {\nweb test:native-pair: +         assert.equal(report._tag, \"TakeHomePayReport\");\nweb test:native-pair: +         assert.equal(report.netPay.cents, 130_100);\nweb test:native-pair: +       })\nweb test:native-pair: +     )\nweb test:native-pair: +   )\nweb test:native-pair: + );\nweb test:native-pair: +\nweb test:native-pair: + it.effect(\"rejects external input before calculation\", () =>\nweb test:native-pair: +   Schema.decodeEffect(\nweb test:native-pair: +     Schema.fromJsonString(au.calculations.takeHomePay.inputSchema)\nweb test:native-pair: +   )('{\"taxableIncome\":{\"_tag\":\"Money\",\"cents\":9000000,\"currency\":\"AUD\"}}').pipe(\nweb test:native-pair: +     Effect.flip,\nweb test:native-pair: +     Effect.tap((error) =>\nweb test:native-pair: +       Effect.sync(() => assert.equal(error._tag, \"SchemaError\"))\nweb test:native-pair: +     )\nweb test:native-pair: +   )\nweb test:native-pair: + );\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Verify the result [#verify-the-result]\nweb test:native-pair: +\nweb test:native-pair: + Run your application's test command. Inside this repository, the SDK type and\nweb test:native-pair: + unit tests are:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`sh\nweb test:native-pair: + bun run --filter=@taxkit/sdk test\nweb test:native-pair: + bun run --filter=@taxkit/sdk test-types\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Handle errors [#handle-errors]\nweb test:native-pair: +\nweb test:native-pair: + Test the error tag your application relies on. Do not assert a full error\nweb test:native-pair: + message unless the message is part of your user-facing contract.\nweb test:native-pair: +\nweb test:native-pair: + ## Related pages [#related-pages]\nweb test:native-pair: +\nweb test:native-pair: + * [Safe SDK](/sdk/safe-sdk)\nweb test:native-pair: + * [API errors](/api/errors)\nweb test:native-pair: + * [Diagnostics](/concepts/diagnostics)\nweb test:native-pair: + `,i={contents:[{heading:`test-your-integration`,content:`Use this guide when you need evidence that your application still calls\nweb test:native-pair: + TaxKit with the expected facts and handles expected failures.`},{heading:`before-you-start`,content:`Choose SDK or HTTP in Choose SDK or HTTP API.`},{heading:`before-you-start`,content:`Keep one success case and one validation failure case.`},{heading:`before-you-start`,content:`Assert cents, report tags and error tags instead of snapshotting a full\nweb test:native-pair: + report.`},{heading:`steps`,content:`Add a success test for the calculator you call.`},{heading:`steps`,content:`Add a validation failure test that checks external input before calculation.`},{heading:`steps`,content:`Run your app tests and the relevant TaxKit package test when working in\nweb test:native-pair: + this repo.`},{heading:`verify-the-result`,content:`Run your application's test command. Inside this repository, the SDK type and\nweb test:native-pair: + unit tests are:`},{heading:`handle-errors`,content:`Test the error tag your application relies on. Do not assert a full error\nweb test:native-pair: + message unless the message is part of your user-facing contract.`},{heading:`related-pages`,content:`Safe SDK`},{heading:`related-pages`,content:`API errors`},{heading:`related-pages`,content:`Diagnostics`}],headings:[{id:`test-your-integration`,content:`Test your integration`},{id:`before-you-start`,content:`Before you start`},{id:`steps`,content:`Steps`},{id:`example`,content:`Example`},{id:`verify-the-result`,content:`Verify the result`},{id:`handle-errors`,content:`Handle errors`},{id:`related-pages`,content:`Related pages`}]},a=[{depth:1,url:`#test-your-integration`,title:(0,t.jsx)(t.Fragment,{children:`Test your integration`})},{depth:2,url:`#before-you-start`,title:(0,t.jsx)(t.Fragment,{children:`Before you start`})},{depth:2,url:`#steps`,title:(0,t.jsx)(t.Fragment,{children:`Steps`})},{depth:2,url:`#example`,title:(0,t.jsx)(t.Fragment,{children:`Example`})},{depth:2,url:`#verify-the-result`,title:(0,t.jsx)(t.Fragment,{children:`Verify the result`})},{depth:2,url:`#handle-errors`,title:(0,t.jsx)(t.Fragment,{children:`Handle errors`})},{depth:2,url:`#related-pages`,title:(0,t.jsx)(t.Fragment,{children:`Related pages`})}];function o(e){let n={a:`a`,code:`code`,h1:`h1`,h2:`h2`,li:`li`,ol:`ol`,p:`p`,pre:`pre`,span:`span`,ul:`ul`,...e.components};return(0,t.jsxs)(t.Fragment,{children:[(0,t.jsx)(n.h1,{id:`test-your-integration`,children:`Test your integration`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`Use this guide when you need evidence that your application still calls\nweb test:native-pair: + TaxKit with the expected facts and handles expected failures.`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`before-you-start`,children:`Before you start`}),`\nweb test:native-pair: + `,(0,t.jsxs)(n.ul,{children:[`\nweb te