onse.empty({ headers })\\n+                : HttpServerResponse.text(document.body, {\\n+                    contentType: `${document.contentType}; charset=utf-8`,\\n+                    headers,\\n+                  });\\n+            }),\\n+            Effect.catch(() => Effect.succeed(HttpServerResponse.empty({\\n+              headers: { \\\"cache-control\\\": \\\"no-store\\\" },\\n+              status: 503,\\n+            })))\\n+          );\\n+        }\\n*** End Patch\"));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","create_time":1791310538.756475}}}
