st:native-pair: + no-Changeset rationale in `,(0,t.jsx)(n.a,{href:`/contributing/pr-evidence-checklist`,children:`PR evidence checklist`}),`.`]})]})}function s(e={}){let{wrapper:n}=e.components||{};return n?(0,t.jsx)(n,{...e,children:(0,t.jsx)(o,{...e})}):o(e)}export{r as _markdown,s as default,n as frontmatter,i as structuredData,a as toc};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Add a canonical fact with schema, descriptor, ownership and tests.`,status:`published`,title:`Add a fact`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # Add a fact [#add-a-fact]\nweb test:native-pair: +\nweb test:native-pair: + Use this guide when you need a new input fact, derived fact, parameter fact or\nweb test:native-pair: + question prompt for a calculator.\nweb test:native-pair: +\nweb test:native-pair: + ## Before you start [#before-you-start]\nweb test:native-pair: +\nweb test:native-pair: + * Find the owning package in\nweb test:native-pair: +   [Package ownership](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/package-ownership.md).\nweb test:native-pair: + * Read the current fact model in\nweb test:native-pair: +   [Facts](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/facts.md).\nweb test:native-pair: + * Check whether an existing fact descriptor already covers the tax behaviour.\nweb test:native-pair: +\nweb test:native-pair: + Shared primitives, \\`FactId\\` and common descriptor contracts live in\nweb test:native-pair: + \\`@taxkit/core\\`. Rule-specific facts should live in the rule package that owns\nweb test:native-pair: + the rule, parameter table and golden tests.\nweb test:native-pair: +\nweb test:native-pair: + ## Proposal [#proposal]\nweb test:native-pair: +\nweb test:native-pair: + Describe the fact before you code:\nweb test:native-pair: +\nweb test:native-pair: + * whether it is an input fact, derived fact or parameter fact\nweb test:native-pair: + * the source that proves the fact is tax-significant\nweb test:native-pair: + * the schema-backed value and branded fields it needs\nweb test:native-pair: + * the \\`Context.Service\\` that provides the value\nweb test:native-pair: + * the descriptor title, authority policy and question metadata\nweb test:native-pair: + * which calculators will accept or derive it\nweb test:native-pair: +\nweb test:native-pair: + Do not mirror canonical fields such as \\`id: string\\` in a local DTO. Import the\nweb test:native-pair: + owning \\`FactId\\`, schema, descriptor, constructor or service tag.\nweb test:native-pair: +\nweb test:native-pair: + ## Implementation [#implementation]\nweb test:native-pair: +\nweb test:native-pair: + Define the fact in the owning package and keep the descriptor beside the\nweb test:native-pair: + package-owned rule or scenario input that uses it.\nweb test:native-pair: +\nweb test:native-pair: + This example shows the existing gross-pay fact. For a new fact, use the\nweb test:native-pair: + name, schema and service key owned by its rule package.\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Money } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { PayPeriod } from \"@taxkit/rules-au-pay/facts\";\nweb test:native-pair: + import { Context, Schema } from \"effect\";\nweb test:native-pair: +\nweb test:native-pair: + // This illustrates the existing fact definition. A new fact needs its own\nweb test:native-pair: + // rule-owned name, schema, service key and descriptor.\nweb test:native-pair: + export class GrossPay extends Schema.TaggedClass<GrossPay>()(\"GrossPay\", {\nweb test:native-pair: +   amount: Money,\nweb test:native-pair: +   period: PayPeriod,\nweb test:native-pair: + }) {}\nweb test:native-pair: +\nweb test:native-pair: + export class GrossPayFact extends Context.Service<GrossPayFact, GrossPay>()(\nweb test:native-pair: +   \"taxkit/rules-au-pay/fact/GrossPay\"\nweb test:native-pair: + ) {}\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + Use schema-owned optional fields with \\`Option\\` and \\`Match\\` when the fact has\nweb test:native-pair: + optional policy. Do not create default values that change a tax outcome, such\nweb test:native-pair: + as assuming a HELP/STSL debt answer or a tax-free threshold claim.\nweb test:native-pair: +\nweb test:native-pair: + ## Tests [#tests]\nweb test:native-pair: +\nweb test:native-pair: + Your evidence should include:\nweb test:native-pair: +\nweb test:native-pair: + * schema decode tests for valid and invalid fact values\nweb test:native-pair: + * type tests when the fact changes a public SDK or calculator input type\nweb test:native-pair: + * graph validation evidence showing the fact is provided and required by the\nweb test:native-pair: +   expected rules\nweb test:native-pair: + * golden tests when the fact changes a tax calculation result\nweb test:native-pair: + * API compatibility tests when the fact appears in \\`CalculatorRunRequest\\`\nweb test:native-pair: + * SDK compatibility tests when SDK helpers accept the fact\nweb test:native-pair: +\nweb test:native-pair: + ## Pull request evidence [#pull-request-evidence]\nweb test:native-pair: +\nweb test:native-pair: + Link the source citation for the fact, list the owning package, show the test\nweb test:native-pair: + commands you ran and explain compatibility impact in\nweb test:native-pair: + [PR evidence checklist](/contributing/pr-evidence-checklist).\nweb test:native-pair: + `,i={contents:[{heading:`add-a-fact`,content:`Use this guide when you need a new input fact, derived fact, parameter fact or\nweb test:native-pair: + question prompt for a calculator.`},{heading:`before-you-start`,content:`Find the owning package in\nweb test:native-pair: + Package ownership.`},{heading:`before-you-start`,content:`Read the current fact model in\nweb test:native-pair: + Facts.`},{heading:`before-you-start`,content:`Check whether an existing fact descriptor already covers the tax behaviour.`},{heading:`before-you-start`,content:\"Shared primitives, `FactId` and common descriptor contracts live in\\n`@taxkit/core`. Rule-specific facts should live in the rule package that owns\\nthe rule, parameter table and golden tests.\"},{heading:`proposal`,content:`Describe the fact before you code:`},{heading:`proposal`,content:`whether it is an input fact, derived fact or parameter fact`},{heading:`proposal`,content:`the source that proves the fact is tax-significant`},{heading:`proposal`,content:`the schema-backed value and branded fields it needs`},{heading:`proposal`,content:\"the `Context.Service` that provides the value\"},{heading:`proposal`,content:`the descriptor title, authority policy and question metadata`},{heading:`proposal`,content:`which calculators will accept or derive it`},{heading:`proposal`,content:\"Do not mirror canonical fields such as `id: string` in a local DTO. Import the\\nowning `FactId`, schema, descriptor, constructor or service tag.\"},{heading:`implementation`,content:`Define the fact in the owning package and keep the descriptor beside the\nweb test:native-pair: + package-owned rule or scenario input that uses it.`},{heading:`implementation`,content:`This example shows the existing gross-pay fact. For a new fact, use the\nweb test:native-pair: + name, schema and service key owned by its rule package.`},{heading:`implementation`,content:\"Use schema-owned optional fields with `Option` and `Match` when the fact has\\noptional policy. Do not create default values that change a tax outcome, such\\nas assuming a HELP/STSL debt answer or a tax-free threshold claim.\"},{heading:`tests`,content:`Your evidence should include:`},{heading:`tests`,content:`schema decode tests for valid and invalid fact values`},{heading:`tests`,content:`type tests when the fact changes a public SDK or calculator input type`},{heading:`tests`,content:`graph validation evidence showing the fact is provided and required by the\nweb test:native-pair: + expected rules`},{heading:`tests`,content:`golden tests when the fact changes a tax calculation result`},{heading:`tests`,content:\"API compatibility tests when the fact appears in `CalculatorRunRequest`\"},{heading:`tests`,content:`SDK compatibility tests when SDK helpers accept the fact`},{heading:`pull-request-evidence`,content:`Link the source citation for the fact, list the owning package, show the test\nweb test:native-pair: + commands you ran and explain compatibility impact in\nweb test:native-pair: + PR evidence checklist.`}],headings:[{id:`add-a-fact`,content:`Add a fact`},{id:`before-you-start`,content:`Before you start`},{id:`proposal`,content:`Proposal`},{id:`implementation`,content:`Implementation`},{id:`tests`,content:`Tests`},{id:`pull-request-evidence`,content:`Pull request evidence`}]},a=[{depth:1,url:`#add-a-fact`,title:(0,t.jsx)(t.Fragment,{children:`Add a fact`})},{depth:2,url:`#before-you-start`,title:(0,t.jsx)(t.Fragment,{children:`Before you start`})},{depth:2,url:`#proposal`,title:(0,t.jsx)(t.Fragment,{children:`Proposal`})},{depth:2,url:`#implementation`,title:(0,t.jsx)(t.Fragment,{children:`Implementation`})},{depth:2,url:`#tests`,title:(0,t.jsx)(t.Fragment,{children:`Tests`})},{depth:2,url:`#pull-request-evidence`,title:(0,t.jsx)(t.Fragment,{children:`Pull request evidence`})}];function o(e){let n={a:`a`,code:`code`,h1:`h1`,h2:`h2`,li:`li`,p:`p`,pre:`pre`,span:`span`,ul:`ul`,...e.components};return(0,t.jsxs)(t.Fragment,{children:[(0,t.jsx)(n.h1,{id:`add-a-fact`,children:`Add a fact`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`Use this guide when you need a new input fact, derived fact, parameter fact or\nweb test:native-pair: + question prompt for a calculator.`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`before-you-start`,children:`Before you start`}),`\nweb test:native-pair: + `,(0,t.jsx