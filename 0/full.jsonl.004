2,21 5,20.564129 5,20 V 4 C 5,3.4358712 5.4358712,3 6,3 Z M 15,3.4140625 18.585937,7 H 16 C 15.435871,7 15,6.5641288 15,6 Z\" fill=\"currentColor\" /></svg>`,children:(0,t.jsxs)(n.code,{children:[(0,t.jsx)(n.span,{className:`line`,children:(0,t.jsx)(n.span,{children:`GrossPay`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.span,{className:`line`,children:(0,t.jsx)(n.span,{children:`  -> taxable pay rule`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.span,{className:`line`,children:(0,t.jsx)(n.span,{children:`  -> PAYG withholding rule`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.span,{className:`line`,children:(0,t.jsx)(n.span,{children:`  -> net pay rule`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.span,{className:`line`,children:(0,t.jsx)(n.span,{children:`  -> TakeHomePayReport`})})]})})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`Rules have descriptors so TaxKit can expose graph edges, source references\nweb test:native-pair: + and required facts through metadata endpoints.`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`parameters`,children:`Parameters`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`Tax-year rates and thresholds are services. The same algorithm can be paired\nweb test:native-pair: + with different parameter layers for different effective periods.`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`related-concepts`,children:`Related concepts`}),`\nweb test:native-pair: + `,(0,t.jsxs)(n.ul,{children:[`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/concepts/calculators`,children:`Calculators`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/concepts/diagnostics`,children:`Diagnostics`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/rules-and-parameters.md`,children:`Rules and parameters architecture`})}),`\nweb test:native-pair: + `]})]})}function s(e={}){let{wrapper:n}=e.components||{};return n?(0,t.jsx)(n,{...e,children:(0,t.jsx)(o,{...e})}):o(e)}export{r as _markdown,s as default,n as frontmatter,i as structuredData,a as toc};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Run a copyable SDK script with canonical money input values.`,status:`published`,title:`Run your first calculation`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # Run your first calculation [#run-your-first-calculation]\nweb test:native-pair: +\nweb test:native-pair: + Use this page when you want a copyable script that runs a calculator through\nweb test:native-pair: + the plain SDK.\nweb test:native-pair: +\nweb test:native-pair: + ## Before you start [#before-you-start]\nweb test:native-pair: +\nweb test:native-pair: + The SDK package is private until release approval. Run this from the workspace\nweb test:native-pair: + or adapt the imports after the SDK is published.\nweb test:native-pair: +\nweb test:native-pair: + ## Create a script [#create-a-script]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const report = await au.incomeTax.annual({\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + console.log({\nweb test:native-pair: +   liabilityCents: report.liability.cents,\nweb test:native-pair: +   currency: report.liability.currency,\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Understand the input [#understand-the-input]\nweb test:native-pair: +\nweb test:native-pair: + \\`taxableIncome\\` is a canonical calculator fact. The value uses the \\`Money\\`\nweb test:native-pair: + schema from \\`@taxkit/core/primitives\\`, created with the \\`aud\\` constructor.\nweb test:native-pair: + Pass integer cents rather than floating point dollars.\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + aud(Cents.make(9_000_000)); // AUD 90,000.00\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Use the generic facade [#use-the-generic-facade]\nweb test:native-pair: +\nweb test:native-pair: + Australian helpers call the same generic facade that other SDK consumers use:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { TaxKit } from \"@taxkit/sdk\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const report = await TaxKit.calculate(au.calculations.annualIncomeTax, {\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Verify the result [#verify-the-result]\nweb test:native-pair: +\nweb test:native-pair: + The report type is inferred from \\`au.calculations.annualIncomeTax\\`. If you pass\nweb test:native-pair: + facts for another calculator, TypeScript should reject the call before runtime.\nweb test:native-pair: + Runtime schema decoding still protects calls that receive untrusted input.\nweb test:native-pair: +\nweb test:native-pair: + ## Next steps [#next-steps]\nweb test:native-pair: +\nweb test:native-pair: + * Read [Type safety](/sdk/type-safety) for compile-time and runtime checks.\nweb test:native-pair: + * Read [Safe SDK](/sdk/safe-sdk) if you want result values instead of\nweb test:native-pair: +   rejected Promises.\nweb test:native-pair: + `,i={contents:[{heading:`run-your-first-calculation`,content:`Use this page when you want a copyable script that runs a calculator through\nweb test:native-pair: + the plain SDK.`},{heading:`before-you-start`,content:`The SDK package is private until release approval. Run this from the workspace\nweb test:native-pair: + or adapt the imports after the SDK is published.`},{heading:`understand-the-input`,content:\"`taxableIncome` is a canonical calculator fact. The value uses the `Money`\\nschema from `@taxkit/core/primitives`, created with the `aud` constructor.\\nPass integer cents rather than floating point dollars.\"},{heading:`use-the-generic-facade`,content:`Australian helpers call the same generic facade that other SDK consumers use:`},{heading:`verify-the-result`,content:`The report type is inferred from \\`au.calculations.annualIncomeTax\\`. If you pass\nweb test:native-pair: + facts for another calculator, TypeScript should reject the call before runtime.\nweb test:native-pair: + Runtime schema decoding still protects calls that receive untrusted input.`},{heading:`next-steps`,content:`Read Type safety for compile-time and runtime checks.`},{heading:`next-steps`,content:`Read Safe SDK if you want result values instead of\nweb test:native-pair: + rejected Promises.`}],headings:[{id:`run-your-first-calculation`,content:`Run your first calculation`},{id:`before-you-start`,content:`Before you start`},{id:`create-a-script`,content:`Create a script`},{id:`understand-the-input`,content:`Understand the input`},{id:`use-the-generic-facade`,content:`Use the generic facade`},{id:`verify-the-result`,content:`Verify the result`},{id:`next-steps`,content:`Next steps`}]},a=[{depth:1,url:`#run-your-first-calculation`,title:(0,t.jsx)(t.Fragment,{children:`Run your first calculation`})},{depth:2,url:`#before-you-start`,title:(0,t.jsx)(t.Fragment,{children:`Before you start`})},{depth:2,url:`#create-a-script`,title:(0,t.jsx)(t.Fragment,{children:`Create a script`})},{depth:2,url:`#understand-the-input`,title:(0,t.jsx)(t.Fragment,{children:`Understand the input`})},{depth:2,url:`#use-the-generic-f