,{href:`/contributing/pr-evidence-checklist`,children:`PR evidence checklist`}),`.`]})]})}function s(e={}){let{wrapper:n}=e.components||{};return n?(0,t.jsx)(n,{...e,children:(0,t.jsx)(o,{...e})}):o(e)}export{r as _markdown,s as default,n as frontmatter,i as structuredData,a as toc};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Add a source-backed rule with parameter services, descriptors and golden tests.`,status:`published`,title:`Add a rule`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # Add a rule [#add-a-rule]\nweb test:native-pair: +\nweb test:native-pair: + Use this guide when you need a source-backed calculation rule, threshold,\nweb test:native-pair: + coefficient formula, parameter table or derived fact.\nweb test:native-pair: +\nweb test:native-pair: + ## Before you start [#before-you-start]\nweb test:native-pair: +\nweb test:native-pair: + * Read [Rules and parameters](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/rules-and-parameters.md).\nweb test:native-pair: + * Read [Testing and quality](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/testing-and-quality.md).\nweb test:native-pair: + * Find the rule package that owns the tax area:\nweb test:native-pair: +   \\`@taxkit/rules-au-pay\\`, \\`@taxkit/rules-au-income-tax\\` or\nweb test:native-pair: +   \\`@taxkit/rules-au-stsl\\`.\nweb test:native-pair: +\nweb test:native-pair: + The rule package owns the rule layer, parameter service, descriptor, source\nweb test:native-pair: + references, graph metadata, rule-pack composition and golden tests.\nweb test:native-pair: +\nweb test:native-pair: + ## Proposal [#proposal]\nweb test:native-pair: +\nweb test:native-pair: + Before implementation, write down:\nweb test:native-pair: +\nweb test:native-pair: + * the official source and section, table, schedule or page range\nweb test:native-pair: + * the effective period and tax year\nweb test:native-pair: + * the input facts and parameter services the rule requires\nweb test:native-pair: + * the facts, traces or ledger components the rule provides\nweb test:native-pair: + * the rounding mode and edge cases\nweb test:native-pair: + * whether the change needs API compatibility tests or SDK compatibility tests\nweb test:native-pair: +\nweb test:native-pair: + ## Implementation [#implementation]\nweb test:native-pair: +\nweb test:native-pair: + Rules are Effect \\`Layer\\`s. Parameter tables are services, not imported\nweb test:native-pair: + globals. The existing Schedule 1 parameter file uses this definition:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + export const AtoSchedule1_2025_26_Live =\nweb test:native-pair: +   Layer.succeed(AtoSchedule1Table)(table2025_26);\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + This is an excerpt from\nweb test:native-pair: + [the owning parameter source](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/packages/rules/au/pay/src/parameters/schedule1.ts).\nweb test:native-pair: + That file imports \\`Layer\\`, defines \\`AtoSchedule1Table\\` and checks \\`table2025_26\\`\nweb test:native-pair: + with its owning schema. The excerpt needs those definitions; it is not a\nweb test:native-pair: + complete application example.\nweb test:native-pair: +\nweb test:native-pair: + Keep algorithm code separate from yearly data. Most tax-year updates should\nweb test:native-pair: + add schema-validated parameter data and golden tests without rewriting the\nweb test:native-pair: + rule algorithm.\nweb test:native-pair: +\nweb test:native-pair: + ## Tests [#tests]\nweb test:native-pair: +\nweb test:native-pair: + Your evidence should include:\nweb test:native-pair: +\nweb test:native-pair: + * source reference validation for each official source\nweb test:native-pair: + * effective-date overlap checks for parameter descriptors\nweb test:native-pair: + * graph cycle and duplicate-provider checks\nweb test:native-pair: + * golden tests from official examples or known scenarios\nweb test:native-pair: + * date-boundary tests when thresholds change across periods\nweb test:native-pair: + * trace snapshot tests when rule IDs, source references or ledgers change\nweb test:native-pair: + * package export or type tests when public exports change\nweb test:native-pair: +\nweb test:native-pair: + ## Pull request evidence [#pull-request-evidence]\nweb test:native-pair: +\nweb test:native-pair: + Use [Source citation standards](/contributing/source-citation-standards) and\nweb test:native-pair: + [PR evidence checklist](/contributing/pr-evidence-checklist). Explain whether the\nweb test:native-pair: + rule changes public API or SDK behaviour, even when endpoint shapes do not\nweb test:native-pair: + change.\nweb test:native-pair: + `,i={contents:[{heading:`add-a-rule`,content:`Use this guide when you need a source-backed calculation rule, threshold,\nweb test:native-pair: + coefficient formula, parameter table or derived fact.`},{heading:`before-you-start`,content:`Read Rules and parameters.`},{heading:`before-you-start`,content:`Read Testing and quality.`},{heading:`before-you-start`,content:\"Find the rule package that owns the tax area:\\n`@taxkit/rules-au-pay`, `@taxkit/rules-au-income-tax` or\\n`@taxkit/rules-au-stsl`.\"},{heading:`before-you-start`,content:`The rule package owns the rule layer, parameter service, descriptor, source\nweb test:native-pair: + references, graph metadata, rule-pack composition and golden tests.`},{heading:`proposal`,content:`Before implementation, write down:`},{heading:`proposal`,content:`the official source and section, table, schedule or page range`},{heading:`proposal`,content:`the effective period and tax year`},{heading:`proposal`,content:`the input facts and parameter services the rule requires`},{heading:`proposal`,content:`the facts, traces or ledger components the rule provides`},{heading:`proposal`,content:`the rounding mode and edge cases`},{heading:`proposal`,content:`whether the change needs API compatibility tests or SDK compatibility tests`},{heading:`implementation`,content:\"Rules are Effect `Layer`s. Parameter tables are services, not imported\\nglobals. The existing Schedule 1 parameter file uses this definition:\"},{heading:`implementation`,content:\"This is an excerpt from\\nthe owning parameter source.\\nThat file imports `Layer`, defines `AtoSchedule1Table` and checks `table2025_26`\\nwith its owning schema. The excerpt needs those definitions; it is not a\\ncomplete application example.\"},{heading:`implementation`,content:`Keep algorithm code separate from yearly data. Most tax-year updates should\nweb test:native-pair: + add schema-validated parameter data and golden tests without rewriting the\nweb test:native-pair: + rule algorithm.`},{heading:`tests`,content:`Your evidence should include:`},{heading:`tests`,content:`source reference validation for each official source`},{heading:`tests`,content:`effective-date overlap checks for parameter descriptors`},{heading:`tests`,content:`graph cycle and duplicate-provider checks`},{heading:`tests`,content:`golden tests from official examples or known scenarios`},{heading:`tests`,content:`date-boundary tests when thresholds change across periods`},{heading:`tests`,content:`trace snapshot tests when rule IDs, source references or ledgers change`},{heading:`tests`,content:`package export or type tests when public exports change`},{heading:`pull-request-evidence`,content:`Use Source citation standards and\nweb test:native-pair: + PR evidence checklist. Explain whether the\nweb test:native-pair: + rule changes public API or SDK behaviour, even when endpoint shapes do not\nweb test:native-pair: + change.`}],headings:[{id:`add-a-rule`,content:`Add a rule`},{id:`before-you-start`,content:`Before you start`},{id:`prop