{"timestamp":"2026-10-06T18:41:29.023Z","ordinal":50635,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","item":{"type":"CommandExecution","id":"exec-6ba34a6b-9019-476a-8459-71a35de284e7","process_id":"17570","command":["/bin/zsh","-lc","sed -n '295,439p' apps/web/test/native-pair.boundary.test.ts; sed -n '1590,1645p' apps/web/test/native-pair.boundary.test.ts; sed -n '1,175p' packages/content/test/service.test.ts; sed -n '1,145p' packages/content/test/schemas.test.ts"],"cwd":"file:///Users/cooper/.codex/worktrees/aac7/taxkit","parsed_cmd":[{"type":"read","cmd":"sed -n '295,439p' apps/web/test/native-pair.boundary.test.ts","name":"native-pair.boundary.test.ts","path":"apps/web/test/native-pair.boundary.test.ts"},{"type":"read","cmd":"sed -n '1590,1645p' apps/web/test/native-pair.boundary.test.ts","name":"native-pair.boundary.test.ts","path":"apps/web/test/native-pair.boundary.test.ts"},{"type":"read","cmd":"sed -n '1,175p' packages/content/test/service.test.ts","name":"service.test.ts","path":"packages/content/test/service.test.ts"},{"type":"read","cmd":"sed -n '1,145p' packages/content/test/schemas.test.ts","name":"schemas.test.ts","path":"packages/content/test/schemas.test.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"        // Compare the actual built Worker with the owning checked catalogue,\n        // including every body rather than accepting a count or a placeholder.\n        const publicContent = yield* fs\n          .readFileString(\n            path.join(\n              root,\n              \"packages/docs-content/.source/public-catalogue.json\"\n            )\n          )\n          .pipe(\n            Effect.flatMap(\n              Schema.decodeEffect(Schema.fromJsonString(DocsPublicCatalogue))\n            )\n          );\n        expect(publicContent.pages).toHaveLength(61);\n        // Native RPC restores the same catalogue values across separate\n        // actual Worker requests. No authored source or compiler is consulted.\n        const discoveryDocuments = yield* Effect.gen(function* () {\n          const client = yield* DocsRpcClient;\n          expect(yield* client.getNavigation()).toEqual(\n            publicContent.navigation\n          );\n          yield* Effect.forEach(publicContent.pages, (page) =>\n            Effect.gen(function* () {\n              expect(yield* client.getPage(page.path)).toEqual(page);\n              expect(yield* client.getMarkdown(page.path)).toBe(page.markdown);\n            })\n          );\n          const term = yield* Schema.decodeEffect(DocsSearchTerm)(\"Quickstart\");\n          const results = yield* client.searchPages(term);\n          expect(results.length).toBeGreaterThan(0);\n          expect(results.length).toBeLessThanOrEqual(20);\n          expect(\n            Array.every(results, (result) => result.excerpt.length <= 240)\n          ).toBe(true);\n          return yield* Effect.forEach(\n            DocsDiscoveryPath.literals,\n            client.getDiscovery\n          );\n        }).pipe(\n          Effect.provide(\n            DocsRpcClientLive(catalogueOrigin).pipe(\n              Layer.provide(FetchHttpClient.layer)\n            )\n          )\n        );\n        const unavailableDiscoveryWorker = yield* Effect.promise(() =>\n          website.getWorker(\"taxkit-website-unavailable\")\n        );\n        yield* Effect.forEach(discoveryDocuments, (document) =>\n          Effect.gen(function* () {\n            const served = yield* Effect.promise(() =>\n              website.dispatchFetch(`${websiteOrigin}${document.path}`)\n            );\n            expect(served.status).toBe(200);\n            expect(served.headers.get(\"content-type\")).toBe(\n              `${document.contentType}; charset=utf-8`\n            );\n            expect(served.headers.get(\"cache-control\")).toBe(\n              \"public, max-age=300\"\n            );\n            expect(served.headers.get(\"x-content-type-options\")).toBe(\n              \"nosniff\"\n            );\n            expect(yield* Effect.promise(() => served.text())).toBe(\n              document.body\n            );\n            const head = yield* Effect.promise(() =>\n              website.dispatchFetch(`${websiteOrigin}${document.path}`, {\n                method: \"HEAD\",\n              })\n            );\n            expect(head.status).toBe(200);\n            expect(head.headers.get(\"content-type\")).toBe(\n              served.headers.get(\"content-type\")\n            );\n            expect(yield* Effect.promise(() => head.text())).toBe(\"\");\n            const wrongMethod = yield* Effect.promise(() =>\n              website.dispatchFetch(`${websiteOrigin}${document.path}`, {\n                body: \"PRIVATE9\",\n                method: \"POST\",\n              })\n            );\n            expect(wrongMethod.status).toBe(405);\n            expect(wrongMethod.headers.get(\"allow\")).toBe(\"GET, HEAD\");\n            expect(yield* Effect.promise(() => wrongMethod.text())).toBe(\"\");\n            const query = yield* Effect.promise(() =>\n              website.dispatchFetch(\n                `${websiteOrigin}${document.path}?PRIVATE9=1`\n              )\n            );\n            expect(query.status).toBe(400);\n            expect(yield* Effect.promise(() => query.text())).toBe(\"\");\n            const unavailable = yield* Effect.promise(() =>\n              unavailableDiscoveryWorker.fetch(\n                `${websiteOrigin}${document.path}`\n              )\n            );\n            expect(unavailable.status).toBe(503);\n            expect(unavailable.headers.get(\"cache-control\")).toBe(\"no-store\");\n            expect(yield* Effect.promise(() => unavailable.text())).toBe(\"\");\n          })\n        );\n        const discoverySitemap = yield* Array.findFirst(\n          discoveryDocuments,\n          (document) => document.path === \"/sitemap.xml\"\n        ).pipe(Effect.fromOption);\n        const discoveryIndex = yield* Array.findFirst(\n          discoveryDocuments,\n          (document) => document.path === \"/llms.txt\"\n        ).pipe(Effect.fromOption);\n        const discoveryFull = yield* Array.findFirst(\n          discoveryDocuments,\n          (document) => document.path === \"/llms-full.txt\"\n        ).pipe(Effect.fromOption);\n        expect(discoverySitemap.body).not.toContain(\"lastmod\");\n        expect(discoverySitemap.body).not.toContain(\"/search\");\n        expect(discoveryIndex.body).not.toContain(\".mdx\");\n        // Exact processed-body comparison preserves useful fenced import/code\n        // examples. It must not reject every line beginning with \"import\".\n        yield* Effect.forEach(publicContent.pages, (page) =>\n          Effect.sync(() => {\n            expect(discoverySitemap.body).toContain(\n              `<loc>${websiteOrigin}${page.path}</loc>`\n            );\n            expect(discoveryIndex.body).toContain(\n              `(${apiOrigin}/api/v1/docs/markdown?${new URLSearchParams({ path: page.path }).toString()})`\n            );\n            expect(discoveryFull.body).toContain(\n              `Canonical page: ${websiteOrigin}${page.path}\\n\\n${page.markdown}`\n            );\n          })\n        );\n        const docsNavigation = yield* Effect.promise(() =>\n          publicApi.dispatchFetch(`${apiOrigin}/api/v1/docs/navigation`)\n        );\n        expect(docsNavigation.status).toBe(200);\n        expect(\n          yield* Schema.decodeEffect(\n            Schema.fromJsonString(DocsPublicNavigation)\n          )(yield* Effect.promise(() => docsNavigation.text()))\n        ).toEqual(publicContent.navigation);\n        yield* Effect.forEach(publicContent.pages, (expectedPage) =>\n          Effect.gen(function* () {\n            const query = new URLSearchParams({ path: expectedPage.path });\n            },\n          ],\n          (invalidDocsRequest) =>\n            Effect.gen(function* () {\n              const response = yield* Effect.promise(() =>\n                website.dispatchFetch(\n                  `${nativeDocsAddress}${invalidDocsRequest.suffix}`,\n                  {\n                    headers: invalidDocsRequest.headers,\n                  }\n                )\n              );\n              expect(response.status).toBe(400);\n              expect(yield* Effect.promise(() => response.text())).toBe(\"\");\n            })\n        );\n        const docsPage = yield* Effect.promise(() => context.newPage());\n        const parsedSitemap = yield* Effect.promise(() =>\n          docsPage.evaluate((xml) => {\n            const document = new DOMParser().parseFromString(\n              xml,\n              \"application/xml\"\n            );\n            return {\n              hasParserError: document.querySelector(\"parsererror\") !== null,\n              locationCount: document.querySelectorAll(\"loc\").length,\n              locationText: document.documentElement.textContent ?? \"\",\n              namespace: document.documentElement.namespaceURI,\n            };\n          }, discoverySitemap.body)\n        );\n        expect(parsedSitemap.hasParserError).toBe(false);\n        expect(parsedSitemap.namespace).toBe(\n          \"http://www.sitemaps.org/schemas/sitemap/0.9\"\n        );\n        expect(parsedSitemap.locationCount).toBe(61);\n        expect(parsedSitemap.locationText.trim().split(/\\s+/u)).toEqual(\n          Array.map(\n            publicContent.pages,\n            (item) => `${websiteOrigin}${item.path}`\n          )\n        );\n        docsPage.on(\"pageerror\", (error) =>\n          Queue.offerUnsafe(exceptions, error.message)\n        );\n        const docsCalls = yield* Queue.make<string>();\n        const docsDocuments = yield* Queue.make<string>();\n        docsPage.on(\"request\", (request) => {\n          if (new URL(request.url()).pathname.startsWith(\"/_serverFn/\")) {\n            Queue.offerUnsafe(docsCalls, request.url());\n          }\n          if (\n            request.isNavigationRequest() &&\n            request.frame() === docsPage.mainFrame()\n          ) {\n            Queue.offerUnsafe(docsDocuments, request.url());\nimport { assert, describe, it } from \"@effect/vitest\";\nimport { Array, Effect, Layer, Ref, Schema } from \"effect\";\n\nimport {\n  exampleContentCatalogue,\n  exampleDiscoverySettings,\n} from \"../src/__testing__/fixtures.js\";\nimport { DocsSourceError } from \"../src/errors.js\";\nimport { ContentDiscoveryLive, ContentServiceLive } from \"../src/live.layer.js\";\nimport {\n  DocsDiscoveryPath,\n  DocsDiscoverySettings,\n  DocsPagePath,\n  DocsPublicCatalogue,\n  DocsSearchTerm,\n} from \"../src/schemas.js\";\nimport {\n  ContentCatalogue,\n  ContentDiscovery,\n  ContentService,\n} from \"../src/service.js\";\nimport {\n  makeContentDiscoveryTest,\n  makeContentTest,\n} from \"../src/test.layer.js\";\n\ndescribe(\"accepted content service\", () => {\n  it.effect(\n    \"derives discovery from accepted pages and checked stage addresses\",\n    () =>\n      Effect.gen(function* () {\n        const catalogue = yield* exampleContentCatalogue;\n        const settings = yield* exampleDiscoverySettings;\n        const setup = yield* makeContentDiscoveryTest(catalogue, settings);\n        yield* Effect.gen(function* () {\n          const discovery = yield* ContentDiscovery;\n          const sitemap = yield* discovery.getDocument(\"/sitemap.xml\");\n          assert.equal(sitemap.contentType, \"application/xml\");\n          assert.include(\n            sitemap.body,\n            \"<loc>https://website.example.com/start/overview</loc>\"\n          );\n          assert.notInclude(sitemap.body, \"lastmod\");\n          assert.notInclude(sitemap.body, \"/search\");\n          const robots = yield* discovery.getDocument(\"/robots.txt\");\n          assert.include(\n            robots.body,\n            \"Sitemap: https://website.example.com/sitemap.xml\"\n          );\n          assert.notInclude(robots.body, \"Disallow: /search\");\n          const index = yield* discovery.getDocument(\"/llms.txt\");\n          assert.include(\n            index.body,\n            \"[Start here](https://api.example.com/api/v1/docs/markdown?path=%2Fstart%2Foverview)\"\n          );\n          assert.notInclude(index.body, \"content/start/overview.mdx\");\n          const full = yield* discovery.getDocument(\"/llms-full.txt\");\n          assert.include(\n            full.body,\n            \"Canonical page: https://website.example.com/start/overview\"\n          );\n          yield* Effect.forEach(catalogue.pages, (page) =>\n            Effect.sync(() => assert.include(full.body, page.markdown))\n          );\n        }).pipe(Effect.provide(setup.layer));\n        assert.deepEqual(\n          yield* Ref.get(setup.observations.requestedDocuments),\n          DocsDiscoveryPath.literals\n        );\n      })\n  );\n\n  it.effect(\n    \"keeps deferred settings lazy and reads one configured address set\",\n    () =>\n      Effect.gen(function* () {\n        const observed = yield* Ref.make(0);\n        const settings = yield* exampleDiscoverySettings;\n        const layer = ContentDiscoveryLive(\n          Ref.update(observed, (count) => count + 1).pipe(Effect.as(settings))\n        ).pipe(\n          Layer.provide(Layer.effect(ContentCatalogue, exampleContentCatalogue))\n        );\n        yield* Effect.gen(function* () {\n          const discovery = yield* ContentDiscovery;\n          assert.equal(yield* Ref.get(observed), 0);\n          yield* Effect.forEach(\n            DocsDiscoveryPath.literals,\n            discovery.getDocument\n          );\n          assert.equal(yield* Ref.get(observed), 1);\n        }).pipe(Effect.provide(layer));\n      })\n  );\n\n  it.effect(\n    \"keeps unavailable stage settings in the named failure channel\",\n    () =>\n      Effect.gen(function* () {\n        const expected = new DocsSourceError({\n          message: \"Settings unavailable.\",\n          operation: \"getDiscoveryDocument\",\n        });\n        const result = yield* ContentDiscovery.pipe(\n          Effect.flatMap((service) => service.getDocument(\"/sitemap.xml\")),\n          Effect.flip,\n          Effect.provide(\n            ContentDiscoveryLive(Effect.fail(expected)).pipe(\n              Layer.provide(\n                Layer.effect(ContentCatalogue, exampleContentCatalogue)\n              )\n            )\n          )\n        );\n        assert.deepEqual(result, expected);\n      })\n  );\n\n  it.effect(\n    \"escapes Markdown labels and preserves processed bodies under a different stage\",\n    () =>\n      Effect.gen(function* () {\n        const original = yield* exampleContentCatalogue;\n        const catalogue = yield* DocsPublicCatalogue.makeEffect({\n          ...original,\n          navigation: {\n            primaryNavigation: Array.map(\n              original.navigation.primaryNavigation,\n              (page) => ({ ...page, title: \"[Start] \\\\ guide\" })\n            ),\n          },\n          pages: Array.map(original.pages, (page) => ({\n            ...page,\n            frontmatter: {\n              ...page.frontmatter,\n              description: \"First line.\\nSecond line.\",\n              title: \"[Start] \\\\ guide\",\n            },\n          })),\n        });\n        const settings = yield* Schema.decodeEffect(DocsDiscoverySettings)({\n          apiOrigin: \"http://127.0.0.1:4001\",\n          websiteOrigin: \"http://127.0.0.1:4000\",\n        });\n        const setup = yield* makeContentDiscoveryTest(catalogue, settings);\n        const index = yield* ContentDiscovery.pipe(\n          Effect.flatMap((service) => service.getDocument(\"/llms.txt\")),\n          Effect.provide(setup.layer)\n        );\n        assert.include(\n          index.body,\n          \"[\\\\[Start\\\\] \\\\\\\\ guide](http://127.0.0.1:4001/api/v1/docs/markdown?path=%2Fstart%2Foverview): First line. Second line.\"\n        );\n        assert.notInclude(index.body, \"example.com\");\n      })\n  );\n  it.effect(\n    \"returns the injected pages and navigation; missing pages remain a typed failure\",\n    () =>\n      Effect.gen(function* () {\n        const catalogue = yield* exampleContentCatalogue;\n        const setup = yield* makeContentTest(catalogue);\n        const path = yield* DocsPagePath.makeEffect(\"/start/overview\");\n        const missingPath = yield* DocsPagePath.makeEffect(\"/missing\");\n        yield* Effect.gen(function* () {\n          const content = yield* ContentService;\n          assert.deepEqual(yield* content.listPages(), catalogue.pages);\n          assert.deepEqual(\n            yield* content.getNavigation(),\n            catalogue.navigation\n          );\n          assert.strictEqual(\n            (yield* content.getPage(path)).frontmatter.title,\n            \"Start here\"\n          );\nimport { assert, describe, it } from \"@effect/vitest\";\nimport { Array, Effect, Result, Schema } from \"effect\";\n\nimport { exampleContentCatalogue } from \"../src/__testing__/fixtures.js\";\nimport {\n  DocsDiscoveryDocument,\n  DocsDiscoverySettings,\n  DocsAcceptedSourceDigest,\n  DocsPublicCatalogue,\n  DocsPublicPage,\n  DocsSearchTerm,\n  PublicPageAcceptanceRecord,\n  PublicPageAcceptanceRecordV2,\n} from \"../src/schemas.js\";\n\ndescribe(\"public catalogue ingress\", () => {\n  it.effect(\n    \"rejects mismatched discovery media types and oversized bodies\",\n    () =>\n      Effect.gen(function* () {\n        yield* Effect.forEach(\n          [\n            {\n              body: \"<urlset/>\",\n              contentType: \"text/plain\",\n              path: \"/sitemap.xml\",\n            },\n            {\n              body: \"# TaxKit\",\n              contentType: \"application/xml\",\n              path: \"/llms.txt\",\n            },\n            { body: \"private\", contentType: \"text/plain\", path: \"/private\" },\n            {\n              body: \"x\".repeat(300_001),\n              contentType: \"text/plain\",\n              path: \"/llms-full.txt\",\n            },\n          ],\n          (value) =>\n            Schema.decodeUnknownEffect(DocsDiscoveryDocument)(value).pipe(\n              Effect.flip,\n              Effect.tap((error) =>\n                Effect.sync(() => assert.equal(error._tag, \"SchemaError\"))\n              )\n            )\n        );\n      })\n  );\n  it.effect(\n    \"admits HTTPS and exact local origins while rejecting address decorations\",\n    () =>\n      Effect.gen(function* () {\n        yield* Effect.forEach(\n          [\n            \"https://website.example.com\",\n            \"http://localhost:4000\",\n            \"http://127.0.0.1:4000\",\n          ],\n          (websiteOrigin) =>\n            Schema.decodeEffect(DocsDiscoverySettings)({\n              apiOrigin: \"https://api.example.com\",\n              websiteOrigin,\n            })\n        );\n        yield* Effect.forEach(\n          [\n            \"http://website.example.com\",\n            \"https://website.example.com/path\",\n            \"https://website.example.com?private=1\",\n            \"REDACTED\",\n            \"https://website.example.com/#private\",\n          ],\n          (websiteOrigin) =>\n            Schema.decodeEffect(DocsDiscoverySettings)({\n              apiOrigin: \"https://api.example.com\",\n              websiteOrigin,\n            }).pipe(Effect.flip)\n        );\n      })\n  );\n  it.effect(\n    \"retains legacy acceptance records and requires a hash in version two\",\n    () =>\n      Effect.gen(function* () {\n        const legacy =\n          '{\"observedAt\":\"2026-07-21T22:30:00Z\",\"owner\":\"product-owner\",\"schemaVersion\":1,\"state\":\"accepted\",\"targetPath\":\"packages/docs-content/content/guide.mdx\"}';\n        const codec = Schema.fromJsonString(PublicPageAcceptanceRecord);\n        const record = yield* Schema.decodeEffect(codec, {\n          onExcessProperty: \"error\",\n        })(legacy);\n        assert.equal(yield* Schema.encodeEffect(codec)(record), legacy);\n        const second = yield* PublicPageAcceptanceRecordV2.makeEffect({\n          ...record,\n          schemaVersion: 2,\n          sourceSha256: yield* DocsAcceptedSourceDigest.makeEffect(\n            \"0\".repeat(64)\n          ),\n        });\n        const wire = yield* Schema.encodeEffect(codec)(second);\n        assert.deepEqual(\n          yield* Schema.decodeEffect(codec, { onExcessProperty: \"error\" })(\n            wire\n          ),\n          second\n        );\n        yield* Effect.forEach(\n          [\n            wire.replace('\"schemaVersion\":2', '\"schemaVersion\":3'),\n            wire.replace(\n              `\"sourceSha256\":\"${\"0\".repeat(64)}\"`,\n              '\"sourceSha256\":\"bad\"'\n            ),\n            legacy.replace('\"schemaVersion\":1', '\"schemaVersion\":2'),\n            wire.replace('\"state\":\"accepted\"', '\"state\":\"draft\"'),\n          ],\n          (invalid) =>\n            Schema.decodeEffect(codec, { onExcessProperty: \"error\" })(\n              invalid\n            ).pipe(\n              Effect.flip,\n              Effect.tap((error) =>\n                Effect.sync(() => assert.equal(error._tag, \"SchemaError\"))\n              )\n            )\n        );\n      })\n  );\n  it.effect(\"round-trips the one accepted wire version\", () =>\n    Effect.gen(function* () {\n      const catalogue = yield* exampleContentCatalogue;\n      const wire = yield* Schema.encodeEffect(DocsPublicCatalogue)(catalogue);\n      assert.deepEqual(\n        yield* Schema.decodeUnknownEffect(DocsPublicCatalogue)(wire),\n        catalogue\n      );\n    })\n  );\n\n  it.effect(\n    \"rejects drafts, mismatched addresses and unrelated source files\",\n    () =>\n      Effect.gen(function* () {\n        const catalogue = yield* exampleContentCatalogue;\n        yield* Effect.forEach(catalogue.pages, (page) =>\n","stderr":"","aggregated_output":"        // Compare the actual built Worker with the owning checked catalogue,\n        // including every body rather than accepting a count or a placeholder.\n        const publicContent = yield* fs\n          .readFileString(\n            path.join(\n              root,\n              \"packages/docs-content/.source/public-catalogue.json\"\n            )\n          )\n          .pipe(\n            Effect.flatMap(\n              Schema.decodeEffect(Schema.fromJsonString(DocsPublicCatalogue))\n            )\n          );\n        expect(publicContent.pages).toHaveLength(61);\n        // Native RPC restores the same catalogue values across separate\n        // actual Worker requests. No authored source or compiler is consulted.\n        const discoveryDocuments = yield* Effect.gen(function* () {\n          const client = yield* DocsRpcClient;\n          expect(yield* client.getNavigation()).toEqual(\n            publicContent.navigation\n          );\n          yield* Effect.forEach(publicContent.pages, (page) =>\n            Effect.gen(function* () {\n              expect(yield* client.getPage(page.path)).toEqual(page);\n              expect(yield* client.getMarkdown(page.path)).toBe(page.markdown);\n            })\n          );\n          const term = yield* Schema.decodeEffect(DocsSearchTerm)(\"Quickstart\");\n          const results = yield* client.searchPages(term);\n          expect(results.length).toBeGreaterThan(0);\n          expect(results.length).toBeLessThanOrEqual(20);\n          expect(\n            Array.every(results, (result) => result.excerpt.length <= 240)\n          ).toBe(true);\n          return yield* Effect.forEach(\n            DocsDiscoveryPath.literals,\n            client.getDiscovery\n          );\n        }).pipe(\n          Effect.provide(\n            DocsRpcClientLive(catalogueOrigin).pipe(\n              Layer.provide(FetchHttpClient.layer)\n            )\n          )\n        );\n        const unavailableDiscoveryWorker = yield* Effect.promise(() =>\n          website.getWorker(\"taxkit-website-unavailable\")\n        );\n        yield* Effect.forEach(discoveryDocuments, (document) =>\n          Effect.gen(function* () {\n            const served = yield* Effect.promise(() =>\n              website.dispatchFetch(`${websiteOrigin}${document.path}`)\n            );\n            expect(served.status).toBe(200);\n            expect(served.headers.get(\"content-type\")).toBe(\n              `${document.contentType}; charset=utf-8`\n            );\n            expect(served.headers.get(\"cache-control\")).toBe(\n              \"public, max-age=300\"\n            );\n            expect(served.headers.get(\"x-content-type-options\")).toBe(\n              \"nosniff\"\n            );\n            expect(yield* Effect.promise(() => served.text())).toBe(\n              document.body\n            );\n            const head = yield* Effect.promise(() =>\n              website.dispatchFetch(`${websiteOrigin}${document.path}`, {\n                method: \"HEAD\",\n              })\n            );\n            expect(head.status).toBe(200);\n            expect(head.headers.get(\"content-type\")).toBe(\n              served.headers.get(\"content-type\")\n            );\n            expect(yield* Effect.promise(() => head.text())).toBe(\"\");\n            const wrongMethod = yield* Effect.promise(() =>\n              website.dispatchFetch(`${websiteOrigin}${document.path}`, {\n                body: \"PRIVATE9\",\n                method: \"POST\",\n              })\n            );\n            expect(wrongMethod.status).toBe(405);\n            expect(wrongMethod.headers.get(\"allow\")).toBe(\"GET, HEAD\");\n            expect(yield* Effect.promise(() => wrongMethod.text())).toBe(\"\");\n            const query = yield* Effect.promise(() =>\n              website.dispatchFetch(\n                `${websiteOrigin}${document.path}?PRIVATE9=1`\n              )\n            );\n            expect(query.status).toBe(400);\n            expect(yield* Effect.promise(() => query.text())).toBe(\"\");\n            const unavailable = yield* Effect.promise(() =>\n              unavailableDiscoveryWorker.fetch(\n                `${websiteOrigin}${document.path}`\n              )\n            );\n            expect(unavailable.status).toBe(503);\n            expect(unavailable.headers.get(\"cache-control\")).toBe(\"no-store\");\n            expect(yield* Effect.promise(() => unavailable.text())).toBe(\"\");\n          })\n        );\n        const discoverySitemap = yield* Array.findFirst(\n          discoveryDocuments,\n          (document) => document.path === \"/sitemap.xml\"\n        ).pipe(Effect.fromOption);\n        const discoveryIndex = yield* Array.findFirst(\n          discoveryDocuments,\n          (document) => document.path === \"/llms.txt\"\n        ).pipe(Effect.fromOption);\n        const discoveryFull = yield* Array.findFirst(\n          discoveryDocuments,\n          (document) => document.path === \"/llms-full.txt\"\n        ).pipe(Effect.fromOption);\n        expect(discoverySitemap.body).not.toContain(\"lastmod\");\n        expect(discoverySitemap.body).not.toContain(\"/search\");\n        expect(discoveryIndex.body).not.toContain(\".mdx\");\n        // Exact processed-body comparison preserves useful fenced import/code\n        // examples. It must not reject every line beginning with \"import\".\n        yield* Effect.forEach(publicContent.pages, (page) =>\n          Effect.sync(() => {\n            expect(discoverySitemap.body).toContain(\n              `<loc>${websiteOrigin}${page.path}</loc>`\n            );\n            expect(discoveryIndex.body).toContain(\n              `(${apiOrigin}/api/v1/docs/markdown?${new URLSearchParams({ path: page.path }).toString()})`\n            );\n            expect(discoveryFull.body).toContain(\n              `Canonical page: ${websiteOrigin}${page.path}\\n\\n${page.markdown}`\n            );\n          })\n        );\n        const docsNavigation = yield* Effect.promise(() =>\n          publicApi.dispatchFetch(`${apiOrigin}/api/v1/docs/navigation`)\n        );\n        expect(docsNavigation.status).toBe(200);\n        expect(\n          yield* Schema.decodeEffect(\n            Schema.fromJsonString(DocsPublicNavigation)\n          )(yield* Effect.promise(() => docsNavigation.text()))\n        ).toEqual(publicContent.navigation);\n        yield* Effect.forEach(publicContent.pages, (expectedPage) =>\n          Effect.gen(function* () {\n            const query = new URLSearchParams({ path: expectedPage.path });\n            },\n          ],\n          (invalidDocsRequest) =>\n            Effect.gen(function* () {\n              const response = yield* Effect.promise(() =>\n                website.dispatchFetch(\n                  `${nativeDocsAddress}${invalidDocsRequest.suffix}`,\n                  {\n                    headers: invalidDocsRequest.headers,\n                  }\n                )\n              );\n              expect(response.status).toBe(400);\n              expect(yield* Effect.promise(() => response.text())).toBe(\"\");\n            })\n        );\n        const docsPage = yield* Effect.promise(() => context.newPage());\n        const parsedSitemap = yield* Effect.promise(() =>\n          docsPage.evaluate((xml) => {\n            const document = new DOMParser().parseFromString(\n              xml,\n              \"application/xml\"\n            );\n            return {\n              hasParserError: document.querySelector(\"parsererror\") !== null,\n              locationCount: document.querySelectorAll(\"loc\").length,\n              locationText: document.documentElement.textContent ?? \"\",\n              namespace: document.documentElement.namespaceURI,\n            };\n          }, discoverySitemap.body)\n        );\n        expect(parsedSitemap.hasParserError).toBe(false);\n        expect(parsedSitemap.namespace).toBe(\n          \"http://www.sitemaps.org/schemas/sitemap/0.9\"\n        );\n        expect(parsedSitemap.locationCount).toBe(61);\n        expect(parsedSitemap.locationText.trim().split(/\\s+/u)).toEqual(\n          Array.map(\n            publicContent.pages,\n            (item) => `${websiteOrigin}${item.path}`\n          )\n        );\n        docsPage.on(\"pageerror\", (error) =>\n          Queue.offerUnsafe(exceptions, error.message)\n        );\n        const docsCalls = yield* Queue.make<string>();\n        const docsDocuments = yield* Queue.make<string>();\n        docsPage.on(\"request\", (request) => {\n          if (new URL(request.url()).pathname.startsWith(\"/_serverFn/\")) {\n            Queue.offerUnsafe(docsCalls, request.url());\n          }\n          if (\n            request.isNavigationRequest() &&\n            request.frame() === docsPage.mainFrame()\n          ) {\n            Queue.offerUnsafe(docsDocuments, request.url());\nimport { assert, describe, it } from \"@effect/vitest\";\nimport { Array, Effect, Layer, Ref, Schema } from \"effect\";\n\nimport {\n  exampleContentCatalogue,\n  exampleDiscoverySettings,\n} from \"../src/__testing__/fixtures.js\";\nimport { DocsSourceError } from \"../src/errors.js\";\nimport { ContentDiscoveryLive, ContentServiceLive } from \"../src/live.layer.js\";\nimport {\n  DocsDiscoveryPath,\n  DocsDiscoverySettings,\n  DocsPagePath,\n  DocsPublicCatalogue,\n  DocsSearchTerm,\n} from \"../src/schemas.js\";\nimport {\n  ContentCatalogue,\n  ContentDiscovery,\n  ContentService,\n} from \"../src/service.js\";\nimport {\n  makeContentDiscoveryTest,\n  makeContentTest,\n} from \"../src/test.layer.js\";\n\ndescribe(\"accepted content service\", () => {\n  it.effect(\n    \"derives discovery from accepted pages and checked stage addresses\",\n    () =>\n      Effect.gen(function* () {\n        const catalogue = yield* exampleContentCatalogue;\n        const settings = yield* exampleDiscoverySettings;\n        const setup = yield* makeContentDiscoveryTest(catalogue, settings);\n        yield* Effect.gen(function* () {\n          const discovery = yield* ContentDiscovery;\n          const sitemap = yield* discovery.getDocument(\"/sitemap.xml\");\n          assert.equal(sitemap.contentType, \"application/xml\");\n          assert.include(\n            sitemap.body,\n            \"<loc>https://website.example.com/start/overview</loc>\"\n          );\n          assert.notInclude(sitemap.body, \"lastmod\");\n          assert.notInclude(sitemap.body, \"/search\");\n          const robots = yield* discovery.getDocument(\"/robots.txt\");\n          assert.include(\n            robots.body,\n            \"Sitemap: https://website.example.com/sitemap.xml\"\n          );\n          assert.notInclude(robots.body, \"Disallow: /search\");\n          const index = yield* discovery.getDocument(\"/llms.txt\");\n          assert.include(\n            index.body,\n            \"[Start here](https://api.example.com/api/v1/docs/markdown?path=%2Fstart%2Foverview)\"\n          );\n          assert.notInclude(index.body, \"content/start/overview.mdx\");\n          const full = yield* discovery.getDocument(\"/llms-full.txt\");\n          assert.include(\n            full.body,\n            \"Canonical page: https://website.example.com/start/overview\"\n          );\n          yield* Effect.forEach(catalogue.pages, (page) =>\n            Effect.sync(() => assert.include(full.body, page.markdown))\n          );\n        }).pipe(Effect.provide(setup.layer));\n        assert.deepEqual(\n          yield* Ref.get(setup.observations.requestedDocuments),\n          DocsDiscoveryPath.literals\n        );\n      })\n  );\n\n  it.effect(\n    \"keeps deferred settings lazy and reads one configured address set\",\n    () =>\n      Effect.gen(function* () {\n        const observed = yield* Ref.make(0);\n        const settings = yield* exampleDiscoverySettings;\n        const layer = ContentDiscoveryLive(\n          Ref.update(observed, (count) => count + 1).pipe(Effect.as(settings))\n        ).pipe(\n          Layer.provide(Layer.effect(ContentCatalogue, exampleContentCatalogue))\n        );\n        yield* Effect.gen(function* () {\n          const discovery = yield* ContentDiscovery;\n          assert.equal(yield* Ref.get(observed), 0);\n          yield* Effect.forEach(\n            DocsDiscoveryPath.literals,\n            discovery.getDocument\n          );\n          assert.equal(yield* Ref.get(observed), 1);\n        }).pipe(Effect.provide(layer));\n      })\n  );\n\n  it.effect(\n    \"keeps unavailable stage settings in the named failure channel\",\n    () =>\n      Effect.gen(function* () {\n        const expected = new DocsSourceError({\n          message: \"Settings unavailable.\",\n          operation: \"getDiscoveryDocument\",\n        });\n        const result = yield* ContentDiscovery.pipe(\n          Effect.flatMap((service) => service.getDocument(\"/sitemap.xml\")),\n          Effect.flip,\n          Effect.provide(\n            ContentDiscoveryLive(Effect.fail(expected)).pipe(\n              Layer.provide(\n                Layer.effect(ContentCatalogue, exampleContentCatalogue)\n              )\n            )\n          )\n        );\n        assert.deepEqual(result, expected);\n      })\n  );\n\n  it.effect(\n    \"escapes Markdown labels and preserves processed bodies under a different stage\",\n    () =>\n      Effect.gen(function* () {\n        const original = yield* exampleContentCatalogue;\n        const catalogue = yield* DocsPublicCatalogue.makeEffect({\n          ...original,\n          navigation: {\n            primaryNavigation: Array.map(\n              original.navigation.primaryNavigation,\n              (page) => ({ ...page, title: \"[Start] \\\\ guide\" })\n            ),\n          },\n          pages: Array.map(original.pages, (page) => ({\n            ...page,\n            frontmatter: {\n              ...page.frontmatter,\n              description: \"First line.\\nSecond line.\",\n              title: \"[Start] \\\\ guide\",\n            },\n          })),\n        });\n        const settings = yield* Schema.decodeEffect(DocsDiscoverySettings)({\n          apiOrigin: \"http://127.0.0.1:4001\",\n          websiteOrigin: \"http://127.0.0.1:4000\",\n        });\n        const setup = yield* makeContentDiscoveryTest(catalogue, settings);\n        const index = yield* ContentDiscovery.pipe(\n          Effect.flatMap((service) => service.getDocument(\"/llms.txt\")),\n          Effect.provide(setup.layer)\n        );\n        assert.include(\n          index.body,\n          \"[\\\\[Start\\\\] \\\\\\\\ guide](http://127.0.0.1:4001/api/v1/docs/markdown?path=%2Fstart%2Foverview): First line. Second line.\"\n        );\n        assert.notInclude(index.body, \"example.com\");\n      })\n  );\n  it.effect(\n    \"returns the injected pages and navigation; missing pages remain a typed failure\",\n    () =>\n      Effect.gen(function* () {\n        const catalogue = yield* exampleContentCatalogue;\n        const setup = yield* makeContentTest(catalogue);\n        const path = yield* DocsPagePath.makeEffect(\"/start/overview\");\n        const missingPath = yield* DocsPagePath.makeEffect(\"/missing\");\n        yield* Effect.gen(function* () {\n          const content = yield* ContentService;\n          assert.deepEqual(yield* content.listPages(), catalogue.pages);\n          assert.deepEqual(\n            yield* content.getNavigation(),\n            catalogue.navigation\n          );\n          assert.strictEqual(\n            (yield* content.getPage(path)).frontmatter.title,\n            \"Start here\"\n          );\nimport { assert, describe, it } from \"@effect/vitest\";\nimport { Array, Effect, Result, Schema } from \"effect\";\n\nimport { exampleContentCatalogue } from \"../src/__testing__/fixtures.js\";\nimport {\n  DocsDiscoveryDocument,\n  DocsDiscoverySettings,\n  DocsAcceptedSourceDigest,\n  DocsPublicCatalogue,\n  DocsPublicPage,\n  DocsSearchTerm,\n  PublicPageAcceptanceRecord,\n  PublicPageAcceptanceRecordV2,\n} from \"../src/schemas.js\";\n\ndescribe(\"public catalogue ingress\", () => {\n  it.effect(\n    \"rejects mismatched discovery media types and oversized bodies\",\n    () =>\n      Effect.gen(function* () {\n        yield* Effect.forEach(\n          [\n            {\n              body: \"<urlset/>\",\n              contentType: \"text/plain\",\n              path: \"/sitemap.xml\",\n            },\n            {\n              body: \"# TaxKit\",\n              contentType: \"application/xml\",\n              path: \"/llms.txt\",\n            },\n            { body: \"private\", contentType: \"text/plain\", path: \"/private\" },\n            {\n              body: \"x\".repeat(300_001),\n              contentType: \"text/plain\",\n              path: \"/llms-full.txt\",\n            },\n          ],\n          (value) =>\n            Schema.decodeUnknownEffect(DocsDiscoveryDocument)(value).pipe(\n              Effect.flip,\n              Effect.tap((error) =>\n                Effect.sync(() => assert.equal(error._tag, \"SchemaError\"))\n              )\n            )\n        );\n      })\n  );\n  it.effect(\n    \"admits HTTPS and exact local origins while rejecting address decorations\",\n    () =>\n      Effect.gen(function* () {\n        yield* Effect.forEach(\n          [\n            \"https://website.example.com\",\n            \"http://localhost:4000\",\n            \"http://127.0.0.1:4000\",\n          ],\n          (websiteOrigin) =>\n            Schema.decodeEffect(DocsDiscoverySettings)({\n              apiOrigin: \"https://api.example.com\",\n              websiteOrigin,\n            })\n        );\n        yield* Effect.forEach(\n          [\n            \"http://website.example.com\",\n            \"https://website.example.com/path\",\n            \"https://website.example.com?private=1\",\n            \"REDACTED\",\n            \"https://website.example.com/#private\",\n          ],\n          (websiteOrigin) =>\n            Schema.decodeEffect(DocsDiscoverySettings)({\n              apiOrigin: \"https://api.example.com\",\n              websiteOrigin,\n            }).pipe(Effect.flip)\n        );\n      })\n  );\n  it.effect(\n    \"retains legacy acceptance records and requires a hash in version two\",\n    () =>\n      Effect.gen(function* () {\n        const legacy =\n          '{\"observedAt\":\"2026-07-21T22:30:00Z\",\"owner\":\"product-owner\",\"schemaVersion\":1,\"state\":\"accepted\",\"targetPath\":\"packages/docs-content/content/guide.mdx\"}';\n        const codec = Schema.fromJsonString(PublicPageAcceptanceRecord);\n        const record = yield* Schema.decodeEffect(codec, {\n          onExcessProperty: \"error\",\n        })(legacy);\n        assert.equal(yield* Schema.encodeEffect(codec)(record), legacy);\n        const second = yield* PublicPageAcceptanceRecordV2.makeEffect({\n          ...record,\n          schemaVersion: 2,\n          sourceSha256: yield* DocsAcceptedSourceDigest.makeEffect(\n            \"0\".repeat(64)\n          ),\n        });\n        const wire = yield* Schema.encodeEffect(codec)(second);\n        assert.deepEqual(\n          yield* Schema.decodeEffect(codec, { onExcessProperty: \"error\" })(\n            wire\n          ),\n          second\n        );\n        yield* Effect.forEach(\n          [\n            wire.replace('\"schemaVersion\":2', '\"schemaVersion\":3'),\n            wire.replace(\n              `\"sourceSha256\":\"${\"0\".repeat(64)}\"`,\n              '\"sourceSha256\":\"bad\"'\n            ),\n            legacy.replace('\"schemaVersion\":1', '\"schemaVersion\":2'),\n            wire.replace('\"state\":\"accepted\"', '\"state\":\"draft\"'),\n          ],\n          (invalid) =>\n            Schema.decodeEffect(codec, { onExcessProperty: \"error\" })(\n              invalid\n            ).pipe(\n              Effect.flip,\n              Effect.tap((error) =>\n                Effect.sync(() => assert.equal(error._tag, \"SchemaError\"))\n              )\n            )\n        );\n      })\n  );\n  it.effect(\"round-trips the one accepted wire version\", () =>\n    Effect.gen(function* () {\n      const catalogue = yield* exampleContentCatalogue;\n      const wire = yield* Schema.encodeEffect(DocsPublicCatalogue)(catalogue);\n      assert.deepEqual(\n        yield* Schema.decodeUnknownEffect(DocsPublicCatalogue)(wire),\n        catalogue\n      );\n    })\n  );\n\n  it.effect(\n    \"rejects drafts, mismatched addresses and unrelated source files\",\n    () =>\n      Effect.gen(function* () {\n        const catalogue = yield* exampleContentCatalogue;\n        yield* Effect.forEach(catalogue.pages, (page) =>\n","exit_code":0,"duration":{"secs":0,"nanos":10083},"formatted_output":"        // Compare the actual built Worker with the owning checked catalogue,\n        // including every body rather than accepting a count or a placeholder.\n        const publicContent = yield* fs\n          .readFileString(\n            path.join(\n              root,\n              \"packages/docs-content/.source/public-catalogue.json\"\n            )\n          )\n          .pipe(\n            Effect.flatMap(\n              Schema.decodeEffect(Schema.fromJsonString(DocsPublicCatalogue))\n            )\n          );\n        expect(publicContent.pages).toHaveLength(61);\n        // Native RPC restores the same catalogue values across separate\n        // actual Worker requests. No authored source or compiler is consulted.\n        const discoveryDocuments = yield* Effect.gen(function* () {\n          const client = yield* DocsRpcClient;\n          expect(yield* client.getNavigation()).toEqual(\n            publicContent.navigation\n          );\n          yield* Effect.forEach(publicContent.pages, (page) =>\n            Effect.gen(function* () {\n              expect(yield* client.getPage(page.path)).toEqual(page);\n              expect(yield* client.getMarkdown(page.path)).toBe(page.markdown);\n            })\n          );\n          const term = yield* Schema.decodeEffect(DocsSearchTerm)(\"Quickstart\");\n          const results = yield* client.searchPages(term);\n          expect(results.length).toBeGreaterThan(0);\n          expect(results.length).toBeLessThanOrEqual(20);\n          expect(\n            Array.every(results, (result) => result.excerpt.length <= 240)\n          ).toBe(true);\n          return yield* Effect.forEach(\n            DocsDiscoveryPath.literals,\n            client.getDiscovery\n          );\n        }).pipe(\n          Effect.provide(\n            DocsRpcClientLive(catalogueOrigin).pipe(\n              Layer.provide(FetchHttpClient.layer)\n            )\n          )\n        );\n        const unavailableDiscoveryWorker = yield* Effect.promise(() =>\n          website.getWorker(\"taxkit-website-unavailable\")\n        );\n        yield* Effect.forEach(discoveryDocuments, (document) =>\n          Effect.gen(function* () {\n            const served = yield* Effect.promise(() =>\n              website.dispatchFetch(`${websiteOrigin}${document.path}`)\n            );\n            expect(served.status).toBe(200);\n            expect(served.headers.get(\"content-type\")).toBe(\n              `${document.contentType}; charset=utf-8`\n            );\n            expect(served.headers.get(\"cache-control\")).toBe(\n              \"public, max-age=300\"\n            );\n            expect(served.headers.get(\"x-content-type-options\")).toBe(\n              \"nosniff\"\n            );\n            expect(yield* Effect.promise(() => served.text())).toBe(\n              document.body\n            );\n            const head = yield* Effect.promise(() =>\n              website.dispatchFetch(`${websiteOrigin}${document.path}`, {\n                method: \"HEAD\",\n              })\n            );\n            expect(head.status).toBe(200);\n            expect(head.headers.get(\"content-type\")).toBe(\n              served.headers.get(\"content-type\")\n            );\n            expect(yield* Effect.promise(() => head.text())).toBe(\"\");\n            const wrongMethod = yield* Effect.promise(() =>\n              website.dispatchFetch(`${websiteOrigin}${document.path}`, {\n                body: \"PRIVATE9\",\n                method: \"POST\",\n              })\n            );\n            expect(wrongMethod.status).toBe(405);\n            expect(wrongMethod.headers.get(\"allow\")).toBe(\"GET, HEAD\");\n            expect(yield* Effect.promise(() => wrongMethod.text())).toBe(\"\");\n            const query = yield* Effect.promise(() =>\n              website.dispatchFetch(\n                `${websiteOrigin}${document.path}?PRIVATE9=1`\n              )\n            );\n            expect(query.status).toBe(400);\n            expect(yield* Effect.promise(() => query.text())).toBe(\"\");\n            const unavailable = yield* Effect.promise(() =>\n              unavailableDiscoveryWorker.fetch(\n                `${websiteOrigin}${document.path}`\n              )\n            );\n            expect(unavailable.status).toBe(503);\n            expect(unavailable.headers.get(\"cache-control\")).toBe(\"no-store\");\n            expect(yield* Effect.promise(() => unavailable.text())).toBe(\"\");\n          })\n        );\n        const discoverySitemap = yield* Array.findFirst(\n          discoveryDocuments,\n          (document) => document.path === \"/sitemap.xml\"\n        ).pipe(Effect.fromOption);\n        const discoveryIndex = yield* Array.findFirst(\n          discoveryDocuments,\n          (document) => document.path === \"/llms.txt\"\n        ).pipe(Effect.fromOption);\n        const discoveryFull = yield* Array.findFirst(\n          discoveryDocuments,\n          (document) => document.path === \"/llms-full.txt\"\n        ).pipe(Effect.fromOption);\n        expect(discoverySitemap.body).not.toContain(\"lastmod\");\n        expect(discoverySitemap.body).not.toContain(\"/search\");\n        expect(discoveryIndex.body).not.toContain(\".mdx\");\n        // Exact processed-body comparison preserves useful fenced import/code\n        // examples. It must not reject every line beginning with \"import\".\n        yield* Effect.forEach(publicContent.pages, (page) =>\n          Effect.sync(() => {\n            expect(discoverySitemap.body).toContain(\n              `<loc>${websiteOrigin}${page.path}</loc>`\n            );\n            expect(discoveryIndex.body).toContain(\n              `(${apiOrigin}/api/v1/docs/markdown?${new URLSearchParams({ path: page.path }).toString()})`\n            );\n            expect(discoveryFull.body).toContain(\n              `Canonical page: ${websiteOrigin}${page.path}\\n\\n${page.markdown}`\n            );\n          })\n        );\n        const docsNavigation = yield* Effect.promise(() =>\n          publicApi.dispatchFetch(`${apiOrigin}/api/v1/docs/navigation`)\n        );\n        expect(docsNavigation.status).toBe(200);\n        expect(\n          yield* Schema.decodeEffect(\n            Schema.fromJsonString(DocsPublicNavigation)\n          )(yield* Effect.promise(() => docsNavigation.text()))\n        ).toEqual(publicContent.navigation);\n        yield* Effect.forEach(publicContent.pages, (expectedPage) =>\n          Effect.gen(function* () {\n            const query = new URLSearchParams({ path: expectedPage.path });\n            },\n          ],\n          (invalidDocsRequest) =>\n            Effect.gen(function* () {\n              const response = yield* Effect.promise(() =>\n                website.dispatchFetch(\n                  `${nativeDocsAddress}${invalidDocsRequest.suffix}`,\n                  {\n                    headers: invalidDocsRequest.headers,\n                  }\n                )\n              );\n              expect(response.status).toBe(400);\n              expect(yield* Effect.promise(() => response.text())).toBe(\"\");\n            })\n        );\n        const docsPage = yield* Effect.promise(() => context.newPage());\n        const parsedSitemap = yield* Effect.promise(() =>\n          docsPage.evaluate((xml) => {\n            const document = new DOMParser().parseFromString(\n              xml,\n              \"application/xml\"\n            );\n            return {\n              hasParserError: document.querySelector(\"parsererror\") !== null,\n              locationCount: document.querySelectorAll(\"loc\").length,\n              locationText: document.documentElement.textContent ?? \"\",\n              namespace: document.documentElement.namespaceURI,\n            };\n          }, discoverySitemap.body)\n        );\n        expect(parsedSitemap.hasParserError).toBe(false);\n        expect(parsedSitemap.namespace).toBe(\n          \"http://www.sitemaps.org/schemas/sitemap/0.9\"\n        );\n        expect(parsedSitemap.locationCount).toBe(61);\n        expect(parsedSitemap.locationText.trim().split(/\\s+/u)).toEqual(\n          Array.map(\n            publicContent.pages,\n            (item) => `${websiteOrigin}${item.path}`\n          )\n        );\n        docsPage.on(\"pageerror\", (error) =>\n          Queue.offerUnsafe(exceptions, error.message)\n        );\n        const docsCalls = yield* Queue.make<string>();\n        const docsDocuments = yield* Queue.make<string>();\n        docsPage.on(\"request\", (request) => {\n          if (new URL(request.url()).pathname.startsWith(\"/_serverFn/\")) {\n            Queue.offerUnsafe(docsCalls, request.url());\n          }\n          if (\n            request.isNavigationRequest() &&\n            request.frame() === docsPage.mainFrame()\n          ) {\n            Queue.offerUnsafe(docsDocuments, request.url());\nimport { assert, describe, it } from \"@effect/vitest\";\nimport { Array, Effect, Layer, Ref, Schema } from \"effect\";\n\nimport {\n  exampleContentCatalogue,\n  exampleDiscoverySettings,\n} from \"../src/__testing__/fixtures.js\";\nimport { DocsSourceError } from \"../src/errors.js\";\nimport { ContentDiscoveryLive, ContentServiceLive } from \"../src/live.layer.js\";\nimport {\n  DocsDiscoveryPath,\n  DocsDiscoverySettings,\n  DocsPagePath,\n  DocsPublicCatalogue,\n  DocsSearchTerm,\n} from \"../src/schemas.js\";\nimport {\n  ContentCatalogue,\n  ContentDiscovery,\n  ContentService,\n} from \"../src/service.js\";\nimport {\n  makeContentDiscoveryTest,\n  makeContentTest,\n} from \"../src/test.layer.js\";\n\ndescribe(\"accepted content service\", () => {\n  it.effect(\n    \"derives discovery from accepted pages and checked stage addresses\",\n    () =>\n      Effect.gen(function* () {\n        const catalogue = yield* exampleContentCatalogue;\n        const settings = yield* exampleDiscoverySettings;\n        const setup = yield* makeContentDiscoveryTest(catalogue, settings);\n        yield* Effect.gen(function* () {\n          const discovery = yield* ContentDiscovery;\n          const sitemap = yield* discovery.getDocument(\"/sitemap.xml\");\n          assert.equal(sitemap.contentType, \"application/xml\");\n          assert.include(\n            sitemap.body,\n            \"<loc>https://website.example.com/start/overview</loc>\"\n          );\n          assert.notInclude(sitemap.body, \"lastmod\");\n          assert.notInclude(sitemap.body, \"/search\");\n          const robots = yield* discovery.getDocument(\"/robots.txt\");\n          assert.include(\n            robots.body,\n            \"Sitemap: https://website.example.com/sitemap.xml\"\n          );\n          assert.notInclude(robots.body, \"Disallow: /search\");\n          const index = yield* discovery.getDocument(\"/llms.txt\");\n          assert.include(\n            index.body,\n            \"[Start here](https://api.example.com/api/v1/docs/markdown?path=%2Fstart%2Foverview)\"\n          );\n          assert.notInclude(index.body, \"content/start/overview.mdx\");\n          const full = yield* discovery.getDocument(\"/llms-full.txt\");\n          assert.include(\n            full.body,\n            \"Canonical page: https://website.example.com/start/overview\"\n          );\n          yield* Effect.forEach(catalogue.pages, (page) =>\n            Effect.sync(() => assert.include(full.body, page.markdown))\n          );\n        }).pipe(Effect.provide(setup.layer));\n        assert.deepEqual(\n          yield* Ref.get(setup.observations.requestedDocuments),\n          DocsDiscoveryPath.literals\n        );\n      })\n  );\n\n  it.effect(\n    \"keeps deferred settings lazy and reads one configured address set\",\n    () =>\n      Effect.gen(function* () {\n        const observed = yield* Ref.make(0);\n        const settings = yield* exampleDiscoverySettings;\n        const layer = ContentDiscoveryLive(\n          Ref.update(observed, (count) => count + 1).pipe(Effect.as(settings))\n        ).pipe(\n          Layer.provide(Layer.effect(ContentCatalogue, exampleContentCatalogue))\n        );\n        yield* Effect.gen(function* () {\n          const discovery = yield* ContentDiscovery;\n          assert.equal(yield* Ref.get(observed), 0);\n          yield* Effect.forEach(\n            DocsDiscoveryPath.literals,\n            discovery.getDocument\n          );\n          assert.equal(yield* Ref.get(observed), 1);\n        }).pipe(Effect.provide(layer));\n      })\n  );\n\n  it.effect(\n    \"keeps unavailable stage settings in the named failure channel\",\n    () =>\n      Effect.gen(function* () {\n        const expected = new DocsSourceError({\n          message: \"Settings unavailable.\",\n          operation: \"getDiscoveryDocument\",\n        });\n        const result = yield* ContentDiscovery.pipe(\n          Effect.flatMap((service) => service.getDocument(\"/sitemap.xml\")),\n          Effect.flip,\n          Effect.provide(\n            ContentDiscoveryLive(Effect.fail(expected)).pipe(\n              Layer.provide(\n                Layer.effect(ContentCatalogue, exampleContentCatalogue)\n              )\n            )\n          )\n        );\n        assert.deepEqual(result, expected);\n      })\n  );\n\n  it.effect(\n    \"escapes Markdown labels and preserves processed bodies under a different stage\",\n    () =>\n      Effect.gen(function* () {\n        const original = yield* exampleContentCatalogue;\n        const catalogue = yield* DocsPublicCatalogue.makeEffect({\n          ...original,\n          navigation: {\n            primaryNavigation: Array.map(\n              original.navigation.primaryNavigation,\n              (page) => ({ ...page, title: \"[Start] \\\\ guide\" })\n            ),\n          },\n          pages: Array.map(original.pages, (page) => ({\n            ...page,\n            frontmatter: {\n              ...page.frontmatter,\n              description: \"First line.\\nSecond line.\",\n              title: \"[Start] \\\\ guide\",\n            },\n          })),\n        });\n        const settings = yield* Schema.decodeEffect(DocsDiscoverySettings)({\n          apiOrigin: \"http://127.0.0.1:4001\",\n          websiteOrigin: \"http://127.0.0.1:4000\",\n        });\n        const setup = yield* makeContentDiscoveryTest(catalogue, settings);\n        const index = yield* ContentDiscovery.pipe(\n          Effect.flatMap((service) => service.getDocument(\"/llms.txt\")),\n          Effect.provide(setup.layer)\n        );\n        assert.include(\n          index.body,\n          \"[\\\\[Start\\\\] \\\\\\\\ guide](http://127.0.0.1:4001/api/v1/docs/markdown?path=%2Fstart%2Foverview): First line. Second line.\"\n        );\n        assert.notInclude(index.body, \"example.com\");\n      })\n  );\n  it.effect(\n    \"returns the injected pages and navigation; missing pages remain a typed failure\",\n    () =>\n      Effect.gen(function* () {\n        const catalogue = yield* exampleContentCatalogue;\n        const setup = yield* makeContentTest(catalogue);\n        const path = yield* DocsPagePath.makeEffect(\"/start/overview\");\n        const missingPath = yield* DocsPagePath.makeEffect(\"/missing\");\n        yield* Effect.gen(function* () {\n          const content = yield* ContentService;\n          assert.deepEqual(yield* content.listPages(), catalogue.pages);\n          assert.deepEqual(\n            yield* content.getNavigation(),\n            catalogue.navigation\n          );\n          assert.strictEqual(\n            (yield* content.getPage(path)).frontmatter.title,\n            \"Start here\"\n          );\nimport { assert, describe, it } from \"@effect/vitest\";\nimport { Array, Effect, Result, Schema } from \"effect\";\n\nimport { exampleContentCatalogue } from \"../src/__testing__/fixtures.js\";\nimport {\n  DocsDiscoveryDocument,\n  DocsDiscoverySettings,\n  DocsAcceptedSourceDigest,\n  DocsPublicCatalogue,\n  DocsPublicPage,\n  DocsSearchTerm,\n  PublicPageAcceptanceRecord,\n  PublicPageAcceptanceRecordV2,\n} from \"../src/schemas.js\";\n\ndescribe(\"public catalogue ingress\", () => {\n  it.effect(\n    \"rejects mismatched discovery media types and oversized bodies\",\n    () =>\n      Effect.gen(function* () {\n        yield* Effect.forEach(\n          [\n            {\n              body: \"<urlset/>\",\n              contentType: \"text/plain\",\n              path: \"/sitemap.xml\",\n            },\n            {\n              body: \"# TaxKit\",\n              contentType: \"application/xml\",\n              path: \"/llms.txt\",\n            },\n            { body: \"private\", contentType: \"text/plain\", path: \"/private\" },\n            {\n              body: \"x\".repeat(300_001),\n              contentType: \"text/plain\",\n              path: \"/llms-full.txt\",\n            },\n          ],\n          (value) =>\n            Schema.decodeUnknownEffect(DocsDiscoveryDocument)(value).pipe(\n              Effect.flip,\n              Effect.tap((error) =>\n                Effect.sync(() => assert.equal(error._tag, \"SchemaError\"))\n              )\n            )\n        );\n      })\n  );\n  it.effect(\n    \"admits HTTPS and exact local origins while rejecting address decorations\",\n    () =>\n      Effect.gen(function* () {\n        yield* Effect.forEach(\n          [\n            \"https://website.example.com\",\n            \"http://localhost:4000\",\n            \"http://127.0.0.1:4000\",\n          ],\n          (websiteOrigin) =>\n            Schema.decodeEffect(DocsDiscoverySettings)({\n              apiOrigin: \"https://api.example.com\",\n              websiteOrigin,\n            })\n        );\n        yield* Effect.forEach(\n          [\n            \"http://website.example.com\",\n            \"https://website.example.com/path\",\n            \"https://website.example.com?private=1\",\n            \"REDACTED\",\n            \"https://website.example.com/#private\",\n          ],\n          (websiteOrigin) =>\n            Schema.decodeEffect(DocsDiscoverySettings)({\n              apiOrigin: \"https://api.example.com\",\n              websiteOrigin,\n            }).pipe(Effect.flip)\n        );\n      })\n  );\n  it.effect(\n    \"retains legacy acceptance records and requires a hash in version two\",\n    () =>\n      Effect.gen(function* () {\n        const legacy =\n          '{\"observedAt\":\"2026-07-21T22:30:00Z\",\"owner\":\"product-owner\",\"schemaVersion\":1,\"state\":\"accepted\",\"targetPath\":\"packages/docs-content/content/guide.mdx\"}';\n        const codec = Schema.fromJsonString(PublicPageAcceptanceRecord);\n        const record = yield* Schema.decodeEffect(codec, {\n          onExcessProperty: \"error\",\n        })(legacy);\n        assert.equal(yield* Schema.encodeEffect(codec)(record), legacy);\n        const second = yield* PublicPageAcceptanceRecordV2.makeEffect({\n          ...record,\n          schemaVersion: 2,\n          sourceSha256: yield* DocsAcceptedSourceDigest.makeEffect(\n            \"0\".repeat(64)\n          ),\n        });\n        const wire = yield* Schema.encodeEffect(codec)(second);\n        assert.deepEqual(\n          yield* Schema.decodeEffect(codec, { onExcessProperty: \"error\" })(\n            wire\n          ),\n          second\n        );\n        yield* Effect.forEach(\n          [\n            wire.replace('\"schemaVersion\":2', '\"schemaVersion\":3'),\n            wire.replace(\n              `\"sourceSha256\":\"${\"0\".repeat(64)}\"`,\n              '\"sourceSha256\":\"bad\"'\n            ),\n            legacy.replace('\"schemaVersion\":1', '\"schemaVersion\":2'),\n            wire.replace('\"state\":\"accepted\"', '\"state\":\"draft\"'),\n          ],\n          (invalid) =>\n            Schema.decodeEffect(codec, { onExcessProperty: \"error\" })(\n              invalid\n            ).pipe(\n              Effect.flip,\n              Effect.tap((error) =>\n                Effect.sync(() => assert.equal(error._tag, \"SchemaError\"))\n              )\n            )\n        );\n      })\n  );\n  it.effect(\"round-trips the one accepted wire version\", () =>\n    Effect.gen(function* () {\n      const catalogue = yield* exampleContentCatalogue;\n      const wire = yield* Schema.encodeEffect(DocsPublicCatalogue)(catalogue);\n      assert.deepEqual(\n        yield* Schema.decodeUnknownEffect(DocsPublicCatalogue)(wire),\n        catalogue\n      );\n    })\n  );\n\n  it.effect(\n    \"rejects drafts, mismatched addresses and unrelated source files\",\n    () =>\n      Effect.gen(function* () {\n        const catalogue = yield* exampleContentCatalogue;\n        yield* Effect.forEach(catalogue.pages, (page) =>\n"},"started_at_ms":1791312089023,"completed_at_ms":1791312089023}}
{"timestamp":"2026-10-06T18:41:34.095Z","ordinal":50636,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a11285-638f-79f0-b150-a593eaa9728e","call_id":"call_g9vvo0kAx5ROy2NGiBbc5UXL","output":[{"type":"input_text","text":"Script completed\nWall time 5.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"fcd25e\",\"wall_time_seconds\":0.000010083,\"exit_code\":0,\"original_token_count\":4988,\"output\":\"        // Compare the actual built Worker with the owning checked catalogue,\\n        // including every body rather than accepting a count or a placeholder.\\n        const publicContent = yield* fs\\n          .readFileString(\\n            path.join(\\n              root,\\n              \\\"packages/docs-content/.source/public-catalogue.json\\\"\\n            )\\n          )\\n          .pipe(\\n            Effect.flatMap(\\n              Schema.decodeEffect(Schema.fromJsonString(DocsPublicCatalogue))\\n            )\\n          );\\n        expect(publicContent.pages).toHaveLength(61);\\n        // Native RPC restores the same catalogue values across separate\\n        // actual Worker requests. No authored source or compiler is consulted.\\n        const discoveryDocuments = yield* Effect.gen(function* () {\\n          const client = yield* DocsRpcClient;\\n          expect(yield* client.getNavigation()).toEqual(\\n            publicContent.navigation\\n          );\\n          yield* Effect.forEach(publicContent.pages, (page) =>\\n            Effect.gen(function* () {\\n              expect(yield* client.getPage(page.path)).toEqual(page);\\n              expect(yield* client.getMarkdown(page.path)).toBe(page.markdown);\\n            })\\n          );\\n          const term = yield* Schema.decodeEffect(DocsSearchTerm)(\\\"Quickstart\\\");\\n          const results = yield* client.searchPages(term);\\n          expect(results.length).toBeGreaterThan(0);\\n          expect(results.length).toBeLessThanOrEqual(20);\\n          expect(\\n            Array.every(results, (result) => result.excerpt.length <= 240)\\n          ).toBe(true);\\n          return yield* Effect.forEach(\\n            DocsDiscoveryPath.literals,\\n            client.getDiscovery\\n          );\\n        }).pipe(\\n          Effect.provide(\\n            DocsRpcClientLive(catalogueOrigin).pipe(\\n              Layer.provide(FetchHttpClient.layer)\\n            )\\n          )\\n        );\\n        const unavailableDiscoveryWorker = yield* Effect.promise(() =>\\n          website.getWorker(\\\"taxkit-website-unavailable\\\")\\n        );\\n        yield* Effect.forEach(discoveryDocuments, (document) =>\\n          Effect.gen(function* () {\\n            const served = yield* Effect.promise(() =>\\n              website.dispatchFetch(`${websiteOrigin}${document.path}`)\\n            );\\n            expect(served.status).toBe(200);\\n            expect(served.headers.get(\\\"content-type\\\")).toBe(\\n              `${document.contentType}; charset=utf-8`\\n            );\\n            expect(served.headers.get(\\\"cache-control\\\")).toBe(\\n              \\\"public, max-age=300\\\"\\n            );\\n            expect(served.headers.get(\\\"x-content-type-options\\\")).toBe(\\n              \\\"nosniff\\\"\\n            );\\n            expect(yield* Effect.promise(() => served.text())).toBe(\\n              document.body\\n            );\\n            const head = yield* Effect.promise(() =>\\n              website.dispatchFetch(`${websiteOrigin}${document.path}`, {\\n                method: \\\"HEAD\\\",\\n              })\\n            );\\n            expect(head.status).toBe(200);\\n            expect(head.headers.get(\\\"content-type\\\")).toBe(\\n              served.headers.get(\\\"content-type\\\")\\n            );\\n            expect(yield* Effect.promise(() => head.text())).toBe(\\\"\\\");\\n            const wrongMethod = yield* Effect.promise(() =>\\n              website.dispatchFetch(`${websiteOrigin}${document.path}`, {\\n                body: \\\"PRIVATE9\\\",\\n                method: \\\"POST\\\",\\n              })\\n            );\\n            expect(wrongMethod.status).toBe(405);\\n            expect(wrongMethod.headers.get(\\\"allow\\\")).toBe(\\\"GET, HEAD\\\");\\n            expect(yield* Effect.promise(() => wrongMethod.text())).toBe(\\\"\\\");\\n            const query = yield* Effect.promise(() =>\\n              website.dispatchFetch(\\n                `${websiteOrigin}${document.path}?PRIVATE9=1`\\n              )\\n            );\\n            expect(query.status).toBe(400);\\n            expect(yield* Effect.promise(() => query.text())).toBe(\\\"\\\");\\n            const unavailable = yield* Effect.promise(() =>\\n              unavailableDiscoveryWorker.fetch(\\n                `${websiteOrigin}${document.path}`\\n              )\\n            );\\n            expect(unavailable.status).toBe(503);\\n            expect(unavailable.headers.get(\\\"cache-control\\\")).toBe(\\\"no-store\\\");\\n            expect(yield* Effect.promise(() => unavailable.text())).toBe(\\\"\\\");\\n          })\\n        );\\n        const discoverySitemap = yield* Array.findFirst(\\n          discoveryDocuments,\\n          (document) => document.path === \\\"/sitemap.xml\\\"\\n        ).pipe(Effect.fromOption);\\n        const discoveryIndex = yield* Array.findFirst(\\n          discoveryDocuments,\\n          (document) => document.path === \\\"/llms.txt\\\"\\n        ).pipe(Effect.fromOption);\\n        const discoveryFull = yield* Array.findFirst(\\n          discoveryDocuments,\\n          (document) => document.path === \\\"/llms-full.txt\\\"\\n        ).pipe(Effect.fromOption);\\n        expect(discoverySitemap.body).not.toContain(\\\"lastmod\\\");\\n        expect(discoverySitemap.body).not.toContain(\\\"/search\\\");\\n        expect(discoveryIndex.body).not.toContain(\\\".mdx\\\");\\n        // Exact processed-body comparison preserves useful fenced import/code\\n        // examples. It must not reject every line beginning with \\\"import\\\".\\n        yield* Effect.forEach(publicContent.pages, (page) =>\\n          Effect.sync(() => {\\n            expect(discoverySitemap.body).toContain(\\n              `<loc>${websiteOrigin}${page.path}</loc>`\\n            );\\n            expect(discoveryIndex.body).toContain(\\n              `(${apiOrigin}/api/v1/docs/markdown?${new URLSearchParams({ path: page.path }).toString()})`\\n            );\\n            expect(discoveryFull.body).toContain(\\n              `Canonical page: ${websiteOrigin}${page.path}\\\\n\\\\n${page.markdown}`\\n            );\\n          })\\n        );\\n        const docsNavigation = yield* Effect.promise(() =>\\n          publicApi.dispatchFetch(`${apiOrigin}/api/v1/docs/navigation`)\\n        );\\n        expect(docsNavigation.status).toBe(200);\\n        expect(\\n          yield* Schema.decodeEffect(\\n            Schema.fromJsonString(DocsPublicNavigation)\\n          )(yield* Effect.promise(() => docsNavigation.text()))\\n        ).toEqual(publicContent.navigation);\\n        yield* Effect.forEach(publicContent.pages, (expectedPage) =>\\n          Effect.gen(function* () {\\n            const query = new URLSearchParams({ path: expectedPage.path });\\n            },\\n          ],\\n          (invalidDocsRequest) =>\\n            Effect.gen(function* () {\\n              const response = yield* Effect.promise(() =>\\n                website.dispatchFetch(\\n                  `${nativeDocsAddress}${invalidDocsRequest.suffix}`,\\n                  {\\n                    headers: invalidDocsRequest.headers,\\n                  }\\n                )\\n              );\\n              expect(response.status).toBe(400);\\n              expect(yield* Effect.promise(() => response.text())).toBe(\\\"\\\");\\n            })\\n        );\\n        const docsPage = yield* Effect.promise(() => context.newPage());\\n        const parsedSitemap = yield* Effect.promise(() =>\\n          docsPage.evaluate((xml) => {\\n            const document = new DOMParser().parseFromString(\\n              xml,\\n              \\\"application/xml\\\"\\n            );\\n            return {\\n              hasParserError: document.querySelector(\\\"parsererror\\\") !== null,\\n              locationCount: document.querySelectorAll(\\\"loc\\\").length,\\n              locationText: document.documentElement.textContent ?? \\\"\\\",\\n              namespace: document.documentElement.namespaceURI,\\n            };\\n          }, discoverySitemap.body)\\n        );\\n        expect(parsedSitemap.hasParserError).toBe(false);\\n        expect(parsedSitemap.namespace).toBe(\\n          \\\"http://www.sitemaps.org/schemas/sitemap/0.9\\\"\\n        );\\n        expect(parsedSitemap.locationCount).toBe(61);\\n        expect(parsedSitemap.locationText.trim().split(/\\\\s+/u)).toEqual(\\n          Array.map(\\n            publicContent.pages,\\n            (item) => `${websiteOrigin}${item.path}`\\n          )\\n        );\\n        docsPage.on(\\\"pageerror\\\", (error) =>\\n          Queue.offerUnsafe(exceptions, error.message)\\n        );\\n        const docsCalls = yield* Queue.make<string>();\\n        const docsDocuments = yield* Queue.make<string>();\\n        docsPage.on(\\\"request\\\", (request) => {\\n          if (new URL(request.url()).pathname.startsWith(\\\"/_serverFn/\\\")) {\\n            Queue.offerUnsafe(docsCalls, request.url());\\n          }\\n          if (\\n            request.isNavigationRequest() &&\\n            request.frame() === docsPage.mainFrame()\\n          ) {\\n            Queue.offerUnsafe(docsDocuments, request.url());\\nimport { assert, describe, it } from \\\"@effect/vitest\\\";\\nimport { Array, Effect, Layer, Ref, Schema } from \\\"effect\\\";\\n\\nimport {\\n  exampleContentCatalogue,\\n  exampleDiscoverySettings,\\n} from \\\"../src/__testing__/fixtures.js\\\";\\nimport { DocsSourceError } from \\\"../src/errors.js\\\";\\nimport { ContentDiscoveryLive, ContentServiceLive } from \\\"../src/live.layer.js\\\";\\nimport {\\n  DocsDiscoveryPath,\\n  DocsDiscoverySettings,\\n  DocsPagePath,\\n  DocsPublicCatalogue,\\n  DocsSearchTerm,\\n} from \\\"../src/schemas.js\\\";\\nimport {\\n  ContentCatalogue,\\n  ContentDiscovery,\\n  ContentService,\\n} from \\\"../src/service.js\\\";\\nimport {\\n  makeContentDiscoveryTest,\\n  makeContentTest,\\n} from \\\"../src/test.layer.js\\\";\\n\\ndescribe(\\\"accepted content service\\\", () => {\\n  it.effect(\\n    \\\"derives discovery from accepted pages and checked stage addresses\\\",\\n    () =>\\n      Effect.gen(function* () {\\n        const catalogue = yield* exampleContentCatalogue;\\n        const settings = yield* exampleDiscoverySettings;\\n        const setup = yield* makeContentDiscoveryTest(catalogue, settings);\\n        yield* Effect.gen(function* () {\\n          const discovery = yield* ContentDiscovery;\\n          const sitemap = yield* discovery.getDocument(\\\"/sitemap.xml\\\");\\n          assert.equal(sitemap.contentType, \\\"application/xml\\\");\\n          assert.include(\\n            sitemap.body,\\n            \\\"<loc>https://website.example.com/start/overview</loc>\\\"\\n          );\\n          assert.notInclude(sitemap.body, \\\"lastmod\\\");\\n          assert.notInclude(sitemap.body, \\\"/search\\\");\\n          const robots = yield* discovery.getDocument(\\\"/robots.txt\\\");\\n          assert.include(\\n            robots.body,\\n            \\\"Sitemap: https://website.example.com/sitemap.xml\\\"\\n          );\\n          assert.notInclude(robots.body, \\\"Disallow: /search\\\");\\n          const index = yield* discovery.getDocument(\\\"/llms.txt\\\");\\n          assert.include(\\n            index.body,\\n            \\\"[Start here](https://api.example.com/api/v1/docs/markdown?path=%2Fstart%2Foverview)\\\"\\n          );\\n          assert.notInclude(index.body, \\\"content/start/overview.mdx\\\");\\n          const full = yield* discovery.getDocument(\\\"/llms-full.txt\\\");\\n          assert.include(\\n            full.body,\\n            \\\"Canonical page: https://website.example.com/start/overview\\\"\\n          );\\n          yield* Effect.forEach(catalogue.pages, (page) =>\\n            Effect.sync(() => assert.include(full.body, page.markdown))\\n          );\\n        }).pipe(Effect.provide(setup.layer));\\n        assert.deepEqual(\\n          yield* Ref.get(setup.observations.requestedDocuments),\\n          DocsDiscoveryPath.literals\\n        );\\n      })\\n  );\\n\\n  it.effect(\\n    \\\"keeps deferred settings lazy and reads one configured address set\\\",\\n    () =>\\n      Effect.gen(function* () {\\n        const observed = yield* Ref.make(0);\\n        const settings = yield* exampleDiscoverySettings;\\n        const layer = ContentDiscoveryLive(\\n          Ref.update(observed, (count) => count + 1).pipe(Effect.as(settings))\\n        ).pipe(\\n          Layer.provide(Layer.effect(ContentCatalogue, exampleContentCatalogue))\\n        );\\n        yield* Effect.gen(function* () {\\n          const discovery = yield* ContentDiscovery;\\n          assert.equal(yield* Ref.get(observed), 0);\\n          yield* Effect.forEach(\\n            DocsDiscoveryPath.literals,\\n            discovery.getDocument\\n          );\\n          assert.equal(yield* Ref.get(observed), 1);\\n        }).pipe(Effect.provide(layer));\\n      })\\n  );\\n\\n  it.effect(\\n    \\\"keeps unavailable stage settings in the named failure channel\\\",\\n    () =>\\n      Effect.gen(function* () {\\n        const expected = new DocsSourceError({\\n          message: \\\"Settings unavailable.\\\",\\n          operation: \\\"getDiscoveryDocument\\\",\\n        });\\n        const result = yield* ContentDiscovery.pipe(\\n          Effect.flatMap((service) => service.getDocument(\\\"/sitemap.xml\\\")),\\n          Effect.flip,\\n          Effect.provide(\\n            ContentDiscoveryLive(Effect.fail(expected)).pipe(\\n              Layer.provide(\\n                Layer.effect(ContentCatalogue, exampleContentCatalogue)\\n              )\\n            )\\n          )\\n        );\\n        assert.deepEqual(result, expected);\\n      })\\n  );\\n\\n  it.effect(\\n    \\\"escapes Markdown labels and preserves processed bodies under a different stage\\\",\\n    () =>\\n      Effect.gen(function* () {\\n        const original = yield* exampleContentCatalogue;\\n        const catalogue = yield* DocsPublicCatalogue.makeEffect({\\n          ...original,\\n          navigation: {\\n            primaryNavigation: Array.map(\\n              original.navigation.primaryNavigation,\\n              (page) => ({ ...page, title: \\\"[Start] \\\\\\\\ guide\\\" })\\n            ),\\n          },\\n          pages: Array.map(original.pages, (page) => ({\\n            ...page,\\n            frontmatter: {\\n              ...page.frontmatter,\\n              description: \\\"First line.\\\\nSecond line.\\\",\\n              title: \\\"[Start] \\\\\\\\ guide\\\",\\n            },\\n          })),\\n        });\\n        const settings = yield* Schema.decodeEffect(DocsDiscoverySettings)({\\n          apiOrigin: \\\"http://127.0.0.1:4001\\\",\\n          websiteOrigin: \\\"http://127.0.0.1:4000\\\",\\n        });\\n        const setup = yield* makeContentDiscoveryTest(catalogue, settings);\\n        const index = yield* ContentDiscovery.pipe(\\n          Effect.flatMap((service) => service.getDocument(\\\"/llms.txt\\\")),\\n          Effect.provide(setup.layer)\\n        );\\n        assert.include(\\n          index.body,\\n          \\\"[\\\\\\\\[Start\\\\\\\\] \\\\\\\\\\\\\\\\ guide](http://127.0.0.1:4001/api/v1/docs/markdown?path=%2Fstart%2Foverview): First line. Second line.\\\"\\n        );\\n        assert.notInclude(index.body, \\\"example.com\\\");\\n      })\\n  );\\n  it.effect(\\n    \\\"returns the injected pages and navigation; missing pages remain a typed failure\\\",\\n    () =>\\n      Effect.gen(function* () {\\n        const catalogue = yield* exampleContentCatalogue;\\n        const setup = yield* makeContentTest(catalogue);\\n        const path = yield* DocsPagePath.makeEffect(\\\"/start/overview\\\");\\n        const missingPath = yield* DocsPagePath.makeEffect(\\\"/missing\\\");\\n        yield* Effect.gen(function* () {\\n          const content = yield* ContentService;\\n          assert.deepEqual(yield* content.listPages(), catalogue.pages);\\n          assert.deepEqual(\\n            yield* content.getNavigation(),\\n            catalogue.navigation\\n          );\\n          assert.strictEqual(\\n            (yield* content.getPage(path)).frontmatter.title,\\n            \\\"Start here\\\"\\n          );\\nimport { assert, describe, it } from \\\"@effect/vitest\\\";\\nimport { Array, Effect, Result, Schema } from \\\"effect\\\";\\n\\nimport { exampleContentCatalogue } from \\\"../src/__testing__/fixtures.js\\\";\\nimport {\\n  DocsDiscoveryDocument,\\n  DocsDiscoverySettings,\\n  DocsAcceptedSourceDigest,\\n  DocsPublicCatalogue,\\n  DocsPublicPage,\\n  DocsSearchTerm,\\n  PublicPageAcceptanceRecord,\\n  PublicPageAcceptanceRecordV2,\\n} from \\\"../src/schemas.js\\\";\\n\\ndescribe(\\\"public catalogue ingress\\\", () => {\\n  it.effect(\\n    \\\"rejects mismatched discovery media types and oversized bodies\\\",\\n    () =>\\n      Effect.gen(function* () {\\n        yield* Effect.forEach(\\n          [\\n            {\\n              body: \\\"<urlset/>\\\",\\n              contentType: \\\"text/plain\\\",\\n              path: \\\"/sitemap.xml\\\",\\n            },\\n            {\\n              body: \\\"# TaxKit\\\",\\n              contentType: \\\"application/xml\\\",\\n              path: \\\"/llms.txt\\\",\\n            },\\n            { body: \\\"private\\\", contentType: \\\"text/plain\\\", path: \\\"/private\\\" },\\n            {\\n              body: \\\"x\\\".repeat(300_001),\\n              contentType: \\\"text/plain\\\",\\n              path: \\\"/llms-full.txt\\\",\\n            },\\n          ],\\n          (value) =>\\n            Schema.decodeUnknownEffect(DocsDiscoveryDocument)(value).pipe(\\n              Effect.flip,\\n              Effect.tap((error) =>\\n                Effect.sync(() => assert.equal(error._tag, \\\"SchemaError\\\"))\\n              )\\n            )\\n        );\\n      })\\n  );\\n  it.effect(\\n    \\\"admits HTTPS and exact local origins while rejecting address decorations\\\",\\n    () =>\\n      Effect.gen(function* () {\\n        yield* Effect.forEach(\\n          [\\n            \\\"https://website.example.com\\\",\\n            \\\"http://localhost:4000\\\",\\n            \\\"http://127.0.0.1:4000\\\",\\n          ],\\n          (websiteOrigin) =>\\n            Schema.decodeEffect(DocsDiscoverySettings)({\\n              apiOrigin: \\\"https://api.example.com\\\",\\n              websiteOrigin,\\n            })\\n        );\\n        yield* Effect.forEach(\\n          [\\n            \\\"http://website.example.com\\\",\\n            \\\"https://website.example.com/path\\\",\\n            \\\"https://website.example.com?private=1\\\",\\n            \\\"REDACTED\",\\n            \\\"https://website.example.com/#private\\\",\\n          ],\\n          (websiteOrigin) =>\\n            Schema.decodeEffect(DocsDiscoverySettings)({\\n              apiOrigin: \\\"https://api.example.com\\\",\\n              websiteOrigin,\\n            }).pipe(Effect.flip)\\n        );\\n      })\\n  );\\n  it.effect(\\n    \\\"retains legacy acceptance records and requires a hash in version two\\\",\\n    () =>\\n      Effect.gen(function* () {\\n        const legacy =\\n          '{\\\"observedAt\\\":\\\"2026-07-21T22:30:00Z\\\",\\\"owner\\\":\\\"product-owner\\\",\\\"schemaVersion\\\":1,\\\"state\\\":\\\"accepted\\\",\\\"targetPath\\\":\\\"packages/docs-content/content/guide.mdx\\\"}';\\n        const codec = Schema.fromJsonString(PublicPageAcceptanceRecord);\\n        const record = yield* Schema.decodeEffect(codec, {\\n          onExcessProperty: \\\"error\\\",\\n        })(legacy);\\n        assert.equal(yield* Schema.encodeEffect(codec)(record), legacy);\\n        const second = yield* PublicPageAcceptanceRecordV2.makeEffect({\\n          ...record,\\n          schemaVersion: 2,\\n          sourceSha256: yield* DocsAcceptedSourceDigest.makeEffect(\\n            \\\"0\\\".repeat(64)\\n          ),\\n        });\\n        const wire = yield* Schema.encodeEffect(codec)(second);\\n        assert.deepEqual(\\n          yield* Schema.decodeEffect(codec, { onExcessProperty: \\\"error\\\" })(\\n            wire\\n          ),\\n          second\\n        );\\n        yield* Effect.forEach(\\n          [\\n            wire.replace('\\\"schemaVersion\\\":2', '\\\"schemaVersion\\\":3'),\\n            wire.replace(\\n              `\\\"sourceSha256\\\":\\\"${\\\"0\\\".repeat(64)}\\\"`,\\n              '\\\"sourceSha256\\\":\\\"bad\\\"'\\n            ),\\n            legacy.replace('\\\"schemaVersion\\\":1', '\\\"schemaVersion\\\":2'),\\n            wire.replace('\\\"state\\\":\\\"accepted\\\"', '\\\"state\\\":\\\"draft\\\"'),\\n          ],\\n          (invalid) =>\\n            Schema.decodeEffect(codec, { onExcessProperty: \\\"error\\\" })(\\n              invalid\\n            ).pipe(\\n              Effect.flip,\\n              Effect.tap((error) =>\\n                Effect.sync(() => assert.equal(error._tag, \\\"SchemaError\\\"))\\n              )\\n            )\\n        );\\n      })\\n  );\\n  it.effect(\\\"round-trips the one accepted wire version\\\", () =>\\n    Effect.gen(function* () {\\n      const catalogue = yield* exampleContentCatalogue;\\n      const wire = yield* Schema.encodeEffect(DocsPublicCatalogue)(catalogue);\\n      assert.deepEqual(\\n        yield* Schema.decodeUnknownEffect(DocsPublicCatalogue)(wire),\\n        catalogue\\n      );\\n    })\\n  );\\n\\n  it.effect(\\n    \\\"rejects drafts, mismatched addresses and unrelated source files\\\",\\n    () =>\\n      Effect.gen(function* () {\\n        const catalogue = yield* exampleContentCatalogue;\\n        yield* Effect.forEach(catalogue.pages, (page) =>\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"4b9675\",\"wall_time_seconds\":5.003708708,\"session_id\":72575,\"original_token_count\":0,\"output\":\"\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","create_time":1791312094.09559}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
