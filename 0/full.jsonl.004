culator service errors.`]}),`\nweb test:native-pair: + `]}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`related-pages`,children:`Related pages`}),`\nweb test:native-pair: + `,(0,t.jsxs)(n.ul,{children:[`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/api/overview`,children:`API overview`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/api/endpoints`,children:`Endpoints`})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/api/errors`,children:`Errors`})}),`\nweb test:native-pair: + `]})]})}function s(e={}){let{wrapper:n}=e.components||{};return n?(0,t.jsx)(n,{...e,children:(0,t.jsx)(o,{...e})}):o(e)}export{r as _markdown,s as default,n as frontmatter,i as structuredData,a as toc};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Check API, SDK, schema and release impact before changing public contracts.`,status:`published`,title:`Backward compatibility`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # Backward compatibility [#backward-compatibility]\nweb test:native-pair: +\nweb test:native-pair: + Use this page before you change facts, calculator inputs, report fields,\nweb test:native-pair: + errors, HTTP routes, SDK helpers or exported schema names.\nweb test:native-pair: +\nweb test:native-pair: + ## Public contract surfaces [#public-contract-surfaces]\nweb test:native-pair: +\nweb test:native-pair: + | Surface                  | Compatibility evidence                                            |\nweb test:native-pair: + | ------------------------ | ----------------------------------------------------------------- |\nweb test:native-pair: + | Calculator request facts | schema decode tests, OpenAPI evidence and SDK type tests          |\nweb test:native-pair: + | Calculator reports       | golden tests, API compatibility tests and SDK compatibility tests |\nweb test:native-pair: + | Expected errors          | \\`CalculatorServiceError\\` tests and HTTP status envelope tests     |\nweb test:native-pair: + | HTTP endpoints           | route tests and generated OpenAPI review                          |\nweb test:native-pair: + | SDK helpers              | type tests, packed artifact checks and browser-safe import checks |\nweb test:native-pair: + | Tax-year metadata        | API metadata tests and SDK descriptor tests                       |\nweb test:native-pair: +\nweb test:native-pair: + Breaking changes need an explicit release-impact note and a Changeset when\nweb test:native-pair: + package-facing behaviour changes.\nweb test:native-pair: +\nweb test:native-pair: + ## HTTP and SDK rule [#http-and-sdk-rule]\nweb test:native-pair: +\nweb test:native-pair: + HTTP and SDK layers adapt public callers to the calculator boundary. They must\nweb test:native-pair: + not hide tax business logic or make incompatible tax results look compatible.\nweb test:native-pair: + If tax behaviour changes, update the owning fact, rule, parameter, calculator\nweb test:native-pair: + or service package and then prove the public layer still reflects that owner.\nweb test:native-pair: +\nweb test:native-pair: + ## Review notes [#review-notes]\nweb test:native-pair: +\nweb test:native-pair: + Your PR should state:\nweb test:native-pair: +\nweb test:native-pair: + * whether request or response schemas changed\nweb test:native-pair: + * whether public SDK helper input or output types changed\nweb test:native-pair: + * whether generated OpenAPI output changed\nweb test:native-pair: + * whether existing calculator IDs, jurisdictions or tax years still work\nweb test:native-pair: + * whether the change needs a Changeset\nweb test:native-pair: +\nweb test:native-pair: + Read [API and SDK](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/api-and-sdk.md) before\nweb test:native-pair: + changing transport or SDK contracts.\nweb test:native-pair: + `,i={contents