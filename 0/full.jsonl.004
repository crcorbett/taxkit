rbose\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + Do not run \\`bun run version-repo\\` unless you are intentionally applying the\nweb test:native-pair: + pending release train.\nweb test:native-pair: +\nweb test:native-pair: + ## When a Changeset is not required [#when-a-changeset-is-not-required]\nweb test:native-pair: +\nweb test:native-pair: + Docs-only changes inside \\`packages/docs-content/content\\`, navigation updates and active\nweb test:native-pair: + exec-plan validation notes do not need a Changeset when they do not change\nweb test:native-pair: + package exports, package README behaviour or runtime behaviour.\nweb test:native-pair: +\nweb test:native-pair: + State the no-Changeset rationale in your PR and handoff.\nweb test:native-pair: +\nweb test:native-pair: + ## PR evidence [#pr-evidence]\nweb test:native-pair: +\nweb test:native-pair: + Link the Changeset path or write the no-Changeset rationale in\nweb test:native-pair: + [PR evidence checklist](/contributing/pr-evidence-checklist).\nweb test:native-pair: + `,i={contents:[{heading:`changesets`,content:`Use this page when your contribution changes package-facing behaviour,\nweb test:native-pair: + exports, public schemas, package READMEs or runtime contracts.`},{heading:`when-you-need-a-changeset`,content:`Add or update a Changeset when you change:`},{heading:`when-you-need-a-changeset`,content:`public package exports`},{heading:`when-you-need-a-changeset`,content:`SDK helper behaviour or types`},{heading:`when-you-need-a-changeset`,content:`HTTP API contract behaviour`},{heading:`when-you-need-a-changeset`,content:`calculator request or response schemas`},{heading:`when-you-need-a-changeset`,content:`package README behaviour`},{heading:`when-you-need-a-changeset`,content:`rule package behaviour that affects published calculation output`},{heading:`when-you-need-a-changeset`,content:`Run:`},{heading:`when-you-need-a-changeset`,content:`Then check the pending release state:`},{heading:`when-you-need-a-changeset`,content:\"Do not run `bun run version-repo` unless you are intentionally applying the\\npending release train.\"},{heading:`when-a-changeset-is-not-required`,content:`Docs-only changes inside \\`packages/docs-content/content\\`, navigation updates and active\nweb test:native-pair: + exec-plan validation notes do not need a Changeset when they do not change\nweb test:native-pair: + package exports, package README behaviour or runtime behaviour.`},{heading:`when-a-changeset-is-not-required`,content:`State the no-Changeset rationale in your PR and handoff.`},{heading:`pr-evidence`,content:`Link the Changeset path or write the no-Changeset rationale in\nweb test:native-pair: + PR evidence checklist.`}],headings:[{id:`changesets`,content:`Changesets`},{id:`when-you-need-a-changeset`,content:`When you need a Changeset`},{id:`when-a-changeset-is-not-required`,content:`When a Changeset is not required`},{id:`pr-evidence`,content:`PR evidence`}]},a=[{depth:1,url:`#changesets`,title:(0,t.jsx)(t.Fragment,{children:`Changesets`})},{depth:2,url:`#when-you-need-a-changeset`,title:(0,t.jsx)(t.Fragment,{children:`When you need a Changeset`})},{depth:2,url:`#when-a-changeset-is-not-required`,title:(0,t.jsx)(t.Fragment,{children:`When a Changeset is not required`})},{depth:2,url:`#pr-evidence`,title:(0,t.jsx)(t.Fragment,{children:`PR evidence`})}];function o(e){let n={a:`a`,code:`code`,h1:`h1`,h2:`h2`,li:`li`,p:`p`,pre:`pre`,span:`span`,ul:`ul`,...e.components};return(0,t.jsxs)(t.Fragment,{children:[(0,t.jsx)(n.h1,{id:`changesets`,children:`Changesets`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`Use this page when your contribution changes package-facing behaviour,\nweb test:native-pair: + exports, public schemas, package READMEs or runtime contracts.`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`when-you-need-a-changeset`,children:`When you need a Changeset`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{childr