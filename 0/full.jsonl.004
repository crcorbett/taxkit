| \"\";\n}) => term === \"\" ? <p>Enter a few words to find a documentation page.</p>\n  : results.length === 0 ? <section aria-live=\"polite\"><h2>No matching pages</h2><p>Try fewer words or choose a page from the documentation navigation.</p></section>\n  : <section aria-label=\"Documentation search results\">\n    <h2>{results.length} matching {results.length === 1 ? \"page\" : \"pages\"}</h2>\n    <ol className=\"docs-search-results\">\n      {Array.map(results, (result) => <li key={result.path}>\n        <h3><Link onClick={requestDocsNavigationFocus} params={{ _splat: result.path.slice(1) }} to=\"/$\">{result.title}</Link></h3>\n        <p>{result.description}</p>\n        <p className=\"docs-search-excerpt\">{result.excerpt}</p>\n      </li>)}\n    </ol>\n  </section>;\n''')\nPath('apps/web/src/routes/search.tsx').write_text('''import { createFileRoute } from \"@tanstack/react-router\";\nimport { Match, Result } from \"effect\";\n\nimport { DocsNavigation } from \"#/lib/docs/page.view\";\nimport { docsPageRouteBoundary } from \"#/lib/docs/route-boundary\";\nimport { DocsSearchForm, DocsSearchResults } from \"#/lib/docs/search.view\";\n\nconst SearchUnavailable = () => <section className=\"docs-state\" role=\"alert\">\n  <h1>Search documentation</h1>\n  <p>Documentation search could not load. Please reload this page to try again.</p>\n  <DocsSearchForm term=\"\" />\n  <a href=\"/start/quickstart\">Open the Quickstart</a>\n</section>;\n\nexport const Route = createFileRoute(\"/search\")({\n  component: function DocumentationSearchRoute() {\n    const restored = docsPageRouteBoundary.restoreSearch(Route.useLoaderData());\n    return Result.match(restored, {\n      onFailure: (error) => <section className=\"docs-state\" role=\"alert\">\n        <h1>Search documentation</h1>\n        <p>{Match.value(error).pipe(\n          Match.tag(\"DocsSearchInputError\", () => \"Enter up to 100 characters to search the documentation.\"),\n          Match.orElse(() => \"Documentation search could not load. Please reload this page to try again.\")\n        )}</p>\n        <DocsSearchForm term=\"\" />\n        <a href=\"/start/quickstart\">Open the Quickstart</a>\n      </section>,\n      onSuccess: ({ navigation, results, term }) => <div className=\"docs-layout\">\n        <aside className=\"docs-sidebar\"><DocsNavigation currentPath={undefined} navigation={navigation} /></aside>\n        <article className=\"docs-article\">\n          <h1 tabIndex={-1}>Search documentation</h1>\n          <DocsSearchForm term={term} />\n          <DocsSearchResults results={results} term={term} />\n        </article>\n      </div>,\n    });\n  },\n  errorComponent: SearchUnavailable,\n  head: () => ({ meta: [\n    { title: \"Search documentation | TaxKit\" },\n    { name: \"robots\", content: \"noindex, follow\" },\n    { name: \"description\", content: \"Find a TaxKit guide, API reference or integration example.\" },\n  ] }),\n  // Each original address supplies its own words. Do not reuse a cached result\n  // from a previous query or let the framework's JSON query parser change it.\n  shouldReload: true,\n  loader: ({ location, context, abortController }) => context.loadDocsSearch({\n    query: docsPageRouteBoundary.searchLocation(location.searchStr),\n    signal: abortController.signal,\n  }),\n  pendingComponent: () => <section aria-busy=\"true\" aria-live=\"polite\" className=\"docs-state\"><h1>Searching documentation</h1><p>Matching pages are being loaded.</p></section>,\n  pendingMs: 150,\n});\n''')\nedit('apps/web/src/lib/docs/page.view.tsx','readonly currentPath: DocsPublicPage[\"path\"];','readonly currentPath: DocsPublicPage[\"path\"] | undefined;')\np=Path('apps/web/src/styles.css');s=p.read_text();s+='''\n\n.docs-search-form { margin-block: 1.75rem 2.5rem; }\n.docs-search-form label { display: block; margin-bottom: .5rem; font-weight: 600; }\n.docs-search-controls { display: flex; flex-wrap: wrap; gap: .75rem; }\n.docs-search-controls input, .docs-search-controls button {\n  min-height: 2.75rem; border: 1px solid #94a3b8; border-radius: .375rem;\n  padding: .625rem .75rem; font: inherit; color: inherit; background: #fff;\n}\n.docs-search-controls input { flex: 1 1 15rem; min-width: 0; width: 100%; }\n.docs-search-controls button { background: #172033; color: #fff; cursor: pointer; }\n.docs-search-controls input:focus-visible, .docs-search-controls button:focus-visible {\n  outline: 3px solid #2563eb; outline-offset: .25rem;\n}\n.docs-search-form p { margin-top: .75rem; color: #526071; font-size: .9375rem; }\n.docs-search-results { list-style: none; padding: 0; }\n.docs-search-results li { margin-top: 2rem; padding-bottom: 1.75rem; border-bottom: 1px solid #d6dde7; }\n.docs-search-results h3 { margin: 0 0 .5rem; font-size: 1.25rem; }\n.docs-search-results p { margin: .5rem 0; }\n.docs-search-excerpt { color: #526071; font-size: .9375rem; overflow-wrap: anywhere; }\n''';p.write_text(s)\np=Path('docs/exec-plans/active/clean-slate-foundation.md');s=p.read_text();s+='''\n### T005 Website search implementation — 7 October\n\nThe next bounded slice connects a human search page to the existing named\n`searchDocs` operation and accepted catalogue. A plain GET form keeps search\nusable without JavaScript; results use the existing document link behaviour.\nThe original address owns SSR words, while the generated native browser GET\ncarries only a bounded ASCII URI component header. The installed native URI\ncodec carries Unicode, and the owning content Schema retains the 100-character\nterm, 20-result and 240-character excerpt limits. Empty, missing, invalid,\nloading and unavailable states remain distinct. No separate search index,\ncollection event or personalised content is introduced.\n\nDocumentation impact before acceptance: Change required for Website source,\nSchema/route/host ingress, exact route-consumer lint proof, native reading/search\njourney, Website/frontend/content/API/testing owners, SPEC/task and this plan;\nPreserve for accepted source/review/navigation, content service/RPC contract,\nretained results and disabled collection; N/A for a new package export,\nChangeset, deployment procedure, provider or credential operation. Discovery,\nMarkdown negotiation, images and old-app retirement remain later T005 work.\n''';p.write_text(s)\nPY\npython3 /private/tmp/dev76-search-implementation.py"}],"source":"unified_exec_startup","status":"completed","stdout":"","stderr":"","aggregated_output":"","exit_code":0,"duration":{"secs":0,"nanos":7875},"formatted_output":""},"started_at_ms":1791306397721,"completed_at_ms":1791306397721}}
