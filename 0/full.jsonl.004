 question metadata.\nweb test:native-pair: + 3. Call calculate with \\`help=errors\\` when validation fails.\nweb test:native-pair: + 4. Show returned issue paths beside your fields.\nweb test:native-pair: +\nweb test:native-pair: + ## Example [#example]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { TaxKitHttpApiService } from \"@taxkit/api-http/client\";\nweb test:native-pair: + import { createTaxKitApiClientLayer } from \"@taxkit/api-http/client/live\";\nweb test:native-pair: + import { HelpQuery } from \"@taxkit/calculators/schemas\";\nweb test:native-pair: + import { AuPayTakeHomeCalculation } from \"@taxkit/sdk/au/effect\";\nweb test:native-pair: + import { Array, Effect, Layer, Option } from \"effect\";\nweb test:native-pair: + import * as FetchHttpClient from \"effect/http/FetchHttpClient\";\nweb test:native-pair: +\nweb test:native-pair: + export const loadCalculatorHelp = Effect.gen(function* () {\nweb test:native-pair: +   const client = yield* TaxKitHttpApiService;\nweb test:native-pair: +   const query = yield* HelpQuery.makeEffect({\nweb test:native-pair: +     help: Option.some(Option.some(\"schema\")),\nweb test:native-pair: +   });\nweb test:native-pair: +   const schema = yield* client.calculatorApi.getCalculatorSchema({\nweb test:native-pair: +     params: { calculatorId: AuPayTakeHomeCalculation.calculatorId },\nweb test:native-pair: +     query,\nweb test:native-pair: +   });\nweb test:native-pair: +   return Array.map(schema.inputFacts, (fact) => \\`\\${fact.id}: \\${fact.title}\\`);\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + // Your application supplies the public API origin and owns Effect execution.\nweb test:native-pair: + export const program = loadCalculatorHelp.pipe(\nweb test:native-pair: +   Effect.provide(\nweb test:native-pair: +     createTaxKitApiClientLayer({ baseUrl: \"http://127.0.0.1:4000\" }).pipe(\nweb test:native-pair: +       Layer.provide(FetchHttpClient.layer)\nweb test:native-pair: +     )\nweb test:native-pair: +   )\nweb test:native-pair: + );\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Verify the result [#verify-the-result]\nweb test:native-pair: +\nweb test:native-pair: + Expected output includes fact descriptors for gross pay and the tax-free\nweb test:native-pair: + threshold claim used by the take-home pay calculator.\nweb test:native-pair: +\nweb test:native-pair: + ## Handle errors [#handle-errors]\nweb test:native-pair: +\nweb test:native-pair: + Let the typed client's expected error channel reach your application error\nweb test:native-pair: + handler. Display the checked issue paths or descriptor help from an input\nweb test:native-pair: + decode failure; [API errors](/api/errors) explains the envelope and other\nweb test:native-pair: + server failures. A calculation call with \\`help=errors\\` returns field help when\nweb test:native-pair: + its checked request facts do not match the selected calculator.\nweb test:native-pair: +\nweb test:native-pair: + ## Related pages [#related-pages]\nweb test:native-pair: +\nweb test:native-pair: + * [Facts](/concepts/facts)\nweb test:native-pair: + * [Diagnostics](/concepts/diagnostics)\nweb test:native-pair: + * [API errors](/api/errors)\nweb test:native-pair: + `,i={contents:[{heading:`show-calculator-help-to-users`,content:`Use this guide when your UI needs labels, required facts or validation help\nweb test:native-pair: + for the selected calculator.`},{heading:`before-you-start`,content:\"Choose a calculator ID such as `au.pay.take-home`.\"},{heading:`before-you-start`,content:`Use HTTP for browser clients that cannot import rule packages.`},{heading:`before-you-start`,content:`Keep the generated OpenAPI reference as the endpoint field source.`},{heading:`steps`,content:`Fetch calculator schema metadata.`},{heading:`steps`,content:`Render fact titles and question metadata.`},{heading:`steps`,content