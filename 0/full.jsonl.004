mport \\`aud\\`, \\`GrossPay\\` and the AU SDK helper.\nweb test:native-pair: + 2. Build the canonical gross pay fact.\nweb test:native-pair: + 3. Call \\`au.pay.takeHomePay\\`.\nweb test:native-pair: + 4. Check user input before the call and handle calculation failures with the\nweb test:native-pair: +    safe helper.\nweb test:native-pair: +\nweb test:native-pair: + ## Example [#example]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { GrossPay } from \"@taxkit/rules-au-pay\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const report = await au.pay.takeHomePay({\nweb test:native-pair: +   grossPay: new GrossPay({\nweb test:native-pair: +     amount: aud(Cents.make(165_400)),\nweb test:native-pair: +     period: \"weekly\",\nweb test:native-pair: +   }),\nweb test:native-pair: +   taxFreeThresholdClaimed: true,\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + console.log({\nweb test:native-pair: +   kind: report._tag,\nweb test:native-pair: +   netPayCents: report.netPay.cents,\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Verify the result [#verify-the-result]\nweb test:native-pair: +\nweb test:native-pair: + Expected output:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`json\nweb test:native-pair: + { \"kind\": \"TakeHomePayReport\", \"netPayCents\": 130100 }\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + This matches the current SDK test fixture for weekly gross pay of $1,654.00.\nweb test:native-pair: +\nweb test:native-pair: + ## Handle errors [#handle-errors]\nweb test:native-pair: +\nweb test:native-pair: + Check untrusted input as shown in [Handle validation errors](/guides/handle-validation-errors).\nweb test:native-pair: + Then use the safe helper when you want expected calculation failures as values:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + const result = await au.pay.safe.takeHomePay({\nweb test:native-pair: +   grossPay: new GrossPay({\nweb test:native-pair: +     amount: aud(Cents.make(165_400)),\nweb test:native-pair: +     period: \"weekly\",\nweb test:native-pair: +   }),\nweb test:native-pair: +   taxFreeThresholdClaimed: true,\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + if (result._tag === \"TaxKitFailure\") {\nweb test:native-pair: +   console.error(result.error.message);\nweb test:native-pair: + }\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Related pages [#related-pages]\nweb test:native-pair: +\nweb test:native-pair: + * [Plain SDK](/sdk/plain-sdk)\nweb test:native-pair: + * [Safe SDK](/sdk/safe-sdk)\nweb test:native-pair: + * [Calculators](/concepts/calculators)\nweb test:native-pair: + `,i={contents:[{heading:`calculate-australian-take-home-pay`,content:`Use this guide when you need a pay-period take-home amount from TypeScript.\nweb test:native-pair: + The SDK path keeps the calculation in-process and avoids HTTP transport.`},{heading:`before-you-start`,content:`Install the SDK with Install the SDK.`},{heading:`before-you-start`,content:`Use a TypeScript runtime that can import the SDK.`},{heading:`before-you-start`,content:\"Represent money in cents with `aud`.\"},{heading:`steps`,content:\"Import `aud`, `GrossPay` and the AU SDK helper.\"},{heading:`steps`,content:`Build the canonical gross pay fact.`},{heading:`steps`,content:\"Call `au.pay.takeHomePay`.\"},{heading:`steps`,content:`Check user input before the call and handle calculation failures with the\nweb test:native-pair: + safe helper.`},{heading:`verify-the-result`,content:`Expected output:`},{heading:`verify-the-result`,content:`This matches the current SDK test fixture for weekly gross pay of $1,654.00.`},{heading:`handle-errors`,content:`Check untrusted input as shown in Handle validation errors.\nweb test:native-pair: + Then use the safe helper when you want expected calculation failures as values:`},{heading:`related-pages`,content:`Plain SDK`},{heading:`related-pages`,content:`Safe SDK`},{heading:`related-pages`,content:`Calculators`}],headings:[{id:`calculate-australian-take-home-pay`,content:`Calculate Australian take-home pay`},{id:`before-you-start`,content:`Before you start`},{id:`steps`,content:`Steps`},{id:`example`,content:`Example`},{id:`verify-the-result`,content:`Verify the result`},{id:`handle-errors`,content:`Handle errors`},{id:`related-pages`,content:`Related pages`}]},a=[{depth:1,url:`#calculate-australian-take-home-pay`,title:(0,t.jsx)(t.Fragment,{children:`Calculate Australian take-home pay`})},{depth:2,url:`#before-you-start`,title:(0,t.jsx)(t.Fragment,{children:`Before you start`})},{depth:2,url:`#steps`,title:(0,t.jsx)(t.Fragment,{children:`Steps`})},{depth:2,url:`#example`,title:(0,t.jsx)(t.Fragment,{children:`Example`})},{depth:2,url:`#verify-the-result`,title:(0,t.jsx)(t.Fragment,{children:`Verify the result`})},{depth:2,url:`#handle-errors`,title:(0,t.jsx)(t.Fragment,{children:`Handle errors`})},{depth:2,url:`#related-pages`,title:(0,t.jsx)(t.Fragment,{children:`Related pages`})}];function o(e){let n={a:`a`,code:`code`,h1:`h1`,h2:`h2`,li:`li`,ol:`ol`,p:`p`,pre:`pre`,span:`span`,ul:`ul`,...e.components};return(0,t.jsxs)(t.Fragment,{children:[(0,t.jsx)(n.h1,{id:`calculate-australian-take-home-pay`,children:`Calculate Australian take-home pay`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`Use this guide when you need a pay-period take-home amount from TypeScript.\nweb test:native-pair: + The SDK path keeps the calculation in-process and avoids HTTP transport.`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`before-you-start`,children:`Before you start`}),`\nweb test:native-pair: + `,(0,t.jsxs)(n.