: + | \\`@taxkit/sdk/au/effect\\` | Use Australian calculation descriptors in Effect programs.                                           |\nweb test:native-pair: + | \\`@taxkit/sdk/schemas\\`   | Import schema-facing types that are re-exported for SDK consumers.                                   |\nweb test:native-pair: +\nweb test:native-pair: + The SDK package remains private until release approval. The public import\nweb test:native-pair: + shape is still the developer contract used by docs and examples.\nweb test:native-pair: +\nweb test:native-pair: + ## Plain SDK [#plain-sdk]\nweb test:native-pair: +\nweb test:native-pair: + Use \\`TaxKit.calculate\\` when you already have descriptor-typed input and want a\nweb test:native-pair: + Promise for the report:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { TaxKit } from \"@taxkit/sdk\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const report = await TaxKit.calculate(au.calculations.annualIncomeTax, {\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + Use the AU helper when you do not need to pass the descriptor yourself:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const report = await au.incomeTax.annual({\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Safe SDK [#safe-sdk]\nweb test:native-pair: +\nweb test:native-pair: + Use \\`TaxKit.safe.calculate\\` when expected calculator failures should be values:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { TaxKit } from \"@taxkit/sdk\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const result = await TaxKit.safe.calculate(au.calculations.annualIncomeTax, {\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + if (result._tag === \"TaxKitSuccess\") {\nweb test:native-pair: +   console.log(result.value.liability.cents);\nweb test:native-pair: + }\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Effect SDK [#effect-sdk]\nweb test:native-pair: +\nweb test:native-pair: + Use \\`calculateRunRequest\\` when you need a full \\`CalculatorRunResponse\\` with the\nweb test:native-pair: + descriptor-decoded report:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { audFromCents } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { AuAnnualIncomeTaxCalculation } from \"@taxkit/sdk/au/effect\";\nweb test:native-pair: + import { calculateRunRequest } from \"@taxkit/sdk/effect\";\nweb test:native-pair: + import { Effect, Option } from \"effect\";\nweb test:native-pair: +\nweb test:native-pair: + const effect = Effect.gen(function* () {\nweb test:native-pair: +   const taxableIncome = yield* audFromCents(9_000_000);\nweb test:native-pair: +   return yield* calculateRunRequest(AuAnnualIncomeTaxCalculation, {\nweb test:native-pair: +     payload: {\nweb test:native-pair: +       facts: { taxableIncome },\nweb test:native-pair: +       jurisdiction: Option.some(\nweb test:native-pair: +         Option.some(AuAnnualIncomeTaxCalculation.jurisdiction)\nweb test:native-pair: +       ),\nweb test:native-pair: +       taxYear: Option.some(Option.some(AuAnnualIncomeTaxCalculation.taxYear)),\nweb test:native-pair: +     },\nweb test:native-pair: +   });\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + Use \\`calculateReportRequest\\` when you have a full request and only need the\nweb test:native-pair: + report. Use \\`calculateReport\\` when you already have descriptor-typed facts.\nweb test:native-pair: +\nweb test:native-pair: + ## Owning sources [#owning-sources]\nweb test:native-pair: +\nweb test:native-pair: + * SDK facade: [\\`packages/sdk/typescript/src/index.ts\\`](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/packages/sdk/typescript/src/index.ts)\nweb test:native-pair: + * AU helpers: [\\`packages/sdk/typescript/src/au.ts\\`](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/packages/sdk/typescript/src/au.ts)\nweb test:native-pair: + * Effect helpers: [\\`packages/sdk/typescript/src/effect.ts\\`](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/packages/sdk/typescript/src/effect.ts)\nweb test:native-pair: +\nweb test:native-pair: + ## Used by [#used-by]\nweb test:native-pair: +\nweb test:native-pair: + * [Run your first calculation](/start/run-your-first-calculation)\nweb test:native-pair: + * [Plain SDK](/sdk/plain-sdk)\nweb test:native-pair: + * [Effect SDK](/sdk/effect-sdk)\nweb test:native-pair: + * [Examples](/reference/examples)\nweb test:native-pair: + `,i={contents:[{heading:`sdk-reference`,content:`Use this page when you need the stable SDK names after you have chosen an\nweb test:native-pair: + integration path.`},{heading:`entry-points`,content:`Import`},{heading:`entry-points`,content:`Use`},{heading:`entry-points`,content:\"`@taxkit/sdk`\"},{heading:`entry-points`,content:\"Use `TaxKit.calculate`, `TaxKit.safe.calculate` and `TaxKit.createClient`.\"},{heading:`entry-points`,