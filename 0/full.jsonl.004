lib.sha256(b).hexdigest(),'bytes':len(b)}\\ndef rows(prefix):\\n return [json.loads(line) for line in Path('/private/tmp/'+prefix+'-results.jsonl').read_text().splitlines()]\\ndef report(path):\\n raw=Path(path).read_bytes();s=raw.decode();s=s.replace('/Users/cooper/.agents/skills/impeccable','<installed-impeccable-skill>').replace('/Users/cooper/.codex/worktrees/aac7/taxkit','<repository-root>')\\n return {'path':path,'originalSha256':hashlib.sha256(raw).hexdigest(),'projectedSha256':hashlib.sha256(s.encode()).hexdigest(),'portableReport':s}\\nfull=rows('dev76-search-full-c')\\nassert {r['stage'] for r in full}=={'format','all-tests','verification'} and all(r['exitCode']==0 for r in full)\\nfor item in frozen['sourceIdentities']+frozen['preservedSources']['identities']+[frozen['catalogueIdentity']]:assert identity(item['path'])==item,item['path']\\ncaptures=json.loads(Path('/private/tmp/dev76-search-reviewed-captures.json').read_text())\\nfor item in captures:\\n assert identity(item['path'])=={k:item[k] for k in ['path','sha256','bytes']}\\n live='.alchemy/native-pair/screenshots/'+Path(item['path']).name\\n assert identity(live)['sha256']==item['sha256'],live\\nfocus=rows('dev76-search-final-native-d')\\nassert all(r['exitCode']==0 for r in focus)\\nreview=report('/private/tmp/dev76-search-finish-review.md');assert review['portableReport'].startswith('disposition: ship')\\ndesign=report('/private/tmp/dev76-search-design-documentation.md')\\nfailed=[]\\nfor p in sorted(Path('/private/tmp').glob('dev76-search-*-results.jsonl')):\\n for r in [json.loads(line) for line in p.read_text().splitlines()]:\\n  if r['exitCode']!=0:failed.append(r)\\nv={\\n 'schemaVersion':1,'documentType':'bounded-proof-receipt','lifecycle':'evidence','authority':'supporting','owner':'taxkit-web-app-owner','observedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),\\n 'status':'Local Website accepted-catalogue search qualified; whole T005 remains in progress','baseHead':frozen['b