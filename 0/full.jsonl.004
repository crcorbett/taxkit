.\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { CalculationQuery } from \"@taxkit/calculators/schemas\";\nweb test:native-pair: + import { Effect, Option } from \"effect\";\nweb test:native-pair: +\nweb test:native-pair: + const issueCount = client.calculatorApi\nweb test:native-pair: +   .calculate({\nweb test:native-pair: +     params: { calculatorId },\nweb test:native-pair: +     payload,\nweb test:native-pair: +     query: CalculationQuery.make({\nweb test:native-pair: +       help: Option.some(Option.some(\"errors\")),\nweb test:native-pair: +     }),\nweb test:native-pair: +   })\nweb test:native-pair: +   .pipe(Effect.map((response) => response.diagnostics.graphIssues.length));\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + Expected output for the current take-home pay success fixture is:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`txt\nweb test:native-pair: + 0\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Trace and graph data [#trace-and-graph-data]\nweb test:native-pair: +\nweb test:native-pair: + Trace data records which rule ran, what it used, what it produced and which\nweb test:native-pair: + sources support it. Graph data exposes dependency edges and validation issues\nweb test:native-pair: + through the calculator graph endpoint.\nweb test:native-pair: +\nweb test:native-pair: + ## Related concepts [#related-concepts]\nweb test:native-pair: +\nweb test:native-pair: + * [Reports](/concepts/reports)\nweb test:native-pair: + * [Rules](/concepts/rules)\nweb test:native-pair: + * [Graph, trace and ledgers architecture](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/graph-trace-ledgers.md)\nweb test:native-pair: + `,i={contents:[{heading:`diagnostics`,content:`Diagnostics explain calculation health and metadata quality. They are part of\nweb test:native-pair: + the public calculation model, not private debug output.`},{heading:`when-this-matters`,content:`Use diagnostics when you need to show validation issues, inspect graph health\nweb test:native-pair: + or test that a calculator ran without metadata problems.`},{heading:`how-it-works`,content:\"`CalculatorRunResponse` includes a `diagnostics` field beside the calculator\\nmetadata and report:\"},{heading:`how-it-works`,content:\"This excerpt assumes `client`, `calculatorId` and `payload` are already checked\\napplication values. It returns an Effect for your application host to run.\"},{heading:`how-it-works`,content:`Expected output for the current take-home pay success fixture is:`},{heading:`trace-and-graph-data`,content:`Trace data records which rule ran, what it used, what it produced and which\nweb test:native-pair: + sources support it. Graph data exposes dependency edges and validation issues\nweb test:native-pair: + through the calculator graph endpoint.`},{heading:`related-concepts`,content:`Reports`},{heading:`related-concepts`,content:`Rules`},{heading:`related-concepts`,content:`Graph, trace and ledgers architecture`}],headings:[{id:`diagnostics`,content:`Diagnostics`},{id:`when-this-matters`,content:`When this matters`},{id:`how-it-works`,content:`How it works`},{id:`trace-and-graph-data`,content:`Trace and graph data`},{id:`related-concepts`,content:`Related concepts`}]},a=[{depth:1,url:`#diagnostics`,title:(0,t.jsx)(t.Fragment,{children:`Diagnostics`})},{depth:2,url:`#when-this-matters`,title:(0,t.jsx)(t.Fragment,{children:`When this matters`})},{depth:2,url:`#how-it-works`,title:(0,t.jsx)(t.Fragment,{children:`How it works`})},{depth:2,url:`#trace-and-graph-data`,title:(0,t.jsx)(t.Fragment,{children:`Trace and graph data`})},{depth:2,url:`#related-concepts`,title:(0,t.jsx)(t.Fragment,{children:`Related concepts`})}];function o(e){let n={a:`a`,code:`code`,h1:`h1`,h2:`h2`,li:`li`,p:`p`,pre:`pre`,span:`span`,ul:`ul`,...e.components};return(0,t.jsxs)(t.Fra