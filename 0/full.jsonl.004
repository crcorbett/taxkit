r:n}=e.components||{};return n?(0,t.jsx)(n,{...e,children:(0,t.jsx)(o,{...e})}):o(e)}export{r as _markdown,s as default,n as frontmatter,i as structuredData,a as toc};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Run the AU annual income tax calculator with a branded money value.`,status:`published`,title:`Calculate annual income tax`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # Calculate annual income tax [#calculate-annual-income-tax]\nweb test:native-pair: +\nweb test:native-pair: + Use this guide to run the retained Australian 2025–26 annual income tax\nweb test:native-pair: + calculator from TypeScript.\nweb test:native-pair: +\nweb test:native-pair: + ## Before you start [#before-you-start]\nweb test:native-pair: +\nweb test:native-pair: + * Install the SDK with [Install the SDK](/start/install-the-sdk).\nweb test:native-pair: + * Use \\`au.incomeTax.annual\\` for the common plain SDK path.\nweb test:native-pair: + * Pass taxable income as \\`Money\\` in cents.\nweb test:native-pair: +\nweb test:native-pair: + ## Steps [#steps]\nweb test:native-pair: +\nweb test:native-pair: + 1. Import \\`aud\\` and the AU SDK helper.\nweb test:native-pair: + 2. Convert taxable income to a \\`Money\\` value.\nweb test:native-pair: + 3. Call \\`au.incomeTax.annual\\`.\nweb test:native-pair: + 4. Read \\`liability\\` and the report ledger.\nweb test:native-pair: +\nweb test:native-pair: + ## Example [#example]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const report = await au.incomeTax.annual({\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + console.log({\nweb test:native-pair: +   kind: report._tag,\nweb test:native-pair: +   liabilityCents: report.liability.cents,\nweb test:native-pair: +   components: report.ledger.components.length,\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Verify the result [#verify-the-result]\nweb test:native-pair: +\nweb test:native-pair: + Expected output:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`json\nweb test:native-pair: + {\nweb test:native-pair: +   \"kind\": \"AnnualTaxReport\",\nweb test:native-pair: +   \"liabilityCents\": 1958800,\nweb test:native-pair: +   \"components\": 3\nweb test:native-pair: + }\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + The liability value is cents. \\`1958800\\` means $19,588.00. This expected value\nweb test:native-pair: + checks the retained calculation fixture. A Medicare threshold update is still\nweb test:native-pair: + under review, so the fixture does not establish current-law accuracy.\nweb test:native-pair: +\nweb test:native-pair: + ## Handle errors [#handle-errors]\nweb test:native-pair: +\nweb test:native-pair: + Use \\`TaxKit.safe.calculate\\` when you need a result value:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { TaxKit } from \"@taxkit/sdk\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const result = await TaxKit.safe.calculate(au.calculations.annualIncomeTax, {\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + if (result._tag === \"TaxKitFailure\") {\nweb test:native-pair: +   console.error(result.error.message);\nweb test:native-pair: + }\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Related pages [#related-pages]\nweb test:native-pair: +\nweb test:native-pair: + * [Run your first calculation](/start/run-your-first-calculation)\nweb test:native-pair: + * [Reports](/concepts/reports)\nweb test:native-pair: + * [Money and branded values](/concepts/money-and-branded-values)\nweb test:native-pair: + `,i={contents:[{heading:`calculate-annual-income-tax`,content:`Use this guide to run the retained Australian 2025–26 annual income tax\nweb test:native-pair: + calculator from TypeScript.`},{heading:`before-you-start`,content:`Install the SDK with Install the SDK.`},{heading:`before-you-start`,content:\"Use `au.incomeTax.annual` for the common plain SDK path.\"},{heading:`before-you-start`,content:\"Pass taxable income as `Money` in cents.\"},{heading:`steps`,content:\"Import `aud` and the AU SDK helper.\"},{heading:`steps`,content:\"Convert taxable income to a `Money` value.\"},{heading:`steps`,content:\"Call `au.incomeTax.annual`.\"},{heading:`steps`,content:\"Read `liability` and the report ledger.\"},{heading:`verify-the-result`,content:`Expected output:`},{heading:`verify-the-result`,content:`The liability value is cents. \\`1958800\\` means $19,588.00. This expected value\nweb test:native-pair: + checks the retained calculation fixture. A Medicare threshold update is still\nweb test:native-pair: + under review, so the fixture does not establish current-law accuracy.`},{heading:`handle-errors`,content:\"Use `TaxKit.safe.calculate` when you need a result value:\"},{heading:`related-pages`,content:`Run your first calculation`},{heading:`related-pages`,content:`Reports`},{heading:`related-pages`,content:`Money and branded values`}],headings:[{id:`calculate-annual-income-tax`,content:`Calculate annual income tax`},{id:`before-you-start`,content:`Before you start`},{id:`steps`,content:`Steps`},{id:`example`,content:`Example`},{id:`verify-the-result`,content:`Verify the result`},{id:`handle-errors`,content:`Handle errors`},{id:`related-pages`,content:`Related pages`}]},a=[{depth:1,url:`#c