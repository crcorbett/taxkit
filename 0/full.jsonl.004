},{heading:`review-notes`,content:`whether request or response schemas changed`},{heading:`review-notes`,content:`whether public SDK helper input or output types changed`},{heading:`review-notes`,content:`whether generated OpenAPI output changed`},{heading:`review-notes`,content:`whether existing calculator IDs, jurisdictions or tax years still work`},{heading:`review-notes`,content:`whether the change needs a Changeset`},{heading:`review-notes`,content:`Read API and SDK before\nweb test:native-pair: + changing transport or SDK contracts.`}],headings:[{id:`backward-compatibility`,content:`Backward compatibility`},{id:`public-contract-surfaces`,content:`Public contract surfaces`},{id:`http-and-sdk-rule`,content:`HTTP and SDK rule`},{id:`review-notes`,content:`Review notes`}]},a=[{depth:1,url:`#backward-compatibility`,title:(0,t.jsx)(t.Fragment,{children:`Backward compatibility`})},{depth:2,url:`#public-contract-surfaces`,title:(0,t.jsx)(t.Fragment,{children:`Public contract surfaces`})},{depth:2,url:`#http-and-sdk-rule`,title:(0,t.jsx)(t.Fragment,{children:`HTTP and SDK rule`})},{depth:2,url:`#review-notes`,title:(0,t.jsx)(t.Fragment,{children:`Review notes`})}];function o(e){let n={a:`a`,code:`code`,h1:`h1`,h2:`h2`,li:`li`,p:`p`,table:`table`,tbody:`tbody`,td:`td`,th:`th`,thead:`thead`,tr:`tr`,ul:`ul`,...e.components};return(0,t.jsxs)(t.Fragment,{children:[(0,t.jsx)(n.h1,{id:`backward-compatibility`,children:`Backward compatibility`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`Use this page before you change facts, calculator inputs, report fields,\nweb test:native-pair: + errors, HTTP routes, SDK helpers or exported schema names.`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`public-contract-surfaces`,children:`Public contract surfaces`}),`\nweb test:native-pair: + `,(0,t.jsxs)(n.table,{children:[(0,t.jsx)(n.thead,{children:(0,t.jsxs)(n.tr,{children:[(0,t.jsx)(n.th,{children:`Surface`}),(0,t.jsx)(n.th,{children:`Compatibility evidence`})]})}),(0,t.j