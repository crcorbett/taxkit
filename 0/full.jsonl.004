itemap.xml\", config.websiteOrigin).href}\\n`\n+              ),\n+              Match.when(\n+                \"/llms.txt\",\n+                () =>\n+                  \"# TaxKit\\n\\n> Open-source Australian tax calculators, APIs and integration documentation.\\n\\n\" +\n+                  \"These links contain accepted public documentation, not personal calculation reports.\\n\" +\n+                  `Relative page links in the Markdown use ${config.websiteOrigin.origin}.\\n\\n` +\n+                  \"## Documentation\\n\\n\" +\n+                  Array.map(catalogue.pages, (page) => {\n+                    const label = page.frontmatter.title\n+                      .replaceAll(/\\s+/gu, \" \")\n+                      .replaceAll(/([\\\\[\\]])/gu, \"\\\\$1\");\n+                    const address = new URL(\n+                      `/api/v1/docs/markdown?${new URLSearchParams({ path: page.path }).toString()}`,\n+                      config.apiOrigin\n+                    ).href;\n+                    return `- [${label}](${address}): ${page.frontmatter.description.replaceAll(/\\s+/gu, \" \")}`;\n+                  }).join(\"\\n\") +\n+                  \"\\n\"\n+              ),\n+              Match.when(\n+                \"/llms-full.txt\",\n+                () =>\n+                  \"# TaxKit documentation\\n\\n\" +\n+                  \"Accepted public documentation only; no personal calculation reports.\\n\" +\n+                  `Relative page links use ${config.websiteOrigin.origin}.\\n\\n` +\n+                  Array.map(\n+                    catalogue.pages,\n+                    (page) =>\n+                      `Canonical page: ${new URL(page.path, config.websiteOrigin).href}\\n\\n${page.markdown}`\n+                  ).join(\"\\n\\n---\\n\\n\") +\n+                  \"\\n\"\n+              ),\n+              Match.exhaustive\n+            );\n+            return yield* DocsDiscoveryDocument.makeEffect({\n+              body,\n+              contentType: path === \"/sitemap.xml\" ? \"application/xml\" : \"text/plain\",\n+              path,\n+            }).pipe(\n+              Effect.mapError(\n+                () => new DocsSourceError({\n+                  message: \"The documentation discovery document could not be prepared.\",\n+                  operation: \"getDiscoveryDocument\",\n+                })\n+              )\n+            );\n+          }\n+        ),\n+      });\n+    })\n+  );\n","move_path":null},"/Users/cooper/.codex/worktrees/aac7/taxkit/packages/api/rpc/src/schemas.ts":{"type":"update","unified_diff":"@@ -8,2 +8,3 @@\n import { ByteSize, Duration, Schema, SchemaGetter } from \"effect\";\n+import { PublicHttpOrigin } from \"@taxkit/content/schemas\";\n \n@@ -53,11 +54,5 @@\n \n-export const CalculatorRpcOrigin = Schema.URLFromString.check(\n-  Schema.makeFilter(\n-    (url) =>\n-      url.href === `${url.origin}/` &&\n-      (url.protocol === \"https:\" ||\n-        (url.protocol === \"http:\" &&\n-          (url.hostname === \"localhost\" || url.hostname === \"127.0.0.1\")))\n-  )\n-).pipe(Schema.brand(\"@taxkit/api-rpc/CalculatorRpcOrigin\"));\n+export const CalculatorRpcOrigin = PublicHttpOrigin.pipe(\n+  Schema.brand(\"@taxkit/api-rpc/CalculatorRpcOrigin\")\n+);\n export type CalculatorRpcOrigin = typeof CalculatorRpcOrigin.Type;\n","move_path":null},"/Users/cooper/.codex/worktrees/aac7/taxkit/packages/content/src/errors.ts":{"type":"update","unified_diff":"@@ -11,2 +11,3 @@\n   \"decode\",\n+  \"getDiscoveryDocument\",\n   \"getNavigation\",\n@@ -34,2 +35,7 @@\n \n+export class DocsDiscoveryUnavailable extends Schema.TaggedError<DocsDiscoveryUnavailable>()(\n+  \"DocsDiscoveryUnavailable\",\n+  { message: Schema.Literal(\"Documentation discovery is temporarily unavailable.\") }\n+) {}\n+\n export class DocsPageNotFoundError extends Schema.TaggedError<DocsPageNotFoundError>()(\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /Users/coop