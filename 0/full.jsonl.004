concepts/calculators)\nweb test:native-pair: + * [Diagnostics](/concepts/diagnostics)\nweb test:native-pair: + * [Rules and parameters architecture](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/rules-and-parameters.md)\nweb test:native-pair: + `,i={contents:[{heading:`rules`,content:`Rules derive facts from other facts and parameter services. They are the\nweb test:native-pair: + source-backed calculation steps behind calculator reports.`},{heading:`when-this-matters`,content:`You usually do not call rules directly as an API or SDK consumer. You need the\nweb test:native-pair: + model when you inspect graph metadata, review diagnostics or contribute tax\nweb test:native-pair: + behaviour.`},{heading:`how-it-works`,content:`Rules have descriptors so TaxKit can expose graph edges, source references\nweb test:native-pair: + and required facts through metadata endpoints.`},{heading:`parameters`,content:`Tax-year rates and thresholds are services. The same algorithm can be paired\nweb test:native-pair: + with different parameter layers for different effective periods.`},{heading:`related-concepts`,content:`Calculators`},{heading:`related-concepts`,content:`Diagnostics`},{heading:`related-concepts`,content:`Rules and parameters architecture`}],headings:[{id:`rules`,content:`Rules`},{id:`when-this-matters`,content:`When this matters`},{id:`how-it-works`,content:`How it works`},{id:`parameters`,content:`Parameters`},{id:`related-concepts`,content:`Related concepts`}]},a=[{depth:1,url:`#rules`,title:(0,t.jsx)(t.Fragment,{children:`Rules`})},{depth:2,url:`#when-this-matters`,title:(0,t.jsx)(t.Fragment,{children:`When this matters`})},{depth:2,url:`#how-it-works`,title:(0,t.jsx)(t.Fragment,{children:`How it works`})},{depth:2,url:`#parameters`,title:(0,t.jsx)(t.Fragment,{children:`Parameters`})},{depth:2,url:`#related-concepts`,title:(0,t.jsx)(t.Fragment,{children:`Related concepts`})}];function o(e){let n={a:`a`,code:`cod