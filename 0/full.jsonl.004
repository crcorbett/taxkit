path\": \"tools/documentation/owner-policy.json\",\n      \"sha256\": \"75c342c96118899eb11cd9c3bd2fa36ba98c8b6fd832e40d9190083e9b75bd54\",\n      \"bytes\": 16702\n    }\n  ],\n  \"retainedIntegrationTemplates\": [\n    {\n      \"path\": \"packages/docs-examples/src/node-server.ts\",\n      \"sha256\": \"615696a109f00a22c8b7adeeca0d23a0e3b0c3598cb03c8d374db5c60fedb908\",\n      \"bytes\": 2000\n    },\n    {\n      \"path\": \"packages/docs-examples/src/browser-http.ts\",\n      \"sha256\": \"bc7f0cb75b61ccd87e98a6f4e4c7c797e83bec1651c0fce1587a73deeb973862\",\n      \"bytes\": 1157\n    },\n    {\n      \"path\": \"packages/docs-examples/src/effect.ts\",\n      \"sha256\": \"a1bbc04ec1a8bbb31b52b8a9a22b591d5ffaf4e484da4f6e461eaadb3ec6619a\",\n      \"bytes\": 1061\n    },\n    {\n      \"path\": \"packages/docs-examples/src/error-handling.ts\",\n      \"sha256\": \"77616e6e6803778d226f1e7911cfbaf15300e611582a136dcfa1ba4f149aa570\",\n      \"bytes\": 825\n    }\n  ]\n}\ncatalogueIdentity dict\n{\n  \"path\": \"packages/docs-content/.source/public-catalogue.json\",\n  \"sha256\": \"6f3d3beb055c2d5d83ba5abeb9feef3fb8da51188f077e9181685f8f708c26b6\",\n  \"bytes\": 235703\n}\nfrom pathlib import Path\nimport json,hashlib,datetime,subprocess,struct\nreceipt=Path('docs/documentation-audit/clean-slate-foundation/2026-10-07-website-docs-search.json')\nfrozen=json.loads(Path('/private/tmp/dev76-search-frozen-sources.json').read_text())\ndef identity(path):\n b=Path(path).read_bytes();return {'path':path,'sha256':hashlib.sha256(b).hexdigest(),'bytes':len(b)}\ndef rows(prefix):\n return [json.loads(line) for line in Path('/private/tmp/'+prefix+'-results.jsonl').read_text().splitlines()]\ndef report(path):\n raw=Path(path).read_bytes();s=raw.decode();s=s.replace('/Users/cooper/.agents/skills/impeccable','<installed-impeccable-skill>').replace('/Users/cooper/.codex/worktrees/aac7/taxkit','<repository-root>')\n return {'path':path,'originalSha256':hashlib.sha256(raw).hexdigest(),'projectedSha256':hashlib.sha256(s.encode()).hexdigest(),'portableReport':s}\nfull=rows('dev76-search-full-c')\nassert {r['stage'] for r in full}=={'format','all-tests','verification'} and all(r['exitCode']==0 for r in full)\nfor item in frozen['sourceIdentities']+frozen['preservedSources']['identities']+[frozen['catalogueIdentity']]:assert identity(item['path'])==item,item['path']\ncaptures=json.loads(Path('/private/tmp/dev76-search-reviewed-captures.json').read_text())\nfor item in captures:\n assert identity(item['path'])=={k:item[k] for k in ['path','sha256','bytes']}\n live='.alchemy/native-pair/screenshots/'+Path(item['path']).name\n assert identity(live)['sha256']==item['sha256'],live\nfocus=rows('dev76-search-final-native-d')\nassert all(r['exitCode']==0 for r in focus)\nreview=report('/private/tmp/dev76-search-finish-review.md');assert review['portableReport'].startswith('disposition: ship')\ndesign=report('/private/tmp/dev76-search-design-documentation.md')\nfailed=[]\nfor p in sorted(Path('/private/tmp').glob('dev76-search-*-results.jsonl')):\n for r in [json.loads(line) for line in p.read_text().splitlines()]:\n  if r['exitCode']!=0:failed.append(r)\nv={\n 'schemaVersion':1,'documentType':'bounded-proof-receipt','lifecycle':'evidence','authority':'supporting','owner':'taxkit-web-app-owner','observedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),\n 'status':'Local Website accepted-catalogue search qualified; whole T005 remains in progress','baseHead':frozen['baseHead'],\n 'actorAuthority':{'principal':'Cooper','reviewer':'Codex','operation':'Approved CSF-T005 implementation, local checks, tested commit/push and continuation of draft PR155','environment':'Local native workerd/Chromium pair and repository checks','approvalBoundary':'No merge, deploy, publication, provider apply or metrics implementation'},\n 'outcome':['A labelled /search GET form uses the existing accepted-catalogue searchDocs operation, works without JavaScript and links checked title/description results to documentation.','Literal URL pairs preserve scientific numbers, quoted words, duplicate keys and Unicode; checked ingress rejects unexpected/duplicate keys and overlong words.','Generated native search GET takes no data or client Context, carries only a bounded ASCII URI header and decodes Unicode through the installed Schema codec. Original SSR URLs resist forged headers.','Empty words skip search. Empty/no-match/loading/invalid/unavailable states remain separate; damaged genuine browser replies fail checked restoration safely.','The route restores and matches encoded results before readonly leaf composition. Typed route context avoids server imports in a browser route. Existing heading-focus and phone navigation remain owned.','Local startup observes served-page readiness after printed addresses, retrying only 502/503 for at most fifteen seconds before strict successful browser navigation. The earlier hosted 502 cause remains unknown.'],\n 'impact':{'changeRequired':['apps/web source/Schema/URL/restoration/native-loader/host ingress and existing native/browser tests','Exact oxlint selectors and actual CLI positive/negative cases','apps/web/README.md; frontend, content-and-posts, API-and-SDK, Effect-services and testing-quality architecture','Active SPEC/tasks/plan, existing taxkit-native-website journey and this receipt'],'preserve':['127 hashed sources: 61 accepted pages, 64 review records, navigation and four integration templates; 62 exact bindings and owner policy','Content service and HTTP/RPC contracts; retained calculator answers and Medicare scope decision','Existing visual design and historical docs/runtime receipts','Disabled platform collection and explicit metrics deferral'],'notApplicable':['No package export/wire change or new Changeset; existing documentation contract Changeset retained','No new runbook command, operational procedure, skill installation or provider/credential/release change']},\n 'environment':{'bu