Tree.gen.ts                      |   30 +-\\n apps/web/src/router.tsx                            |   10 +-\\n apps/web/src/routes/$.tsx                          |    7 +-\\n apps/web/src/routes/search.tsx                     |   87 ++\\n apps/web/src/server.ts                             |   16 +-\\n apps/web/src/styles.css                            |   60 +\\n .../test/native-local-development.boundary.test.ts |   14 +\\n apps/web/test/native-pair.boundary.test.ts         |  365 ++++-\\n docs/architecture/api-and-sdk.md                   |    7 +-\\n docs/architecture/content-and-posts.md             |    6 +-\\n docs/architecture/effect-services.md               |    2 +-\\n docs/architecture/frontend.md                      |   36 +-\\n docs/architecture/testing-and-quality.md           |   41 +-\\n .../2026-10-07-website-docs-search.json            | 1414 ++++++++++++++++++++\\n docs/exec-plans/active/clean-slate-foundation.md   |   45 +\\n docs/product-specs/clean-slate-foundation.md       |   17 +\\n .../clean-slate-foundation.tasks.json              |    3 +-\\n docs/verification/critical-journeys.json           |   10 +-\\n oxlint.config.ts                                   |    4 +\\n tools/oxlint/portable-rules.test.ts                |   17 +\\n 32 files changed, 2699 insertions(+), 46 deletions(-)\\n\"}}}"},{"type":"input_text","text":"{\"i\":2,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"08d95d\",\"wall_time_seconds\":0.000006209,\"exit_code\":0,\"original_token_count\":1897,\"output\":\"diff --git a/apps/web/src/lib/docs/search-location.boundary.ts b/apps/web/src/lib/docs/search-location.boundary.ts\\nnew file mode 100644\\nindex 00000000..9f8f1f2c\\n--- /dev/null\\n+++ b/apps/web/src/lib/docs/search-location.boundary.ts\\n@@ -0,0 +1,40 @@\\n+import { Array, HashSet, Record, Result, Schema } from \\\"effect\\\";\\n+\\n+import { WebsiteDocsSearchLocation, WebsiteSearchParameters } from \\\"../schemas\\\";\\n+import { DocsSearchInputError } from \\\"./errors\\\";\\n+\\n+// The Website has literal human query text. The framework's default JSON\\n+// parser changes scientific numbers and quoted words, and its encoder changes\\n+// duplicate keys. Preserve the native URL pairs through both host callbacks.\\n+export const websiteSearchParameters = {\\n+  parse: (raw: string): typeof WebsiteSearchParameters.Type => {\\n+    const query = new URLSearchParams(raw);\\n+    return Record.fromEntries(\\n+      Array.map(\\n+        Array.fromIterable(HashSet.fromIterable(query.keys())),\\n+        (key) => [key, query.getAll(key)]\\n+      )\\n+    );\\n+  },\\n+  stringify: (input: typeof Schema.Unknown.Type) =>\\n+    Schema.decodeUnknownResult(WebsiteSearchParameters)(input).pipe(\\n+      Result.match({\\n+        onFailure: () => \\\"?invalid-search=1\\\",\\n+        onSuccess: (query) => {\\n+          const encoded = new URLSearchParams(\\n+            Array.flatMap(Record.toEntries(query), ([key, values]) =>\\n+              Array.map(values, (value) => [key, value])\\n+            )\\n+          ).toString();\\n+          return encoded === \\\"\\\" ? \\\"\\\" : `?${encoded}`;\\n+        },\\n+      })\\n+    ),\\n+};\\n+\\n+// The route's original address is representation ingress, separate from\\n+// restoration of a later encoded loader reply.\\n+export const readDocsSearchLocation = (encoded: typeof Schema.Unknown.Type) =>\\n+  Schema.decodeUnknownResult(WebsiteDocsSearchLocation)(encoded).pipe(\\n+    Result.mapError(() => new DocsSearchInputError())\\n+  );\\ndiff --git a/apps/web/src/lib/docs/search.view.tsx b/apps/web/src/lib/docs/search.view.tsx\\nnew file mode 100644\\nindex 00000000..552d7f74\\n--- /dev/null\\n+++ b/apps/web/src/lib/docs/search.view.tsx\\n@@ -0,0 +1,75 @@\\n+import { Link } from \\\"@tanstack/react-router\\\";\\n+import type { DocsSearchResult, DocsSearchTerm } from \\\"@taxkit/content/schemas\\\";\\n+import { Array } from \\\"effect\\\";\\n+\\n+import { requestDocsNavigationFocus } from \\\"./components\\\";\\n+\\n+export const DocsSearchForm = ({\\n+  term,\\n+}: {\\n+  readonly term: DocsSearchTerm | \\\"\\\";\\n+}) => (\\n+  <search>\\n+    <form action=\\\"/search\\\" className=\\\"docs-search-form\\\" method=\\\"GET\\\">\\n+      <label htmlFor=\\\"docs-search-term\\\">Search words</label>\\n+      <div className=\\\"docs-search-controls\\\">\\n+        <input\\n+          autoComplete=\\\"off\\\"\\n+          defaultValue={term}\\n+          id=\\\"docs-search-term\\\"\\n+          key={term}\\n+          maxLength={100}\\n+          name=\\\"term\\\"\\n+          type=\\\"search\\\"\\n+        />\\n+        <button type=\\\"submit\\\">Search documentation</button>\\n+      </div>\\n+      <p>Search the guides, API reference and integration examples.</p>\\n+    </form>\\n+  </search>\\n+);\\n+\\n+export const DocsSearchResults = ({\\n+  results,\\n+  term,\\n+}: {\\n+  readonly results: readonly DocsSearchResult[];\\n+  readonly term: DocsSearchTerm | \\\"\\\";\\n+}) => {\\n+  if (term === \\\"\\\") {\\n+    return <p>Enter a few words to find a documentation page.</p>;\\n+  }\\n+  if (results.length === 0) {\\n+    return (\\n+      <section aria-live=\\\"polite\\\">\\n+        <h2>No matching pages</h2>\\n+        <p>\\n+          Try fewer words or choose a page from the documentation navigation.\\n+        </p>\\n+      </section>\\n+    );\\n+  }\\n+  return (\\n+    <section aria-label=\\\"Documentation search results\\\">\\n+      <h2>\\n+        {results.length} matching {results.length === 1 ? \\\"page\\\" : \\\"pages\\\"}\\n+      </h2>\\n+      <ol className=\\\"docs-search-results\\\">\\n+        {Array.map(results, (result) => (\\n+          <li key={result.path}>\\n+            <h3>\\n+              <Link\\n+                onClick={requestDocsNavigationFocus}\\n+                params={{ _splat: result.path.slice(1) }}\\n+                to=\\\"/$\\\"\\n+              >\\n+                {result.title}\\n+              </Link>\\n+            </h3>\\n+            <p>{result.description}</p>\\n+          </li>\\n+        ))}\\n+      </ol>\\n+    </section>\\n+  );\\n+};\\ndiff --git a/apps/web/src/routes/search.tsx b/apps/web/src/routes/search.tsx\\nnew file mode 100644\\nindex 00000000..d03b5cef\\n--- /dev/null\\n+++ b/apps/web/src/routes/search.tsx\\n@@ -0,0 +1,87 @@\\n+import { createFileRoute } from \\\"@tanstack/react-router\\\";\\n+import { Match, Option, Result } from \\\"effect\\\";\\n+\\n+import { DocsHeading } from \\\"#/lib/docs/components\\\";\\n+import { DocsNavigation } from \\\"#/lib/docs/page.view\\\";\\n+import { docsSearchRouteBoundary } from \\\"#/lib/docs/route-boundary\\\";\\n+import { readDocsSearchLocation } from \\\"#/lib/docs/search-location.boundary\\\";\\n+import { DocsSearchForm, DocsSearchResults } from \\\"#/lib/docs/search.view\\\";\\n+\\n+const SearchUnavailable = () => (\\n+  <section className=\\\"docs-state\\\" role=\\\"alert\\\">\\n+    <DocsHeading>Search documentation</DocsHeading>\\n+    <p>\\n+      Documentation search could not load. Please reload this page to try again.\\n+    </p>\\n+    <DocsSearchForm term=\\\"\\\" />\\n+    <a href=\\\"/start/quickstart\\\">Open the Quickstart</a>\\n+  </section>\\n+);\\n+\\n+export const Route = createFileRoute(\\\"/search\\\")({\\n+  component: function DocumentationSearchRoute() {\\n+    const restored = docsSearchRouteBoundary.restore(Route.useLoaderData());\\n+    return Result.match(restored, {\\n+      onFailure: (error) => (\\n+        <section className=\\\"docs-state\\\" role=\\\"alert\\\">\\n+          <DocsHeading>Search documentation</DocsHeading>\\n+          <p>\\n+            {Match.value(error).pipe(\\n+              Match.tag(\\n+                \\\"DocsSearchInputError\\\",\\n+                () => \\\"Enter up to 100 characters to search the documentation.\\\"\\n+              ),\\n+              Match.orElse(\\n+                () =>\\n+                  \\\"Documentation search could not load. Please reload this page to try again.\\\"\\n+              )\\n+            )}\\n+          </p>\\n+          <DocsSearchForm term=\\\"\\\" />\\n+          <a href=\\\"/start/quickstart\\\">Open the Quickstart</a>\\n+        </section>\\n+      ),\\n+      onSuccess: ({ navigation, results, term }) => (\\n+        <div className=\\\"docs-layout\\\">\\n+          <aside className=\\\"docs-sidebar\\\">\\n+            <DocsNavigation\\n+              currentPath={Option.none()}\\n+              navigation={navigation}\\n+            />\\n+          </aside>\\n+          <article className=\\\"docs-article\\\">\\n+            <DocsHeading>Search documentation</DocsHeading>\\n+            <DocsSearchForm term={term} />\\n+            <DocsSearchResults results={results} term={term} />\\n+          </article>\\n+        </div>\\n+      ),\\n+    });\\n+  },\\n+  errorComponent: SearchUnavailable,\\n+  head: () => ({\\n+    meta: [\\n+      { title: \\\"Search documentation | TaxKit\\\" },\\n+      { content: \\\"noindex, follow\\\", name: \\\"robots\\\" },\\n+      {\\n+        content: \\\"Find a TaxKit guide, API reference or integration example.\\\",\\n+        name: \\\"description\\\",\\n+      },\\n+    ],\\n+  }),\\n+  loader: ({ location, context, abortController }) =>\\n+    context.loadDocsSearch({\\n+      query: readDocsSearchLocation(location.searchStr),\\n+      signal: abortController.signal,\\n+    }),\\n+  pendingComponent: () => (\\n+    <section aria-busy=\\\"true\\\" aria-live=\\\"polite\\\" className=\\\"docs-state\\\">\\n+      <h1>Searching documentation</h1>\\n+      <p>Matching pages are being loaded.</p>\\n+    </section>\\n+  ),\\n+  pendingMs: 150,\\n+  // Each original address supplies its own words. Do not reuse a cached result\\n+  // from a previous query or let the framework's JSON query parser change it.\\n+  shouldReload: true,\\n+});\\n\"}}}"},{"type":"input_text","text":"{\"i\":3,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"ff748d\",\"wall_time_seconds\":0.000006208,\"exit_code\":0,\"original_token_count\":10,\"output\":\"codex/dev-76-public-content-catalogue\\n\"}}}"},{"type":"input_text","text":"{\"i\":4,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"437230\",\"wall_time_seconds\":0.00000775,\"exit_code\":0,\"original_token_count\":10,\"output\":\"https://github.com/crcorbett/taxkit.git\\n\"}}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","create_time":1791310058.441308}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
