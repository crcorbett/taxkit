oBe(`${apiOrigin}/api/docs/openapi.json`);\\n1441:        const docsFunctionId = Array.findFirst(\\n1456:            expect.fail(\\\"Missing native generated docs function identity\\\")\\n1459:        const nativeDocsAddress = `${websiteOrigin}/_serverFn/${docsFunctionId}`;\\n1463:          \\\"x-taxkit-docs-page\\\": \\\"/start/quickstart\\\",\\n1488:                \\\"x-taxkit-docs-page\\\": `/${\\\"a\\\".repeat(256)}`,\\n1495:                \\\"x-taxkit-docs-page\\\": \\\"../PRIVATE9\\\",\\n1514:        const docsPage = yield* Effect.promise(() => context.newPage());\\n1515:        docsPage.on(\\\"pageerror\\\", (error) =>\\n1518:        const docsCalls = yield* Queue.make<string>();\\n1519:        const docsDocuments = yield* Queue.make<string>();\\n1520:        docsPage.on(\\\"request\\\", (request) => {\\n1522:            Queue.offerUnsafe(docsCalls, request.url());\\n1526:            request.frame() === docsPage.mainFrame()\\n1528:            Queue.offerUnsafe(docsDocuments, request.url());\\n1532:          docsPage.goto(`${websiteOrigin}/start/quickstart`)\\n1534:        yield* Effect.promise(() => docsPage.waitForLoadState(\\\"networkidle\\\"));\\n1536:          yield* Effect.promise(() => docsPage.locator(\\\"main\\\").count())\\n1540:            docsPage.locator(\\\".docs-article h1\\\").count()\\n1545:            docsPage\\n1546:              .locator(\\\".docs-article h1\\\")\\n1556:                headers: { \\\"x-taxkit-docs-page\\\": \\\"/private9\\\" },\\n1562:              docsPage.evaluate((value) => {\\n1567:                const article = document.querySelector(\\\".docs-article\\\");\\n1577:                    ?.querySelector('a[href*=\\\"/api/v1/docs/markdown?\\\"]')\\n1580:                    document.querySelectorAll(\\\".docs-navigation a\\\").length,\\n1594:              `${apiOrigin}/api/v1/docs/markdown?path=${encodeURIComponent(expected.path)}`\\n1614:                website.getWorker(`taxkit-website-docs-${mode}`)\\n1632:        yield* Queue.clear(docsCalls);\\n1633:        yield* Queue.clear(docsDocuments);\\n1635:          docsPage\\n1636:            .locator('.docs-navigation a[href=\\\"/sdk/typescript-sdk\\\"]')\\n1640:          docsPage\\n1646:            docsPage\\n1647:              .locator(\\\".docs-article h1\\\")\\n1653:            docsPage\\n1654:              .locator('.docs-navigation [aria-current=\\\"page\\\"]')\\n1658:        expect(yield* Queue.clear(docsCalls)).toContain(nativeDocsAddress);\\n1659:        expect(yield* Queue.clear(docsDocuments)).toEqual([]);\\n1661:          docsPage\\n1662:            .locator('.docs-article a[href=\\\"/sdk/plain-sdk\\\"]')\\n1667:          docsPage\\n1671:        expect(yield* Queue.clear(docsCalls)).toContain(nativeDocsAddress);\\n1672:        expect(yield* Queue.clear(docsDocuments)).toEqual([]);\\n1674:          docsPage\\n1675:            .locator('.docs-navigation a[href=\\\"/start/quickstart\\\"]')\\n1679:          docsPage\\n1684:          docsPage.evaluate(() => window.scrollTo(0, 0))\\n1687:          docsPage.screenshot({\\n1689:            path: path.join(screenshotRoot, \\\"docs-desktop.png\\\"),\\n1693:          docsPage.setViewportSize({ height: 844, width: 390 })\\n1697:            docsPage.evaluate(\\n1703:          docsPage.locator(\\\".docs-navigation-panel summary\\\").focus()\\n1705:        yield* Effect.promise(() => docsPage.keyboard.press(\\\"Enter\\\"));\\n1708:            docsPage.locator(\\\".docs-navigation-panel\\\").getAttribute(\\\"open\\\")\\n1712:          docsPage.evaluate(() => window.scrollTo(0, 0))\\n1715:          docsPage.screenshot({\\n1717:            path: path.join(screenshotRoot, \\\"docs-mobile.png\\\"),\\n1725:            plainPage.locator(\\\".docs-article h1\\\").textContent()\\n1730:            .locator('.docs-navigation a[href=\\\"/sdk/typescript-sdk\\\"]')\\n1735:            plainPage.locator(\\\".docs-article h1\\\").textContent()\\n1739:          docsPage.goto(`${websiteOrigin}/contributing/what-are-you-changing`)\\n1741:        yield* Effect.promise(() => docsPage.waitForLoadState(\\\"networkidle\\\"));\\n1743:          docsPage.locator(\\\".docs-navigation-panel summary\\\").click()\\n1747:            docsPage.evaluate(\\n1754:            docsPage.locator(\\\".docs-article svg\\\").count()\\n1759:            docsPage\\n1765:          docsPage\\n1772:            docsPage\\n1778:        yield* Effect.promise(() => docsPage.keyboard.press(\\\"ArrowRight\\\"));\\n1780:          docsPage.evaluate(() => window.scrollTo(0, 0))\\n1783:          docsPage.screenshot({\\n1785:            path: path.join(screenshotRoot, \\\"docs-diagram-mobile.png\\\"),\\n1789:          docsPage.setViewportSize({ height: 900, width: 1440 })\\n1792:          docsPage.locator(\\\".docs-navigation-panel summary\\\").click()\\n1795:          docsPage.evaluate(() => window.scrollTo(0, 0))\\n1798:          docsPage.screenshot({\\n1800:            path: path.join(screenshotRoot, \\\"docs-diagram-desktop.png\\\"),\\n1804:          docsPage.goto(`${websiteOrigin}/start/quickstart`)\\n1806:        yield* Effect.promise(() => docsPage.waitForLoadState(\\\"networkidle\\\"));\\n1808:          docsPage.route(\\n1820:          docsPage\\n1821:            .locator('.docs-navigation a[href=\\\"/sdk/typescript-sdk\\\"]')\\n1825:          docsPage\\n1833:          yield* Effect.promise(() => docsPage.locator(\\\"body\\\").textContent())\\n1836:          docsPage\\n1841:          docsPage\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","create_time":1791306080.581369}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
