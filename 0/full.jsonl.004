native-pair: + | Surface                  | Compatibility evidence                                            |\nweb test:native-pair: + | ------------------------ | ----------------------------------------------------------------- |\nweb test:native-pair: + | Calculator request facts | schema decode tests, OpenAPI evidence and SDK type tests          |\nweb test:native-pair: + | Calculator reports       | golden tests, API compatibility tests and SDK compatibility tests |\nweb test:native-pair: + | Expected errors          | \\`CalculatorServiceError\\` tests and HTTP status envelope tests     |\nweb test:native-pair: + | HTTP endpoints           | route tests and generated OpenAPI review                          |\nweb test:native-pair: + | SDK helpers              | type tests, packed artifact checks and browser-safe import checks |\nweb test:native-pair: + | Tax-year metadata        | API metadata tests and SDK descriptor tests                       |\nweb test:native-pair: +\nweb test:native-pair: + Breaking changes need an explicit release-impact note and a Changeset when\nweb test:native-pair: + package-facing behaviour changes.\nweb test:native-pair: +\nweb test:native-pair: + ## HTTP and SDK rule [#http-and-sdk-rule]\nweb test:native-pair: +\nweb test:native-pair: + HTTP and SDK layers adapt public callers to the calculator boundary. They must\nweb test:native-pair: + not hide tax business logic or make incompatible tax results look compatible.\nweb test:native-pair: + If tax behaviour changes, update the owning fact, rule, parameter, calculator\nweb test:native-pair: + or service package and then prove the public layer still reflects that owner.\nweb test:native-pair: +\nweb test:native-pair: + ## Review notes [#review-notes]\nweb test:native-pair: +\nweb test:native-pair: + Your PR should state:\nweb test:native-pair: +\nweb test:native-pair: + * whether request or response schemas changed\nweb test:native-pair: + * whether public SDK helper input or output types changed\nweb test:native-pair: + * whether generated OpenAPI output changed\nweb test:native-pair: + * whether existing calculator IDs, jurisdictions or tax years still work\nweb test:native-pair: + * whether the change needs a Changeset\nweb test:native-pair: +\nweb test:native-pair: + Read [API and SDK](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/api-and-sdk.md) before\nweb test:native-pair: + changing transport or SDK contracts.\nweb test:native-pair: + `,i={contents:[{heading:`backward-compatibility`,content:`Use this page before you change facts, calculator inputs, report fields,\nweb test:native-pair: + errors, HTTP routes, SDK helpers or exported schema names.`},{heading:`public-contract-surfaces`,content:`Surface`},{heading:`public-contract-surfaces`,content:`Compatibility evidence`},{heading:`public-contract-surfaces`,content:`Calculator request facts`},{heading:`public-contract-surfaces`,content:`schema decode tests, OpenAPI evidence and SDK type tests`},{heading:`public-contract-surfaces`,content:`Calculator reports`},{heading:`public-contract-surfaces`,content:`golden tests, API compatibility tests and SDK compatibility tests`},{heading:`public-contract-surfaces`,content:`Expected errors`},{heading:`public-contract-surfaces`,content:\"`CalculatorServiceError` tests and HTTP status envelope tests\"},{heading:`public-contract-surfaces`,content:`HTTP endpoints`},{heading:`public-contract-surfaces`,content:`route tests and generated OpenAPI review`},{heading:`public-contract-surfaces`,content:`SDK helpers`},{heading:`public-contract-surfaces`,content:`type tests, packed artifact checks and browser-safe import checks`},{heading:`public-contract-surfaces`,content:`Tax-year metadata`},{heading:`public-contract-surfaces`,content:`API metadata tests and SDK descriptor tests`},{heading:`public-contract-surfaces`,content:`Breaking changes need an explicit release-impact note and a Changeset when\nweb test:native-pair: + package-facing behaviour changes.`},{heading:`http-and-sdk-rule`,content:`HTTP and SDK layers adapt public callers to the calculator boundary. They must\nweb test:native-pair: + not hide tax business logic or make incompatible tax results look compatible.\nweb test:native-pair: + If tax behaviour changes, update the owning fact, rule, parameter, calculator\nweb test:native-pair: + or service package and then prove the public layer still reflects that owner.`},{heading:`review-notes`,content:`Your PR should state:`},{heading:`review-notes`,content:`whether request or response schemas changed`},{heading:`review-notes`,content:`whether public SDK helper input or output types changed`},{heading:`review-notes`,content:`whether generated OpenAPI output changed`},{heading:`review-notes`,content:`whether existing calculator IDs, jurisdictions or tax years still work`},{heading:`review-notes`,content:`whether the change needs a Changeset`},{heading:`review-notes`,content:`Read API and SDK before\nweb test:native-pair: + changing transport or SDK contracts.`}],headings:[{id:`backward-compatibility`,content:`Backward compatibility`},{id:`public-contract-surfaces`,content:`Public contract surfaces`},{id:`http-and-sdk-rule`,content:`HTTP and SDK rule`},{id:`review-notes`,content:`Review notes`}]},a=[{depth:1,url:`#backward-compatibility`,title:(0,t.jsx)(t.Fragment,{children:`Backward compatibility`})},{depth:2,url:`#public-contract-surfaces`,title:(0,t.jsx)(t.Fragment,{children:`Public contract surfaces`})},{depth:2,url:`#http-and-sdk-rule`,title:(0,t.jsx)(t.Fragment,{children:`HTTP and SDK rule`})},{depth:2,url:`#review-notes`,title:(0,t.jsx)(t.Fragment,{children:`Review notes`})}];function o(e){let n={a:`a`,code:`code`,h1:`h1`,h2:`h2`,li:`li`,p:`p`,table:`table`,tbody:`tbody`,td:`td`,th:`th`,thead:`thead`,tr:`tr`,ul:`ul`,...e.components};return(0,t.jsxs)(t.Fragment,{children:[(0,t.jsx)(n.h1,{id:`backward-compatibility`,children:`Backward compatibility`}),`\