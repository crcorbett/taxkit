Gi as na,N as ni,Qp as nn,Ge as no,Bp as nr,YS as nt,gE as o,qi as oa,ad as oi,rm as on,Ie as oo,Cp as or,jS as ot,GT as p,A as pa,Vo as pi,Hm as pn,pe as po,ip as pr,AS as pt,Ow as q,x as qa,wa as qi,gm as qn,Hl as qr,cm as qt,uE as r,Ki as ra,Uc as ri,z as rn,Ue as ro,em as rr,U as rt,pE as s,Bi as sa,F as si,$m as sn,Ne as so,Tp as sr,wS as st,xE as t,Zi as ta,Uu as ti,bm as tn,qe as to,_m as tr,vC as tt,oE as u,Hi as ua,hs as ui,Lm as un,ke as uo,Ap as ur,G as ut,qT as v,Wr as va,fo as vi,eh as vn,he as vo,np as vr,Y as vt,OT as w,Qn as wa,uo as wi,km as wn,de as wo,Hf as wr,lS as wt,XT as x,O as xa,io as xi,pm as xn,f as xo,Vf as xr,dS as xt,VT as y,Ur as ya,go as yi,Rm as yn,ie as yo,Qf as yr,IS as yt,_T as z,Qt as za,Ua as zi,Tm as zn,Pf as zr,s_ as zt};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Install the SDK shape and run one Australian income tax calculation.`,status:`published`,title:`Quickstart`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # Quickstart [#quickstart]\nweb test:native-pair: +\nweb test:native-pair: + Run one Australian annual income tax calculation with the plain TypeScript SDK.\nweb test:native-pair: + This is the recommended first path for TypeScript applications.\nweb test:native-pair: +\nweb test:native-pair: + ## Before you start [#before-you-start]\nweb test:native-pair: +\nweb test:native-pair: + You need a TypeScript runtime that can import ESM packages. The SDK package is\nweb test:native-pair: + private until release approval, so run this from the TaxKit workspace for now.\nweb test:native-pair: +\nweb test:native-pair: + ## Install [#install]\nweb test:native-pair: +\nweb test:native-pair: + The intended public install shape is:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`sh\nweb test:native-pair: + bun add @taxkit/sdk @taxkit/core\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + Inside this repository, the workspace provides those packages already.\nweb test:native-pair: +\nweb test:native-pair: + ## Run a calculation [#run-a-calculation]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const report = await au.incomeTax.annual({\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + console.log(report.liability.cents);\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + \\`aud(Cents.make(9_000_000))\\` represents AUD 90,000.00 as integer cents. The calculator\nweb test:native-pair: + returns a typed annual income tax report.\nweb test:native-pair: +\nweb test:native-pair: + ## Expected result [#expected-result]\nweb test:native-pair: +\nweb test:native-pair: + The report includes money values, ledger entries and calculator-specific\nweb test:native-pair: + fields. Access fields directly from the typed report:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + console.log(report.liability.currency);\nweb test:native-pair: + console.log(report.rawLiability.cents);\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Handle errors [#handle-errors]\nweb test:native-pair: +\nweb test:native-pair: + Use the safe facade when you want a typed result instead of a rejected Promise:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { TaxKit } from \"@taxkit/sdk\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const result = await TaxKit.safe.calculate(au.calculations.annualIncomeTax, {\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + if (result._tag === \"TaxKitSuccess\") {\nweb test:native-pair: +   console.log(result.value.liability.cents);\nweb test:native-pair: + }\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Next steps [#next-steps]\nweb test:native-pair: +\nweb test:native-pair: + * Use [Run your first calculation](/start/run-your-first-calculation) for a\nweb test:native-pair: +   fuller copyable script.\nweb test:native-pair: + * Compare surfaces in [Choose SDK or HTTP API](/start/choose-sdk-or-api).\nweb test:native-pair: + * Read [Type safety](/sdk/type-safety) before accepting user input.\nweb test:native-pair: + `,i={contents:[{heading:`quickstart`,content:`Run one Australian annual income tax calculation with the plain TypeScript SDK.\nweb test:native-pair: + This is the recommended first path for TypeScript applications.`},{heading:`before-you-start`,content:`You need a TypeScript runtime that can import ESM packages. The SDK package is\nweb test:native-pair: + private until release approval, so run this from the TaxKit workspace for now.`},{heading:`install`,content:`The intended public install shape is:`},{heading:`install`,content:`Inside this repository, the workspace provides those packages already.`},{heading:`run-a-calculation`,content:\"`aud(Cents.make(9_000_000))` represents AUD 90,000.00 as integer cents. The calculator\\nreturns a typed annual income tax report.\"},{heading:`expected-result`,content:`The report includes money values, ledger entries and calculator-specific\nweb test:native-pair: + fields. Access fields directly from the typed report:`},{heading:`handle-errors`,content:`Use the safe facade when you want a typed result instead of a rejected Promise:`},{heading:`next-steps`,content:`Use Run your first calculation for a\nweb test:native-pair: + fuller copyable script.`},{heading:`next-steps`,content:`Compare surfaces in Choose SDK or HTTP API.`},{heading:`next-steps`,content:`Read Type safety before accepting user input.`}],headings:[{id:`quickstart`,content:`Quickstart`},{id:`before-you-start`,content:`Before you start`},{id:`install`,content:`Install`},{id:`run-a-calculation`,content:`Run a calculation`},{id:`expected-result`,content:`Expected result`},{id:`handle-errors`,content:`Handle errors`},{id:`next-steps`,content:`Next steps`}]},a=[{depth:1,url:`#quickstart`,title:(0,t.jsx)(t.Fragment,{children:`Quickstart`})},{depth:2,url:`#before-you-start`,title:(0,t.jsx)(t.Fragment,{children:`Before you start`})},{depth:2,url:`#install`,title:(0,t.jsx)(t.Fragment,{children:`Install`})},{depth:2,url:`#run-a-calculation`,title:(0,t.jsx)(t.Fragment,{children:`Run a calculation`})},{depth:2,url:`#expected-result`,title:(0,t.jsx)(t.Fragment,{children:`Expected result`})},{depth:2,url:`#handle-errors`,title:(0,t.jsx)(t.Fragment,{children:`Handle errors`})},{depth:2,url:`#next-steps`,title:(0,t.jsx)(t.Fragment,{children:`Next steps`})}];function o(e){let n={a:`a`,code:`code`,h1:`h1`,h2:`h2`,li:`li`,p:`p`,pre:`pre`,span:`span`,ul:`ul`,...e.components};return(0,t.jsxs)(t.Fragment,{children:[(0,t.jsx)(n.h1,{id:`quickstart`,children:`Quickstart`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`Run one Australian annual income tax calculation with the plain TypeScript SDK.\nweb test:native-pair: + This is the recommended first path for TypeScript applications.`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`before-you-start`,children:`Before you start`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`You need a TypeScript runtime that can import ESM packages. The SDK package is\nweb test:native-pair: + private until release approval, so run this from the TaxKit workspace for now.`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`install`,children:`Install`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`The intended public inst