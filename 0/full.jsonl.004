ses.`]}),`\nweb test:native-pair: + `]})]})}function s(e={}){let{wrapper:n}=e.components||{};return n?(0,t.jsx)(n,{...e,children:(0,t.jsx)(o,{...e})}):o(e)}export{r as _markdown,s as default,n as frontmatter,i as structuredData,a as toc};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Return typed success or failure values from SDK calculations.`,status:`published`,title:`Safe SDK`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # Safe SDK [#safe-sdk]\nweb test:native-pair: +\nweb test:native-pair: + Use the safe SDK when expected failures should be returned as values instead of\nweb test:native-pair: + rejected Promises.\nweb test:native-pair: +\nweb test:native-pair: + ## Call \\`TaxKit.safe.calculate\\` [#call-taxkitsafecalculate]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { TaxKit } from \"@taxkit/sdk\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const result = await TaxKit.safe.calculate(au.calculations.annualIncomeTax, {\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + if (result._tag === \"TaxKitSuccess\") {\nweb test:native-pair: +   console.log(result.value.liability.cents);\nweb test:native-pair: + }\nweb test:native-pair: +\nweb test:native-pair: + if (result._tag === \"TaxKitFailure\") {\nweb test:native-pair: +   console.error(result.error._tag);\nweb test:native-pair: + }\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + The result is either \\`TaxKitSuccess\\` with the calculator report or\nweb test:native-pair: + \\`TaxKitFailure\\` with an SDK-owned error value.\nweb test:native-pair: +\nweb test:native-pair: + ## Call AU safe helpers [#call-au-safe-helpers]\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const result = await au.incomeTax.safe.annual({\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## When to use it [#when-to-use-it]\nweb test:native-pair: +\nweb test:native-pair: + Use the safe facade when your application already models expected failures as\nweb test:native-pair: + data, or when you want to handle schema decode errors in the same branch as\nweb test:native-pair: + calculation failures. A client that has been closed returns \\`TaxKitFailure\\` with\nweb test:native-pair: + \\`TaxKitClientDisposedError\\` in \\`result.error.error\\`. Await \\`client.dispose()\\` when\nweb test:native-pair: + finished; the [Plain SDK](/sdk/plain-sdk) shows a \\`try\\`/\\`finally\\` example.\nweb test:native-pair: +\nweb test:native-pair: + Use \\`TaxKit.calculate\\` when rejected Promises fit your existing control flow.\nweb test:native-pair: +\nweb test:native-pair: + ## Related pages [#related-pages]\nweb test:native-pair: +\nweb test:native-pair: + * [Plain SDK](/sdk/plain-sdk)\nweb test:native-pair: + * [Schemas](/sdk/schemas)\nweb test:native-pair: + * [Type safety](/sdk/type-safety)\nweb test:native-pair: + `,i={contents:[{heading:`safe-sdk`,content:`Use the safe SDK when expected failures should be returned as values instead of\nweb test:native-pair: + rejected Promises.`},{heading:`call-taxkitsafecalculate`,content:\"The result is either `TaxKitSuccess` with the calculator report or\\n`TaxKitFailure` with an SDK-owned error value.\"},{heading:`when-to-use-it`,content:\"Use the safe facade when your application already models expected failures as\\ndata, or when you want to handle schema decode errors in the same branch as\\ncalculation failures. A client that has been closed returns `TaxKitFailure` with\\n`TaxKitClientDisposedError` in `result.error.error`. Await `client.dispose()` when\\nfinished; the Plain SDK shows a `try`/`finally` example.\"},{heading:`when-to-use-it`,content:\"Use `TaxKit.calculate` when rejected Promises fit your existing control flow.\"},{heading:`related-pages`,content:`Plain SDK`},{heading:`related-pages`,content:`Schemas`},{heading:`related-pages`,content:`Type safety`}],headings:[{id:`safe-sdk`,content:`Safe SDK`},{id:`call-taxkitsafecalculate`,content:\"Call `TaxKit.safe.calculate`\"},{id:`call-au-safe-helpers`,content:`Call AU safe helpers`},{id:`when-to-use-it`,content:`When to use it`},{id:`related-pages`,content:`Related pages`}]},a=[{depth:1,url:`#safe-sdk`,title:(0,t.jsx)(t.Fragment,{children:`Safe SDK`})},{depth:2,url:`#call-taxkitsafecalculate`,title:(0,t.jsxs)(t.Fragment,{children:[`Call `,(0,t.jsx)(`code`,{children:`TaxKit.safe.calculate`})]})},{depth:2,url:`#call-au-safe-helpers`,title:(0,t.jsx)(t.Fragment,{children:`Call AU safe helpers`})},{depth:2,url:`#when-to-use-it`,title:(0,t.jsx)(t.Fragment,{children:`When to use it`})},{depth:2,url:`#related-pages`,title:(0,t.jsx)(t.Fragment,{children:`Related pages`})}];function o(e){let n={a:`a`,code:`code`,h1:`h1`,h2:`h2`,li:`li`,p:`p`,pre:`pre`,span:`span`,ul:`ul`,...e.components};return(0,t.jsxs)(t.Fragment,{children:[(0,t.jsx)(n.h1,{id:`safe-sdk`,children:`Safe SDK`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`Use the safe SDK when expected failures should be returned as values instead of\nweb test:native-pair: + rejected Promises.`}),`\nweb test:native-pair: + `,(0,t.jsxs)(n.h2,{id:`call-taxkitsafecalculate`,children:[`Call `,(0,t.jsx)(n.code,{children:`TaxKit.safe.calculate`})]}),`\nweb test:native-pair: + `,(0,t.jsx)(t.Fragment,{children:(0,t.jsx)(n.pre,{className:`shiki shiki-themes github-dark github-light`,style:{\"--shiki-dark\":