`,\"--shiki-light\":`#032F62`},children:` verification`})]})})})}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`source-of-truth`,children:`Source of truth`}),`\nweb test:native-pair: + `,(0,t.jsxs)(n.p,{children:[`For the full quality model, read\nweb test:native-pair: + `,(0,t.jsx)(n.a,{href:`https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/testing-and-quality.md`,children:`Testing and quality`}),`\nweb test:native-pair: + and\nweb test:native-pair: + `,(0,t.jsx)(n.a,{href:`https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/testing-and-validation.md`,children:`Testing and validation`}),`.`]})]})}function s(e={}){let{wrapper:n}=e.components||{};return n?(0,t.jsx)(n,{...e,children:(0,t.jsx)(o,{...e})}):o(e)}export{r as _markdown,s as default,n as frontmatter,i as structuredData,a as toc};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Understand descriptor typing, branded values and runtime schema decoding.`,status:`published`,title:`Type safety`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # Type safety [#type-safety]\nweb test:native-pair: +\nweb test:native-pair: + TaxKit uses TypeScript types and runtime schemas together. TypeScript checks\nweb test:native-pair: + the calculator descriptor and facts you pass at compile time. Runtime schema\nweb test:native-pair: + decoding still validates untrusted values before calculation.\nweb test:native-pair: +\nweb test:native-pair: + ## Compile-time calculator inputs [#compile-time-calculator-inputs]\nweb test:native-pair: +\nweb test:native-pair: + The selected descriptor controls the accepted facts and the returned report:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { TaxKit } from \"@taxkit/sdk\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + const report = await TaxKit.calculate(au.calculations.annualIncomeTax, {\nweb test:native-pair: +   taxableIncome: aud(Cents.make(9_000_000)),\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + report.liability.cents;\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + If you pass facts for another calculator, the call should fail type checking:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { TaxKit } from \"@taxkit/sdk\";\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: +\nweb test:native-pair: + await TaxKit.calculate(au.calculations.annualIncomeTax, {\nweb test:native-pair: +   grossPay: aud(Cents.make(165_400)),\nweb test:native-pair: +   taxFreeThresholdClaimed: true,\nweb test:native-pair: + });\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Branded values [#branded-values]\nweb test:native-pair: +\nweb test:native-pair: + Money values use canonical branded constructors from \\`@taxkit/core\\`:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { Cents, aud } from \"@taxkit/core/primitives\";\nweb test:native-pair: +\nweb test:native-pair: + const taxableIncome = aud(Cents.make(9_000_000));\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + Use \\`Cents.make\\` for known constants and \\`aud\\` for cents you have already\nweb test:native-pair: + checked. Use the fallible \\`audFromCents\\` helper when a number still needs\nweb test:native-pair: + checking. See [Money and branded values](/concepts/money-and-branded-values)\nweb test:native-pair: + for checked arithmetic and error handling.\nweb test:native-pair: +\nweb test:native-pair: + ## Runtime schema decoding [#runtime-schema-decoding]\nweb test:native-pair: +\nweb test:native-pair: + Compile-time checks protect code you compile. Runtime schema decoding protects\nweb test:native-pair: + values that come from users, forms, JSON or other services.\nweb test:native-pair: +\nweb test:native-pair: + Decode external JSON with the selected calculator's input schema before\nweb test:native-pair: + calling the typed SDK. In this example, annual tax facts fail the pay\nweb test:native-pair: + calculator's schema check; the valid weekly pay input reaches calculation.\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import { au } from \"@taxkit/sdk/au\";\nweb test:native-pair: + import { Effect, Schema } from \"effect\";\nweb test:native-pair: +\nweb test:native-pair: + // Check an external JSON representation before calling a typed calculator.\nweb test:native-pair: + export const invalidInput = Schema.decodeEffect(\nweb test:native-pair: +   Schema.fromJsonString(au.calculations.takeHomePay.inputSchema)\nweb test:native-pair: + )('{\"taxableIncome\":{\"_tag\":\"Money\",\"cents\":9000000,\"currency\":\"AUD\"}}');\nweb test:native-pair: +\nweb test:native-pair: + export const validInput = Schema.decodeEffect(\nweb test:native-pair: +   Schema.fromJsonString(au.calculations.takeHomePay.inputSchema)\nweb test:native-pair: + )(\nweb test:native-pair: +   '{\"grossPay\":{\"_tag\":\"GrossPay\",\"amount\":{\"_tag\":\"Money\",\"cents\":165400,\"currency\":\"AUD\"},\"period\":\"weekly\"},\"taxFreeThresholdClaimed\":true}'\nweb test:native-pair: + ).pipe(\nweb test:native-pair: +   Effect.flatMap((input) => Effect.promise(() => au.pay.takeHomePay(input)))\nweb test:native-pair: + );\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + These values are Effect programs for your application's runner.\nweb test:native-pair: + \\`invalidInput\\` fails with \\`SchemaError\\` before the SDK is called. The complete\nweb test:native-pair: + example is checked in [the example source](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/packages/docs-examples/src/validate-external-input.ts).\nweb test:native-pair: + See [Handle validation errors](/guides/handle-validation-errors) for\nweb test:native-pair: + handling this error separately from calculation failures.\nweb test:native-pair: +\nweb test:native-pair: + ## Full run typing [#full-run-typing]\nweb test:native-pair: +\nweb test:native-pair: + Effect consumers can preserve the full \\`CalculatorRunResponse\\` shape while\nweb test:native-pair: + narrowing \\`report\\` to the selected descriptor output:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`ts\nweb test:native-pair: + import type { SdkCalculatorRunResponse } from \"@taxkit/sdk/effect\";\nweb test:native-pair: + import type { CalculatorRunResponse } from \"@taxkit/sdk/schemas\";\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + \\`SdkCalculatorRunResponse<Report>\\` keeps the canonical response shape and\nweb test:native-pair: + narrows \\`report\\` to the decoded report type.\nweb test:native-pair: +\nweb test:native-pair: + ## Related pages [#related-pages]\nweb test:native-pair: +\nweb test:native-pair: + * [Schemas](/sdk/schemas)\nweb test:native-pair: + * [Plain SDK](/sdk/plain-sdk)\nweb test:native-pair: + * [Safe SDK](/sdk/safe-sdk)\nweb test:native-pair: + `,i={contents:[{heading:`type-safety`,content:`TaxKit uses TypeScript types and runtime schemas together. TypeScript checks\nweb test:native-pair: + the calculator descriptor and facts you pass at compile time. Runtime schema\nweb test:native-pair: + decoding still validates untrusted values before calculation.`},{heading:`compile-time-calculator-inputs`,content:`The selected descriptor controls the accepted facts and the returned report:`},{heading:`compile-time-calculator-inputs`,content:`If you pass facts for another calculator, the call should fail type checking:`},{heading:`branded-values`,content:\"Money values use canonical branded constructors from `@taxkit/core`:\"},{heading:`branded-values`,content:\"Use `Cents.make` for known constants and `aud` for cents you have already\\nchecked. Use the fallible `audFromCents` helper when a number still needs\\nchecking. See Money and branded values\\nfor checked arithmetic and error handling.\"},{heading:`runtime-schema-decoding`,content:`Compile-time checks protect code you compile. Runtime schema decoding protects\nweb test:native-pair: + values that come from users, forms, JSON or other services.`},{heading:`runtime-schema-decoding`,content:`Decode external JSON with the selected calculator's input schema before\nweb test:native-pair: + calling the typed SDK. In this example, annual tax facts fail the pay\nweb test:native-pair: + calculator's schema check; the valid weekly pay input reaches calculation.`},{heading:`runtime-schema-decoding`,content:`These values are Effect programs for your application's runner.\nweb test:native-pair: + \\`invalidInput\\` fails with \\`SchemaError\\` before the SDK is called. The complete\nweb test:native-pair: + example is checked in the example source.\nweb test:native-pair: + See Handle validation errors for\nweb test:native-pair: + handling this error separately from calculation failures.`},{heading:`full-run-typing`,content:\"Effect consumers can preserve the full `CalculatorRunResponse` shape while\\nnarrowing `report` to the selected descriptor output:\"},{heading:`full-run-typing`,content:\"`SdkCalculatorRunResponse<Report>` keeps the canonical response shape and\\nnarrows `report` to the decoded report type.\"},{heading:`related-pages`,content:`Schemas`},{heading:`related-pages`,content:`Plain SDK`},{heading:`related-pages`,content:`Safe SDK`}],headings:[{id:`type-safety`,content:`Type safety`},{id:`compile-time-calculator-inputs`,content:`Compile-time calculator inputs`},{id:`branded-val