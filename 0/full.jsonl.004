ontent/src/errors.ts                     |  10 ++\\n packages/content/src/live.layer.ts                 | 108 ++++++++++++++-\\n packages/content/src/schemas.ts                    |  45 +++++++\\n packages/content/src/service.ts                    |  11 ++\\n packages/content/src/test.layer.ts                 |  38 +++++-\\n packages/content/test/schemas.test.ts              |  67 +++++++++\\n packages/content/test/service.test.ts              | 150 ++++++++++++++++++++-\\n 41 files changed, 1111 insertions(+), 111 deletions(-)\\npackages/content/test/service.test.ts:6:  exampleDiscoverySettings,\\npackages/content/test/service.test.ts:9:import { ContentDiscoveryLive, ContentServiceLive } from \\\"../src/live.layer.js\\\";\\npackages/content/test/service.test.ts:11:  DocsDiscoveryPath,\\npackages/content/test/service.test.ts:12:  DocsDiscoverySettings,\\npackages/content/test/service.test.ts:19:  ContentDiscovery,\\npackages/content/test/service.test.ts:23:  makeContentDiscoveryTest,\\npackages/content/test/service.test.ts:29:    \\\"derives discovery from accepted pages and checked stage addresses\\\",\\npackages/content/test/service.test.ts:33:        const settings = yield* exampleDiscoverySettings;\\npackages/content/test/service.test.ts:34:        const setup = yield* makeContentDiscoveryTest(catalogue, settings);\\npackages/content/test/service.test.ts:36:          const discovery = yield* ContentDiscovery;\\npackages/content/test/service.test.ts:37:          const sitemap = yield* discovery.getDocument(\\\"/sitemap.xml\\\");\\npackages/content/test/service.test.ts:38:          assert.equal(sitemap.contentType, \\\"application/xml\\\");\\npackages/content/test/service.test.ts:40:            sitemap.body,\\npackages/content/test/service.test.ts:43:          assert.notInclude(sitemap.body, \\\"lastmod\\\");\\npackages/content/test/service.test.ts:44:          assert.notInclude(sitemap.body, \\\"/search\\\");\\npackages/content/test/service.test.ts:45:          const robots = yield* discovery.getDocument(\\\"/robots.txt\\\");\\npackages/content/test/service.test.ts:48:            \\\"Sitemap: https://website.example.com/sitemap.xml\\\"\\npackages/content/test/service.test.ts:51:          const index = yield* discovery.getDocument(\\\"/llms.txt\\\");\\npackages/content/test/service.test.ts:57:          const full = yield* discovery.getDocument(\\\"/llms-full.txt\\\");\\npackages/content/test/service.test.ts:68:          DocsDiscoveryPath.literals\\npackages/content/test/service.test.ts:78:        const settings = yield* exampleDiscoverySettings;\\npackages/content/test/service.test.ts:79:        const layer = ContentDiscoveryLive(\\npackages/content/test/service.test.ts:85:          const discovery = yield* ContentDiscovery;\\npackages/content/test/service.test.ts:88:            DocsDiscoveryPath.literals,\\npackages/content/test/service.test.ts:89:            discovery.getDocument\\npackages/content/test/service.test.ts:102:          operation: \\\"getDiscoveryDocument\\\",\\npackages/content/test/service.test.ts:104:        const result = yield* ContentDiscovery.pipe(\\npackages/content/test/service.test.ts:105:          Effect.flatMap((service) => service.getDocument(\\\"/sitemap.xml\\\")),\\npackages/content/test/service.test.ts:108:            ContentDiscoveryLive(Effect.fail(expected)).pipe(\\npackages/content/test/service.test.ts:141:        const settings = yield* Schema.decodeEffect(DocsDiscoverySettings)({\\npackages/content/test/service.test.ts:145:        const setup = yield* makeContentDiscoveryTest(catalogue, settings);\\npackages/content/test/service.test.ts:146:        const index = yield* ContentDiscovery.pipe(\\npackages/content/test/service.test.ts:147:          Effect.flatMap((service) => service.getDocument(\\\"/llms.txt\\\")),\\napps/web/test/native-pair.boundary.test.ts:21:  DocsDiscoveryPath,\\napps/web/test/native-pair.boundary.test.ts:312:        const discoveryDocuments = yield* Effect.gen(function* () {\\napps/web/test/native-pair.boundary.test.ts:331:            DocsDiscoveryPath.literals,\\napps/web/test/native-pair.boundary.test.ts:332:            client.getDiscovery\\napps/web/test/native-pair.boundary.test.ts:341:        const unavailableDiscoveryWorker = yield* Effect.promise(() =>\\napps/web/test/native-pair.boundary.test.ts:344:        yield* Effect.forEach(discoveryDocuments, (document) =>\\napps/web/test/native-pair.boundary.test.ts:389:              unavailableDiscoveryWorker.fetch(\\napps/web/test/native-pair.boundary.test.ts:398:        const discoverySitemap = yield* Array.findFirst(\\napps/web/test/native-pair.boundary.test.ts:399:          discoveryDocuments,\\napps/web/test/native-pair.boundary.test.ts:400:          (document) => document.path === \\\"/sitemap.xml\\\"\\napps/web/test/native-pair.boundary.test.ts:402:        const discoveryIndex = yield* Array.findFirst(\\napps/web/test/native-pair.boundary.test.ts:403:          discoveryDocuments,\\napps/web/test/native-pair.boundary.test.ts:404:          (document) => document.path === \\\"/llms.txt\\\"\\napps/web/test/native-pair.boundary.test.ts:406:        const discoveryFull = yield* Array.findFirst(\\napps/web/test/native-pair.boundary.test.ts:407:          discoveryDocuments,\\napps/web/test/native-pair.boundary.test.ts:408:          (document) => document.path === \\\"/llms-full.txt\\\"\\napps/web/test/native-pair.boundary.test.ts:410:        expect(discoverySitemap.body).not.toContain(\\\"lastmod\\\");\\napps/web/test/native-pair.boundary.test.ts:411:        expect(discoverySitemap.body).not.toContain(\\\"/search\\\");\\napps/web/test/native-pair.boundary.test.ts:412:        expect(discoveryIndex.body).not.toContain(\\\".mdx\\\");\\napps/web/test/native-pair.boundary.test.ts:417:            expect(discoverySitemap.body).toContain(\\napps/web/test/native-pair.boundary.test.ts:420:            expect(discoveryIndex.body).toContain(\\napps/web/test/native-pair.boundary.test.ts:423:            expect(discoveryFull.body).toContain(\\napps/web/test/native-pair.boundary.test.ts:1619:          }, discoverySitemap.body)\\napps/web/test/native-pair.boundary.test.ts:1623:          \\\"http://www.sitemaps.org/schemas/sitemap/0.9\\\"\\n---\\n\\\"@taxkit/content\\\": major\\n\\\"@taxkit/api-rpc\\\": major\\n---\\n\\nAdd checked discovery documents derived from the accepted documentation catalogue\\nand the configured Website/API addresses. Native documentation calls now require\\nrevision 2 and gain the closed discovery operation and fixed unavailable error.\\nAPI and Website origins reuse one checked public-address policy with\\nseparate identities. No calculator request or retained answer changes.\\n# TaxKit documentation profile\\n\\nRead this profile after `AGENTS.md` and `docs/README.md`. Paths and commands\\nbelow are repository-local; resolve the checkout with `git rev-parse --show-toplevel`.\\n\\n## Owner map\\n\\n| Change class                                        | Earliest owner and required pointers                                                                                                                                                                                                                                                                                            |\\n| --------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\\n| Maintainer lifecycle, truth layers, archive routing | `docs/README.md`; architecture, standards, audit and active intent only when affected                                                                                                                                                                                                                                           |\\n| Calculator rules, facts and schemas                 | owning `packages/calculators` or `packages/rules/**` source/README; relevant `docs/architecture/**`, SDK/API/public docs only when consumers change                                                                                                                                                                             |\\n| SDK exports and examples                            | `packages/sdk/typescript` source/export map and README; packed-consumer/downstream proof; `docs/architecture/api-and-sdk.md`                                                                                                                                                                                                    |\\n| HTTP/OpenAPI                                        | `packages/api/http/src/**` schemas and `src/openapi.ts`; generated snapshot `packages/api/http/__snapshots__/openapi.json` through `test:openapi`; `packages/api/http/README.md`, `apps/api/README.md`, and API/SDK architecture only when their contracts change                                                               |\\n| Public MDX/navigation/lifecycle                     | `packages/docs-content/content/**`, `packages/docs-content/navigation.json`, and `tools/documentation/owner-policy.json`; `published` requires one exact `public.statusDecision.acceptanceRecords` binding to a strict addressable record, with the durable lifecycle decision routed from `docs/documentation-audit/hgi-207/public-mdx-lifecycle.json` |\\n| Public docs runtime/generated Fumadocs              | `apps/docs/README.md`, `packages/docs-content/source.config.ts`, `packages/docs-content/.source`, and `packages/docs-fumadocs`; regenerate/check through the owning commands and never hand-edit generated output                                                                                                               |\\n| Package/app roots                                   | owning package/app README, package ownership architecture, root routes only when discoverability changes                                                                                                                                                                                                                        |\\n| Commands, CI, versioning and release readiness      | `package.json`, workflow/command owner, `docs/standards/versioning.md`, `docs/runbooks/README.md`, testing-quality architecture and proof owner                                                                                                                                                                                 |\\n| Runbooks, authority, proof and history              | exactly five target-owned procedures routed by `docs/runbooks/README.md`; `docs/operations/authority-model.md`; `tools/documentation/runbook-contract.json`; sanitized `docs/evidence/releases/**`, `docs/evidence/deployments/**`, or dated `docs/documentation-audit/**`; preserve provenance and non-claims                             |\\n| PRD and implementation                              | target SPEC, sibling tasks and active plan; local `prd-writer`, `prd-review`, `prd-implementer` invoke this skill                                                                                                                                                                                                               |\\n\\nPublic `published` needs an exact accepted record and one-to-one binding in\\n`tools/documentation/owner-policy.json`; its `targetPath` must equal the public\\npath. Navigation remains independently draft unless it receives its own exact\\nrecord and binding.\\nGenerated source is authoritative over checked output. Repository evidence is\\nnot provider, registry, deployment, public-site or consumer proof.\\n\\n## Commands and boundaries\\n\\n- Baseline documentation/path/skill checks: `bun run test:skills`, `bun run\\ncheck:docs`, `bun run check:runbooks`, `bun run check:repository-paths`.\\n- Harness foundation checks: `bun run check:harness-governance:types`, `bun run\\n  test:harness-governance`, and `bun run check:harness-governance`. The runtime\\n  gate reads only repository-local profile, audit, receipt, skill, link, and\\n  critical-journey owners.\\n- Full local closeout: `bun run verification` and `git diff --check`.\\n- Public content/runtime: `bun run docs:validate`, `bun run docs:build`,\\n  `bun run --filter=docs test:browser` when applicable.\\n- SDK package boundary: `bun run --filter=@taxkit/sdk check-packed-artifact`\\n  and `bun run --filter=@taxkit/sdk validate:downstream` when applicable.\\n- Release evidence: `bun run release:check` is local proof only; versioning,\\n  publication and deployment remain separately authorized operations.\\n- Runbook contract: `bun run check:runbooks` is inspect-only and writes the\\n  bounded ignored `tmp/runbook-validation-report.json`; it never runs a\\n  documented procedure or establishes external state.\\n\\nFor each check, state its observable postcondition and what it does not prove.\\nKeep background freshness reports as candidates until an attached implementation\\nauthority, responsible reviewer and separately named publisher accept them.\\n\\n## Clean-slate compatibility and implementation\\n\\nThe local root manifest and lockfile select stable Effect 4.0.0 and TypeScript\\n7.0.2. Canonical skill templates may retain their upstream rc.117 qualification;\\nthat reference snapshot does not downgrade TaxKit or prove an app/provider\\nmigration. Check installed exports and the active clean-slate plan before use.\\n\\nThe complete local skill collection is pinned by\\n`tools/skills/canonical-skill-baseline.json` to Commonplace development-workflows\\n0.6.1. It includes `linear`, `strict-effect-ts` and `alchemy-iac`, with relative\\nClaude links. Use the Linear skill for tracked task status/evidence. The active\\n`docs/exec-plans/active/clean-slate-foundation.md` distinguishes skill adoption, strict enforcement and Atom integration from\\nlater application work. Use its task receipts for current acceptance; the\\nupstream skill receipt alone does not prove runtime behaviour.\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","create_time":1791312082.083451}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
