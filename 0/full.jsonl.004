r: + `,(0,t.jsx)(n.li,{children:(0,t.jsx)(n.a,{href:`/concepts/diagnostics`,children:`Diagnostics`})}),`\nweb test:native-pair: + `]})]})}function s(e={}){let{wrapper:n}=e.components||{};return n?(0,t.jsx)(n,{...e,children:(0,t.jsx)(o,{...e})}):o(e)}export{r as _markdown,s as default,n as frontmatter,i as structuredData,a as toc};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Choose the required tests for facts, rules, calculators, tax years and public contracts.`,status:`published`,title:`Testing standards`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # Testing standards [#testing-standards]\nweb test:native-pair: +\nweb test:native-pair: + Use this page when you need to decide which tests and validation evidence a\nweb test:native-pair: + tax behaviour change needs.\nweb test:native-pair: +\nweb test:native-pair: + ## Required evidence by change [#required-evidence-by-change]\nweb test:native-pair: +\nweb test:native-pair: + | Change           | Required evidence                                                                                        |\nweb test:native-pair: + | ---------------- | -------------------------------------------------------------------------------------------------------- |\nweb test:native-pair: + | Fact             | schema decode tests, graph validation, type tests if public input types change                           |\nweb test:native-pair: + | Rule             | source reference validation, graph checks, golden tests, trace snapshots when rule IDs or ledgers change |\nweb test:native-pair: + | Calculator       | schema tests, golden tests, graph validation, API compatibility tests and SDK compatibility tests        |\nweb test:native-pair: + | Tax year         | parameter schema validation, effective-date checks, golden tests, API metadata tests and SDK type tests  |\nweb test:native-pair: + | Incorrect result | failing regression first, source citation, passing golden test and compatibility notes                   |\nweb test:native-pair: +\nweb test:native-pair: + ## Test types [#test-types]\nweb test:native-pair: +\nweb test:native-pair: + Golden tests should use official examples or reviewed scenarios and live with\nweb test:native-pair: + the rule package they validate.\nweb test:native-pair: +\nweb test:native-pair: + Type tests should prove public SDK descriptors reject unsupported facts,\nweb test:native-pair: + calculator IDs, jurisdictions and tax years at compile time.\nweb test:native-pair: +\nweb test:native-pair: + API compatibility tests should prove \\`CalculatorRunRequest\\`,\nweb test:native-pair: + \\`CalculatorRunResponse\\` and route-owned error envelopes still match public\nweb test:native-pair: + HTTP expectations.\nweb test:native-pair: +\nweb test:native-pair: + SDK compatibility tests should prove \\`TaxKit.calculate\\`,\nweb test:native-pair: + \\`TaxKit.safe.calculate\\`, \\`calculateRunRequest\\`, \\`calculateReportRequest\\`,\nweb test:native-pair: + \\`calculateReport\\` and jurisdiction helpers still infer the expected input,\nweb test:native-pair: + report and error types.\nweb test:native-pair: +\nweb test:native-pair: + ## Commands [#commands]\nweb test:native-pair: +\nweb test:native-pair: + Use package-specific commands when your change is local:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`sh\nweb test:native-pair: + bun run --filter=@taxkit/rules-au-pay test\nweb test:native-pair: + bun run --filter=@taxkit/rules-au-income-tax test\nweb test:native-pair: + bun run --filter=@taxkit/rules-au-stsl test\nweb test:native-pair: + bun run --filter=@taxkit/calculators test\nweb test:native-pair: + bun run --filter=@taxkit/api-http test\nweb test:native-pair: + bun run --filter=@taxkit/sdk test-types\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + Before handoff, run the repository gate:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`sh\nweb test:native-pair: + bun run verification\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Source of truth [#source-of-truth]\nweb test:native-pair: +\nweb test:native-pair: + For the full quality model, read\nweb test:native-pair: + [Testing and quality](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/testing-and-quality.md)\nweb test:native-pair: + and\nweb test:native-pair: + [Testing and validation](https://github.com/crcorbett/taxkit/blob/a151e51e8a30247526fa93412df046955846eca4/docs/architecture/testing-and-validation.md).\nweb test:native-pair: + `,i={contents:[{heading:`testing-standards`,content:`Use this page when you need to decide which tests and validation evidence a\nweb test:native-pair: + tax behaviour change needs.`},{heading:`required-evidence-by-change`,content:`Change`},{heading:`required-evidence-by-change`,content:`Required evidence`},{heading:`required-evidence-by-change`,content:`Fact`},{heading:`required-evidence-by-change`,content:`schema decode tests, graph validation, type tests if public input types change`},{heading:`required-evidence-by-change`,content:`Rule`},{heading:`required-evidence-by-change`,content:`source reference validation, graph checks, golden tests, trace snapshots when rule IDs or ledgers change`},{heading:`required-evidence-by-change`,content:`Calculator`},{heading:`required-evidence-by-change`,content:`schema tests, golden tests, graph validation, API compatibility tests and SDK compatibility tests`},{heading:`required-evidence-by-change`,content:`Tax year`},{heading:`required-evidence-by-change`,content:`parameter schema validation, effective-date checks, golden tests, API metadata tests and SDK type tests`},{heading:`required-evidence-by-change`,content:`Incorrect result`},{heading:`required-evidence-by-change`,content:`failing regression first, source citation, passing golden test and compatibility notes`},{heading:`test-types`,content:`Golden tests should use official examples or reviewed scenarios and live with\nweb test:native-pair: + the rule package they validate.`},{heading:`test-types`,content:`Type tests should prove public SDK descriptors reject unsupported facts,\nweb test:native-pair: + calculator IDs, jurisdictions and tax years at compile time.`},{heading:`test-types`,content:\"API compatibility tests should prove `CalculatorRunRequest`,\\n`CalculatorRunResponse` and route-owned error envelopes still match public\\nHTTP expectations.\"},{heading:`test-types`,content:\"SDK compatibility tests should prove `TaxKit.calculate`,\\n`TaxKit.safe.calculate`, `calculateRunRequest`, `calculateReportRequest`,\\n`calculateReport` and jurisdiction helpers still infer the expected input,\\nreport and error types.\"},{heading:`commands`,content:`Use package-specific commands when your change is local:`},{heading:`commands`,content:`Before handoff, run the repository gate:`},{heading:`source-of-truth`,content:`For the full quality model, read\nweb test:native-pair: + Testing and quality\nweb test:native-pair: + and\nweb test:native-pair: + Testing and validation.`}],headings:[{id:`testing-standards`,content:`Testing standards`},{id:`required-evidence-by-change`,content:`Required evidence by change`},{id:`test-types`,content:`Test types`},{id:`commands`,content:`Commands`},{id:`source-of-truth`,content:`Source of truth`}]},a=[{depth:1,url:`#testing-standards`,title:(0,t.jsx)(t.Fragment,{children:`Testing standards`})},{depth:2,url:`#required-evidence-by-change`,title:(0,t.jsx)(t.Fragment,{children:`Required evidence by change`})},{depth:2,url:`#test-types`,title:(0,t.jsx)(t.Fragment,{children:`Test types`})},{depth:2,url:`#commands`,title:(0,t.jsx)(t.Fragment,{children:`Commands`})},{depth:2,url:`#source-of-truth`,title:(0,t.jsx)(t.Fragment,{children:`Source of truth`})}];function o(e){let n={a:`a`,code:`code`,h1:`h1`,h2:`h2`,p:`p`,pre:`pre`,span:`span`,table:`table`,tbody:`tbody`,td:`td`