ooper/.nvm/versions/node/v24.16.0/bin/node --experimental-import-meta-resolve --require /Users/cooper/.codex/worktrees/aac7/taxkit/node_modules/.bun/vitest@5.0.3+4cc7f2df5722204b/node_modules/vitest/suppress-warnings.cjs --conditions node --conditions development /Users/cooper/.codex/worktrees/aac7/taxkit/node_modules/.bun/vitest@5.0.3+4cc7f2df5722204b/node_modules/vitest/dist/workers/forks.js\n 2692       00:00 /bin/zsh -c ps -axo pid,etime,command | rg 'vitest|dev75-request|alchemy.*cli|native-pair' | head -16; sed -n '520,545p' oxlint.config.ts; rg -n 'Test Files|Tests|duration' /private/tmp/dev76-website-docs-native-k-native-test.log /private/tmp/dev76-website-docs-native-k-native.log 2>/dev/null\n 2694       00:00 rg vitest|dev75-request|alchemy.*cli|native-pair\n  ],\n  overrides: [\n    {\n      files: [\n        \"apps/docs/scripts/check-import-boundaries.runtime.ts\",\n        \"apps/api/src/config.ts\",\n        // Schema.TaggedError is a class factory, not an Error constructor.\n        \"packages/api/rpc/src/live.layer.ts\",\n        \"packages/api/rpc/src/content.live.layer.ts\",\n        \"packages/api/rpc/src/content.errors.ts\",\n        \"packages/api/rpc/src/response-budget.boundary.ts\",\n        \"packages/api/rpc/src/server-serialization.boundary.ts\",\n        \"apps/web/src/lib/config.ts\",\n        \"apps/web/src/lib/docs/errors.ts\",\n        \"apps/web/src/lib/form.boundary.ts\",\n        \"apps/api/scripts/routes.ts\",\n        \"apps/api/scripts/smoke-public-routes.runtime.ts\",\n      ],\n      rules: { \"unicorn/throw-new-error\": \"off\" },\n    },\n    {\n      files: [\n        \"packages/sdk/typescript/scripts/check-import-boundaries.runtime.ts\",\n        \"packages/sdk/typescript/scripts/check-packed-artifact.runtime.ts\",\n        \"packages/sdk/typescript/scripts/validate-downstream-consumer.runtime.ts\",\n      ],\n","exit_code":2,"duration":{"secs":0,"nanos":9208},"formatted_output":" 2452       01:05 /Library/Developer/Comman