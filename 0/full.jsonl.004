ph`\"},{heading:`current-routes`,content:`Read the calculator fact and rule graph.`},{heading:`current-routes`,content:\"`GET`\"},{heading:`current-routes`,content:\"`/api/v1/facts`\"},{heading:`current-routes`,content:`List public fact descriptor metadata.`},{heading:`current-routes`,content:\"`GET`\"},{heading:`current-routes`,content:\"`/api/v1/rules`\"},{heading:`current-routes`,content:`List public rule descriptor metadata.`},{heading:`calculate-route`,content:`The calculate route calls the calculator service directly.`},{heading:`owning-sources`,content:\"API definition: `packages/api/http/src/api.ts`\"},{heading:`owning-sources`,content:\"Calculator group: `packages/api/http/src/groups/calculators.ts`\"},{heading:`owning-sources`,content:\"API runtime: `apps/api/src/server.ts`\"},{heading:`used-by`,content:`OpenAPI reference`},{heading:`used-by`,content:`Endpoints`},{heading:`used-by`,content:`Build a browser app with the HTTP API`},{heading:`used-by`,content:`Examples`}],headings:[{id:`api-reference`,content:`API reference`},{id:`generated-reference`,content:`Generated reference`},{id:`current-routes`,content:`Current routes`},{id:`calculate-route`,content:`Calculate route`},{id:`owning-sources`,content:`Owning sources`},{id:`used-by`,content:`Used by`}]},a=[{depth:1,url:`#api-reference`,title:(0,t.jsx)(t.Fragment,{children:`API reference`})},{depth:2,url:`#generated-reference`,title:(0,t.jsx)(t.Fragment,{children:`Generated reference`})},{depth:2,url:`#current-routes`,title:(0,t.jsx)(t.Fragment,{children:`Current routes`})},{depth:2,url:`#calculate-route`,title:(0,t.jsx)(t.Fragment,{children:`Calculate route`})},{depth:2,url:`#owning-sources`,title:(0,t.jsx)(t.Fragment,{children:`Owning sources`})},{depth:2,url:`#used-by`,title:(0,t.jsx)(t.Fragment,{children:`Used by`})}];function o(e){let n={a:`a`,code:`code`,h1:`h1`,h2:`h2`,li:`li`,p:`p`,pre:`pre`,span:`span`,table:`table`,tbody:`tbody`,td:`td`,th:`th`,thead:`thead`,tr:`tr`,ul:`ul`,...e.components};return