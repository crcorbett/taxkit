uerySelector(\"parsererror\") !== null,\n+            namespace: document.documentElement.namespaceURI,\n+            urls: Array.from(document.querySelectorAll(\"loc\"), (node) => node.textContent),\n+          };\n+        }, discoverySitemap.body));\n+        expect(parsedSitemap.hasParserError).toBe(false);\n+        expect(parsedSitemap.namespace).toBe(\"http://www.sitemaps.org/schemas/sitemap/0.9\");\n+        expect(parsedSitemap.urls).toEqual(Array.map(publicContent.pages, (item) => `${websiteOrigin}${item.path}`));\n         docsPage.on(\"pageerror\", (error) =>\n","move_path":null},"/Users/cooper/.codex/worktrees/aac7/taxkit/packages/api/http/__tests__/public-content.boundary.test.ts":{"type":"update","unified_diff":"@@ -3,3 +3,4 @@\n import { DocsPagePath, DocsSearchTerm } from \"@taxkit/content/schemas\";\n-import { ContentService } from \"@taxkit/content/service\";\n+import { ContentDiscovery, ContentService } from \"@taxkit/content/service\";\n+import { DocsDiscoveryPath } from \"@taxkit/content/schemas\";\n import { exampleContentCatalogue } from \"@taxkit/content/testing/fixtures\";\n@@ -7,2 +8,3 @@\n import {\n+  DocsDiscoveryUnavailable,\n   Headers,\n@@ -29,2 +31,19 @@\n describe(\"checked public documentation HTTP\", () => {\n+  it.effect.each(DocsDiscoveryPath.literals)(\"returns the checked discovery document at $\", (path) =>\n+    Effect.gen(function* () {\n+      const client = yield* TaxKitHttpApiService;\n+      const discovery = yield* ContentDiscovery;\n+      assert.deepEqual(yield* client.content.getDiscovery({ query: { path } }), yield* discovery.getDocument(path));\n+    }).pipe(Effect.provide(ClientTestLive.pipe(Layer.provideMerge(ContentTestLive))))\n+  );\n+  it.effect(\"projects private discovery failures to a fixed unavailable error\", () =>\n+    Effect.gen(function* () {\n+      const client = yield* TaxKitHttpApiService;\n+      const error = yield* client.content.getDiscovery({ query: { path: \"/sitemap.xml\" } }).pipe(Effect.flip);\n+      assert.deepEqual(error, new DocsDiscoveryUnavailable({ message: \"Documentation discovery is temporarily unavailable.\" }));\n+    }).pipe(Effect.provide(TaxKitApiInProcessClientLive.pipe(\n+      Layer.provide(Layer.succeed(ContentDiscovery, ContentDiscovery.of({ getDocument: () => Effect.fail(new DocsSourceError({ message: \"PRIVATE9\", operation: \"getDiscoveryDocument\" })) }))),\n+      Layer.provide(ContentTestLive)\n+    )))\n+  );\n   it.effect(\n@@ -81,2 +100,4 @@\n   it.effect.each([\n+    \"/api/v1/docs/discovery\",\n+    \"/api/v1/docs/discovery?path=PRIVATE9\",\n     \"/api/v1/docs/page\",\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /Users/cooper/.codex/worktrees/aac7/taxkit/apps/web/test/native-pair.boundary.test.ts\nM /Users/cooper/.codex/worktrees/aac7/taxkit/packages/api/http/__tests__/public-content.boundary.test.ts\nM /Users/cooper/.codex/worktrees/aac7/taxkit/packages/api/rpc/test/content.boundary.test.ts\n","stderr":""},"started_at_ms":1791311053919,"completed_at_ms":1791311053922}}
