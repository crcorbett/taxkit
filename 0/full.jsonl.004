hen-a-changeset-is-not-required`,children:`When a Changeset is not required`}),`\nweb test:native-pair: + `,(0,t.jsxs)(n.p,{children:[`Docs-only changes inside `,(0,t.jsx)(n.code,{children:`packages/docs-content/content`}),`, navigation updates and active\nweb test:native-pair: + exec-plan validation notes do not need a Changeset when they do not change\nweb test:native-pair: + package exports, package README behaviour or runtime behaviour.`]}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`State the no-Changeset rationale in your PR and handoff.`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.h2,{id:`pr-evidence`,children:`PR evidence`}),`\nweb test:native-pair: + `,(0,t.jsxs)(n.p,{children:[`Link the Changeset path or write the no-Changeset rationale in\nweb test:native-pair: + `,(0,t.jsx)(n.a,{href:`/contributing/pr-evidence-checklist`,children:`PR evidence checklist`}),`.`]})]})}function s(e={}){let{wrapper:n}=e.components||{};return n?(0,t.jsx)(n,{...e,children:(0,t.jsx)(o,{...e})}):o(e)}export{r as _markdown,s as default,n as frontmatter,i as structuredData,a as toc};\nweb test:native-pair: + import{t as e}from\"./jsx-runtime-BkSabwWG.js\";var t=e(),n={description:`Choose the right TaxKit integration surface for your application.`,status:`published`,title:`Choose SDK or HTTP API`},r=`\nweb test:native-pair: +\nweb test:native-pair: + # Choose SDK or HTTP API [#choose-sdk-or-http-api]\nweb test:native-pair: +\nweb test:native-pair: + Choose the SDK when your application can import TypeScript packages. Choose the\nweb test:native-pair: + HTTP API when the calculation should run on the server or the caller cannot\nweb test:native-pair: + import TypeScript packages. The SDK's root, AU and schema entrypoints also\nweb test:native-pair: + support browser callers; those calculations run on the caller's device.\nweb test:native-pair: +\nweb test:native-pair: + ## Choose by environment [#choose-by-environment]\nweb test:native-pair: +\nweb test:native-pair: + | Environment                                      | Choose          | Why                                                                                                             |\nweb test:native-pair: + | ------------------------------------------------ | --------------- | --------------------------------------------------------------------------------------------------------------- |\nweb test:native-pair: + | Server-side TypeScript application               | Plain SDK       | You get typed calculator inputs and reports without HTTP transport.                                             |\nweb test:native-pair: + | TypeScript application that wants typed failures | Safe SDK        | You get \\`TaxKit.safe.calculate\\` result values.                                                                  |\nweb test:native-pair: + | Effect application                               | Effect SDK      | You can compose \\`calculateRunRequest\\`, \\`calculateReportRequest\\` and \\`calculateReport\\` with services and layers. |\nweb test:native-pair: + | Browser application                              | HTTP API or SDK | HTTP sends the request to the server; the browser-safe SDK calculates on the device.                            |\nweb test:native-pair: + | Non-TypeScript backend                           | HTTP API        | You can use JSON and generated OpenAPI reference.                                                               |\nweb test:native-pair: + | Generated endpoint contract                      | HTTP API        | OpenAPI owns endpoint shape and status codes.                                                                   |\nweb test:native-pair: +\nweb test:native-pair: + ## Recommended paths [#recommended-paths]\nweb test:native-pair: +\nweb test:native-pair: + <svg id=\"mermaid-0\" width=\"100%\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" class=\"flowchart\" style=\"max-width: 1031.421875px;\" viewBox=\"0 0 1031