hs\\\": \\\"turbo run //#check:repository-paths:task\\\",\\n  \\\"check:repository-paths:task\\\": \\\"bun run tools/repository-paths/check.runtime.ts\\\",\\n  \\\"check:repository-paths:types\\\": \\\"turbo run //#check:repository-paths:types:task\\\",\\n  \\\"check:repository-paths:types:task\\\": \\\"tsc --noEmit -p tools/repository-paths/tsconfig.json\\\",\\n  \\\"check:quality-workflow\\\": \\\"turbo run //#check:quality-workflow:task\\\",\\n  \\\"check:quality-workflow:task\\\": \\\"bun run tools/quality-workflow/check.runtime.ts\\\",\\n  \\\"check:quality-workflow:types\\\": \\\"turbo run //#check:quality-workflow:types:task\\\",\\n  \\\"check:quality-workflow:types:task\\\": \\\"tsc --noEmit -p tools/quality-workflow/tsconfig.json\\\",\\n  \\\"clean\\\": \\\"turbo run clean\\\",\\n  \\\"dev\\\": \\\"turbo run build --filter=api && CI=1 ALCHEMY_HOME=.alchemy/native-apps-auth ALCHEMY_TELEMETRY_DISABLED=1 BUN_OPTIONS=\\\\\\\"--conditions=source --no-env-file\\\\\\\" bun run node_modules/alchemy/bin/cli.js dev --config alchemy.apps.local.run.ts --env-file tools/apps-local/no-local-env --stage dev_native_apps\\\",\\n  \\\"docs:build\\\": \\\"turbo run build --filter=docs\\\",\\n  \\\"docs:dev:cloudflare\\\": \\\"bun --no-env-file run tools/docs-deployment/local-doppler.runtime.ts\\\",\\n  \\\"docs:dev:cloudflare:internal\\\": \\\"alchemy dev --env-file tools/docs-deployment/no-local-env\\\",\\n  \\\"docs:dev:vite\\\": \\\"bun run --filter=docs dev:vite\\\",\\n  \\\"docs:validate\\\": \\\"turbo run validate --filter=@taxkit/docs-content\\\",\\n  \\\"fix\\\": \\\"ultracite fix --type-aware\\\",\\n  \\\"format\\\": \\\"oxfmt -c oxfmt.config.ts --write . --no-error-on-unmatched-pattern\\\",\\n  \\\"format:check\\\": \\\"turbo run //#format:check:task\\\",\\n  \\\"format:check:task\\\": \\\"oxfmt -c oxfmt.config.ts --check . --no-error-on-unmatched-pattern\\\",\\n  \\\"knip\\\": \\\"turbo run //#knip:task\\\",\\n  \\\"knip:task\\\": \\\"knip --no-progress --no-config-hints\\\",\\n  \\\"knip:production\\\": \\\"turbo run //#knip:production:task\\\",\\n  \\\"knip:production:task\\\": \\\"knip --production --config knip.production.json --no-gitignore --no-progress --no-config-hints\\\",\\n  \\\"lint\\\": \\\"turbo run //#lint:task\\\",\\n  \\\"lint:task\\\": \\\"bun run lint:boundary-directives && oxlint -c oxlint.config.ts . --disable-nested-config --no-error-on-unmatched-pattern\\\",\\n  \\\"lint:boundary-directives\\\": \\\"oxlint -c oxlint.config.ts . --allow=taxkit/no-decoding-outside-boundaries --allow=taxkit/no-route-transport-restore-outside-consumers --report-unused-disable-directives-severity=error --disable-nested-config --no-error-on-unmatched-pattern\\\",\\n  \\\"prepare\\\": \\\"effect-tsgo patch\\\",\\n  \\\"release:check\\\": \\\"bun run --filter=@taxkit/scripts release:check\\\",\\n  \\\"release:present\\\": \\\"bun run --filter=@taxkit/scripts release:present\\\",\\n  \\\"test\\\": \\\"bun run test:documentation && bun run test:repository-paths && bun run test:docs-boundaries && bun run test:oxlint && turbo run test\\\",\\n  \\\"test:documentation\\\": \\\"turbo run //#test:documentation:task\\\",\\n  \\\"test:documentation:task\\\": \\\"bun --bun vitest run --config tools/vitest.config.ts tools/documentation\\\",\\n  \\\"test:docs-deployment\\\": \\\"turbo run //#test:docs-deployment:task\\\",\\n  \\\"test:docs-deployment:task\\\": \\\"bun --conditions=source node_modules/vitest/vitest.mjs run --config tools/vitest.config.ts tools/docs-deployment\\\",\\n  \\\"test:docs-boundaries\\\": \\\"turbo run //#test:docs-boundaries:task\\\",\\n  \\\"test:docs-boundaries:task\\\": \\\"bun run --filter=docs check-import-boundaries && bun run --filter=docs test\\\",\\n  \\\"test:hgi-206\\\": \\\"bun --bun vitest run --config tools/vitest.config.ts tools/evals/hgi-206\\\",\\n  \\\"test:harness-governance\\\": \\\"bun --bun vitest run --config tools/vitest.config.ts tools/governance\\\",\\n  \\\"test:oxlint\\\": \\\"turbo run //#test:oxlint:task\\\",\\n  \\\"test:oxlint:task\\\": \\\"bun --bun vitest run --config tools/vitest.config.ts tools/oxlint\\\",\\n  \\\"test:repository-paths\\\": \\\"turbo run //#test:repository-paths:task\\\",\\n  \\\"test:repository-paths:task\\\": \\\"bun --bun vitest run --config tools/vitest.config.ts tools/repository-paths\\\",\\n  \\\"test:quality-workflow\\\": \\\"turbo run //#test:quality-workflow:task\\\",\\n  \\\"test:quality-workflow:task\\\": \\\"bun --bun vitest run --config tools/vitest.config.ts tools/quality-workflow\\\",\\n  \\\"test:skills\\\": \\\"turbo run //#test:skills:task\\\",\\n  \\\"test:skills:task\\\": \\\"bun --bun vitest run --config tools/vitest.config.ts tools/skills\\\",\\n  \\\"test:release-readiness\\\": \\\"bun run --filter=@taxkit/scripts test -- release-readiness\\\",\\n  \\\"sdk:check-packed-artifact\\\": \\\"turbo run check-packed-artifact --filter=@taxkit/sdk\\\",\\n  \\\"sdk:validate-downstream\\\": \\\"turbo run validate:downstream --filter=@taxkit/sdk\\\",\\n  \\\"api:smoke\\\": \\\"turbo run smoke --filter=api\\\",\\n  \\\"docs:test:browser\\\": \\\"turbo run test:browser --filter=docs\\\",\\n  \\\"changeset:status\\\": \\\"turbo run //#changeset:status:task\\\",\\n  \\\"changeset:status:task\\\": \\\"changeset status --verbose\\\",\\n  \\\"verification\\\": \\\"bun run check:skills:types && bun run check:oxlint:types && bun run check:repository-paths:types && bun run check:repository-paths && bun run check:harness-governance && bun run check:quality-workflow:types && bun run check:quality-workflow && bun run check:docs:types && bun run check:harness-foundation-epoch:types && bun run check:docs && bun run check:runbooks && bun run check:effect-language-service && bun run check:docs-deployment:types && bun run check:docs-deployment-tools:types && bun run check:docs-deployment && bun run check:docs-deployment-automation && bun run test:docs-deployment && bun run lint && bun run format:check && bun run test:skills && bun run test:hgi-206 && bun run test:quality-workflow && bun run knip && bun run knip:production && bun run check-types && bun run sdk:test:browser && bun run web:test:browser && bun run --filter=web check:worker-types && bun run web:test:native-pair\\\",\\n  \\\"version-packages\\\": \\\"changeset version\\\",\\n  \\\"version-repo\\\": \\\"changeset version\\\",\\n  \\\"web:test:browser\\\": \\\"turbo run test:browser --filter=web\\\",\\n  \\\"sdk:test:browser\\\": \\\"turbo run test:browser --filter=@taxkit/sdk\\\",\\n  \\\"web:test:native-pair\\\": \\\"bun run --filter=web build:native-pair && bun run --filter=web test:native-pair\\\",\\n  \\\"docs:catalogue\\\": \\\"bun run --filter=@taxkit/docs-content generate && bun --conditions=source run tools/documentation/catalogue.runtime.ts\\\"\\n}\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a110dd-a561-7f92-9e34-cf5bd1e8dee9","create_time":1791311942.538527}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
