lationEngineLive } from \"@taxkit/core\";\nweb test:native-pair: + import { Cents, Money } from \"@taxkit/core/primitives\";\nweb test:native-pair: + import { GrossPay } from \"@taxkit/rules-au-pay\";\nweb test:native-pair: + import { AuPayTakeHomeCalculation } from \"@taxkit/sdk/au/effect\";\nweb test:native-pair: + import { calculateReport } from \"@taxkit/sdk/effect\";\nweb test:native-pair: + import { Effect, Layer, Schema } from \"effect\";\nweb test:native-pair: + import * as HttpServerRequest from \"effect/http/HttpServerRequest\";\nweb test:native-pair: +\nweb test:native-pair: + class PayPreviewRequestError extends Schema.TaggedError<PayPreviewRequestError>()(\nweb test:native-pair: +   \"PayPreviewRequestError\",\nweb test:native-pair: +   { message: Schema.String }\nweb test:native-pair: + ) {}\nweb test:native-pair: +\nweb test:native-pair: + const PayPreviewRequest = Schema.Struct({\nweb test:native-pair: +   grossPayCents: Cents,\nweb test:native-pair: +   period: GrossPay.fields.period,\nweb test:native-pair: +   taxFreeThresholdClaimed: Schema.Boolean,\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + const PayPreviewResponse = Schema.Struct({\nweb test:native-pair: +   netPayCents: Cents,\nweb test:native-pair: +   withholdingsCents: Cents,\nweb test:native-pair: + });\nweb test:native-pair: +\nweb test:native-pair: + const TaxKitLayer = PublicCalculatorServiceLive.pipe(\nweb test:native-pair: +   Layer.provide(CalculationEngineLive)\nweb test:native-pair: + );\nweb test:native-pair: +\nweb test:native-pair: + export const handlePayPreview = (request: Request) =>\nweb test:native-pair: +   Effect.gen(function* () {\nweb test:native-pair: +     const body = yield* HttpServerRequest.fromWeb(request).text.pipe(\nweb test:native-pair: +       Effect.flatMap(\nweb test:native-pair: +         Schema.decodeEffect(Schema.fromJsonString(PayPreviewRequest))\nweb test:native-pair: +       ),\nweb test:native-pair: +       Effect.mapError(\nweb test:native-pair: +         () =>\nweb test:native-pair: +           new PayPreviewRequestError({\nweb test:native-pair: +             message: \"Invalid pay preview request.\",\nweb test:native-pair: +           })\nweb test:native-pair: +       )\nweb test:native-pair: +     );\nweb test:native-pair: +     const report = yield* calculateReport(AuPayTakeHomeCalculation, {\nweb test:native-pair: +       grossPay: new GrossPay({\nweb test:native-pair: +         amount: new Money({ cents: body.grossPayCents, currency: \"AUD\" }),\nweb test:native-pair: +         period: body.period,\nweb test:native-pair: +       }),\nweb test:native-pair: +       taxFreeThresholdClaimed: body.taxFreeThresholdClaimed,\nweb test:native-pair: +     });\nweb test:native-pair: +     const response = yield* Schema.encodeEffect(\nweb test:native-pair: +       Schema.fromJsonString(PayPreviewResponse)\nweb test:native-pair: +     )({\nweb test:native-pair: +       netPayCents: report.netPay.cents,\nweb test:native-pair: +       withholdingsCents: report.withholdingsTotal.cents,\nweb test:native-pair: +     });\nweb test:native-pair: +     return new Response(response, {\nweb test:native-pair: +       headers: { \"content-type\": \"application/json\" },\nweb test:native-pair: +     });\nweb test:native-pair: +   }).pipe(Effect.provide(TaxKitLayer));\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Verify the result [#verify-the-result]\nweb test:native-pair: +\nweb test:native-pair: + Request body:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`json\nweb test:native-pair: + {\nweb test:native-pair: +   \"grossPayCents\": 165400,\nweb test:native-pair: +   \"period\": \"weekly\",\nweb test:native-pair: +   \"taxFreeThresholdClaimed\": true\nweb test:native-pair: + }\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + Expected response:\nweb test:native-pair: +\nweb test:native-pair: + \\`\\`\\`json\nweb test:native-pair: + { \"netPayCents\": 130100, \"withholdingsCents\": 35300 }\nweb test:native-pair: + \\`\\`\\`\nweb test:native-pair: +\nweb test:native-pair: + ## Handle errors [#handle-errors]\nweb test:native-pair: +\nweb test:native-pair: + The handler returns an Effect. Your server host owns execution and maps the\nweb test:native-pair: + typed failure channel to its HTTP status and response shape. Invalid JSON,\nweb test:native-pair: + fractional cents and unsupported periods fail request validation before the\nweb test:native-pair: + calculator runs. Provider or request details are not included in the safe\nweb test:native-pair: + request error.\nweb test:native-pair: +\nweb test:native-pair: + ## Related pages [#related-pages]\nweb test:native-pair: +\nweb test:native-pair: + * [Plain SDK](/sdk/plain-sdk)\nweb test:native-pair: + * [Build a browser app with the HTTP API](/guides/build-a-browser-app-with-the-http-api)\nweb test:native-pair: + * [SDK, HTTP API and calculators service boundary](/concepts/sdk-http-api-and-calculators-service-boundary)\nweb test:native-pair: + `,i={contents:[{heading:`build-a-server-route-with-the-sdk`,content:`Use this guide when your application owns the HTTP route and only needs\nweb test:native-pair: + TaxKit for the calculation.`},{heading:`before-you-start`,content:`Use a server-side TypeScript runtime.`},{heading:`before-you-start`,content:`Install the SDK with Install the SDK.`},{heading:`before-you-start`,content:`Keep request validation at your application boundary.`},{heading:`steps`,content:`Parse your application request.`},{heading:`steps`,content:`Convert accepted fields into canonical TaxKit facts.`},{heading:`steps`,content:`Call the SDK helper.`},{heading:`steps`,content:`Return the report fields your application needs.`},{heading:`verify-the-result`,content:`Request body:`},{heading:`verify-the-result`,content:`Expected response:`},{heading:`handle-errors`,content:`The handler returns an Effect. Your server host owns execution and maps the\nweb test:native-pair: + typed failure channel to its HTTP status and response shape. Invalid JSON,\nweb test:native-pair: + fractional cents and unsupported periods fail request validation before the\nweb test:native-pair: + calculator runs. Provider or request details are not included in the safe\nweb test:native-pair: + request error.`},{heading:`related-pages`,content:`Plain SDK`},{heading:`related-pages`,content:`Build a browser app with the HTTP API`},{heading:`related-pages`,content:`SDK, HTTP API and calculators service boundary`}],headings:[{id:`build-a-server-route-with-the-sdk`,content:`Build a server route with the SDK`},{id:`before-you-start`,content:`Before you start`},{id:`steps`,content:`Steps`},{id:`example`,content:`Example`},{id:`verify-the-result`,content:`Verify the result`},{id:`handle-errors`,content:`Handle errors`},{id:`related-pages`,content:`Related pages`}]},a=[{depth:1,url:`#build-a-server-route-with-the-sdk`,title:(0,t.jsx)(t.Fragment,{children:`Build a server route with the SDK`})},{depth:2,url:`#before-you-start`,title:(0,t.jsx)(t.Fragment,{children:`Before you start`})},{depth:2,url:`#steps`,title:(0,t.jsx)(t.Fragment,{children:`Steps`})},{depth:2,url:`#example`,title:(0,t.jsx)(t.Fragment,{children:`Example`})},{depth:2,url:`#verify-the-result`,title:(0,t.jsx)(t.Fragment,{children:`Verify the result`})},{depth:2,url:`#handle-errors`,title:(0,t.jsx)(t.Fragment,{children:`Handle errors`})},{depth:2,url:`#related-pages`,title:(0,t.jsx)(t.Fragment,{children:`Related pages`})}];function o(e){let n={a:`a`,code:`code`,h1:`h1`,h2:`h2`,li:`li`,ol:`ol`,p:`p`,pre:`pre`,span:`span`,ul:`ul`,...e.components};return(0,t.jsxs)(t.Fragment,{children:[(0,t.jsx)(n.h1,{id:`build-a-server-route-with-the-sdk`,children:`Build a server route with the SDK`}),`\nweb test:native-pair: + `,(0,t.jsx)(n.p,{children:`Use this guide when your application owns the HTTP route and only needs\nweb test:native-pair: + TaxKit for the 