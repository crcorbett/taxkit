rol.json')).read_text())\nrows=[json.loads(line) for line in (root/(prefix+'-results.jsonl')).read_text().splitlines()]\nassert len(rows)==1 and rows[0]['exitCode']==0,rows\nreport=root/(prefix+'-release-report.log');text=report.read_text()\npattern=r'PASS \\[([^\\]]+)\\] target=([^;]+); stdout=([^\\s]+) \\((sha256:[0-9a-f]{64})\\); stderr=([^\\s]+) \\((sha256:[0-9a-f]{64})\\)'\nmatches=re.findall(pattern,text)\nexpected=['verification','test','build','docs-validation','packed-artifact','downstream-consumer','api-smoke','docs-browser','changeset-status']\nassert [m[0] for m in matches]==expected,[m[0] for m in matches]\nchecks=[]\nfor check,label,stdout,stdout_hash,stderr,stderr_hash in matches:\n row={'check':check,'label':label,'exitCode':0}\n for stream,path,digest in [('stdout',stdout,stdout_hash),('stderr',stderr,stderr_hash)]:\n  observed='sha256:'+hashlib.sha256(Path(path).read_bytes()).hexdigest()\n  assert observed==digest,(check,path)\n  row[stream]={'path':path,'sha256':digest}\n row['detailsVerified']=True\n row['sdkTaskCacheLines']=[line for line in Path(stdout).read_text().splitlines() if ('check-packed-artifact:' in line or 'validate:downstream:' in line) and 'cache ' in line]\n checks.append(row)\nmanifest_path=root/(prefix+'-source-freeze.json');manifest=json.loads(manifest_path.read_text());changed=[]\nfor path,expected in manifest.items():\n p=Path(path)\n if not p.exists() and not p.is_symlink():changed.append(path);continue\n if p.is_symlink():kind,mode,b='symlink',120000,os.readlink(p).encode()\n else:kind,mode,b='file',100755 if p.stat().st_mode & 0o111 else 100644,p.read_bytes()\n if {'kind':kind,'mode':mode,'sha256':hashlib.sha256(b).hexdigest()}!=expected:changed.append(path)\nassert not changed,changed\nhead=subprocess.check_output(['git','rev-parse','HEAD']).decode().strip();assert head==control['candidate'],head\nprs=json.loads((root/'taxkit-merge-open-prs.json').read_text())\nfor pr in prs:subprocess.run(['git','merge-base','--is-ancestor',pr['headRefOid'],head],check=True)\nassert not subprocess.check_output(['git','status','--porcelain']).decode().strip(),'tracked/untracked worktree changed'\nresult={'mode':'CI/report-only graph executed locally on Cooper Mac; no hosted CI claim','candidate':head,'runner':rows[0],'orderedChecks':checks,'sourceQualification':{'frozenFiles':len(manifest),'allMatched':True,'manifest':manifest_path.name,'manifestSha256':hashlib.sha256(manifest_path.read_bytes()).hexdigest(),'excludedMetadata':['docs/documentation-audit/clean-slate-foundation/2026-10-08-merge-all.json']},'all81HeadsAreAncestors':True,'report':{'path':report.name,'sha256':hashlib.sha256(report.read_bytes()).hexdigest()},'observedAt':datetime.datetime.now(datetime.timezone.utc).isoformat()}\nout=root/'taxkit-merge-passing-evidence.json';out.write_text(json.dumps(result,indent=2)+'\\n')\nprint(json.dumps({'candidate':head,'allNinePass':True,'durationSeconds':rows[0]['durationSeconds'],'detailHashesVerified':len(checks)*2,'frozenFilesMatched':len(manifest),'all81HeadsAreAncestors':True,'evidence':str(out)}))\nPY\n"}],"source":"unified_exec_startup","status":"completed","stdout":"","stderr":"","aggregated_output":"","exit_code":0,"duration":{"secs":0,"nanos":6083},"formatted_output":""},"started_at_ms":1791445769031,"completed_at_ms":1791445769031}}
