{"timestamp":"2026-10-08T08:13:12.755Z","ordinal":78239,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1055e-4560-7b33-82d2-226827c76159","turn_id":"01a11a78-0d20-79f1-98ee-3fa84f9694e8","item":{"type":"McpToolCall","id":"exec-a26e8679-5414-4d62-bd79-3574b7a5033b","server":"executor-personal","tool":"execute","arguments":{"code":"const out = await Promise.all([tools.search({namespace: \"linear_mcp\", query: \"get_issue\", limit: 3}), tools.search({namespace: \"linear_mcp\", query: \"save_issue\", limit: 3}), tools.search({namespace: \"linear_mcp\", query: \"status_updates\", limit: 4})]); return out;"},"status":"completed","result":{"content":[{"type":"text","text":"[\n  {\n    \"items\": [\n      {\n        \"path\": \"linear_mcp.user.personallinearmcp.get_issue\",\n        \"name\": \"get_issue\",\n        \"description\": \"Retrieve detailed information about an issue by ID, including attachments, git branch name, and active Triage Intelligence suggestions when the issue is in triage. A nonempty fields selection overrides the include options; request optional fields directly in fields.\",\n        \"integration\": \"linear_mcp\",\n        \"score\": 461\n      },\n      {\n        \"path\": \"linear_mcp.user.personallinearmcp.get_issue_status\",\n        \"name\": \"get_issue_status\",\n        \"description\": \"Retrieve detailed information about an issue status in Linear by name or ID\",\n        \"integration\": \"linear_mcp\",\n        \"score\": 391\n      },\n      {\n        \"path\": \"linear_mcp.user.personallinearmcp.get_attachment\",\n        \"name\": \"get_attachment\",\n        \"description\": \"Retrieve an issue attachment by ID. Use format=url to get its title and download URL without fetching the file content. Linear upload URLs are signed for five minutes; call again to refresh. External URLs are returned unchanged. Files embedded in comments have no issue attachment ID; use the URLs in list_comments attachments instead.