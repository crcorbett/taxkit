mport json,subprocess,hashlib,datetime,os\nfrom pathlib import Path\nexcluded='docs/documentation-audit/clean-slate-foundation/2026-10-08-merge-all.json'\nfiles=subprocess.check_output(['git','ls-files','-z']).decode().split('\\0')\nmanifest={}\nfor p in files:\n if not p or p==excluded:continue\n path=Path(p);islink=path.is_symlink();raw=os.readlink(path).encode() if islink else path.read_bytes();mode=path.lstat().st_mode\n manifest[p]={'kind':'symlink' if islink else 'file','mode':120000 if islink else (100755 if mode&0o100 else 100644),'sha256':hashlib.sha256(raw).hexdigest()}\np=Path('/private/tmp/taxkit-merge-source-freeze.json');p.write_text(json.dumps(manifest,sort_keys=True,indent=2)+'\\n')\nprefix='taxkit-merge-final';log=Path('/private/tmp/'+prefix+'-control.log')\nwith log.open('w') as out:\n proc=subprocess.Popen(['python3','/private/tmp/dev75-request-run-checks.py',json.dumps([['release-report',['bun','run','release:check','--','--ci']]]),prefix],cwd=str(Path.cwd()),stdout=out,stderr=subprocess.STDOUT,start_new_session=True)\ncontrol={'pid':proc.pid,'startedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),'prefix':prefix,'log':str(log),'results':'/private/tmp/'+prefix+'-results.jsonl','frozenFiles':len(manifest),'manifestSha256':hashlib.sha256(p.read_bytes()).hexdigest(),'candidate':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()}\nPath('/private/tmp/taxkit-merge-final-control.json').write_text(json.dumps(control,indent=2)+'\\n');print(control)\nPY"}],"source":"unified_exec_startup","status":"completed","stdout":"{'pid': 19029, 'startedAt': '2026-10-08T03:11:36.762746+00:00', 'prefix': 'taxkit-merge-final', 'log': '/private/tmp/taxkit-merge-final-control.log', 'results': '/private/tmp/taxkit-merge-final-results.jsonl', 'frozenFiles': 1712, 'manifestSha256': '11d0b3167dac9d0145fb55e298d165e0cdc5c4997b725ba808071b9c45b5fac0', 'candidate': '12b6d7d765dc7c645e1034b967b1c33fd605528e'}\n","stderr":"","aggregated_output":"{'pi