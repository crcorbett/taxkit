atus_update\",\n        \"name\": \"delete_status_update\",\n        \"description\": \"Delete (archive) a project or initiative status update.\",\n        \"integration\": \"linear_mcp\",\n        \"score\": 187\n      },\n      {\n        \"path\": \"linear_mcp.user.personallinearmcp.save_status_update\",\n        \"name\": \"save_status_update\",\n        \"description\": \"Create or update a project/initiative status update. Omit `id` to create, provide `id` to update.\",\n        \"integration\": \"linear_mcp\",\n        \"score\": 187\n      },\n      {\n        \"path\": \"linear_mcp.user.personallinearmcp.update_diff\",\n        \"name\": \"update_diff\",\n        \"description\": \"Update a Linear diff's title, description, reviewer requests, issue links, or status. Provide at least one update. Combined updates can partially succeed; inspect the result before retrying. Use merge_diff to merge and submit_diff_review to approve or request changes.\",\n        \"integration\": \"linear_mcp\",\n        \"score\": 109\n      }\n    ],\n    \"total\": 8,\n    \"hasMore\": true,\n    \"nextOffset\": 4\n  }\n]"}],"structuredContent":{"status":"completed","result":[{"items":[{"path":"linear_mcp.user.personallinearmcp.get_issue","name":"get_issue","description":"Retrieve detailed information about an issue by ID, including attachments, git branch name, and active Triage Intelligence suggestions when the issue is in triage. A nonempty fields selection overrides the include options; request optional fields directly in fields.","integration":"linear_mcp","score":461},{"path":"linear_mcp.user.personallinearmcp.get_issue_status","name":"get_issue_status","description":"Retrieve detailed information about an issue status in Linear by name or ID","integration":"linear_mcp","score":391},{"path":"linear_mcp.user.personallinearmcp.get_attachment","name":"get_attachment","description":"Retrieve an issue attachment by ID. Use format=url to get its title and download URL without 