ng formatting...\\n@taxkit/scripts release:check: //:format:check:task: \\n@taxkit/scripts release:check: //:format:check:task: tools/evals/hgi-206/check.runtime.test.ts (0ms)\\n@taxkit/scripts release:check: //:format:check:task: \\n@taxkit/scripts release:check: //:format:check:task: Format issues found in above 1 files. Run without `--check` to fix.\\n@taxkit/scripts release:check: //:format:check:task: Finished in 2205ms on 793 files using 14 threads.\\n@taxkit/scripts release:check: //:format:check:task: error: script \\\"format:check:task\\\" exited with code 1\\n@taxkit/scripts release:check: \\n@taxkit/scripts release:check:  Tasks:    0 successful, 1 total\\n@taxkit/scripts release:check: Cached:    0 cached, 1 total\\n@taxkit/scripts release:check:   Time:    2.515s \\n@taxkit/scripts release:check: Failed:    //#format:check:task\\n@taxkit/scripts release:check: \\n@taxkit/scripts release:check: \\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"ba1898\",\"wall_time_seconds\":0.000007209,\"exit_code\":0,\"original_token_count\":11,\"output\":\"2a27c43d06626a8f1725538cda810d70efe975f7\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a119a1-b5ae-7cf0-a81d-8528237cff7c","create_time":1791432435.185172}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
