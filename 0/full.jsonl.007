        |   310 +\\n tools/oxlint/binding-tracker.js                    |   196 -\\n tools/oxlint/binding-tracker.test.ts               |    40 +\\n tools/oxlint/binding-tracker.ts                    |   304 +\\n tools/oxlint/{bun-rules.js => bun-rules.ts}        |    38 +-\\n tools/oxlint/cli-fixture.test.ts                   |    32 +\\n tools/oxlint/cli-fixture.ts                        |    70 +\\n tools/oxlint/{effect-rules.js => effect-rules.ts}  |   512 +-\\n .../fixtures/strict-bindings-rejected.js.txt       |    16 +\\n .../fixtures/strict-collections-rejected.ts.txt    |    17 +\\n tools/oxlint/fixtures/strict-commonjs-accepted.cjs |     2 +\\n .../fixtures/strict-commonjs-rejected.cjs.txt      |     8 +\\n tools/oxlint/fixtures/strict-global-accepted.js    |     4 +\\n .../oxlint/fixtures/strict-global-rejected.js.txt  |     5 +\\n tools/oxlint/host.types.ts                         |    19 +\\n tools/oxlint/lexical-policy.test.ts                |   266 +\\n tools/oxlint/{mdx-rules.js => mdx-rules.ts}        |    32 +-\\n tools/oxlint/no-bare-effect-try-promise.test.ts    |   110 +-\\n .../oxlint/no-decoding-outside-boundaries.test.ts  |   247 +-\\n ...ute-transport-restore-outside-consumers.test.ts |   626 +-\\n .../oxlint/{package-rules.js => package-rules.ts}  |    60 +-\\n tools/oxlint/portable-rules.test.ts                |  2604 ++-\\n tools/oxlint/taxkit-rules.js                       |  1846 ---\\n tools/oxlint/taxkit-rules.ts                       |  2195 +++\\n tools/oxlint/tsconfig.json                         |    11 +\\n tools/quality-workflow/check.runtime.ts            |    15 +-\\n .../fixtures/release-boundary-defects.json         |     7 +-\\n .../fixtures/strict-enforcement-defects.json       |    56 +\\n tools/quality-workflow/policy.test.ts              |   934 +-\\n tools/quality-workflow/policy.ts                   |   645 +-\\n tools/quality-workflow/release-boundary.test.ts    |   520 +-\\n tools/quality-workflow/schemas.ts                  |    19 +\\n tools/quality-workflow/tsconfig.json               |    10 +\\n tools/repository-paths/check.runtime.test.ts       |   183 +-\\n tools/repository-paths/check.runtime.ts            |     2 +-\\n tools/repository-paths/policy.test.ts              |    18 +-\\n tools/vitest.config.ts                             |    17 +\\n tsconfig.alchemy.json                              |     9 +-\\n tsconfig.base.json                                 |    10 +-\\n turbo.json                                         |    44 +-\\n 1020 files changed, 176425 insertions(+), 24947 deletions(-)\\n7ab9f80a style: format historical refusal expectation [skip ci]\\n2a27c43d test: retain historical refusal checks after plugin migration [skip ci]\\n8cb46fca fix: retain typed historical hash checks after merge [skip ci]\\n12b6d7d7 docs: record merge-all authority and combined source [skip ci]\\nae32f426 merge: combine approved Medicare correction with reviewed rebuild [skip ci]\\n892b1950 merge: preserve main plugin updates in reviewed rebuild [skip ci]\\nsed: .github/workflows/deploy-preview.yml: No such file or directory\\nsed: .github/workflows/deploy-production.yml: No such file or directory\\n\"}}\n{\"i\":1,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"b1b0e4\",\"wall_time_seconds\":1.249764375,\"exit_code\":0,\"original_token_count\":364,\"output\":\"rows 81\\nnon-ancestor heads []\\nfirst {'baseRefName': 'codex/dev-79-shared-posthog-project', 'headRefName': 'codex/dev-81-review-handover', 'headRefOid': '601693dc93a45b8345db19349f959b2a41508a24', 'isDraft': True, 'mergeStateStatus': 'CLEAN', 'mergeable': 'MERGEABLE', 'number': 170, 'reviewDecision': '', 'statusCheckRollup': [], 'title': 'DEV-81: Record reviewed handover and analytics deferrals', 'url': 'https://github.com/crcorbett/taxkit/pull/170'}\\nlast {'baseRefName': 'main', 'headRefName': 'codex/dev-72-clean-slate-foundation', 'headRefOid': '771a506a071277f1f975672c4edaa9e32bf629b0', 'isDraft': True, 'mergeStateStatus': 'UNKNOWN', 'mergeable': 'UNKNOWN', 'number': 88, 'reviewDecision': '', 'statusCheckRollup': [{'__typename': 'CheckRun', 'completedAt': '2026-10-04T01:22:05Z', 'conclusion': 'SUCCESS', 'detailsUrl': 'https://github.com/crcorbett/taxkit/actions/runs/37167621711/job/111333786839', 'name': 'quality', 'startedAt': '2026-10-04T01:18:50Z', 'status': 'COMPLETED', 'workflowName': 'Quality'}], 'title': 'Preserve rebuild baseline and expose offline install errors (DEV-72)', 'url': 'https://github.com/crcorbett/taxkit/pull/88'}\\n/private/tmp/taxkit-merge-complete-control.log 0\\n\\n/private/tmp/taxkit-merge-complete-results.jsonl not yet present\\n/private/tmp/taxkit-merge-complete-release-report.log 126\\n$ bun run --filter=@taxkit/scripts release:check --ci\\n@taxkit/scripts release:check: RUN  [verification] bun run verification\\n\\n\"}}\n{\"i\":2,\"status\":\"fulfilled\",\"value\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"id\\\":\\\"DEV-79\\\",\\\"uuid\\\":\\\"85150329-9061-4690-8f80-bfbc7af57ebe\\\",\\\"title\\\":\\\"CSF-T008 — Track visits and calculator choice with minimal PostHog events\\\",\\\"description\\\":\\\"## 8 October 2026 — current handover and PostHog postponement\\\\n\\\\nCooper postponed PostHog on 8 October. Preserve the tested one-project design in draft <pull-request id=\\\\\\\"f2c8f9f4-d24d-40d2-9b7f-d7221f04abbe\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/review/dev-79-use-one-shared-posthog-project-and-close-rejected-requests-61d4c708ada1\\\\\\\">crcorbett/taxkit#169</pull-request> and keep collection off. Browser pageviews, actual project creation, tracking activation and stored-event checks remain unfinished; resume only when Cooper asks. No billing upgrade, credential creation or provider change is authorised by this handover.\\\\n\\\\n<pull-request id=\\\\\\\"397baa65-c16b-498d-acd8-6129b4745683\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/review/dev-81-record-reviewed-handover-and-analytics-deferrals-cd08825ec160\\\\\\\">crcorbett/taxkit#170</pull-request> records this decision in the SPEC, task list and active plan, with the reviewed handover and passing local release/SDK checks. [Exact evidence](<https://github.com/crcorbett/taxkit/blob/fc4da30fdc6797ebed905c79823ff5e9508d33ba/docs/documentation-audit/clean-slate-foundation/2026-10-08-review-handover.json>). <issue id=\\\\\\\"85150329-9061-4690-8f80-bfbc7af57ebe\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/issue/DEV-79/csf-t008-track-visits-and-calculator-choice-with-minimal-posthog\\\\\\\">DEV-79</issue> remains incomplete and In Progress; its existing dependencies and acceptance conditions remain in force. Earlier progress below is dated history and does not override this postponement.\\\\n\\\\nThis issue tracks `CSF-T008` in the clean-slate rebuild plan.…2411 tokens truncated…ted. The browser sender decision and temporary management-read preparation approval remain pending; complete provider capacity/inventory, project apply, final hosted recipient headers, stored-event proof and final privacy/operations updates remain unfinished. This progress supersedes earlier notes that the relay remained unfinished. <issue id=\\\\\\\"85150329-9061-4690-8f80-bfbc7af57ebe\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/issue/DEV-79/csf-t008-track-visits-and-calculator-choice-with-minimal-posthog\\\\\\\">DEV-79</issue> stays In Progress; metrics remain deferred. Checks and deployments ran on this Mac because GitHub Actions credits are exhausted.\\\\n\\\\nCooper selected one US TaxKit project shared by Production and controlled Preview. Draft <pull-request id=\\\\\\\"f2c8f9f4-d24d-40d2-9b7f-d7221f04abbe\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/review/dev-79-use-one-shared-posthog-project-and-close-rejected-requests-61d4c708ada1\\\\\\\">crcorbett/taxkit#169</pull-request>, stacked on <pull-request id=\\\\\\\"2f003fb5-eb4f-4680-b168-ce350fedbc77\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/review/dev-79-add-the-bounded-website-event-relay-b24ae5f3bb6d\\\\\\\">crcorbett/taxkit#167</pull-request>, now contains that design and the reviewed request-cleanup/bodyless-success fixes. Root tests, types and build pass locally; complete verification passes in 957.81 seconds, including all 34 release-check cases and 22 freshly built app cases. The corrected browser test and independent reviews pass, with individual request and cancellation limits preserved. [Shared-project evidence](<https://github.com/crcorbett/taxkit/blob/94e0362037df3590c193fc522387fe256f40d826/docs/documentation-audit/clean-slate-foundation/2026-10-08-shared-posthog-project.json>) records exact source, failed attempts, recovery and limits. The temporary read-only preparation and credential cleanup are already complete; the current project list still has six entries. PostHog shows adad test scheduled for deletion on 10 October at 10:43 am, as displayed. Capacity is not yet confirmed. No new project, key, provider state, tracking activation or deployment was changed by this slice. Browser sender choice, reviewed live plan/project creation and hosted/stored-event/privacy proof remain unfinished. <issue id=\\\\\\\"85150329-9061-4690-8f80-bfbc7af57ebe\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/issue/DEV-79/csf-t008-track-visits-and-calculator-choice-with-minimal-posthog\\\\\\\">DEV-79</issue> remains In Progress; metrics remain deferred and retained tax results are unchanged.\\\",\\\"priority\\\":{\\\"value\\\":0,\\\"name\\\":\\\"No priority\\\"},\\\"url\\\":\\\"https://linear.app/coopers-personal/issue/DEV-79/csf-t008-track-visits-and-calculator-choice-with-minimal-posthog\\\",\\\"gitBranchName\\\":\\\"coopercorbett/dev-79-csf-t008-track-visits-and-calculator-choice-with-minimal\\\",\\\"createdAt\\\":\\\"2026-10-04T00:14:08.681Z\\\",\\\"updatedAt\\\":\\\"2026-10-08T02:05:15.134Z\\\",\\\"archivedAt\\\":null,\\\"completedAt\\\":null,\\\"startedAt\\\":\\\"2026-10-07T10:10:06.397Z\\\",\\\"canceledAt\\\":null,\\\"dueDate\\\":null,\\\"slaStartedAt\\\":null,\\\"slaMediumRiskAt\\\":null,\\\"slaHighRiskAt\\\":null,\\\"slaBreachesAt\\\":null,\\\"status\\\":\\\"In Progress\\\",\\\"statusType\\\":\\\"started\\\",\\\"labels\\\":[\\\"web\\\",\\\"analytics\\\"],\\\"attachments\\\":[{\\\"id\\\":\\\"1a2937fd-a918-4daa-a322-d121c5402244\\\",\\\"title\\\":\\\"DEV-79: Use one shared PostHog project and close rejected requests\\\",\\\"subtitle\\\":null,\\\"url\\\":\\\"https://github.com/crcorbett/taxkit/pull/169\\\"},{\\\"id\\\":\\\"8a000048-56be-469e-a607-671b12f99c5f\\\",\\\"title\\\":\\\"DEV-79: Add the bounded Website event relay\\\",\\\"subtitle\\\":null,\\\"url\\\":\\\"https://github.com/crcorbett/taxkit/pull/167\\\"},{\\\"id\\\":\\\"9ab89be4-a2e3-4b1a-a7c0-9e6530d4060c\\\",\\\"title\\\":\\\"dev79: define retained PostHog projects and fix docs build ordering\\\",\\\"subtitle\\\":null,\\\"url\\\":\\\"https://github.com/crcorbett/taxkit/pull/166\\\"},{\\\"id\\\":\\\"7659c132-e0fa-4edc-ae23-5b0afdac9a98\\\",\\\"title\\\":\\\"DEV-79: Honour Website collection choices for calculator requests\\\",\\\"subtitle\\\":null,\\\"url\\\":\\\"https://github.com/crcorbett/taxkit/pull/165\\\"},{\\\"id\\\":\\\"76b5361d-7b4f-43c7-99cf-dae53c587d08\\\",\\\"title\\\":\\\"DEV-79: Add minimal calculator events and per-request opt-out\\\",\\\"subtitle\\\":null,\\\"url\\\":\\\"https://github.com/crcorbett/taxkit/pull/164\\\"}],\\\"documents\\\":[],\\\"stateHistory\\\":[{\\\"state\\\":{\\\"id\\\":\\\"64be05ca-3288-4616-9b5b-4d0c8d805b56\\\",\\\"name\\\":\\\"Backlog\\\",\\\"type\\\":\\\"backlog\\\"},\\\"startedAt\\\":\\\"2026-10-04T00:14:08.681Z\\\",\\\"endedAt\\\":\\\"2026-10-07T10:10:06.422Z\\\"},{\\\"state\\\":{\\\"id\\\":\\\"b878aab7-e95e-4f74-aac1-e8693ffd9fd1\\\",\\\"name\\\":\\\"In Progress\\\",\\\"type\\\":\\\"started\\\"},\\\"startedAt\\\":\\\"2026-10-07T10:10:06.422Z\\\",\\\"endedAt\\\":null}],\\\"createdBy\\\":\\\"Cooper Corbett\\\",\\\"createdById\\\":\\\"d8b7eeef-6a21-42af-8081-66dca85ec9df\\\",\\\"assignee\\\":\\\"Cooper Corbett\\\",\\\"assigneeId\\\":\\\"d8b7eeef-6a21-42af-8081-66dca85ec9df\\\",\\\"project\\\":\\\"Taxkit\\\",\\\"projectId\\\":\\\"4e0eb6ef-1871-46d4-8f47-9c8f52a9c069\\\",\\\"team\\\":\\\"Development\\\",\\\"teamId\\\":\\\"ed6b68f2-2ec2-4db2-983f-bdc5951dc79a\\\",\\\"relations\\\":{\\\"blocks\\\":[{\\\"id\\\":\\\"DEV-81\\\",\\\"title\\\":\\\"CSF-T010 — Finish rebuild checks, package versioning and controlled delivery\\\"}],\\\"blockedBy\\\":[{\\\"id\\\":\\\"DEV-75\\\",\\\"title\\\":\\\"CSF-T004 — Build all calculator pages and the fresh package interface\\\"},{\\\"id\\\":\\\"DEV-77\\\",\\\"title\\\":\\\"CSF-T006 — Add remote MCP and visible browser calculator tools\\\"},{\\\"id\\\":\\\"DEV-76\\\",\\\"title\\\":\\\"CSF-T005 — Rebuild docs, search discovery, public Markdown and share images\\\"}],\\\"relatedTo\\\":[],\\\"duplicateOf\\\":null}}\"}],\"isError\":false}}\n{\"i\":3,\"status\":\"fulfilled\",\"value\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"id\\\":\\\"DEV-80\\\",\\\"uuid\\\":\\\"17d02184-45d0-4203-9b86-963399b73dc3\\\",\\\"title\\\":\\\"CSF-T009 — Send safe logs, traces and metrics to the three shared Axiom datasets\\\",\\\"description\\\":\\\"## 8 October 2026 — current handover and metrics postponement\\\\n\\\\nCooper deferred metrics on 6 October because the approach may change. T009 remains queued and incomplete. Revisit the design with Cooper before implementation or any Axiom/provider operation; this handover changes no shared datasets, credentials, retention or signal collection.\\\\n\\\\n<pull-request id=\\\\\\\"397baa65-c16b-498d-acd8-6129b4745683\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/review/dev-81-record-reviewed-handover-and-analytics-deferrals-cd08825ec160\\\\\\\">crcorbett/taxkit#170</pull-request> records the postponement in the SPEC, task list and active plan. [Exact handover evidence](<https://github.com/crcorbett/taxkit/blob/fc4da30fdc6797ebed905c79823ff5e9508d33ba/docs/documentation-audit/clean-slate-foundation/2026-10-08-review-handover.json>). <issue id=\\\\\\\"17d02184-45d0-4203-9b86-963399b73dc3\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/issue/DEV-80/csf-t009-send-safe-logs-traces-and-metrics-to-the-three-shared-axiom\\\\\\\">DEV-80</issue> remains Backlog with its existing dependencies and acceptance conditions. Earlier planning below is retained history.\\\\n\\\\nThis issue tracks `CSF-T009` in the clean-slate rebuild plan.\\\\n\\\\nThe account is limited to three datasets. TaxKit needs useful operational signals in the existing datasets without changing their ownership or sending calculation details.\\\\n\\\\nWork to do:\\\\n\\\\n* Reference the existing logs/traces/metrics outputs from CooperCorbettSiteCloudflare/prod. Do not create, adopt or change the shared datasets or their retention.\\\\n* Give TaxKit its own scoped ingest token, destinations and dashboards under the reviewed Alchemy plan.\\\\n* Use common project/app/stage fields so each signal can be filtered. Implement the agreed request/calculation logs, spans, counts and durations without unbounded metric labels.\\\\n* Keep one native trace owner and bounded Effect log/metric delivery for each request, with the correct encoding, endpoint and headers.\\\\n* Test application and automatic trace fields, including URLs and retained Cloudflare storage. If native tracing cannot meet the privacy contract, record the requirement as unmet and resolve the design rather than claiming completion.\\\\n\\\\nAccept when:\\\\n\\\\n* Exactly the three existing datasets are used and their ownership/retention is unchanged.\\\\n* Actual payload, identity, encoding and completion checks pass for logs, traces and metrics.\\\\n* No input or result details leak through automatic spans or logs. Safe tracing and exact provider indexing require actual evidence, not only an application allowlist.\\\\n\\\\nRequired commands are recorded in the owning task: `bun run test`, `bun run test:oxlint`, `bun run check-types`, `bun run build`, `bun run check:runbooks`, `bun run check:docs`, `bun run verification`.\\\\n\\\\nDepends on `CSF-T003`, `CSF-T004`, `CSF-T006`. These will also be saved as native issue blockers.\\\\n\\\\nThe rebuild is queued. Final shared understanding is still pending in the committed design; implementation and any provider apply have their own recorded approval requirements.\\\\n\\\\nOwning [task and checks](<https://github.com/crcorbett/taxkit/blob/8ed03f0e1a96d2cc258b68935b9f9be443666e1b/docs/product-specs/clean-slate-foundation.tasks.json#L668>), [design](<https://github.com/crcorbett/taxkit/blob/8ed03f0e1a96d2cc258b68935b9f9be443666e1b/docs/product-specs/clean-slate-foundation.md>) and [planning commit](<https://github.com/crcorbett/taxkit/commit/8ed03f0e1a96d2cc258b68935b9f9be443666e1b>).\\\",\\\"priority\\\":{\\\"value\\\":0,\\\"name\\\":\\\"No priority\\\"},\\\"url\\\":\\\"https://linear.app/coopers-personal/issue/DEV-80/csf-t009-send-safe-logs-traces-and-metrics-to-the-three-shared-axiom\\\",\\\"gitBranchName\\\":\\\"coopercorbett/dev-80-csf-t009-send-safe-logs-traces-and-metrics-to-the-three\\\",\\\"createdAt\\\":\\\"2026-10-04T00:15:37.419Z\\\",\\\"updatedAt\\\":\\\"2026-10-08T02:05:29.705Z\\\",\\\"archivedAt\\\":null,\\\"completedAt\\\":null,\\\"startedAt\\\":null,\\\"canceledAt\\\":null,\\\"dueDate\\\":null,\\\"slaStartedAt\\\":null,\\\"slaMediumRiskAt\\\":null,\\\"slaHighRiskAt\\\":null,\\\"slaBreachesAt\\\":null,\\\"status\\\":\\\"Backlog\\\",\\\"statusType\\\":\\\"backlog\\\",\\\"labels\\\":[\\\"analytics\\\",\\\"backend\\\",\\\"infra\\\"],\\\"attachments\\\":[],\\\"documents\\\":[],\\\"stateHistory\\\":[{\\\"state\\\":{\\\"id\\\":\\\"64be05ca-3288-4616-9b5b-4d0c8d805b56\\\",\\\"name\\\":\\\"Backlog\\\",\\\"type\\\":\\\"backlog\\\"},\\\"startedAt\\\":\\\"2026-10-04T00:15:37.419Z\\\",\\\"endedAt\\\":null}],\\\"createdBy\\\":\\\"Cooper Corbett\\\",\\\"createdById\\\":\\\"d8b7eeef-6a21-42af-8081-66dca85ec9df\\\",\\\"project\\\":\\\"Taxkit\\\",\\\"projectId\\\":\\\"4e0eb6ef-1871-46d4-8f47-9c8f52a9c069\\\",\\\"team\\\":\\\"Development\\\",\\\"teamId\\\":\\\"ed6b68f2-2ec2-4db2-983f-bdc5951dc79a\\\",\\\"relations\\\":{\\\"blocks\\\":[{\\\"id\\\":\\\"DEV-81\\\",\\\"title\\\":\\\"CSF-T010 — Finish rebuild checks, package versioning and controlled delivery\\\"}],\\\"blockedBy\\\":[{\\\"id\\\":\\\"DEV-75\\\",\\\"title\\\":\\\"CSF-T004 — Build all calculator pages and the fresh package interface\\\"},{\\\"id\\\":\\\"DEV-77\\\",\\\"title\\\":\\\"CSF-T006 — Add remote MCP and visible browser calculator tools\\\"},{\\\"id\\\":\\\"DEV-74\\\",\\\"title\\\":\\\"CSF-T003 — Make one calculator work through the separate website and backend\\\"}],\\\"relatedTo\\\":[],\\\"duplicateOf\\\":null}}\"}],\"isError\":false}}\n{\"i\":4,\"status\":\"fulfilled\",\"value\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"id\\\":\\\"DEV-81\\\",\\\"uuid\\\":\\\"d92d58fd-14d3-4911-bf79-e0a22f4613cc\\\",\\\"title\\\":\\\"CSF-T010 — Finish rebuild checks, package versioning and controlled delivery\\\",\\\"description\\\":\\\"## 8 October 2026 — reviewed handover delivered; full rebuild remains open\\\\n\\\\n<pull-request id=\\\\\\\"397baa65-c16b-498d-acd8-6129b4745683\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/review/dev-81-record-reviewed-handover-and-analytics-deferrals-cd08825ec160\\\\\\\">crcorbett/taxkit#170</pull-request>, stacked on <pull-request id=\\\\\\\"f2c8f9f4-d24d-40d2-9b7f-d7221f04abbe\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/review/dev-79-use-one-shared-posthog-project-and-close-rejected-requests-61d4c708ada1\\\\\\\">crcorbett/taxkit#169</pull-request>, delivers the current review and handover at commit `fc4da30fdc6797ebed905c79823ff5e9508d33ba`. The bounded independent review resolved two material documentation findings. All nine local release checks passed in 1,086.17 seconds, including fresh SDK package/downstream runs and both built website/API runs with all 22 cases. Package notes cover the ten-package breaking release group; version application and publication remain outside this work. [Exact source, checks and limits](<https://github.com/crcorbett/taxkit/blob/fc4da30fdc6797ebed905c79823ff5e9508d33ba/docs/documentation-audit/clean-slate-foundation/2026-10-08-review-handover.json>).\\\\n\\\\nPostHog/T008 is postponed by Cooper on 8 October; metrics/T009 remains deferred from 6 October. Collection stays off. The narrow Medicare correction was separately approved on 8 October and remains owned by <pull-request id=\\\\\\\"26906978-210f-4988-8a2b-c14dec4ac972\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/review/correct-2025-26-medicare-figures-and-accept-zero-annual-income-b88e5f113e32\\\\\\\">crcorbett/taxkit#168</pull-request>; this handover changes no tax values and does not integrate or accept that separate branch or its adad consumer work.\\\\n\\\\nThis completes the current bounded handover, not T010's full rebuild acceptance. <issue id=\\\\\\\"d92d58fd-14d3-4911-bf79-e0a22f4613cc\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/issue/DEV-81/csf-t010-finish-rebuild-checks-package-versioning-and-controlled\\\\\\\">DEV-81</issue> remains Backlog with its existing blockers and acceptance conditions. No merge, package version application, publication, deployment, billing, credential or provider operation is performed. Checks ran on this Mac under Cooper's direction because GitHub Actions credits are exhausted; no hosted CI success is claimed. Earlier progress below remains dated history.\\\\n\\\\nThis issue tracks `CSF-T010` in the clean-slate rebuild plan.\\\\n\\\\nThe rebuild is complete only when the agreed user journeys, package consumers, documentation and delivery checks work together.\\\\n\\\\nWork to do:\\\\n\\\\n* Reconcile all requirements, owners and useful old URLs. Remove only wiring listed for replacement and preserve recorded historical/recovery artifacts.\\\\n* Complete Changesets and the current ten-package fixed release-train consequences, including @taxkit/content, as owned by .changeset/config.json and docs/standards/versioning.md. Run packed SDK/downstream and local release checks; package publication is outside this planning scope.\\\\n* Check all calculator, docs/search/Markdown/share-image, remote/browser agent and analytics/privacy journeys. Obtain a fresh substantive review and resolve its findings.\\\\n* Prepare the exact provider plan and recovery steps. After separate approval, prove controlled Preview, actual provider events/signals and domains, then carry out any separately approved Production cutover.\\\\n* Keep failed or missing checks visible and close the active plan only when its accepted result is actually achieved.\\\\n\\\\nAccept when:\\\\n\\\\n* All required local checks and the substantive review pass, with current docs/runbooks and appropriate versioning.\\\\n* Preview/provider/DNS/Production claims have exact artifact identity, approval and independent readback.\\\\n* The user receives a working, reviewable replacement with clear remaining limits and a tested recovery path.\\\\n\\\\nRequired commands are recorded in the owning task: `bun run check:docs`, `bun run check:runbooks`, `bun run check:repository-paths`, `bun run test:skills`, `bun run format:check`, `bun run lint`, `bun run check-types`, `bun run test`, `bun run build`, `bun run sdk:check-packed-artifact`, `bun run sdk:validate-downstream`, `bun run release:check`, `bun run changeset:status`, `git diff --check`, `bun run verification`.\\\\n\\\\nDepends on `CSF-T007`, `CSF-T008`, `CSF-T009`. These will also be saved as native issue blockers.\\\\n\\\\nCooper admitted implementation on 4 October and separately approved qualified native Preview and Production deployments from this Mac on 7 October. The old whole-design confirmation hold is superseded. Final rebuild closeout still awaits completed T008 analytics and Cooper's deferred T009 telemetry decision. The tested relay app pair in draft <pull-request id=\\\\\\\"2f003fb5-eb4f-4680-b168-ce350fedbc77\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/review/dev-79-add-the-bounded-website-event-relay-b24ae5f3bb6d\\\\\\\">crcorbett/taxkit#167</pull-request> is delivered to Preview pr-167 and Production with collection off; this bounded delivery does not complete <issue id=\\\\\\\"d92d58fd-14d3-4911-bf79-e0a22f4613cc\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/issue/DEV-81/csf-t010-finish-rebuild-checks-package-versioning-and-controlled\\\\\\\">DEV-81</issue>. Merge, package version application, publication, credential creation and unrelated provider changes still require their own concrete authority.\\\\n\\\\nOwning [task and checks](<https://github.com/crcorbett/taxkit/blob/da94a2f736b07210bf27b8b467f5d74304d35456/docs/product-specs/clean-slate-foundation.tasks.json#L846>), [design](<https://github.com/crcorbett/taxkit/blob/da94a2f736b07210bf27b8b467f5d74304d35456/docs/product-specs/clean-slate-foundation.md>) and [planning commit](<https://github.com/crcorbett/taxkit/commit/8ed03f0e1a96d2cc258b68935b9f9be443666e1b>).\\\\n\\\\nCurrent intent-owner reconciliation is checked and pushed in draft <pull-request id=\\\\\\\"2f003fb5-eb4f-4680-b168-ce350fedbc77\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/review/dev-79-add-the-bounded-website-event-relay-b24ae5f3bb6d\\\\\\\">crcorbett/taxkit#167</pull-request>, commit `da94a2f736b07210bf27b8b467f5d74304d35456`. Fresh full local verification passed in 676.83 seconds, including all 34 isolated workflow cases and all 22 freshly built app cases. Documentation/runbook/path/format/Changeset checks pass. All task statuses, dependencies, required checks and acceptance conditions are preserved. [Bounded record and proof limits](<https://github.com/crcorbett/taxkit/blob/da94a2f736b07210bf27b8b467f5d74304d35456/docs/exec-plans/active/clean-slate-foundation.md#continuation-owner-reconciliation>). Final independent review, completed analytics and the deferred telemetry requirement remain outstanding; this progress does not accept <issue id=\\\\\\\"d92d58fd-14d3-4911-bf79-e0a22f4613cc\\\\\\\" href=\\\\\\\"https://linear.app/coopers-personal/issue/DEV-81/csf-t010-finish-rebuild-checks-package-versioning-and-controlled\\\\\\\">DEV-81</issue> or the overall rebuild.\\\",\\\"priority\\\":{\\\"value\\\":0,\\\"name\\\":\\\"No priority\\\"},\\\"url\\\":\\\"https://linear.app/coopers-personal/issue/DEV-81/csf-t010-finish-rebuild-checks-package-versioning-and-controlled\\\",\\\"gitBranchName\\\":\\\"coopercorbett/dev-81-csf-t010-finish-rebuild-checks-package-versioning-and\\\",\\\"createdAt\\\":\\\"2026-10-04T00:16:01.793Z\\\",\\\"updatedAt\\\":\\\"2026-10-08T02:09:17.480Z\\\",\\\"archivedAt\\\":null,\\\"completedAt\\\":null,\\\"startedAt\\\":null,\\\"canceledAt\\\":null,\\\"dueDate\\\":null,\\\"slaStartedAt\\\":null,\\\"slaMediumRiskAt\\\":null,\\\"slaHighRiskAt\\\":null,\\\"slaBreachesAt\\\":null,\\\"status\\\":\\\"Backlog\\\",\\\"statusType\\\":\\\"backlog\\\",\\\"labels\\\":[\\\"docs\\\",\\\"infra\\\"],\\\"attachments\\\":[{\\\"id\\\":\\\"adcb2cb6-15dd-4bd6-be8b-c839b3dbcb43\\\",\\\"title\\\":\\\"DEV-81: Record reviewed handover and analytics deferrals\\\",\\\"subtitle\\\":null,\\\"url\\\":\\\"https://github.com/crcorbett/taxkit/pull/170\\\"}],\\\"documents\\\":[],\\\"stateHistory\\\":[{\\\"state\\\":{\\\"id\\\":\\\"64be05ca-3288-4616-9b5b-4d0c8d805b56\\\",\\\"name\\\":\\\"Backlog\\\",\\\"type\\\":\\\"backlog\\\"},\\\"startedAt\\\":\\\"2026-10-04T00:16:01.793Z\\\",\\\"endedAt\\\":null}],\\\"createdBy\\\":\\\"Cooper Corbett\\\",\\\"createdById\\\":\\\"d8b7eeef-6a21-42af-8081-66dca85ec9df\\\",\\\"project\\\":\\\"Taxkit\\\",\\\"projectId\\\":\\\"4e0eb6ef-1871-46d4-8f47-9c8f52a9c069\\\",\\\"team\\\":\\\"Development\\\",\\\"teamId\\\":\\\"ed6b68f2-2ec2-4db2-983f-bdc5951dc79a\\\",\\\"relations\\\":{\\\"blocks\\\":[],\\\"blockedBy\\\":[{\\\"id\\\":\\\"DEV-80\\\",\\\"title\\\":\\\"CSF-T009 — Send safe logs, traces and metrics to the three shared Axiom datasets\\\"},{\\\"id\\\":\\\"DEV-79\\\",\\\"title\\\":\\\"CSF-T008 — Track visits and calculator choice with minimal PostHog events\\\"},{\\\"id\\\":\\\"DEV-78\\\",\\\"title\\\":\\\"CSF-T007 — Prepare Alchemy domain, DNS and Doppler plans\\\"}],\\\"relatedTo\\\":[],\\\"duplicateOf\\\":null}}\"}],\"isError\":false}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a119a1-b5ae-7cf0-a81d-8528237cff7c","create_time":1791432494.474326}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
