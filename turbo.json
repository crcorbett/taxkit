{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    ".bun-version",
    "tsconfig.base.json",
    "tsconfig.alchemy.json"
  ],
  "globalEnv": ["CI"],
  "remoteCache": {
    "enabled": true,
    "timeout": 10,
    "uploadTimeout": 20
  },
  "tasks": {
    "api#build": {
      "dependsOn": ["^build"],
      "env": [
        "ALCHEMY_CLOUDFLARE_VITE_INJECTED",
        "NODE_ENV",
        "TAXKIT_API_BASE_URL",
        "VITE_*"
      ],
      "outputs": ["dist/**", "src/generated/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/docs/**"]
    },
    "api#check-types": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "api#test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/docs/**"],
      "outputs": []
    },
    "web#build": {
      "dependsOn": ["^build"],
      "env": [
        "ALCHEMY_CLOUDFLARE_VITE_INJECTED",
        "NODE_ENV",
        "TAXKIT_API_BASE_URL",
        "VITE_*"
      ],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**", "public/og/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/docs/**"]
    },
    "web#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/docs/**"],
      "outputs": []
    },
    "@taxkit/docs-examples#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/docs/**"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "ALCHEMY_CLOUDFLARE_VITE_INJECTED",
        "NODE_ENV",
        "TAXKIT_API_BASE_URL",
        "VITE_*"
      ],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**", "public/og/**"]
    },
    "check-types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check-packed-artifact": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "validate:downstream": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "smoke": {
      "dependsOn": ["build"],
      "env": ["TAXKIT_API_SMOKE_PORT"],
      "outputs": []
    },
    "test:browser": {
      "dependsOn": ["build"],
      "env": ["PLAYWRIGHT_BROWSERS_PATH"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
