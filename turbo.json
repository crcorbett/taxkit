{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    ".bun-version",
    "tsconfig.base.json",
    "tsconfig.alchemy.json"
  ],
  "globalEnv": ["CI"],
  "remoteCache": {
    "enabled": true,
    "timeout": 10,
    "uploadTimeout": 20
  },
  "tasks": {
    "@taxkit/docs-content#build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "PLAYWRIGHT_BROWSERS_PATH"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/docs-examples/src/**",
        "$TURBO_ROOT$/packages/docs-examples/test/**"
      ],
      "outputs": [".source/**"]
    },
    "@taxkit/docs-content#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/docs-examples/src/**",
        "$TURBO_ROOT$/packages/docs-examples/test/**"
      ],
      "outputs": []
    },
    "@taxkit/docs-content#validate": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/docs-examples/src/**",
        "$TURBO_ROOT$/packages/docs-examples/test/**"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "ALCHEMY_CLOUDFLARE_VITE_INJECTED",
        "NODE_ENV",
        "PLAYWRIGHT_BROWSERS_PATH",
        "TAXKIT_API_BASE_URL",
        "VITE_*"
      ],
      "outputs": [
        "dist/**",
        ".source/**",
        ".output/**",
        ".vercel/output/**",
        "public/og/**"
      ]
    },
    "generate": {
      "dependsOn": ["^build"],
      "inputs": [
        "content/**",
        "navigation.json",
        "source.config.ts",
        "src/**",
        "package.json"
      ],
      "outputs": [".source/**"]
    },
    "check-types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "validate": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check-packed-artifact": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "validate:downstream": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "smoke": {
      "dependsOn": ["build"],
      "env": ["TAXKIT_API_SMOKE_PORT"],
      "outputs": []
    },
    "test:browser": {
      "dependsOn": ["build"],
      "env": ["PLAYWRIGHT_BROWSERS_PATH"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
