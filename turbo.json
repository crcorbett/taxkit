{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    ".bun-version",
    "tsconfig.base.json",
    "tsconfig.alchemy.json"
  ],
  "globalEnv": [
    "CI"
  ],
  "remoteCache": {
    "enabled": true,
    "timeout": 10,
    "uploadTimeout": 20
  },
  "tasks": {
    "@taxkit/docs-content#build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NODE_ENV",
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/documentation/catalogue.*",
        "$TURBO_ROOT$/tools/documentation/schemas.ts",
        "$TURBO_ROOT$/tools/documentation/owner-policy.json",
        "$TURBO_ROOT$/docs/documentation-audit/clean-slate-foundation/public-content-acceptance/**/*.json"
      ],
      "outputs": [
        ".source/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "ALCHEMY_CLOUDFLARE_VITE_INJECTED",
        "NODE_ENV",
        "PLAYWRIGHT_BROWSERS_PATH",
        "TAXKIT_API_BASE_URL",
        "VITE_*"
      ],
      "outputs": [
        "dist/**",
        ".source/**",
        ".output/**",
        ".vercel/output/**",
        "public/og/**"
      ]
    },
    "generate": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "content/**",
        "navigation.json",
        "source.config.ts",
        "src/**",
        "package.json"
      ],
      "outputs": [
        ".source/**"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "validate": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "check-packed-artifact": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "validate:downstream": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "smoke": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "TAXKIT_API_SMOKE_PORT"
      ],
      "outputs": []
    },
    "test:browser": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "outputs": []
    },
    "//#check:docs:task": {
      "outputs": [
        "tmp/docs-policy-report.json"
      ]
    },
    "//#check:runbooks:task": {
      "outputs": [
        "tmp/runbook-validation-report.json"
      ]
    },
    "//#knip:task": {
      "dependsOn": [
        "@taxkit/docs-content#build"
      ],
      "outputs": []
    },
    "//#knip:production:task": {
      "dependsOn": [
        "@taxkit/docs-content#build"
      ],
      "outputs": []
    },
    "//#check:docs-deployment:task": {
      "outputs": []
    },
    "//#check:docs-deployment-automation:task": {
      "outputs": []
    },
    "//#check:docs-deployment-inventory:task": {
      "cache": false,
      "passThroughEnv": [
        "ALCHEMY_PROFILE",
        "CLOUDFLARE_*",
        "TAXKIT_*"
      ]
    },
    "//#check:docs-deployment-workflow-proof:task": {
      "cache": false,
      "passThroughEnv": [
        "TAXKIT_*"
      ]
    },
    "//#check:docs-deployment-workflow-input:task": {
      "cache": false,
      "passThroughEnv": [
        "TAXKIT_*"
      ]
    },
    "//#check:docs-deployment-workflow-run:task": {
      "cache": false,
      "passThroughEnv": [
        "TAXKIT_*"
      ]
    },
    "//#check:docs-deployment-workflow-plan:task": {
      "cache": false,
      "passThroughEnv": [
        "TAXKIT_*"
      ]
    },
    "//#check:docs-deployment-workflow-teardown-proof:task": {
      "cache": false,
      "passThroughEnv": [
        "TAXKIT_*"
      ]
    },
    "//#check:docs-deployment:types:task": {
      "outputs": []
    },
    "//#check:docs-deployment-tools:types:task": {
      "outputs": []
    },
    "//#check:oxlint:types:task": {
      "outputs": []
    },
    "//#check:docs:types:task": {
      "outputs": [],
      "dependsOn": [
        "@taxkit/docs-content#build"
      ]
    },
    "//#check:effect-language-service:task": {
      "outputs": []
    },
    "//#check:harness-governance:task": {
      "outputs": []
    },
    "//#check:repository-paths:task": {
      "outputs": []
    },
    "//#check:repository-paths:types:task": {
      "outputs": []
    },
    "//#check:quality-workflow:task": {
      "outputs": []
    },
    "//#check:quality-workflow:types:task": {
      "outputs": []
    },
    "//#format:check:task": {
      "outputs": []
    },
    "//#lint:task": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".agents/skills/strict-effect-ts/assets/oxlint/effect-policy.ts"
      ],
      "outputs": []
    },
    "//#test:documentation:task": {
      "outputs": []
    },
    "//#test:docs-deployment:task": {
      "outputs": []
    },
    "//#test:oxlint:task": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".agents/skills/strict-effect-ts/assets/oxlint/effect-policy.ts"
      ],
      "outputs": []
    },
    "//#test:repository-paths:task": {
      "outputs": []
    },
    "//#test:quality-workflow:task": {
      "env": [
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "outputs": []
    },
    "//#changeset:status:task": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
