  "ownership": {
    "runtime": "Native Alchemy API instance/request owner; lazy protocol host is built once in its instance scope after native origins resolve",
    "protocol": "Installed Effect McpServer/Toolkit, only v2026_07_28 composed at /mcp; native JSON/SSE frames and per-request metadata",
    "contracts": "Canonical calculator/content Schemas and captured named services; MCP owns only the search-result envelope around the canonical content result Schema. Toolkit stays private. No independent engine, saved personal report or public package export.",
