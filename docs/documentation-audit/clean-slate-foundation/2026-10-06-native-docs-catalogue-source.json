  "outcome": [
    "Independent native Fumadocs index and Bun compiler connection use the same checked generated collection adapter as the retained Vite source.",
    "The local repository builder requires version-two acceptance records with reviewed source hashes, reads decisions before loading the compiler, verifies source bytes and decisions again before output, and constructs the canonical catalogue.",
    "Missing acceptance, zero accepted pages, changed source bytes, duplicate bindings, wrong owners or targets, outside-checkout paths, draft navigation and an accepted child under a draft section fail.",
    "The existing version-one record representation round-trips unchanged. Regular docs checks verify version-two source hashes.",
    "Five named copied TypeScript fences match compiled source/test owners. The four original integration templates retain their parent bytes and weekly-pay oracle.",
    "A clean index regeneration and the actual native source connection process all 61 authored draft pages with non-empty processed Markdown.",
    "The fresh source-only checkout documentation oracle passes after explicit source-export selection."
  ],
  "impact": {
    "changeRequired": [
      "content and docs-content contracts, compiler connection, generated outputs and READMEs",
      "checked examples, Node ambient types and copied-fence prevention",
      "corrected public MDX and SDK/content/package/documentation architecture",
      "root command, workspace dependencies, generated input/type prerequisites and exact lint admissions",
      "Changeset, active plan and this bounded receipt"
    ],
    "preserve": [
      "all authored draft statuses and empty acceptance bindings",
      "retained Vite docs app and historical receipts",
      "tax results and original integration-template bytes",
      "selected dependency versions and canonical skills",
      "Cooper metrics deferral"
    ],
    "notApplicable": [
      "provider operations",
      "publication or deployment",
      "runbook procedure changes"
    ]
  },
