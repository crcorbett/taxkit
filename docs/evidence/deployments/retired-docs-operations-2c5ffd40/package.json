{
  "name": "taxkit",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/api/*",
      "packages/sdk/*",
      "packages/rules/au/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0",
      "@effect/platform-node": "4.0.0",
      "@effect/vitest": "4.0.0",
      "@cloudflare/vite-plugin": "1.62.5",
      "@tanstack/react-router": "1.170.41",
      "@tanstack/react-start": "1.168.60",
      "@types/bun": "1.4.2",
      "@types/node": "26.6.4",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.1",
      "alchemy": "2.0.0-beta.80",
      "effect": "4.0.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "typescript": "7.0.2",
      "vite": "8.3.2",
      "vitest": "5.0.3",
      "wrangler": "4.147.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "ultracite check --type-aware",
    "check:docs": "turbo run //#check:docs:task",
    "check:docs:task": "bun --conditions=source run tools/documentation/check.runtime.ts",
    "check:docs-deployment": "turbo run //#check:docs-deployment:task",
    "check:docs-deployment:task": "bun --conditions=source run tools/docs-deployment/check.runtime.ts",
    "check:docs-deployment-automation": "turbo run //#check:docs-deployment-automation:task",
    "check:docs-deployment-automation:task": "bun --conditions=source run tools/docs-deployment/automation.check.runtime.ts",
    "check:docs-deployment-inventory": "CI=1 turbo run //#check:docs-deployment-inventory:task",
    "check:docs-deployment-inventory:task": "bun --conditions=source run tools/docs-deployment/inventory.runtime.ts",
    "check:docs-deployment-workflow-proof": "turbo run //#check:docs-deployment-workflow-proof:task",
    "check:docs-deployment-workflow-proof:task": "bun --conditions=source run tools/docs-deployment/workflow-proof-check.runtime.ts",
    "check:docs-deployment-workflow-input": "turbo run //#check:docs-deployment-workflow-input:task",
    "check:docs-deployment-workflow-input:task": "bun --conditions=source run tools/docs-deployment/workflow-input-check.runtime.ts",
    "check:docs-deployment-workflow-run": "turbo run //#check:docs-deployment-workflow-run:task",
    "check:docs-deployment-workflow-run:task": "bun --conditions=source run tools/docs-deployment/workflow-run-check.runtime.ts",
    "check:docs-deployment-workflow-plan": "turbo run //#check:docs-deployment-workflow-plan:task",
    "check:docs-deployment-workflow-plan:task": "bun --conditions=source run tools/docs-deployment/workflow-plan-check.runtime.ts",
    "check:docs-deployment-workflow-teardown-proof": "turbo run //#check:docs-deployment-workflow-teardown-proof:task",
    "check:docs-deployment-workflow-teardown-proof:task": "bun --conditions=source run tools/docs-deployment/workflow-teardown-proof-check.runtime.ts",
    "check:docs-deployment:types": "turbo run //#check:docs-deployment:types:task",
    "check:docs-deployment:types:task": "tsc --noEmit -p tsconfig.alchemy.json",
    "check:doppler-custody": "bun --no-env-file run tools/docs-deployment/doppler-custody.runtime.ts",
    "check:docs-deployment-tools:types": "turbo run //#check:docs-deployment-tools:types:task",
    "check:docs-deployment-tools:types:task": "tsc --noEmit -p tools/docs-deployment/tsconfig.json",
    "check:skills:types": "turbo run //#check:skills:types:task",
    "check:skills:types:task": "tsc --noEmit -p tools/skills/tsconfig.json",
    "check:oxlint:types": "turbo run //#check:oxlint:types:task",
    "check:oxlint:types:task": "tsc --noEmit -p tools/oxlint/tsconfig.json",
    "check:docs:types": "turbo run //#check:docs:types:task",
    "check:docs:types:task": "tsc --noEmit -p tools/documentation/tsconfig.json",
    "check:effect-language-service": "turbo run //#check:effect-language-service:task",
    "check:effect-language-service:task": "effect-tsgo diagnostics --project tools/effect-language-service/tsconfig.json && tsc --noEmit -p tools/effect-language-service/tsconfig.json",
    "check:harness-governance": "turbo run //#check:harness-governance:task",
    "check:harness-governance:task": "bun --conditions=source run tools/governance/check.runtime.ts",
    "check:harness-governance:types": "tsc --noEmit -p tools/governance/tsconfig.json",
    "check:harness-foundation-epoch": "bun --conditions=source run tools/evals/harness-foundation/check.runtime.ts",
    "check:harness-foundation-epoch:types": "tsc --noEmit -p tools/evals/tsconfig.json",
    "check:hgi-206": "bun --conditions=source run tools/evals/hgi-206/check.runtime.ts",
    "check:runbooks": "turbo run //#check:runbooks:task",
    "check:runbooks:task": "bun --conditions=source run tools/documentation/runbook-check.runtime.ts",
    "check-types": "turbo run check-types",
    "check:repository-paths": "turbo run //#check:repository-paths:task",
    "check:repository-paths:task": "bun run tools/repository-paths/check.runtime.ts",
    "check:repository-paths:types": "turbo run //#check:repository-paths:types:task",
    "check:repository-paths:types:task": "tsc --noEmit -p tools/repository-paths/tsconfig.json",
    "check:quality-workflow": "turbo run //#check:quality-workflow:task",
    "check:quality-workflow:task": "bun run tools/quality-workflow/check.runtime.ts",
    "check:quality-workflow:types": "turbo run //#check:quality-workflow:types:task",
    "check:quality-workflow:types:task": "tsc --noEmit -p tools/quality-workflow/tsconfig.json",
    "clean": "turbo run clean",
    "dev": "turbo run build --filter=api && CI=1 ALCHEMY_HOME=.alchemy/native-apps-auth ALCHEMY_TELEMETRY_DISABLED=1 BUN_OPTIONS=\"--conditions=source --no-env-file\" bun run node_modules/alchemy/bin/cli.js dev --config alchemy.apps.local.run.ts --env-file tools/apps-local/no-local-env --stage dev_native_apps",
    "docs:build": "turbo run build --filter=docs",
    "docs:dev:cloudflare": "bun --no-env-file run tools/docs-deployment/local-doppler.runtime.ts",
    "docs:dev:cloudflare:internal": "alchemy dev --env-file tools/docs-deployment/no-local-env",
    "docs:dev:vite": "bun run --filter=docs dev:vite",
    "docs:validate": "turbo run validate --filter=@taxkit/docs-content",
    "fix": "ultracite fix --type-aware",
    "format": "oxfmt -c oxfmt.config.ts --write . --no-error-on-unmatched-pattern",
    "format:check": "turbo run //#format:check:task",
    "format:check:task": "oxfmt -c oxfmt.config.ts --check . --no-error-on-unmatched-pattern",
    "knip": "turbo run //#knip:task",
    "knip:task": "knip --no-progress --no-config-hints",
    "knip:production": "turbo run //#knip:production:task",
    "knip:production:task": "knip --production --config knip.production.json --no-gitignore --no-progress --no-config-hints",
    "lint": "turbo run //#lint:task",
    "lint:task": "bun run lint:boundary-directives && oxlint -c oxlint.config.ts . --disable-nested-config --no-error-on-unmatched-pattern",
    "lint:boundary-directives": "oxlint -c oxlint.config.ts . --allow=taxkit/no-decoding-outside-boundaries --allow=taxkit/no-route-transport-restore-outside-consumers --report-unused-disable-directives-severity=error --disable-nested-config --no-error-on-unmatched-pattern",
    "prepare": "effect-tsgo patch",
    "release:check": "bun run --filter=@taxkit/scripts release:check",
    "release:present": "bun run --filter=@taxkit/scripts release:present",
    "test": "bun run test:documentation && bun run test:repository-paths && bun run test:docs-boundaries && bun run test:oxlint && turbo run test",
    "test:documentation": "turbo run //#test:documentation:task",
    "test:documentation:task": "bun --bun vitest run --config tools/vitest.config.ts tools/documentation",
    "test:docs-deployment": "turbo run //#test:docs-deployment:task",
    "test:docs-deployment:task": "bun --conditions=source node_modules/vitest/vitest.mjs run --config tools/vitest.config.ts tools/docs-deployment",
    "test:docs-boundaries": "turbo run //#test:docs-boundaries:task",
    "test:docs-boundaries:task": "bun run --filter=docs check-import-boundaries && bun run --filter=docs test",
    "test:hgi-206": "bun --bun vitest run --config tools/vitest.config.ts tools/evals/hgi-206",
    "test:harness-governance": "bun --bun vitest run --config tools/vitest.config.ts tools/governance",
    "test:oxlint": "turbo run //#test:oxlint:task",
    "test:oxlint:task": "bun --bun vitest run --config tools/vitest.config.ts tools/oxlint",
    "test:repository-paths": "turbo run //#test:repository-paths:task",
    "test:repository-paths:task": "bun --bun vitest run --config tools/vitest.config.ts tools/repository-paths",
    "test:quality-workflow": "turbo run //#test:quality-workflow:task",
    "test:quality-workflow:task": "bun --bun vitest run --config tools/vitest.config.ts tools/quality-workflow",
    "test:skills": "turbo run //#test:skills:task",
    "test:skills:task": "bun --bun vitest run --config tools/vitest.config.ts tools/skills",
    "test:release-readiness": "bun run --filter=@taxkit/scripts test -- release-readiness",
    "sdk:check-packed-artifact": "turbo run check-packed-artifact --filter=@taxkit/sdk",
    "sdk:validate-downstream": "turbo run validate:downstream --filter=@taxkit/sdk",
    "api:smoke": "turbo run smoke --filter=api",
    "docs:test:browser": "turbo run test:browser --filter=docs",
    "changeset:status": "turbo run //#changeset:status:task",
    "changeset:status:task": "changeset status --verbose",
    "verification": "bun run check:skills:types && bun run check:oxlint:types && bun run check:repository-paths:types && bun run check:repository-paths && bun run check:harness-governance && bun run check:quality-workflow:types && bun run check:quality-workflow && bun run check:docs:types && bun run check:harness-foundation-epoch:types && bun run check:docs && bun run check:runbooks && bun run check:effect-language-service && bun run check:docs-deployment:types && bun run check:docs-deployment-tools:types && bun run check:docs-deployment && bun run check:docs-deployment-automation && bun run test:docs-deployment && bun run lint && bun run format:check && bun run test:skills && bun run test:hgi-206 && bun run test:quality-workflow && bun run knip && bun run knip:production && bun run check-types && bun run sdk:test:browser && bun run web:test:browser && bun run --filter=web check:worker-types && bun run web:test:native-pair",
    "version-packages": "changeset version",
    "version-repo": "changeset version",
    "web:test:browser": "turbo run test:browser --filter=web",
    "sdk:test:browser": "turbo run test:browser --filter=@taxkit/sdk",
    "web:test:native-pair": "bun run --filter=web build:native-pair && bun run --filter=web test:native-pair",
    "docs:catalogue": "bun run --filter=@taxkit/docs-content generate && bun --conditions=source run tools/documentation/catalogue.runtime.ts"
  },
  "dependencies": {
    "@taxkit/infrastructure": "workspace:*",
    "alchemy": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.48.0",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.86.0",
    "@taxkit/content": "workspace:*",
    "@taxkit/docs-content": "workspace:*",
    "@taxkit/scripts": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/typescript6": "6.0.2",
    "effect": "catalog:",
    "knip": "6.39.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "portless": "0.15.7",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "ultracite": "7.12.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0",
    "@effect/sql-d1": "4.0.0",
    "@effect/sql-sqlite-do": "4.0.0",
    "workerd": "1.20261001.1"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.16.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@effect/atom-react@4.0.0": "patches/@effect%2Fatom-react@4.0.0.patch",
    "alchemy@2.0.0-beta.80": "patches/alchemy@2.0.0-beta.80.patch"
  }
}
