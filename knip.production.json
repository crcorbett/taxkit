{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreWorkspaces": ["packages/tsconfig"],
  "ignoreIssues": {
    "packages/api/http/src/client/service.ts": ["duplicates"],
    "packages/scripts/src/release-readiness/evidence.boundary.ts": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "alchemy.run.ts!",
        "alchemy.apps.run.ts!",
        "alchemy.apps.local.run.ts!"
      ],
      "project": ["alchemy.run.ts!"]
    },
    "apps/docs": {
      "entry": [
        "src/router.tsx!",
        "src/server.ts!",
        "src/routes/**/*.{ts,tsx}!",
        "vite.config.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "!src/**/*.test.ts!",
        "!src/**/*.type-test.ts!",
        "vite.config.ts!"
      ],
      "vite": false
    },
    "apps/api": {
      "entry": ["src/index.ts!", "src/worker.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/api/http": {
      "entry": [
        "src/index.ts!",
        "src/api.ts!",
        "src/client/index.ts!",
        "src/client/live.layer.ts!",
        "src/client/server.layer.ts!",
        "src/config.ts!",
        "src/server.ts!",
        "src/handlers/index.ts!",
        "src/handlers/live.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "packages/calculators": {
      "entry": [
        "src/index.ts!",
        "src/catalog.ts!",
        "src/errors.ts!",
        "src/metadata.ts!",
        "src/service.ts!",
        "src/live.layer.ts!",
        "src/schemas.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "packages/core": {
      "entry": [
        "src/index.ts!",
        "src/primitives/index.ts!",
        "src/facts/index.ts!",
        "src/parameters/index.ts!",
        "src/errors/index.ts!",
        "src/engine/index.ts!",
        "src/rules/index.ts!",
        "src/graph/index.ts!",
        "src/trace/index.ts!",
        "src/ledger/index.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "packages/docs-content": {
      "entry": [
        "source.config.ts!",
        "src/client.ts!",
        "src/errors.ts!",
        "src/generated-source.layer.ts!",
        "src/live.layer.ts!",
        "src/schemas.ts!",
        "src/server.ts!",
        "src/service.ts!",
        "src/validate.runtime.ts!"
      ],
      "project": [
        ".source/browser.ts!",
        ".source/server.ts!",
        "source.config.ts!",
        "src/**/*.ts!",
        "!src/**/*.test.ts!",
        "!src/test.layer.ts!"
      ],
      "ignoreDependencies": ["vite/client"]
    },
    "packages/docs-fumadocs": {
      "entry": [
        "src/config.ts!",
        "src/errors.ts!",
        "src/live.layer.ts!",
        "src/render/index.ts!",
        "src/schemas.ts!",
        "src/service.ts!"
      ],
      "project": ["src/**/*.ts!", "!src/**/*.test.ts!", "!src/test.layer.ts!"]
    },
    "packages/rules/au/income-tax": {
      "entry": [
        "src/index.ts!",
        "src/facts/index.ts!",
        "src/parameters/index.ts!",
        "src/rules/index.ts!",
        "src/rule-pack/index.ts!",
        "src/calculator/index.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "packages/rules/au/pay": {
      "entry": [
        "src/index.ts!",
        "src/facts/index.ts!",
        "src/parameters/index.ts!",
        "src/rules/index.ts!",
        "src/calculator/index.ts!",
        "src/rule-pack/index.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "packages/rules/au/stsl": {
      "entry": [
        "src/index.ts!",
        "src/facts/index.ts!",
        "src/parameters/index.ts!",
        "src/rules/index.ts!",
        "src/rule-pack/index.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "packages/scripts": {
      "entry": [
        "src/index.ts!",
        "src/release-readiness/present.runtime.ts!",
        "src/release-readiness/release-readiness.runtime.ts!"
      ],
      "project": ["src/**/*.ts!", "!src/release-readiness/test.layer.ts!"]
    },
    "packages/sdk/typescript": {
      "entry": [
        "src/index.ts!",
        "src/effect.ts!",
        "src/au.ts!",
        "src/au-effect.ts!",
        "src/schemas/index.ts!",
        "src/testing/index.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "packages/testing": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/api/rpc": {
      "entry": [
        "src/group.ts!",
        "src/handlers.ts!",
        "src/service.ts!",
        "src/server.ts!",
        "src/live.layer.ts!",
        "src/schemas.ts!",
        "src/errors.ts!",
        "src/request-boundary.ts!",
        "src/host-telemetry.ts!"
      ],
      "project": ["src/**/*.ts!", "!src/__testing__/**!", "!src/test.layer.ts!"]
    },
    "apps/web": {
      "entry": [
        "src/router.tsx!",
        "src/server.ts!",
        "src/routes/**/*.{ts,tsx}!",
        "vite.config.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "!src/**/*.test.ts!",
        "!src/**/*.browser.test.tsx!",
        "vite.config.ts!"
      ],
      "vite": false,
      "ignoreDependencies": ["cloudflare"],
      "ignoreExportsUsedInFile": true
    },
    "packages/docs-examples": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/content": {
      "entry": [
        "src/schemas.ts!",
        "src/errors.ts!",
        "src/service.ts!",
        "src/live.layer.ts!"
      ],
      "project": ["src/**/*.ts!", "!src/test.layer.ts!", "!src/__testing__/**!"]
    }
  }
}
