{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "alchemy.run.ts!",
        "alchemy.posthog.run.ts!",
        "alchemy.axiom.run.ts!",
        "alchemy.trace.run.ts!"
      ],
      "project": ["alchemy*.ts!"]
    },
    "apps/api": {
      "entry": ["src/index.ts!", "src/worker.ts!", "src/server.ts!"],
      "project": ["src/**/*.ts!", "!src/build/**!", "!src/verification/**!"]
    },
    "apps/web": {
      "entry": [
        "src/router.tsx!",
        "src/entry.server.ts!",
        "src/routes/**/*.{ts,tsx}!",
        "vite.config.ts!"
      ],
      "project": ["src/**/*.{ts,tsx}!", "vite.config.ts!"],
      "vite": false,
      "ignoreDependencies": ["cloudflare"],
      "ignoreExportsUsedInFile": true
    },
    "packages/docs-examples": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/sdk/typescript": {
      "entry": [
        "src/index.ts!",
        "src/effect.ts!",
        "src/au.ts!",
        "src/au-effect.ts!",
        "src/schemas/index.ts!",
        "src/testing/index.ts!",
        "src/core.ts!",
        "src/http.ts!",
        "src/money.ts!",
        "src/money/effect.ts!",
        "src/au/schemas.ts!"
      ],
      "project": ["src/**/*.ts!", "!src/internal/artifact-schemas.ts!"]
    },
    "packages/*": {
      "project": [
        "src/**/*.{ts,tsx}!",
        "!src/__testing__/**!",
        "!src/test.layer.ts!",
        "!src/**/test.layer.ts!"
      ]
    },
    "packages/{api,rules/au}/*": {
      "project": ["src/**/*.ts!", "!src/__testing__/**!", "!src/test.layer.ts!"]
    }
  }
}
