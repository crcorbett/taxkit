{
  "name": "@taxkit/workspace",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "content/*",
      "packages/*",
      "packages/api/*",
      "packages/sdk/*",
      "packages/rules/au/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.1.2",
      "@effect/platform-browser": "4.1.2",
      "@effect/platform-node": "4.1.2",
      "@effect/vitest": "4.1.2",
      "@cloudflare/vite-plugin": "1.65.0",
      "@tanstack/react-router": "1.170.46",
      "@tanstack/react-start": "1.169.4",
      "@types/bun": "1.4.4",
      "@types/node": "26.6.5",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.2",
      "alchemy": "2.0.0-beta.85",
      "effect": "4.1.2",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "typescript": "7.0.2",
      "vite": "8.3.5",
      "vitest": "5.0.5",
      "@alchemy.run/cloudflare": "2.0.0-beta.85",
      "@alchemy.run/axiom": "2.0.0-beta.85",
      "@alchemy.run/doppler": "2.0.0-beta.85",
      "@alchemy.run/frontend-frameworks": "2.0.0-beta.85",
      "@effect/atom-react": "4.1.2",
      "@base-ui/react": "1.9.0",
      "@modelcontextprotocol/client": "2.4.0",
      "@vitest/browser-playwright": "5.0.5",
      "lucide-react": "1.66.0",
      "playwright": "1.64.1",
      "yaml": "2.9.1",
      "webmcp-types": "0.1.10",
      "@cloudflare/workers-types": "5.20261109.1"
    }
  },
  "type": "module",
  "scripts": {
    "verification": "bun run build && bun run lint && turbo run check-types check-types:root knip test test:browser && turbo run test:tools test:native --concurrency=1",
    "build": "turbo run build",
    "lint": "bun run format:check && bun run lint:refresh && bun run lint:doctor && oxlint -c oxlint.config.ts . --type-aware --deny-warnings --report-unused-disable-directives-severity=error --disable-nested-config --no-error-on-unmatched-pattern && bun tools/documentation/check.runtime.ts && bun tools/repository-paths/check.runtime.ts",
    "check-types": "turbo run check-types check-types:root",
    "knip": "knip --no-progress --no-config-hints && knip --production --config knip.production.json --no-gitignore --no-progress --no-config-hints",
    "test": "turbo run test test:browser && turbo run test:tools test:native --concurrency=1",
    "format": "oxfmt -c oxfmt.config.ts --write . --no-error-on-unmatched-pattern",
    "fix": "bun run format && oxlint -c oxlint.config.ts . --type-aware --fix --disable-nested-config --no-error-on-unmatched-pattern",
    "format:check": "oxfmt -c oxfmt.config.ts --check . --no-error-on-unmatched-pattern",
    "lint:refresh": "bun update @commonplaces/oxlint-plugin --latest --no-save --no-cache --ignore-scripts && effect-tsgo patch --oxlint",
    "lint:doctor": "commonplace-lint-doctor",
    "check-types:root": "tsc --noEmit -p tsconfig.alchemy.json && tsc --noEmit -p tools/tsconfig.json",
    "test:tools": "bun --bun vitest run --config tools/vitest.config.ts --project tools",
    "test:native": "bun run build:native-pair && bun run test:native-pair",
    "build:native-pair": "turbo run build --filter=api && bun run tools/apps-local/native-pair-build.runtime.ts",
    "test:native-pair": "node node_modules/vitest/vitest.mjs run --config tools/vitest.config.ts --project native-pair",
    "prepare": "effect-tsgo patch --oxlint",
    "dev": "turbo run build --filter=api && CI=1 ALCHEMY_HOME=.alchemy/native-apps-auth ALCHEMY_TELEMETRY_DISABLED=1 BUN_OPTIONS=--no-env-file node --import ./node_modules/alchemy/bin/register-oxc.js node_modules/alchemy/bin/alchemy.js dev --stage dev_native_apps",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version-packages": "changeset version",
    "release:check": "bun run verification && bun run sdk:check-packed-artifact && bun run sdk:validate-downstream && bun run api:smoke && bun run changeset:status",
    "sdk:check-packed-artifact": "turbo run check-packed-artifact --filter=taxkit",
    "sdk:validate-downstream": "turbo run validate:downstream --filter=taxkit",
    "api:smoke": "turbo run smoke --filter=api",
    "pr:plan": "bun tools/infrastructure/preview-stage.runtime.ts plan",
    "pr:deploy": "bun tools/infrastructure/preview-stage.runtime.ts deploy",
    "pr:destroy": "bun tools/infrastructure/preview-stage.runtime.ts destroy",
    "production:plan": "bun run build --filter=api && alchemy plan --stage prod",
    "production:deploy": "bun run build && alchemy deploy --stage prod",
    "production:drift": "alchemy drift --stage prod",
    "axiom:plan": "alchemy plan --config alchemy.axiom.run.ts --stage prod",
    "axiom:deploy": "alchemy deploy --config alchemy.axiom.run.ts --stage prod",
    "posthog:plan": "alchemy plan --config alchemy.posthog.run.ts --stage prod",
    "trace:plan": "alchemy plan --config alchemy.trace.run.ts --stage prod",
    "trace:deploy": "alchemy deploy --config alchemy.trace.run.ts --stage prod"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@taxkit/infrastructure": "workspace:*",
    "alchemy": "catalog:",
    "api": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commonplaces/oxlint-plugin": "latest",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.67.5",
    "@effect/vitest": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@taxkit/analytics": "workspace:*",
    "@taxkit/api-http": "workspace:*",
    "@taxkit/api-mcp": "workspace:*",
    "@taxkit/calculators": "workspace:*",
    "@taxkit/content": "workspace:*",
    "@taxkit/observability": "workspace:*",
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "knip": "6.43.0",
    "miniflare": "5.20261023.1-beta",
    "oxfmt": "0.75.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "catalog:",
    "portless": "0.15.12",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.1.0",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.2",
    "@effect/sql-d1": "4.1.2",
    "@effect/sql-sqlite-do": "4.1.2",
    "@effect/tsgo": "0.67.5",
    "effect": "4.1.2",
    "workerd": "1.20261027.1"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24.16.0"
  },
  "packageManager": "bun@1.4.4"
}
