{
  "name": "taxkit",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/api/*",
      "packages/sdk/*",
      "packages/rules/au/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0",
      "@effect/platform-node": "4.0.0",
      "@effect/vitest": "4.0.0",
      "@cloudflare/vite-plugin": "1.62.5",
      "@tanstack/react-router": "1.170.41",
      "@tanstack/react-start": "1.168.60",
      "@types/bun": "1.4.2",
      "@types/node": "26.6.4",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.1",
      "alchemy": "2.0.0-beta.80",
      "effect": "4.0.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "typescript": "7.0.2",
      "vite": "8.3.2",
      "vitest": "5.0.3",
      "wrangler": "4.147.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "check": "ultracite check --type-aware",
    "check-types": "turbo run check-types && bun run check-types:root",
    "check-types:root": "tsc --noEmit -p tsconfig.alchemy.json && tsc --noEmit -p tools/tsconfig.json",
    "check:docs": "bun --conditions=source run tools/documentation/check.runtime.ts",
    "check:effect": "effect-tsgo diagnostics --project tools/effect-language-service/tsconfig.json && tsc --noEmit -p tools/effect-language-service/tsconfig.json",
    "check:repository-paths": "bun run tools/repository-paths/check.runtime.ts",
    "clean": "turbo run clean",
    "dev": "turbo run build --filter=api && CI=1 ALCHEMY_HOME=.alchemy/native-apps-auth ALCHEMY_TELEMETRY_DISABLED=1 BUN_OPTIONS=\"--conditions=source --no-env-file\" bun run node_modules/alchemy/bin/cli.js dev --config alchemy.apps.local.run.ts --env-file tools/apps-local/no-local-env --stage dev_native_apps",
    "docs:validate": "turbo run validate --filter=@taxkit/docs-content",
    "fix": "ultracite fix --type-aware",
    "format": "oxfmt -c oxfmt.config.ts --write . --no-error-on-unmatched-pattern",
    "format:check": "oxfmt -c oxfmt.config.ts --check . --no-error-on-unmatched-pattern",
    "knip": "turbo run build --filter=@taxkit/docs-content && knip --no-progress --no-config-hints",
    "knip:production": "knip --production --config knip.production.json --no-gitignore --no-progress --no-config-hints",
    "lint": "bun run lint:boundary-directives && oxlint -c oxlint.config.ts . --disable-nested-config --no-error-on-unmatched-pattern",
    "lint:boundary-directives": "oxlint -c oxlint.config.ts . --allow=taxkit/no-decoding-outside-boundaries --allow=taxkit/no-route-transport-restore-outside-consumers --report-unused-disable-directives-severity=error --disable-nested-config --no-error-on-unmatched-pattern",
    "prepare": "effect-tsgo patch",
    "test": "bun run test:tools && turbo run test",
    "test:tools": "bun --bun vitest run --config tools/vitest.config.ts",
    "test:browser": "turbo run test:browser",
    "test:native": "bun run --filter=web build:native-pair && bun run --filter=web test:native-pair",
    "api:smoke": "turbo run smoke --filter=api",
    "sdk:check-packed-artifact": "turbo run check-packed-artifact --filter=@taxkit/sdk",
    "sdk:validate-downstream": "turbo run validate:downstream --filter=@taxkit/sdk",
    "release:check": "bun run verification && bun run sdk:check-packed-artifact && bun run sdk:validate-downstream && bun run api:smoke && bun run docs:validate && bun run changeset:status",
    "verification": "bun run build && bun run format:check && bun run lint && bun run check-types && bun run check:effect && bun run test && bun run test:browser && bun run knip && bun run knip:production && bun run check:docs && bun run check:repository-paths",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@taxkit/infrastructure": "workspace:*",
    "alchemy": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.48.0",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.86.0",
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "knip": "6.39.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "portless": "0.15.7",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "ultracite": "7.12.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0",
    "@effect/sql-d1": "4.0.0",
    "@effect/sql-sqlite-do": "4.0.0",
    "workerd": "1.20261001.1"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.16.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@effect/atom-react@4.0.0": "patches/@effect%2Fatom-react@4.0.0.patch",
    "alchemy@2.0.0-beta.80": "patches/alchemy@2.0.0-beta.80.patch"
  }
}
